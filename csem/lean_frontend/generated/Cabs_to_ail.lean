partial def desugar_block_statement [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl]
    [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (self : cabs_statement → desugM (statement Unit)) (ss : List cabs_statement) :
    state_with_markers → exceptM
        ((List
          (sym ×
            ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) ×
          List (statement Unit)) × state_with_markers) error :=
  match self, ss with
  | self, ss =>
    stExpect_bind fresh_block_scope (fun (scope1 : scope) =>
      stExpect_bind (collect_with_scope scope1 (stExpect_mapM self ss))
        (fun (p :
          (List
            (sym ×
              ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers ×
                ctype)) × List (statement Unit))) =>
          match p with
          | (bs_, d_ss) =>
            (let bs :=
               List.filter
                 (fun (p :
                   (sym ×
                     ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers ×
                       ctype))) =>
                   match p with
                   | (_, ((_, dur, _), _, _, _)) =>
                     (match dur with
                      | Static => false
                      | Thread => false
                      | _ => true)) bs_;
             /- this is removing unnecessary blocks and skips introduced by the desugared.
      TODO: check carefully that we don't remove source blocks -/
             let d_ss' :=
               lemListFoldr
                 (fun (p : (cabs_statement × statement Unit)) (acc : List (statement Unit)) =>
                   match p, acc with
                   | z@((cabs_stmt, d_stmt)), acc =>
                     (match cabs_stmt, d_stmt.node with
                      | CabsStatement _ _ CabsSnull,
                        AilSskip => /- this is the case of a block already present in the Cabs code. -/
                        Prod.snd z :: acc
                      | CabsStatement _ _ _, AilSskip =>
                        (lem_if d_stmt.attrs == no_attributes then acc else Prod.snd z :: acc)
                      | CabsStatement _ _ (CabsSblock _),
                        AilSblock _
                          _ => /- this is the case of a block already present in the Cabs code. -/
                        Prod.snd z :: acc
                      | _, AilSblock [] xs =>
                        (lem_if d_stmt.attrs ==
                            no_attributes then /- here a block with no local variables was introduced by the desugaring -/
                          xs ++ acc
                        else /- we keep it if there are attributes -/
                          Prod.snd z :: acc)
                      | _, _ => Prod.snd z :: acc)) ([] : List (statement Unit))
                 (lemListZip ss d_ss);
             stExpect_return (bs, d_ss'))))
