def translate_unary_operator : cabs_unary_operator → unaryOperator :=
  fun (x : cabs_unary_operator) =>
    match x with
    | CabsAddress => Address
    | CabsIndirection => Indirection
    | CabsPlus => Plus
    | CabsMinus => Minus
    | CabsBnot => Bnot
    /- This case cannot occurs since Not is translated away. -/
    | CabsNot => (failwithI "[Cabs_to_ail.translate_unary_operator] Not" : unaryOperator)

def translate_arithmetic_operator : cabs_binary_operator → arithmeticOperator :=
  fun (x : cabs_binary_operator) =>
    match x with
    | CabsAdd => Add0
    | CabsSub => Sub0
    | CabsMul => Mul0
    | CabsDiv => Div0
    | CabsMod => Mod0
    | CabsBand => Band
    | CabsBxor => Bxor
    | CabsBor => Bor
    | CabsShl => Shl
    | CabsShr => Shr
    | _ =>
      (failwithI
        "[Cabs0_to_ail.translate_arithmetic_operator] should only be called on operators allowed for compound assignments [§6.5.16#1]." :
        arithmeticOperator)

def translate_binary_operator : cabs_binary_operator → binaryOperator :=
  fun (x : cabs_binary_operator) =>
    match x with
    | CabsAnd => And0
    | CabsOr => Or0
    | CabsEq => Eq1
    | CabsNe => Ne0
    | CabsLt => Lt
    | CabsGt => Gt
    | CabsLe => Le
    | CabsGe => Ge
    | op => Arithmetic (translate_arithmetic_operator op)

def translate_assignment_operator : cabs_assignment_operator → Option arithmeticOperator :=
  fun (x : cabs_assignment_operator) =>
    match x with
    | Assign => none
    | Assign_Mul => some Mul0
    | Assign_Div => some Div0
    | Assign_Mod => some Mod0
    | Assign_Add => some Add0
    | Assign_Sub => some Sub0
    | Assign_Shl => some Shl
    | Assign_Shr => some Shr
    | Assign_Band => some Band
    | Assign_Bxor => some Bxor
    | Assign_Bor => some Bor

def desugar_cabs_constant (loc1 : CerbLocation.Loc) :
    cabs_constant → state_with_markers → exceptM (constant × state_with_markers) error :=
  fun (x : cabs_constant) =>
    match x with
    | CabsInteger_const iCst => stExpect_return (ConstantInteger (translate_integer_constant iCst))
    | CabsFloating_const fCst =>
      stExpect_return (ConstantFloating (translate_floating_constant fCst))
    | CabsCharacter_const cCst =>
      stExpect_return (ConstantCharacter (translate_character_constant cCst))

def translate_cabs_encoding_prefix : cabs_encoding_prefix → encodingPrefix :=
  fun (x : cabs_encoding_prefix) =>
    match x with
    | CabsEncPrefix_u8 => Enc_u8
    | CabsEncPrefix_u => Enc_u
