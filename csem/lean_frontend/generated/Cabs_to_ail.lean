         stExpect_bind ((desugar_cn_assertion _lemReader_enum_definitions _lemReader_tagDefs) assrt)
           (fun (assrt : cn_assertion sym ctype) => stExpect_return (CN_have assrt))
       | CN_instantiate o_filter expr1 =>
         stExpect_bind
           (match o_filter with
            | I_Everything => stExpect_return I_Everything
            | I_Good tyname =>
              stExpect_bind
                ((desugar_type_name _lemReader_enum_definitions _lemReader_tagDefs) tyname)
                (fun (p : (qualifiers × ctype)) =>
                  match p with
                  | (_, ty1) => stExpect_return (I_Good ty1))
