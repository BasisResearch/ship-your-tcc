  fun (x : cabs_integer_suffix) =>
    match x with
    | CabsSuffix_U => U
    | CabsSuffix_UL => UL
    | CabsSuffix_ULL => ULL
    | CabsSuffix_L => L
    | CabsSuffix_LL => LL

def translate_integer_constant (p : (String × Option cabs_integer_suffix)) : integerConstant :=
  match p with
  | (str, suff_opt) =>
    (match CerbDecode.decode_integer_constant str with
     | (basis1, n) =>
       (match suff_opt with
        | some suff => IConstant n basis1 (some (translate_integer_suffix suff))
        | none => IConstant n basis1 none))
def translate_floating_suffix : cabs_floating_suffix → floatingSuffix :=
  fun (x : cabs_floating_suffix) =>
    match x with
