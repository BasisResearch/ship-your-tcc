                stExpect_bind (register_cn_ident CN_datatype_nm dt.cn_dt_name) (fun (_ : sym) =>
                  stExpect_return ()))
        | _ => stExpect_return ()) xs)
def register_additional_cn_var [CerberusFresh.Digest] (id1 : identifier) :
    state_with_markers → exceptM (sym × state_with_markers) error :=
  register_cn_ident CN_vars id1

/- C1 (effect retirement): the entry threads the pipeline's single
   fresh-symbol stream (S1) — takes the current supply, seeds the
   desugar state with it, and returns the final supply beside the
   result. DEAD on the OCaml target (ambient counter; callers pass 0
   and ignore the returned component). -/

/- address-space-bound slice (2026-09-17): the second parameter is the address-space top
   the desugar state is seeded with (E.initial_state), read back by the const-expr
   mini-run; the driver passes the same value here and to the execution entry. -/
def desugar [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (sup : Nat)
    (address_space_top1 : Int) (core_eval_stuff1 : (Fmap String sym × fun_map Unit × impl))
    (cn_eval_stuff : init_scope) (startup_str : String) (t5 : translation_unit) :
    exceptM (fin_markers_env × (Option ail_identifier × sigma Unit) × Nat) error :=
  match sup, address_space_top1, core_eval_stuff1, cn_eval_stuff, startup_str, t5 with
  | sup, address_space_top1, core_eval_stuff1, cn_eval_stuff, startup_str, (TUnit edecls) =>
    cabs_to_ail_effect_eval sup address_space_top1 core_eval_stuff1 cn_eval_stuff
      (under_scope Scope_file
        (stExpect_bind (register_cn_predicate_names edecls) (fun (u : Unit) =>
          match u with
          | () =>
            stExpect_bind (register_cn_function_names edecls) (fun (u : Unit) =>
              match u with
              | () =>
                stExpect_bind (register_cn_datatype_names edecls) (fun (u : Unit) =>
                  match u with
                  | () =>
                    stExpect_bind
                      (lemListFoldr
                        (fun (m : state_with_markers → exceptM (Unit × state_with_markers)
                          (CerbLocation.Loc × cause))
                          (f : state_with_markers → exceptM (Unit × state_with_markers)
                            (CerbLocation.Loc × cause))=>
                          stExpect_bind m (fun (_ : Unit) => f)) (stExpect_return ())
                        (List.map
                          (desugar_and_register_external_declaration _lemReader_enum_definitions
                            _lemReader_tagDefs) edecls))
                      (fun (u : Unit) =>
                        match u with
                        | () => extract_program startup_str))))))
