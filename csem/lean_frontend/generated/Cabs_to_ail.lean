    (List.map
      (fun (x : external_declaration) =>
        match x with
        | EDecl_datatypeCN dt =>
          stExpect_bind
            (stExpect_return
              (CerbDebug.print_debug_pure 2 [DB_desugaring] (fun (u : Unit) =>
                match u with
                | () => "adding a datatype name")))
            (fun (u : Unit) =>
              match u with
