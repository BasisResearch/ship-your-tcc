                                     stExpect_return (AilScase_rangeGNU n1 n2 z))
                                 else
                                   stExpect_bind
                                     (stExpect_return
                                       (CerbDebug.warn [DB_desugaring] (fun (u : Unit) =>
                                         match u with
                                         | () =>
                                           String.append "empty case range ["
                                             (String.append (CerbLocation.stringFromLocation loc1)
                                               "] discarded by the desugaring"))))
                                     (fun (u : Unit) =>
                                       match u with
                                       | () => stExpect_return AilSskip)))))
                     | false =>
                       (fun (_ : state_with_markers) =>
                         fail0
                           (loc1,
                             DESUGAR (Desugar_ConstraintViolation LabelStatementOutsideSwitch)))))
              | CabsSmarker s =>
                stExpect_bind (record_marker ()) (fun (id1 : Nat) =>
                  stExpect_bind (self s) (fun (z : statement Unit) =>
                    stExpect_return (AilSmarker id1 z))))
             (fun (z : statement_ Unit) =>
               stExpect_return (mk_statement_full loc1 desug_info2 attrs1 z))))
end
def desugar_statement [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (stmt : cabs_statement) :
    state_with_markers → exceptM (statement Unit × state_with_markers) error :=
  (desugar_statement_aux _lemReader_enum_definitions _lemReader_tagDefs)
    (({ cont_ident_opt := none } : stmt_context)) stmt
partial def register_labels [CerberusFresh.Digest] (c : cabs_statement) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  match c with
  | (CabsStatement _ _ stmt_) =>
    (match stmt_ with
     | CabsSlabel ident s =>
       stExpect_bind (register_label ident) (fun (_ : Unit) => register_labels s)
     | CabsScase _ s => register_labels s
     | CabsSdefault s => register_labels s
     | CabsSblock ss =>
       lemListFoldr
         (fun (m : state_with_markers → exceptM (Unit × state_with_markers)
           (CerbLocation.Loc × cause))
           (f : state_with_markers → exceptM (Unit × state_with_markers)
             (CerbLocation.Loc × cause))=>
           stExpect_bind m (fun (_ : Unit) => f)) (stExpect_return ()) (List.map register_labels ss)
     | CabsSdecl _ => stExpect_return ()
     | CabsSnull => stExpect_return ()
     | CabsSexpr _ => stExpect_return ()
     | CabsSif _ s1 s2_opt =>
       stExpect_bind (register_labels s1) (fun (_ : Unit) =>
         maybe0 (stExpect_return ()) register_labels s2_opt)
     | CabsSswitch _ s => register_labels s
     | CabsSwhile _ s => register_labels s
     | CabsSdo _ s => register_labels s
     | CabsSfor _ _ _ s => register_labels s
     | CabsSgoto _ => stExpect_return ()
     | CabsScontinue => stExpect_return ()
     | CabsSbreak => stExpect_return ()
     | CabsSreturn _ => stExpect_return ()
     | CabsSpar _ => /- TODO: temporary -/ stExpect_return ()
     | CabsSasm _ _ _ => /- TODO: check whether labels can declared here -/ stExpect_return ()
     | CabsScaseGNU _ _ s => register_labels s /- BEGIN CN -/
     | CabsSmarker s => register_labels s /- END CN -/)

/- BEGIN CN -/

def unique_record_members { a b : Type }
    (f : b → state_with_markers → exceptM (a × state_with_markers) error)
    (members : List (identifier × b)) :
    state_with_markers → exceptM (List (identifier × a) × state_with_markers)
        (CerbLocation.Loc × cause) :=
  stExcept_foldlM
    (fun (acc : List (identifier × a)) (p : (identifier × b)) =>
      match acc, p with
      | acc, (member, thing) =>
        (match (lookupBy idEqual member acc) with
         | some _ =>
           (fun (_ : state_with_markers) =>
             fail0
               ((match member with
                 | (Identifier loc1 _) => loc1),
                 DESUGAR (Desugar_CN (CNErr_duplicate_field member))))
         | none =>
           stExpect_bind (f thing) (fun (thing : a) => stExpect_return ((member, thing) :: acc))))
    [] members

def sort_record_members { a b : Type }
    (f : a → state_with_markers → exceptM (b × state_with_markers) error)
    (members : List (identifier × a)) :
    state_with_markers → exceptM (List (identifier × b) × state_with_markers) error :=
  let cmp : (identifier × b) → (identifier × b) → Bool :=
    (fun (p : (identifier × b)) (p0 : (identifier × b)) =>
      match p, p0 with
      | (mem1, _), (mem2, _) =>
        Lem_String_extra.stringLess
          (match mem1 with
           | Identifier _ str => str)
          (match mem2 with
           | Identifier _ str => str));
  stExpect_bind (unique_record_members f members) (fun (z : List (identifier × b)) =>
    stExpect_return (Lem_Sorting.insertSortBy cmp z))

partial def desugar_cn_base_type (loc1 : CerbLocation.Loc) (bTy : cn_base_type identifier) :
    state_with_markers → exceptM (cn_base_type sym × state_with_markers) error :=
  match bTy with
  | CN_unit => stExpect_return CN_unit
  | CN_bool => stExpect_return CN_bool
  | CN_integer => stExpect_return CN_integer
  | CN_bits sign1 n => stExpect_return (CN_bits sign1 n)
  | CN_real => stExpect_return CN_real
  | CN_loc => stExpect_return CN_loc
  | CN_alloc_id => stExpect_return CN_alloc_id
  | CN_struct tag_ident =>
    stExpect_bind (resolve_extraordinary_identifier tag_ident Namespace_tag)
      (fun (x : Option (scope × (sym × identifier_kind))) =>
        match x with
        | some (_, (tag_sym, Kind_tag Kind_struct)) => stExpect_return (CN_struct tag_sym)
        | some _ =>
          (fun (_ : state_with_markers) => fail0 (loc1, DESUGAR (Desugar_CN CNErr_invalid_tag)))
        | none =>
          (fun (_ : state_with_markers) => fail0 (loc1, DESUGAR (Desugar_CN CNErr_invalid_tag))))
  | CN_record members =>
    stExpect_bind (sort_record_members (desugar_cn_base_type loc1) members)
      (fun (z : List (identifier × cn_base_type sym)) => stExpect_return (CN_record z))
  | CN_datatype ident =>
    stExpect_bind (resolve_cn_ident CN_datatype_nm ident)
      (fun (sym_resolved : (sym × cn_var_kind)) =>
        let sym1 := ensure_not_c_variable sym_resolved;
        stExpect_return (CN_datatype sym1))
  | CN_map bTy1 bTy2 =>
    stExpect_bind
      (stExpect_bind (desugar_cn_base_type loc1 bTy1) (fun (z : cn_base_type sym) =>
        stExpect_return (CN_map z)))
      (fun (f : cn_base_type sym → cn_base_type sym) =>
        stExpect_bind (desugar_cn_base_type loc1 bTy2) (fun (z : cn_base_type sym) =>
          stExpect_return (f z)))
  | CN_list bTy =>
    stExpect_bind (desugar_cn_base_type loc1 bTy) (fun (z : cn_base_type sym) =>
      stExpect_return (CN_list z))
  | CN_tuple bTys =>
    stExpect_bind (stExpect_mapM (desugar_cn_base_type loc1) bTys)
      (fun (z : List (cn_base_type sym)) => stExpect_return (CN_tuple z))
  | CN_set bTy =>
    stExpect_bind (desugar_cn_base_type loc1 bTy) (fun (z : cn_base_type sym) =>
      stExpect_return (CN_set z))
  | CN_user_type_name ident => resolve_cn_user_type_name ident
  | CN_c_typedef_name _ =>
    (failwithI "CN_c_typedef_name before elaboration" : state_with_markers → exceptM
      (cn_base_type sym × state_with_markers) error)

partial def register_and_desugar_cn_pattern [CerberusFresh.Digest] (c : cn_pat identifier) :
    state_with_markers → exceptM (cn_pat sym × state_with_markers) error :=
  match c with
  | (CNPat loc1 pat_) =>
    (match pat_ with
     | CNPat_sym ident =>
       stExpect_bind (register_cn_ident CN_vars ident) (fun (sym1 : sym) =>
         stExpect_return (CNPat loc1 (CNPat_sym sym1)))
     | CNPat_wild => stExpect_return (CNPat loc1 CNPat_wild)
     | CNPat_constructor cons1 args =>
       stExpect_bind (resolve_cn_ident CN_constructor cons1)
         (fun (cons_resolved : (sym × cn_var_kind)) =>
           let cons_resolved := ensure_not_c_variable cons_resolved;
           stExpect_bind
             (stExpect_mapM
               (fun (p : (identifier × cn_pat identifier)) =>
                 match p with
                 | (member, pat') =>
                   stExpect_bind (register_and_desugar_cn_pattern pat') (fun (pat' : cn_pat sym) =>
                     stExpect_return (member, pat'))) args)
             (fun (args : List (identifier × cn_pat sym)) =>
               stExpect_return (CNPat loc1 (CNPat_constructor cons_resolved args)))))

def pair { a b : Type } (x : a) (y : b) : (a × b) := (x, y)

def desugar_maybe { a b : Type }
    (desugar_f : b → state_with_markers → exceptM (a × state_with_markers) error) (o : Option b) :
    state_with_markers → exceptM (Option a × state_with_markers) error :=
  match o with
  | some x => stExpect_bind (desugar_f x) (fun (x : a) => stExpect_return (some x))
  | none => stExpect_return none

def cn_resolve_ordinary_id_other (loc1 : CerbLocation.Loc) (nm : identifier) :
    state_with_markers → exceptM (sym × state_with_markers) error :=
  stExpect_bind (resolve_ordinary_identifier loc1 nm)
    (fun (x : Option (scope × ordinary_registration)) =>
      match x with
      | some (_, OReg_other nm_sym _ _) => stExpect_return nm_sym
      | some (_, OReg_enum_constant _) =>
        (fun (_ : state_with_markers) =>
          fail0 (loc1, DESUGAR (Desugar_CN (CNErr_unknown_c_identifier nm))))
      | some (_, OReg_typedef _) =>
        (fun (_ : state_with_markers) =>
          fail0 (loc1, DESUGAR (Desugar_CN (CNErr_unknown_c_identifier nm))))
      | none =>
        (fun (_ : state_with_markers) =>
          fail0 (loc1, DESUGAR (Desugar_CN (CNErr_unknown_c_identifier nm)))))

