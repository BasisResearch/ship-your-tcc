    | CabsFloatingSuffix_L => Fsuf_L

def translate_floating_constant (p : (String × Option cabs_floating_suffix)) :
    (String × Option floatingSuffix) :=
  match p with
  | (str, suff_opt) =>
    (str,
      maybe0 none ((fun (x : cabs_floating_suffix)=> some (translate_floating_suffix x))) suff_opt)
