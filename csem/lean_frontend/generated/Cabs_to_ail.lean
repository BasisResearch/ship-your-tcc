           (fun (to_extract : cn_to_extract sym ctype) =>
             stExpect_bind ((desugar_cn_expr _lemReader_enum_definitions _lemReader_tagDefs) expr1)
               (fun (expr1 : cn_expr sym ctype) =>
                 stExpect_return (CN_extract attrs1 to_extract expr1)))
       | CN_unfold f args =>
         stExpect_bind (resolve_cn_ident CN_function f) (fun (f_resolved : (sym × cn_var_kind)) =>
           let f := ensure_not_c_variable f_resolved;
           stExpect_bind
