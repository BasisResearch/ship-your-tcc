                              end
-/
                                                                register_global_object_definition2
                                                                  ident_loc sym1 link1
                                                                  (ExternalDefinition d_e)))
                                                  | none =>
                                                    stExpect_bind
                                                      (cabs_to_ail_effect_is_incomplete ty1)
                                                      (fun (is_incomplete2 : Bool) =>
                                                        lem_if (link1 == Linkage_internal) &&
                                                            is_incomplete2 then /- TODO: this is wrong (see tentative definition in the STD) -/
                                                          fun (_ : state_with_markers) =>
                                                            fail0
                                                              (ident_loc,
                                                                DESUGAR
                                                                  (Desugar_UndefinedBehaviour
                                                                    UB089_tentative_definition_internal_linkage))
                                                        else lem_if (link1 == Linkage_none) &&
                                                            is_incomplete2 then
                                                          fun (_ : state_with_markers) =>
                                                            fail0
                                                              (ident_loc,
                                                                DESUGAR
                                                                  (Desugar_UndefinedBehaviour
                                                                    UB059_incomplete_no_linkage_identifier))
                                                        else lem_if (dur == Static) ||
                                                            (dur ==
                                                              Thread) then /- TODO: not correct for thread? -/
                                                          lem_if Lem_List.elem SC_extern
                                                              s.storage_classes then
                                                            stExpect_return ()
                                                          else
                                                            register_global_object_definition2
                                                              ident_loc sym1 link1
                                                              (Tentative ident_loc
                                                                ty1 /- mk_zeroInit tagDefs ty -/)
                                                        else
                                                          stExpect_return ()))))))) xs)))))))
    | EDecl_decl (Declaration_static_assert s0) =>
      (desugar_and_register_static_assert_declaration _lemReader_enum_definitions
        _lemReader_tagDefs) s0
    | EDecl_magic p => add_toplevel_magic p
    | EDecl_funcCN c0 =>
      (desugar_and_register_cn_function _lemReader_enum_definitions _lemReader_tagDefs) c0
    | EDecl_lemmaCN c1 =>
      (desugar_and_register_cn_lemma _lemReader_enum_definitions _lemReader_tagDefs) c1
    | EDecl_predCN c2 =>
      (desugar_and_register_cn_predicate _lemReader_enum_definitions _lemReader_tagDefs) c2
    | EDecl_datatypeCN c3 => desugar_and_register_cn_datatype c3
    | EDecl_type_synCN c4 => desugar_and_register_cn_type_synonym c4
    | EDecl_fun_specCN c5 => desugar_and_register_cn_fun_spec c5
def register_cn_predicate_names [CerberusFresh.Digest] (xs : List external_declaration) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  lemListFoldr
    (fun (m : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))
      (f : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))=>
      stExpect_bind m (fun (_ : Unit) => f)) (stExpect_return ())
    (List.map
      (fun (x : external_declaration) =>
        match x with
        | EDecl_predCN pred1 =>
          stExpect_bind (register_cn_ident CN_predicate pred1.cn_pred_name) (fun (_ : sym) =>
            stExpect_return ())
        | _ => stExpect_return ()) xs)
def register_cn_function_names [CerberusFresh.Digest] (xs : List external_declaration) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  lemListFoldr
    (fun (m : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))
      (f : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))=>
      stExpect_bind m (fun (_ : Unit) => f)) (stExpect_return ())
    (List.map
      (fun (x : external_declaration) =>
        match x with
        | EDecl_funcCN pred1 =>
          stExpect_bind (register_cn_ident CN_function pred1.cn_func_name) (fun (_ : sym) =>
            stExpect_return ())
        | _ => stExpect_return ()) xs)
def register_cn_datatype_names [CerberusFresh.Digest] (xs : List external_declaration) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  lemListFoldr
    (fun (m : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))
      (f : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))=>
