partial def find_compatible_generic_association { a : Type }
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (p : (qualifiers × ctype)) :
    List (generic_association a) → Option (qualifiers × ctype) :=
  match p with
  | (qs, ty1) =>
    (fun (x : List (generic_association a)) =>
      match x with
      | [] => none
      | AilGAtype qs' ty' _ :: gs' =>
        (lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (qs, ty1)
            (qs', ty') then
          some (qs', ty')
        else
          (find_compatible_generic_association _lemReader_enum_definitions _lemReader_tagDefs)
            (qs, ty1) gs')
      | AilGAdefault _ :: gs' =>
        (find_compatible_generic_association _lemReader_enum_definitions _lemReader_tagDefs)
          (qs, ty1) gs')
/- D3 seed (program-data parameters E-A): the _Generic association search reads
   the enum map through are_compatible -/

