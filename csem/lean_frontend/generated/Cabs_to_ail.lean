def check_members { a b : Type } [CerbImplCfg.Impl]
    (membrDefs : List (identifier × (b × a × qualifiers × ctype))) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  lemListFoldr
    (fun (m : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))
      (f : state_with_markers → exceptM (Unit × state_with_markers) (CerbLocation.Loc × cause))=>
      stExpect_bind m (fun (_ : Unit) => f)) (stExpect_return ())
    (List.map
      (fun (p : (identifier × (b × a × qualifiers × ctype))) =>
        match p with
        | (ident, (_, _, qs, ty1)) =>
          (lem_if is_function ty1 then
            fun (_ : state_with_markers) =>
              fail0
                ((match ident with
                  | (Identifier loc1 _) => loc1),
                  DESUGAR (Desugar_ConstraintViolation (StructMemberFunctionType ident)))
          else
            stExpect_bind (cabs_to_ail_effect_is_incomplete ty1) (fun (x : Bool) =>
              match x with
              | true =>
                (fun (_ : state_with_markers) =>
                  fail0
                    ((match ident with
                      | (Identifier loc1 _) => loc1),
                      DESUGAR (Desugar_ConstraintViolation (StructMemberIncompleteType qs ty1))))
              | false => stExpect_return ()))) membrDefs)

