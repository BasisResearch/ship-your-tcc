                  stExpect_return (I_Function f)))
           (fun (o_filter : cn_to_instantiate sym ctype) =>
             stExpect_bind ((desugar_cn_expr _lemReader_enum_definitions _lemReader_tagDefs) expr1)
               (fun (expr1 : cn_expr sym ctype) => stExpect_return (CN_instantiate o_filter expr1)))
