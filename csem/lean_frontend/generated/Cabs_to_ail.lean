def desugar_basic_type_specifiers (locs : List CerbLocation.Loc)
    (specs : t2 cabs_base_type_specifier) :
    state_with_markers → exceptM (Option (CerbLocation.Loc × basicType) × state_with_markers)
        error :=
  let loc1 := CerbLocation.bboxLocation locs;
  CerbUtils.STD_ "§6.7.2#2, sentence 2 (non `void' case)"
    (lem_if equal_multiset specs
        (from_list [BTSpec_float, BTSpec_Complex]) then /- STD §6.7.2#2, item 17 -/
      fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_NeverSupported "_Complex types"))
    else lem_if equal_multiset specs
        (from_list [BTSpec_double, BTSpec_Complex]) then /- STD §6.7.2#2, item 18 -/
      fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_NeverSupported "_Complex types"))
    else lem_if equal_multiset specs
        (from_list [BTSpec_long, BTSpec_double, BTSpec_Complex]) then /- STD §6.7.2#2, item 19 -/
      fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_NeverSupported "_Complex types"))
    else
      stExpect_return
        (lem_if equal_multiset specs (from_list [BTSpec_char]) then /- STD §6.7.2#2, item 2 -/
          some (loc1, Integer Char0)
        else lem_if equal_multiset specs
            (from_list [BTSpec_signed, BTSpec_char]) then /- STD §6.7.2#2, item 3 -/
          some (loc1, Integer (Signed Ichar))
        else lem_if equal_multiset specs
            (from_list [BTSpec_unsigned, BTSpec_char]) then /- STD §6.7.2#2, item 4 -/
          some (loc1, Integer (Unsigned Ichar))
        else lem_if List.any
            [from_list [BTSpec_short], from_list [BTSpec_signed, BTSpec_short],
              from_list [BTSpec_short, BTSpec_int],
              from_list [BTSpec_signed, BTSpec_short, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 5 -/
          some (loc1, Integer (Signed Short))
        else lem_if List.any
            [from_list [BTSpec_unsigned, BTSpec_short],
              from_list [BTSpec_unsigned, BTSpec_short, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 6 -/
          some (loc1, Integer (Unsigned Short))
        else lem_if List.any
            [from_list [BTSpec_int], from_list [BTSpec_signed],
              from_list [BTSpec_signed, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 7 -/
          some (loc1, Integer (Signed Int_))
        else lem_if List.any [from_list [BTSpec_unsigned], from_list [BTSpec_unsigned, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 8 -/
          some (loc1, Integer (Unsigned Int_))
        else lem_if List.any
            [from_list [BTSpec_long], from_list [BTSpec_signed, BTSpec_long],
              from_list [BTSpec_long, BTSpec_int],
              from_list [BTSpec_signed, BTSpec_long, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z)then /- STD §6.7.2#2, item 9 -/
          some (loc1, Integer (Signed Long))
        else lem_if List.any
            [from_list [BTSpec_unsigned, BTSpec_long],
              from_list [BTSpec_unsigned, BTSpec_long, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 10 -/
          some (loc1, Integer (Unsigned Long))
        else lem_if List.any
            [from_list [BTSpec_long, BTSpec_long],
              from_list [BTSpec_signed, BTSpec_long, BTSpec_long],
              from_list [BTSpec_long, BTSpec_long, BTSpec_int],
              from_list [BTSpec_signed, BTSpec_long, BTSpec_long, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 11 -/
          some (loc1, Integer (Signed LongLong))
        else lem_if List.any
            [from_list [BTSpec_unsigned, BTSpec_long, BTSpec_long],
              from_list [BTSpec_unsigned, BTSpec_long, BTSpec_long, BTSpec_int]]
            (fun (z : t2 cabs_base_type_specifier) =>
              equal_multiset specs z) then /- STD §6.7.2#2, item 12 -/
          some (loc1, Integer (Unsigned LongLong))
        else lem_if equal_multiset specs (from_list [BTSpec_float]) then /- STD §6.7.2#2, item 13 -/
          some (loc1, Floating (RealFloating Float0))
        else lem_if equal_multiset specs
            (from_list [BTSpec_double]) then /- STD §6.7.2#2, item 14 -/
          some (loc1, Floating (RealFloating Double))
        else lem_if equal_multiset specs
            (from_list [BTSpec_long, BTSpec_double]) then /- STD §6.7.2#2, item 15 -/
          some (loc1, Floating (RealFloating LongDouble))
        else lem_if equal_multiset specs (from_list [BTSpec_Bool]) then /- STD §6.7.2#2, item 16 -/
          some (loc1, Integer Bool0)
        else
          none))
