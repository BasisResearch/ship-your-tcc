partial def is_integer_constant_expression0 (e : expression Unit) :
    state_with_markers → exceptM (Bool × state_with_markers) error :=
  match e with
  | expr1@(AnnotatedExpression () _ loc1 expr_) =>
    CerbUtils.STD_ "§6.6#6"
      (match expr_ with
       | AilEunary uop e =>
         (match uop with
          | Plus => is_integer_constant_expression0 e
          | Minus => is_integer_constant_expression0 e
          | Bnot => is_integer_constant_expression0 e
          | Address => stExpect_return false
          | Indirection => stExpect_return false
          | PostfixIncr => stExpect_return false
          | PostfixDecr => stExpect_return false)
       | AilEcast _ _ _ =>
         (fun (_ : state_with_markers) =>
           fail0
             (loc1,
               DESUGAR (Desugar_NotYetSupported "cast operator in `integer constant expressions'")))
       | AilEassert _ => stExpect_return false
       | AilEoffsetof _ _ => /- STD §7.19#3 -/ stExpect_return true
       | AilEstr _ => stExpect_return false
       /-
    | AilEgeneric of expression 'a * list (generic_association 'a)
    | AilEarray of bool * ctype * list (maybe (expression 'a))
    | AilEstruct of ail_identifier * list (Symbol.identifier * maybe (expression 'a)) /- tag, pairs of member id, expression -/
    | AilEunion of ail_identifier * Symbol.identifier * maybe (expression 'a)
    | AilEcompound of ctype * expression 'a
    | AilEmemberof of expression 'a * Symbol.identifier
    | AilEmemberofptr of expression 'a * Symbol.identifier
    | AilEbuiltin of string /- TODO: see if that can be moved to [constant] -/
    | AilEstr of stringLiteral
    | AilEconst of constant
    | AilEident of ail_identifier
-/
       | AilEannot _ e => is_integer_constant_expression0 e
       | AilEva_start _ _ => stExpect_return false
       | AilEva_copy _ _ => stExpect_return false
       | AilEva_arg _ _ => stExpect_return false
       | AilEva_end _ => stExpect_return false
       | AilEprint_type e => is_integer_constant_expression0 e
       | AilEbmc_assume _ => stExpect_return false
       | AilErvalue _ => /- NOTE: this only exists after the Ail typing -/
         (failwithI "cabs_to_ail.is_integer_constant_expression (AilErvalue _)" :
           state_with_markers → exceptM (Bool × state_with_markers) error)
       | AilEarray_decay _ => /- NOTE: this only exists after the Ail typing -/
         (failwithI "cabs_to_ail.is_integer_constant_expression (AilEarray_decay _)" :
           state_with_markers → exceptM (Bool × state_with_markers) error)
       | AilEfunction_decay _ => /- NOTE: this only exists after the Ail typing -/
         (failwithI "cabs_to_ail.is_integer_constant_expression (AilEfunction_decay _)" :
           state_with_markers → exceptM (Bool × state_with_markers) error)
       | AilEatomic _ => /- NOTE: this only exists after the Ail typing -/
         (failwithI "cabs_to_ail.is_integer_constant_expression (AilEatomic _)" :
           state_with_markers → exceptM (Bool × state_with_markers) error)
       | AilEconst (ConstantInteger _) => /- NOTE: this includes enumeration constants -/
         stExpect_return true
       | AilEconst (ConstantFloating _) => stExpect_return false
       | AilEconst (ConstantCharacter _) => stExpect_return true
       | AilEconst (ConstantPredefined PConstantFalse) => stExpect_return true
       | AilEconst (ConstantPredefined PConstantTrue) => stExpect_return true
       | AilEsizeof _ ty1 =>
         (lem_if is_vla ty1 then /- STD §6.5.3.4#2, sentence 4 -/
           stExpect_return false
         else
           stExpect_return true)
       | AilEsizeof_expr
         _ => /- TODO: this is wrong if the expression is a VLA -/ /- but I can't easily ask the Ail typing for now ... -/
         /-
        if AilTypesAux.is_vla ty then
          /- STD §6.5.3.4#2, sentence 4 -/
          E.return false
        else
-/
         stExpect_return true
       | AilEalignof _ _ => stExpect_return true
       /-

floating constants that are the immediate operands of casts.

Cast operators in an integer constant expression shall only convert arithmetic types to integer types, except as part of an operand to the sizeof or _Alignof operator.
-/
       /-
Constant expressions shall not


increment

decrement

function-call

or comma operators

except when they are contained within a subexpression that is not evaluated.115)
-/
       | AilEassign _ _ => /- STD §6.6#3 -/ stExpect_return false
       | AilEcompoundAssign _ _ _ => /- STD §6.6#3 -/ stExpect_return false
       | AilEcall _ _ => /- STD §6.6#3 -/ stExpect_return false
       | AilEbinary _ Comma _ => /- STD §6.6#3 -/ stExpect_return false
       | AilEbinary e1 _ e2 =>
         stExpect_bind (is_integer_constant_expression0 e1) (fun (b1 : Bool) =>
           lem_if b1 then is_integer_constant_expression0 e2 else stExpect_return false)
       | AilEcond e1 none e3 =>
         stExpect_bind (is_integer_constant_expression0 e1) (fun (b1 : Bool) =>
           lem_if b1 then /- TODO: this is too strict, it is allowed for the dead branch to not be a constant -/
             is_integer_constant_expression0 e3
           else
             stExpect_return false)
       | AilEcond e1 (some e2) e3 =>
         stExpect_bind (is_integer_constant_expression0 e1) (fun (b1 : Bool) =>
           lem_if b1 then
             stExpect_bind (is_integer_constant_expression0 e2) (fun (b2 : Bool) =>
               stExpect_bind (is_integer_constant_expression0 e3)
                 (fun (b3 :
                   Bool) => /- TODO: this is too strict, it is allowed for the dead branch to not be a constant -/
                   stExpect_return (b2 && b3)))
           else
             stExpect_return false)
       | AilEmemberof _ _ => stExpect_return false
       | AilEmemberofptr _ _ => stExpect_return false
       | AilEident _ => stExpect_return false
       | AilEgcc_statement _ _ =>
         (fun (_ : state_with_markers) =>
           fail0
             (loc1,
               DESUGAR
                 (Desugar_NotYetSupported "GNU statement as expression in constant expression")))
       | _ =>
         (failwithI
           (String.append "TODO: Cabs_to_ail.is_integer_constant_expression, wildcard ==> "
             (CerbPP.stringFromAil_expression expr1)) : state_with_markers → exceptM
           (Bool × state_with_markers) error))
/- STD §6.6#8 -/
/- TODO: this is super partial and hackish -/
/- TODO: I assume from the "shall only have operands" that arithmetic operations are allowed -/

partial def is_arithmetic_constant_expression (is_lvalue1 : Bool) (e : expression Unit) :
    state_with_markers → exceptM (Bool × state_with_markers) error :=
  match is_lvalue1, e with
  | is_lvalue1, ((AnnotatedExpression () _ loc1 expr1)) =>
    (match expr1 with
     | AilEconst (ConstantInteger _) => stExpect_return true
     | AilEconst (ConstantFloating _) => stExpect_return true
     | AilEconst (ConstantCharacter _) => stExpect_return true
     | AilEconst (ConstantPredefined PConstantFalse) => stExpect_return true
     | AilEconst (ConstantPredefined PConstantTrue) => stExpect_return true
     /-
    | AilEconst (ConstantArray _) ->
        /- NOTE: is Ail specific -/
        E.return true
-/
     | AilEident _ =>
       stExpect_return
         is_lvalue1 /- TODO: not sure about this! but I want to include enumerations -/
     | AilEannot _ e => is_arithmetic_constant_expression true e
     | AilEunary Address e => is_arithmetic_constant_expression true e
     | AilEunary _ e => is_arithmetic_constant_expression is_lvalue1 e
     | AilEbinary e1 _ e2 =>
       stExpect_bind (is_arithmetic_constant_expression is_lvalue1 e1) (fun (b1 : Bool) =>
         stExpect_bind (is_arithmetic_constant_expression is_lvalue1 e2) (fun (b2 : Bool) =>
           stExpect_return (b1 && b2)))
     | AilEsizeof _ ty1 => /- TODO: sizeof expressions whose results are integer constants -/
       stExpect_return (not (is_vla ty1))
     | AilEalignof _ _ => stExpect_return true
     | AilEcast _ ty1 e =>
       (lem_if not (is_arithmetic ty1) then
         stExpect_return false
       else
         stExpect_bind
           (stExpect_return
             (CerbDebug.print_debug_pure 2 [DB_desugaring] (fun (u : Unit) =>
               match u with
               | () =>
                 "WARNING[Cabs_to_ail.is_arithmetic_constant_expression] AilEcast: annoying ==> need to typecheck e...")))
           (fun (_ :
             Unit) => /-          E.return true -/ /- TODO: is_lvalue might be wrong depending on the type of e? -/
             is_arithmetic_constant_expression is_lvalue1 e))
     | AilEoffsetof _ _ => /- STD §7.19#3 -/ stExpect_return true
     | _ => stExpect_return false)
partial def is_lvalue_to_static_object (e : expression Unit) :
    state_with_markers → exceptM (Bool × state_with_markers) error :=
  match e with
  | (AnnotatedExpression () _ loc1 expr1) =>
    (match expr1 with
     | AilEident sym1 =>
       is_static_object_identifier
         sym1 /- The array-subscript [] and member-access . and -> operators, the address & and indirection * unary operators, and pointer casts may be used in the creation of an address constant, but the value of an object shall not be accessed by use of these operators. -/
     | AilEbinary e1 (Arithmetic Add0) e2 =>
       stExpect_bind
         (/- NOTE: this case corresponds to array-subcript -/ is_lvalue_to_static_object e1)
         (fun (b11 : Bool) =>
           stExpect_bind (is_arithmetic_constant_expression false /- TODO check -/ e1)
             (fun (b12 : Bool) =>
               stExpect_bind (is_lvalue_to_static_object e2) (fun (b21 : Bool) =>
                 stExpect_bind (is_arithmetic_constant_expression false /- TODO check -/ e2)
                   (fun (b22 : Bool) => stExpect_return ((b11 && b22) || (b12 && b21))))))
     | AilEmemberof e _ => /- TODO: not sure -/ is_lvalue_to_static_object e
     | AilEmemberofptr e _ => /- TODO: not sure -/ is_lvalue_to_static_object e
     | AilEcast _ ty1 e =>
       (/- TODO: check -/ lem_if not (is_pointer ty1) then
         stExpect_return false
       else
         is_lvalue_to_static_object e)
     | AilEstr _ =>
       /- String literals decay to a pointer to the start of an array of
           static storage duration (except when directly initialising an array,
           but this is not relevant here) -/
       stExpect_return true
     /- TODO
    | AilEmemberof e ident ->
-/
     | _ => stExpect_return false)
/- STD §6.6#9 -/

def is_address_constant (a_expr : expression Unit) :
    state_with_markers → exceptM (Bool × state_with_markers)
        error := /- TODO: not sure is_null_pointer_constant is the right predicate -/ /- An address constant (...) -/
  lem_if is_null_pointer_constant a_expr then /- (...) is a null pointer, -/
    stExpect_return true
  else
    match a_expr with
    | AnnotatedExpression () _ _ (AilEident sym1) =>
      stExpect_bind (is_function_designator sym1) (fun (x : Bool) =>
        match x with
        | true => stExpect_return true
        | false =>
          stExpect_bind (fetch_object_declaration sym1)
            (fun (p :
              (Bool × CerbLocation.Loc × storageDuration × Bool × Option alignment × qualifiers ×
                ctype)) =>
              match p with
              | (_, _, dur, _, _, _, ty1) =>
                (match dur with
                 | Static => stExpect_return (is_array ty1)
                 | _ => stExpect_return false)))
    | AnnotatedExpression () _ _ (AilEunary Address expr1) => is_lvalue_to_static_object expr1
    | AnnotatedExpression () _ _ (AilEcast _ _ expr1) =>
      stExpect_bind (is_lvalue_to_static_object expr1) (fun (x : Bool) =>
        match x with
        | true => stExpect_return true
        | false => is_integer_constant_expression0 expr1)
    | _ => stExpect_return false

/- As defined in STD §6.6#7, in the context of initializers, "constant expressions" 
   can have more things in them -/
/- TODO: "or evaluate to" -/

def is_initializer_constant_expression_or_string_literal0 (e : expression Unit) :
    state_with_markers → exceptM (Bool × state_with_markers) error :=
  match e with
  | a_expr@(AnnotatedExpression () _ loc1 expr1) =>
    stExpect_bind (is_arithmetic_constant_expression false /- TODO check -/ a_expr)
      (fun (b1 : Bool) =>
        stExpect_bind (is_address_constant a_expr)
          (fun (b2 : Bool) => /- STD §6.6#7, bullets 1 - 3 -/
            lem_if b1 || (is_null_pointer_constant a_expr || b2) then
              stExpect_return true /- STD §6.6#7, bullets 4 -/
            else
              match expr1 with
              | AilEbinary e1 (Arithmetic Add0) e2 =>
                stExpect_bind (is_address_constant e1) (fun (b11 : Bool) =>
                  stExpect_bind (is_integer_constant_expression0 e2) (fun (b12 : Bool) =>
                    stExpect_bind (is_address_constant e2) (fun (b21 : Bool) =>
                      stExpect_bind (is_integer_constant_expression0 e1) (fun (b22 : Bool) =>
                        stExpect_return ((b11 && b12) || (b21 && b22))))))
              | AilEbinary e1 (Arithmetic Sub0) e2 =>
                stExpect_bind (is_address_constant e1) (fun (b11 : Bool) =>
                  stExpect_bind (is_integer_constant_expression0 e2) (fun (b12 : Bool) =>
                    stExpect_bind (is_address_constant e2) (fun (b21 : Bool) =>
                      stExpect_bind (is_integer_constant_expression0 e1) (fun (b22 : Bool) =>
                        stExpect_return ((b11 && b12) || (b21 && b22))))))
              | AilEstr _ => stExpect_return true
              | _ => stExpect_return false))
