         stExpect_bind ((desugar_cn_pred _lemReader_enum_definitions _lemReader_tagDefs) pred1)
           (fun (pred1 : cn_pred sym ctype) =>
             stExpect_bind
               (stExpect_mapM (desugar_cn_expr _lemReader_enum_definitions _lemReader_tagDefs)
                 iargs)
               (fun (iargs : List (cn_expr sym ctype)) =>
                 stExpect_return (CN_to_from_bytes to_from1 pred1 iargs)))
