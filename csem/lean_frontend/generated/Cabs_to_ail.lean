  match c with
  | (CN_statement loc1 stmt_) =>
    stExpect_bind
      (match stmt_ with
       | CN_pack_unpack pack_unpack1 pred1 iargs =>
         stExpect_bind
           (/- copying from desugar_cn_resource -/ (desugar_cn_pred _lemReader_enum_definitions
             _lemReader_tagDefs) pred1)
           (fun (pred1 : cn_pred sym ctype) =>
             stExpect_bind
