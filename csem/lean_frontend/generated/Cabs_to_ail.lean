           (fun (preds_iargs : List (cn_pred sym ctype × Option (List (cn_expr sym ctype)))) =>
             stExpect_return (CN_derive_constraints preds_iargs)))
      (fun (stmt_ : cn_statement_ sym ctype) => stExpect_return (CN_statement loc1 stmt_))
