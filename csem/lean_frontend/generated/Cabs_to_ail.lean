def project_base_type_specifier (c : cabs_type_specifier) :
    Option (cabs_base_type_specifier × CerbLocation.Loc) :=
  match c with
  | (TSpec loc1 tspec) =>
    (match tspec with
     | TSpec_void => some (BTSpec_void, loc1)
     | TSpec_char => some (BTSpec_char, loc1)
     | TSpec_short => some (BTSpec_short, loc1)
     | TSpec_int => some (BTSpec_int, loc1)
     | TSpec_long => some (BTSpec_long, loc1)
     | TSpec_float => some (BTSpec_float, loc1)
     | TSpec_double => some (BTSpec_double, loc1)
     | TSpec_signed => some (BTSpec_signed, loc1)
     | TSpec_unsigned => some (BTSpec_unsigned, loc1)
     | TSpec_Bool => some (BTSpec_Bool, loc1)
     | TSpec_Complex => some (BTSpec_Complex, loc1)
     | _ => none)
partial def project_base_type_specifiers_aux
    (p : (List cabs_base_type_specifier × List CerbLocation.Loc)) :
    List cabs_type_specifier → Option (List cabs_base_type_specifier × List CerbLocation.Loc) :=
  match p with
  | (acc_bts, acc_locs) =>
    (fun (x : List cabs_type_specifier) =>
      match x with
      | [] => some (List.reverse acc_bts, acc_locs)
      | spec :: specs' =>
        (match project_base_type_specifier spec with
         | some (z, loc1) =>
           project_base_type_specifiers_aux ((z :: acc_bts), (loc1 :: acc_locs)) specs'
         | none => none))
def project_base_type_specifiers :
    List cabs_type_specifier → Option (List cabs_base_type_specifier × List CerbLocation.Loc) :=
  project_base_type_specifiers_aux
    (([] : List cabs_base_type_specifier), ([] : List CerbLocation.Loc))
