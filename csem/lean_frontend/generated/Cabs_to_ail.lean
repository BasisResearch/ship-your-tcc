         stExpect_bind (resolve_cn_ident CN_lemma l) (fun (l_resolved : (sym × cn_var_kind)) =>
           let l := ensure_not_c_variable l_resolved;
           stExpect_bind
             (stExpect_mapM (desugar_cn_expr _lemReader_enum_definitions _lemReader_tagDefs) args)
