  | Core_parser_unresolved_symbol : String → core_parser_cause
  | Core_parser_multiple_declaration : String → core_parser_cause
  | Core_parser_ctor_wrong_application : Int /- expected -/ → Int → core_parser_cause /- found -/
  | Core_parser_wrong_decl_in_std : core_parser_cause
  | Core_parser_unknown_ctype : String → core_parser_cause
  | Core_parser_undefined_startup : core_parser_cause
  | Core_parser_internal_error : String → core_parser_cause
export core_parser_cause (Core_lexer Core_parser_unexpected_token Core_parser_unresolved_symbol
    Core_parser_multiple_declaration Core_parser_ctor_wrong_application
    Core_parser_wrong_decl_in_std Core_parser_unknown_ctype Core_parser_undefined_startup
    Core_parser_internal_error)
instance : Inhabited core_parser_cause where
  default := Core_parser_wrong_decl_in_std
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def core_parser_cause.ctor_rank_ocaml : core_parser_cause → Nat
  | .Core_lexer _ => 2
  | .Core_parser_unexpected_token _ => 3
  | .Core_parser_unresolved_symbol _ => 4
  | .Core_parser_multiple_declaration _ => 5
  | .Core_parser_ctor_wrong_application _ _ => 6
  | .Core_parser_wrong_decl_in_std => 0
  | .Core_parser_unknown_ctype _ => 7
  | .Core_parser_undefined_startup => 1
  | .Core_parser_internal_error _ => 8
mutual
def core_parser_cause.beq_derived (cmpx_ cmpy_ : core_parser_cause) : Bool :=
  match cmpx_, cmpy_ with
  | .Core_lexer x1, .Core_lexer y1 => x1 == y1
  | .Core_parser_unexpected_token x1, .Core_parser_unexpected_token y1 => x1 == y1
  | .Core_parser_unresolved_symbol x1, .Core_parser_unresolved_symbol y1 => x1 == y1
  | .Core_parser_multiple_declaration x1, .Core_parser_multiple_declaration y1 => x1 == y1
  | .Core_parser_ctor_wrong_application x1 x2, .Core_parser_ctor_wrong_application y1 y2 =>
    x1 == y1 && x2 == y2
  | .Core_parser_wrong_decl_in_std, .Core_parser_wrong_decl_in_std => true
  | .Core_parser_unknown_ctype x1, .Core_parser_unknown_ctype y1 => x1 == y1
  | .Core_parser_undefined_startup, .Core_parser_undefined_startup => true
  | .Core_parser_internal_error x1, .Core_parser_internal_error y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def core_parser_cause.compare_derived (cmpx_ cmpy_ : core_parser_cause) : Ordering :=
  match cmpx_, cmpy_ with
  | .Core_lexer x1, .Core_lexer y1 => Ord.compare x1 y1
  | .Core_parser_unexpected_token x1, .Core_parser_unexpected_token y1 => Ord.compare x1 y1
  | .Core_parser_unresolved_symbol x1, .Core_parser_unresolved_symbol y1 => Ord.compare x1 y1
  | .Core_parser_multiple_declaration x1, .Core_parser_multiple_declaration y1 => Ord.compare x1 y1
  | .Core_parser_ctor_wrong_application x1 x2, .Core_parser_ctor_wrong_application y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .Core_parser_unknown_ctype x1, .Core_parser_unknown_ctype y1 => Ord.compare x1 y1
  | .Core_parser_internal_error x1, .Core_parser_internal_error y1 => Ord.compare x1 y1
  | xg, yg =>
    Ord.compare (core_parser_cause.ctor_rank_ocaml xg) (core_parser_cause.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

