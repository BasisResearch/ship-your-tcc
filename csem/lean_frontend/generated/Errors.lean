inductive cparser_cause : Type where
  | Cparser_invalid_symbol : cparser_cause
  | Cparser_invalid_string_character : cparser_cause
  | Cparser_invalid_line_number : String → cparser_cause
  | Cparser_unexpected_eof : cparser_cause
  | Cparser_unexpected_token : String → cparser_cause
  | Cparser_non_standard_string_concatenation : cparser_cause
  | Cparser_extra_semi : extra_semi_context → cparser_cause
  | Cparser_KnR_declaration : cparser_cause /- we don't support K&R syntax for declarations -/
  | Cparser_nested_comment : cparser_cause
  | Cparser_unterminated_comment : String → cparser_cause
  | Cparser_mismatched_magic_comment : cparser_cause
  | Cparser_experimental_keyword : String → cparser_cause
  | Cparser_unimplemented_keyword : String → cparser_cause
  | Cparser_deprecated_keyword : String → String → cparser_cause
export cparser_cause (Cparser_invalid_symbol Cparser_invalid_string_character
    Cparser_invalid_line_number Cparser_unexpected_eof Cparser_unexpected_token
    Cparser_non_standard_string_concatenation Cparser_extra_semi Cparser_KnR_declaration
    Cparser_nested_comment Cparser_unterminated_comment Cparser_mismatched_magic_comment
    Cparser_experimental_keyword Cparser_unimplemented_keyword Cparser_deprecated_keyword)
instance : Inhabited cparser_cause where
  default := Cparser_invalid_symbol
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def cparser_cause.ctor_rank_ocaml : cparser_cause → Nat
  | .Cparser_invalid_symbol => 0
  | .Cparser_invalid_string_character => 1
  | .Cparser_invalid_line_number _ => 7
  | .Cparser_unexpected_eof => 2
  | .Cparser_unexpected_token _ => 8
  | .Cparser_non_standard_string_concatenation => 3
  | .Cparser_extra_semi _ => 9
  | .Cparser_KnR_declaration => 4
  | .Cparser_nested_comment => 5
  | .Cparser_unterminated_comment _ => 10
  | .Cparser_mismatched_magic_comment => 6
  | .Cparser_experimental_keyword _ => 11
  | .Cparser_unimplemented_keyword _ => 12
  | .Cparser_deprecated_keyword _ _ => 13
mutual
def cparser_cause.beq_derived (cmpx_ cmpy_ : cparser_cause) : Bool :=
  match cmpx_, cmpy_ with
  | .Cparser_invalid_symbol, .Cparser_invalid_symbol => true
  | .Cparser_invalid_string_character, .Cparser_invalid_string_character => true
  | .Cparser_invalid_line_number x1, .Cparser_invalid_line_number y1 => x1 == y1
  | .Cparser_unexpected_eof, .Cparser_unexpected_eof => true
  | .Cparser_unexpected_token x1, .Cparser_unexpected_token y1 => x1 == y1
  | .Cparser_non_standard_string_concatenation, .Cparser_non_standard_string_concatenation => true
  | .Cparser_extra_semi x1, .Cparser_extra_semi y1 => x1 == y1
  | .Cparser_KnR_declaration, .Cparser_KnR_declaration => true
  | .Cparser_nested_comment, .Cparser_nested_comment => true
  | .Cparser_unterminated_comment x1, .Cparser_unterminated_comment y1 => x1 == y1
  | .Cparser_mismatched_magic_comment, .Cparser_mismatched_magic_comment => true
  | .Cparser_experimental_keyword x1, .Cparser_experimental_keyword y1 => x1 == y1
  | .Cparser_unimplemented_keyword x1, .Cparser_unimplemented_keyword y1 => x1 == y1
  | .Cparser_deprecated_keyword x1 x2, .Cparser_deprecated_keyword y1 y2 => x1 == y1 && x2 == y2
  | _, _ => false
termination_by structural cmpx_
def cparser_cause.compare_derived (cmpx_ cmpy_ : cparser_cause) : Ordering :=
  match cmpx_, cmpy_ with
  | .Cparser_invalid_line_number x1, .Cparser_invalid_line_number y1 => Ord.compare x1 y1
  | .Cparser_unexpected_token x1, .Cparser_unexpected_token y1 => Ord.compare x1 y1
  | .Cparser_extra_semi x1, .Cparser_extra_semi y1 => Ord.compare x1 y1
  | .Cparser_unterminated_comment x1, .Cparser_unterminated_comment y1 => Ord.compare x1 y1
  | .Cparser_experimental_keyword x1, .Cparser_experimental_keyword y1 => Ord.compare x1 y1
  | .Cparser_unimplemented_keyword x1, .Cparser_unimplemented_keyword y1 => Ord.compare x1 y1
  | .Cparser_deprecated_keyword x1 x2, .Cparser_deprecated_keyword y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | xg, yg => Ord.compare (cparser_cause.ctor_rank_ocaml xg) (cparser_cause.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq cparser_cause where
  beq := cparser_cause.beq_derived
instance : Ord cparser_cause where
  compare := cparser_cause.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType cparser_cause where
  setElemCompare x y :=
    match cparser_cause.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 cparser_cause where
  isEqual := cparser_cause.beq_derived
  isInequal x y := !(cparser_cause.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 cparser_cause where
  compare x y :=
    match cparser_cause.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match cparser_cause.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match cparser_cause.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match cparser_cause.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match cparser_cause.compare_derived x y with
    | .lt => false
    | _ => true

