partial def eq_genIntegerType (gity1 : genIntegerType) (gity2 : genIntegerType) : Bool :=
  let ord : genIntegerType → Nat :=
    fun (x : genIntegerType) =>
      match x with
      | Concrete _ => (0 : Nat)
      | SizeT => 1
      | PtrdiffT => 2
      | PtraddrT => 3
      | Unknown _ => 4
      | Promote _ => 5
      | Usual _ _ => 6;
  match gity1, gity2 with
  | Concrete ity1, Concrete ity2 => integerTypeEqual ity1 ity2
  | Unknown iCst1, Unknown iCst2 => iCst1 == iCst2
  | Promote gity1, Promote gity2 => eq_genIntegerType gity1 gity2
  | Usual gity11 gity21, Usual gity12 gity22 =>
    eq_genIntegerType gity11 gity12 && eq_genIntegerType gity21 gity22
  | _, _ => ord gity1 == ord gity2

instance : Eq0 genIntegerType where

    isEqual := eq_genIntegerType

    isInequal := fun git1 git2 => not (eq_genIntegerType git1 git2)

def eq_genBasicType (gbty1 : genBasicType) (gbty2 : genBasicType) : Bool :=
  match gbty1, gbty2 with
  | GenInteger gity1, GenInteger gity2 => eq_genIntegerType gity1 gity2
  | GenFloating fty1, GenFloating fty2 => fty1 == fty2
  | _, _ => false

instance : Eq0 genBasicType where

    isEqual := eq_genBasicType

    isInequal := fun gbty1 gbty2 => not (eq_genBasicType gbty1 gbty2)

partial def eq_genType (gty1 : genType) (gty2 : genType) : Bool :=
  let ord : genType → Nat :=
    fun (x : genType) =>
      match x with
      | GenVoid => (0 : Nat)
      | GenBasic _ => 1
      | GenArray _ _ => 2
      | GenFunction _ _ _ => 3
      | GenFunctionNoParams _ => 4
      | GenPointer _ _ => 5
      | GenStruct _ => 6
      | GenUnion _ => 7
      | GenAtomic _ => 8
      | GenByte => 9;
  match gty1, gty2 with
  | GenBasic gbty1, GenBasic gbty2 => eq_genBasicType gbty1 gbty2
  | GenArray ty1 n1_opt, GenArray ty2 n2_opt =>
    ctypeEqual ty1 ty2 && (maybeEqualBy (fun x y => x == y) n1_opt n2_opt)
  | GenFunction (qs1, ty1) params1 b1, GenFunction (qs2, ty2) params2 b2 =>
    qualifiersEqual qs1 qs2 &&
      (ctypeEqual ty1 ty2 &&
        ((listEqualBy (@tripleEqual qualifiers ctype Bool _ _ _) params1 params2) && (b1 == b2)))
  | GenFunctionNoParams (qs1, ty1), GenFunctionNoParams (qs2, ty2) =>
    qualifiersEqual qs1 qs2 && ctypeEqual ty1 ty2
  | GenPointer qs1 ty1, GenPointer qs2 ty2 => qualifiersEqual qs1 qs2 && ctypeEqual ty1 ty2
  | GenStruct tag1, GenStruct tag2 =>
    (match tag1, tag2 with
     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
         lem_if natGteb 0 5 && (sd1 != sd2) then
           (lemSeq
             (fun _ =>
               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                 match u with
                 | () =>
                   String.append "[Symbol.symbolEqual] suspicious equality ==> "
                     (String.append (show_symbol_description sd1)
                       (String.append " <-> " (show_symbol_description sd2))))) (fun _ => true))
         else
           true
       else
         false))
  | GenUnion tag1, GenUnion tag2 =>
    (match tag1, tag2 with
     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
         lem_if natGteb 0 5 && (sd1 != sd2) then
           (lemSeq
             (fun _ =>
               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                 match u with
                 | () =>
                   String.append "[Symbol.symbolEqual] suspicious equality ==> "
                     (String.append (show_symbol_description sd1)
                       (String.append " <-> " (show_symbol_description sd2))))) (fun _ => true))
         else
           true
       else
         false))
  | GenAtomic gty1, GenAtomic gty2 => eq_genType gty1 gty2
  | _, _ => ord gty1 == ord gty2

instance : Eq0 genType where

    isEqual := eq_genType

    isInequal := fun gty1 gty2 => not (eq_genType gty1 gty2)

def eq_genTypeCategory (gentyCat1 : genTypeCategory) (gentyCat2 : genTypeCategory) : Bool :=
  let ord : genTypeCategory → Nat :=
    fun (x : genTypeCategory) =>
      match x with
      | GenLValueType _ _ _ => (0 : Nat)
      | GenRValueType _ => 1;
  match gentyCat1, gentyCat2 with
  | GenLValueType qs1 ty1 isRegister1, GenLValueType qs2 ty2 isRegister2 =>
    qualifiersEqual qs1 qs2 && (ctypeEqual ty1 ty2 && (isRegister1 == isRegister2))
  | GenRValueType gty1, GenRValueType gty2 => eq_genType gty1 gty2
  | _, _ => ord gentyCat1 == ord gentyCat2

instance : Eq0 genTypeCategory where

    isEqual := eq_genTypeCategory

