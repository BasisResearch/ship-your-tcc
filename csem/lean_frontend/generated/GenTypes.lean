def inject_integerType (ity : integerType) : genIntegerType := Concrete ity
def inject_basicType : basicType → genBasicType :=
  fun (x : basicType) =>
    match x with
    | Integer ity => GenInteger (inject_integerType ity)
    | Floating fty => GenFloating fty

partial def inject_type (c : ctype) : genType :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Void0 => GenVoid
     | Basic bty => GenBasic (inject_basicType bty)
     | Pointer qs ty1 => GenPointer qs ty1
     | Array0 ty1 n_opt => GenArray ty1 n_opt
     | Function qs_ty params b => GenFunction qs_ty params b
     | FunctionNoParams qs_ty => GenFunctionNoParams qs_ty
     | Atomic ty1 => GenAtomic (inject_type ty1)
     | Struct tag => GenStruct tag
     | Union0 tag => GenUnion tag
     | Byte => GenByte)
def inject_typeCategory : typeCategory → genTypeCategory :=
  fun (x : typeCategory) =>
    match x with
    | LValueType qs ty1 isRegister => GenLValueType qs ty1 isRegister
    | RValueType ty1 => GenRValueType (inject_type ty1)

