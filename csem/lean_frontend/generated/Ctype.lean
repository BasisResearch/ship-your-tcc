/- STD §6.2.5#14, sentence 3 -/
def basicTypeEqual (bty1 : basicType) (bty2 : basicType) : Bool :=
  let ord : basicType → Nat :=
    fun (x : basicType) =>
      match x with
      | Integer _ => (0 : Nat)
      | Floating _ => 1;
  match bty1, bty2 with
  | Integer ity1, Integer ity2 => integerTypeEqual ity1 ity2
  | Floating fty1, Floating fty2 => fty1 == fty2
  | _, _ => ord bty1 == ord bty2

instance : Eq0 basicType where

    isEqual := basicTypeEqual

    isInequal := fun bty1 bty2 => not (basicTypeEqual bty1 bty2)

def qualifiersEqual (qs1 : qualifiers) (qs2 : qualifiers) : Bool :=
  (qs1.const == qs2.const) && ((qs1.restrict == qs2.restrict) && (qs1.volatile == qs2.volatile))

instance : Eq0 qualifiers where

    isEqual := qualifiersEqual

    isInequal := fun qs1 qs2 => not (qualifiersEqual qs1 qs2)

def ctypeEqual_lemFuel (lemFuel : Nat) (c : ctype) (c0 : ctype) : Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match c, c0 with
     | (Ctype _ ty1), (Ctype _ ty2) =>
       (let ord : ctype_ → Nat :=
          fun (x : ctype_) =>
            match x with
            | Void0 => (0 : Nat)
            | Basic _ => 1
            | Array0 _ _ => 2
            | Function _ _ _ => 3
            | FunctionNoParams _ => 4
            | Pointer _ _ => 5
            | Atomic _ => 6
            | Struct _ => 7
            | Union0 _ => 8
            | Byte => 9;
        let paramsEqual : (qualifiers × ctype × Bool) → (qualifiers × ctype × Bool) → Bool :=
          (fun (p : (qualifiers × ctype × Bool)) (p0 : (qualifiers × ctype × Bool)) =>
            match p, p0 with
            | (qs1, ty1, b1), (qs2, ty2, b2) =>
              qualifiersEqual qs1 qs2 && ((ctypeEqual_lemFuel lemFuel) ty1 ty2 && (b1 == b2)));
        match ty1, ty2 with
        | Basic bty1, Basic bty2 => basicTypeEqual bty1 bty2
        | Array0 ty1 n1_opt, Array0 ty2 n2_opt =>
          (ctypeEqual_lemFuel lemFuel) ty1 ty2 && (maybeEqualBy (fun x y => x == y) n1_opt n2_opt)
        | Function (qs1, ty1) params1 b1, Function (qs2, ty2) params2 b2 =>
          qualifiersEqual qs1 qs2 &&
            ((ctypeEqual_lemFuel lemFuel) ty1 ty2 &&
              (List.all (lemListZip params1 params2) (uncurry paramsEqual) && (b1 == b2)))
        | FunctionNoParams (qs1, ty1), FunctionNoParams (qs2, ty2) =>
          qualifiersEqual qs1 qs2 && (ctypeEqual_lemFuel lemFuel) ty1 ty2
        | Atomic ty1, Atomic ty2 => (ctypeEqual_lemFuel lemFuel) ty1 ty2
        | Struct id1, Struct id2 =>
          (match id1, id2 with
           | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
             (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
               lem_if natGteb 0 5 && (sd1 != sd2) then
                 (lemSeq
                   (fun _ =>
                     CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                       match u with
                       | () =>
                         String.append "[Symbol.symbolEqual] suspicious equality ==> "
                           (String.append (show_symbol_description sd1)
                             (String.append " <-> " (show_symbol_description sd2)))))
                   (fun _ => true))
               else
                 true
             else
               false))
        | Union0 id1, Union0 id2 =>
          (match id1, id2 with
           | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
             (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
               lem_if natGteb 0 5 && (sd1 != sd2) then
                 (lemSeq
                   (fun _ =>
                     CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                       match u with
                       | () =>
                         String.append "[Symbol.symbolEqual] suspicious equality ==> "
                           (String.append (show_symbol_description sd1)
                             (String.append " <-> " (show_symbol_description sd2)))))
                   (fun _ => true))
               else
                 true
             else
               false))
        | _, _ => ord ty1 == ord ty2))

def ctypeEqual (c : ctype) (c0 : ctype) : Bool := ctypeEqual_lemFuel (ctype.lemSize c) c c0
theorem ctypeEqual_lemFuel_zero (c : ctype) (c0 : ctype) :
    ctypeEqual_lemFuel 0 c c0 = (fuelExhausted false) :=
  rfl

