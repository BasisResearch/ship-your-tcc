                      (match ident with
                       | Identifier _ str => str) "; ")) "[" tag_defs) "]");
      match «def» with
      | StructDef _ tag_defs none => string_of_identifiers tag_defs
      | StructDef _ tag_defs (some (FlexibleArrayMember attrs1 ident qs elem_ty)) =>
        (let ty1 := Ctype ([] : List annot) (Array0 elem_ty none);
         string_of_identifiers (tag_defs ++ [(ident, (attrs1, none, qs, ty1))]))
      | UnionDef _ tag_defs => string_of_identifiers tag_defs

/- * Some useful functions -/

def proj_ctype_ (c : ctype) : ctype_ :=
  match c with
  | (Ctype _ ty_) => ty_

/- NOTE: a well-formed ctype cannot have an Atomic directly inside another one -/
def unatomic (c : ctype) : ctype :=
  match c with
  | ty1@(Ctype annots1 ty_) =>
    (match ty_ with
     | Atomic ty1 => ty1
     | _ => ty1)

def unatomic_ (ty1 : ctype) : ctype_ := proj_ctype_ (unatomic ty1)
def make_qualifiers (c : Bool) (r : Bool) (v : Bool) : qualifiers :=
  (({ const := c, restrict := r, volatile := v } : qualifiers))
def no_qualifiers : qualifiers :=
  (({ const := false, restrict := false, volatile := false } : qualifiers))
def combine_qualifiers (qs1 : qualifiers) (qs2 : qualifiers) : qualifiers :=
  (({ const := (qs1.const || qs2.const),
      restrict := (qs1.restrict || qs2.restrict),
      volatile := (qs1.volatile || qs2.volatile) } : qualifiers))

/- Some constructors -/

def mk_ctype_pointer (qs : qualifiers) (ty1 : ctype) : ctype :=
  Ctype ([] : List annot) (Pointer qs ty1)

def mk_ctype_integer (ity : integerType) : ctype := Ctype ([] : List annot) (Basic (Integer ity))

def mk_ctype_atomic (c : ctype) : ctype :=
  match c with
  | cty@(Ctype _ ty_) =>
    (let invalid :=
       match ty_ with
       | Array0 _ _ => true
       | Function _ _ _ => true
       | FunctionNoParams _ => true
       | Atomic _ => true
       | _ => false;
     lem_if invalid then
       (failwithI "Ctyp.mk_ctype_atomic: called on an invalid inner type" : ctype)
     else
       Ctype ([] : List annot) (Atomic cty))
