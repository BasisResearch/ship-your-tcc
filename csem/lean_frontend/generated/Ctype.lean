/- C11 6.7.2.1p13: an anonymous member is a physical subobject.  An
   unspellable attribute marks promotion; printable field names keep Core
   text interoperable.  A source field that resembles the internal name is
   still an ordinary named field. -/
/- Attribute identifiers containing ':' cannot be supplied by the C grammar.
   Keep trusted IR operations separate from public source name resolution. -/
def has_internal_attribute (name1 : String) (a : attributes) : Bool :=
  match name1, a with
  | name1, (Attrs attrs1) =>
    List.any attrs1 (fun (attr : attribute0) =>
      idEqual attr.attr_id (Identifier CerbLocation.unknown name1))

def add_internal_attribute (name1 : String) (attrs1 : attributes) : attributes :=
  combine_attributes attrs1
    (Attrs
      [(({ attr_ns := none,
           attr_id := (Identifier CerbLocation.unknown name1),
           attr_args :=
             ([] : List (CerbLocation.Loc × String × List (CerbLocation.Loc × String))) } :
        attribute0))])

def gnu_decimal (str : String) : Option Int :=
  let cs := String.toList str;
  lem_if List.isEmpty cs then
    none
  else
    List.foldl
      (fun (acc : Option Int) (c : Char) =>
        match acc with
        | none => none
        | some n =>
          (match String.ofList [c] with
           | "0" => some ((10 : Int) * n)
           | "1" => some (((10 : Int) * n) + (1 : Int))
           | "2" => some (((10 : Int) * n) + (2 : Int))
           | "3" => some (((10 : Int) * n) + (3 : Int))
           | "4" => some (((10 : Int) * n) + (4 : Int))
           | "5" => some (((10 : Int) * n) + (5 : Int))
           | "6" => some (((10 : Int) * n) + (6 : Int))
           | "7" => some (((10 : Int) * n) + (7 : Int))
           | "8" => some (((10 : Int) * n) + (8 : Int))
           | "9" => some (((10 : Int) * n) + (9 : Int))
           | _ => none)) (some ((0 : Int) : Int)) cs

/- C11 6.7.2.1: bit-fields are members, not addressable scalar objects.
   The unspellable carrier follows the existing internal physical-member and
   typedef-alignment carriers. All consumers use this named-field view. -/
structure bitfield_info where
  bitfield_width : Nat
  bitfield_named : Bool
  bitfield_byte_offset : Nat
  bitfield_bit_offset : Nat
  deriving BEq, Ord
instance : Inhabited bitfield_info where
  default :=
    { bitfield_width := default,
      bitfield_named := default,
      bitfield_byte_offset := default,
      bitfield_bit_offset := default }
instance (priority := 500) : Lem_Basic_classes.SetType bitfield_info where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 bitfield_info where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 bitfield_info where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

def bitfield_of_annotations (annots1 : List annot) : Option bitfield_info :=
  List.foldl
    (fun (acc : Option bitfield_info) (annot1 : annot) =>
      match annot1 with
      | Aattrs (Attrs attrs1) =>
        List.foldl
          (fun (acc : Option bitfield_info) (attr : attribute0) =>
            match attr.attr_id with
            | Identifier _ name1 =>
              (lem_if (name1 == ":bitfield:") && isNothing attr.attr_ns then
                match attr.attr_args with
                | [(_, w, _), (_, n, _), (_, b, _), (_, s, _)] =>
                  (match gnu_decimal w, gnu_decimal b, gnu_decimal s with
                   | some w, some b, some s =>
                     some
                       (({ bitfield_width := (Int.natAbs (lemIntFromInteger w)),
                           bitfield_named := (n == "1"),
                           bitfield_byte_offset := (Int.natAbs (lemIntFromInteger b)),
                           bitfield_bit_offset := (Int.natAbs (lemIntFromInteger s)) } :
                         bitfield_info))
                   | _, _, _ => acc)
                | _ => acc
              else
                acc)) acc attrs1
      | _ => acc) none annots1

def bitfield_of_type (c : ctype) : Option bitfield_info :=
  match c with
  | (Ctype annots1 _) => bitfield_of_annotations annots1

def clear_bitfield_annotations (annots1 : List annot) : List annot :=
  List.map
    (fun (annot1 : annot) =>
      match annot1 with
      | Aattrs (Attrs attrs1) =>
        Aattrs
          (Attrs
            (List.filter
              (fun (attr : attribute0) =>
                match attr.attr_id with
                | Identifier _ n => not (n == ":bitfield:")) attrs1))
      | _ => annot1) annots1

def with_bitfield (info : bitfield_info) (c : ctype) : ctype :=
  match info, c with
  | info, (Ctype annots1 ty1) =>
    (let arg : Nat → (CerbLocation.Loc × String × List (CerbLocation.Loc × String)) :=
       (fun (n : Nat) =>
         (CerbLocation.unknown, Lem_String_extra.stringFromNat n,
           ([] : List (CerbLocation.Loc × String))));
     Ctype
       (Aattrs
         (Attrs
           [(({ attr_ns := none,
                attr_id := (Identifier CerbLocation.unknown ":bitfield:"),
                attr_args :=
                  [arg info.bitfield_width, arg (lem_if info.bitfield_named then (1 : Nat) else 0),
                    arg info.bitfield_byte_offset, arg info.bitfield_bit_offset] } :
             attribute0))]) :: clear_bitfield_annotations annots1) ty1)

def without_bitfield (c : ctype) : ctype :=
  match c with
  | (Ctype annots1 ty1) => Ctype (clear_bitfield_annotations annots1) ty1

def is_unnamed_bitfield (ty1 : ctype) : Bool :=
  match bitfield_of_type ty1 with
  | some info => not info.bitfield_named
  | none => false

def volatile_access_type (qs : qualifiers) (c : ctype) : ctype :=
  match qs, c with
  | qs, cty@(Ctype annots1 ty1) =>
    (lem_if qs.volatile then
      Ctype (Aattrs (add_internal_attribute ":volatile-access:" no_attributes) :: annots1) ty1
    else
      cty)

def is_volatile_access (c : ctype) : Bool :=
  match c with
  | (Ctype annots1 _) =>
    maybe0 false (has_internal_attribute ":volatile-access:") (get_attrs annots1)

def bitfield_span (info : bitfield_info) : Nat :=
  lemNatDiv ((info.bitfield_bit_offset + info.bitfield_width) + 7) 8

/- PCC little-endian allocation policy, independently of C expression rules.
   A packed field may cross its base-type unit. Zero width ignores packing.
   Byte offsets are relative to this physical container, never its parent. -/
structure bitfield_cursor where
  bitfield_next_byte : Nat
  bitfield_next_bit : Nat
  deriving BEq, Ord
instance : Inhabited bitfield_cursor where
  default := { bitfield_next_byte := default, bitfield_next_bit := default }
instance (priority := 500) : Lem_Basic_classes.SetType bitfield_cursor where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 bitfield_cursor where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 bitfield_cursor where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def bitfield_round (n : Nat) (a : Nat) : Nat :=
  lem_if lemNatMod n a == 0 then n else (n + a) - lemNatMod n a
def place_bitfield (is_union2 : Bool) (packed : Bool) (explicit_alignment : Bool) (size : Nat)
    (align : Nat) (width_opt : Option Nat) (cursor1 : bitfield_cursor) :
    (Nat × Nat × bitfield_cursor) :=
  let c := cursor1.bitfield_next_byte;
  let p := cursor1.bitfield_next_bit;
  match width_opt with
  | none =>
    (let off := lem_if is_union2 then 0 else bitfield_round (c + lemNatDiv (p + 7) 8) align;
     (off, 0, (({ bitfield_next_byte := (off + size), bitfield_next_bit := 0 } : bitfield_cursor))))
  | some width =>
    (let fresh1 :=
       (width == 0) ||
         (explicit_alignment ||
           (not packed &&
             (natGtb
               (lemNatDiv (((lemNatMod ((c * 8) + p) (align * 8) + width) + (align * 8)) - 1)
                 (align * 8)) (lemNatDiv size align))));
     let c :=
       lem_if is_union2 then
         0
       else lem_if fresh1 then bitfield_round (c + lemNatDiv (p + 7) 8) align else c;
     let p := lem_if is_union2 || fresh1 then 0 else p;
     let off := c + ((lemNatDiv p (align * 8)) * align);
     let shift := lemNatMod p (align * 8);
     (off, shift,
       (({ bitfield_next_byte := off, bitfield_next_bit := (shift + width) } : bitfield_cursor))))

def is_anonymous_member (attrs1 : attributes) : Bool :=
  has_internal_attribute ":anonymous-member:" attrs1
def anonymous_member_attributes (attrs1 : attributes) : attributes :=
  add_internal_attribute ":anonymous-member:" attrs1
def physical_member_annotations : List annot :=
  [Aattrs (add_internal_attribute ":physical-member-operation:" (Attrs ([] : List attribute0)))]
def is_physical_member_operation (annots1 : List annot) : Bool :=
  match get_attrs annots1 with
  | some attrs1 => has_internal_attribute ":physical-member-operation:" attrs1
  | none => false

def name_anonymous_members (reserved : List identifier)
    (members : List (identifier × (attributes × Option alignment × qualifiers × ctype))) :
    List (identifier × (attributes × Option alignment × qualifiers × ctype)) :=
  /- Longer than every declared name, and unique by member index.  This is
     local to a tag: a later declaration cannot capture an earlier name. -/
  let width :=
    List.foldl
      (fun (n : Nat) (i : identifier) =>
        match n, i with
        | n, (Identifier _ name1) => natMax n (String.length name1)) 0
      (List.map Prod.fst members ++ reserved);
  List.map
    (fun (p : (Nat × (identifier × (attributes × Option alignment × qualifiers × ctype)))) =>
      match p with
      | (n, (ident, data)) =>
        (match ident with
         | Identifier loc1 name1 =>
           (match data with
            | (attrs1, _, _, _) =>
              (Identifier loc1
                (lem_if is_anonymous_member attrs1 || is_unnamed_bitfield
                    (match data with
                     | (_, _, _, ty1) => ty1) then
                  String.append (stringMakeString (width + 1) '_')
                    (String.append "cerb_anon_" (Lem_String_extra.stringFromNat n))
                else
                  name1), data)))) (numerote members)

structure member_path where
  member_path_visible : Bool
  member_path_steps : List (identifier × qualifiers × ctype)
  deriving BEq, Ord
instance : Inhabited member_path where
  default := { member_path_visible := default, member_path_steps := default }
instance (priority := 500) : Lem_Basic_classes.SetType member_path where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 member_path where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 member_path where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def member_paths (depth : Nat)
    (members : sym → List (identifier × (attributes × Option alignment × qualifiers × ctype)))
    (ty1 : ctype) :
    List (identifier × member_path) :=
  /- A complete by-value member chain cannot repeat a tag.  Callers supply
     one plus the number of definitions.  Bounded iteration keeps this helper
     total on malformed cyclic tables too, with no native or partial seam. -/
  let paths :=
    List.foldl
      (fun (paths : ctype → List (identifier × member_path)) (_ : Unit) =>
        fun (parent_ty : ctype) =>
          let xs :=
            match unatomic_ parent_ty with
            | Struct tag => members tag
            | Union0 tag => members tag
            | _ => ([] : List (identifier × (attributes × Option alignment × qualifiers × ctype)));
          List.flatten
            (List.map
              (fun (p : (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
                match p with
                | (ident, (attrs1, _, qs, child_ty)) =>
                  (let step1 := (ident, qs, child_ty);
                   (ident,
                     (({ member_path_visible :=
                           (not (is_anonymous_member attrs1) && not (is_unnamed_bitfield child_ty)),
                         member_path_steps := [step1] } : member_path))) ::
                     (lem_if is_anonymous_member attrs1 then
                       List.map
                         (fun (p : (identifier × member_path)) =>
                           match p with
                           | (name1, path) =>
                             (name1,
                               { path with member_path_steps := step1 :: path.member_path_steps }))
                         (paths child_ty)
                     else
                       ([] : List (identifier × member_path))))) xs))
      (fun (_ : ctype) => ([] : List (identifier × member_path))) (List.replicate depth ());
  paths ty1

/- GNU typedef alignment changes alignment alone: sizeof(T) remains the
   underlying sizeof, unlike aggregate alignment's trailing padding. The
   unspellable internal attribute is a typed translation artifact, not a
   public field or an additional allocation. Readers consume it explicitly. -/

def gnu_align_typedef { a : Type } [Show a] (alignment1 : Option a) (ty1 : ctype) : ctype :=
  match alignment1, ty1 with
  | none, _ => ty1
  | some n, Ctype annots1 ty1 =>
    Ctype
      (Aattrs
        (Attrs
          [(({ attr_ns := none,
               attr_id := (Identifier CerbLocation.unknown ":gnu-typedef-alignment:"),
               attr_args :=
                 [(CerbLocation.unknown, show0 n, ([] : List (CerbLocation.Loc × String)))] } :
            attribute0))]) :: annots1) ty1

def gnu_typedef_alignment (annots1 : List annot) : Option Int :=
  List.foldl
    (fun (acc : Option Int) (annot1 : annot) =>
      match annot1 with
      | Aattrs (Attrs xs) =>
        List.foldl
          (fun (acc : Option Int) (attr : attribute0) =>
            match attr.attr_id with
            | Identifier _ name1 =>
              (lem_if (name1 == ":gnu-typedef-alignment:") && isNothing attr.attr_ns then
                match acc, attr.attr_args with
                | none, [(_, str, _)] => gnu_decimal str
                | _, _ => acc
              else
                acc)) acc xs
      | _ => acc) none annots1

/- Deriving a pointer from an array/function expression resets its outer
   alias alignment, while preserving every other annotation and the referent. -/
def gnu_clear_typedef_alignment (annots1 : List annot) : List annot :=
  List.map
    (fun (x : annot) =>
      match x with
      | Aattrs (Attrs attrs1) =>
        Aattrs
          (Attrs
            (List.filter
              (fun (attr : attribute0) =>
                match attr.attr_id with
                | Identifier _ name1 =>
                  not ((name1 == ":gnu-typedef-alignment:") && isNothing attr.attr_ns)) attrs1))
      | annot1 => annot1) annots1

/- The tag owns these effects. Member alignments are kept independently: GNU
   expression-alignof can observe the distinction. Validation is performed by
   the shared Cabs elaborator before the attributes reach this projection. -/
def aggregate_layout_of_attributes (a : attributes) : aggregate_layout :=
  match a with
  | (Attrs attrs1) =>
    List.foldl
      (fun (layout : aggregate_layout) (attr : attribute0) =>
        let ns :=
          maybe0 ""
            (fun (i : identifier) =>
              match i with
              | (Identifier _ s) => s) attr.attr_ns;
        match attr.attr_id with
        | Identifier _ name1 =>
          (lem_if (ns == "__attribute") || ((ns == "__attribute__") || (ns == "gnu")) then
            lem_if (name1 == "packed") || (name1 == "__packed__") then
              { layout with aggregate_packed := true }
            else lem_if (name1 == "aligned") || (name1 == "__aligned__") then
              let n :=
                match attr.attr_args with
                | [] => some ((16 : Int) : Int) /- cfgTcc's maximum alignment -/
                | [(_, str, _)] => gnu_decimal str
                | _ => none;
              { layout with
                aggregate_alignment :=
                  match layout.aggregate_alignment, n with
                  | none, _ => n
                  | _, none => layout.aggregate_alignment
                  | some old, some n => some (max old n) }
            else
              layout
          else
            layout)) no_aggregate_layout attrs1

def effective_member_alignment (packed : Bool) (alignment1 : Option alignment) : Option alignment :=
  lem_if packed && isNothing alignment1 then some (AlignInteger ((1 : Int))) else alignment1

def aggregate_align (layout : aggregate_layout) (natural1 : Nat) : Nat :=
  maybe0 natural1 (fun (n : Int) => natMax natural1 (Int.natAbs (lemIntFromInteger n)))
    layout.aggregate_alignment

def effective_aggregate_members { a b c d : Type } (packed : Bool)
    (members : List (a × (c × Option alignment × b × d))) :
    List (a × (c × Option alignment × b × d)) :=
  List.map
    (fun (p : (a × (c × Option alignment × b × d))) =>
      match p with
      | (ident, (attrs1, al, qs, ty1)) =>
        (ident, (attrs1, effective_member_alignment packed al, qs, ty1))) members
