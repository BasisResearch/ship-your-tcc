instance : Show tag_definition where

    show0 «def» :=
      let string_of_identifiers : List
        (identifier × (attributes × Option alignment × qualifiers × ctype)) → String :=
        (fun tag_defs =>
          String.append
            (List.foldl
              (fun acc p =>
                match acc, p with
                | acc, (ident, _) =>
                  String.append acc
