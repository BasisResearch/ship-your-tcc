                    | External =>
                      ((lemSeq
                        (fun _ =>
                          CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
                            match u with
                            | () => "KKK: check this")) (fun _ => acc))))
                  ((fmapRangeBy defaultCompare idents_map))
                  ([] : List
                    (sym ×
                      ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers ×
                        ctype))), { st with registered_identifiers := ident_table' }))))))
        (fun (bs : List
          (sym ×
