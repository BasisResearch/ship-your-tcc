def get_compatible_alignment_requirements [CerbImplCfg.Impl] (loc1 : CerbLocation.Loc)
    (new_align_opt : Option alignment) (prev_align_opt : Option alignment) :
    state_with_markers → exceptM (Option alignment × state_with_markers) error :=
  stExpect_bind get_alignof (fun (alignof_ty : ctype → Option Nat) =>
    let common : Int → Int → state_with_markers → exceptM (Option alignment × state_with_markers)
      error :=
      (fun (new_n : Int) (prev_n : Int) =>
        lem_if new_n == prev_n then
          stExpect_return prev_align_opt
        else
          fun (_ : state_with_markers) =>
            fail0
              (loc1, DESUGAR (Desugar_UndefinedBehaviour UB072_incompatible_alignment_specifiers)));
    match new_align_opt, prev_align_opt with
    | none, none => stExpect_return none
    | some _, none =>
      (/- STD §6.7.5#7, sentence 2 -/ fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_UndefinedBehaviour UB072_incompatible_alignment_specifiers)))
    | none, some _ => stExpect_return prev_align_opt
    | some (AlignInteger new_n), some (AlignInteger prev_n) => common new_n prev_n
    | some (AlignType new_ty), some (AlignType prev_ty) =>
      (lem_if CerbGlobal.isAgnostic () then
        fun (_ : state_with_markers) =>
          fail0
            (loc1,
              DESUGAR
                (Desugar_agnosticFailure
                  "redeclaration with alignment specifiers is too complicated"))
      else
        match alignof_ty new_ty, alignof_ty prev_ty with
        | some new_n, some prev_n => common (Int.ofNat new_n) (Int.ofNat prev_n)
        | _, _ =>
          (fun (_ : state_with_markers) =>
            fail0 (loc1, DESUGAR (Desugar_TODO "error msg: need a better implementation"))))
    | some (AlignType new_ty), some (AlignInteger prev_n) =>
      (lem_if CerbGlobal.isAgnostic () then
        fun (_ : state_with_markers) =>
          fail0
            (loc1,
              DESUGAR
                (Desugar_agnosticFailure
                  "redeclaration with alignment specifiers is too complicated"))
      else
        match alignof_ty new_ty with
        | some new_n => common (Int.ofNat new_n) prev_n
        | none =>
          (fun (_ : state_with_markers) =>
            fail0 (loc1, DESUGAR (Desugar_TODO "error msg: need a better implementation"))))
    | some (AlignInteger new_n), some (AlignType prev_ty) =>
      (lem_if CerbGlobal.isAgnostic () then
        fun (_ : state_with_markers) =>
          fail0
            (loc1,
              DESUGAR
                (Desugar_agnosticFailure
                  "redeclaration with alignment specifiers is too complicated"))
      else
        match alignof_ty prev_ty with
        | some prev_n => common new_n (Int.ofNat prev_n)
        | none =>
          (fun (_ : state_with_markers) =>
            fail0 (loc1, DESUGAR (Desugar_TODO "error msg: need a better implementation")))))
