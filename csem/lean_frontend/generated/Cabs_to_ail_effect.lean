          match namespace2, kind1, link_opt with
          | Namespace_label, Kind_label, none => stExpect_return ()
          | Namespace_tag, Kind_tag _, none => stExpect_return ()
          | Namespace_member _, Kind_member _, none => stExpect_return ()
          | Namespace_ordinary, Kind_ordinary OK_enum_constant, none => stExpect_return ()
          | Namespace_ordinary, Kind_ordinary OK_typedef, none => stExpect_return ()
          | Namespace_ordinary, Kind_ordinary _, some _ => stExpect_return ()
