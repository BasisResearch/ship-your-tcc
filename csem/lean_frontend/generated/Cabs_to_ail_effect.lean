def register_typedef [CerberusFresh.Digest] (ident : identifier)
    (p : (attributes × qualifiers × ctype)) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  match ident, p with
  | ident, (attrs1, qs, ty1) =>
    (let loc1 :=
       match ident with
       | (Identifier loc1 _) => loc1;
     let has_byte_attr := is_cerb_byte attrs1;
     let byte_attr_str := lem_if has_byte_attr then "[[cerb::byte]] " else "";
     let mk_byte : ctype → state_with_markers → exceptM (ctype × state_with_markers) error :=
       (fun (ty1 : ctype) =>
         lem_if has_byte_attr then
           lem_if is_unsigned_char ty1 then
             stExpect_return (Ctype ([] : List annot) Byte)
           else
             fun (_ : state_with_markers) =>
               fail0 (loc1, DESUGAR (Desugar_ConstraintViolation TypedefBytesAreUnsignedCharsOnly))
         else
           stExpect_return ty1);
     (lemSeq
       (fun _ =>
         CerbDebug.print_debug_pure 2 [DB_desugaring] (fun (u : Unit) =>
           match u with
           | () =>
             String.append "registering typedef identifier: "
               (String.append
                 (match ident with
                  | Identifier _ str => str)
                 (String.append " with (qs, ty) = "
                   (String.append byte_attr_str (CerbPP.stringFromAil_ctype qs ty1))))))
       (fun _ =>
         stExpect_bind
           (/- if the identifier is already declared we reuse that existing declaration -/ internal_register_identifier
             (fun (p : (scope × (sym × identifier_kind × Option linkage)))
               (f : Unit → desugM ail_identifier) =>
               match p, f with
               | (_, (sym1, _, _)), _ => stExpect_return sym1) ident Namespace_ordinary
             (Kind_ordinary OK_typedef) none)
           (fun (sym1 : sym) =>
             stExpect_bind get_inner (fun (st : state) =>
               match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                   st.typedef_definitions) with
               | some (attrs', qs', ty') =>
                 (/- STD §6.7#3, first bullet -/ lem_if variably_modified ty1 then
                   fun (_ : state_with_markers) =>
                     fail0
                       (loc1,
                         DESUGAR
                           (Desugar_ConstraintViolation TypedefRedefinitionVariablyModifiedType))
                 else lem_if ((fun (qs1 : qualifiers) (qs2 : qualifiers) =>
                     not (qualifiersEqual qs1 qs2)) qs qs') ||
                     ((fun (ty1 : ctype) (ty2 : ctype) => not (ctypeEqual ty1 ty2)) ty1 ty') then
                   fun (_ : state_with_markers) =>
                     fail0 (loc1, DESUGAR (Desugar_ConstraintViolation TypedefRedefinition))
                 else
                   stExpect_bind (mk_byte ty')
                     (fun (ty' :
                       ctype) => /- TODO: we combine the attributes, not sure this is right thing to do -/
                       put_inner
                         ({ st with
                            typedef_definitions :=
                              (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                                (combine_attributes attrs1 attrs', qs', ty')
                                st.typedef_definitions) }))) /- return () -/
               | none =>
                 stExpect_bind (mk_byte ty1) (fun (ty1 : ctype) =>
                   put_inner
                     ({ st with
                        typedef_definitions :=
                          (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                            (attrs1, qs, ty1) st.typedef_definitions) })))))))
def resolve_typedef (sym1 : sym) :
    state_with_markers → exceptM ((attributes × qualifiers × ctype) × state_with_markers)
        (CerbLocation.Loc × cause) :=
  read_inner (fun (st : state) =>
    match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
        st.typedef_definitions) with
    | some attrs_qs_ty => attrs_qs_ty
    | _ =>
      (failwithI "TODO(msg) Cabs_to_ail_effect.resolve_typedef" :
        (attributes × qualifiers × ctype)))
def register_case (loc1 : CerbLocation.Loc) (case_sel : case_selector) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  stExpect_bind get_inner (fun (st : state) =>
    match st.switch_context with
    | [] =>
      (fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_ConstraintViolation LabelStatementOutsideSwitch)))
    | x :: xs =>
      (let ctx' := { x with cases_info := (loc1, case_sel) :: x.cases_info } :: xs;
       put_inner { st with switch_context := ctx' }))
def register_default (loc1 : CerbLocation.Loc) :
    state_with_markers → exceptM (Unit × state_with_markers) error :=
  stExpect_bind get_inner (fun (st : state) =>
    match st.switch_context with
    | [] =>
      (fun (_ : state_with_markers) =>
        fail0 (loc1, DESUGAR (Desugar_ConstraintViolation LabelStatementOutsideSwitch)))
    | x :: xs =>
      (match x.default_info with
       | some prev_loc =>
         (fun (_ : state_with_markers) =>
           fail0 (loc1, DESUGAR (Desugar_ConstraintViolation (MutipleDefaultStatement prev_loc))))
       | none =>
         (let ctx' := { x with default_info := some loc1 } :: xs;
          put_inner { st with switch_context := ctx' })))

partial def check_case_overlap { a : Type } (new_case : case_selector) :
    List (a × case_selector) → Option a :=
  fun (x : List (a × case_selector)) =>
    match x with
    | [] => none
    | (loc1, prev_case) :: xs =>
      (lem_if (match new_case, prev_case with
               | CaseSelectConst new_n, CaseSelectConst prev_n => new_n == prev_n
               | CaseSelectConst new_n, CaseSelectRange prev_n1 prev_n2 =>
                 intLteb prev_n1 new_n && intLteb new_n prev_n2
               | CaseSelectRange new_n1 new_n2, CaseSelectConst prev_n =>
                 intLteb new_n1 prev_n && intLteb prev_n new_n2
               | CaseSelectRange new_n1 new_n2, CaseSelectRange prev_n1 prev_n2 =>
                 intLteb /- NOTE: we are assuming the case_selectors  are well-formed -/ prev_n1
                   new_n2 && intLteb new_n1 prev_n2) then
        some loc1
      else
        check_case_overlap new_case xs)

partial def check_case_overlaps_aux { a : Type } (acc : List (a × case_selector)) :
    List (a × case_selector) → Option (a × a) :=
  fun (x : List (a × case_selector)) =>
    match x with
    | [] => none
    | (loc1, x) :: xs =>
      (match check_case_overlap x acc with
       | none => check_case_overlaps_aux ((loc1, x) :: acc) xs
       | some prev_loc => some (loc1, prev_loc))

def check_case_overlaps { a : Type } (xs : List (a × case_selector)) : Option (a × a) :=
  check_case_overlaps_aux [] xs
def is_in_switch :
    state_with_markers → exceptM (Bool × state_with_markers) (CerbLocation.Loc × cause) :=
  read_inner (fun (st : state) =>
    match st.switch_context with
    | [] => false
    | _ :: _ => true)
def as_switch_body { a : Type } [Inhabited a]
    (m : state_with_markers → exceptM (a × state_with_markers) error) :
    state_with_markers → exceptM (a × state_with_markers) error :=
  stExpect_bind
    (update_inner (fun (st : state) =>
      { st with switch_context := empty_switch_info :: st.switch_context }))
    (fun (u : Unit) =>
      match u with
      | () =>
        stExpect_bind m (fun (ret : a) =>
          stExpect_bind get_inner (fun (st : state) =>
            match st.switch_context with
            | [] =>
              (failwithI "Cabs_to_ail.as_switch_body: switch_context = []" : state_with_markers →
                exceptM (a × state_with_markers) error)
            | switch_info1 :: xs =>
              stExpect_bind (put_inner { st with switch_context := xs }) (fun (u : Unit) =>
                match u with
                | () =>
                  (match check_case_overlaps switch_info1.cases_info with
                   | none => stExpect_return ret
                   | some (loc1, prev_loc) =>
                     (fun (_ : state_with_markers) =>
                       fail0
                         (loc1,
                           DESUGAR
                             (Desugar_ConstraintViolation (CaseStatementOverlap prev_loc)))))))))
