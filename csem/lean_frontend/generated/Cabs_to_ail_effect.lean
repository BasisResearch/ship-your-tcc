                    (String.append " with namespace= "
                      (String.append
                        ((fun (x : namespace0) =>
                          match x with
                          | Namespace_label => "label"
                          | Namespace_tag => "tag"
                          | Namespace_member ident =>
                            String.append "member{"
                              (String.append
                                (match ident with
                                 | Identifier _ str => str) "}")
                          | Namespace_ordinary => "ordinary") namespace2)
                        (String.append ", kind= "
                          (String.append
                            ((fun (x : identifier_kind) =>
                              match x with
                              | Kind_ordinary (OK_object false) => "object"
                              | Kind_ordinary (OK_object true) => "parameter"
                              | Kind_ordinary OK_function => "function"
                              | Kind_member Kind_struct => "struct_member"
                              | Kind_member Kind_union => "union_member"
                              | Kind_member Kind_enum => "enum_member (TODO: this is invalid)"
                              | Kind_ordinary OK_enum_constant => "enum_constant"
                              | Kind_tag Kind_struct => "struct tag"
                              | Kind_tag Kind_union => "union tag"
                              | Kind_tag Kind_enum => "enum tag"
                              | Kind_ordinary OK_typedef => "typedef"
                              | Kind_label => "label") kind1)
                            (match link_opt with
                             | none => ""
                             | some _ =>
                               String.append ", linkage= "
                                 (stringFromMaybe
                                   (fun (x : linkage) =>
                                     match x with
                                     | Linkage_external => "external"
                                     | Linkage_internal => "internal"
                                     | Linkage_none => "none") link_opt)))))))))))
      (fun _ =>
        stExpect_bind
          (/- TODO: we should use a smaller type in the state to avoid having to do these
