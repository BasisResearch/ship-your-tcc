def cabs_to_ail_effect_eval { a : Type } (sup : Nat) (address_space_top1 : Int)
    (core_eval_stuff1 : (Fmap String sym × fun_map Unit × impl)) (cn_eval_stuff : init_scope)
    (m : state_with_markers → exceptM (a × state_with_markers) error) :
    exceptM ((Nat × markers_env) × a × Nat) (CerbLocation.Loc × cause) :=
  state_except_eval
    (stExpect_bind m (fun (res : a) =>
      stExpect_bind (fin_markers_env0 ()) (fun (markers : (Nat × markers_env)) =>
        stExpect_bind get_fresh_sym_supply (fun (sup' : Nat) =>
          stExpect_return (markers, res, sup')))))
    (initial_state sup address_space_top1 core_eval_stuff1 cn_eval_stuff)

