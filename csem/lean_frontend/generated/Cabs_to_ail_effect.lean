/- val liftCnDesug: forall 'a. Cn_desugaring.cn_desugM 'a -> desugM 'a -/
/- let liftCnDesug mk = -/
/-   begin fun st -> -/
/-     Exception.bind (State_exception.run mk st.inner.cn_state) -/
/-       (fun (ret, cn_st') -> Exception.return (ret, <| st with inner= <| st.inner with cn_state= cn_st' |> |>)) -/
/-   end >>= fun ret -> (\* (ret, st') -> *\) -/
/-   (\* put_inner st' >>= fun () -> *\) -/
/-   return ret -/

def check_cn_ident (ns : cn_namespace) (_ident : identifier) :
    state_with_markers → exceptM (Bool × state_with_markers) error :=
  match ns with
  | CN_predicate => stExpect_return true /- global -/
  | CN_function => stExpect_return true /- global -/
  | CN_lemma => stExpect_return true /- global -/
  | CN_vars => stExpect_return false /- local -/
  | CN_oarg => stExpect_return false /- local -/
  | _ => stExpect_return true

def update_cn_state { a : Type } (f : cn_desugaring_state → cn_desugaring_state) :
    state_with_markers → exceptM (Unit × state_with_markers) a :=
  update_inner (fun (inner1 : state) => { inner1 with cn_state := f inner1.cn_state })

def get_cn_state : state_with_markers → exceptM (cn_desugaring_state × state_with_markers) error :=
  stExpect_bind get_inner (fun (inner1 : state) => stExpect_return inner1.cn_state)

def assert_cn_bottom_scope : state_with_markers → exceptM (Unit × state_with_markers) error :=
  stExpect_bind get_cn_state (fun (st : cn_desugaring_state) =>
    match st.cn_scopes with
    | [] =>
      (failwithI "cn_scopes is empty but should never be empty" : state_with_markers → exceptM
        (Unit × state_with_markers) error)
    | [sc1] => stExpect_return ()
    | _ =>
      (failwithI "cn_scopes should be a singleton but is not" : state_with_markers → exceptM
        (Unit × state_with_markers) error))

def current_cn_scope (s : cn_desugaring_state) : Fmap (cn_namespace × identifier) sym :=
  Lem_List_extra.head s.cn_scopes

def push_cn_scope { a : Type } : state_with_markers → exceptM (Unit × state_with_markers) a :=
  update_cn_state (fun (s : cn_desugaring_state) =>
    { s with cn_scopes := current_cn_scope s :: s.cn_scopes })

def pop_cn_scope { a : Type } : state_with_markers → exceptM (Unit × state_with_markers) a :=
  update_cn_state (fun (s : cn_desugaring_state) =>
    { s with cn_scopes := Lem_List_extra.tail s.cn_scopes })

def update_current_cn_scope { a : Type }
    (f : Fmap (cn_namespace × identifier) sym → Fmap (cn_namespace × identifier) sym) :
    state_with_markers → exceptM (Unit × state_with_markers) a :=
  update_cn_state (fun (s : cn_desugaring_state) =>
    let cur := Lem_List_extra.head s.cn_scopes;
    let rest1 := Lem_List_extra.tail s.cn_scopes;
    { s with cn_scopes := f cur :: rest1 })

/- CN variables cannot shadow CN variables or C variables.  It would
   be good to make the same true the other way round (C variables not
   shadowing CN variables), but with the current pipeline shape that's
   not trivia. So, instead, this function makes C variables take
   precedence over CN variables, as suggested by Kayvan. -/

def cn_resolve_ordinary (inner1 : state) (ident : identifier) : Option (sym × identifier_kind) :=
  match resolve (ident, Namespace_ordinary) inner1.registered_identifiers with
  | none => none
  | some (_, Internal sym1 kind1 _linkage) => some (sym1, kind1)
  | some (_, External) =>
    (match (fmapLookupBy
         (pairCompare
           (fun (ident1 : identifier) (ident2 : identifier)=>
             match ident1 with
             | (Identifier _ str1) =>
               (match ident2 with
                | (Identifier _ str2) => defaultCompare str1 str2))
           (fun (ns1 : namespace0) (ns2 : namespace0)=>
             let ord : namespace0 → Nat :=
               fun (x : namespace0) =>
                 match x with
                 | Namespace_label => (0 : Nat)
                 | Namespace_tag => 1
                 | Namespace_member _ => 2
                 | Namespace_ordinary => 3;
             match ns1, ns2 with
             | Namespace_member ident1, Namespace_member ident2 =>
               (match ident1 with
                | (Identifier _ str1) =>
                  (match ident2 with
                   | (Identifier _ str2) => defaultCompare str1 str2))
             | _, _ => defaultCompare (ord ns1) (ord ns2))) (ident, Namespace_ordinary)
         inner1.registered_external_identifiers) with
     | none => none
     | some (_scope, (sym1, kind1, _linkage)) => some (sym1, kind1))

def resolve_cn_ident_opt (ns : cn_namespace) (ident : identifier) :
    state_with_markers → exceptM (Option (sym × cn_var_kind) × state_with_markers) error :=
  stExpect_bind get_inner (fun (inner1 : state) =>
    let st := inner1.cn_state;
    let c_var_kind : identifier_kind → cn_var_kind :=
      (fun (kind1 : identifier_kind) =>
        match kind1 with
        | Kind_ordinary OK_enum_constant => Var_kind_c C_kind_enum
        | Kind_ordinary _ => Var_kind_c C_kind_var
        | _ => (failwithI "resolve_cn_ident_opt: not Kind_ordinary" : cn_var_kind));
    let lookup_in_c_desugaring_state : Unit → Option (sym × cn_var_kind) :=
      (fun (u : Unit) =>
        match u with
        | () =>
          (match cn_resolve_ordinary inner1 ident with
           | some (sym1, kind1) => some (sym1, c_var_kind kind1)
           | none => none));
    /- based on earlier Cabs_to_ail_effect code  -/
    let lookup_in_cn_desugaring_state : Unit → Option (sym × cn_var_kind) :=
      (fun (u : Unit) =>
        match u with
        | () =>
          (match (fmapLookupBy
               (pairCompare defaultCompare (fun (ident1 : identifier) (ident2 : identifier)=>
                 match ident1 with
                 | (Identifier _ str1) =>
                   (match ident2 with
                    | (Identifier _ str2) => defaultCompare str1 str2))) (ns, ident)
               (current_cn_scope st)) with
           | some sym1 => some (sym1, Var_kind_cn)
           | none =>
             (match (fmapLookupBy
                  (pairCompare defaultCompare (fun (ident1 : identifier) (ident2 : identifier)=>
                    match ident1 with
                    | (Identifier _ str1) =>
                      (match ident2 with
                       | (Identifier _ str2) => defaultCompare str1 str2))) (ns, ident)
                  st.cn_idents0) with
              | some sym1 => some (sym1, Var_kind_cn)
              | none => none)));
    let result :=
      match ns with
      | CN_vars =>
        (match lookup_in_c_desugaring_state () with
         | none => lookup_in_cn_desugaring_state ()
         | some r => some r)
      | _ => lookup_in_cn_desugaring_state ();
    stExpect_return result)

