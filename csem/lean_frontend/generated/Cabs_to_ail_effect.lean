    state_with_markers → exceptM (a × state_with_markers) error :=
  stExpect_bind
    (stExpect_bind
      (state_except_update (fun (st : state_with_markers) =>
        (lemSeq
          (fun _ =>
            CerbDebug.print_debug_pure 3 [DB_desugaring] (fun (u : Unit) =>
              match u with
              | () => String.append "ENTERING Scope: " (string_of_scope scope1)))
          (fun _ => create_new_scope scope1 st)))) (fun (_ : Unit) => m))
    (fun (res : a) =>
      stExpect_bind
        (update_inner (fun (st : state) =>
          match destroy_scope st.registered_identifiers with
          | (_, ident_table') =>
            ((lemSeq
              (fun _ =>
                CerbDebug.print_debug_pure 3 [DB_desugaring] (fun (u : Unit) =>
                  match u with
                  | () => String.append "EXITING Scope: " (string_of_scope scope1)))
