    match x with
    | none =>
      stExpect_bind get_inner (fun (inner1 : state) =>
        let st := inner1.cn_state;
        let same_ns : List (cn_namespace × identifier) → List identifier :=
          (fun (xs : List (cn_namespace × identifier)) =>
            List.flatten
              (List.map
                (fun (p : (cn_namespace × identifier)) =>
                  match p with
                  | (ns2, sym1) => (lem_if ns2 == ns then [sym1] else ([] : List identifier))) xs));
        (lemSeq
          (fun _ =>
            CerbDebug.print_debug_pure 8 ([] : List domain) (fun (u : Unit) =>
              match u with
              | () =>
                String.append "available CN identifiers in ns ("
                  (String.append
                    (match ns with
                     | CN_predicate => "predicate"
                     | CN_function => "function"
                     | CN_lemma => "lemma"
                     | CN_fun_spec => "fun_spec"
                     | CN_datatype_nm => "datatype"
                     | CN_constructor => "constructor"
                     | CN_vars => "vars"
                     | CN_oarg => "oarg"
                     | CN_type_nm => "type name") ") in local scope:")))
          (fun _ => /- let () = Debug.print_debug 8 [] -/ /-            (fun () -> show (same_ns (Set_extra.toList (Map.domain st.cn_current_scope)))) in -/
            (lemSeq
              (fun _ =>
                CerbDebug.print_debug_pure 8 ([] : List domain) (fun (u : Unit) =>
                  match u with
                  | () => "and in global scope:"))
              (fun _ =>
                (lemSeq
                  (fun _ =>
                    CerbDebug.print_debug_pure 8 ([] : List domain) (fun (u : Unit) =>
                      match u with
                      | () =>
                        stringFromList
                          (fun (ident : identifier)=>
                            match ident with
                            | Identifier _ str => str)
                          (same_ns
                            (setToList
                              ((fmapDomainBy
                                (pairCompare defaultCompare
