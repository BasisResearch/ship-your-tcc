/- State-threaded fresh-symbol helpers.  These bump fresh_sym_supply and
   return a new Symbol.sym, making the effect explicit in the desugM monad.
   Callers that currently use Symbol.fresh/fresh_pretty/etc. directly should
   migrate to these — otherwise Lean's CSE on the pure Symbol.fresh* will
   produce duplicate IDs and trigger UB015. -/

def fresh_sym_int (_ : Unit) :
    state_with_markers → exceptM (Nat × state_with_markers) (CerbLocation.Loc × cause) :=
  modify_inner (fun (st : state) =>
    let n := st.fresh_sym_supply;
    (n, { st with fresh_sym_supply := n + 1 }))
/- arc-13 D1 (renumbering, scheme R-B): on the OCaml target desugar ids
   come from the single ambient counter, exactly as un-forked upstream —
   the threaded supply above is the LEAN-target scheme only (Lean CSE
   safety, commit 8923d6436). Restores the single-supply collision-
   impossibility and byte-identical-to-upstream numbering; checked per TU
   by util/cerb_fresh.ml check_ail_window. Evidence + decision:
   lean_frontend/docs/2026-08-22_arc13-s0-scheme-decision.md. -/

def fresh_sym [CerberusFresh.Digest] (_ : Unit) :
    state_with_markers → exceptM (sym × state_with_markers) error :=
  stExpect_bind (fresh_sym_int ()) (fun (n : Nat) =>
    stExpect_return (Symbol CerberusFresh.Digest.digest n SD_None))
def fresh_sym_pretty [CerberusFresh.Digest] (str : String) :
