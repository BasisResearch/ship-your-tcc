def get_gamma_sofar :
    state_with_markers → exceptM
        (List
          (sym ×
            ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) ×
          state_with_markers) (CerbLocation.Loc × cause) :=
  read_inner (fun (st : state) =>
    /- TODO: this is putting too much in gamma (i.e. things which are not in the
       current scope). But since we are dealing with fresh symbols, this
       shouldn't be observable? -/
    List.map
      (fun (p :
        (sym ×
          (CerbLocation.Loc × storageDuration × Bool × Option alignment × qualifiers × ctype))) =>
        match p with
        | (sym1, (loc1, dur, b, align_opt, qs, ty1)) =>
          (sym1, ((loc1, dur, b), align_opt, qs, ty1)))
      (fmapElements st.internal_object_declarations))
/- Returns what would the Ail sigma be so far -/
/- TODO: factorise with extract_program -/

def get_sigma_sofar [CerbImplCfg.Impl] :
    state_with_markers → exceptM (sigma Unit × state_with_markers) (CerbLocation.Loc × cause) :=
  read_inner (fun (st : state) =>
    let decls1 :=
      fmapElements
        (map_union
          (fmapMap
            (fun (p :
              (Bool × CerbLocation.Loc × attributes ×
                ((qualifiers × ctype) × Option (List (qualifiers × ctype × Bool)) × Bool × Bool ×
                  Bool))) =>
              match p with
              | (hasProto, loc1, attrs1, (ty1, params_opt, isVariadic, isInline, isNoreturn)) =>
                ((lemSeq
                  (fun _ =>
                    CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
                      match u with
                      | () => "KKK: check + find STD quote"))
                  (fun _ => /- TODO: is it correct "complete" the params like that ? -/
                    let params :=
                      match params_opt with
                      | none => ([] : List (qualifiers × ctype × Bool))
                      | some z => z;
                    (loc1, attrs1,
                      Decl_function hasProto ty1 params isVariadic isInline isNoreturn)))))
            st.function_declarations)
          (fmapMap
            (fun (p :
              (Bool × CerbLocation.Loc × attributes × storageDuration × Bool × Option alignment ×
                qualifiers × ctype)) =>
              match p with
              | (_, loc1, attrs1, dur, isRegister, _, qs, ty1) =>
                (loc1, attrs1, Decl_object ((dur, isRegister)) none qs ty1))
            st.external_object_declarations));
    (({ declarations := /- remove_unused_identifiers st startup_sym -/ decls1,
        object_definitions :=
          /- remove_unused_identifiers st startup_sym $ -/ ([] : List
            (ail_identifier × expression
              Unit)) /- TODO:check, but this shouldn't be used -/ /- Map_extra.toList st.global_object_definitions -/,
        function_definitions :=
          (/- remove_unused_identifiers st startup_sym $ -/ fmapElements st.function_definitions0),
        static_assertions := st.static_assertions0,
        tag_definitions :=
          (lemListFoldr
            (fun (p : (sym × tag_definition0))
              (acc : List (sym × (CerbLocation.Loc × attributes × tag_definition))) =>
              match p, acc with
              | (sym1, def1), acc =>
                (match def1 with
                 | Struct_definition loc1 attrs1 _ membersDefs flexible_opt =>
                   (sym1,
                     (loc1, attrs1,
                       StructDef (aggregate_layout_of_attributes attrs1) membersDefs
                         flexible_opt)) :: acc
                 | Union_definition loc1 attrs1 _ membersDefs =>
                   (sym1,
                     (loc1, attrs1,
                       UnionDef (aggregate_layout_of_attributes attrs1) membersDefs)) :: acc
                 | Enum_definition _ => acc))
            ([] : List (sym × (CerbLocation.Loc × attributes × tag_definition)))
            (fmapElements st.tag_definitions0)),
        enum_definitions := (enum_definitions_of_tag_definitions st.tag_definitions0),
        extern_idmap := fmapEmpty,
        typedef_attributes :=
          (fmapMap
            (fun (p : (attributes × qualifiers × ctype)) =>
              match p with
              | (z, _, _) => z) st.typedef_definitions),
        loop_attributes0 := st.loop_attributes2,
        cn_predicates :=
          (List.reverse
            (List.map
              (fun (p : (identifier × (sym × cn_predicate sym ctype))) =>
                match p with
                | (_, (_, z)) => z) st.cn_state.cn_predicates0)),
        cn_functions :=
          (List.reverse
            (List.map
              (fun (p : (identifier × (sym × cn_function sym ctype))) =>
                match p with
                | (_, (_, z)) => z) st.cn_state.cn_functions0)),
        cn_lemmata :=
          (List.reverse
            (List.map
              (fun (p : (identifier × (sym × cn_lemma sym ctype))) =>
                match p with
                | (_, (_, z)) => z) st.cn_state.cn_lemmata0)),
        cn_datatypes :=
          (List.reverse
            (List.map
              (fun (p : (identifier × cn_datatype sym)) =>
                match p with
                | (_, z) => z) st.cn_state.cn_datatypes0)),
        cn_decl_specs := (List.reverse st.cn_state.cn_decl_specs0),
        cn_idents := st.cn_state.cn_idents0 } : sigma Unit)))
