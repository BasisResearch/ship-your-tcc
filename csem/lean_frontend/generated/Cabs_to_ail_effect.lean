def record_marker (_ : Unit) : state_with_markers → exceptM (Nat × state_with_markers) error :=
  stExpect_bind (fresh_sym_int ()) (fun (id1 : Nat) =>
    stExpect_bind
      (lem_if CerbGlobal.backend_name () == "Cn" then
        stExpect_bind get_inner (fun (inner1 : state) =>
          state_except_update (fun (old_state : state_with_markers) =>
            { old_state with
              markers_env0 := (fmapAddBy defaultCompare id1 inner1 old_state.markers_env0) }))
      else
        stExpect_return ())
      (fun (u : Unit) =>
        match u with
        | () => stExpect_return id1))
def fin_markers_env0 (_ : Unit) :
    state_with_markers → exceptM ((Nat × Fmap Nat state) × state_with_markers) error :=
  stExpect_bind (record_marker ()) (fun (id1 : Nat) =>
    stExpect_bind state_except_get (fun (st : state_with_markers) =>
      stExpect_return (id1, st.markers_env0)))
/- C1: the desugar supply threads in and out of the evaluation (S1
   single stream) — the caller passes the current stream value and
   receives the final one beside the result. -/

def get_fresh_sym_supply :
    state_with_markers → exceptM (Nat × state_with_markers) (CerbLocation.Loc × cause) :=
  modify_inner (fun (st : state) => (st.fresh_sym_supply, st))
