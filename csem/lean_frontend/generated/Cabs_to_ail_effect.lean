    (String.append
      "register_static_global_definition must only be called for object with static storage duration ==> "
      (show_symbol sym1))
    (update_inner (fun (st : state) =>
      { st with
        global_object_definitions :=
          (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1 gdef
            st.global_object_definitions) }))
