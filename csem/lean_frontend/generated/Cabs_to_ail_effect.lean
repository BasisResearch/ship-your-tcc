/- Ordinary identifiers are those declared by ordinary declarators (i.e. object
    or functions) or enumeration constants -/

inductive ordinary_registration : Type where
  | OReg_enum_constant : ail_identifier → ordinary_registration
  | OReg_typedef : ail_identifier → ordinary_registration
  | OReg_other : ail_identifier → ordinary_kind → linkage → ordinary_registration
  deriving BEq, Ord
export ordinary_registration (OReg_enum_constant OReg_typedef OReg_other)
instance : Inhabited ordinary_registration where
  default := OReg_enum_constant default
instance (priority := 500) : Lem_Basic_classes.SetType ordinary_registration where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 ordinary_registration where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 ordinary_registration where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def resolve_ordinary_identifier (loc1 : CerbLocation.Loc) (ident : identifier) :
    state_with_markers → exceptM (Option (scope × ordinary_registration) × state_with_markers)
        error :=
  stExpect_bind
    (stExpect_return
      (CerbDebug.print_debug_pure 2 [DB_desugaring] (fun (u : Unit) =>
        match u with
        | () =>
          String.append "attempting to resolve ordinary identifier `"
            (match ident with
             | Identifier _ str => str))))
    (fun (_ : Unit) =>
