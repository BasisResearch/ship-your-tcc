instance (priority := 500) : Lem_Basic_classes.Eq0 pure_memop where
  isEqual := pure_memop.beq_derived
  isInequal x y := !(pure_memop.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 pure_memop where
  compare x y :=
