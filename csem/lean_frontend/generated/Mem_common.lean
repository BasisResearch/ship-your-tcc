/- https://hoogle.haskell.org/?hoogle=sequence
  Should be in some generic library module.
-/

partial def either_sequence { a b : Type } (xs : List (Sum a b)) : Sum a (List b) :=
  match xs with
  | [] => Sum.inr []
  | Sum.inl msg :: _ => Sum.inl msg
  | (Sum.inr x) :: xs =>
    (match either_sequence xs with
     | Sum.inl msg => Sum.inl msg
     | Sum.inr xs' => Sum.inr (x :: xs'))

/- Function to derive an actual signature given the list
  of actual argument types and specification as returned
  by [get_intrinsic_type_spec].

  Returns None in case of error or a signature as a list
  of types. The first one is the type of return value and
  the remaining ones are types of arguments.
-/
def try_usual_arithmetic (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) (c0 : ctype) :
    Option ctype :=
  match c, c0 with
  | (Ctype _ ty1), (Ctype _ ty2) =>
    (match ty1, ty2 with
     | Basic (Integer ity1), Basic (Integer ity2) =>
       some
         (Ctype ([] : List annot)
           (Basic
             (Integer
               ((usual_arithmetic_integer _lemReader_enum_definitions _lemReader_tagDefs)
                 ((integerImpl _lemReader_enum_definitions _lemReader_tagDefs) ()) ity1 ity2))))
     | _, _ => none)
partial def resolve_arg (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (n : Nat)
    (get_arg : Nat → (ctype × Bool)) (get_spec : Nat → intrinsics_arg_spec) (p : (ctype × Bool))
    (spec : intrinsics_arg_spec) :
    Sum String ctype :=
  match n, get_arg, get_spec, p, spec with
  | n, get_arg, get_spec, (arg, is_null_pointer_constant1), spec =>
    (let resolve_arg1 :=(resolve_arg _lemReader_enum_definitions _lemReader_tagDefs) n get_arg
         get_spec;
     match spec with
     | ExactArg ty1 =>
       (lem_if ctypeEqual arg ty1 then
         Sum.inr arg
       else
         match (try_usual_arithmetic _lemReader_enum_definitions _lemReader_tagDefs) ty1 arg with
         | some usual_ty =>
           (lem_if ctypeEqual usual_ty ty1 then
             Sum.inr usual_ty
           else
             Sum.inl "ExactArg -- common type didn't match")
         | none => Sum.inl "ExactArg -- type mismatch")
     | PolymorphicArg tyl =>
       (let opt :=
          List.foldl
            (fun (acc : Option ctype) (p : type_predicate) =>
              match acc, p with
              | some ty1, _ => some ty1
              | none, TyPred pred1 => (lem_if pred1 arg then some arg else none)
              | none, TyIsPointer =>
                (lem_if is_pointer arg then
                  some arg
                else lem_if is_null_pointer_constant1 then
                  some (mk_ctype_pointer no_qualifiers void)
                else
                  none)) none tyl;
        match opt with
        | some ty1 => Sum.inr ty1
        | none => Sum.inl "PolymorphicArg -- all preds failed")
     | CopyArg i =>
       (lem_if natGteb i n then
         Sum.inl "CopyArg -- invalid index" /- spec error! -/
       else
         match get_spec i with
         | CopyArg _ => Sum.inl "CopyArg -- dual indirection not allowed!"
         | spec' => resolve_arg1 (get_arg i) spec'))

def derive_intrinsic_signature (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (args : List (ctype × Bool))
    (p : (instrinsics_ret_spec × List intrinsics_arg_spec)) :
    Sum String (ctype × List ctype) :=
  match args, p with
  | args, (ret_spec, specs) =>
    (let n := List.length args;
     lem_if not (n == (List.length specs)) then
       Sum.inl "|args| <> |specs|"
     else
       match either_sequence
           (map2
             ((resolve_arg _lemReader_enum_definitions _lemReader_tagDefs) n
               ((fun (idx : Nat)=>
                 match listGetOpt args idx with
                 | some z => z
                 | none =>
                   (failwithI "Mem_common.derive_intrinsic_signature: internal error (get)" :
                     (ctype × Bool))))
               ((fun (idx : Nat)=>
                 match listGetOpt specs idx with
                 | some z => z
                 | none =>
                   (failwithI "Mem_common.derive_intrinsic_signature: internal error (get)" :
                     intrinsics_arg_spec)))) args specs) with
       | Sum.inl msg => Sum.inl msg
       | Sum.inr tys =>
         Sum.inr
           (match ret_spec with
            | ExactRet ty1 => (ty1, tys)
            | CopyRet i =>
              (match listGetOpt tys i with
               | some z => z
               | none =>
                 (failwithI "Mem_common.derive_intrinsic_signature: internal error (get)" : ctype),
                tys)))
