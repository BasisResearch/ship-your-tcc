inductive mem_constraint (a : Type) : Type where
  | MC_empty : mem_constraint a
  | MC_eq : a → a → mem_constraint a
  | MC_le : a → a → mem_constraint a
  | MC_lt : a → a → mem_constraint a
  | MC_in_device : a → mem_constraint a
  | MC_or : mem_constraint a → mem_constraint a → mem_constraint a
  | MC_conj : List (mem_constraint a) → mem_constraint a
  | MC_not : mem_constraint a → mem_constraint a
  deriving BEq, Ord
export mem_constraint (MC_empty MC_eq MC_le MC_lt MC_in_device MC_or MC_conj MC_not)
instance { a : Type } : Inhabited (mem_constraint a) where
  default := MC_empty
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (mem_constraint a) where
  setElemCompare := defaultCompare
instance (priority := 500) { a : Type } [BEq a] : Lem_Basic_classes.Eq0 (mem_constraint a) where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.Ord0 (mem_constraint a) where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def mem_constraint.lemSize { a : Type } (sizex_ : mem_constraint a) : Nat :=
  match sizex_ with
  | .MC_empty => 1
  | .MC_eq _ _ => 1
  | .MC_le _ _ => 1
  | .MC_lt _ _ => 1
  | .MC_in_device _ => 1
  | .MC_or x1 x2 => 1 + mem_constraint.lemSize x1 + mem_constraint.lemSize x2
  | .MC_conj x1 => 1 + mem_constraint.lemSize_aux1 x1
  | .MC_not x1 => 1 + mem_constraint.lemSize x1
termination_by structural sizex_
def mem_constraint.lemSize_aux1 { a : Type } (sizex_ : List (mem_constraint a)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + mem_constraint.lemSize x1 + mem_constraint.lemSize_aux1 xs0
termination_by structural sizex_
end

instance (a : Type) : Constraints (mem_constraint a) where

    empty := MC_empty

    negate cs := MC_not cs

    concat cs1 cs2 := MC_conj [cs1, cs2]

inductive type_predicate : Type where
  | TyPred : (ctype → Bool) → type_predicate
  | TyIsPointer : type_predicate
export type_predicate (TyPred TyIsPointer)
instance : Inhabited type_predicate where
  default := TyIsPointer
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def type_predicate.ctor_rank_ocaml : type_predicate → Nat
  | .TyPred _ => 1
  | .TyIsPointer => 0
mutual
def type_predicate.beq_derived (cmpx_ cmpy_ : type_predicate) : Bool :=
  match cmpx_, cmpy_ with
  | .TyPred x1, .TyPred y1 => lemFunctionalBeq x1 y1
  | .TyIsPointer, .TyIsPointer => true
  | _, _ => false
termination_by structural cmpx_
def type_predicate.compare_derived (cmpx_ cmpy_ : type_predicate) : Ordering :=
  match cmpx_, cmpy_ with
  | .TyPred x1, .TyPred y1 => lemFunctionalCompare x1 y1
  | xg, yg => Ord.compare (type_predicate.ctor_rank_ocaml xg) (type_predicate.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq type_predicate where
  beq := type_predicate.beq_derived
instance : Ord type_predicate where
  compare := type_predicate.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType type_predicate where
  setElemCompare x y :=
    match type_predicate.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 type_predicate where
  isEqual := type_predicate.beq_derived
  isInequal x y := !(type_predicate.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 type_predicate where
  compare x y :=
    match type_predicate.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match type_predicate.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match type_predicate.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match type_predicate.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match type_predicate.compare_derived x y with
    | .lt => false
    | _ => true

/- This type describes an element of function specification.
   It is used for both arguments and return values.
   Please note, that it allows circular dependencies.
 -/
inductive instrinsics_ret_spec : Type where
  | ExactRet : ctype → instrinsics_ret_spec /- fixed type -/
  | CopyRet : Nat → instrinsics_ret_spec
  deriving BEq, Ord
export instrinsics_ret_spec (ExactRet CopyRet)
instance : Inhabited instrinsics_ret_spec where
  default := ExactRet default
instance (priority := 500) : Lem_Basic_classes.SetType instrinsics_ret_spec where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 instrinsics_ret_spec where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 instrinsics_ret_spec where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual :=
    defaultGreaterEq
    /- the type must be derived from the
                      resolved type of one of the arguments. -/

inductive intrinsics_arg_spec : Type where
  | ExactArg : ctype → intrinsics_arg_spec /- fixed type -/
  | PolymorphicArg :
      (List type_predicate) → intrinsics_arg_spec /- any type matching this perdicate -/
  | CopyArg : Nat → intrinsics_arg_spec
  deriving BEq, Ord
export intrinsics_arg_spec (ExactArg PolymorphicArg CopyArg)
instance : Inhabited intrinsics_arg_spec where
  default := ExactArg default
instance (priority := 500) : Lem_Basic_classes.SetType intrinsics_arg_spec where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 intrinsics_arg_spec where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 intrinsics_arg_spec where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual :=
    defaultGreaterEq
    /- the type of this argument will be derived from
                      the resolved type of another PolymorphicArg or
                      ExactArg argument with the given index. The
                      double indirection CopyArg pointing to another
                      CopyArg), or loops (CopyArg pointing to itself)
                      are not allowed. -/

/- An intrinsic signature is a specification of return type and list
   of arguments' type specifications. -/
abbrev intrinsics_signature := (instrinsics_ret_spec × List intrinsics_arg_spec)

instance : Show intrinsics_arg_spec where

    show0 :=
      fun x =>
        match x with
        | ExactArg ty1 => "ExactArg"
        | PolymorphicArg _ => "PolymorphicArg"
        | CopyArg i =>
          String.append "CopyArg(" (String.append (Lem_String_extra.stringFromNat i) ")")

