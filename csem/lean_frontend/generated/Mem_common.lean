    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match pure_memop.compare_derived x y with
    | .lt => false
    | _ => true /- byte -> integer -/

inductive generic_memop (sym : Type) : Type where
  | PtrEq : generic_memop sym
  | PtrNe : generic_memop sym
  | PtrLt : generic_memop sym
  | PtrGt : generic_memop sym
  | PtrLe : generic_memop sym
  | PtrGe : generic_memop sym
  /-  | PtrIsNull -/
  | Ptrdiff : generic_memop sym /- (address, address) -> eff integer -/
  | IntFromPtr :
      generic_memop
          sym /- (ctype, ctype, address) -> eff integer -/ /- first type is that of the referenced type, second on is type of integer -/
  | PtrFromInt :
      generic_memop
          sym /- (ctype, ctype, integer) -> eff address -/ /- first type is that of integer, second on is type of reference -/
  | PtrValidForDeref : generic_memop sym /- (ctype, address) -> eff boolean -/
  | PtrWellAligned : generic_memop sym /- (ctype, address) -> eff boolean -/
  | PtrArrayShift : generic_memop sym /- address -> ctype -> integer -> eff address -/
  | PtrMemberShift : sym → identifier → generic_memop sym /- address -> eff address -/
  | Memcpy : generic_memop sym
  | Memcmp : generic_memop sym
  | Realloc : generic_memop sym /- TODO: not sure about this -/
  | Va_start : generic_memop sym
  | Va_copy : generic_memop sym
  | Va_arg : generic_memop sym
  | Va_end : generic_memop sym
  /- RefinedC -/
  | Copy_alloc_id : generic_memop sym /- (integer, pointer) -> eff pointer -/
  /- CHERI -/
  | CHERI_intrinsic : String → (ctype × List ctype) → generic_memop sym
export generic_memop (PtrEq PtrNe PtrLt PtrGt PtrLe PtrGe Ptrdiff IntFromPtr PtrFromInt
    PtrValidForDeref PtrWellAligned PtrArrayShift PtrMemberShift Memcpy Memcmp Realloc Va_start
    Va_copy Va_arg Va_end Copy_alloc_id CHERI_intrinsic)
instance { sym : Type } : Inhabited (generic_memop sym) where
  default := PtrEq
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def generic_memop.ctor_rank_ocaml { sym : Type } : generic_memop sym → Nat
  | .PtrEq => 0
  | .PtrNe => 1
  | .PtrLt => 2
  | .PtrGt => 3
  | .PtrLe => 4
  | .PtrGe => 5
  | .Ptrdiff => 6
  | .IntFromPtr => 7
  | .PtrFromInt => 8
  | .PtrValidForDeref => 9
  | .PtrWellAligned => 10
  | .PtrArrayShift => 11
  | .PtrMemberShift _ _ => 20
  | .Memcpy => 12
  | .Memcmp => 13
  | .Realloc => 14
  | .Va_start => 15
  | .Va_copy => 16
  | .Va_arg => 17
  | .Va_end => 18
  | .Copy_alloc_id => 19
  | .CHERI_intrinsic _ _ => 21
mutual
def generic_memop.beq_derived { sym : Type } [BEq sym] (cmpx_ cmpy_ : generic_memop sym) : Bool :=
  match cmpx_, cmpy_ with
  | .PtrEq, .PtrEq => true
  | .PtrNe, .PtrNe => true
  | .PtrLt, .PtrLt => true
  | .PtrGt, .PtrGt => true
  | .PtrLe, .PtrLe => true
  | .PtrGe, .PtrGe => true
  | .Ptrdiff, .Ptrdiff => true
  | .IntFromPtr, .IntFromPtr => true
  | .PtrFromInt, .PtrFromInt => true
  | .PtrValidForDeref, .PtrValidForDeref => true
  | .PtrWellAligned, .PtrWellAligned => true
  | .PtrArrayShift, .PtrArrayShift => true
  | .PtrMemberShift x1 x2, .PtrMemberShift y1 y2 => x1 == y1 && x2 == y2
  | .Memcpy, .Memcpy => true
  | .Memcmp, .Memcmp => true
  | .Realloc, .Realloc => true
  | .Va_start, .Va_start => true
  | .Va_copy, .Va_copy => true
  | .Va_arg, .Va_arg => true
  | .Va_end, .Va_end => true
  | .Copy_alloc_id, .Copy_alloc_id => true
  | .CHERI_intrinsic x1 x2, .CHERI_intrinsic y1 y2 => x1 == y1 && x2 == y2
  | _, _ => false
termination_by structural cmpx_
def generic_memop.compare_derived { sym : Type } [Ord sym] (cmpx_ cmpy_ : generic_memop sym) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .PtrMemberShift x1 x2, .PtrMemberShift y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CHERI_intrinsic x1 x2, .CHERI_intrinsic y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | xg, yg => Ord.compare (generic_memop.ctor_rank_ocaml xg) (generic_memop.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

