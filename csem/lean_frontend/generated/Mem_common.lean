inductive pure_memop : Type where
  /- CHERI -/
  /- (integer, integer) -> integer -/
  | DeriveCap : derivecap_op → Bool → pure_memop /- is_signed -/
  /- CHERI -/
  /- (integer, integer) -> integer (may result in UB) -/
  | CapAssignValue : pure_memop
  /- CHERI -/
  /- integer -> integer -/
  | Ptr_tIntValue : pure_memop
  /- Bytes -/
  | ByteFromInt : pure_memop /- integer -> byte -/
  | IntFromByte : pure_memop
export pure_memop (DeriveCap CapAssignValue Ptr_tIntValue ByteFromInt IntFromByte)
instance : Inhabited pure_memop where
  default := CapAssignValue
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def pure_memop.ctor_rank_ocaml : pure_memop → Nat
  | .DeriveCap _ _ => 4
  | .CapAssignValue => 0
  | .Ptr_tIntValue => 1
  | .ByteFromInt => 2
  | .IntFromByte => 3
mutual
def pure_memop.beq_derived (cmpx_ cmpy_ : pure_memop) : Bool :=
  match cmpx_, cmpy_ with
  | .DeriveCap x1 x2, .DeriveCap y1 y2 => x1 == y1 && x2 == y2
  | .CapAssignValue, .CapAssignValue => true
  | .Ptr_tIntValue, .Ptr_tIntValue => true
  | .ByteFromInt, .ByteFromInt => true
  | .IntFromByte, .IntFromByte => true
  | _, _ => false
termination_by structural cmpx_
def pure_memop.compare_derived (cmpx_ cmpy_ : pure_memop) : Ordering :=
  match cmpx_, cmpy_ with
  | .DeriveCap x1 x2, .DeriveCap y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | xg, yg => Ord.compare (pure_memop.ctor_rank_ocaml xg) (pure_memop.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq pure_memop where
  beq := pure_memop.beq_derived
instance : Ord pure_memop where
  compare := pure_memop.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType pure_memop where
  setElemCompare x y :=
    match pure_memop.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
