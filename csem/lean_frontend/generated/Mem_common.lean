  | .MerrReadUninit => 1
  | .MerrTrapRepresentation _ => 12
  | .MerrUndefinedFree _ => 13
  | .MerrUndefinedRealloc _ => 14
  | .MerrUndefinedMemcpy _ => 15
  | .MerrIntFromPtr => 2
  | .MerrPtrFromInt => 3
  | .MerrPtrComparison => 4
  | .MerrArrayShift => 5
  | .MerrFreeNullPtr => 6
  | .MerrWIP _ => 16
  | .MerrVIP _ => 17
  | .MerrCHERI _ => 18
mutual
def mem_error.beq_derived (cmpx_ cmpy_ : mem_error) : Bool :=
  match cmpx_, cmpy_ with
  | .MerrOutsideLifetime x1, .MerrOutsideLifetime y1 => x1 == y1
  | .MerrInternal x1, .MerrInternal y1 => x1 == y1
  | .MerrOther x1, .MerrOther y1 => x1 == y1
  | .MerrPtrdiff, .MerrPtrdiff => true
  | .MerrAccess x1 x2, .MerrAccess y1 y2 => x1 == y1 && x2 == y2
  | .MerrWriteOnReadOnly x1, .MerrWriteOnReadOnly y1 => x1 == y1
  | .MerrReadUninit, .MerrReadUninit => true
  | .MerrTrapRepresentation x1, .MerrTrapRepresentation y1 => x1 == y1
  | .MerrUndefinedFree x1, .MerrUndefinedFree y1 => x1 == y1
  | .MerrUndefinedRealloc x1, .MerrUndefinedRealloc y1 => x1 == y1
  | .MerrUndefinedMemcpy x1, .MerrUndefinedMemcpy y1 => x1 == y1
  | .MerrIntFromPtr, .MerrIntFromPtr => true
  | .MerrPtrFromInt, .MerrPtrFromInt => true
  | .MerrPtrComparison, .MerrPtrComparison => true
  | .MerrArrayShift, .MerrArrayShift => true
  | .MerrFreeNullPtr, .MerrFreeNullPtr => true
  | .MerrWIP x1, .MerrWIP y1 => x1 == y1
  | .MerrVIP x1, .MerrVIP y1 => x1 == y1
  | .MerrCHERI x1, .MerrCHERI y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def mem_error.compare_derived (cmpx_ cmpy_ : mem_error) : Ordering :=
  match cmpx_, cmpy_ with
  | .MerrOutsideLifetime x1, .MerrOutsideLifetime y1 => Ord.compare x1 y1
  | .MerrInternal x1, .MerrInternal y1 => Ord.compare x1 y1
  | .MerrOther x1, .MerrOther y1 => Ord.compare x1 y1
  | .MerrAccess x1 x2, .MerrAccess y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .MerrWriteOnReadOnly x1, .MerrWriteOnReadOnly y1 => Ord.compare x1 y1
  | .MerrTrapRepresentation x1, .MerrTrapRepresentation y1 => Ord.compare x1 y1
  | .MerrUndefinedFree x1, .MerrUndefinedFree y1 => Ord.compare x1 y1
  | .MerrUndefinedRealloc x1, .MerrUndefinedRealloc y1 => Ord.compare x1 y1
  | .MerrUndefinedMemcpy x1, .MerrUndefinedMemcpy y1 => Ord.compare x1 y1
  | .MerrWIP x1, .MerrWIP y1 => Ord.compare x1 y1
  | .MerrVIP x1, .MerrVIP y1 => Ord.compare x1 y1
  | .MerrCHERI x1, .MerrCHERI y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (mem_error.ctor_rank_ocaml xg) (mem_error.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

