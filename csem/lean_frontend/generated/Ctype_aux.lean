/-
  | StructDef of list (Symbol.identifier * ctype)
  | UnionDef of list (Symbol.identifier * ctype)
-/

inductive integer_type_match : Type where
  | MatchedItySigned : integerType → integer_type_match
  | MatchedItyUnsigned : integerType → integer_type_match
  | NotMatchedIty : integer_type_match
export integer_type_match (MatchedItySigned MatchedItyUnsigned NotMatchedIty)
instance : Inhabited integer_type_match where
  default := NotMatchedIty
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def integer_type_match.ctor_rank_ocaml : integer_type_match → Nat
  | .MatchedItySigned _ => 1
  | .MatchedItyUnsigned _ => 2
  | .NotMatchedIty => 0
mutual
def integer_type_match.beq_derived (cmpx_ cmpy_ : integer_type_match) : Bool :=
  match cmpx_, cmpy_ with
  | .MatchedItySigned x1, .MatchedItySigned y1 => x1 == y1
  | .MatchedItyUnsigned x1, .MatchedItyUnsigned y1 => x1 == y1
  | .NotMatchedIty, .NotMatchedIty => true
  | _, _ => false
termination_by structural cmpx_
def integer_type_match.compare_derived (cmpx_ cmpy_ : integer_type_match) : Ordering :=
  match cmpx_, cmpy_ with
  | .MatchedItySigned x1, .MatchedItySigned y1 => Ord.compare x1 y1
  | .MatchedItyUnsigned x1, .MatchedItyUnsigned y1 => Ord.compare x1 y1
  | xg, yg =>
    Ord.compare (integer_type_match.ctor_rank_ocaml xg) (integer_type_match.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq integer_type_match where
  beq := integer_type_match.beq_derived
instance : Ord integer_type_match where
  compare := integer_type_match.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType integer_type_match where
  setElemCompare x y :=
    match integer_type_match.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 integer_type_match where
  isEqual := integer_type_match.beq_derived
  isInequal x y := !(integer_type_match.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 integer_type_match where
  compare x y :=
    match integer_type_match.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match integer_type_match.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match integer_type_match.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match integer_type_match.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match integer_type_match.compare_derived x y with
    | .lt => false
    | _ => true

