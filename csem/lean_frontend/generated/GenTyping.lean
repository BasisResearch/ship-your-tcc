                                     (String.append (show_symbol_description sd1)
                                       (String.append " <-> " (show_symbol_description sd2)))))
                             (fun _ => true))
                         else
                           true
                       else
                         false)) ident sigm.declarations) with
               | some
                 (_, _,
                   Decl_function hasProto (ret_qs, ret_ty) params _ /- isVariadic -/ _
                     /- isInline -/ _) /- isNoreturn -/ =>
                 (/- TODO: qualifiers -/ (lemSeq
                   (fun _ =>
                     CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                       match u with
                       | () => "(unsure) annotate_sigma doesn't look at [ret_qs]"))
                   (fun _ =>
                     let bindings1 :=
                       List.map
                         (fun (p : (sym × (qualifiers × ctype × Bool))) =>
                           match p with
                           | (ident, (qs, ty1, isRegister)) => /- STD §6.9.1#9, first sentence -/
                             (ident, ((loc1, Automatic, isRegister), none, qs, ty1)))
                         (lemListZip param_idents params);
                     lem_if sigma_fresh_bindings bindings1 sigm then
                       let add_bindings : List
                         (sym ×
                           ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                             qualifiers × ctype)) → List
                         (sym ×
                           ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                             qualifiers × ctype)) → List
                         (sym ×
                           ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                             qualifiers × ctype)) :=
                         (fun (bs : List
                           (sym ×
                             ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                               qualifiers × ctype)))
                           (acc : List
                             (sym ×
                               ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                 qualifiers × ctype))) =>
                           List.foldl
                             (fun (acc : List
                               (sym ×
                                 ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                   qualifiers × ctype)))
                               (b :
                                 (sym ×
                                   ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                     qualifiers × ctype))) =>
                               b :: acc) bs acc);
                       bind3
                         ((annotate_statement _lemReader_enum_definitions _lemReader_tagDefs) sigm
                           (add_bindings bindings1
                             ([] : List
                               (sym ×
                                 ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                   qualifiers × ctype)))) ret_ty s)
                         (fun (s' : statement genTypeCategory) =>
                           ErrorM (fun (ts : List (List String)) =>
                             Sum.inr ((ident, (loc1, marker_id1, attr, param_idents, s')), ts)))
                     else
                       (failwithI "annotate_sigma: parameter ail_identifiers are not fresh" : errorM
                         (sym ×
                           (CerbLocation.Loc × Nat × attributes × List sym × statement
                             genTypeCategory))))))
               | _ =>
                 (failwithI "annotate_sigma: function definition must have a declaration" : errorM
                   (sym ×
                     (CerbLocation.Loc × Nat × attributes × List sym × statement
                       genTypeCategory))))) sigm.function_definitions)
        (fun (function_defs' : List (sigma_function_definition genTypeCategory)) =>
          let check_member : Bool →
            (identifier × (attributes × Option alignment × qualifiers × ctype)) → errorM Unit :=
            (fun (is_struct2 : Bool)
              (p : (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
              match is_struct2, p with
              | is_struct2, (ident, (_, _, qs, ty1)) =>
                bind3 (add "§6.7.2.1#3") (fun (_ : Unit) =>
                  lem_if is_struct2 && has_flexible_array_member sigm ty1 then
                    ErrorM (fun (_ : List (List String)) =>
                      Sum.inl
