            lem_if (match tag_sym1, tag_sym2 with
                    | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                      (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                        lem_if natGteb 0 5 && (sd1 != sd2) then
                          (lemSeq
                            (fun _ =>
                              CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                match u with
                                | () =>
                                  String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                    (String.append (show_symbol_description sd1)
                                      (String.append " <-> " (show_symbol_description sd2)))))
                            (fun _ => true))
                        else
                          true
                      else
                        false)) then
              ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts))
            else
              throw2 IncompatibleType)))
      | _, _ => throw2 IncompatibleType)
  else lem_if atomic_qualified_unqualified is_pointer ty1 then
    (lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
          match u with
          | () => "TODO: check the use of AAux.lvalue_conversion"))
      (fun _ =>
        bind3 (lvalue_conversion s ty1) (fun (conv_ty1 : ctype) =>
          (lemSeq
            (fun _ =>
              CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
                match u with
                | () =>
                  String.append "[well_typed_assignment] before bullet 3: conv_ty1= "
                    (String.append (CerbPP.stringFromAil_ctype no_qualifiers conv_ty1)
                      (String.append " -- gty2= " (CerbPP.stringFromAil_genType gty2)))))
            (fun _ =>
              match (proj_ctype_ (unatomic ty1)), proj_ctype_ conv_ty1, gty2 with
              | Pointer ref_qs1 _, Pointer _ conv_ref_ty1, GenPointer ref_qs2 ref_ty2 =>
                (/- doing the "qualified or unqualified versions of" by checking the compatibility of
             the unqualified referenced type with no qualifiers -/
                /- NOTE: for the left operand, we are looking at the qualifiers before
             conversion (since the lvalue conversion removes the qualifiers) -/
                lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
                    (no_qualifiers, conv_ref_ty1) (no_qualifiers, ref_ty2) && sub_qualifiers ref_qs2
                    ref_qs1 then
                  (lemSeq
                    (fun _ =>
                      CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
                        match u with
                        | () => "[well_typed_assignment] OK: bullet 3"))
                    (fun _ => /- DEBUG -/
                      (lemSeq
                        (fun _ =>
                          CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
                            match u with
                            | () => /- TODO !!!! -/
                              "FIXME: sub_qualifiers sees the wrong qualifiers (GenTypeCategory RValue seems to be at fault) !!!!"))
                        (fun _ => add "§6.5.16.1#1, bullet 3"))))
                else lem_if ((is_object conv_ref_ty1 && is_void ref_ty2) ||
                    (is_void conv_ref_ty1 && is_object ref_ty2)) && sub_qualifiers ref_qs2
                    ref_qs1 then
                  (lemSeq
                    (fun _ =>
                      CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
                        match u with
                        | () => "[well_typed_assignment] OK: bullet 4"))
                    (fun _ => /- DEBUG -/ add "§6.5.16.1#1, bullet 4"))
                else lem_if is_null_pointer_constant e2 then
                  (lemSeq
                    (fun _ =>
                      CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
                        match u with
                        | () => "[well_typed_assignment] OK: bullet 5"))
                    (fun _ => /- DEBUG -/ add "§6.5.16.1#1, bullet 5"))
                else
                  (lemSeq
                    (fun _ =>
                      CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
                        match u with
                        | () =>
                          String.append
                            "[well_typed_assignment] KO: is_pointer ty1 && gty2 ==> (ref_qs1, conv_ref_ty1)= "
                            (String.append (CerbPP.stringFromAil_human_ctype ref_qs1 conv_ref_ty1)
                              (String.append ", (ref_qs2, ref_ty2)= "
                                (CerbPP.stringFromAil_human_ctype ref_qs2 ref_ty2)))))
                    (fun _ => /- DEBUG -/
                      lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
                          (no_qualifiers, conv_ref_ty1) (no_qualifiers, ref_ty2) then
                        throw2 DiscardsQualifiers
                      else
                        throw2 IncompatiblePointerType)))
              | _, _, _ =>
                (lem_if is_null_pointer_constant e2 then
                  add "§6.5.16.1#1, bullet 5"
                else
                  throw2 IncompatibleType))))))
    /- NOTE: bullet 6 is dealt with earlier (look for the code dealing with bullet 1) -/
  else lem_if is_init then /- TODO: check -/
    match proj_ctype_ ty1, gty2 with
    | Array0 elem_ty1 n1_opt, GenArray elem_ty2 n2_opt =>
      (lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
          (no_qualifiers, elem_ty1) (no_qualifiers, elem_ty2) then
        match n1_opt, n2_opt with
        | some n1, some n2 =>
          (lem_if not (n1 == n2) then
            throw2 IncompatibleType
          else
            ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts)))
        | _, _ => ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts))
      else
        throw2 IncompatibleType)
    | _, _ => throw2 IncompatibleType
  else
    (lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 [DB_ail_typing] (fun (u : Unit) =>
          match u with
          | () => "[well_typed_assignment] KO: the end"))
      (fun _ => /- DEBUG -/ throw2 IncompatibleType))
/- STD §6.5.9#2 -/

def well_typed_equality (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (gty1 : genType)
    (gty2 : genType) (is_null1 : Bool) (is_null2 : Bool) :
    Bool :=
  (/- STD §6.5.9#2, item 1 -/ is_arithmetic0 gty1 && is_arithmetic0 gty2)
    /- STD §6.5.9#2, item 2 -/
    ||
    ((are_pointers_to_qualifiedOrUnqualified_compatible_types _lemReader_enum_definitions
      _lemReader_tagDefs) gty1 gty2
      /- Defacto extension. TODO: make it a specific flag -/
      ||
      ((CerbGlobal.isDefacto () && (is_pointer_to_object0 gty1 && is_pointer_to_object0 gty2))
        /- STD §6.5.9#2, item 3 -/
        ||
        ((is_pointer_to_void0 gty1 && is_pointer_to_object0 gty2)
          /- STD §6.5.9#2, item 3 -/
          ||
          ((is_pointer_to_object0 gty1 && is_pointer_to_void0 gty2)
            /- STD §6.5.9#2, item 4 -/
            ||
            ((is_pointer0 gty1 && is_null2)
              /- STD §6.5.9#2, item 4 -/
              || (is_null1 && is_pointer0 gty2))))))

def guard_violation (loc1 : CerbLocation.Loc) (viol : violation) (b : Bool) : errorM Unit :=
  (fun (x : Bool) =>
    match x with
    | true => ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts))
    | false =>
      ErrorM (fun (_ : List (List String)) => Sum.inl (loc1, (TError_ConstraintViolation viol)))) b

def well_typed_binary_arithmetic (viol : arith_binop_violation → genType → genType → violation)
    (loc_e1 : CerbLocation.Loc) (loc_op : CerbLocation.Loc) (loc_e2 : CerbLocation.Loc)
    (gt1 : genType) (aop : arithmeticOperator) (gt2 : genType) :
    errorM Unit :=
  let guard2 : arith_binop_violation → Bool → errorM Unit :=
    (fun (bop : arith_binop_violation) =>
      guard_violation (CerbLocation.withRegionsAndCursor [loc_e1, loc_e2] (some loc_op))
        (viol bop gt1 gt2));
  match aop with
  | Mul0 => guard2 MultiplicativeInvalidOperandsType (is_arithmetic0 gt1 && is_arithmetic0 gt2)
  | Div0 => guard2 MultiplicativeInvalidOperandsType (is_arithmetic0 gt1 && is_arithmetic0 gt2)
  | Mod0 => guard2 ModInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)
  | Add0 => guard2 AdditiveOperandsArithmeticType (is_arithmetic0 gt1 && is_arithmetic0 gt2)
  | Sub0 => guard2 AdditiveOperandsArithmeticType (is_arithmetic0 gt1 && is_arithmetic0 gt2)
  | Shl => guard2 BitwiseShiftInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)
  | Shr => guard2 BitwiseShiftInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)
  | Band => guard2 BitwiseAndInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)
  | Bxor => guard2 BitwiseXorInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)
  | Bor => guard2 BitwiseOrInvalidOperandsType (is_integer0 gt1 && is_integer0 gt2)

def combine_qualifiers_left (gty1 : genType) (gty2 : genType) : genType :=
  match gty1, gty2 with
  | GenPointer qs1 ty1, GenPointer qs2 _ => GenPointer (combine_qualifiers qs1 qs2) ty1
  | GenPointer _ _, _ => gty1
  | _, _ => gty1

def combine_qualifiers_right (gty1 : genType) (gty2 : genType) : genType :=
  match gty1, gty2 with
  | GenPointer qs1 _, GenPointer qs2 ty2 => GenPointer (combine_qualifiers qs1 qs2) ty2
  | _, GenPointer _ _ => gty2
  | _, _ => gty2

def well_typed_conditionalGNU (p : (CerbLocation.Loc × CerbLocation.Loc × CerbLocation.Loc))
    (gty1 : genType) (gty3 : genType) :
    errorM genTypeCategory :=
  match p, gty1, gty3 with
  | (loc_cond, loc_e1, loc_e3), gty1, gty3 =>
    (lem_if is_scalar0 gty1 && not (is_byte0 gty1) then
      bind3 (add "§6.5.15#2") (fun (_ : Unit) =>
        lem_if is_arithmetic0 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 1") (fun (_ : Unit) => add "§6.5.15#5, sentence 1"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr ((GenRValueType (usual_arithmetic gty3 gty3)), ts)))
        else lem_if is_struct_or_union0 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 2") (fun (_ : Unit) => add "§6.5.15#5, sentence 2"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType gty3), ts)))
        else lem_if void0 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 3") (fun (_ : Unit) => add "§6.5.15#5, sentence 3"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType GenVoid), ts)))
        else lem_if is_pointer0 gty3 then
          bind3 (add "§6.5.15#3, bullet 4") (fun (_ : Unit) =>
            ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType gty3), ts)))
        else
          ErrorM (fun (_ : List (List String)) =>
            Sum.inl
              ((CerbLocation.withCursorFrom loc_e3 loc_cond),
                (TError_ConstraintViolation (GNUConditionalOperatorInvalidOperandType gty3)))))
    else
      ErrorM (fun (_ : List (List String)) =>
        Sum.inl
          ((CerbLocation.withCursorFrom loc_e1 loc_cond),
            (TError_ConstraintViolation (ConditionalOperatorControlType gty1)))))
def well_typed_conditional (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (p : (CerbLocation.Loc × CerbLocation.Loc × CerbLocation.Loc × CerbLocation.Loc))
    (gty1 : genType) (gty2 : genType) (gty3 : genType) (is_null2 : Bool) (is_null3 : Bool) :
    errorM genTypeCategory :=
  match p, gty1, gty2, gty3, is_null2, is_null3 with
  | (loc_cond, loc_e1, loc_e2, loc_e3), gty1, gty2, gty3, is_null2, is_null3 =>
    (lem_if is_scalar0 gty1 && not (is_byte0 gty1) then
      bind3 (add "§6.5.15#2") (fun (_ : Unit) =>
        lem_if is_arithmetic0 gty2 && is_arithmetic0 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 1") (fun (_ : Unit) => add "§6.5.15#5, sentence 1"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr ((GenRValueType (usual_arithmetic gty2 gty3)), ts)))
        else lem_if is_struct_or_union0 gty2 && eq_genType gty2 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 2") (fun (_ : Unit) => add "§6.5.15#5, sentence 2"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType gty2), ts)))
        else lem_if void0 gty2 && void0 gty3 then
          bind3 (bind3 (add "§6.5.15#3, bullet 3") (fun (_ : Unit) => add "§6.5.15#5, sentence 3"))
            (fun (_ : Unit) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType GenVoid), ts)))
        else
          match (composite_pointer _lemReader_enum_definitions _lemReader_tagDefs) gty2 gty3 with
          | some gty =>
            bind3 (bind3 (add "§6.5.15#3, bullet 4") (fun (_ : Unit) => add "§6.5.15#6"))
              (fun (_ : Unit) =>
                ErrorM (fun (ts : List (List String)) => Sum.inr ((GenRValueType gty), ts)))
          | none =>
            (lem_if is_pointer0 gty2 && is_null3 then
              bind3 (bind3 (add "§6.5.15#3, bullet 5") (fun (_ : Unit) => add "§6.5.15#6"))
                (fun (_ : Unit) =>
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((GenRValueType (combine_qualifiers_left gty2 gty3)), ts)))
            else lem_if is_pointer0 gty3 && is_null2 then
              bind3 (bind3 (add "§6.5.15#3, bullet 5") (fun (_ : Unit) => add "§6.5.15#6"))
                (fun (_ : Unit) =>
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((GenRValueType (combine_qualifiers_right gty2 gty3)), ts)))
            else lem_if is_pointer_to_object0 gty2 && is_pointer_to_void0 gty3 then
              bind3 (bind3 (add "§6.5.15#3, bullet 6") (fun (_ : Unit) => add "§6.5.15#6"))
                (fun (_ : Unit) =>
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((GenRValueType (combine_qualifiers_right gty2 gty3)), ts)))
            else lem_if is_pointer_to_object0 gty3 && is_pointer_to_void0 gty2 then
              bind3 (bind3 (add "§6.5.15#3, bullet 6") (fun (_ : Unit) => add "§6.5.15#6"))
                (fun (_ : Unit) =>
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((GenRValueType (combine_qualifiers_left gty2 gty3)), ts)))
            else
              ErrorM (fun (_ : List (List String)) =>
                Sum.inl
                  ((CerbLocation.withRegionsAndCursor [loc_e2, loc_e3] (some loc_cond)),
                    (TError_ConstraintViolation
                      (ConditionalOperatorInvalidOperandTypes gty2 gty3))))))
    else
      ErrorM (fun (_ : List (List String)) =>
        Sum.inl
          ((CerbLocation.withCursorFrom loc_e1 loc_cond),
            (TError_ConstraintViolation (ConditionalOperatorControlType gty1)))))
def annotate_stringLiteral (p : (Option encodingPrefix × List (CerbLocation.Loc × List String))) :
    errorM (expression_ genTypeCategory × genTypeCategory) :=
  match p with
  | (pref_opt, strs) =>
    (let elem_ty :=
       match pref_opt with
       | none => char0 /- STD §6.4.5#6 sentence 3 -/
       | some Enc_u8 => char0 /- STD §6.4.5#6 sentence 4 -/
       | some Enc_u => char16_t /- STD §6.4.5#6 sentence 6 -/
       | some Enc_U => char32_t /- STD §6.4.5#6 sentence 6 -/
       | some Enc_L => wchar_t /- STD §6.4.5#6 sentence 5 -/;
     /- the acc is initialised with 1 to take into account the trailing '\0' -/
     let sz :=
       List.foldl
         (fun (acc : Nat) (p : (CerbLocation.Loc × List String)) =>
           match acc, p with
           | acc, (_, str) => acc + List.length str) 1 strs;
     ErrorM (fun (ts : List (List String)) =>
       Sum.inr
         ((AilEstr (pref_opt, strs),
           GenLValueType no_qualifiers
             (Ctype ([] : List annot) (Array0 elem_ty (some (Int.ofNat (id sz))))) false), ts)))
partial def typecheck_constant [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (cst : constant) :
    errorM genType :=
  match cst with
  | ConstantInteger iCst =>
    bind3 ((gen_typing_type_of_constant _lemReader_enum_definitions _lemReader_tagDefs) loc1 iCst)
      (fun (gity : genIntegerType) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr ((GenBasic (GenInteger gity)), ts)))
  | ConstantFloating ((_, suff_opt)) =>
    bind3 (add "§6.4.4.2#4") (fun (_ : Unit) =>
      let rfty :=
        match suff_opt with
        | none => Double
        | some Fsuf_F => Float0
        | some Fsuf_L => LongDouble;
      ErrorM (fun (ts : List (List String)) =>
        Sum.inr ((GenBasic (GenFloating (RealFloating rfty))), ts)))
  | ConstantCharacter cc =>
    (/- TODO: §6.4.4.4#9 -/
    match Prod.fst cc with
    | none =>
      bind3 (add "§6.4.4.4#10") (fun (_ : Unit) =>
        ErrorM (fun (ts : List (List String)) =>
          Sum.inr ((GenBasic (GenInteger (Concrete (Signed Int_)))), ts)))
    | some Pref_L =>
      bind3 (add "§6.4.4.4#11") (fun (_ : Unit) =>
        ErrorM (fun (ts : List (List String)) =>
          Sum.inr ((GenBasic (GenInteger (Concrete Wchar_t))), ts)))
    | some Pref_u =>
      bind3 (add "§6.4.4.4#11") (fun (_ : Unit) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr (genChar16_t, ts)))
    | some Pref_U =>
      bind3 (add "§6.4.4.4#11") (fun (_ : Unit) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr (genChar32_t, ts))))
  | ConstantArray elem_ty csts =>
    bind3
      (/- TODO: this is probably too strong -/ ailErr_mapM
        ((typecheck_constant _lemReader_enum_definitions _lemReader_tagDefs) loc1) csts)
      (fun (x : List genType) =>
        match x with
        | [] => (failwithI "typecheck_constant: empty array constant" : errorM genType)
        | gtys => /- TODO !!!! -/
          ErrorM (fun (ts : List (List String)) =>
            Sum.inr ((GenArray elem_ty (some (Int.ofNat (List.length csts)))), ts)))
  | ConstantIndeterminate ty1 =>
    ErrorM (fun (ts : List (List String)) => Sum.inr ((inject_type ty1), ts))
  | ConstantNull => /- TODO: check -/
    ErrorM (fun (ts : List (List String)) =>
      Sum.inr ((GenPointer no_qualifiers (Ctype ([] : List annot) Void0)), ts))
  | ConstantStruct tag_sym xs =>
    bind3
      (ailErr_mapM
        (fun (p : (identifier × constant)) =>
          match p with
          | (memb_ident, cst) =>
            bind3
              (/- TODO: need to check that the members type match ... -/ (typecheck_constant
                _lemReader_enum_definitions _lemReader_tagDefs) loc1 cst)
              (fun (gty : genType) =>
                ErrorM (fun (ts : List (List String)) => Sum.inr ((memb_ident, gty), ts)))) xs)
      (fun (xs_gtys : List (identifier × genType)) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr ((GenStruct tag_sym), ts)))
  | ConstantUnion tag_sym memb_ident cst =>
    bind3
      (/- TODO: need to check that the members type match ... -/ (typecheck_constant
        _lemReader_enum_definitions _lemReader_tagDefs) loc1 cst)
      (fun (gty_membr : genType) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr ((GenUnion tag_sym), ts)))
  | ConstantPredefined PConstantFalse => /- STD C23 §6.4.4.5#3 -/
    ErrorM (fun (ts : List (List String)) => Sum.inr ((GenBasic (GenInteger (Concrete Bool0))), ts))
  | ConstantPredefined PConstantTrue => /- STD C23 §6.4.4.5#3 -/
    ErrorM (fun (ts : List (List String)) => Sum.inr ((GenBasic (GenInteger (Concrete Bool0))), ts))

inductive generic_selection : Type where
  | GA_match :
      genTypeCategory → Nat → List (generic_association genTypeCategory) → generic_selection
  | GA_multiple : generic_selection
  | GA_no_match : generic_selection
export generic_selection (GA_match GA_multiple GA_no_match)
instance : Inhabited generic_selection where
  default := GA_multiple
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def generic_selection.ctor_rank_ocaml : generic_selection → Nat
  | .GA_match _ _ _ => 2
  | .GA_multiple => 0
  | .GA_no_match => 1
mutual
def generic_selection.beq_derived (cmpx_ cmpy_ : generic_selection) : Bool :=
  match cmpx_, cmpy_ with
  | .GA_match x1 x2 x3, .GA_match y1 y2 y3 => x1 == y1 && x2 == y2 && x3 == y3
  | .GA_multiple, .GA_multiple => true
  | .GA_no_match, .GA_no_match => true
  | _, _ => false
termination_by structural cmpx_
def generic_selection.compare_derived (cmpx_ cmpy_ : generic_selection) : Ordering :=
  match cmpx_, cmpy_ with
  | .GA_match x1 x2 x3, .GA_match y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | xg, yg =>
    Ord.compare (generic_selection.ctor_rank_ocaml xg) (generic_selection.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq generic_selection where
  beq := generic_selection.beq_derived
instance : Ord generic_selection where
  compare := generic_selection.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType generic_selection where
  setElemCompare x y :=
    match generic_selection.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 generic_selection where
  isEqual := generic_selection.beq_derived
  isInequal x y := !(generic_selection.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 generic_selection where
  compare x y :=
    match generic_selection.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match generic_selection.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match generic_selection.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match generic_selection.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match generic_selection.compare_derived x y with
    | .lt => false
    | _ => true

partial def find_generic_association_aux { a : Type } (idx : Nat)
    (p :
      (Option (genTypeCategory × Nat) × Option (genTypeCategory × Nat) × List
        (generic_association genTypeCategory)))
    (annotate_expression1 : expression a → errorM (expression genTypeCategory))
    (are_compatible2 : qualifiers → ctype → Bool) (gas : List (generic_association a)) :
    errorM generic_selection :=
  match idx, p, annotate_expression1, are_compatible2, gas with
  | idx, (select_opt, default_opt, rev_gas'), annotate_expression1, are_compatible2, gas =>
    (let next :
       (Option (genTypeCategory × Nat) × Option (genTypeCategory × Nat) × List
         (generic_association genTypeCategory)) → List (generic_association a) → errorM
       generic_selection :=
       (fun (acc :
         (Option (genTypeCategory × Nat) × Option (genTypeCategory × Nat) × List
           (generic_association genTypeCategory))) =>
         find_generic_association_aux (idx + 1) acc annotate_expression1 are_compatible2);
     match gas with
     | [] =>
       (let gas' := List.reverse rev_gas';
        ErrorM (fun (ts : List (List String)) =>
          Sum.inr
            ((match select_opt, default_opt with
              | some (sel_gtc, sel_idx), _ => GA_match sel_gtc sel_idx gas'
              | none, some (def_gtc, def_idx) => GA_match def_gtc def_idx gas'
              | none, none => GA_no_match), ts)))
     | AilGAtype qs ty1 e :: gas =>
       bind3 (annotate_expression1 e) (fun (e' : expression genTypeCategory) =>
         lem_if are_compatible2 qs ty1 then
           lem_if isJust select_opt then
             ErrorM (fun (ts : List (List String)) => Sum.inr (GA_multiple, ts))
           else
             next (some (genTypeCategoryOf e', idx), default_opt, (AilGAtype qs ty1 e' :: rev_gas'))
               gas
         else
           next (select_opt, default_opt, (AilGAtype qs ty1 e' :: rev_gas')) gas)
     | AilGAdefault e :: gas =>
       bind3 (annotate_expression1 e) (fun (e' : expression genTypeCategory) =>
         next (select_opt, some (genTypeCategoryOf e', idx), (AilGAdefault e' :: rev_gas')) gas))

def find_generic_association { a : Type } (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_expression1 : expression a → errorM (expression genTypeCategory)) (ctrl_ty : ctype)
    (gas : List (generic_association a)) :
    errorM generic_selection :=
  let are_compatible2 : qualifiers → ctype → Bool :=
    (fun (qs : qualifiers) (ty1 : ctype) =>
      (are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (qs, ty1)
        (no_qualifiers, ctrl_ty));
  find_generic_association_aux 0 (none, none, ([] : List (generic_association genTypeCategory)))
    annotate_expression1 are_compatible2 gas

/- context given to [annotate_expression] to inform it on the what the current
   expression is: -/
inductive annotation_context : Type where
  /- operand of AilEsizeof_expr -/
  | CTXsizeof : annotation_context
  /- operand of AilEunary Address -/
  | CTXaddr : annotation_context
  /- operand of AilEunary PostfixIncr -/
  | CTXincr : annotation_context
  /- operand of AilEunary PostfixDecr -/
  | CTXdecr : annotation_context
  /- left operand of AilEmemberof -/
  | CTXmemberof : annotation_context
  /- left operand of AilEassign or AilEcompoundAssign -/
  | CTXassign : annotation_context
  /- array initialiser (used by AilEstr) -/
  | CTXarray_init : annotation_context
  /- otherwise -/
  | CTXother : annotation_context
  deriving BEq, Ord
export annotation_context (CTXsizeof CTXaddr CTXincr CTXdecr CTXmemberof CTXassign CTXarray_init
    CTXother)
instance : Inhabited annotation_context where
  default := CTXsizeof
instance (priority := 500) : Lem_Basic_classes.SetType annotation_context where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 annotation_context where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 annotation_context where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
mutual
partial def annotate_rvalue [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (expr1 : expression Unit) :
    errorM (expression genTypeCategory × genType) :=
  match annotate_block1, sigm, gamm, expr1 with
  | annotate_block1, sigm, gamm, expr1 =>
    bind3
      ((annotate_expression _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm
        gamm CTXother expr1)
      (fun (e : expression genTypeCategory) =>
        match e with
        | (AnnotatedExpression gtc std_annots loc1 expr_) =>
          ErrorM (fun (ts : List (List String)) =>
            Sum.inr
              (match gtc with
               | GenRValueType gty =>
                 (AnnotatedExpression (GenRValueType gty) std_annots loc1 expr_, gty)
               | GenLValueType qs ty1 isRegister =>
                 (AnnotatedExpression (GenLValueType qs ty1 isRegister) std_annots loc1 expr_,
                   inject_type ty1), ts)))
partial def annotate_assignee [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (is_init : Bool) (a_ctxt : simple_assignment_violation → ctype → genType → violation)
    (loc1 : CerbLocation.Loc) (ty1 : ctype) (e2 : expression Unit) :
    errorM (expression genTypeCategory) :=
  match annotate_block1, sigm, gamm, is_init, a_ctxt, loc1, ty1, e2 with
  | annotate_block1, sigm, gamm, is_init, a_ctxt, loc1, ty1, e2 =>
    bind3
      ((annotate_rvalue _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm gamm
        e2)
      (fun (p : (expression genTypeCategory × genType)) =>
        match p with
        | (e2, gty2) =>
          bind3
            ((well_typed_assignment _lemReader_enum_definitions _lemReader_tagDefs) sigm is_init
              a_ctxt loc1 ty1 gty2 e2)
            (fun (_ : Unit) =>
              lem_if is_atomic ty1 && not (is_atomic0 gty2) then
                ErrorM (fun (ts : List (List String)) =>
                  Sum.inr
                    ((AnnotatedExpression (GenRValueType (GenAtomic gty2)) ([] : List annot) loc1
                      (AilEatomic e2)), ts))
              else
                ErrorM (fun (ts : List (List String)) => Sum.inr (e2, ts))))
partial def annotate_expression [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (ctx : annotation_context) (e : expression Unit) :
    errorM (expression genTypeCategory) :=
  match annotate_block1, sigm, gamm, ctx, e with
  | annotate_block1, sigm, gamm, ctx, (AnnotatedExpression () std_annots loc1 expr_) =>
    (let annotate_expression1 :=(annotate_expression _lemReader_enum_definitions _lemReader_tagDefs)
         annotate_block1 sigm gamm;
     let annotate_rvalue1 :=(annotate_rvalue _lemReader_enum_definitions _lemReader_tagDefs)
         annotate_block1 sigm gamm;
     let annotate_assignee1 :=(annotate_assignee _lemReader_enum_definitions _lemReader_tagDefs)
         annotate_block1 sigm gamm;
     let annotate_arguments1 : CerbLocation.Loc → Bool → List (expression Unit) → Option
       (List (qualifiers × ctype × Bool)) → errorM (List (expression genTypeCategory)) :=
       (fun (loc1 : CerbLocation.Loc) (is_variadic : Bool) (args : List (expression Unit)) =>
         fun (x : Option (List (qualifiers × ctype × Bool))) =>
           match x with
           | some params =>
             (annotate_arguments_aux _lemReader_enum_definitions _lemReader_tagDefs) false
               annotate_block1 sigm gamm (List.length args) (List.length params) loc1 is_variadic
               args params
           | none =>
             (failwithI "annotate_arguments ==> no proto" : errorM
               (List (expression genTypeCategory))));
     let annotate_and_cast_arguments : CerbLocation.Loc → Bool → List (expression Unit) → Option
       (List (qualifiers × ctype × Bool)) → errorM (List (expression genTypeCategory)) :=
       (fun (loc1 : CerbLocation.Loc) (is_variadic : Bool) (args : List (expression Unit)) =>
         fun (x : Option (List (qualifiers × ctype × Bool))) =>
           match x with
           | some params =>
             (annotate_arguments_aux _lemReader_enum_definitions _lemReader_tagDefs) true
               annotate_block1 sigm gamm (List.length args) (List.length params) loc1 is_variadic
               args params
           | none =>
             (failwithI "annotate_and_cast_arguments ==> no proto" : errorM
               (List (expression genTypeCategory))));
     bind3
       (match expr_ with
        | AilEunary (uop@Plus) e =>
          bind3
            (bind3 (/- STD §6.5.3.3#1, sentence 1 -/ add "§6.5.3.3#1, sentence 1")
              (fun (_ : Unit) => annotate_rvalue1 e))
            (fun (p : (expression genTypeCategory × genType)) =>
              match p with
              | (a_e, gty) =>
                (lem_if is_arithmetic0 gty then
                  let mk_conversion :=
                    lem_if is_integer0 gty then integer_promote else (fun (x : genType)=> x);
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((AilEunary uop a_e, GenRValueType (mk_conversion gty)), ts))
                else
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl
                      ((CerbLocation.withCursorFrom
                        (match e with
                         | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                        (TError_ConstraintViolation (InvalidArgumentTypeUnaryExpression gty))))))
        | AilEunary (uop@Minus) e =>
          bind3
            (bind3 (/- STD §6.5.3.3#1, sentence 1 -/ add "§6.5.3.3#1, sentence 1")
              (fun (_ : Unit) => annotate_rvalue1 e))
            (fun (p : (expression genTypeCategory × genType)) =>
              match p with
              | (a_e, gty) =>
                (lem_if is_arithmetic0 gty then
                  let mk_conversion :=
                    lem_if is_integer0 gty then integer_promote else (fun (x : genType)=> x);
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((AilEunary uop a_e, GenRValueType (mk_conversion gty)), ts))
                else
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl
                      ((CerbLocation.withCursorFrom
                        (match e with
                         | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                        (TError_ConstraintViolation (InvalidArgumentTypeUnaryExpression gty))))))
        | AilEunary (uop@Bnot) e =>
          bind3
            (bind3
              (bind3
                (/- STD §6.5#4, sentence 1 -/ /- STD §6.5.3.3#1, sentence 2 -/ add
                  "STD §6.5#4, sentence 1") (fun (_ : Unit) => add "STD §6.5.3.3#1, sentence 2"))
              (fun (_ : Unit) => annotate_rvalue1 e))
            (fun (p : (expression genTypeCategory × genType)) =>
              match p with
              | (a_e, gty) =>
                (lem_if is_integer0 gty then
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr ((AilEunary uop a_e, GenRValueType (integer_promote gty)), ts))
                else
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl
                      ((CerbLocation.withCursorFrom
                        (match e with
                         | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                        (TError_ConstraintViolation (InvalidArgumentTypeUnaryExpression gty))))))
        | AilEunary Address e =>
          bind3
            (bind3 (/- STD §6.5.3.2#1 -/ add "§6.5.3.2#1") (fun (_ : Unit) =>
              annotate_expression1 CTXaddr e))
            (fun (a_e : expression genTypeCategory) =>
              match genTypeCategoryOf a_e with
              | GenRValueType (GenFunction ty1 params isVariadic) =>
                (/- e is a 'function designator' -/
                let gty' :=
                  GenPointer no_qualifiers
                    (Ctype ([] : List annot) (Function ty1 params isVariadic));
                ErrorM (fun (ts : List (List String)) =>
                  Sum.inr ((AilEunary Address a_e, GenRValueType gty'), ts)))
              | GenRValueType gty =>
                ErrorM (fun (_ : List (List String)) =>
                  Sum.inl
                    ((CerbLocation.withCursorFrom
                      (match e with
                       | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                      (TError_ConstraintViolation (UnaryAddressNotRvalue gty))))
              | GenLValueType qs ty1 isRegister =>
                (/- e is an 'lvalue' -/ lem_if isJust (bitfield_of_type ty1) then
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl (loc1, (TError_ConstraintViolation BitfieldAddress)))
                else lem_if isRegister then
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl
                      ((CerbLocation.withCursorFrom
                        (match e with
                         | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                        (TError_ConstraintViolation UnaryAddressRegisterLvalue)))
                else
                  bind3 (add "§6.5.3.2#3, 2nd sentence") (fun (_ : Unit) =>
                    ErrorM (fun (ts : List (List String)) =>
                      Sum.inr ((AilEunary Address a_e, GenRValueType (GenPointer qs ty1)), ts)))))
        | AilEunary Indirection e =>
          bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
            match p with
            | (e', gty) =>
              (match gty with
               | GenPointer ref_qs ref_ty =>
                 bind3
                   (bind3 (add "§6.5.3.2#4, sentence 2") (fun (_ : Unit) =>
                     add "§6.5.3.2#4, sentence 3"))
                   (fun (_ : Unit) =>
                     lem_if is_object ref_ty then /- -/
                       ErrorM (fun (ts : List (List String)) =>
                         Sum.inr
                           ((AilEunary Indirection e', GenLValueType ref_qs ref_ty false), ts))
                     else /- TODO: check that it's ok to drop the qualifiers -/
                       ErrorM (fun (ts : List (List String)) =>
                         Sum.inr
                           ((AilEunary Indirection e', GenRValueType (inject_type ref_ty)), ts)))
               | _ =>
                 ErrorM (fun (_ : List (List String)) =>
                   Sum.inl
                     ((CerbLocation.withCursorFrom
                       (match e with
                        | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                       (TError_ConstraintViolation IndirectionNotPointer)))))
        | AilEunary (uop@PostfixIncr) e =>
          bind3 (annotate_expression1 CTXincr e) (fun (e' : expression genTypeCategory) =>
            match genTypeCategoryOf e' with
            | GenLValueType qs' ty' _ =>
              bind3
                (/- TODO(check): why are we doing an lvalue coercion here? -/ lvalue_coercion sigm
                  ty')
                (fun (ty' : ctype) =>
                  /- NOTE: the STD at §6.5.3#1 doesn't directly says that pointer operand must be to
                       complete object type, but then #2 defers to §6.5.6#2 which does. -/
                  lem_if modifiable sigm qs' ty' &&
                      (atomic_qualified_unqualified is_real ty' || atomic_qualified_unqualified
                        (is_pointer_to_complete_object sigm) ty') then
                    ErrorM (fun (ts : List (List String)) =>
                      Sum.inr ((AilEunary uop e', GenRValueType (inject_type ty')), ts))
                  else
                    ErrorM (fun (_ : List (List String)) =>
                      Sum.inl
                        ((CerbLocation.withCursorFrom
                          (match e with
                           | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                          (TError_ConstraintViolation (InvalidArgumentTypeUnaryIncrement ty')))))
            | _ =>
              ErrorM (fun (_ : List (List String)) =>
                Sum.inl
                  ((CerbLocation.withCursorFrom
                    (match e with
                     | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                    (TError_ConstraintViolation UnaryExpressionNotLvalue))))
        | AilEunary (uop@PostfixDecr) e =>
          bind3 (annotate_expression1 CTXdecr e) (fun (e' : expression genTypeCategory) =>
            match genTypeCategoryOf e' with
            | GenLValueType qs' ty' _ =>
              bind3
                (/- TODO(check): why are we doing an lvalue coercion here? -/ lvalue_coercion sigm
                  ty')
                (fun (ty' : ctype) =>
                  /- NOTE: the STD at §6.5.3#1 doesn't directly says that pointer operand must be to
                       complete object type, but then #2 defers to §6.5.6#2 which does. -/
                  lem_if modifiable sigm qs' ty' &&
                      (atomic_qualified_unqualified is_real ty' || atomic_qualified_unqualified
                        (is_pointer_to_complete_object sigm) ty') then
                    ErrorM (fun (ts : List (List String)) =>
                      Sum.inr ((AilEunary uop e', GenRValueType (inject_type ty')), ts))
                  else
                    ErrorM (fun (_ : List (List String)) =>
                      Sum.inl
                        ((CerbLocation.withCursorFrom
                          (match e with
                           | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                          (TError_ConstraintViolation (InvalidArgumentTypeUnaryDecrement ty')))))
            | _ =>
              ErrorM (fun (_ : List (List String)) =>
                Sum.inl
                  ((CerbLocation.withCursorFrom
                    (match e with
                     | (AnnotatedExpression _ _ loc1 _) => loc1) loc1),
                    (TError_ConstraintViolation UnaryExpressionNotLvalue))))
        | AilEarray is_str elem_ty e_opts =>
          bind3
            (/- TODO: think about it -/ ailErr_mapM
              (maybe0 (ErrorM (fun (ts : List (List String)) => Sum.inr (none, ts)))
                (fun (e : expression Unit) =>
                  lem_if is_array elem_ty then
                    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
                      match p with
                      | (e', gty) =>
                        ((lemSeq
                          (fun _ =>
                            CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                              match u with
                              | () =>
                                "TODO!!! Ail's typing is not properly checking AilEarray when elem_ty is an array type"))
                          (fun _ =>
                            ErrorM (fun (ts : List (List String)) => Sum.inr ((some e'), ts))))))
                  else
                    bind3 (add "§6.7.9#11")
                      (fun (_ : Unit) => /- TODO: unqualify elem_ty? -/
                        (bind3
                          (annotate_assignee1 true InitializationAsSimpleAssignment loc1 elem_ty e)
                          ((fun (x : expression genTypeCategory)=>
                            ErrorM (fun (ts : List (List String)) => Sum.inr ((some x), ts))))))
                      /-
          annotate_rvalue e >>= fun (e', gty) ->
          /- TODO: maybe this is too strict and we want to relax to only having
             the types compatibles? -/
          if inject_type elem_ty <> gty then
            let () = Debug.print_debug 2 [] (fun () ->
              "elem_ty: " ^ Pp.stringFromAil_ctype no_qualifiers elem_ty
            ) in
            let () = Debug.print_debug 2 [] (fun () ->
              "gty: " ^ Pp.stringFromAil_genType gty
            ) in
            let () = Debug.print_debug 2 [] (fun () ->
              "expr: " ^ Pp.stringFromAil_expression expr
            ) in
            E.fail loc (TError "illtyped element of an AilEarray")
          else
            E.return (Just e')
-/
                      )) e_opts)
            (fun (xs : List
              (Option
                (expression
                  genTypeCategory))) => /- TODO: checking that the types in [xs] match ty -/
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr
                  ((AilEarray is_str elem_ty xs,
                    GenRValueType (GenArray elem_ty (some (Int.ofNat (List.length xs))))), ts)))
        | AilEstruct tag_sym xs =>
          (let struct_gty := GenStruct tag_sym;
           match lookup_tag_definition sigm tag_sym with
           | some (StructDef _ membersDefs _) =>
             (/- NOTE: the potential flexible array member is never prevent in the list of expressions
                       (as it cannot be initialised with an initializer) -/
             lem_if not ((List.length xs) == (List.length membersDefs)) then
               (failwithI "TODO: AilEstruct not the right number of members" : errorM
                 (expression_ genTypeCategory × genTypeCategory))
             else
               bind3
                 (ailErr_mapM
                   (fun (p : (identifier × Option (expression Unit))) =>
                     match p with
                     | (memb_ident, e_opt) =>
                       (match (lookupBy idEqual memb_ident membersDefs) with
                        | some (_, align_opt, memb_qs, memb_ty) =>
                          maybe0
                            (ErrorM (fun (ts : List (List String)) =>
                              Sum.inr ((memb_ident, none), ts)))
                            (fun (e : expression Unit) =>
                              bind3
                                (annotate_assignee1 true InitializationAsSimpleAssignment loc1
                                  memb_ty e)
                                (fun (a_e : expression genTypeCategory) =>
                                  ErrorM (fun (ts : List (List String)) =>
                                    Sum.inr ((memb_ident, some a_e), ts)))) e_opt
                        | none =>
                          ErrorM (fun (_ : List (List String)) =>
                            Sum.inl
                              (loc1,
                                (TError_ConstraintViolation
                                  (MemberofNoMemberRvalue memb_ident struct_gty)))))) xs)
                 (fun (a_xs : List (identifier × Option (expression genTypeCategory))) =>
                   ErrorM (fun (ts : List (List String)) =>
                     Sum.inr ((AilEstruct tag_sym a_xs, GenRValueType struct_gty), ts))))
           | _ =>
             (failwithI "annotate_expression(AilEstruct): failed to find a valid tag definition" :
               errorM (expression_ genTypeCategory × genTypeCategory)))
        | AilEunion tag_sym memb_ident none =>
          ErrorM (fun (ts : List (List String)) =>
            Sum.inr ((AilEunion tag_sym memb_ident none, GenRValueType (GenUnion tag_sym)), ts))
        | AilEunion tag_sym memb_ident (some e) =>
          (let union_gty := GenUnion tag_sym;
           match lookup_tag_definition sigm tag_sym with
           | some (UnionDef _ membersDefs) =>
             (match (lookupBy idEqual memb_ident membersDefs) with
              | some (_, align_opt, _, memb_ty) =>
                bind3 (annotate_assignee1 true InitializationAsSimpleAssignment loc1 memb_ty e)
                  (fun (a_e : expression genTypeCategory) =>
                    ErrorM (fun (ts : List (List String)) =>
                      Sum.inr
                        ((AilEunion tag_sym memb_ident (some a_e), GenRValueType union_gty), ts)))
              | none =>
                ErrorM (fun (_ : List (List String)) =>
                  Sum.inl
                    (loc1,
                      (TError_ConstraintViolation (MemberofNoMemberRvalue memb_ident union_gty)))))
           | _ =>
             (failwithI "annotate_expression(AilEunion): failed to find a valid tag definition" :
               errorM (expression_ genTypeCategory × genTypeCategory)))
        | AilEcompound qs ty1 e =>
          bind3 (/- STD §6.5.2.5#1 -/ add "§6.5.2.5#1") (fun (_ : Unit) =>
            lem_if (is_complete sigm ty1 && is_object ty1) ||
                (is_array_unknown_size ty1 && not (is_vla ty1)) then
              bind3
                (/- TODO: check that -/ (annotate_definition_aux _lemReader_enum_definitions
                  _lemReader_tagDefs) annotate_block1 sigm gamm (ty1, e))
                (fun (a_e : expression genTypeCategory) =>
                  bind3 (add "§6.5.2.5#4") (fun (_ : Unit) =>
                    ErrorM (fun (ts : List (List String)) =>
                      Sum.inr ((AilEcompound qs ty1 a_e, GenLValueType qs ty1 false), ts))))
            else
              ErrorM (fun (_ : List (List String)) =>
                Sum.inl (loc1, (TError_ConstraintViolation InvalidTypeCompoundLiteral))))
        | AilEbuiltin b =>
          (match b with
           | AilBatomic _ =>
             ErrorM (fun (_ : List (List String)) =>
               Sum.inl
