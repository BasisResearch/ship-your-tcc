def annotate_sigma [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (sigm : sigma Unit) :
    errorM (sigma genTypeCategory) :=
  bind3
    (bind3
      (/- TODO: morally we want a "mapP_" here -/ /- Checking that declarations are well-formed -/ ailErr_mapM
        (fun (p : (sym × (CerbLocation.Loc × attributes × declaration))) =>
          match p with
          | (ident, decl) =>
            (match decl with
             | (_, _, decl@(Decl_object dur_opt _ qs ty1)) =>
               bind3 (wf_lvalue sigm qs ty1) (fun (_ : Unit) =>
                 ErrorM (fun (ts : List (List String)) => Sum.inr ((ident, decl), ts)))
             | (_, _, decl@(Decl_function hasProto ret_ty params isVariadic _ /- isInline -/ _)) =>
               bind3
                 (/- TODO?   ==> AilTyping.well_formed_bindings bs && -/ wf_type sigm
                   (Ctype ([] : List annot) (Function ret_ty params isVariadic)))
                 (fun (_ : Unit) =>
                   ErrorM (fun (ts : List (List String)) => Sum.inr ((ident, decl), ts)))))
        sigm.declarations)
      (fun (_ : List
        (sym × declaration)) => /- Typechecking of external objects that have a definition -/
        ailErr_mapM
          (fun (p : (sym × expression Unit)) =>
            match p with
            | (ident, e) =>
              (match (lookupBy
                   (fun (sym1 : sym) (sym2 : sym)=>
                     match sym1, sym2 with
                     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                         lem_if natGteb 0 5 && (sd1 != sd2) then
                           (lemSeq
                             (fun _ =>
                               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                 match u with
                                 | () =>
                                   String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                     (String.append (show_symbol_description sd1)
                                       (String.append " <-> " (show_symbol_description sd2)))))
                             (fun _ => true))
                         else
                           true
                       else
                         false)) ident sigm.declarations) with
               | some (loc1, _, Decl_object _ _ _ /- qs -/ ty1) =>
                 bind3
                   (/- TODO: qualifiers?; storage duration? -/ (annotate_definition_aux
                     _lemReader_enum_definitions _lemReader_tagDefs)
                     ((annotate_block _lemReader_enum_definitions _lemReader_tagDefs) none) sigm
                     ([] : List
                       (sym ×
                         ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                           qualifiers × ctype))) (ty1, e))
                   (fun (def1 : expression genTypeCategory) =>
                     ErrorM (fun (ts : List (List String)) => Sum.inr ((ident, def1), ts)))
               | _ =>
                 (failwithI "annotate_sigma: object definition must have a declaration" : errorM
                   (sym × expression genTypeCategory)))) sigm.object_definitions))
    (fun (object_defs' : List (sigma_object_definition genTypeCategory)) =>
      bind3
        (/- Typechecking of functions that have a definition -/ ailErr_mapM
          (fun (p : (sym × (CerbLocation.Loc × Nat × attributes × List sym × statement Unit))) =>
            match p with
            | (ident, (loc1, marker_id1, attr, param_idents, s)) =>
              (match (lookupBy
                   (fun (sym1 : sym) (sym2 : sym)=>
                     match sym1, sym2 with
                     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                         lem_if natGteb 0 5 && (sd1 != sd2) then
                           (lemSeq
                             (fun _ =>
                               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                 match u with
