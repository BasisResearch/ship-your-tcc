              E.return (AilEva_start e' sym, GenRValueType GenVoid)
          | _ ->
              E.misc (locOf e) VaStartArgumentType
        end
        -/
        | AilEva_copy e1 e2 =>
          bind3 (annotate_rvalue1 e1) (fun (p : (expression genTypeCategory × genType)) =>
            match p with
            | (e1', _) =>
              bind3 (annotate_rvalue1 e2) (fun (p : (expression genTypeCategory × genType)) =>
                match p with
                | (e2', _) =>
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr
                      ((AilEva_copy e1' e2',
                        GenRValueType (GenBasic (GenInteger (Concrete (Signed Int_))))), ts))))
        | AilEva_arg e ty1 =>
          bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
            match p with
            | (e', _) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr ((AilEva_arg e' ty1, GenRValueType (inject_type ty1)), ts)))
        /- TODO: add this check later
        annotate_rvalue e >>= function
          | (e', GenBuiltin "va_list") ->
              E.return (AilEva_arg e' ty, GenRValueType (inject_type ty))
          | _ ->
              E.misc (locOf e) VaArgArgumentType
        end
        -/
        | AilEva_end e =>
          bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
            match p with
            | (e', _) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr ((AilEva_end e', GenRValueType GenVoid), ts)))
        | AilEprint_type e =>
          bind3 (annotate_expression1 ctx e) (fun (a_e : expression genTypeCategory) =>
            ErrorM (fun (ts : List (List String)) =>
              Sum.inr ((AilEprint_type a_e, genTypeCategoryOf0 a_e), ts)))
        | AilEbmc_assume e =>
          bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
            match p with
            | (e', gty) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr ((AilEbmc_assume e', GenRValueType GenVoid), ts)))
        | AilEreg_load r =>
          ErrorM
            (fun (ts : List (List String)) =>
              Sum.inr
                ((AilEreg_load r, GenRValueType (GenBasic (GenInteger (Concrete (Signed Int_))))),
                  ts)) /- NOTE: assuming registers are always of type int -/
        | AilErvalue
          _ => /- This should be impossible because the desugaring doesn't emit any AilErvalue -/
          (failwithI "annotate_expression(AilErvalue)" : errorM
            (expression_ genTypeCategory × genTypeCategory))
        | AilEarray_decay
          _ => /- This should be impossible because the Desugaring doesn't emit any AilEarray_decay -/
          (failwithI "annotate_expression(AilEarray_decay)" : errorM
            (expression_ genTypeCategory × genTypeCategory))
        | AilEfunction_decay
          _ => /- This should be impossible because the Desugaring doesn't emit any AilEfunction_decay -/
          (failwithI "annotate_expression(AilEfunction_decay)" : errorM
            (expression_ genTypeCategory × genTypeCategory))
        | AilEatomic
          _ => /- This should be impossible because the desugaring doesn't emit any AilEatomic -/
          (failwithI "annotate_expression(AilEatomic)" : errorM
            (expression_ genTypeCategory × genTypeCategory))
        | AilEgcc_statement bs ss =>
          bind3 (well_formed_bindings loc1 sigm bs) (fun (u : Unit) =>
            match u with
            | () =>
              (lem_if sigma_fresh_bindings bs sigm then
                bind3 (annotate_block1 sigm gamm bs ss)
                  (fun (ss' : List (statement genTypeCategory)) =>
                    match Lem_List.dest_init ss' with
                    | none =>
                      ErrorM (fun (ts : List (List String)) =>
                        Sum.inr
                          ((AilEgcc_statement bs ([] : List (statement genTypeCategory)),
                            GenRValueType GenVoid), ts))
                    | some (ss', last_s') =>
                      (/- if last_s is of the form l1: ... ln: E; then we use the type of E otherwise void -/
                      let gtc := (typeof_statement_as_expression last_s').statement_category;
                      ErrorM (fun (ts : List (List String)) =>
                        Sum.inr ((AilEgcc_statement bs (ss' ++ [last_s']), gtc), ts))))
              else
                (failwithI "annotate_statement: sigma_fresh bindings failed in a AilSblock" : errorM
                  (expression_ genTypeCategory × genTypeCategory))))
        | AilEinvalid ty1 reason =>
          ErrorM (fun (ts : List (List String)) =>
            Sum.inr ((AilEinvalid ty1 reason, GenRValueType (inject_type ty1)), ts)))
       (fun (p : (expression_ genTypeCategory × genTypeCategory)) =>
         match p with
         | (expr_', gtc) =>
           bind3 unpack (fun (annots1 : List String) =>
             let annots1 := (fun x y => x ++ y) std_annots (List.map Astd annots1);
             match gnu_align_typedef
                 ((result_type_alignment _lemReader_enum_definitions _lemReader_tagDefs) sigm loc1
                   gtc expr_') (Ctype annots1 Void0) with
             | Ctype type_annots _ =>
               (perform_decays _lemReader_enum_definitions _lemReader_tagDefs) sigm ctx
                 (AnnotatedExpression gtc type_annots loc1 expr_'))))
partial def perform_decays [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (sigm : sigma Unit)
    (ctx : annotation_context) (a_expr : expression genTypeCategory) :
    errorM (expression genTypeCategory) :=
  match sigm, ctx, a_expr with
  | sigm, ctx, a_expr =>
    (let is_literal :=
       match a_expr with
       | AnnotatedExpression _ _ _ (AilEarray true _ _) => true
       | AnnotatedExpression _ _ _ (AilEconst (ConstantArray _ _)) => true
       | AnnotatedExpression _ _ _ (AilEstr _) => /- TODO: this is probably dead now -/ true
       | _ => false;
     match annotations0 a_expr with
     | (std_annots, GenLValueType qs ty1 isRegister) =>
       ((lemSeq
         (fun _ =>
           CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
             match u with
             | () => String.append "GenLValueType ==>" (CerbPP.stringFromAil_ctype qs ty1)))
         (fun _ =>
           lem_if not (is_array ty1) && not
               (Lem_List.elem ctx
                 [CTXsizeof, CTXaddr, CTXincr, CTXdecr, CTXmemberof,
                   CTXassign]) then /- STD §6.3.2.1#2 -/ /- performing the lvalue conversion -/
             match ty1 with
             | Ctype type_annots _ =>
               (let rvalue_ty := Ctype type_annots (unatomic_ ty1);
                lem_if is_incomplete sigm ty1 then /- STD §6.3.2.1#2, sentence 3 -/
                  ErrorM (fun (_ : List (List String)) =>
                    Sum.inl
                      ((match ty1 with
                        | (Ctype annots1 _) => get_loc_ annots1),
                        (TError_UndefinedBehaviour UB020_nonarray_incomplete_lvalue_conversion)))
                else
                  ErrorM (fun (ts : List (List String)) =>
                    Sum.inr
                      ((AnnotatedExpression (GenRValueType (inject_type rvalue_ty))
                        (std_annots ++ type_annots)
                        (match a_expr with
                         | (AnnotatedExpression _ _ loc1 _) => loc1) (AilErvalue a_expr)), ts)))
           else lem_if is_array ty1 &&
               (not (Lem_List.elem ctx [CTXsizeof, CTXaddr]) && not
                 (Lem_List.elem ctx [CTXarray_init] &&
                   is_literal)) then /- STD §6.3.2.1#3 -/ /- performing the array decay -/
             lem_if isRegister then
               ErrorM (fun (_ : List (List String)) =>
                 Sum.inl
                   (CerbLocation.unknown, (TError_UndefinedBehaviour UB022_register_array_decay)))
             else /- TODO: qualifiers?? -/
               (lemSeq
                 (fun _ =>
                   (lem_if not (is_unqualified qs) then
                     CerbDebug.warn [DB_ail_typing] (fun (u : Unit) =>
                       match u with
                       | () => "(UNSURE) GenTyping.array_decay, qs <> {}")
                   else
                     ()))
                 (fun _ =>
                   ErrorM (fun (ts : List (List String)) =>
                     Sum.inr
                       ((AnnotatedExpression (GenRValueType (inject_type (array_coercion ty1)))
                         (gnu_clear_typedef_alignment std_annots)
                         (match a_expr with
                          | (AnnotatedExpression _ _ loc1 _) => loc1) (AilEarray_decay a_expr)),
                         ts))))
           else
             ErrorM (fun (ts : List (List String)) => Sum.inr (a_expr, ts)))))
     | (std_annots, GenRValueType gty) =>
       (lem_if not
           (Lem_List.elem ctx
             [CTXsizeof, CTXaddr]) then /- STD §6.3.2.1#4 -/ /- performing the function decay -/
         ErrorM (fun (ts : List (List String)) =>
           Sum.inr
             (match gty with
              | GenFunction ty1 params isVariadic =>
                AnnotatedExpression
                  (GenRValueType
                    (GenPointer no_qualifiers
                      (Ctype ([] : List annot) (Function ty1 params isVariadic))))
                  (gnu_clear_typedef_alignment std_annots)
                  (match a_expr with
                   | (AnnotatedExpression _ _ loc1 _) => loc1) (AilEfunction_decay a_expr)
              | GenArray elem_ty sz_opt =>
                (match a_expr with
                 | AnnotatedExpression _ _ _ (AilEconst (ConstantIndeterminate _)) => a_expr
                 | AnnotatedExpression _ _ _ (AilEarray false _ _) =>
                   /- NOTE: this case doesn't syntactically exist in C, since
                       array values don't exist -/
                   a_expr
                 | AnnotatedExpression _ _ _
                   (AilEinvalid _ _) => /- We need invalid nodes kept as is -/
                   a_expr
                 | _ =>
                   (lem_if not (Lem_List.elem ctx [CTXarray_init] && is_literal) then
                     let ty1 := Ctype ([] : List annot) (Array0 elem_ty sz_opt);
                     /- STD §6.3.2.1#3 -/ /- performing the array decay -/ AnnotatedExpression
                       (GenRValueType (inject_type (array_coercion ty1)))
                       (gnu_clear_typedef_alignment std_annots)
                       (match a_expr with
                        | (AnnotatedExpression _ _ loc1 _) => loc1) (AilEarray_decay a_expr)
                   else
                     a_expr))
              | _ => a_expr, ts))
       else
         ErrorM (fun (ts : List (List String)) => Sum.inr (a_expr, ts))))
partial def annotate_arguments_aux [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (add_casts : Bool)
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (n_args : Nat) (n_params : Nat) (loc1 : CerbLocation.Loc) (is_variadic : Bool)
    (args : List (expression Unit)) (params : List (qualifiers × ctype × Bool)) :
    errorM (List (expression genTypeCategory)) :=
  match add_casts, annotate_block1, sigm, gamm, n_args, n_params, loc1, is_variadic, args,
      params with
  | add_casts, annotate_block1, sigm, gamm, n_args, n_params, loc1, is_variadic, args, params =>
    (let annotate_expression1 :=(annotate_expression _lemReader_enum_definitions _lemReader_tagDefs)
         annotate_block1 sigm gamm CTXother;
     let annotate_assignee1 :=(annotate_assignee _lemReader_enum_definitions _lemReader_tagDefs)
         annotate_block1 sigm gamm false FunctionParameterAsSimpleAssignment;
     let annotate_arguments_aux1 :=(annotate_arguments_aux _lemReader_enum_definitions
         _lemReader_tagDefs) add_casts annotate_block1 sigm gamm n_args n_params loc1 is_variadic;
     match args, params with
     | [], [] =>
       ((lemSeq
         (fun _ =>
           CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
             match u with
             | () => "WTF []"))
         (fun _ =>
           ErrorM (fun (ts : List (List String)) =>
             Sum.inr (([] : List (expression genTypeCategory)), ts)))))
     | [], [(_, Ctype _ Void0, _)] => /- TODO: document this case -/
       ErrorM (fun (ts : List (List String)) =>
         Sum.inr (([] : List (expression genTypeCategory)), ts))
     | arg_e :: args', (_, param_ty1, isRegister) :: params' =>
       (/-
        if has_proto then
-/
       /- NOTE: we use 'unknown' location here because the location of the
             argument argment is used in the end -/
       let rvalue_ty := (rvalue_coercion param_ty1);
       bind3 (annotate_assignee1 CerbLocation.unknown rvalue_ty arg_e)
         (fun (a_arg_e : expression genTypeCategory) =>
           bind3 (annotate_arguments_aux1 args' params')
             (fun (a_args' : List (expression genTypeCategory)) =>
               let a_arg_e' :=
                 lem_if add_casts then
                   AnnotatedExpression (GenRValueType (inject_type rvalue_ty)) ([] : List annot)
                     (match a_arg_e with
                      | (AnnotatedExpression _ _ loc1 _) => loc1)
                     (AilEcast no_qualifiers rvalue_ty a_arg_e)
                 else
                   a_arg_e;
               ErrorM (fun (ts : List (List String)) => Sum.inr ((a_arg_e' :: a_args'), ts)))))
     /-
        else
          /- the called function has a type that does not include a prototype -/
          /- STD §6.5.2.2#6 -/
          let ty1' = KKKK
-/
     | _, [] =>
       (/- This case must correspond to a call to a variadic function -/ lem_if not is_variadic then
         ErrorM (fun (_ : List (List String)) =>
           Sum.inl
             (loc1, (TError_ConstraintViolation (FunctionCallTooManyArguments n_params n_args))))
       else /- following (§6.5.2.2#7) -/ /- TODO: default argument promotion + checks (at least that there are no void-expression, though this might already be done by the promotion) -/
         ailErr_mapM annotate_expression1 args)
     /-
          E.mapM annotate_expression args >>= fun a_args ->
          if List.any (fun z -> type_of annot z = Void) a_args then
            E.fail Loc.unknown (TError "called a variadic function with a void expression")
          else
            E.return a_args
-/
     | _, _ =>
       ErrorM (fun (_ : List (List String)) =>
         Sum.inl
           (loc1, (TError_ConstraintViolation (FunctionCallTooFewArguments n_params n_args)))))
partial def annotate_definition_aux [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (p : (ctype × expression Unit)) :
    errorM (expression genTypeCategory) :=
  match annotate_block1, sigm, gamm, p with
  | annotate_block1, sigm, gamm, (ty1, e) =>
    (lem_if (((not (is_array ty1)) || has_unknown_size sigm ty1)) ||
        (((not (is_complete_object sigm ty1)) || not (is_vla ty1))) then
      lem_if atomic_qualified_unqualified is_scalar ty1 then
        bind3 (add "§6.7.9#11, sentence 3")
          (fun (_ : Unit) =>
            /- NOTE: since we are not passing a `qs' with `ty' to annotate_assignee,
         we are indeed unqualifying the scalar type -/
            /- TODO: add location -/ (annotate_assignee _lemReader_enum_definitions
              _lemReader_tagDefs) annotate_block1 sigm gamm true InitializationAsSimpleAssignment
              CerbLocation.unknown ty1 e) /- TODO: "(...) that has automatic storage duration" -/
      else lem_if atomic_qualified_unqualified is_struct_or_union ty1 then
        bind3 (/- TODO: check -/ add "§6.7.9#13")
          (fun (_ : Unit) =>
            (annotate_assignee _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm
              gamm true InitializationAsSimpleAssignment CerbLocation.unknown ty1 e)
          /- annotate_rvalue sigm gamm e >>= fun (a_e, gty) ->
      AilEassign
      /- TODO: need to make sure that gty is compatible with ty -/
      E.return a_e -/
           /- STD §6.7.9#15 -/
      else lem_if (compatibleWithQualifiedUnqualifiedVersionOf _lemReader_enum_definitions
          _lemReader_tagDefs) ty1 [wchar_t, char16_t, char32_t] then
        (failwithI
          "WIP: annotate_definition_aux, compatibleWithQualifiedUnqualifiedVersionOf ty [wchar_t; char16_t; char32_t]" :
          errorM
          (expression
            genTypeCategory)) /- STD §6.7.9#16 -/ /-          else if  then -/ /- KKK -/ /- TODO: at this point we should now have a non character array -/
      else lem_if is_array
          ty1 then /- TODO: check the std. (not that it says anything useful here ...) -/
        let ctx :=/-          if AAux.is_array_of_character ty then -/ lem_if is_array ty1 then
            CTXarray_init
          else
            CTXother;
        bind3
          ((annotate_expression _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm
            gamm ctx e)
          (fun (a_e : expression genTypeCategory) =>
            (lemSeq
              (fun _ =>
                CerbDebug.warn [DB_ail_typing] (fun (u : Unit) =>
                  match u with
                  | () =>
                    "(UNSURE) for the definition of arrays the compatilibity of types is checked for they unqualified versions and ignoring the elem_qs"))
              (fun _ =>
                match ty1, genTypeCategoryOf a_e with
                | Ctype _ (Array0 elem_ty1 none), GenRValueType (GenArray elem_ty2 (some n)) =>
                  (lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
                      (no_qualifiers, elem_ty1) (no_qualifiers, elem_ty2) then
                    ErrorM
                      (fun (ts : List (List String)) =>
                        Sum.inr (a_e, ts)) /- (e', GenArray elem_ty1 (Just n)) -/
                  else
                    (failwithI
                      (String.append
                        "TODO(annotate_definition_aux, 1): error message: array object definition, types didn't match ==> "
                        (String.append (CerbPP.stringFromAil_ctype no_qualifiers elem_ty1)
                          (String.append " <-> "
                            (CerbPP.stringFromAil_ctype no_qualifiers elem_ty2)))) : errorM
                      (expression genTypeCategory)))
                | Ctype _ (Array0 elem_ty1 (some n1)),
                  GenRValueType (GenArray elem_ty2 (some n2)) =>
                  (lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
                      (no_qualifiers, elem_ty1) (no_qualifiers, elem_ty2) && (n1 == n2) then
                    ErrorM
                      (fun (ts : List (List String)) =>
                        Sum.inr (a_e, ts)) /- (e', GenArray elem_ty1 (Just n1)) -/
                  else
                    (failwithI
                      (String.append
                        "TODO(annotate_definition_aux, 2): error message: array object definition, types didn't match ==> "
                        (String.append (CerbPP.stringFromAil_ctype no_qualifiers elem_ty1)
                          (String.append " <-> "
                            (CerbPP.stringFromAil_ctype no_qualifiers elem_ty2)))) : errorM
                      (expression genTypeCategory)))
                | Ctype _ (Array0 elem_ty1 (some n1)),
                  GenLValueType qs2 (Ctype _ (Array0 elem_ty2 (some n2))) _ =>
                  (/- TODO: isRegister? -/ /- TODO: what if n1 < n2? -/ /- TODO: check std -/ lem_if (are_compatible
                      _lemReader_enum_definitions _lemReader_tagDefs) (no_qualifiers, elem_ty1)
                      (no_qualifiers, elem_ty2) && intGteb n1 n2 then
                    ErrorM (fun (ts : List (List String)) => Sum.inr (a_e, ts))
                  else
                    (failwithI
                      (String.append
                        "TODO(annotate_definition_aux, 3): error message: array object definition, types didn't match ==> "
                        (String.append (CerbPP.stringFromAil_ctype no_qualifiers elem_ty1)
                          (String.append "["
                            (String.append (Lem_String_extra.stringFromInteger n1)
                              (String.append "] <-> "
                                (String.append (CerbPP.stringFromAil_ctype no_qualifiers elem_ty2)
                                  (String.append "["
                                    (String.append (Lem_String_extra.stringFromInteger n2)
                                      "]")))))))) : errorM (expression genTypeCategory)))
                | _, _ =>
                  (/- STD §6.7.9#14 -/ lem_if is_array_of_character ty1 then
                    (failwithI
                      (String.append "WIP: annotate_definition_aux, is_array_of_character ty ==> "
                        (String.append (CerbPP.stringFromAil_ctype no_qualifiers ty1)
                          (String.append " <===> " (CerbPP.stringFromAil_expression a_e)))) : errorM
                      (expression genTypeCategory))
                  else
                    (lemSeq
                      (fun _ =>
                        CerbDebug.print_debug_pure 0 ([] : List domain) (fun (u : Unit) =>
                          match u with
                          | () => String.append "a_e: " (CerbPP.stringFromAil_expression a_e)))
                      (fun _ =>
                        (lemSeq
                          (fun _ =>
                            CerbDebug.print_debug_pure 0 ([] : List domain) (fun (u : Unit) =>
                              match u with
                              | () =>
                                String.append "ty: "
                                  (String.append (CerbPP.stringFromAil_ctype no_qualifiers ty1)
                                    (String.append " <--> gty: "
                                      (match genTypeCategoryOf a_e with
                                       | GenLValueType qs' ty' _ =>
                                         String.append "lvalue "
                                           (CerbPP.stringFromAil_ctype qs' ty')
                                       | GenRValueType gty =>
                                         String.append "rvalue "
                                           (CerbPP.stringFromAil_genType gty))))))
                          (fun _ =>
                            (failwithI
                              "WIP: annotate_definition, not(is_scalar ty), not array (or had no size)" :
                              errorM (expression genTypeCategory))))))))))
      else
        (failwithI "WIP: annotate_definition_aux, final case" : errorM (expression genTypeCategory))
    else /- STD §6.7.9#3 -/
      let kind1 := lem_if is_vla ty1 then InitialisedVLA else InitialisedIncomplete ty1;
      ErrorM (fun (_ : List (List String)) =>
        Sum.inl
          ((match e with
            | (AnnotatedExpression _ _ loc1 _) => loc1),
            (TError_ConstraintViolation (IllegalInitialisation kind1)))))
end
def annotate_definition [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → List
      (sym ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
      List (statement Unit) → errorM (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (p : (sym × Option (expression Unit))) :
    errorM (sym × Option (expression genTypeCategory)) :=
  match annotate_block1, sigm, gamm, p with
  | annotate_block1, sigm, gamm, (sym1, e_opt) =>
    (match e_opt,
         (lookupBy
           (fun (sym1 : sym) (sym2 : sym)=>
             match sym1, sym2 with
             | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
               (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                 lem_if natGteb 0 5 && (sd1 != sd2) then
                   (lemSeq
                     (fun _ =>
                       CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                         match u with
                         | () =>
                           String.append "[Symbol.symbolEqual] suspicious equality ==> "
                             (String.append (show_symbol_description sd1)
                               (String.append " <-> " (show_symbol_description sd2)))))
                     (fun _ => true))
                 else
                   true
               else
                 false)) sym1 gamm) with
     | none, some _ => ErrorM (fun (ts : List (List String)) => Sum.inr ((sym1, none), ts))
     | some e, some (_, _, sym_qs, sym_ty) =>
       bind3
         ((annotate_definition_aux _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1
           sigm gamm (sym_ty, e))
         (fun (a_e : expression genTypeCategory) =>
           ErrorM (fun (ts : List (List String)) => Sum.inr ((sym1, some a_e), ts)))
     | _, none =>
       (failwithI "annotate_definition: symbol not found in the context" : errorM
         (sym × Option (expression genTypeCategory))))
partial def annotate_definitions [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (annotate_block1 : sigma Unit → gamma → bindings → List (statement Unit) → errorM
      (List (statement genTypeCategory))) (sigm : sigma Unit)
    (gamm : List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype))) :
    List (sym × Option (expression Unit)) → errorM
        (List (sym × Option (expression genTypeCategory))) :=
  fun (x : List (sym × Option (expression Unit))) =>
    match x with
    | [] =>
      ErrorM (fun (ts : List (List String)) =>
        Sum.inr (([] : List (sym × Option (expression genTypeCategory))), ts))
    | d :: ds =>
      bind3
        ((annotate_definition _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm
          gamm d)
        (fun (d : (sym × Option (expression genTypeCategory))) =>
          bind3
            ((annotate_definitions _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1
              sigm gamm ds)
            (fun (ds : List (sym × Option (expression genTypeCategory))) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((d :: ds), ts))))

