                  else
                    ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts))));
          bind3
            (ailErr_mapM
              (fun (x : (sym × (CerbLocation.Loc × attributes × tag_definition))) =>
                match x with
                | (_, (_, _, StructDef _ xs flexible_opt)) =>
                  bind3
                    (lemListFoldr
                      (fun (m : errorM Unit) (f : errorM Unit)=> bind3 m (fun (_ : Unit) => f))
                      (ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts)))
                      (List.map (check_member true) xs))
                    (fun (u : Unit) =>
                      match u with
                      | () =>
                        bind3
                          (lemListFoldr
                            (fun (m : errorM Unit) (f : errorM Unit)=>
                              bind3 m (fun (_ : Unit) => f))
                            (ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts)))
                            (List.map
                              (fun (p :
                                (identifier ×
                                  (attributes × Option alignment × qualifiers × ctype))) =>
                                match p with
                                | (_,
                                  (_, _, qs,
                                    ty1)) => /- TODO: check that it is ok to use wf_lvalue (instead of just wf_type) -/
                                  wf_lvalue sigm qs ty1) xs))
                          (fun (u : Unit) =>
                            match u with
                            | () =>
                              (match flexible_opt with
                               | none => ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts))
                               | some (FlexibleArrayMember _ _ flex_qs flex_elem_ty) =>
