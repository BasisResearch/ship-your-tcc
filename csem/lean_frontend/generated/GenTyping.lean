partial def annotate_statement_ [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (sigm : sigma Unit)
    (gamm : List
      (ail_identifier ×
        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)))
    (ty1 : ctype) (stmt : statement_ Unit) :
    errorM (statement_ genTypeCategory) :=
  let annotate_block1 :=(annotate_block _lemReader_enum_definitions _lemReader_tagDefs) (some ty1);
  let annotate_expression1 :=(annotate_expression _lemReader_enum_definitions _lemReader_tagDefs)
      annotate_block1 sigm gamm CTXother;
  let annotate_rvalue1 :=(annotate_rvalue _lemReader_enum_definitions _lemReader_tagDefs)
      annotate_block1 sigm gamm;
  let annotate_statement1 :=(annotate_statement _lemReader_enum_definitions _lemReader_tagDefs) sigm
      gamm ty1;
  match stmt with
  | AilSskip => ErrorM (fun (ts : List (List String)) => Sum.inr (AilSskip, ts))
  | AilSexpr e =>
    bind3 (annotate_expression1 e) (fun (e' : expression genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSexpr e'), ts)))
  | AilSblock bindings1 ss =>
    bind3 (well_formed_bindings loc1 sigm bindings1) (fun (_ : Unit) =>
      lem_if sigma_fresh_bindings bindings1 sigm then
        bind3 (annotate_block1 sigm gamm bindings1 ss)
          (fun (ss' : List (statement genTypeCategory)) =>
            ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSblock bindings1 ss'), ts)))
      else
        (failwithI "annotate_statement: sigma_fresh bindings failed in a AilSblock" : errorM
          (statement_ genTypeCategory)))
  | AilSif e s1 s2 =>
    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
      match p with
      | (e', gty) =>
        bind3 (add "§6.8.4.1#1") (fun (_ : Unit) =>
          lem_if is_scalar0 gty then
            bind3 (annotate_statement1 s1) (fun (s1' : statement genTypeCategory) =>
              bind3 (annotate_statement1 s2) (fun (s2' : statement genTypeCategory) =>
                ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSif e' s1' s2'), ts))))
          else
            ErrorM (fun (_ : List (List String)) =>
              Sum.inl
                ((match e with
                  | (AnnotatedExpression _ _ loc1 _) => loc1),
                  (TError_ConstraintViolation IfStatementControllingExpressionNotScalar)))))
  | AilSwhile e s id1 =>
    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
      match p with
      | (e', gty) =>
        bind3 (add "§6.8.5#2") (fun (_ : Unit) =>
          lem_if is_scalar0 gty then
            bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSwhile e' s' id1), ts)))
          else
            ErrorM (fun (_ : List (List String)) =>
              Sum.inl
                ((match e with
                  | (AnnotatedExpression _ _ loc1 _) => loc1),
                  (TError_ConstraintViolation IterationStatementControllingExpressionNotScalar)))))
  | AilSdo s e id1 =>
    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
      match p with
      | (e', gty) =>
        bind3 (add "§6.8.5#2") (fun (_ : Unit) =>
          lem_if is_scalar0 gty then
            bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSdo s' e' id1), ts)))
          else
            ErrorM (fun (_ : List (List String)) =>
              Sum.inl
                ((match e with
                  | (AnnotatedExpression _ _ loc1 _) => loc1),
                  (TError_ConstraintViolation IterationStatementControllingExpressionNotScalar)))))
  | AilSbreak => ErrorM (fun (ts : List (List String)) => Sum.inr (AilSbreak, ts))
  | AilScontinue => ErrorM (fun (ts : List (List String)) => Sum.inr (AilScontinue, ts))
  | AilSreturnVoid =>
    (lem_if is_void ty1 then
      ErrorM (fun (ts : List (List String)) => Sum.inr (AilSreturnVoid, ts))
    else
      ErrorM (fun (_ : List (List String)) =>
        Sum.inl (loc1, (TError_ConstraintViolation NonVoidReturnVoidFunction))))
  | AilSreturn e =>
    bind3
      ((annotate_assignee _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm gamm
        false ReturnAsSimpleAssignment
        (CerbLocation.withCursorFrom
          (match e with
           | (AnnotatedExpression _ _ loc1 _) => loc1) loc1) ty1 e)
      (fun (e' : expression genTypeCategory) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSreturn e'), ts)))
  | AilSswitch e s =>
    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
      match p with
      | (e', gty) =>
        bind3 (add "§6.8.4.2#1") (fun (_ : Unit) =>
          lem_if is_integer0 gty then
            bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
              ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSswitch e' s'), ts)))
          else
            ErrorM (fun (_ : List (List String)) =>
              Sum.inl
                ((match e with
                  | (AnnotatedExpression _ _ loc1 _) => loc1),
                  (TError_ConstraintViolation SwitchStatementControllingExpressionNotInteger)))))
  | AilScase n s =>
    bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilScase n s'), ts)))
  | AilScase_rangeGNU n1 n2 s =>
    bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilScase_rangeGNU n1 n2 s'), ts)))
  | AilSdefault s =>
    bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSdefault s'), ts)))
  | AilSlabel sym1 s la =>
    bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSlabel sym1 s' la), ts)))
  | AilSgoto sym1 => ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSgoto sym1), ts))
  | AilSdeclaration sym_es =>
    bind3
      ((annotate_definitions _lemReader_enum_definitions _lemReader_tagDefs) annotate_block1 sigm
        gamm sym_es)
      (fun (sym_es' : List (ail_identifier × Option (expression genTypeCategory))) =>
        ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSdeclaration sym_es'), ts)))
  | AilSpar ss =>
    bind3 (ailErr_mapM annotate_statement1 ss) (fun (ss' : List (statement genTypeCategory)) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSpar ss'), ts)))
  | AilSreg_store r e =>
    bind3 (annotate_rvalue1 e) (fun (p : (expression genTypeCategory × genType)) =>
      match p with
      | (e', _) => ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSreg_store r e'), ts)))
  | AilSmarker id1 s =>
    bind3 (annotate_statement1 s) (fun (s' : statement genTypeCategory) =>
      ErrorM (fun (ts : List (List String)) => Sum.inr ((AilSmarker id1 s'), ts)))

partial def annotate_statement [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (sigm : sigma Unit)
