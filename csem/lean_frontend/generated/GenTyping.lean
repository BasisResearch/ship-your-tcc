                    lemListFoldr
                      (fun (m : errorM Unit) (f : errorM Unit)=> bind3 m (fun (_ : Unit) => f))
                      (ErrorM (fun (ts : List (List String)) => Sum.inr ((), ts)))
                      (List.map
                        (fun (p :
                          (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
                          match p with
                          | (_,
                            (_, _, qs,
                              ty1)) => /- TODO: check that it is ok to use wf_lvalue (instead of just wf_type) -/
                            wf_lvalue sigm qs ty1) xs))) sigm.tag_definitions)
            (fun (_ : List Unit) =>
              ErrorM (fun (ts : List (List String)) =>
                Sum.inr
                  ((({ declarations := sigm.declarations,
                       object_definitions := object_defs',
                       function_definitions := function_defs',
                       static_assertions :=
