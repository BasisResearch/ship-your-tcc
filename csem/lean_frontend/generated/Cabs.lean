def cabs_expression_.beq_derived (cmpx_ cmpy_ : cabs_expression_) : Bool :=
  match cmpx_, cmpy_ with
  | .CabsEident x1, .CabsEident y1 => x1 == y1
  | .CabsEconst x1, .CabsEconst y1 => x1 == y1
  | .CabsEstring x1, .CabsEstring y1 => x1 == y1
  | .CabsEgeneric x1 x2, .CabsEgeneric y1 y2 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression_.beq_deriv_aux7 x2 y2
  | .CabsEsubscript x1 x2, .CabsEsubscript y1 y2 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2
  | .CabsEcall x1 x2 x3, .CabsEcall y1 y2 y3 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression_.beq_deriv_aux8 x2 y2 && x3 == y3
  | .CabsEmemberof x1 x2, .CabsEmemberof y1 y2 => cabs_expression.beq_derived x1 y1 && x2 == y2
  | .CabsEmemberofptr x1 x2, .CabsEmemberofptr y1 y2 =>
    cabs_expression.beq_derived x1 y1 && x2 == y2
  | .CabsEpostincr x1, .CabsEpostincr y1 => cabs_expression.beq_derived x1 y1
  | .CabsEpostdecr x1, .CabsEpostdecr y1 => cabs_expression.beq_derived x1 y1
  | .CabsEcompound x1 x2, .CabsEcompound y1 y2 =>
    type_name.beq_derived x1 y1 && cabs_expression_.beq_deriv_aux9 x2 y2
  | .CabsEpreincr x1, .CabsEpreincr y1 => cabs_expression.beq_derived x1 y1
  | .CabsEpredecr x1, .CabsEpredecr y1 => cabs_expression.beq_derived x1 y1
  | .CabsEunary x1 x2, .CabsEunary y1 y2 => x1 == y1 && cabs_expression.beq_derived x2 y2
  | .CabsEsizeof_expr x1, .CabsEsizeof_expr y1 => cabs_expression.beq_derived x1 y1
  | .CabsEsizeof_type x1, .CabsEsizeof_type y1 => type_name.beq_derived x1 y1
  | .CabsEalignof x1, .CabsEalignof y1 => type_name.beq_derived x1 y1
  | .CabsEcast x1 x2, .CabsEcast y1 y2 =>
    type_name.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2
  | .CabsEbinary x1 x2 x3, .CabsEbinary y1 y2 y3 =>
    x1 == y1 && cabs_expression.beq_derived x2 y2 && cabs_expression.beq_derived x3 y3
  | .CabsEcond x1 x2 x3, .CabsEcond y1 y2 y3 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2 &&
      cabs_expression.beq_derived x3 y3
  | .CabsEassign x1 x2 x3, .CabsEassign y1 y2 y3 =>
    x1 == y1 && cabs_expression.beq_derived x2 y2 && cabs_expression.beq_derived x3 y3
  | .CabsEcomma x1 x2, .CabsEcomma y1 y2 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2
  | .CabsEassert x1, .CabsEassert y1 => cabs_expression.beq_derived x1 y1
  | .CabsEoffsetof x1 x2, .CabsEoffsetof y1 y2 => type_name.beq_derived x1 y1 && x2 == y2
  | .CabsEva_start x1 x2, .CabsEva_start y1 y2 => cabs_expression.beq_derived x1 y1 && x2 == y2
  | .CabsEva_copy x1 x2, .CabsEva_copy y1 y2 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2
  | .CabsEva_arg x1 x2, .CabsEva_arg y1 y2 =>
    cabs_expression.beq_derived x1 y1 && type_name.beq_derived x2 y2
  | .CabsEva_end x1, .CabsEva_end y1 => cabs_expression.beq_derived x1 y1
  | .CabsEprint_type x1, .CabsEprint_type y1 => cabs_expression.beq_derived x1 y1
  | .CabsEbmc_assume x1, .CabsEbmc_assume y1 => cabs_expression.beq_derived x1 y1
  | .CabsEgcc_statement x1, .CabsEgcc_statement y1 => cabs_expression_.beq_deriv_aux12 x1 y1
  | .CabsEcondGNU x1 x2, .CabsEcondGNU y1 y2 =>
    cabs_expression.beq_derived x1 y1 && cabs_expression.beq_derived x2 y2
  | .CabsEbuiltinGNU x1, .CabsEbuiltinGNU y1 => gnu_builtin_function.beq_derived x1 y1
  | _, _ => false
