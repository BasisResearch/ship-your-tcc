/- §6.7.2.2 Enumeration specifiers, Syntax -/
abbrev enumerator := (identifier × Option cabs_expression)

/- §6.9 External definitions, Syntax -/
mutual
inductive translation_unit : Type where
  | TUnit : List external_declaration → translation_unit
inductive external_declaration : Type where
  | EDecl_func : function_definition → external_declaration
  | EDecl_decl : cabs_declaration → external_declaration
  | EDecl_magic :
      (CerbLocation.Loc × String) → external_declaration /- magic comment at top level -/
  | EDecl_funcCN : cn_function identifier type_name → external_declaration /- CN backend -/
  | EDecl_lemmaCN : cn_lemma identifier type_name → external_declaration /- CN backend -/
  | EDecl_predCN : cn_predicate identifier type_name → external_declaration /- CN backend -/
  | EDecl_datatypeCN : cn_datatype identifier → external_declaration /- CN backend -/
  | EDecl_type_synCN : cn_type_synonym identifier → external_declaration /- CN backend -/
  | EDecl_fun_specCN : cn_decl_spec identifier type_name → external_declaration
/- CN backend -/
/- §6.9.1 Function definitions, Syntax -/
inductive function_definition : Type where
  | FunDef :
      CerbLocation.Loc → attributes → specifiers → declarator → cabs_statement → function_definition
end
export translation_unit (TUnit)
export external_declaration (EDecl_func EDecl_decl EDecl_magic EDecl_funcCN EDecl_lemmaCN
    EDecl_predCN EDecl_datatypeCN EDecl_type_synCN EDecl_fun_specCN)
export function_definition (FunDef)
mutual
def translation_unit.default_inhabited : translation_unit := TUnit default
def external_declaration.default_inhabited : external_declaration := EDecl_decl default
def function_definition.default_inhabited : function_definition :=
  FunDef default default default default default
end
instance : Inhabited translation_unit where
  default := translation_unit.default_inhabited
instance : Inhabited external_declaration where
  default := external_declaration.default_inhabited
instance : Inhabited function_definition where
  default := function_definition.default_inhabited

/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def external_declaration.ctor_rank_ocaml : external_declaration → Nat
  | .EDecl_func _ => 0
  | .EDecl_decl _ => 1
  | .EDecl_magic _ => 2
  | .EDecl_funcCN _ => 3
  | .EDecl_lemmaCN _ => 4
  | .EDecl_predCN _ => 5
  | .EDecl_datatypeCN _ => 6
  | .EDecl_type_synCN _ => 7
  | .EDecl_fun_specCN _ => 8
mutual
def translation_unit.beq_derived (cmpx_ cmpy_ : translation_unit) : Bool :=
  match cmpx_, cmpy_ with
  | .TUnit x1, .TUnit y1 => translation_unit.beq_deriv_aux2 x1 y1
termination_by structural cmpx_
def translation_unit.compare_derived (cmpx_ cmpy_ : translation_unit) : Ordering :=
  match cmpx_, cmpy_ with
  | .TUnit x1, .TUnit y1 => translation_unit.cmp_deriv_aux1 x1 y1
termination_by structural cmpx_
def external_declaration.beq_derived (cmpx_ cmpy_ : external_declaration) : Bool :=
  match cmpx_, cmpy_ with
  | .EDecl_func x1, .EDecl_func y1 => function_definition.beq_derived x1 y1
  | .EDecl_decl x1, .EDecl_decl y1 => x1 == y1
  | .EDecl_magic x1, .EDecl_magic y1 => x1 == y1
  | .EDecl_funcCN x1, .EDecl_funcCN y1 => x1 == y1
  | .EDecl_lemmaCN x1, .EDecl_lemmaCN y1 => x1 == y1
  | .EDecl_predCN x1, .EDecl_predCN y1 => x1 == y1
  | .EDecl_datatypeCN x1, .EDecl_datatypeCN y1 => x1 == y1
  | .EDecl_type_synCN x1, .EDecl_type_synCN y1 => x1 == y1
  | .EDecl_fun_specCN x1, .EDecl_fun_specCN y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def external_declaration.compare_derived (cmpx_ cmpy_ : external_declaration) : Ordering :=
  match cmpx_, cmpy_ with
  | .EDecl_func x1, .EDecl_func y1 => function_definition.compare_derived x1 y1
  | .EDecl_decl x1, .EDecl_decl y1 => Ord.compare x1 y1
  | .EDecl_magic x1, .EDecl_magic y1 => Ord.compare x1 y1
  | .EDecl_funcCN x1, .EDecl_funcCN y1 => Ord.compare x1 y1
  | .EDecl_lemmaCN x1, .EDecl_lemmaCN y1 => Ord.compare x1 y1
  | .EDecl_predCN x1, .EDecl_predCN y1 => Ord.compare x1 y1
  | .EDecl_datatypeCN x1, .EDecl_datatypeCN y1 => Ord.compare x1 y1
  | .EDecl_type_synCN x1, .EDecl_type_synCN y1 => Ord.compare x1 y1
  | .EDecl_fun_specCN x1, .EDecl_fun_specCN y1 => Ord.compare x1 y1
  | xg, yg =>
    Ord.compare (external_declaration.ctor_rank_ocaml xg) (external_declaration.ctor_rank_ocaml yg)
termination_by structural cmpx_
def function_definition.beq_derived (cmpx_ cmpy_ : function_definition) : Bool :=
  match cmpx_, cmpy_ with
  | .FunDef x1 x2 x3 x4 x5, .FunDef y1 y2 y3 y4 y5 =>
    x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && x5 == y5
termination_by structural cmpx_
def function_definition.compare_derived (cmpx_ cmpy_ : function_definition) : Ordering :=
  match cmpx_, cmpy_ with
  | .FunDef x1 x2 x3 x4 x5, .FunDef y1 y2 y3 y4 y5 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match Ord.compare x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq =>
             (match Ord.compare x4 y4 with
              | .lt => Ordering.lt
              | .gt => Ordering.gt
              | .eq => Ord.compare x5 y5))))
termination_by structural cmpx_
def translation_unit.cmp_deriv_aux1 (cmpx_ cmpy_ : List external_declaration) : Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | x1 :: xs0, y1 :: ys0 =>
    (match external_declaration.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => translation_unit.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def translation_unit.beq_deriv_aux2 (cmpx_ cmpy_ : List external_declaration) : Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | x1 :: xs0, y1 :: ys0 =>
    external_declaration.beq_derived x1 y1 && translation_unit.beq_deriv_aux2 xs0 ys0
  | _, _ => false
termination_by structural cmpx_
end

instance : BEq translation_unit where
  beq := translation_unit.beq_derived
instance : Ord translation_unit where
  compare := translation_unit.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType translation_unit where
  setElemCompare x y :=
    match translation_unit.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
