/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def cabs_expression_.lemSize (sizex_ : cabs_expression_) : Nat :=
  match sizex_ with
  | .CabsEident _ => 1
  | .CabsEconst _ => 1
  | .CabsEstring _ => 1
  | .CabsEgeneric x1 x2 => 1 + cabs_expression.lemSize x1 + cabs_expression_.lemSize_aux1 x2
  | .CabsEsubscript x1 x2 => 1 + cabs_expression.lemSize x1 + cabs_expression.lemSize x2
  | .CabsEcall x1 x2 _ => 1 + cabs_expression.lemSize x1 + cabs_expression_.lemSize_aux2 x2
  | .CabsEmemberof x1 _ => 1 + cabs_expression.lemSize x1
  | .CabsEmemberofptr x1 _ => 1 + cabs_expression.lemSize x1
  | .CabsEpostincr x1 => 1 + cabs_expression.lemSize x1
  | .CabsEpostdecr x1 => 1 + cabs_expression.lemSize x1
  | .CabsEcompound x1 x2 => 1 + type_name.lemSize x1 + cabs_expression_.lemSize_aux3 x2
  | .CabsEpreincr x1 => 1 + cabs_expression.lemSize x1
  | .CabsEpredecr x1 => 1 + cabs_expression.lemSize x1
  | .CabsEunary x1 x2 => 1 + cabs_unary_operator.lemSize x1 + cabs_expression.lemSize x2
  | .CabsEsizeof_expr x1 => 1 + cabs_expression.lemSize x1
  | .CabsEsizeof_type x1 => 1 + type_name.lemSize x1
  | .CabsEalignof x1 => 1 + type_name.lemSize x1
  | .CabsEcast x1 x2 => 1 + type_name.lemSize x1 + cabs_expression.lemSize x2
  | .CabsEbinary x1 x2 x3 =>
