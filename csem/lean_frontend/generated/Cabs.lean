/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def translation_unit.lemSize (sizex_ : translation_unit) : Nat :=
  match sizex_ with
  | .TUnit x1 => 1 + translation_unit.lemSize_aux1 x1
termination_by structural sizex_
def external_declaration.lemSize (sizex_ : external_declaration) : Nat :=
  match sizex_ with
  | .EDecl_func x1 => 1 + function_definition.lemSize x1
  | .EDecl_decl _ => 1
  | .EDecl_magic _ => 1
  | .EDecl_funcCN _ => 1
  | .EDecl_lemmaCN _ => 1
  | .EDecl_predCN _ => 1
  | .EDecl_datatypeCN _ => 1
  | .EDecl_type_synCN _ => 1
  | .EDecl_fun_specCN _ => 1
termination_by structural sizex_
def function_definition.lemSize (sizex_ : function_definition) : Nat :=
  match sizex_ with
  | .FunDef _ _ _ _ _ => 1
def translation_unit.lemSize_aux1 (sizex_ : List external_declaration) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + external_declaration.lemSize x1 + translation_unit.lemSize_aux1 xs0
termination_by structural sizex_
end

/- This type's sole purpose it to allow the construction of multiset of base
   type specifiers -/
inductive cabs_base_type_specifier : Type where
  | BTSpec_void : cabs_base_type_specifier
  | BTSpec_char : cabs_base_type_specifier
  | BTSpec_short : cabs_base_type_specifier
  | BTSpec_int : cabs_base_type_specifier
  | BTSpec_long : cabs_base_type_specifier
  | BTSpec_float : cabs_base_type_specifier
  | BTSpec_double : cabs_base_type_specifier
  | BTSpec_signed : cabs_base_type_specifier
  | BTSpec_unsigned : cabs_base_type_specifier
  | BTSpec_Bool : cabs_base_type_specifier
  | BTSpec_Complex : cabs_base_type_specifier
  deriving BEq, Ord
export cabs_base_type_specifier (BTSpec_void BTSpec_char BTSpec_short BTSpec_int BTSpec_long
    BTSpec_float BTSpec_double BTSpec_signed BTSpec_unsigned BTSpec_Bool BTSpec_Complex)
instance : Inhabited cabs_base_type_specifier where
  default := BTSpec_void
instance (priority := 500) : Lem_Basic_classes.SetType cabs_base_type_specifier where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 cabs_base_type_specifier where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 cabs_base_type_specifier where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

instance : Located cabs_expression where

    locOf expr :=
      match expr with
      | (CabsExpression loc1 _) => loc1

instance : Located cabs_statement where

    locOf stmt :=
      match stmt with
      | (CabsStatement loc1 _ _) => loc1

instance : Located cabs_type_specifier where

    locOf tspec :=
      match tspec with
      | (TSpec loc1 _) => loc1

/- NOTE: It returns the location of the identifier -/
partial def loc_of_direct_declarator (ddecl : direct_declarator) : CerbLocation.Loc :=
  match ddecl with
  | DDecl_identifier _ id1 =>
    (match id1 with
     | (Identifier loc1 _) => loc1)
  | DDecl_declarator (Declarator _ ddecl) => loc_of_direct_declarator ddecl
  | DDecl_array ddecl _ => loc_of_direct_declarator ddecl
  | DDecl_function ddecl _ => loc_of_direct_declarator ddecl

instance : Located direct_declarator where

    locOf := loc_of_direct_declarator

/- NOTE: It returns the location of the identifier -/
instance : Located declarator where

    locOf decl :=
      match decl with
      | (Declarator _ ddecl) => loc_of_direct_declarator ddecl

/- NOTE: It returns the location of the identifier -/
instance : Located external_declaration where

    locOf edecl :=
      match edecl with
      | EDecl_func (FunDef _ _ _ decl _) =>
        (match decl with
         | (Declarator _ ddecl) => loc_of_direct_declarator ddecl)
      | EDecl_decl (Declaration_base _ _ idecls) =>
        (match idecls with
         | [] => CerbLocation.unknown
         | (InitDecl _ decl _) :: _ =>
           (match decl with
            | (Declarator _ ddecl) => loc_of_direct_declarator ddecl))
      | EDecl_decl (Declaration_static_assert (Static_assert e _)) =>
        (match e with
         | (CabsExpression loc1 _) => loc1)
      | EDecl_magic (loc1, _) => loc1
      | EDecl_funcCN func =>
        (match func.cn_func_name with
         | (Identifier loc1 _) => loc1)
      | EDecl_lemmaCN lmma =>
        (match lmma.cn_lemma_name with
         | (Identifier loc1 _) => loc1)
      | EDecl_fun_specCN s =>
        (match s.cn_decl_name with
         | (Identifier loc1 _) => loc1)
      | EDecl_predCN pred1 =>
        (match pred1.cn_pred_name with
         | (Identifier loc1 _) => loc1)
      | EDecl_datatypeCN dt =>
        (match dt.cn_dt_name with
         | (Identifier loc1 _) => loc1)
      | EDecl_type_synCN ts => ts.cn_tysyn_loc

def loc_of_edecl (edecl : external_declaration) : CerbLocation.Loc :=
  match edecl with
  | EDecl_func (FunDef _ _ _ decl _) =>
    (match decl with
     | (Declarator _ ddecl) => loc_of_direct_declarator ddecl)
  | EDecl_decl (Declaration_base _ _ idecls) =>
    (/- NOTE: Return just the first InitDecl location -/
    match idecls with
    | [] => CerbLocation.unknown
    | (InitDecl _ decl _) :: _ =>
      (match decl with
       | (Declarator _ ddecl) => loc_of_direct_declarator ddecl))
  | EDecl_decl (Declaration_static_assert (Static_assert e _)) =>
    (match e with
     | (CabsExpression loc1 _) => loc1)
  | EDecl_magic (loc1, _) => loc1
  | EDecl_funcCN func =>
    (match func.cn_func_name with
     | (Identifier loc1 _) => loc1)
  | EDecl_lemmaCN lmma =>
    (match lmma.cn_lemma_name with
     | (Identifier loc1 _) => loc1)
  | EDecl_fun_specCN s =>
    (match s.cn_decl_name with
     | (Identifier loc1 _) => loc1)
  | EDecl_predCN pred1 =>
    (match pred1.cn_pred_name with
     | (Identifier loc1 _) => loc1)
  | EDecl_datatypeCN dt =>
    (match dt.cn_dt_name with
     | (Identifier loc1 _) => loc1)
  | EDecl_type_synCN ts => ts.cn_tysyn_loc

instance : SetType cabs_base_type_specifier where

    setElemCompare bspecif1 bspecif2 :=
      let ord : cabs_base_type_specifier → Nat :=
        fun x =>
          match x with
          | BTSpec_void => (0 : Nat)
          | BTSpec_char => 1
          | BTSpec_short => 2
          | BTSpec_int => 3
          | BTSpec_long => 4
          | BTSpec_float => 5
          | BTSpec_double => 6
          | BTSpec_signed => 7
          | BTSpec_unsigned => 8
          | BTSpec_Bool => 9
          | BTSpec_Complex => 10;
      defaultCompare (ord bspecif1) (ord bspecif2)
