  isEqual := translation_unit.beq_derived
  isInequal x y := !(translation_unit.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 translation_unit where
  compare x y :=
    match translation_unit.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match translation_unit.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match translation_unit.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match translation_unit.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match translation_unit.compare_derived x y with
    | .lt => false
    | _ => true
