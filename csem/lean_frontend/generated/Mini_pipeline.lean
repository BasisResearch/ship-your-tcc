def in_range_of_signed_int (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (n : Int) :
    Option Bool :=
  match eval_integer_value
      ((CerbMem.minIval _lemReader_enum_definitions _lemReader_tagDefs) (Signed Int_)),
      eval_integer_value
        ((CerbMem.maxIval _lemReader_enum_definitions _lemReader_tagDefs) (Signed Int_)) with
  | some min2, some max2 => some (intLteb min2 n && intLteb n max2)
  | some min2, none => (lem_if intLtb n min2 then some false else none)
  | none, some max2 => (lem_if intLtb max2 n then some false else none)
  | none, none => none
