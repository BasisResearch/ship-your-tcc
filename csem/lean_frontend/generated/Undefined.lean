         "the controlling expression of a 'do' statement evaluated to an unspecified value")
    | UB_CERB005_free_nullptr => "a call to 'free()' is given a 'NULL' pointer"
    | Invalid_format str => String.append "Invalid_format \"" (String.append str "\"")
    | ub => String.append "(UB missing short message): " (stringFromUndefined_behaviour ub)

/- Exception monad for possibly undefined executions -/
inductive t0 (a : Type) : Type where
  | Defined : a → t0 a
  | Undef : CerbLocation.Loc → List undefined_behaviour → t0 a
  | Error : CerbLocation.Loc → String → t0 a
  deriving BEq, Ord
export t0 (Defined Undef Error)
instance { a : Type } [Inhabited a] : Inhabited (t0 a) where
  default := Defined default
instance (priority := low) { a : Type } : Inhabited (t0 a) where
  default := Undef default default
instance (priority := low) { a : Type } : Inhabited (t0 a) where
  default := Error default default
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (t0 a) where
  setElemCompare := defaultCompare
instance (priority := 500) { a : Type } [BEq a] : Lem_Basic_classes.Eq0 (t0 a) where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.Ord0 (t0 a) where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def return1 { a : Type } (x : a) : t0 a := Defined x
def bind2 { a b : Type } (m : t0 a) (f : a → t0 b) : t0 b :=
  match m with
  | Defined x => f x
  | Undef loc1 us =>
    Undef loc1
      us /- TODO: we probably want to collect as much undefs as possible, ie. continue that exec ? -/
  | Error loc1 str => Error loc1 str

def sequence0 { a : Type } (ms : List (t0 a)) : t0 (List a) :=
  lemListFoldr
    (fun (m : t0 a) (acc : t0 (List a)) =>
      bind2 m (fun (x : a) => bind2 acc (fun (xs : List a) => return1 (x :: xs)))) (return1 []) ms
def mapM1 { a b : Type } (f : a → t0 b) (xs : List a) : t0 (List b) := sequence0 (List.map f xs)
def undef { a : Type } (loc1 : CerbLocation.Loc) (us : List undefined_behaviour) : t0 a :=
  Undef loc1 us
def error0 { a : Type } (loc1 : CerbLocation.Loc) (str : String) : t0 a := Error loc1 str
def fmap { a b : Type } (f : a → b) (m : t0 a) : t0 b :=
  match m with
  | Defined x => Defined (f x)
  | Undef loc1 us => Undef loc1 us
  | Error loc1 str => Error loc1 str
