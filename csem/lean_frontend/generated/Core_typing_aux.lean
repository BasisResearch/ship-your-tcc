    else
      eq_core_base_type bTy1 bTy2) loc1 (Mismatch str bTy1 bTy2)
partial def unify (infer1 : inferred) (infer2 : inferred) :
    Option (Option inferred × Option inferred) :=
  match infer1, infer2 with
  | InferredUnknown, InferredUnknown => none
  | _, InferredUnknown => some (none, some infer1)
  | InferredUnknown, _ => some (some infer2, none)
  | InferredType_list elem_infer1, InferredType_list elem_infer2 =>
    (match unify elem_infer1 elem_infer2 with
     | none => none
     | some (none, none) => some (none, none)
     | some (none, some elem_infer2') => some (none, some (InferredType_list elem_infer2'))
     | some (some elem_infer1', none) => some (some (InferredType_list elem_infer1'), none)
     | some (some elem_infer1', some elem_infer2') =>
       some (some (InferredType_list elem_infer1'), some (InferredType_list elem_infer2')))
  | InferredType_tuple infers1, InferredType_tuple infers2 =>
    (failwithI "TODO: Core_typing_aux.unify tuples" : Option (Option inferred × Option inferred))
  | _, _ => (lem_if equalInferred infer1 infer2 then some (none, none) else none)

