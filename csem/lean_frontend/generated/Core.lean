  | .CivOR => 9
  | .CivXOR => 10
  | .Cspecified => 11
  | .Cunspecified => 12
  | .Cfvconvert => 13
  | .CfvconvertLoaded => 14
  | .CfvfromintTyped => 15
  | .CfvfromintTypedLoaded => 16
  | .Cfvneg => 17
  | .Cfvfromint => 18
  | .Civfromfloat => 19
  | .CivNULLcap _ => 21
mutual
def ctor.beq_derived (cmpx_ cmpy_ : ctor) : Bool :=
  match cmpx_, cmpy_ with
  | .Cnil x1, .Cnil y1 => x1 == y1
  | .Ccons, .Ccons => true
  | .Ctuple, .Ctuple => true
  | .Carray, .Carray => true
  | .Civmax, .Civmax => true
  | .Civmin, .Civmin => true
  | .Civsizeof, .Civsizeof => true
  | .Civalignof, .Civalignof => true
  | .CivCOMPL, .CivCOMPL => true
  | .CivAND, .CivAND => true
  | .CivOR, .CivOR => true
  | .CivXOR, .CivXOR => true
