def generic_pexpr_.cmp_deriv_aux1 { bty : Type } [Ord bty] { sym : Type } [Ord sym]
    (cmpx_ cmpy_ : List ((mem_iv_constraint × generic_pexpr bty sym))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => generic_pexpr.compare_derived x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux1 xs0 ys0)
