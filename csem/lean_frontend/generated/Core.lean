/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def generic_expr_.lemSize { a : Type } { bty : Type } { sym : Type }
    (sizex_ : generic_expr_ a bty sym) :
    Nat :=
  match sizex_ with
  | .Epure _ => 1
  | .Ememop _ _ => 1
  | .Eaction _ => 1
  | .Ecase _ x1 => 1 + generic_expr_.lemSize_aux1 x1
  | .Elet _ _ x1 => 1 + generic_expr.lemSize x1
  | .Eif _ x1 x2 => 1 + generic_expr.lemSize x1 + generic_expr.lemSize x2
  | .Eccall _ _ _ _ => 1
  | .Eproc _ _ _ => 1
  | .Eunseq x1 => 1 + generic_expr_.lemSize_aux2 x1
  | .Ewseq _ x1 x2 => 1 + generic_expr.lemSize x1 + generic_expr.lemSize x2
  | .Esseq _ x1 x2 => 1 + generic_expr.lemSize x1 + generic_expr.lemSize x2
  | .Ebound x1 => 1 + generic_expr.lemSize x1
  | .End x1 => 1 + generic_expr_.lemSize_aux2 x1
  | .Esave _ _ x1 => 1 + generic_expr.lemSize x1
  | .Erun _ _ _ => 1
  | .Epar x1 => 1 + generic_expr_.lemSize_aux2 x1
  | .Ewait _ => 1
  | .Eannot _ x1 => 1 + generic_expr.lemSize x1
  | .Eexcluded _ _ => 1
termination_by structural sizex_
def generic_expr.lemSize { a : Type } { bty : Type } { sym : Type }
    (sizex_ : generic_expr a bty sym) :
    Nat :=
  match sizex_ with
  | .Expr _ x1 => 1 + generic_expr_.lemSize x1
termination_by structural sizex_
def generic_expr_.lemSize_aux1 { a bty sym : Type }
    (sizex_ : List ((generic_pattern sym × generic_expr a bty sym))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + generic_expr.lemSize x1 + generic_expr_.lemSize_aux1 xs0
termination_by structural sizex_
def generic_expr_.lemSize_aux2 { a bty sym : Type } (sizex_ : List (generic_expr a bty sym)) :
    Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + generic_expr.lemSize x1 + generic_expr_.lemSize_aux2 xs0
termination_by structural sizex_
end

