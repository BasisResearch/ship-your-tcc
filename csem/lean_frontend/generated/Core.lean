/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def generic_pexpr_.ctor_rank_ocaml { bty sym : Type } : generic_pexpr_ bty sym → Nat
  | .PEsym _ => 0
  | .PEimpl _ => 1
  | .PEval _ => 2
  | .PEconstrained _ => 3
  | .PEundef _ _ => 4
  | .PEerror _ _ => 5
  | .PEctor _ _ => 6
  | .PEcase _ _ => 7
  | .PEarray_shift _ _ _ => 8
  | .PEmember_shift _ _ _ => 9
  | .PEmemop _ _ => 10
  | .PEnot _ => 11
  | .PEop _ _ _ => 12
  | .PEconv_int _ _ => 13
  | .PEwrapI _ _ _ _ => 14
  | .PEcatch_exceptional_condition _ _ _ _ => 15
  | .PEstruct _ _ => 16
  | .PEunion _ _ _ => 17
  | .PEcfunction _ => 18
  | .PEmemberof _ _ _ => 19
  | .PEcall _ _ => 20
  | .PElet _ _ _ => 21
  | .PEif _ _ _ => 22
  | .PEis_scalar _ => 23
  | .PEis_integer _ => 24
  | .PEis_signed _ => 25
  | .PEis_unsigned _ => 26
  | .PEbmc_assume _ => 27
  | .PEare_compatible _ _ => 28
mutual
def generic_pexpr_.beq_derived { bty : Type } [BEq bty] { sym : Type } [BEq sym]
    (cmpx_ cmpy_ : generic_pexpr_ bty sym) :
    Bool :=
  match cmpx_, cmpy_ with
  | .PEsym x1, .PEsym y1 => x1 == y1
  | .PEimpl x1, .PEimpl y1 => x1 == y1
  | .PEval x1, .PEval y1 => x1 == y1
  | .PEconstrained x1, .PEconstrained y1 => generic_pexpr_.beq_deriv_aux5 x1 y1
  | .PEundef x1 x2, .PEundef y1 y2 => x1 == y1 && x2 == y2
  | .PEerror x1 x2, .PEerror y1 y2 => x1 == y1 && generic_pexpr.beq_derived x2 y2
  | .PEctor x1 x2, .PEctor y1 y2 => x1 == y1 && generic_pexpr_.beq_deriv_aux6 x2 y2
  | .PEcase x1 x2, .PEcase y1 y2 =>
    generic_pexpr.beq_derived x1 y1 && generic_pexpr_.beq_deriv_aux7 x2 y2
  | .PEarray_shift x1 x2 x3, .PEarray_shift y1 y2 y3 =>
    generic_pexpr.beq_derived x1 y1 && x2 == y2 && generic_pexpr.beq_derived x3 y3
  | .PEmember_shift x1 x2 x3, .PEmember_shift y1 y2 y3 =>
    generic_pexpr.beq_derived x1 y1 && x2 == y2 && x3 == y3
  | .PEmemop x1 x2, .PEmemop y1 y2 => x1 == y1 && generic_pexpr_.beq_deriv_aux6 x2 y2
  | .PEnot x1, .PEnot y1 => generic_pexpr.beq_derived x1 y1
  | .PEop x1 x2 x3, .PEop y1 y2 y3 =>
    x1 == y1 && generic_pexpr.beq_derived x2 y2 && generic_pexpr.beq_derived x3 y3
  | .PEconv_int x1 x2, .PEconv_int y1 y2 => x1 == y1 && generic_pexpr.beq_derived x2 y2
  | .PEwrapI x1 x2 x3 x4, .PEwrapI y1 y2 y3 y4 =>
    x1 == y1 && x2 == y2 && generic_pexpr.beq_derived x3 y3 && generic_pexpr.beq_derived x4 y4
  | .PEcatch_exceptional_condition x1 x2 x3 x4, .PEcatch_exceptional_condition y1 y2 y3 y4 =>
    x1 == y1 && x2 == y2 && generic_pexpr.beq_derived x3 y3 && generic_pexpr.beq_derived x4 y4
  | .PEstruct x1 x2, .PEstruct y1 y2 => x1 == y1 && generic_pexpr_.beq_deriv_aux8 x2 y2
  | .PEunion x1 x2 x3, .PEunion y1 y2 y3 => x1 == y1 && x2 == y2 && generic_pexpr.beq_derived x3 y3
  | .PEcfunction x1, .PEcfunction y1 => generic_pexpr.beq_derived x1 y1
  | .PEmemberof x1 x2 x3, .PEmemberof y1 y2 y3 =>
    x1 == y1 && x2 == y2 && generic_pexpr.beq_derived x3 y3
  | .PEcall x1 x2, .PEcall y1 y2 => x1 == y1 && generic_pexpr_.beq_deriv_aux6 x2 y2
  | .PElet x1 x2 x3, .PElet y1 y2 y3 =>
    x1 == y1 && generic_pexpr.beq_derived x2 y2 && generic_pexpr.beq_derived x3 y3
  | .PEif x1 x2 x3, .PEif y1 y2 y3 =>
    generic_pexpr.beq_derived x1 y1 && generic_pexpr.beq_derived x2 y2 && generic_pexpr.beq_derived
      x3 y3
  | .PEis_scalar x1, .PEis_scalar y1 => generic_pexpr.beq_derived x1 y1
  | .PEis_integer x1, .PEis_integer y1 => generic_pexpr.beq_derived x1 y1
  | .PEis_signed x1, .PEis_signed y1 => generic_pexpr.beq_derived x1 y1
  | .PEis_unsigned x1, .PEis_unsigned y1 => generic_pexpr.beq_derived x1 y1
  | .PEbmc_assume x1, .PEbmc_assume y1 => generic_pexpr.beq_derived x1 y1
  | .PEare_compatible x1 x2, .PEare_compatible y1 y2 =>
    generic_pexpr.beq_derived x1 y1 && generic_pexpr.beq_derived x2 y2
  | _, _ => false
termination_by structural cmpx_
def generic_pexpr_.compare_derived { bty : Type } [Ord bty] { sym : Type } [Ord sym]
    (cmpx_ cmpy_ : generic_pexpr_ bty sym) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .PEsym x1, .PEsym y1 => Ord.compare x1 y1
  | .PEimpl x1, .PEimpl y1 => Ord.compare x1 y1
  | .PEval x1, .PEval y1 => Ord.compare x1 y1
  | .PEconstrained x1, .PEconstrained y1 => generic_pexpr_.cmp_deriv_aux1 x1 y1
  | .PEundef x1 x2, .PEundef y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .PEerror x1 x2, .PEerror y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr.compare_derived x2 y2)
  | .PEctor x1 x2, .PEctor y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux2 x2 y2)
  | .PEcase x1 x2, .PEcase y1 y2 =>
    (match generic_pexpr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux3 x2 y2)
  | .PEarray_shift x1 x2 x3, .PEarray_shift y1 y2 y3 =>
    (match generic_pexpr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEmember_shift x1 x2 x3, .PEmember_shift y1 y2 y3 =>
    (match generic_pexpr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .PEmemop x1 x2, .PEmemop y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux2 x2 y2)
  | .PEnot x1, .PEnot y1 => generic_pexpr.compare_derived x1 y1
  | .PEop x1 x2 x3, .PEop y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match generic_pexpr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEconv_int x1 x2, .PEconv_int y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr.compare_derived x2 y2)
  | .PEwrapI x1 x2 x3 x4, .PEwrapI y1 y2 y3 y4 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match generic_pexpr.compare_derived x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq => generic_pexpr.compare_derived x4 y4)))
  | .PEcatch_exceptional_condition x1 x2 x3 x4, .PEcatch_exceptional_condition y1 y2 y3 y4 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match generic_pexpr.compare_derived x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq => generic_pexpr.compare_derived x4 y4)))
  | .PEstruct x1 x2, .PEstruct y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux4 x2 y2)
  | .PEunion x1 x2 x3, .PEunion y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEcfunction x1, .PEcfunction y1 => generic_pexpr.compare_derived x1 y1
  | .PEmemberof x1 x2 x3, .PEmemberof y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEcall x1 x2, .PEcall y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr_.cmp_deriv_aux2 x2 y2)
  | .PElet x1 x2 x3, .PElet y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match generic_pexpr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEif x1 x2 x3, .PEif y1 y2 y3 =>
    (match generic_pexpr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match generic_pexpr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_pexpr.compare_derived x3 y3))
  | .PEis_scalar x1, .PEis_scalar y1 => generic_pexpr.compare_derived x1 y1
  | .PEis_integer x1, .PEis_integer y1 => generic_pexpr.compare_derived x1 y1
  | .PEis_signed x1, .PEis_signed y1 => generic_pexpr.compare_derived x1 y1
  | .PEis_unsigned x1, .PEis_unsigned y1 => generic_pexpr.compare_derived x1 y1
  | .PEbmc_assume x1, .PEbmc_assume y1 => generic_pexpr.compare_derived x1 y1
  | .PEare_compatible x1 x2, .PEare_compatible y1 y2 =>
    (match generic_pexpr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_pexpr.compare_derived x2 y2)
  | xg, yg => Ord.compare (generic_pexpr_.ctor_rank_ocaml xg) (generic_pexpr_.ctor_rank_ocaml yg)
termination_by structural cmpx_
def generic_pexpr.beq_derived { bty : Type } [BEq bty] { sym : Type } [BEq sym]
