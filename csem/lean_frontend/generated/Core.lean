/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def generic_expr_.ctor_rank_ocaml { a bty sym : Type } : generic_expr_ a bty sym → Nat
  | .Epure _ => 0
  | .Ememop _ _ => 1
  | .Eaction _ => 2
  | .Ecase _ _ => 3
  | .Elet _ _ _ => 4
  | .Eif _ _ _ => 5
  | .Eccall _ _ _ _ => 6
  | .Eproc _ _ _ => 7
  | .Eunseq _ => 8
  | .Ewseq _ _ _ => 9
  | .Esseq _ _ _ => 10
  | .Ebound _ => 11
  | .End _ => 12
  | .Esave _ _ _ => 13
  | .Erun _ _ _ => 14
  | .Epar _ => 15
  | .Ewait _ => 16
  | .Eannot _ _ => 17
  | .Eexcluded _ _ => 18
mutual
def generic_expr_.beq_derived { a : Type } [BEq a] { bty : Type } [BEq bty] { sym : Type } [BEq sym]
    (cmpx_ cmpy_ : generic_expr_ a bty sym) :
    Bool :=
  match cmpx_, cmpy_ with
  | .Epure x1, .Epure y1 => x1 == y1
  | .Ememop x1 x2, .Ememop y1 y2 => x1 == y1 && x2 == y2
  | .Eaction x1, .Eaction y1 => x1 == y1
  | .Ecase x1 x2, .Ecase y1 y2 => x1 == y1 && generic_expr_.beq_deriv_aux3 x2 y2
  | .Elet x1 x2 x3, .Elet y1 y2 y3 => x1 == y1 && x2 == y2 && generic_expr.beq_derived x3 y3
  | .Eif x1 x2 x3, .Eif y1 y2 y3 =>
    x1 == y1 && generic_expr.beq_derived x2 y2 && generic_expr.beq_derived x3 y3
  | .Eccall x1 x2 x3 x4, .Eccall y1 y2 y3 y4 => x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4
  | .Eproc x1 x2 x3, .Eproc y1 y2 y3 => x1 == y1 && x2 == y2 && x3 == y3
  | .Eunseq x1, .Eunseq y1 => generic_expr_.beq_deriv_aux4 x1 y1
  | .Ewseq x1 x2 x3, .Ewseq y1 y2 y3 =>
    x1 == y1 && generic_expr.beq_derived x2 y2 && generic_expr.beq_derived x3 y3
  | .Esseq x1 x2 x3, .Esseq y1 y2 y3 =>
    x1 == y1 && generic_expr.beq_derived x2 y2 && generic_expr.beq_derived x3 y3
  | .Ebound x1, .Ebound y1 => generic_expr.beq_derived x1 y1
  | .End x1, .End y1 => generic_expr_.beq_deriv_aux4 x1 y1
  | .Esave x1 x2 x3, .Esave y1 y2 y3 => x1 == y1 && x2 == y2 && generic_expr.beq_derived x3 y3
  | .Erun x1 x2 x3, .Erun y1 y2 y3 => x1 == y1 && x2 == y2 && x3 == y3
  | .Epar x1, .Epar y1 => generic_expr_.beq_deriv_aux4 x1 y1
  | .Ewait x1, .Ewait y1 => x1 == y1
  | .Eannot x1 x2, .Eannot y1 y2 => x1 == y1 && generic_expr.beq_derived x2 y2
  | .Eexcluded x1 x2, .Eexcluded y1 y2 => x1 == y1 && x2 == y2
  | _, _ => false
termination_by structural cmpx_
def generic_expr_.compare_derived { a : Type } [Ord a] { bty : Type } [Ord bty] { sym : Type }
    [Ord sym] (cmpx_ cmpy_ : generic_expr_ a bty sym) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .Epure x1, .Epure y1 => Ord.compare x1 y1
  | .Ememop x1 x2, .Ememop y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .Eaction x1, .Eaction y1 => Ord.compare x1 y1
  | .Ecase x1 x2, .Ecase y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_expr_.cmp_deriv_aux1 x2 y2)
  | .Elet x1 x2 x3, .Elet y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_expr.compare_derived x3 y3))
  | .Eif x1 x2 x3, .Eif y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match generic_expr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => generic_expr.compare_derived x3 y3))
  | .Eccall x1 x2 x3 x4, .Eccall y1 y2 y3 y4 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
