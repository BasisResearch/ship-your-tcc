  | .End x1, .End y1 => generic_expr_.cmp_deriv_aux2 x1 y1
  | .Esave x1 x2 x3, .Esave y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
