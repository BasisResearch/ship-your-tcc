def generic_expr_.cmp_deriv_aux1 { a : Type } [Ord a] { bty : Type } [Ord bty] { sym : Type }
    [Ord sym] (cmpx_ cmpy_ : List ((generic_pattern sym × generic_expr a bty sym))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => generic_expr.compare_derived x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_expr_.cmp_deriv_aux1 xs0 ys0)
