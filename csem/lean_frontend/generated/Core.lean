def generic_expr_.beq_deriv_aux3 { a : Type } [BEq a] { bty : Type } [BEq bty] { sym : Type }
    [BEq sym] (cmpx_ cmpy_ : List ((generic_pattern sym × generic_expr a bty sym))) :
    Bool :=
  match cmpx_, cmpy_ with
