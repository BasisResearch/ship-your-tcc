   other field counts 0. -/
mutual
def generic_pexpr_.lemSize { bty : Type } { sym : Type } (sizex_ : generic_pexpr_ bty sym) : Nat :=
  match sizex_ with
  | .PEsym _ => 1
  | .PEimpl _ => 1
  | .PEval _ => 1
  | .PEconstrained x1 => 1 + generic_pexpr_.lemSize_aux1 x1
  | .PEundef _ _ => 1
  | .PEerror _ x1 => 1 + generic_pexpr.lemSize x1
  | .PEctor _ x1 => 1 + generic_pexpr_.lemSize_aux2 x1
  | .PEcase x1 x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr_.lemSize_aux3 x2
  | .PEarray_shift x1 _ x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
  | .PEmember_shift x1 _ _ => 1 + generic_pexpr.lemSize x1
  | .PEmemop _ x1 => 1 + generic_pexpr_.lemSize_aux2 x1
  | .PEnot x1 => 1 + generic_pexpr.lemSize x1
  | .PEop _ x1 x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
  | .PEconv_int _ x1 => 1 + generic_pexpr.lemSize x1
  | .PEwrapI _ _ x1 x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
  | .PEcatch_exceptional_condition _ _ x1 x2 =>
    1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
  | .PEstruct _ x1 => 1 + generic_pexpr_.lemSize_aux4 x1
  | .PEunion _ _ x1 => 1 + generic_pexpr.lemSize x1
  | .PEcfunction x1 => 1 + generic_pexpr.lemSize x1
  | .PEmemberof _ _ x1 => 1 + generic_pexpr.lemSize x1
  | .PEcall _ x1 => 1 + generic_pexpr_.lemSize_aux2 x1
  | .PElet _ x1 x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
  | .PEif x1 x2 x3 =>
    1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2 + generic_pexpr.lemSize x3
  | .PEis_scalar x1 => 1 + generic_pexpr.lemSize x1
  | .PEis_integer x1 => 1 + generic_pexpr.lemSize x1
  | .PEis_signed x1 => 1 + generic_pexpr.lemSize x1
  | .PEis_unsigned x1 => 1 + generic_pexpr.lemSize x1
  | .PEbmc_assume x1 => 1 + generic_pexpr.lemSize x1
  | .PEare_compatible x1 x2 => 1 + generic_pexpr.lemSize x1 + generic_pexpr.lemSize x2
termination_by structural sizex_
def generic_pexpr.lemSize { bty : Type } { sym : Type } (sizex_ : generic_pexpr bty sym) : Nat :=
  match sizex_ with
  | .Pexpr _ _ x1 => 1 + generic_pexpr_.lemSize x1
termination_by structural sizex_
def generic_pexpr_.lemSize_aux1 { bty sym : Type }
    (sizex_ : List ((mem_iv_constraint × generic_pexpr bty sym))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + generic_pexpr.lemSize x1 + generic_pexpr_.lemSize_aux1 xs0
termination_by structural sizex_
def generic_pexpr_.lemSize_aux2 { bty sym : Type } (sizex_ : List (generic_pexpr bty sym)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + generic_pexpr.lemSize x1 + generic_pexpr_.lemSize_aux2 xs0
termination_by structural sizex_
def generic_pexpr_.lemSize_aux3 { bty sym : Type }
    (sizex_ : List ((generic_pattern sym × generic_pexpr bty sym))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + generic_pexpr.lemSize x1 + generic_pexpr_.lemSize_aux3 xs0
termination_by structural sizex_
def generic_pexpr_.lemSize_aux4 { bty sym : Type }
    (sizex_ : List ((identifier × generic_pexpr bty sym))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + generic_pexpr.lemSize x1 + generic_pexpr_.lemSize_aux4 xs0
termination_by structural sizex_
end

