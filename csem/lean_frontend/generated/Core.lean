/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def object_value.lemSize (sizex_ : object_value) : Nat :=
  match sizex_ with
  | .OVinteger _ => 1
  | .OVfloating _ => 1
  | .OVpointer _ => 1
  | .OVarray x1 => 1 + object_value.lemSize_aux1 x1
  | .OVstruct _ _ => 1
  | .OVunion _ _ _ => 1
termination_by structural sizex_
def loaded_value.lemSize (sizex_ : loaded_value) : Nat :=
  match sizex_ with
  | .LVspecified x1 => 1 + object_value.lemSize x1
  | .LVunspecified _ => 1
termination_by structural sizex_
def object_value.lemSize_aux1 (sizex_ : List loaded_value) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + loaded_value.lemSize x1 + object_value.lemSize_aux1 xs0
termination_by structural sizex_
end
