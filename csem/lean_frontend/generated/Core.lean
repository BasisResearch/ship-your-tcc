inductive value : Type where
  /- Core values -/
  | Vobject : object_value → value /- C object value -/
  | Vloaded : loaded_value → value /- loaded C object value -/
  | Vunit : value
  | Vtrue : value
  | Vfalse : value
  | Vctype : ctype → value /- C type as value -/
  | Vlist : core_base_type → List value → value
  | Vtuple : List value → value
export value (Vobject Vloaded Vunit Vtrue Vfalse Vctype Vlist Vtuple)
instance : Inhabited value where
  default := Vunit
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def value.ctor_rank_ocaml : value → Nat
  | .Vobject _ => 3
  | .Vloaded _ => 4
  | .Vunit => 0
  | .Vtrue => 1
  | .Vfalse => 2
  | .Vctype _ => 5
  | .Vlist _ _ => 6
  | .Vtuple _ => 7
mutual
def value.beq_derived (cmpx_ cmpy_ : value) : Bool :=
  match cmpx_, cmpy_ with
  | .Vobject x1, .Vobject y1 => x1 == y1
  | .Vloaded x1, .Vloaded y1 => x1 == y1
  | .Vunit, .Vunit => true
  | .Vtrue, .Vtrue => true
  | .Vfalse, .Vfalse => true
  | .Vctype x1, .Vctype y1 => x1 == y1
  | .Vlist x1 x2, .Vlist y1 y2 => x1 == y1 && value.beq_deriv_aux2 x2 y2
  | .Vtuple x1, .Vtuple y1 => value.beq_deriv_aux2 x1 y1
  | _, _ => false
termination_by structural cmpx_
def value.compare_derived (cmpx_ cmpy_ : value) : Ordering :=
  match cmpx_, cmpy_ with
  | .Vobject x1, .Vobject y1 => Ord.compare x1 y1
  | .Vloaded x1, .Vloaded y1 => Ord.compare x1 y1
  | .Vctype x1, .Vctype y1 => Ord.compare x1 y1
  | .Vlist x1 x2, .Vlist y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => value.cmp_deriv_aux1 x2 y2)
  | .Vtuple x1, .Vtuple y1 => value.cmp_deriv_aux1 x1 y1
  | xg, yg => Ord.compare (value.ctor_rank_ocaml xg) (value.ctor_rank_ocaml yg)
termination_by structural cmpx_
def value.cmp_deriv_aux1 (cmpx_ cmpy_ : List value) : Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | x1 :: xs0, y1 :: ys0 =>
    (match value.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => value.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def value.beq_deriv_aux2 (cmpx_ cmpy_ : List value) : Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | x1 :: xs0, y1 :: ys0 => value.beq_derived x1 y1 && value.beq_deriv_aux2 xs0 ys0
  | _, _ => false
termination_by structural cmpx_
end

instance : BEq value where
  beq := value.beq_derived
instance : Ord value where
  compare := value.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType value where
  setElemCompare x y :=
    match value.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 value where
  isEqual := value.beq_derived
  isInequal x y := !(value.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 value where
  compare x y :=
    match value.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match value.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match value.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match value.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match value.compare_derived x y with
    | .lt => false
    | _ => true
/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def value.lemSize (sizex_ : value) : Nat :=
  match sizex_ with
  | .Vobject _ => 1
  | .Vloaded _ => 1
  | .Vunit => 1
  | .Vtrue => 1
  | .Vfalse => 1
  | .Vctype _ => 1
  | .Vlist _ x1 => 1 + value.lemSize_aux1 x1
  | .Vtuple x1 => 1 + value.lemSize_aux1 x1
termination_by structural sizex_
def value.lemSize_aux1 (sizex_ : List value) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + value.lemSize x1 + value.lemSize_aux1 xs0
termination_by structural sizex_
end
