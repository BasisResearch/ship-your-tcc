  match cmpx_, cmpy_ with
  | .Expr x1 x2, .Expr y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => generic_expr_.compare_derived x2 y2)
