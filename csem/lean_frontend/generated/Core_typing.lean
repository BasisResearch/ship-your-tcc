                      except_bind
                        (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe3)
                        (fun (tpe3 : generic_pexpr core_base_type sym) =>
                          except_bind
                            (typecheck_export_pexpr tagDefs1 env1 (BTy_loaded lvalue_oTy) pe4)
