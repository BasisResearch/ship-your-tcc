                  (fun (p : (typing_env × generic_pattern sym)) =>
                    match p with
                    | (env2, tpat2) =>
                      except_return
                        (env_union env1 env2, InferredType_object OTy_integer,
                          Pattern annots1 (CaseCtor Civfromfloat [tpat1, tpat2]))))
        | Civfromfloat, _ =>
          (failwithI "infer_pattern: Cfvfromfloat: wrong number of arguments" : exceptM
            (typing_env × inferred × generic_pattern sym) (CerbLocation.Loc × cause))
        | CivNULLcap is_signed, [] =>
          except_return
            (empty_env, InferredType_object OTy_integer,
              Pattern annots1 (CaseCtor (CivNULLcap is_signed) ([] : List (generic_pattern sym))))
        | CivNULLcap _, _ =>
          (failwithI "infer_pattern: CivNULLcap: wrong number of arguments" : exceptM
            (typing_env × inferred × generic_pattern sym) (CerbLocation.Loc × cause))))

/- val     typeof_object_value: Loc.t -> typing_env -> object_value -> E.eff core_object_type -/
mutual
partial def typeof_object_value { a b : Type } (loc1 : b) (env1 : a) (oval : object_value) :
    exceptM core_object_type (CerbLocation.Loc × cause) :=
  match oval with
  | OVinteger _ => except_return OTy_integer
  | OVfloating _ => except_return OTy_floating
  | OVpointer _ => except_return OTy_pointer
  | OVarray [] => /- TODO(V): impossible to write an example -/
    (failwithI "TODO: EmptyArray" : exceptM core_object_type (CerbLocation.Loc × cause))
  | OVarray (lval' :: lvals') =>
    except_bind (typeof_loaded_value loc1 env1 lval') (fun (oTy : core_object_type) =>
      except_bind
        (except_mapM
          (fun (lval : loaded_value) =>
            except_bind (typeof_loaded_value loc1 env1 lval) (fun (oTy' : core_object_type) =>
              lem_if ((fun (x : core_object_type) (y : core_object_type) =>
                  not (eq_core_object_type x y)) oTy
                  oTy') then /- TODO(V): impossible to write an example -/
                (failwithI "TODO HeterogenousArray oTy oTy'" : exceptM Unit
                  (CerbLocation.Loc × cause))
              else
                except_return ())) lvals') (fun (_ : List Unit) => except_return (OTy_array oTy)))
  | OVstruct tag_sym _ =>
    ((lemSeq
      (fun _ =>
        CerbDebug.warn [DB_core_typing] (fun (u : Unit) =>
          match u with
          | () => "Core typing, OVstruct doesn't check the validity of the member"))
      (fun _ => except_return (OTy_struct tag_sym))))
  | OVunion tag_sym _ _ => except_return (OTy_union tag_sym)
/-
   | OVcomposite _ _ _ ->
       E.return OTy_integer
-/

partial def typeof_loaded_value { a b : Type } (loc1 : b) (env1 : a) (lval : loaded_value) :
    eff core_object_type :=
  match lval with
  | LVspecified oval => typeof_object_value loc1 env1 oval
  | LVunspecified ty1 => /- TODO(V): impossible to write an example -/
    (failwithI "TODO: typeof_loaded_value, LVunspecified" : exceptM core_object_type error)

end

/- val     typeof_value: Loc.t -> typing_env -> Core.value -> E.eff core_base_type -/
partial def typeof_value { a : Type } (loc1 : CerbLocation.Loc) (env1 : a) (cval : value) :
    exceptM core_base_type (CerbLocation.Loc × cause) :=
  match cval with
  | Vobject oval => except_fmap BTy_object (typeof_object_value loc1 env1 oval)
  | Vloaded (LVspecified oval) => except_fmap BTy_loaded (typeof_object_value loc1 env1 oval)
  | Vloaded (LVunspecified ty1) =>
    (match core_object_type_of_ctype ty1 with
     | some oTy => except_return (BTy_loaded oTy)
     | none => /- TODO(V): impossible to write an example -/
       (failwithI "TODO typeof_value, Vunspecified not oTy" : exceptM core_base_type
         (CerbLocation.Loc × cause)))
  | Vunit => except_return BTy_unit
  | Vtrue => except_return BTy_boolean
  | Vfalse => except_return BTy_boolean
  | Vctype _ => except_return BTy_ctype
  | Vlist bTy cvals' =>
    except_bind
      (except_mapM
        (fun (cval : value) =>
          except_bind (typeof_value loc1 env1 cval) (fun (bTy' : core_base_type) =>
            lem_if ((fun (x : core_base_type) (y : core_base_type) => not (eq_core_base_type x y))
                bTy bTy') then
              core_typing_effect_fail loc1 (HeterogenousList bTy bTy')
            else
              except_return ())) cvals') (fun (_ : List Unit) => except_return (BTy_list bTy))
  | Vtuple cvals => except_fmap BTy_tuple (except_mapM (typeof_value loc1 env1) cvals)

/- val     infer_pexpr: foral 'bty. core_tag_definitions -> typing_env -> generic_pexpr 'bty Symbol.sym -> E.eff inferred_pexpr -/
mutual
partial def infer_pexpr { a bty : Type } [Inhabited a] (tagDefs1 : Fmap sym (a × tag_definition))
    (env1 : typing_env) (g : generic_pexpr bty sym) :
    exceptM (generic_pexpr inferred sym) (CerbLocation.Loc × cause) :=
  match tagDefs1, env1, g with
  | tagDefs1, env1, (pexpr1@(Pexpr annot1 _ pexpr_) : generic_pexpr bty sym) =>
    (let loc1 := get_loc_ annot1;
     match pexpr_ with
     | PEsym sym1 =>
       (match (fmapLookupBy
            (fun (nm1 : generic_name sym) (nm2 : generic_name sym)=>
              match nm1, nm2 with
              | Sym sym1, Sym sym2 => ordCompare sym1 sym2
              | Impl iCst1, Impl iCst2 => implementation_constant_compare iCst1 iCst2
              | Sym _, Impl _ => LemOrdering.LT
              | Impl _, Sym _ => LemOrdering.GT) (Sym sym1) env1.decls) with
        | some (TDsym bTy) => except_return (Pexpr annot1 (toInferred bTy) (PEsym sym1))
        | some _ => core_typing_effect_fail loc1 (FunctionOrProcedureSymbol sym1)
        | none =>
          /- NOTE: this should have been detected by the parser.
               * We add it here just in case. -/
          core_typing_effect_fail loc1
            (UnresolvedSymbol (Sym sym1))) /- FIXME: match type for each impl constant??? -/
     | PEimpl impl2 =>
       (failwithI "E.return (Pexpr (BTy_object OTy_integer) (PEimpl impl))" : exceptM
         (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
     | PEval cval =>
       except_bind (typeof_value loc1 env1 cval) (fun (bTy : core_base_type) =>
         except_return (Pexpr annot1 (toInferred bTy) (PEval cval)))
     | PEconstrained cs => /- FIXME -/
       (failwithI "WIP: Core_typing.infer_pexpr, PEconstrained" : exceptM
         (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
     | PEundef loc1 ub => except_return (Pexpr annot1 InferredUnknown (PEundef loc1 ub))
     | PEerror str pe =>
       except_bind (infer_pexpr tagDefs1 env1 pe) (fun (tpe : generic_pexpr inferred sym) =>
         except_return (Pexpr annot1 InferredUnknown (PEerror str tpe)))
     | PEctor ctor1 pes =>
       (let ret_ctor : inferred → ctor → List (generic_pexpr inferred sym) → exceptM
          (generic_pexpr inferred sym) (CerbLocation.Loc × cause) :=
          (fun (bTy : inferred) (ctor1 : ctor) (pes : List (generic_pexpr inferred sym)) =>
            except_return (Pexpr annot1 bTy (PEctor ctor1 pes)));
        match ctor1, pes with
        | Cnil bTy, [] =>
          (let infer := toInferred (BTy_list bTy);
           except_return
             (Pexpr annot1 infer (PEctor (Cnil bTy) ([] : List (generic_pexpr inferred sym)))))
        | Cnil _, _ =>
          (failwithI "infer_pexpr: Cnil: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Ccons, [pe1, pe2] =>
          except_bind (infer_pexpr tagDefs1 env1 pe1) (fun (g : generic_pexpr inferred sym) =>
            match g with
            | pe1'@(Pexpr _ infer1 _) =>
              (match toCoreBaseType infer1 with
               | some bTy1 =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_list bTy1) pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_return
                       (Pexpr annot1 (InferredType_list infer1) (PEctor Ccons [pe1', pe2'])))
               | none =>
                 except_bind (infer_pexpr tagDefs1 env1 pe2)
                   (fun (g : generic_pexpr inferred sym) =>
                     match g with
                     | pe2'@(Pexpr _ infer2 _) =>
                       (match toCoreBaseType infer2 with
                        | some (BTy_list elem_bTy2) =>
                          except_bind (typecheck_pexpr tagDefs1 env1 elem_bTy2 pe1)
                            (fun (pe1' : generic_pexpr inferred sym) =>
                              except_return (Pexpr annot1 infer2 (PEctor Ccons [pe1', pe2'])))
                        | some _ =>
                          core_typing_effect_fail
                            (match pe2 with
                             | (Pexpr annots1 _ _) => get_loc_ annots1)
                            (MismatchFound "Ccons" "list" (toCoreBaseType infer2))
                        | none => /- TODO: can maybe be improved (see Core_typing_aux.unify) -/
                          core_typing_effect_fail loc1 TooGeneral))))
        /-
              let str =
                let str1 = match toCoreBaseType infer1 with
                  | Just bTy ->
                      Pp.stringFromCore_core_base_type bTy
                  | Nothing ->
                      "?"
                end in
                let str2 = match toCoreBaseType infer2 with
                  | Just bTy ->
                      Pp.stringFromCore_core_base_type bTy
                  | Nothing ->
                      "?"
                end in
                str1 ^ " <- vs -> " ^ str2
              in
              E.guard (InferredType_list infer1 = infer2)
                loc (CoreTyping_TODO ("annotate Ccons: illtyped list ==> " ^ str)) >>
              E.return (Pexpr infer2 (PEctor Ccons [pe1'; pe2']))
-/
        | Ccons, _ =>
          (failwithI "infer_pexpr: Ccons: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Ctuple, _ =>
          except_bind (except_mapM (infer_pexpr tagDefs1 env1) pes)
            (fun (pes' : List (generic_pexpr inferred sym)) =>
              match lemListUnzip
                  (List.map
                    (fun (g : generic_pexpr inferred sym) =>
                      match g with
                      | pe'@(Pexpr _ infers _) => (infers, pe')) pes') with
              | (infers, pes') =>
                except_return (Pexpr annot1 (InferredType_tuple infers) (PEctor Ctuple pes')))
        | Civmax, [pe] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
            (fun (pe' : generic_pexpr inferred sym) =>
              ret_ctor (InferredType_object OTy_integer) Civmax [pe'])
        | Civmax, _ =>
          (failwithI "infer_pexpr: Civmax: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Civmin, [pe] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
            (fun (pe' : generic_pexpr inferred sym) =>
              ret_ctor (InferredType_object OTy_integer) Civmin [pe'])
        | Civmin, _ =>
          (failwithI "infer_pexpr: Civmin: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Civsizeof, [pe] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
            (fun (pe' : generic_pexpr inferred sym) =>
              ret_ctor (InferredType_object OTy_integer) Civsizeof [pe'])
        | Civsizeof, _ =>
          (failwithI "infer_pexpr: Civsizeof: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Civalignof, [pe] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
            (fun (pe' : generic_pexpr inferred sym) =>
              ret_ctor (InferredType_object OTy_integer) Civalignof [pe'])
        | Civalignof, _ =>
          (failwithI "infer_pexpr: Civalignof: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | CivCOMPL, [pe1, pe2] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  ret_ctor (InferredType_object OTy_integer) CivCOMPL [pe1', pe2']))
        | CivCOMPL, _ =>
          (failwithI "infer_pexpr: CivCOMPL: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | CivAND, [pe1, pe2, pe3] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                    (fun (pe3' : generic_pexpr inferred sym) =>
                      ret_ctor (InferredType_object OTy_integer) CivAND [pe1', pe2'])))
        | CivAND, _ =>
          (failwithI "infer_pexpr: CivAND: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | CivOR, [pe1, pe2, pe3] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                    (fun (pe3' : generic_pexpr inferred sym) =>
                      ret_ctor (InferredType_object OTy_integer) CivOR [pe1', pe2'])))
        | CivOR, _ =>
          (failwithI "infer_pexpr: CivOR: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | CivXOR, [pe1, pe2, pe3] =>
          except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                    (fun (pe3' : generic_pexpr inferred sym) =>
                      ret_ctor (InferredType_object OTy_integer) CivXOR [pe1', pe2'])))
        | CivXOR, _ =>
          (failwithI "infer_pexpr: CivXOR: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Cspecified, [pe] =>
          except_bind (infer_pexpr tagDefs1 env1 pe) (fun (g : generic_pexpr inferred sym) =>
            match g with
            | pe'@(Pexpr _ infer _) =>
              (match infer with
               | InferredType_object oTy => ret_ctor (InferredType_loaded oTy) Cspecified [pe']
               | _ => core_typing_effect_fail loc1 TooGeneral))
        | Cspecified, _ =>
          (failwithI "infer_pexpr: Cspecified: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | Cunspecified, [Pexpr _ _ (PEval (Vctype ty1))] =>
          (let pe' := Pexpr annot1 InferredType_ctype (PEval (Vctype ty1));
           match core_object_type_of_ctype ty1 with
           | some oTy => ret_ctor (InferredType_loaded oTy) Cunspecified [pe']
           | none => core_typing_effect_fail loc1 (CoreTyping_TODO "Cunspecified, not oTy"))
        | Cunspecified, [pe] =>
          (failwithI "Core_typing, Cunspecified non-trivial" : exceptM (generic_pexpr inferred sym)
            (CerbLocation.Loc × cause))
        | Cunspecified, _ =>
          (failwithI "infer_pexpr: Cunspecified: wrong number of arguments" : exceptM
            (generic_pexpr inferred sym) (CerbLocation.Loc × cause))
        | _, _ =>
          (failwithI (String.append "WIP: infer_pexpr, " (CerbPP.stringFromCore_pexpr pexpr1)) :
            exceptM (generic_pexpr inferred sym) (CerbLocation.Loc × cause)))
     | PEcase pe cases =>
       except_bind (infer_pexpr tagDefs1 env1 pe) (fun (g : generic_pexpr inferred sym) =>
         match g with
         | pe'@(Pexpr _ infer _) =>
           (match toCoreBaseType infer with
            | none => core_typing_effect_fail loc1 TooGeneral
            | some case_bTy =>
              except_bind
                (except_mapM
                  (fun (p : (generic_pattern sym × generic_pexpr bty sym)) =>
                    match p with
                    | (pat, pe) =>
                      except_bind (typecheck_pattern case_bTy pat)
                        (fun (p : (typing_env × generic_pattern sym)) =>
                          match p with
                          | (env', pat') =>
                            except_bind (infer_pexpr tagDefs1 (env_union env1 env') pe)
                              (fun (pe' : generic_pexpr inferred sym) =>
                                except_return (pat', pe')))) cases)
                (fun (cases' : List (generic_pattern sym × generic_pexpr inferred sym)) =>
                  match lemListFoldr
                      (fun (p : (generic_pattern sym × generic_pexpr inferred sym))
                        (acc : Option core_base_type) =>
                        match p, acc with
                        | (_, Pexpr _ infer _),
                          acc => /- NOTE: the eta expansion around Just is because of Lem -/
                          maybe0 (toCoreBaseType infer) (fun (z : core_base_type) => some z) acc)
                      none cases' with
                  | some bTy =>
                    except_bind
                      (except_mapM
                        (fun (p : (generic_pattern sym × generic_pexpr bty sym)) =>
                          match p with
                          | (pat, pe) =>
                            except_bind (typecheck_pattern case_bTy pat)
                              (fun (p : (typing_env × generic_pattern sym)) =>
                                match p with
                                | (env', pat') =>
                                  except_bind
                                    (typecheck_pexpr tagDefs1 (env_union env1 env') bTy pe)
                                    (fun (pe' : generic_pexpr inferred sym) =>
                                      except_return (pat', pe')))) cases)
                      (fun (cases' : List (generic_pattern sym × generic_pexpr inferred sym)) =>
                        except_return (Pexpr annot1 (toInferred bTy) (PEcase pe' cases')))
                  | none => core_typing_effect_fail loc1 TooGeneral)))
     | PEarray_shift pe1 cty pe2 =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe1)
         (fun (pe1' : generic_pexpr inferred sym) =>
           except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
             (fun (pe2' : generic_pexpr inferred sym) =>
               except_return
                 (Pexpr annot1 (InferredType_object OTy_pointer) (PEarray_shift pe1' cty pe2'))))
     | PEmember_shift pe tag_sym memb_ident =>
       (let xs :=
          match Prod.snd
              (fromJust "Core_typing.infer_pexpr, PEmember_shift"
                ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag_sym
                  tagDefs1))) with
          | StructDef z none => z
          | StructDef z (some _) =>
            (failwithI "TODO: Core_typing, PEmember_shift => struct with flexible array member" :
              List (identifier × (attributes × Option alignment × qualifiers × ctype)))
          | UnionDef z => z;
        except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe)
          (fun (pe' : generic_pexpr inferred sym) =>
            match (lookupBy idEqual memb_ident xs) with
            | none => core_typing_effect_fail loc1 (InvalidMember tag_sym memb_ident)
            | _ =>
              except_return
                (Pexpr annot1 (InferredType_object OTy_pointer)
                  (PEmember_shift pe' tag_sym memb_ident))))
     | PEmemop (DeriveCap bop is_signed) [pe1, pe2] =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1)
         (fun (pe1' : generic_pexpr inferred sym) =>
           except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
             (fun (pe2' : generic_pexpr inferred sym) =>
               except_return
                 (Pexpr annot1 (InferredType_object OTy_integer)
                   (PEmemop (DeriveCap bop is_signed) [pe1', pe2']))))
     | PEmemop CapAssignValue [pe1, pe2] =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1)
         (fun (pe1' : generic_pexpr inferred sym) =>
           except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
             (fun (pe2' : generic_pexpr inferred sym) =>
               except_return
                 (Pexpr annot1 (InferredType_object OTy_integer)
                   (PEmemop CapAssignValue [pe1', pe2']))))
     | PEmemop Ptr_tIntValue [pe] =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe)
         (fun (pe' : generic_pexpr inferred sym) =>
           except_return
             (Pexpr annot1 (InferredType_object OTy_integer) (PEmemop Ptr_tIntValue [pe'])))
     | PEmemop ByteFromInt [pe] =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe)
         (fun (pe' : generic_pexpr inferred sym) =>
           except_return
             (Pexpr annot1 (InferredType_object OTy_integer) (PEmemop ByteFromInt [pe'])))
     | PEmemop IntFromByte [pe] =>
       except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe)
         (fun (pe' : generic_pexpr inferred sym) =>
           except_return
             (Pexpr annot1 (InferredType_object OTy_integer) (PEmemop IntFromByte [pe'])))
     | PEmemop _ _ =>
       core_typing_effect_fail loc1 (CoreTyping_TODO (CerbPP.stringFromCore_pexpr pexpr1))
     | PEnot pe =>
       except_fmap (Pexpr annot1 InferredType_boolean)
         (except_fmap PEnot (typecheck_pexpr tagDefs1 env1 BTy_boolean pe))
     | PEop bop pe1 pe2 =>
       trysM_
         (CerbLocation.withRegionsAndCursor
           [match pe1 with
            | (Pexpr annots1 _ _) => get_loc_ annots1,
             match pe2 with
             | (Pexpr annots1 _ _) => get_loc_ annots1] (some loc1)) (MismatchBinaryOperator bop)
         (fun (p : (core_base_type × core_base_type × core_base_type)) =>
           match p with
           | (bTy, bTy1, bTy2) =>
             except_fmap (Pexpr annot1 (toInferred bTy))
               (except_bind (except_fmap (PEop bop) (typecheck_pexpr tagDefs1 env1 bTy1 pe1))
                 (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                   except_fmap f (typecheck_pexpr tagDefs1 env1 bTy2 pe2))))
         (match bop with
          | OpAdd =>
            [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpSub =>
            [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpMul =>
            [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpDiv =>
            [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpRem_t => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
          | OpRem_f => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
          | OpExp => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
          | OpEq =>
            [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating),
              (BTy_boolean, BTy_ctype, BTy_ctype)]
          | OpGt =>
            [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpLt =>
            [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
              (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
          | OpGe =>
            [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
