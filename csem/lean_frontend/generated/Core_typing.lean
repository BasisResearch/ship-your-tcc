def memop_signature : generic_memop sym → (core_base_type × List core_base_type) :=
  fun (x : generic_memop sym) =>
    match x with
    | PtrEq => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | PtrNe => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | PtrLt => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | PtrGt => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | PtrLe => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | PtrGe => (BTy_boolean, [BTy_object OTy_pointer, BTy_object OTy_pointer])
    | Ptrdiff =>
      (BTy_object OTy_integer, [BTy_ctype, BTy_object OTy_pointer, BTy_object OTy_pointer])
    | IntFromPtr => (BTy_object OTy_integer, [BTy_ctype, BTy_ctype, BTy_object OTy_pointer])
    | PtrFromInt => (BTy_object OTy_pointer, [BTy_ctype, BTy_ctype, BTy_object OTy_integer])
    | PtrValidForDeref => (BTy_boolean, [BTy_ctype, BTy_object OTy_pointer])
    | PtrWellAligned => (BTy_boolean, [BTy_ctype, BTy_object OTy_pointer])
    | Memcpy =>
      (BTy_object OTy_pointer,
        [BTy_object OTy_pointer, BTy_object OTy_pointer, BTy_object OTy_integer])
    | Memcmp =>
      (BTy_object OTy_integer,
        [BTy_object OTy_pointer, BTy_object OTy_pointer, BTy_object OTy_integer])
    | Realloc =>
      (BTy_object OTy_pointer,
        [BTy_object OTy_integer, BTy_object OTy_pointer, BTy_object OTy_integer])
    | PtrArrayShift =>
      (BTy_object OTy_pointer, [BTy_object OTy_pointer, BTy_ctype, BTy_object OTy_integer])
    | PtrMemberShift _ _ => (BTy_object OTy_pointer, [BTy_object OTy_pointer])
    | Va_start =>
      (BTy_object OTy_integer, [BTy_list (BTy_tuple [BTy_ctype, BTy_object OTy_pointer])])
    | Va_copy => (BTy_object OTy_integer, [BTy_object OTy_integer])
    | Va_arg => (BTy_object OTy_pointer, [BTy_object OTy_integer, BTy_ctype])
    | Va_end => (BTy_unit, [BTy_object OTy_integer])
    | Copy_alloc_id => (BTy_object OTy_pointer, [BTy_object OTy_integer, BTy_object OTy_pointer])
    | CHERI_intrinsic str (ret_ty, tys) =>
      (let oTys_opt := maybe_mapM core_object_type_of_ctype tys;
       match core_object_type_of_ctype ret_ty, oTys_opt with
       | some ret_oTy, some oTys => (BTy_loaded ret_oTy, List.map BTy_object oTys)
       | _, _ =>
         (failwithI "when typechecking CHERI intrinsics failed to get the params object types" :
           (core_base_type × List core_base_type)))

partial def collect_labels { a bty : Type } (env1 : typing_env) (g : generic_expr a bty sym) :
    exceptM typing_env (CerbLocation.Loc × cause) :=
  match env1, g with
  | env1, (Expr _ expr_) =>
    (match expr_ with
     | Epure _ => except_return env1
     | Ememop _ _ => except_return env1
     | Eaction _ => except_return env1
     | Ecase _ pat_es =>
       core_typing_effect_foldlM
         (fun (env' : typing_env) (p : (generic_pattern sym × generic_expr a bty sym)) =>
           match env', p with
           | env', (_, e) => collect_labels env' e) env1 pat_es
     | Elet _ _ e => collect_labels env1 e
     | Eif _ e1 e2 =>
       except_bind (collect_labels env1 e1) (fun (env' : typing_env) => collect_labels env' e2)
     | Eccall _ _ _ _ => except_return env1
     | Eproc _ _ _ => except_return env1
     | Eunseq es =>
       core_typing_effect_foldlM
         (fun (env' : typing_env) (e : generic_expr a bty sym) => collect_labels env' e) env1 es
     | Ewseq _ e1 e2 =>
       except_bind (collect_labels env1 e1) (fun (env' : typing_env) => collect_labels env' e2)
     | Esseq _ e1 e2 =>
       except_bind (collect_labels env1 e1) (fun (env' : typing_env) => collect_labels env' e2)
     | Ebound e => collect_labels env1 e
     | End es =>
       core_typing_effect_foldlM
         (fun (env' : typing_env) (e : generic_expr a bty sym) => collect_labels env' e) env1 es
     | Esave (sym1, bTy) sym_bTy_pes e =>
       collect_labels
         { env1 with
           labs :=
             (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
               (bTy,
                 List.map
                   (fun (p :
                     (sym ×
                       ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                         bty sym))) =>
                     match p with
                     | (_, ((z, _), _)) => z) sym_bTy_pes) env1.labs) } e
     | Erun _ _ _ => except_return env1
     | Epar es =>
       core_typing_effect_foldlM
         (fun (env' : typing_env) (e : generic_expr a bty sym) => collect_labels env' e) env1 es
     | Ewait _ => except_return env1
     | Eannot _ e => collect_labels env1 e
     | Eexcluded _ _ => except_return env1)
partial def typecheck_expr { a b : Type } (callconv : calling_convention)
    (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition)) (t5 : typing_env)
    (expected_bTy : core_base_type) (g : generic_expr b a sym) :
    exceptM (generic_expr b core_base_type sym) (CerbLocation.Loc × cause) :=
  match callconv, tagDefs1, t5, expected_bTy, g with
  | callconv, tagDefs1, (env1 : typing_env), expected_bTy, (Expr annot1 expr_) =>
    (let typecheck_expr1 : typing_env → core_base_type → generic_expr b a sym → exceptM
       (generic_expr b core_base_type sym) (CerbLocation.Loc × cause) :=
       (fun (env1 : typing_env) (expected_bTy : core_base_type) (expr1 : generic_expr b a sym) =>
         typecheck_expr callconv tagDefs1 env1 expected_bTy expr1);
     let loc1 := get_loc_ annot1;
     let typecheck_ccall_argument :=
       match callconv with
       | Normal_callconv =>
         (fun (_ : ctype) (pe : generic_pexpr a sym) =>
           typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe)
       | Inner_arg_callconv =>
         (fun (ty1 : ctype) (pe : generic_pexpr a sym) =>
           match core_object_type_of_ctype ty1 with
           | some oTy => typecheck_export_pexpr tagDefs1 env1 (BTy_loaded oTy) pe
           | none =>
             core_typing_effect_fail loc1
               (CoreTyping_TODO
                 "the first operand of ccall() has a C function type with a non object parameter type"));
     except_fmap (Expr annot1)
       (match expr_ with
        | Epure pe => except_fmap Epure (typecheck_export_pexpr tagDefs1 env1 expected_bTy pe)
        | Ememop memop1 pes =>
          (match memop_signature memop1 with
           | (ret_bTy, bTys) =>
             (/- FORK 2026-09-23 (audit R3): argument-list arity guard — a surplus
           memop operand (an `error(...)`) was DELETED by the truncating zip -/
             lem_if not ((List.length bTys) == (List.length pes)) then
               core_typing_effect_fail loc1
                 (MismatchExpected "memop()" (BTy_tuple bTys) "argument list of a different arity")
             else
               except_bind
                 (except_mapM
                   (fun (p : (core_base_type × generic_pexpr a sym)) =>
                     match p with
                     | (bTy, pe) => typecheck_export_pexpr tagDefs1 env1 bTy pe)
                   (lemListZip bTys pes))
                 (fun (pes' : List (generic_pexpr core_base_type sym)) =>
                   except_bind (guard_match loc1 "memop()" expected_bTy ret_bTy) (fun (_ : Unit) =>
                     except_return (Ememop memop1 pes')))))
        | (Eaction (Paction p act)) =>
          except_fmap ((fun (x : generic_action b core_base_type sym)=> Eaction (Paction p x)))
            (typecheck_action tagDefs1 env1 expected_bTy act)
        | Ecase pe cases =>
          except_bind (infer_pexpr tagDefs1 env1 pe) (fun (g : generic_pexpr inferred sym) =>
            match g with
            | pe'@(Pexpr _ infer _) =>
              (match toCoreBaseType infer with
               | none =>
                 core_typing_effect_fail
                   (match pe with
                    | (Pexpr annots1 _ _) => get_loc_ annots1) TooGeneral
               | some case_bTy =>
                 except_bind (export_pexpr pe') (fun (pe' : generic_pexpr core_base_type sym) =>
                   except_bind
                     (except_mapM
                       (fun (p : (generic_pattern sym × generic_expr b a sym)) =>
                         match p with
                         | (pat, e) =>
                           except_bind (typecheck_pattern case_bTy pat)
                             (fun (p : (typing_env × generic_pattern sym)) =>
                               match p with
                               | (env', pat') =>
                                 except_bind (export_pattern loc1 pat')
                                   (fun (pat' : generic_pattern sym) =>
                                     except_bind
                                       (typecheck_expr1 (env_union env1 env') expected_bTy e)
                                       (fun (e' : generic_expr b core_base_type sym) =>
                                         except_return (pat', e'))))) cases)
                     (fun (cases' : List
                       (generic_pattern sym × generic_expr b core_base_type sym)) =>
                       except_return (Ecase pe' cases')))))
        | Elet pat pe1 e2 =>
          except_bind (infer_pattern pat)
            (fun (p : (typing_env × inferred × generic_pattern sym)) =>
              match p with
              | (pat_env, pat_infer, _pat') =>
                (match toCoreBaseType pat_infer with
                 | none =>
                   core_typing_effect_fail
                     (match pat with
                      | (Pattern annots1 _) => get_loc_ annots1) TooGeneral
                 | some pat_bTy =>
                   except_bind
                     (except_bind (typecheck_pexpr tagDefs1 env1 pat_bTy pe1) export_pexpr)
                     (fun (pe1' : generic_pexpr core_base_type sym) =>
                       except_bind (export_pattern loc1 _pat') (fun (pat' : generic_pattern sym) =>
                         except_bind (typecheck_expr1 (env_union env1 pat_env) expected_bTy e2)
                           (fun (e2' : generic_expr b core_base_type sym) =>
                             except_return (Elet pat' pe1' e2'))))))
        | Eif pe1 e2 e3 =>
          except_bind
            (except_bind (except_fmap Eif (typecheck_export_pexpr tagDefs1 env1 BTy_boolean pe1))
              (fun (f : generic_expr b core_base_type sym → generic_expr b core_base_type sym →
                generic_expr_ b core_base_type sym) =>
                except_fmap f (typecheck_expr1 env1 expected_bTy e2)))
            (fun (f : generic_expr b core_base_type sym → generic_expr_ b core_base_type sym) =>
              except_fmap f (typecheck_expr1 env1 expected_bTy e3))
        | Eccall annot1 ty_pe pe pes =>
          except_bind (except_bind (infer_pexpr tagDefs1 env1 ty_pe) export_pexpr)
            (fun (ty_pe' : generic_pexpr core_base_type sym) =>
              except_bind (except_bind (infer_pexpr tagDefs1 env1 pe) export_pexpr)
                (fun (g : generic_pexpr core_base_type sym) =>
                  match g with
                  | pe'@(Pexpr _ bTy _) =>
                    (match ty_pe, bTy with
                     | Pexpr _ _
                       (PEval
                         (Vctype
                           (Ctype _ (Pointer _ (Ctype _ (Function (qs, ty1) params isVariadic)))))),
                       BTy_loaded OTy_pointer =>
                       except_bind
                         (lem_if isVariadic then
                           match Lem_List.dest_init pes with
                           | none =>
                             core_typing_effect_fail loc1
                               (CoreTyping_TODO
                                 "ccall to a variadic C procedure must at least have a list of pointers as last argument")
                           | some (xs, last_pe) =>
                             (/- FORK 2026-09-23 (audit R3): the trailing variadic bundle is split
                           off first (xs = the fixed actuals); require EXACTLY |params| of
                           them, zip THAT prefix (the old code zipped `pes`, the whole list,
                           truncated by List.zip), then typecheck the bundle separately.
                           The site's existing error constructor (as :1742). -/
                             lem_if not ((List.length params) == (List.length xs)) then
                               core_typing_effect_fail loc1
                                 (CoreTyping_TODO
                                   "ccall to a variadic C procedure: fixed-argument list of a different arity than the function type's parameters")
                             else
                               except_bind
                                 (except_mapM
                                   (fun (p : ((qualifiers × ctype × Bool) × generic_pexpr a sym)) =>
                                     match p with
                                     | ((_, ty1, _), pe) => typecheck_ccall_argument ty1 pe)
                                   (lemListZip params xs))
                                 (fun (pes' : List (generic_pexpr core_base_type sym)) =>
                                   except_bind
                                     (typecheck_export_pexpr tagDefs1 env1
                                       (BTy_list (BTy_tuple [BTy_ctype, BTy_object OTy_pointer]))
                                       last_pe)
                                     (fun (last_pe' : generic_pexpr core_base_type sym) =>
                                       except_return (pes' ++ [last_pe']))))
                         else /- FORK 2026-09-23 (audit R3): fixed-arity ccall — argument-list arity guard -/ lem_if not
                             ((List.length params) == (List.length pes)) then
                           core_typing_effect_fail loc1
                             (CoreTyping_TODO
                               "ccall: argument list of a different arity than the C function type's parameters")
                         else
                           except_mapM
                             (fun (p : ((qualifiers × ctype × Bool) × generic_pexpr a sym)) =>
                               match p with
                               | ((_, ty1, _), pe) => typecheck_ccall_argument ty1 pe)
                             (lemListZip params pes)
                             /- else match callconv with
                  | Normal_callconv ->
                      E.mapM (fun pe ->
                        typecheck_export_pexpr tagDefs env (BTy_object OTy_pointer) pe
                      ) pes
                  | Inner_arg_callconv ->
                      E.mapM (fun ((_, ty, _), pe) ->
                        match Core_aux.core_object_type_of_ctype ty with
                          | Just oTy ->
                              typecheck_export_pexpr tagDefs env (BTy_loaded oTy) pe
                          | Nothing ->
                              E.fail loc (CoreTyping_TODO "the first operand of ccall() has a C function type with a non object parameter type")
                        end
                      ) (List.zip params pes)
                end -/
                             )
                         (fun (pes' : List (generic_pexpr core_base_type sym)) =>
                           let ret_oTy_opt := core_object_type_of_ctype ty1;
                           except_bind
                             (guard_match loc1 "ccall" expected_bTy
                               (maybe0 BTy_unit BTy_loaded ret_oTy_opt))
                             (fun (_ : Unit) => except_return (Eccall annot1 ty_pe' pe' pes')))
                     | _, _ =>
                       core_typing_effect_fail loc1
                         (CoreTyping_TODO
                           "the first operand of ccall() should have a C function type"))))
        | Eproc annot1 nm pes =>
          (match (fmapLookupBy
               (fun (nm1 : generic_name sym) (nm2 : generic_name sym)=>
                 match nm1, nm2 with
                 | Sym sym1, Sym sym2 => ordCompare sym1 sym2
                 | Impl iCst1, Impl iCst2 => implementation_constant_compare iCst1 iCst2
                 | Sym _, Impl _ => LemOrdering.LT
                 | Impl _, Sym _ => LemOrdering.GT) nm env1.decls) with
           | some (TDproc ret_bTy bTys) =>
             (/- FORK 2026-09-23 (audit R3): argument-list arity guard (see PEcall) -/ lem_if not
                 ((List.length bTys) == (List.length pes)) then
               core_typing_effect_fail loc1
                 (MismatchExpected "proc" (BTy_tuple bTys) "argument list of a different arity")
             else
               except_bind
                 (except_mapM
                   (fun (p : (core_base_type × generic_pexpr a sym)) =>
                     match p with
                     | (bTy, pe) => typecheck_export_pexpr tagDefs1 env1 bTy pe)
                   (lemListZip bTys pes))
                 (fun (pes' : List (generic_pexpr core_base_type sym)) =>
                   except_bind (guard_match loc1 "proc" expected_bTy ret_bTy) (fun (_ : Unit) =>
                     except_return (Eproc annot1 nm pes'))))
           | some _ => /- TODO: clean -/
             core_typing_effect_fail loc1
               (CoreTyping_TODO
                 ("in Eproc(), found a def in a cfunction value: "
                 /- ^
                                           Pp.stringFromCore_value (Vobject (OVcfunction nm)) -/
                 ))
           | none =>
             core_typing_effect_fail loc1
               (CoreTyping_TODO
                 ("in Eproc(), unresolved sym in cfunction value: "
                 /- ^
                                           Pp.stringFromCore_value (Vobject (OVcfunction nm)) -/
                 )))
        | Eunseq [] =>
          core_typing_effect_fail loc1
            (CoreTyping_TODO "UNSEQ must have at least two arguments (seen 0)")
        | Eunseq [e] =>
          core_typing_effect_fail loc1
            (CoreTyping_TODO "UNSEQ must have at least two arguments (seen 1)")
        | Eunseq es =>
          (/- TODO: forbid jumps, par(), ... -/
          match expected_bTy with
          | BTy_tuple bTys =>
            (/- FORK 2026-09-22 (upstream-tray draft 45; audit R1): arity guard —
                 List.zip truncated and DELETED the surplus operands -/
            lem_if not ((List.length bTys) == (List.length es)) then
              core_typing_effect_fail loc1
                (MismatchExpected "Eunseq" expected_bTy "unseq of a different arity")
            else
              except_fmap Eunseq
                (except_mapM
                  (fun (p : (core_base_type × generic_expr b a sym)) =>
                    match p with
                    | (bTy, e) => typecheck_expr1 env1 bTy e) (lemListZip bTys es)))
          | _ => core_typing_effect_fail loc1 (CoreTyping_TODO "UNSEQ illtyped"))
        | Ewseq pat e1 e2 =>
          except_bind (infer_pattern pat)
            (fun (p : (typing_env × inferred × generic_pattern sym)) =>
              match p with
              | (env', infer, _pat') =>
                (match toCoreBaseType infer with
                 | none => core_typing_effect_fail loc1 TooGeneral
                 | some pat_bTy =>
                   except_bind
                     (except_bind (except_fmap Ewseq (export_pattern loc1 _pat'))
                       (fun (f : generic_expr b core_base_type sym → generic_expr b core_base_type
                         sym → generic_expr_ b core_base_type sym) =>
                         except_fmap f (typecheck_expr1 env1 pat_bTy e1)))
                     (fun (f : generic_expr b core_base_type sym → generic_expr_ b core_base_type
                       sym) =>
                       except_fmap f (typecheck_expr1 (env_union env1 env') expected_bTy e2))))
        | Esseq pat e1 e2 =>
          except_bind (infer_pattern pat)
            (fun (p : (typing_env × inferred × generic_pattern sym)) =>
              match p with
              | (env', infer, _pat') =>
                (match toCoreBaseType infer with
                 | none => core_typing_effect_fail loc1 TooGeneral
                 | some pat_bTy =>
                   except_bind
                     (except_bind (except_fmap Esseq (export_pattern loc1 _pat'))
                       (fun (f : generic_expr b core_base_type sym → generic_expr b core_base_type
                         sym → generic_expr_ b core_base_type sym) =>
                         except_fmap f (typecheck_expr1 env1 pat_bTy e1)))
                     (fun (f : generic_expr b core_base_type sym → generic_expr_ b core_base_type
                       sym) =>
                       except_fmap f (typecheck_expr1 (env_union env1 env') expected_bTy e2))))
        | Ebound e => except_fmap /- TODO -/ Ebound (typecheck_expr1 env1 expected_bTy e)
        | End es =>
          (lem_if natLtb (List.length es) 2 then
            core_typing_effect_fail loc1 (CoreTyping_TODO "nd() should have at least 2 operand")
          else
            except_bind (except_mapM (typecheck_expr1 env1 expected_bTy) es)
              (fun (es' : List (generic_expr b core_base_type sym)) => except_return (End es')))
        | Esave sym_bTy sym_bTy_pes e =>
          except_bind
            (/- TODO: check -/ except_mapM
              (fun (p :
                (sym ×
                  ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr a
                    sym))) =>
                match p with
                | (sym1, ((bTy, ct), pe)) =>
                  except_bind (except_bind (typecheck_pexpr tagDefs1 env1 bTy pe) export_pexpr)
                    (fun (pe' : generic_pexpr core_base_type sym) =>
                      except_return (sym1, (((bTy, ct), pe'))))) sym_bTy_pes)
            (fun (sym_bTy_pes' : List
              (sym ×
                ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                  core_base_type sym))) =>
              let env' :=
                (({ decls :=
                      (Lem_Map.fromList
                        (List.map
                          (fun (p :
                            (sym ×
                              ((core_base_type × Option (ctype × pass_by_value_or_pointer)) ×
                                generic_pexpr core_base_type sym))) =>
                            match p with
                            | (sym1, ((bTy, _), _)) => (Sym sym1, TDsym bTy)) sym_bTy_pes')),
                    labs := fmapEmpty } : typing_env));
              except_fmap (Esave sym_bTy sym_bTy_pes')
                (typecheck_expr1 (env_union env1 env') expected_bTy e))
        | Erun annot1 sym1 pes =>
          (match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
               env1.labs) with
           | some (bTy, bTys) =>
             (/-            guard_match loc "run" expected_bTy bTy >> -/ /- TODO check -/ /- FORK 2026-09-23 (audit R3): argument-list arity guard (see PEcall) -/ lem_if not
                 ((List.length bTys) == (List.length pes)) then
               core_typing_effect_fail loc1
                 (MismatchExpected "run" (BTy_tuple bTys) "argument list of a different arity")
             else
               (except_fmap (Erun annot1 sym1)
                 (except_mapM
                   (fun (p : (core_base_type × generic_pexpr a sym)) =>
                     match p with
                     | (bTy, pe) =>
                       except_bind (except_bind (typecheck_pexpr tagDefs1 env1 bTy pe) export_pexpr)
                         (fun (pe' : generic_pexpr core_base_type sym) => except_return pe'))
                   (lemListZip bTys pes))))
           | none => core_typing_effect_fail loc1 (CoreTyping_TODO "Erun, undeclared label"))
        | Epar es =>
          (lem_if natLtb (List.length es) 2 then
            core_typing_effect_fail loc1 (CoreTyping_TODO "Epar must have at least 2 operands")
          else
            match expected_bTy with
            | BTy_tuple bTys =>
              (/- FORK 2026-09-22 (upstream-tray draft 45; audit R1): the same
                 arity guard as Eunseq (same truncating shape) -/
              lem_if not ((List.length bTys) == (List.length es)) then
                core_typing_effect_fail loc1
                  (MismatchExpected "Epar" expected_bTy "par of a different arity")
              else
                except_fmap Epar
                  (except_mapM (uncurry (typecheck_expr1 env1)) (lemListZip bTys es)))
            | _ => core_typing_effect_fail loc1 (CoreTyping_TODO "Epar has as tuple type"))
        | Ewait id1 =>
          (failwithI "typecheck_expr, Ewait" : exceptM (generic_expr_ b core_base_type sym)
            (CerbLocation.Loc × cause))
        | Eannot _ _ =>
          (failwithI "typecheck_expr, Eannot" : exceptM (generic_expr_ b core_base_type sym)
            (CerbLocation.Loc × cause))
        | Eexcluded _ _ =>
          (failwithI "typecheck_expr, Eexcluded" : exceptM (generic_expr_ b core_base_type sym)
            (CerbLocation.Loc × cause))))
/- TODO: add a check for the existence of main -/

def typecheck_program { a bty : Type } [Ord a] [Ord bty] (file1 : generic_file bty a) :
    exceptM (generic_file core_base_type a) (CerbLocation.Loc × cause) :=
  let typecheck_expr1 : typing_env → core_base_type → generic_expr a bty sym → exceptM
    (generic_expr a core_base_type sym) (CerbLocation.Loc × cause) :=
    (fun (env1 : typing_env) (expected_bTy : core_base_type) (expr1 : generic_expr a bty sym) =>
      typecheck_expr file1.calling_convention0 file1.tagDefs env1 expected_bTy expr1);
  let aux :=
    except_bind
      (/- The startup function/procedure must be defined -/
      match file1.main with
      | some sym1 =>
        core_typing_effect_guard
          ((setMemberBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
            (fmapDomainBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) file1.funs)))
          CerbLocation.unknown (UndefinedStartup sym1)
      | none => except_return ())
      (fun (_ :
        Unit) => /- Register the functions/procedures from the stdlib and the impl constants -/
        let env1 :=
          Lem_Map_extra.fold
            (fun (sym1 : sym) (decl : generic_fun_map_decl bty a) (acc : typing_env) =>
              match decl with
              | Fun bTy sym_bTys _ =>
                insert_tdecl (Sym sym1) (TDfun bTy (List.map Prod.snd sym_bTys)) acc
              | ProcDecl _ bTy bTys => insert_tdecl (Sym sym1) (TDproc bTy bTys) acc
              | Proc _ _ bTy sym_bTys _ =>
                insert_tdecl (Sym sym1) (TDproc bTy (List.map Prod.snd sym_bTys)) acc
              | BuiltinDecl _ bTy bTys =>
                (let name1 :=
                   match sym1 with
                   | Symbol _ _ (SD_Id name1) => name1
                   | _ => (failwithI "typecheck_program: BuiltinDecl" : String);
                 insert_tdecl (Impl (BuiltinFunction name1)) (TDproc bTy bTys) acc)) file1.stdlib
            (Lem_Map_extra.fold
              (fun (iCst : implementation_constant) (decl : generic_impl_decl bty)
                (acc : typing_env) =>
                match decl with
                | Def bTy _ => insert_tdecl (Impl iCst) (TDsym bTy) acc
                | IFun bTy sym_bTys _ =>
                  insert_tdecl (Impl iCst) (TDfun bTy (List.map Prod.snd sym_bTys)) acc) file1.impl0
              empty_env);
        except_bind
          (/- Then typechecks them -/ mapMapM
            (fun (_ : sym) (decl : generic_fun_map_decl bty a) =>
              match decl with
              | Fun bTy sym_bTys pe =>
                (let env' :=
                   lemListFoldr
                     (fun (p : (sym × core_base_type)) (acc : typing_env) =>
                       match p, acc with
                       | (sym1, bTy), acc => insert_tdecl (Sym sym1) (TDsym bTy) acc) env1 sym_bTys;
                 except_fmap (Fun bTy sym_bTys) (typecheck_export_pexpr file1.tagDefs env' bTy pe))
              | ProcDecl loc1 bTy bTys => except_return (ProcDecl loc1 bTy bTys)
              | BuiltinDecl loc1 bTy bTys => except_return (BuiltinDecl loc1 bTy bTys)
              | Proc loc1 mrk bTy sym_bTys e =>
                (let env' :=
                   lemListFoldr
                     (fun (p : (sym × core_base_type)) (acc : typing_env) =>
                       match p, acc with
                       | (sym1, bTy), acc => insert_tdecl (Sym sym1) (TDsym bTy) acc) env1 sym_bTys;
                 except_bind (collect_labels env' e) (fun (env' : typing_env) =>
                   except_fmap (Proc loc1 mrk bTy sym_bTys) (typecheck_expr1 env' bTy e))))
            file1.stdlib)
          (fun (stdlib' : Fmap sym (generic_fun_map_decl core_base_type a)) =>
            except_bind
              (/- Typechecking of the impl constants -/ mapMapM
                (fun (_ : implementation_constant) (decl : generic_impl_decl bty) =>
                  match decl with
                  | Def bTy pe =>
                    except_fmap (Def bTy) (typecheck_export_pexpr file1.tagDefs env1 bTy pe)
                  | IFun bTy sym_bTys pe =>
                    (let env' :=
                       lemListFoldr
                         (fun (p : (sym × core_base_type)) (acc : typing_env) =>
                           match p, acc with
                           | (sym1, bTy), acc => insert_tdecl (Sym sym1) (TDsym bTy) acc) env1
                         sym_bTys;
                     except_fmap (IFun bTy sym_bTys)
                       (typecheck_export_pexpr file1.tagDefs env' bTy pe))) file1.impl0)
              (fun (impl' : Fmap implementation_constant (generic_impl_decl core_base_type)) =>
                except_bind
                  (/- Typechecking and registering of the globals -/ core_typing_effect_foldlM
                    (fun (p : (typing_env × List (sym × generic_globs a core_base_type)))
                      (p0 : (sym × generic_globs a bty)) =>
                      match p, p0 with
                      | (env_acc, acc), (sym1, decl) =>
                        (match decl with
                         | GlobalDef (bTy, ct) e =>
                           except_bind (collect_labels env_acc e) (fun (env_acc' : typing_env) =>
                             except_bind (typecheck_expr1 env_acc' bTy e)
                               (fun (te : generic_expr a core_base_type sym) =>
                                 except_return
                                   (insert_tdecl (Sym sym1) (TDsym bTy) env_acc',
                                     ((sym1, GlobalDef (bTy, ct) te) :: acc))))
                         | GlobalDecl (bTy, ct) =>
                           except_return
                             (insert_tdecl (Sym sym1) (TDsym bTy) env_acc,
                               ((sym1, GlobalDecl (bTy, ct)) :: acc)))) (env1, []) file1.globs)
                  (fun (p : (typing_env × List (sym × generic_globs a core_base_type))) =>
                    match p with
                    | (env1, rev_globs') =>
                      (/- Registering the program functions -/
                      let env1 :=
                        Lem_Map_extra.fold
                          (fun (sym1 : sym) (decl : generic_fun_map_decl bty a)
                            (acc : typing_env) =>
                            match decl with
                            | Fun bTy sym_bTys _ =>
                              insert_tdecl (Sym sym1) (TDfun bTy (List.map Prod.snd sym_bTys)) acc
                            | ProcDecl _ bTy bTys => insert_tdecl (Sym sym1) (TDproc bTy bTys) acc
                            | BuiltinDecl _ bTy bTys =>
                              (let name1 :=
                                 match sym1 with
                                 | Symbol _ _ (SD_Id name1) => name1
                                 | _ => (failwithI "typecheck_program: BuiltinDecl" : String);
                               insert_tdecl (Impl (BuiltinFunction name1)) (TDproc bTy bTys) acc)
                            | Proc _ _ bTy sym_bTys _ =>
                              insert_tdecl (Sym sym1) (TDproc bTy (List.map Prod.snd sym_bTys)) acc)
                          file1.funs env1;
                      except_bind
                        (/- and typechecking them -/ mapMapM
                          (fun (_ : sym) (decl : generic_fun_map_decl bty a) =>
                            match decl with
                            | Fun bTy sym_bTys pe =>
                              (let env' :=
                                 lemListFoldr
                                   (fun (p : (sym × core_base_type)) (acc : typing_env) =>
                                     match p, acc with
                                     | (sym1, bTy), acc => insert_tdecl (Sym sym1) (TDsym bTy) acc)
                                   env1 sym_bTys;
                               except_fmap (Fun bTy sym_bTys)
                                 (typecheck_export_pexpr file1.tagDefs env' bTy pe))
                            | ProcDecl loc1 bTy bTys => except_return (ProcDecl loc1 bTy bTys)
                            | BuiltinDecl loc1 bTy bTys => except_return (BuiltinDecl loc1 bTy bTys)
                            | Proc loc1 mrk bTy sym_bTys e =>
                              (let env' :=
                                 lemListFoldr
                                   (fun (p : (sym × core_base_type)) (acc : typing_env) =>
                                     match p, acc with
                                     | (sym1, bTy), acc => insert_tdecl (Sym sym1) (TDsym bTy) acc)
                                   env1 sym_bTys;
                               except_bind (collect_labels env' e) (fun (env' : typing_env) =>
                                 except_fmap (Proc loc1 mrk bTy sym_bTys)
                                   (typecheck_expr1 env' bTy e)))) file1.funs)
                        (fun (funs' : Fmap sym (generic_fun_map_decl core_base_type a)) =>
                          except_return
                            (({ main := file1.main,
