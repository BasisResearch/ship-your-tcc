       | RMW0 pe1 pe2 pe3 pe4 mo1 mo2 =>
         (failwithI "WIP: RMW" : exceptM (generic_action_ core_base_type sym) error)
       | Fence0 mo1 =>
         except_bind (guard_match loc1 "fence()" bTy BTy_unit) (fun (_ : Unit) =>
           except_return (Fence0 mo1))
       | CompareExchangeStrong pe1 pe2 pe3 pe4 mo1 mo2 =>
         except_bind (guard_match loc1 "compareExchangeStrong()" bTy (BTy_loaded OTy_integer))
