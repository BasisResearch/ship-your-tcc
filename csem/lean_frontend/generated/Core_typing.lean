def typecheck_action { a bty : Type } (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (env1 : typing_env) (bTy : core_base_type) (g : generic_action a bty sym) :
    exceptM (generic_action a core_base_type sym) (CerbLocation.Loc × cause) :=
  match tagDefs1, env1, bTy, g with
  | tagDefs1, env1, bTy, (Action loc1 annot1 act_) =>
    except_fmap (Action loc1 annot1)
      (match act_ with
       | Create pe1 pe2 pref =>
         except_bind
           (except_bind (guard_match loc1 "create()" bTy (BTy_object OTy_pointer))
             (fun (_ : Unit) => typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
           (fun (tpe1 : generic_pexpr core_base_type sym) =>
             except_bind (typecheck_export_pexpr tagDefs1 env1 BTy_ctype pe2)
               (fun (tpe2 : generic_pexpr core_base_type sym) =>
                 except_return (Create tpe1 tpe2 pref)))
       | CreateReadOnly pe1 pe2 pe3 pref =>
         except_bind
           (except_bind (guard_match loc1 "create_readonly()" bTy (BTy_object OTy_pointer))
             (fun (_ : Unit) => typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
           (fun (tpe1 : generic_pexpr core_base_type sym) =>
             match pe2 with
             | Pexpr _ _ (PEval (Vctype ty1)) =>
               (let tpe2 := Pexpr ([] : List annot) BTy_ctype (PEval (Vctype ty1));
                match core_object_type_of_ctype ty1 with
                | some lvalue_oTy =>
                  except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_loaded lvalue_oTy) pe3)
                    (fun (tpe3 : generic_pexpr core_base_type sym) =>
                      except_return (CreateReadOnly tpe1 tpe2 tpe3 pref))
