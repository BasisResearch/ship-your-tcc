partial def typecheck_pexpr { a bty : Type } [Inhabited a]
    (tagDefs1 : Fmap sym (a × tag_definition)) (t5 : typing_env) (c : core_base_type)
    (g : generic_pexpr bty sym) :
    eff inferred_pexpr :=
  match tagDefs1, t5, c, g with
  | tagDefs1, (env1 : typing_env), (bTy : core_base_type), pexpr1@(Pexpr annot1 _ pexpr_) =>
    (let loc1 := get_loc_ annot1;
     except_fmap (Pexpr annot1 (toInferred bTy))
       (match pexpr_ with
        | PEsym sym1 =>
          (match (fmapLookupBy
               (fun (nm1 : generic_name sym) (nm2 : generic_name sym)=>
                 match nm1, nm2 with
                 | Sym sym1, Sym sym2 => ordCompare sym1 sym2
                 | Impl iCst1, Impl iCst2 => implementation_constant_compare iCst1 iCst2
                 | Sym _, Impl _ => LemOrdering.LT
                 | Impl _, Sym _ => LemOrdering.GT) (Sym sym1) env1.decls) with
           | some (TDsym bTy') =>
             except_bind (guard_match loc1 (String.append "symbol: " (show_symbol sym1)) bTy bTy')
               (fun (_ : Unit) => except_return (PEsym sym1))
           | some _ =>
             core_typing_effect_fail loc1 (CoreTyping_TODO "found a fun/proc symbolic in a PEsym")
           | none =>
             core_typing_effect_fail loc1
               (CoreTyping_TODO (String.append "unresolved PEsym ==> " (show_symbol sym1))))
        | PEimpl iCst =>
          (match (fmapLookupBy
               (fun (nm1 : generic_name sym) (nm2 : generic_name sym)=>
                 match nm1, nm2 with
                 | Sym sym1, Sym sym2 => ordCompare sym1 sym2
                 | Impl iCst1, Impl iCst2 => implementation_constant_compare iCst1 iCst2
                 | Sym _, Impl _ => LemOrdering.LT
                 | Impl _, Sym _ => LemOrdering.GT) (Impl iCst) env1.decls) with
           | some (TDsym bTy') =>
             except_bind (guard_match loc1 "impl-name" bTy bTy') (fun (_ : Unit) =>
               except_return (PEimpl iCst))
           | some _ =>
             core_typing_effect_fail loc1 (CoreTyping_TODO "found a fun/proc symbolic in a PEimpl")
           | none => core_typing_effect_fail loc1 (CoreTyping_TODO "unresolved PEimpl"))
        | PEval cval =>
          except_bind (typeof_value loc1 env1 cval) (fun (bTy' : core_base_type) =>
            except_bind (guard_match loc1 "value" bTy bTy') (fun (_ : Unit) =>
              except_return (PEval cval)))
        | PEconstrained
          cs => /- list (list Mem.mem_constraint2 * (generic_pexpr 'ty 'sym)) /- constrained value -/ -/
          (failwithI "WIP: Core_typing.typecheck_pexpr, PEconstrained" : exceptM
            (generic_pexpr_ inferred sym) (CerbLocation.Loc × cause))
        | PEundef loc1 ub => except_return (PEundef loc1 ub)
        | PEerror str pe => except_fmap (PEerror str) (infer_pexpr tagDefs1 env1 pe)
        | PEctor ctor1 pes =>
          (let ret_ctor : ctor → generic_pexpr inferred sym → generic_pexpr_ inferred sym :=
             (fun (ctor1 : ctor) (pe : generic_pexpr inferred sym) => PEctor ctor1 [pe]);
           match ctor1, bTy, pes with
           | Cnil cnil_bTy, _, [] =>
             (lem_if eq_core_base_type (BTy_list cnil_bTy) bTy then
               except_return (PEctor (Cnil cnil_bTy) ([] : List (generic_pexpr inferred sym)))
             else
               core_typing_effect_fail loc1 (Mismatch "Cnil" bTy (BTy_list cnil_bTy)))
           | Cnil cnil_bTy, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Cnil" bTy (BTy_list cnil_bTy))
           | Ccons, BTy_list elem_bTy, [pe] =>
             except_fmap (ret_ctor Ccons) (typecheck_pexpr tagDefs1 env1 elem_bTy pe)
           | Ccons, BTy_list elem_bTy, [pe1, pe2] =>
             except_bind (typecheck_pexpr tagDefs1 env1 elem_bTy pe1)
               (fun (pe1' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 bTy pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_return (PEctor Ccons [pe1', pe2'])))
           | Ccons, _, _ => core_typing_effect_fail loc1 (MismatchExpected "Ccons" bTy "list")
           | Ctuple, BTy_tuple bTys, _ =>
             (/- FORK 2026-09-22 (upstream-tray draft 45; audit R1): fail CLOSED on a
                 tuple-arity mismatch. List.zip TRUNCATES, so a tuple EXPRESSION of the
                 wrong arity was accepted and REBUILT with the surplus operands DELETED
                 (an `error(...)` among them vanished from the typed program). -/
             lem_if not ((List.length bTys) == (List.length pes)) then
               core_typing_effect_fail loc1
                 (MismatchExpected "Ctuple" bTy "tuple of a different arity")
             else
               except_bind
                 (except_mapM
                   (fun (p : (core_base_type × generic_pexpr bty sym)) =>
                     match p with
                     | (bTy, pe) => typecheck_pexpr tagDefs1 env1 bTy pe) (lemListZip bTys pes))
                 (fun (pes' : List (generic_pexpr inferred sym)) =>
                   except_return (PEctor Ctuple pes')))
           | Ctuple, _, _ => core_typing_effect_fail loc1 (MismatchExpected "Ctuple" bTy "tuple")
           | Carray, BTy_object (OTy_array oTy), pes =>
             except_fmap (PEctor Carray)
               (except_mapM
                 (fun (pe : generic_pexpr bty sym) =>
                   typecheck_pexpr tagDefs1 env1 (BTy_loaded oTy) pe) pes)
           | Carray, _, _ => core_typing_effect_fail loc1 (MismatchExpected "Carray" bTy "array")
           | Civmax, BTy_object OTy_integer, [pe] =>
             except_fmap (ret_ctor Civmax) (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
           | Civmax, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Civmax" bTy (BTy_object OTy_integer))
           | Civmin, BTy_object OTy_integer, [pe] =>
             except_fmap (ret_ctor Civmin) (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
           | Civmin, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Civmin" bTy (BTy_object OTy_integer))
           | Civsizeof, BTy_object OTy_integer, [pe] =>
             except_fmap (ret_ctor Civsizeof) (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
           | Civsizeof, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Civsizeof" bTy (BTy_object OTy_integer))
           | Civalignof, BTy_object OTy_integer, [pe] =>
             except_fmap (ret_ctor Civalignof) (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
           | Civalignof, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Civalignof" bTy (BTy_object OTy_integer))
           | CivCOMPL, BTy_object OTy_integer, [pe1, pe2] =>
             except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
               (fun (pe1' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_return (PEctor CivCOMPL [pe1', pe2'])))
           | CivCOMPL, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "CivCOMPL" bTy (BTy_object OTy_integer))
           | CivAND, BTy_object OTy_integer, [pe1, pe2, pe3] =>
             except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
               (fun (pe1' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                       (fun (pe3' : generic_pexpr inferred sym) =>
                         except_return (PEctor CivAND [pe1', pe2', pe3']))))
           | CivAND, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "CivAND" bTy (BTy_object OTy_integer))
           | CivOR, BTy_object OTy_integer, [pe1, pe2, pe3] =>
             except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
               (fun (pe1' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                       (fun (pe3' : generic_pexpr inferred sym) =>
                         except_return (PEctor CivOR [pe1', pe2', pe3']))))
           | CivOR, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "CivOR" bTy (BTy_object OTy_integer))
           | CivXOR, BTy_object OTy_integer, [pe1, pe2, pe3] =>
             except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1)
               (fun (pe1' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                   (fun (pe2' : generic_pexpr inferred sym) =>
                     except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe3)
                       (fun (pe3' : generic_pexpr inferred sym) =>
                         except_return (PEctor CivXOR [pe1', pe2', pe3']))))
           | CivXOR, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "CivXOR" bTy (BTy_object OTy_integer))
           | Cspecified, BTy_loaded oTy, [pe] =>
             except_fmap (ret_ctor Cspecified) (typecheck_pexpr tagDefs1 env1 (BTy_object oTy) pe)
           | Cspecified, BTy_storable, [pe] =>
