        | PEcase pe cases =>
          except_bind (infer_pexpr tagDefs1 env1 pe) (fun (g : generic_pexpr inferred sym) =>
            match g with
            | pe'@(Pexpr _ infer _) =>
              (match toCoreBaseType infer with
               | none => core_typing_effect_fail loc1 TooGeneral
               | some case_bTy =>
                 except_bind
                   (except_mapM
                     (fun (p : (generic_pattern sym × generic_pexpr bty sym)) =>
                       match p with
                       | (pat, pe) =>
                         except_bind (typecheck_pattern case_bTy pat)
                           (fun (p : (typing_env × generic_pattern sym)) =>
                             match p with
                             | (env', pat') =>
                               except_bind (typecheck_pexpr tagDefs1 (env_union env1 env') bTy pe)
                                 (fun (pe' : generic_pexpr inferred sym) =>
                                   except_return (pat', pe')))) cases)
                   (fun (cases' : List (generic_pattern sym × generic_pexpr inferred sym)) =>
                     except_return (PEcase pe' cases'))))
        | PEarray_shift pe1 cTy pe2 =>
          except_bind (guard_match loc1 "array_shift()" bTy (BTy_object OTy_pointer))
            (fun (_ : Unit) =>
              (except_bind
                (except_bind
                  (except_fmap PEarray_shift
                    (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe1))
                  (fun (f : ctype → generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                    except_fmap f (except_return cTy)))
                (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                  except_fmap f (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2))))
        | PEmember_shift pe tag_sym memb_ident =>
          (let xs :=
             match Prod.snd
                 (fromJust "Core_typing.typecheck_pexpr, PEmember_shift 1"
                   ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag_sym
                     tagDefs1))) with
             | StructDef z none => z
             | StructDef z (some _) =>
               (failwithI "TODO: Core_typing, PEmember_shift => struct with flexible array member" :
                 List (identifier × (attributes × Option alignment × qualifiers × ctype)))
             | UnionDef z => z;
           match (lookupBy idEqual memb_ident xs) with
           | none => core_typing_effect_fail loc1 (InvalidMember tag_sym memb_ident)
           | _ =>
             except_bind (guard_match loc1 "member_shift()" bTy (BTy_object OTy_pointer))
               (fun (_ : Unit) =>
                 (except_bind
                   (except_bind
                     (except_fmap PEmember_shift
                       (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe))
                     (fun (f : sym → identifier → generic_pexpr_ inferred sym) =>
                       except_fmap f (except_return tag_sym)))
                   (fun (f : identifier → generic_pexpr_ inferred sym) =>
                     except_fmap f (except_return memb_ident)))))
        | PEmemop (DeriveCap bop is_signed) [pe1, pe2] =>
          except_bind
            (except_bind (guard_match loc1 "memop(derive_cap)" bTy (BTy_object OTy_integer))
              (fun (_ : Unit) => typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  except_return (PEmemop (DeriveCap bop is_signed) [pe1', pe2'])))
        | PEmemop CapAssignValue [pe1, pe2] =>
          except_bind
            (except_bind (guard_match loc1 "memop(cap_assign_value)" bTy (BTy_object OTy_integer))
              (fun (_ : Unit) => typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
            (fun (pe1' : generic_pexpr inferred sym) =>
              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
                (fun (pe2' : generic_pexpr inferred sym) =>
                  except_return (PEmemop CapAssignValue [pe1', pe2'])))
        | PEmemop Ptr_tIntValue [pe] =>
          except_bind
            (except_bind (guard_match loc1 "memop(ptr_t_int_value)" bTy (BTy_object OTy_integer))
              (fun (_ : Unit) => typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe))
            (fun (pe' : generic_pexpr inferred sym) => except_return (PEmemop Ptr_tIntValue [pe']))
        | PEmemop ByteFromInt [pe] =>
          except_bind
            (except_bind (guard_match loc1 "memop(bytefromtint)" bTy (BTy_object OTy_integer))
              (fun (_ : Unit) => typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe))
            (fun (pe' : generic_pexpr inferred sym) => except_return (PEmemop ByteFromInt [pe']))
        | PEmemop IntFromByte [pe] =>
          except_bind
            (except_bind (guard_match loc1 "memop(intfrombyte)" bTy (BTy_object OTy_integer))
              (fun (_ : Unit) => typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe))
            (fun (pe' : generic_pexpr inferred sym) => except_return (PEmemop IntFromByte [pe']))
        | PEmemop _ _ =>
          core_typing_effect_fail loc1 (CoreTyping_TODO (CerbPP.stringFromCore_pexpr pexpr1))
        | PEnot pe =>
          except_bind (guard_match loc1 "not()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_fmap PEnot (typecheck_pexpr tagDefs1 env1 BTy_boolean pe)))
        | PEop bop pe1 pe2 =>
          trysM_
            (CerbLocation.withRegionsAndCursor
              [match pe1 with
               | (Pexpr annots1 _ _) => get_loc_ annots1,
                match pe2 with
                | (Pexpr annots1 _ _) => get_loc_ annots1] (some loc1)) (MismatchBinaryOperator bop)
            (fun (p : (core_base_type × core_base_type × core_base_type)) =>
              match p with
              | (bTy', bTy1, bTy2) =>
                (except_bind (except_fmap (PEop bop) (typecheck_pexpr tagDefs1 env1 bTy1 pe1))
                  (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                    except_fmap f (typecheck_pexpr tagDefs1 env1 bTy2 pe2))))
            (match bop with
             | OpAdd =>
               [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpSub =>
               [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpMul =>
               [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpDiv =>
               [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_object OTy_floating, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpRem_t => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
             | OpRem_f => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
             | OpExp => [(BTy_object OTy_integer, BTy_object OTy_integer, BTy_object OTy_integer)]
             | OpEq =>
               [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating),
                 (BTy_boolean, BTy_ctype, BTy_ctype)]
             | OpGt =>
               [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpLt =>
               [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpGe =>
               [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpLe =>
               [(BTy_boolean, BTy_object OTy_integer, BTy_object OTy_integer),
                 (BTy_boolean, BTy_object OTy_floating, BTy_object OTy_floating)]
             | OpAnd => [(BTy_boolean, BTy_boolean, BTy_boolean)]
             | OpOr => [(BTy_boolean, BTy_boolean, BTy_boolean)])
        | PEconv_int ity pe =>
          except_bind (guard_match loc1 "conv_int()" bTy (BTy_object OTy_integer))
            (fun (u : Unit) =>
              match u with
              | () =>
                except_fmap (PEconv_int ity)
                  (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe))
        | PEwrapI ity iop1 pe1 pe2 =>
          except_bind (guard_match loc1 "wrapI_OP()" bTy (BTy_object OTy_integer))
            (fun (u : Unit) =>
              match u with
              | () =>
                except_bind
                  (except_fmap (PEwrapI ity iop1)
                    (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
                  (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                    except_fmap f (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)))
        | PEcatch_exceptional_condition ity iop1 pe1 pe2 =>
          except_bind
            (guard_match loc1 "catch_exceptional_condition_OP()" bTy (BTy_object OTy_integer))
            (fun (u : Unit) =>
              match u with
              | () =>
                except_bind
                  (except_fmap (PEcatch_exceptional_condition ity iop1)
                    (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1))
                  (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                    except_fmap f (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)))
        | PEstruct tag_sym fields =>
          except_bind
            (except_bind (guard_match loc1 "struct()" bTy (BTy_object (OTy_struct tag_sym)))
              (fun (_ : Unit) =>
                match Prod.snd
                    (fromJust "Core_typing.typecheck_pexpr, PEstruct"
                      ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag_sym
                        tagDefs1))) with
                | UnionDef _ => core_typing_effect_fail loc1 (InvalidTag tag_sym)
                | StructDef xs flexible_opt =>
                  except_mapM
                    (fun (p : (identifier × generic_pexpr bty sym)) =>
                      match p with
                      | (ident, pe) =>
                        (match (lookupBy idEqual ident xs) with
                         | none => /- TODO(check) we ignore the potential flexible array member, because they should not exist in structs as value -/
                           core_typing_effect_fail loc1 (InvalidMember tag_sym ident)
                         | some (_, _, _, ty1) =>
                           (match core_object_type_of_ctype ty1 with
                            | none =>
                              core_typing_effect_fail loc1
                                (CoreTyping_TODO
                                  (String.append "in PEstruct, failed to convert '"
                                    (String.append (CerbPP.stringFromCore_ctype ty1)
                                      "' to a Core object type")))
                            | some oTy =>
                              except_bind (typecheck_pexpr tagDefs1 env1 (BTy_loaded oTy) pe)
                                (fun (pe' : generic_pexpr inferred sym) =>
                                  except_return (ident, pe'))))) fields))
            (fun (fields' : List (identifier × generic_pexpr inferred sym)) =>
              except_return (PEstruct tag_sym fields'))
        | PEunion tag_sym ident pe =>
          except_bind (guard_match loc1 "union()" bTy (BTy_object (OTy_union tag_sym)))
            (fun (_ : Unit) =>
              match Prod.snd
                  (fromJust "Core_typing.typecheck_pexpr, PEunion"
                    ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag_sym
                      tagDefs1))) with
              | StructDef _ _ => core_typing_effect_fail loc1 (InvalidTag tag_sym)
              | UnionDef xs =>
                (match (lookupBy idEqual ident xs) with
                 | none => core_typing_effect_fail loc1 (InvalidMember tag_sym ident)
                 | some (_, _, _, ty1) =>
                   (match core_object_type_of_ctype ty1 with
                    | none =>
                      core_typing_effect_fail loc1
                        (CoreTyping_TODO
                          (String.append "in PEunion, failed to convert '"
                            (String.append (CerbPP.stringFromCore_ctype ty1)
                              "' to a Core object type")))
                    | some oTy =>
                      except_bind (typecheck_pexpr tagDefs1 env1 (BTy_loaded oTy) pe)
                        (fun (pe' : generic_pexpr inferred sym) =>
                          except_return (PEunion tag_sym ident pe')))))
        | PEcfunction pe =>
          except_bind
            (guard_match loc1 "cfunction()" bTy
              (BTy_tuple [BTy_ctype, BTy_list BTy_ctype, BTy_boolean, BTy_boolean]))
            (fun (_ : Unit) =>
              (except_fmap PEcfunction (typecheck_pexpr tagDefs1 env1 (BTy_loaded OTy_pointer) pe)))
        | PEmemberof tag_sym memb_ident pe =>
          (match match Prod.snd
                     (fromJust "Core_typing.typecheck_pexpr, PEmemberof"
                       ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag_sym
                         tagDefs1))) with
                 | StructDef xs none => (OTy_struct, xs)
                 | StructDef xs (some _) =>
                   (failwithI "TODO: Core_typing, PEmemberof => struct with flexible array member" :
                     ((sym → core_object_type) × List
                       (identifier × (attributes × Option alignment × qualifiers × ctype))))
                 | UnionDef xs => (OTy_union, xs) with
           | (oty_ctor, xs) =>
             (match (lookupBy idEqual memb_ident xs) with
              | none => core_typing_effect_fail loc1 (InvalidMember tag_sym memb_ident)
              | some (_, _, _, ty1) =>
                (match core_object_type_of_ctype ty1 with
                 | none =>
                   core_typing_effect_fail loc1
                     (CoreTyping_TODO
                       (String.append "in PEmemberof, failed to convert '"
                         (String.append (CerbPP.stringFromCore_ctype ty1)
                           "' to a Core object type")))
                 | some oTy =>
                   except_bind (guard_match loc1 "memberof()" bTy (BTy_loaded oTy))
                     (fun (u : Unit) =>
                       match u with
                       | () =>
                         except_fmap (PEmemberof tag_sym memb_ident)
                           (typecheck_pexpr tagDefs1 env1 (BTy_object (oty_ctor tag_sym)) pe)))))
        | PEcall nm pes =>
          (match (fmapLookupBy
               (fun (nm1 : generic_name sym) (nm2 : generic_name sym)=>
                 match nm1, nm2 with
                 | Sym sym1, Sym sym2 => ordCompare sym1 sym2
                 | Impl iCst1, Impl iCst2 => implementation_constant_compare iCst1 iCst2
                 | Sym _, Impl _ => LemOrdering.LT
                 | Impl _, Sym _ => LemOrdering.GT) nm env1.decls) with
           | some (TDfun ret_bTy bTys) =>
             except_bind (guard_match loc1 "function call" bTy ret_bTy)
               (fun (_ :
                 Unit) => /- FORK 2026-09-23 (audit R3): argument-list arity guard, as in infer_pexpr -/
                 (lem_if not ((List.length bTys) == (List.length pes)) then
                   core_typing_effect_fail loc1
                     (MismatchExpected "PEcall" (BTy_tuple bTys)
                       "argument list of a different arity")
                 else
                   (except_fmap (PEcall nm)
                     (except_mapM
                       (fun (p : (core_base_type × generic_pexpr bty sym)) =>
                         match p with
                         | (bTy, pe) => typecheck_pexpr tagDefs1 env1 bTy pe)
                       (lemListZip bTys pes)))))
           | some _ =>
             core_typing_effect_fail loc1
               (CoreTyping_TODO
                 (String.append "illtyped a fun/proc symbolic ==> "
                   (CerbPP.stringFromCore_pexpr pexpr1)))
           | none =>
             core_typing_effect_fail loc1
               (CoreTyping_TODO
                 (String.append "unresolved PEcall ==> " (CerbPP.stringFromCore_pexpr pexpr1))))
        | PElet pat pe1 pe2 =>
          except_bind (infer_pattern pat)
            (fun (p : (typing_env × inferred × generic_pattern sym)) =>
              match p with
              | (pat_env, pat_infer, pat') =>
                (match toCoreBaseType pat_infer with
                 | some pat_bTy =>
                   except_bind (typecheck_pexpr tagDefs1 env1 pat_bTy pe1)
                     (fun (pe1' : generic_pexpr inferred sym) =>
                       except_bind (typecheck_pexpr tagDefs1 (env_union env1 pat_env) bTy pe2)
                         (fun (pe2' : generic_pexpr inferred sym) =>
                           except_return (PElet pat' pe1' pe2')))
                 | none =>
                   except_bind (infer_pexpr tagDefs1 env1 pe1)
                     (fun (g : generic_pexpr inferred sym) =>
                       match g with
                       | pe1'@(Pexpr _ pe1_infer _) =>
                         (match toCoreBaseType pe1_infer with
                          | some pe1_bTy =>
                            except_bind (typecheck_pattern pe1_bTy pat)
                              (fun (p : (typing_env × generic_pattern sym)) =>
                                match p with
                                | (pat_env, pat') =>
                                  except_bind
                                    (typecheck_pexpr tagDefs1 (env_union env1 pat_env) bTy pe2)
                                    (fun (pe2' : generic_pexpr inferred sym) =>
                                      except_return (PElet pat' pe1' pe2')))
                          | none =>
                            core_typing_effect_fail
                              (match pat with
                               | (Pattern annots1 _) => get_loc_ annots1) TooGeneral))))
        | PEif pe1 pe2 pe3 =>
          except_bind
            (except_bind (except_fmap PEif (typecheck_pexpr tagDefs1 env1 BTy_boolean pe1))
              (fun (f : generic_pexpr inferred sym → generic_pexpr inferred sym → generic_pexpr_
                inferred sym) =>
                except_fmap f (typecheck_pexpr tagDefs1 env1 bTy pe2)))
            (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
              except_fmap f (typecheck_pexpr tagDefs1 env1 bTy pe3))
        | PEis_scalar pe =>
          except_bind (guard_match loc1 "is_scalar()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_fmap PEis_scalar (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)))
        | PEis_integer pe =>
          except_bind (guard_match loc1 "is_integer()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_fmap PEis_integer (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)))
        | PEis_signed pe =>
          except_bind (guard_match loc1 "is_signed()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_fmap PEis_signed (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)))
        | PEis_unsigned pe =>
          except_bind (guard_match loc1 "is_unsigned()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_fmap PEis_unsigned (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)))
        | PEbmc_assume pe =>
          except_bind (guard_match loc1 "bmc_assume()" bTy BTy_unit) (fun (_ : Unit) =>
            (except_fmap PEbmc_assume (typecheck_pexpr tagDefs1 env1 BTy_boolean pe)))
        | PEare_compatible pe1 pe2 =>
          except_bind (guard_match loc1 "are_compatible()" bTy BTy_boolean) (fun (_ : Unit) =>
            (except_bind
              (except_fmap PEare_compatible (typecheck_pexpr tagDefs1 env1 BTy_ctype pe1))
              (fun (f : generic_pexpr inferred sym → generic_pexpr_ inferred sym) =>
                except_fmap f (typecheck_pexpr tagDefs1 env1 BTy_ctype pe2))))))
end

/- val typecheck_export_pexpr: forall 'bty. core_tag_definitions -> typing_env -> core_base_type -> Core.generic_pexpr 'bty Symbol.sym -> E.eff typed_pexpr -/
def typecheck_export_pexpr { a b : Type } [Inhabited b] (tagDefs1 : Fmap sym (b × tag_definition))
    (env1 : typing_env) (bTy : core_base_type) (pe : generic_pexpr a sym) :
    exceptM (generic_pexpr core_base_type sym) (CerbLocation.Loc × cause) :=
  except_bind (typecheck_pexpr tagDefs1 env1 bTy pe) export_pexpr

/- val infer_action: foral 'a 'bty. core_tag_definitions -> typing_env -> generic_action 'a 'bty -> E.eff (core_base_type * typed_action 'a) -/
def infer_action { a b c : Type } [Inhabited b] (tagDefs1 : Fmap sym (b × tag_definition))
    (env1 : typing_env) (g : generic_action a c sym) :
    exceptM (core_base_type × generic_action a core_base_type sym) (CerbLocation.Loc × cause) :=
  match tagDefs1, env1, g with
  | tagDefs1, env1, (Action loc1 annot1 act_) =>
    except_bind
      (match act_ with
       | Create pe1 pe2 pref =>
         except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1)
           (fun (tpe1 : generic_pexpr core_base_type sym) =>
             except_bind (typecheck_export_pexpr tagDefs1 env1 BTy_ctype pe2)
               (fun (tpe2 : generic_pexpr core_base_type sym) =>
                 except_return (BTy_object OTy_pointer, Create tpe1 tpe2 pref)))
       | CreateReadOnly pe1 pe2 pe3 pref =>
         except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1)
           (fun (tpe1 : generic_pexpr core_base_type sym) =>
             match pe2 with
             | Pexpr _ _ (PEval (Vctype ty1)) =>
               (let tpe2 := Pexpr ([] : List annot) BTy_ctype (PEval (Vctype ty1));
                match core_object_type_of_ctype ty1 with
                | some lvalue_oTy =>
                  except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_loaded lvalue_oTy) pe3)
                    (fun (tpe3 : generic_pexpr core_base_type sym) =>
                      except_return (BTy_object OTy_pointer, CreateReadOnly tpe1 tpe2 tpe3 pref))
                | none => core_typing_effect_fail loc1 (CoreTyping_TODO "CreateReadOnly, not oTy"))
             | _ =>
               core_typing_effect_fail loc1 (CoreTyping_TODO "CreateReadOnly, non-trivial ctype"))
       | Alloc0 pe1 pe2 pref =>
         except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe1)
           (fun (tpe1 : generic_pexpr core_base_type sym) =>
             except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe2)
               (fun (tpe2 : generic_pexpr core_base_type sym) =>
                 except_return (BTy_object OTy_pointer, Alloc0 tpe1 tpe2 pref)))
       | Kill kind1 pe =>
         except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe)
           (fun (tpe : generic_pexpr core_base_type sym) =>
             except_return (BTy_unit, Kill kind1 tpe))
       | Store0 b pe1 pe2 pe3 mo1 =>
         (match pe1 with
          | Pexpr _ _ (PEval (Vctype ty1)) =>
            (let tpe1 := Pexpr ([] : List annot) BTy_ctype (PEval (Vctype ty1));
             match core_object_type_of_ctype ty1 with
             | some lvalue_oTy =>
               except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe2)
                 (fun (tpe2 : generic_pexpr core_base_type sym) =>
                   except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_loaded lvalue_oTy) pe3)
                     (fun (tpe3 : generic_pexpr core_base_type sym) =>
                       except_return (BTy_unit, Store0 b tpe1 tpe2 tpe3 mo1)))
             | none => core_typing_effect_fail loc1 (CoreTyping_TODO "Store, not oTy"))
          | _ =>
            except_bind (typecheck_export_pexpr tagDefs1 env1 BTy_ctype pe1)
              (fun (tpe1 : generic_pexpr core_base_type sym) =>
                except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe2)
                  (fun (tpe2 : generic_pexpr core_base_type sym) =>
                    except_bind (infer_pexpr tagDefs1 env1 pe3)
                      (fun (g : generic_pexpr inferred sym) =>
                        match g with
                        | pe3'@(Pexpr _ pe3_infer _) =>
                          (lem_if is_inferred_storable pe3_infer then
                            except_bind (export_pexpr pe3')
                              (fun (tpe3 : generic_pexpr core_base_type sym) =>
                                except_return (BTy_unit, Store0 b tpe1 tpe2 tpe3 mo1))
                          else
                            core_typing_effect_fail loc1
                              (CoreTyping_TODO "Store, not storable"))))))
       | SeqRMW b pe1 pe2 sym1 pe3 =>
         (match pe1 with
          | Pexpr _ _ (PEval (Vctype ty1)) =>
            (let tpe1 := Pexpr ([] : List annot) BTy_ctype (PEval (Vctype ty1));
             match core_object_type_of_ctype ty1 with
             | some lvalue_oTy =>
               (let env' := insert_tdecl (Sym sym1) (TDsym (BTy_loaded lvalue_oTy)) env1;
                except_bind (typecheck_export_pexpr tagDefs1 env1 (BTy_object OTy_pointer) pe2)
                  (fun (tpe2 : generic_pexpr core_base_type sym) =>
