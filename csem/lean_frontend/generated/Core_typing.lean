           | Cunspecified, BTy_loaded _, [pe] =>
             except_fmap (ret_ctor Cunspecified) (typecheck_pexpr tagDefs1 env1 BTy_ctype pe)
           | Cunspecified, _, _ =>
             core_typing_effect_fail loc1 (MismatchExpected "Cunspecified" bTy "loaded object")
           | Cfvfromint, BTy_object OTy_floating, [pe] =>
             except_fmap (ret_ctor Cfvfromint)
               (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_integer) pe)
           | Cfvfromint, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Cfvfromint" bTy (BTy_object OTy_floating))
           | Civfromfloat, BTy_object OTy_integer, [pe_ty, pe_fval] =>
             except_bind (typecheck_pexpr tagDefs1 env1 BTy_ctype pe_ty)
               (fun (pe_ty' : generic_pexpr inferred sym) =>
                 except_bind (typecheck_pexpr tagDefs1 env1 (BTy_object OTy_floating) pe_fval)
                   (fun (pe_fval' : generic_pexpr inferred sym) =>
                     except_return (PEctor Civfromfloat [pe_ty', pe_fval'])))
           | Civfromfloat, _, _ =>
             core_typing_effect_fail loc1 (Mismatch "Civfromfloat" bTy (BTy_object OTy_integer))
           | CivNULLcap is_signed, BTy_object OTy_integer, [] =>
             except_return (PEctor (CivNULLcap is_signed) ([] : List (generic_pexpr inferred sym)))
