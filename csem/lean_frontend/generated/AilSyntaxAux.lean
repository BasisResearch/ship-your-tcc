/- Removes non-semantic constructor from a expression. Pattern matching with mor
   than one level of unfolding should usually only be done on stripped expressions -/

partial def strip_expression { a : Type } (e : expression a) : expression a :=
  match e with
  | expr1@(AnnotatedExpression _ _ _ expr_) =>
    (match expr_ with
     | AilEannot _ e => strip_expression e
     | AilEprint_type e => strip_expression e
     | _ => expr1)
/- STD §6.3.2.3#3, sentence 1 -/

partial def is_null_pointer_constant { a : Type } (expr1 : expression a) : Bool :=
  match strip_expression expr1 with
  | AnnotatedExpression _ _ _ expr_ =>
    (match expr_ with
     | AilEconst ConstantNull => true
     | AilEconst (ConstantInteger (IConstant n _ _)) => n == (0 : Int)
     | AilEcast cast_qs (Ctype _ (Pointer referenced_qs (Ctype _ Void0))) e =>
       is_null_pointer_constant e && (is_unqualified cast_qs && is_unqualified referenced_qs)
     | AilEatomic e => is_null_pointer_constant e
     | _ => /- TODO: should this return true for 'ConstantPredefined PConstantFalse' ? -/ false)
