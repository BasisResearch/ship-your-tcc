def warn_atomic_elaboration (guard2 : Bool) : elab_state → (Unit × elab_state) :=
  (lemSeq
    (fun _ =>
      lem_if guard2 then
        CerbDebug.warn [DB_elaboration] (fun (u : Unit) =>
          match u with
          | () => "TODO: elaboration is wrong for atomic types")
      else
        ()) (fun _ => return0 ()))
def conv_arith (stdlib1 : translation_stdlib) (ty_src : ctype) (ty_dst : ctype)
    (pe : generic_pexpr Unit sym) :
    generic_pexpr Unit sym :=
  lem_if is_integer ty_src then
    lem_if is_integer ty_dst then
      stdlib1.mkcall_conv_int ty_dst pe
    else lem_if is_floating ty_dst then
      Pexpr ([] : List annot) () (PEctor Cfvfromint [mk_ail_ctype_pe ty_dst, pe])
    else /- NOTE: this case will occurs in particular if ty_dst is an atomic type -/
      (failwithI "Translation_aux.conv_arith, not (is_arithmetic ty_dst)" : generic_pexpr Unit sym)
  else lem_if is_floating ty_src then
    lem_if is_integer ty_dst then
      Pexpr ([] : List annot) () (PEctor Civfromfloat [mk_ail_ctype_pe ty_dst, pe])
    else lem_if is_floating ty_dst then /- TODO: floating vs floating conversion -/
      pe
    else /- NOTE: this case will occurs in particular if ty_dst is an atomic type -/
      (failwithI "Translation_aux.conv_arith, not (is_arithmetic ty_dst)" : generic_pexpr Unit sym)
  else /- NOTE: this case will occurs in particular if ty_src is an atomic type -/
    (failwithI "Translation_aux.conv_arith, not (is_arithmetic ty_src)" : generic_pexpr Unit sym)

/-
  LET mask = [| ~(CAP_PERM_STORE || CAP_PERM_STORE_CAP || CAP_PERM_STORE_LOCAL_CAP) |] IN
  memop(cheri_perms_and, ptr, mask)
-/
def cheri_readonly_perms (ptr_ty : ctype) (ptr_pe : generic_pexpr Unit sym) :
    generic_expr Unit Unit sym :=
  /- C equivalent:
     size_t mask = ~(CHERI_PERM_STORE|CHERI_PERM_STORE_CAP|CHERI_PERM_STORE_LOCAL_CAP);

     for Morello, `mask` is 64-bit unsigned integer.
   -/
  let mask_pe := mk_integer_pe ((18446744073709473791 : Int));
  mk_memop_e (CHERI_intrinsic "cheri_perms_and" (ptr_ty, [ptr_ty, size_t])) [ptr_pe, mask_pe]
