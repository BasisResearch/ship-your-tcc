  | (ailnames1, stdlib_fun_map) =>
    (let std_syms :=
       setToList
         ((fmapDomainBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) stdlib_fun_map));
     let mk_call : String → List (generic_pexpr Unit sym) → generic_pexpr Unit sym :=
       (fun (str : String) (pes : List (generic_pexpr Unit sym)) =>
         Pexpr ([] : List annot) () (PEcall (Sym (fetch_stdlib_symbol std_syms str)) pes));
     let mk_proc : String → List (generic_pexpr Unit sym) → generic_expr Unit Unit sym :=
       (fun (str : String) (pes : List (generic_pexpr Unit sym)) =>
         Expr ([] : List annot) (Eproc () (Sym (fetch_stdlib_symbol std_syms str)) pes));
     (({ ailnames := ailnames1,
         mkcall_bitwise_AND :=
           (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "bitwise_AND" [mk_ail_ctype_pe ty1, pe1, pe2]),
         mkcall_bitwise_XOR :=
           (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "bitwise_XOR" [mk_ail_ctype_pe ty1, pe1, pe2]),
         mkcall_bitwise_OR :=
           (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "bitwise_OR" [mk_ail_ctype_pe ty1, pe1, pe2]),
         mkcall_conv_int := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           lem_if not (is_integer ty1) then
             (failwithI "mkcall_conv_int called on non integer type" : generic_pexpr Unit sym)
           else
             mk_call "conv_int" [mk_ail_ctype_pe ty1, pe]),
         mkcall_conv_loaded_int := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           lem_if not (is_integer ty1) then
             (failwithI "mkcall_conv_loaded_int called on non integer type" : generic_pexpr Unit
               sym)
           else
             mk_call "conv_loaded_int" [mk_ail_ctype_pe ty1, pe]),
         mkcall_loaded_fvfromint := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           lem_if not (is_floating ty1) then
             (failwithI "mkcall_loaded_fvfromint called on a non floating type" : generic_pexpr Unit
               sym)
           else
             mk_call "loaded_fvfromint" [mk_ail_ctype_pe ty1, pe]),
         mkcall_loaded_ivfromfloat := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           lem_if not (is_integer ty1) then
             (failwithI "mkcall_loaded_ivfromfloat called on a non integer type" : generic_pexpr
               Unit sym)
           else
             mk_call "loaded_ivfromfloat" [mk_ail_ctype_pe ty1, pe]),
         mkcall_conv_loaded_int_ :=
           (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "conv_loaded_int" [pe1, pe2]),
         mkcall_loaded_fvfromint_ :=
           (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "loaded_fvfromint" [pe1, pe2]),
         mkcall_loaded_ivfromfloat_ :=
           (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_call "loaded_ivfromfloat" [pe1, pe2]),
         mkcall_wrapI := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           mk_call "wrapI" [mk_ail_ctype_pe ty1, pe]),
         mkcall_ctype_width := (fun (ty1 : ctype) => mk_call "ctype_width" [mk_ail_ctype_pe ty1]),
         mkcall_is_representable := (fun (pe : generic_pexpr Unit sym) (ty1 : ctype) =>
           let str :=
             lem_if is_integer ty1 then
               "is_representable_integer"
             else lem_if is_floating ty1 then
               "is_representable_floating"
             else
               (failwithI
                 "Translation_aux.mkcall_is_representable, the type is neither an integer nor a floating" :
                 String);
           mk_call str [pe, mk_ail_ctype_pe ty1]),
         mkcall_all_values_representable_in := (fun (ty1 : ctype) (ty2 : ctype) =>
           mk_call "all_values_representable_in" [mk_ail_ctype_pe ty1, mk_ail_ctype_pe ty2]),
         mkcall_catch_exceptional_condition := (fun (ty1 : ctype) (pe : generic_pexpr Unit sym) =>
           mk_call "catch_exceptional_condition" [mk_ail_ctype_pe ty1, pe]),
         mkproc_loaded_pointer_to_Bool := (fun (pe : generic_pexpr Unit sym) =>
           mk_proc "loaded_pointer_to_Bool" [pe]),
         mkcall_params_length := (fun (pe : generic_pexpr Unit sym) =>
           mk_call "params_length" [pe]),
         mkcall_params_nth := (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
           mk_call "params_nth" [pe1, pe2]),
         mkcall_is_floating := (fun (pe : generic_pexpr Unit sym) => mk_call "is_floating" [pe]),
         mkproc_create_and_store :=
           (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
             mk_proc "create_and_store" [pe1, pe2]) } : translation_stdlib)))
/- ASSUMES: is_arithmetic ty_src && is_arithmetic ty_dst -/

def conv_loaded_arith (stdlib1 : translation_stdlib) (ty_src : ctype) (ty_dst : ctype)
    (pe : generic_pexpr Unit sym) :
    generic_pexpr Unit sym :=
  lem_if is_integer ty_src then
    lem_if is_integer ty_dst then
      stdlib1.mkcall_conv_loaded_int ty_dst pe
    else lem_if is_floating ty_dst then
      stdlib1.mkcall_loaded_fvfromint ty_dst pe
    else /- NOTE: this case will occurs in particular if ty_dst is an atomic type -/
      (failwithI "Translation_aux.conv_loaded_arith, not (is_arithmetic ty_dst)" : generic_pexpr
        Unit sym)
      /-      C.Pexpr [] () (C.PEctor C.Cfvfromint [Caux.mk_ail_ctype_pe ty_dst; pe]) -/
  else lem_if is_floating ty_src then
    lem_if is_integer ty_dst then
      stdlib1.mkcall_loaded_ivfromfloat ty_dst
        pe
        /-      C.Pexpr [] () (C.PEctor C.Civfromfloat [Caux.mk_ail_ctype_pe ty_dst; pe]) -/
    else lem_if is_floating ty_dst then /- TODO: floating vs floating conversion -/
      pe
    else /- NOTE: this case will occurs in particular if ty_dst is an atomic type -/
      (failwithI "Translation_aux.conv_loaded_arith, not (is_arithmetic ty_dst)" : generic_pexpr
        Unit sym)
  else /- NOTE: this case will occurs in particular if ty_src is an atomic type -/
    (failwithI "Translation_aux.conv_loaded_arith, not (is_arithmetic ty_src)" : generic_pexpr Unit
      sym)
