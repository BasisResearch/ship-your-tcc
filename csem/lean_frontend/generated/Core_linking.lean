     | CreateReadOnly pe1 pe2 pe3 _ => free_pexpr (free_pexpr (free_pexpr acc pe1) pe2) pe3
     | Alloc0 pe1 pe2 _ => free_pexpr (free_pexpr acc pe1) pe2
     | Kill _ pe => free_pexpr acc pe
     | Store0 _ pe1 pe2 pe3 _ => free_pexpr (free_pexpr (free_pexpr acc pe1) pe2) pe3
     | Load0 pe1 pe2 _ => free_pexpr (free_pexpr acc pe1) pe2
     | SeqRMW _ pe1 pe2 sym1 pe3 =>
       (let ss3 :=
          (setDiffBy (@setElemCompare a _) (free_pexpr setEmpty pe3)
            (setFromListBy setElemCompare [sym1]));
        (setUnionBy (@setElemCompare a _) ss3
          (free_pexpr (free_pexpr acc pe1)
            pe2))) /- (free_pexpr (free_pexpr (free_pexpr acc pe1) pe2) pe3) \ { sym } -/
     | RMW0 pe1 pe2 pe3 pe4 _ _ =>
       free_pexpr (free_pexpr (free_pexpr (free_pexpr acc pe1) pe2) pe3) pe4
     | Fence0 _ => acc
     | CompareExchangeStrong _ _ _ _ _ _ =>
       (failwithI "free_paction: CompareExchangeStrong" : Pset a)
     | CompareExchangeWeak _ _ _ _ _ _ => (failwithI "free_paction: CompareExchangeWeak" : Pset a)
     | LinuxFence _ => (failwithI "free_paction: LinuxFence" : Pset a)
     | LinuxLoad _ _ _ => (failwithI "free_paction: LinuxLoad" : Pset a)
     | LinuxStore _ _ _ _ => (failwithI "free_paction: LinuxStore" : Pset a)
     | LinuxRMW _ _ _ _ => (failwithI "free_paction: LinuxRMW" : Pset a))

def free_paction { a b c : Type } [SetType c] (acc : Pset c) (g : generic_paction a b c) : Pset c :=
  match acc, g with
  | acc, (Paction _ act) => free_action acc act

partial def free_expr { a b c : Type } [SetType a] (acc : Pset a) (g : generic_expr c b a) :
    Pset a :=
  match acc, g with
  | acc, (Expr _ e) =>
    (match e with
     | Epure pe => free_pexpr acc pe
     | Ememop _ pes => List.foldl (@free_pexpr a b _) acc pes
     | Eaction pact => free_paction acc pact
     | Ecase pe pat_es =>
       List.foldl
         (fun (acc : Pset a) (p : (generic_pattern a × generic_expr c b a)) =>
           match acc, p with
           | acc, (pat, e) =>
             (setUnionBy (@setElemCompare a _) acc
               ((setDiffBy (@setElemCompare a _) (free_expr setEmpty e)
                 (symbols_in_pattern setEmpty
                   pat)))) /- (free_expr acc e) \ (symbols_in_pattern {} pat) -/)
         (free_pexpr acc pe) pat_es
     | Elet pat pe e =>
       (setUnionBy (@setElemCompare a _) (free_pexpr acc pe)
         ((setDiffBy (@setElemCompare a _) (free_expr setEmpty e)
           (symbols_in_pattern setEmpty
             pat)))) /- (free_expr (free_pexpr acc pe) e) \ (symbols_in_pattern {} pat) -/
     | Eif pe1 e2 e3 => free_expr (free_expr (free_pexpr acc pe1) e2) e3
     | Eccall _ pe1 pe2 pes =>
       List.foldl (@free_pexpr a b _) (free_pexpr (free_pexpr acc pe1) pe2) pes
     | Eproc _ _ pes => List.foldl (@free_pexpr a b _) acc pes
     | Eunseq es => List.foldl (@free_expr a b c _) acc es
     | Ewseq pat e1 e2 =>
       (setUnionBy (@setElemCompare a _) ((free_expr acc e1))
         ((setDiffBy (@setElemCompare a _) (free_expr setEmpty e2)
           (symbols_in_pattern setEmpty
             pat)))) /- (free_expr (free_expr acc e1) e2) \ (symbols_in_pattern {} pat) -/
     | Esseq pat e1 e2 =>
       (setUnionBy (@setElemCompare a _) ((free_expr acc e1))
         ((setDiffBy (@setElemCompare a _) (free_expr setEmpty e2)
           (symbols_in_pattern setEmpty
             pat)))) /- (free_expr (free_expr acc e1) e2) \ (symbols_in_pattern {} pat) -/
     | Ebound e => free_expr acc e
     | End es => List.foldl (@free_expr a b c _) acc es
     | Esave _ _ _ => /- globals should not depend on Esave -/
       (failwithI ("TODO: free_expr Esave") : Pset a)
     | Erun _ _ _ => /- globals should not depend on Erun -/
       (failwithI ("TODO: free_expr Erun") : Pset a)
     | Epar es => List.foldl (@free_expr a b c _) acc es
     | Ewait _ => /- globals should not depend on Ewait -/
       (failwithI ("TODO: free_expr Ewait") : Pset a)
     | Eannot _ e => free_expr acc e
     | Eexcluded _ act => free_action acc act)

def free { a b : Type } (acc : Pset sym) : generic_globs a b → Pset sym :=
  fun (x : generic_globs a b) =>
    match x with
    | GlobalDef _ e => free_expr acc e
    | GlobalDecl _ => acc

def empty_dep (map1 : List (sym × Pset sym)) : Pset sym :=
  (setFromListBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
    (List.map Prod.fst
      (List.filter
        (fun (p : (sym × Pset sym)) =>
          match p with
          | (_, edges) => setIsEmpty edges) map1)))
/- Topological order of globals -/

partial def topo_order (l : List sym) (s : Pset sym) (g : List (sym × Pset sym)) : List sym :=
  lem_if setIsEmpty s then
    l
  else
    (let n := setChoose setElemCompare s;
     let g :=
       List.map
         (fun (p : (sym × Pset sym)) =>
           match p with
           | (m, edges) =>
             (m,
               (setDiffBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) edges
                 (setFromListBy setElemCompare [n]))))
         (List.filter
           (fun (p : (sym × Pset sym)) =>
             match p with
             | (n', _) =>
               not
                 (match n, n' with
                  | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                    (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                      lem_if natGteb 0 5 && (sd1 != sd2) then
                        (lemSeq
                          (fun _ =>
                            CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                              match u with
                              | () =>
                                String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                  (String.append (show_symbol_description sd1)
                                    (String.append " <-> " (show_symbol_description sd2)))))
                          (fun _ => true))
                      else
                        true
                    else
                      false))) g);
     let s' := empty_dep g;
     topo_order (n :: l)
       ((setUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
         ((setDiffBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) s
           (setFromListBy setElemCompare [n]))) s')) g)

def merge_globs { a b : Type } (gs1 : List (sym × generic_globs b a))
    (gs2 : List (sym × generic_globs b a)) (def_tents : List (sym × sym)) :
    List (sym × generic_globs b a) :=
  let gs := gs1 ++ gs2;
  /- create an associate list of the dependencies for each global -/
  let dep_map :=
    List.map
      (fun (p : (sym × generic_globs b a)) =>
        match p with
        | (sym1, g) =>
          (let acc :=
             List.map Prod.snd
               (List.filter
                 (fun (p : (sym × sym)) =>
                   match p with
                   | (def1, _) =>
                     (match def1, sym1 with
                      | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                        (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                          lem_if natGteb 0 5 && (sd1 != sd2) then
                            (lemSeq
                              (fun _ =>
                                CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                  match u with
                                  | () =>
                                    String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                      (String.append (show_symbol_description sd1)
                                        (String.append " <-> " (show_symbol_description sd2)))))
                              (fun _ => true))
                          else
                            true
                        else
                          false))) def_tents);
           (sym1,
             free ((setFromListBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) acc)) g)))
      gs;
  let init_set := empty_dep dep_map;
  let ordered_syms := topo_order ([] : List sym) init_set dep_map;
  /- reorder gs according to ordered_syms -/
  let gs_map :=
    List.foldl
      (fun (acc : Fmap sym (generic_globs b a)) (p : (sym × generic_globs b a)) =>
        match acc, p with
        | acc, (s, g) => (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) s g acc))
      fmapEmpty gs;
  let ordered_gs :=
    List.map
      (fun (k : sym) =>
        match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) k gs_map) with
        | some g => (k, g)
        | none => (failwithI "merge_globs" : (sym × generic_globs b a))) ordered_syms;
  /- remove reduntant tentative definitions -/ List.foldl
    (fun (acc : List (sym × generic_globs b a)) (g : sym) => CerbUtils.list_remove_assoc g acc)
    (List.reverse ordered_gs) (List.map Prod.fst def_tents)

def safe_map_union { a b : Type } [MapKeyType b] [SetType b] (m1 : Fmap b a) (m2 : Fmap b a) :
    Fmap b a :=
  lem_if setIsEmpty
      ((setInterBy (@setElemCompare b _) ((fmapDomainBy (@setElemCompare b _) m1))
        ((fmapDomainBy (@setElemCompare b _) m2)))) then
    fmapUnionBy (@mapKeyCompare b _) m1 m2
  else
    (failwithI "safe_map_union: maps are not disjoint" : Fmap b a)
def link_aux { a b : Type } (f1 : generic_file a b) (f2 : generic_file a b) :
    exceptM (generic_file a b) (CerbLocation.Loc × cause) :=
  lem_if f1.calling_convention0 != f2.calling_convention0 then
    link_fail CerbLocation.unknown IncompatibleCallingConvention
  else
    except_bind (link_extern f2.extern f1.extern)
      (fun (p : (Fmap identifier (List sym × linking_kind) × List (sym × sym))) =>
        match p with
        | (extern1, reduntant_globs) =>
          except_bind (link_main f1.main f2.main) (fun (main1 : Option sym) =>
            except_return
              (({ main := main1,
                  calling_convention0 := f1.calling_convention0,
                  tagDefs :=
                    (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) f1.tagDefs
                      f2.tagDefs),
                  enumDefs :=
                    (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) f1.enumDefs
                      f2.enumDefs),
                  stdlib := f1.stdlib,
                  impl0 := f1.impl0,
                  globs := (merge_globs f1.globs f2.globs reduntant_globs),
                  funs :=
                    (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) f1.funs
                      f2.funs),
                  extern := extern1,
                  funinfo :=
                    (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) f1.funinfo
                      f2.funinfo),
                  loop_attributes1 :=
                    (fmapUnionBy defaultCompare f1.loop_attributes1 f2.loop_attributes1),
                  visible_objects_env0 :=
                    (/- safe_mergef_visible_objects_env  -/ safe_map_union f1.visible_objects_env0
                      f2.visible_objects_env0) } : generic_file a b))))
def link { a b : Type } :
    List (generic_file a b) → exceptM (generic_file a b) (CerbLocation.Loc × cause) :=
  fun (x : List (generic_file a b)) =>
    match x with
    | [] =>
      (failwithI "linking: no core files" : exceptM (generic_file a b) (CerbLocation.Loc × cause))
    | f :: fs =>
      List.foldl
        (fun (m_acc : exceptM (generic_file a b) (CerbLocation.Loc × cause))
          (f : generic_file a b) =>
          except_bind m_acc (link_aux f)) (except_return f) fs

