  Lem_Map_extra.fold
    (fun (i : identifier) (p : (List sym × linking_kind)) (acc : Fmap sym sym) =>
      match i, p, acc with
      | _, (decls1, lk1), acc =>
        (match lk1 with
         | LK_none => acc
         | LK_tentative def1 =>
           List.foldl
             (fun (acc : Fmap sym sym) (decl : sym) =>
               (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) decl def1 acc)) acc
             decls1
         | LK_normal def1 =>
           List.foldl
             (fun (acc : Fmap sym sym) (decl : sym) =>
               (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) decl def1 acc)) acc
             decls1)) core_file1.extern fmapEmpty
