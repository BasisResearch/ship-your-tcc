  ((Symbol CerberusFresh.Digest.digest _lemSupplyV0 (SD_ObjectAddress name1)), _lemSupplyS1)

def fresh_funarg [CerberusFresh.Digest] (_lemSupply_fresh_int : Nat) (loc1 : CerbLocation.Loc)
    (i : Nat) :
