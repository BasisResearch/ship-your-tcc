def from_same_translation_unit (sym1 : sym) (sym2 : sym) : Bool :=
  (0 : Int) == CerberusFresh.digest_compare (digest_of_sym sym1) (digest_of_sym sym2)

def symbol_description0 (s : sym) : symbol_description :=
  match s with
  | (Symbol _ _ descr) => descr
def symbol_num (s : sym) : Nat :=
  match s with
  | (Symbol _ num _) => num
