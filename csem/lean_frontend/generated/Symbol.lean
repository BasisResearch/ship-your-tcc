  (Symbol CerberusFresh.Digest.digest id1 (SD_Id (mkStr id1)), _lemSupplyS1)
/- C1: eta-expanded (was `function`-sugar, a lambda — the supply
   transform's G-lambda guard rejects draws under lambdas) -/
def fresh_fancy [CerberusFresh.Digest] (_lemSupply_fresh_int : Nat) (str_opt : Option String) :
    (sym × Nat) :=
  let (_lemSupplyV4, _lemSupplyS5) :=
    (match str_opt with
     | some str =>
       (let (_lemSupplyV0, _lemSupplyS1) := (fresh_pretty _lemSupply_fresh_int str);
        (_lemSupplyV0, _lemSupplyS1))
     | none =>
       (let (_lemSupplyV2, _lemSupplyS3) := (fresh _lemSupply_fresh_int ());
        (_lemSupplyV2, _lemSupplyS3)));
  (_lemSupplyV4, _lemSupplyS5)
/- Build a symbol from an EXPLICITLY SUPPLIED id (arc-2 S1): the pure
   counterpart of fresh, for callers that thread their own supply (see
   core_run_state.sym_supply). -/

def fresh_given_int (d : String) (n : Nat) : sym := Symbol d n SD_None

