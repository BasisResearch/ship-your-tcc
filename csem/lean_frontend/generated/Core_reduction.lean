                   (stExceptUndef_bind (full_eval_pexpr' pe) (fun (x : value) =>
                     match x with
                     | Vloaded (LVspecified (OVpointer pv)) =>
                       stExceptUndef_bind (stExceptUndef_mapM full_eval_pexpr' pes)
