                 /- This step places waiting constructs in the arena and asks the
                 driver to spawn new threads -/
                 /- reduction: SPAWN -/ Step_spawn_threads2
                   (fun (tids : List Nat) => wrap_expr (mk_unseq_e (List.map mk_wait_e tids)))
                   (List.map
                     (fun (e : generic_expr core_run_annotation Unit sym) =>
                       (({ arena := e,
                           stack0 := Stack_empty,
                           errno := (CerbMem.nullPtrval signed_int),
                           current_loc := th_st.current_loc,
                           exec_loc := (ELoc_normal ([] : List (sym × CerbLocation.Loc))),
                           env := th_st.env,
                           current_proc_opt := none } : thread_state))) es)
               | Ewait _ => Step_blocked2
               | _ =>
                 (match one_step0 eval_pexpr1 full_eval_pexpr' th_st.env expr1 with
                  | none =>
                    (failwithI (String.append "STUCK ==> " (CerbPP.stringFromCore_expr expr1)) :
                      core_step2)
                  | some (TAU_WITH_RUNSTATE debug_str step_m) =>
                    Step_with_runstate2 (RSK_tau debug_str TSK_Misc)
                      (stExceptUndef_bind step_m
                        (fun (p :
                          (List (Fmap sym value) × generic_expr core_run_annotation Unit sym)) =>
                          match p with
                          | (env', expr') =>
                            stExceptUndef_return
                              { { th_st with env := env' } with arena := apply_ctx ctx expr' }))
                  | some (TAU debug_str env' expr') =>
                    Step_tau2 debug_str TSK_Misc
                      { { th_st with env := env' } with arena := apply_ctx ctx expr' }
                  | some (EVAL debug_str eval_m) =>
                    Step_with_runstate2 (RSK_eval debug_str)
                      (stExceptUndef_bind eval_m
                        (fun (expr' : generic_expr core_run_annotation Unit sym) =>
                          stExceptUndef_return (wrap_expr expr')))
                  | some (ND0 es) => Step_nd2 (List.map wrap_expr es)
                  | some (MEMOP memop1 cvals) => /- reduction: MEMOP -/
                    Step_memop_request2 th_st.current_loc memop1 cvals current_tid
                      (is_unseq_with_ccall ctx)
                      (fun (cval : value) => wrap_expr (mk_pure_e (mk_value_pe cval)))
                  | some UNSEQUENCED_RACE => /- TODO: loc -/
                    Step_with_runstate2 (RSK_eval "unsequenced race")
                      (stExceptUndef_undef th_st.current_loc [UB035_unsequenced_race])
                  | some (ILLTYPED str) => Step_error2 str)))) (get_ctx th_st.arena))
