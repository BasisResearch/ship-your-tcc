  | .Step_fs2 x1 x2 x3, .Step_fs2 y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => lemFunctionalCompare x3 y3))
  | .Step_nd2 x1, .Step_nd2 y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (core_step2.ctor_rank_ocaml xg) (core_step2.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq core_step2 where
  beq := core_step2.beq_derived
instance : Ord core_step2 where
  compare := core_step2.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType core_step2 where
  setElemCompare x y :=
    match core_step2.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 core_step2 where
  isEqual := core_step2.beq_derived
  isInequal x y := !(core_step2.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 core_step2 where
  compare x y :=
    match core_step2.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match core_step2.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match core_step2.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match core_step2.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match core_step2.compare_derived x y with
    | .lt => false
    | _ => true

/- Lean: core_step2 carries core_runM continuations and closure-carrying
   thread_states, so the auto-generated BEq/Ord/... instances are
   sorry-fallbacks (priority := low); the BEq one fired at runtime (arc-4
   S0: first crash for 77/105 tests/minimal). Hand-written
   OCaml-polymorphic-equality-parity instances live in
   lean_frontend/CerbStepInstances.lean, imported via driver.lem (the only
   use site); they override the low-priority fallbacks there.
   NOTE (arc-4 S1a): `declare {lean} skip_instances type core_step2` is NOT
   usable here -- it also suppresses the needed Inhabited instance, which
   this module itself requires (failwithI sites) and which a downstream
   hand-written file cannot provide (import cycle). -/

instance : Show core_step2 where

    show0 step :=
      match step with
      | Step_ccall2 _ _ => "Step_ccall2"
      | Step_with_runstate2 kind1 _ =>
        (let kind_str :=
           match kind1 with
           | RSK_eval debug_str => String.append "RSK_eval[" (String.append debug_str "]")
           | RSK_tau debug_str kind' =>
             (let kind'_str :=
                match kind' with
                | TSK_Ccall sym1 _ =>
                  String.append "TSK_Ccall(" (String.append (show_symbol sym1) ")")
                | TSK_Return sym1 _ =>
                  String.append "TSK_Return(" (String.append (show_symbol sym1) ")")
                | TSK_Misc => "TSK_Misc";
              String.append "RSK_tau["
                (String.append debug_str (String.append ", " (String.append kind'_str "]"))));
         String.append "Step_with_runstate2[" (String.append kind_str "]"))
      | Step_tau2 debug_str kind1 _ => String.append "Step_tau2<TAU>[" (String.append debug_str "]")
      | Step_action_request2 debug_str loc1 tid1 is_unseq_with_ccall1 _ =>
        String.append "Step_action_request2["
          (String.append debug_str
            (String.append "] -- tid: "
              (String.append (Lem_String_extra.stringFromNat tid1)
                (String.append (lem_if is_unseq_with_ccall1 then " [unseq_with_call]" else "")
                  (String.append " -- at loc: " (CerbLocation.stringFromLocation loc1))))))
      | Step_blocked2 => "Step_blocked2"
      | Step_error2 debug_str => String.append "Step_error2[" (String.append debug_str "]")
      | Step_thread_done2 tid1 cval =>
        String.append "Step_thread_done2(tid: "
          (String.append (Lem_String_extra.stringFromNat tid1)
            (String.append ") -- value: " (CerbPP.stringFromCore_value cval)))
      | Step_done2 cval => String.append "Step_done2 -- value: " (CerbPP.stringFromCore_value cval)
      | Step_memop_request2 loc1 memop1 _ tid1 is_unseq_with_ccall1 _ =>
        String.append "Step_memop_request2["
          (String.append
            ((fun x =>
              match x with
              | PtrEq => "ptreq"
              | PtrNe => "ptrne"
              | PtrLt => "ptrlt"
              | PtrGt => "ptrgt"
              | PtrLe => "ptrle"
              | PtrGe => "ptrge"
              | Ptrdiff => "ptrdiff"
              | IntFromPtr => "intfromptr"
              | PtrFromInt => "ptrfromint"
              | PtrValidForDeref => "ptrvalidforderef"
              | PtrWellAligned => "ptrwellaligned"
              | Memcpy => "memcpy"
              | Memcmp => "memcmp"
              | Realloc => "realloc"
              | PtrArrayShift => "ptrarrayshift"
              | PtrMemberShift tag_sym membr_ident =>
                String.append "ptrmembershift["
                  (String.append (show_symbol tag_sym)
                    (String.append ", "
                      (String.append
                        (match membr_ident with
                         | Identifier _ str => str) "]")))
              | Va_start => "va_start"
              | Va_copy => "va_copy"
              | Va_arg => "va_arg"
              | Va_end => "va_end"
              | Copy_alloc_id => "copy_alloc_id"
              | CHERI_intrinsic str _ => String.append "cheri_" str) memop1)
            (String.append "] -- tid: "
              (String.append (Lem_String_extra.stringFromNat tid1)
                (String.append (lem_if is_unseq_with_ccall1 then " [unseq_with_call]" else "")
                  (String.append " -- at loc: " (CerbLocation.stringFromLocation loc1))))))
      | Step_spawn_threads2 _ _ => "Step_spawn_threads2"
      | Step_fs2 tid1 _ _ => String.append "Step_fs2 -- tid: " (Lem_String_extra.stringFromNat tid1)
      | Step_nd2 _ => "Step_nd2"

