                                                 th_st.exec_loc } with
                                             stack0 := Stack_cons2 th_st.current_proc_opt ctx
                                               th_st.stack0 } with
                                           arena := expr1 });
                           CerbMem.casePtrval pv
                             (fun (_ : ctype) =>
