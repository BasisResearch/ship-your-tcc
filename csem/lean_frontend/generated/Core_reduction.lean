def is_irreducible { a b c : Type } : generic_expr c b a → Bool :=
  fun (x : generic_expr c b a) =>
    match x with
    /- annot(..., annot(..., _)) ==> NOTE THE _ may be a value -/
    | Expr _
      (Eannot _
        (Expr _
          (Eannot _
            (Expr _
              (Epure
                (Pexpr _ _
                  (PEval
                    _))))))) => /- TODO: this makes the function misnamed, but this has a one step reduction -/
      false
    /- v -/
    | Expr _ (Epure (Pexpr _ _ (PEval _))) => true
    /- annot(..., v) -/
    | Expr _ (Eannot _ (Expr _ (Epure (Pexpr _ _ (PEval _))))) => true
    | _ => false

def do_race (xs1 : List dyn_annotation) (xs2 : List dyn_annotation) : Bool :=
  List.any xs1 (fun (x : dyn_annotation) =>
    match x with
    | DA_neg id1 exclusion1 fp1 =>
      List.any xs2 (fun (x : dyn_annotation) =>
        match x with
        | DA_neg id2 exclusion2 fp2 =>
          (lem_if Lem_List.elem id1 exclusion2 || Lem_List.elem id2 exclusion1 then
            false
          else
            CerbMem.overlapping fp1 fp2)
        | DA_pos exclusion2 fp2 =>
          (lem_if Lem_List.elem id1 exclusion2 then false else CerbMem.overlapping fp1 fp2))
    | DA_pos exclusion1 fp1 =>
      List.any xs2 (fun (x : dyn_annotation) =>
        match x with
        | DA_neg id2 _ fp2 =>
          (lem_if Lem_List.elem id2 exclusion1 then false else CerbMem.overlapping fp1 fp2)
        | DA_pos _ fp2 => CerbMem.overlapping fp1 fp2))
def combine_dyn_annotations (xs1 : List dyn_annotation) (xs2 : List dyn_annotation) :
    List dyn_annotation :=
  xs1 ++ xs2

inductive one_step : Type where
  | TAU_WITH_RUNSTATE :
      String → core_runM (List (Fmap sym value) × expr core_run_annotation) → one_step
  | TAU : String → List (Fmap sym value) → expr core_run_annotation → one_step
  | EVAL : String → core_runM (expr core_run_annotation) → one_step
  | ND0 : List (expr core_run_annotation) → one_step
  | MEMOP : memop → List value → one_step
  | UNSEQUENCED_RACE : one_step
  | ILLTYPED : String → one_step
export one_step (TAU_WITH_RUNSTATE TAU EVAL ND0 MEMOP UNSEQUENCED_RACE ILLTYPED)
instance : Inhabited one_step where
  default := UNSEQUENCED_RACE
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def one_step.ctor_rank_ocaml : one_step → Nat
  | .TAU_WITH_RUNSTATE _ _ => 1
  | .TAU _ _ _ => 2
  | .EVAL _ _ => 3
  | .ND0 _ => 4
  | .MEMOP _ _ => 5
  | .UNSEQUENCED_RACE => 0
  | .ILLTYPED _ => 6
mutual
def one_step.beq_derived (cmpx_ cmpy_ : one_step) : Bool :=
  match cmpx_, cmpy_ with
  | .TAU_WITH_RUNSTATE x1 x2, .TAU_WITH_RUNSTATE y1 y2 => x1 == y1 && lemFunctionalBeq x2 y2
  | .TAU x1 x2 x3, .TAU y1 y2 y3 => x1 == y1 && x2 == y2 && x3 == y3
  | .EVAL x1 x2, .EVAL y1 y2 => x1 == y1 && lemFunctionalBeq x2 y2
  | .ND0 x1, .ND0 y1 => x1 == y1
  | .MEMOP x1 x2, .MEMOP y1 y2 => x1 == y1 && x2 == y2
  | .UNSEQUENCED_RACE, .UNSEQUENCED_RACE => true
  | .ILLTYPED x1, .ILLTYPED y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def one_step.compare_derived (cmpx_ cmpy_ : one_step) : Ordering :=
  match cmpx_, cmpy_ with
  | .TAU_WITH_RUNSTATE x1 x2, .TAU_WITH_RUNSTATE y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .TAU x1 x2 x3, .TAU y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .EVAL x1 x2, .EVAL y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .ND0 x1, .ND0 y1 => Ord.compare x1 y1
  | .MEMOP x1 x2, .MEMOP y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .ILLTYPED x1, .ILLTYPED y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (one_step.ctor_rank_ocaml xg) (one_step.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq one_step where
  beq := one_step.beq_derived
instance : Ord one_step where
  compare := one_step.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType one_step where
  setElemCompare x y :=
    match one_step.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 one_step where
  isEqual := one_step.beq_derived
  isInequal x y := !(one_step.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 one_step where
  compare x y :=
    match one_step.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match one_step.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match one_step.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match one_step.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match one_step.compare_derived x y with
    | .lt => false
    | _ => true

def one_step_unseq_aux_lemFuel { a b : Type } (lemFuel : Nat)
    (p : (List dyn_annotation × List value)) (lemTail : List (generic_expr b a sym)) :
    Option (List dyn_annotation × List value) :=
  match lemFuel with
  | 0 => ((fuelExhausted (fun _ => none)) lemTail)
  | Nat.succ lemFuel =>
    (match p with
     | (fps_acc, cvals_acc) =>
       (match lemTail with
        | [] => some (fps_acc, List.reverse cvals_acc)
        | Expr _ (Epure (Pexpr _ _ (PEval cval))) :: xs =>
          (one_step_unseq_aux_lemFuel lemFuel) (fps_acc, (cval :: cvals_acc)) xs
        | Expr _ (Eannot fps (Expr _ (Epure (Pexpr _ _ (PEval cval))))) :: xs =>
          (lem_if do_race fps fps_acc then
            (lemSeq
              (fun _ =>
                CerbDebug.print_debug_pure 2 [DB_core_dynamics] (fun (u : Unit) =>
                  match u with
                  | () =>
                    String.append "FOUND AN UNSEQUENCED RACE: "
                      (String.append
                        (stringFromList
                          (fun (dannot : dyn_annotation)=>
                            match dannot with
                            | DA_neg n excl fp =>
                              String.append "DA_neg("
                                (String.append (Lem_String_extra.stringFromNat n)
                                  (String.append ", "
                                    (String.append
                                      (stringFromList Lem_String_extra.stringFromNat excl) ")")))
                            | DA_pos excl fp =>
                              String.append "DA_pos("
                                (String.append (stringFromList Lem_String_extra.stringFromNat excl)
                                  ")")) fps)
                        (String.append " <---> "
                          (stringFromList
                            (fun (dannot : dyn_annotation)=>
                              match dannot with
                              | DA_neg n excl fp =>
                                String.append "DA_neg("
                                  (String.append (Lem_String_extra.stringFromNat n)
                                    (String.append ", "
                                      (String.append
                                        (stringFromList Lem_String_extra.stringFromNat excl) ")")))
                              | DA_pos excl fp =>
                                String.append "DA_pos("
                                  (String.append
                                    (stringFromList Lem_String_extra.stringFromNat excl) ")"))
                            fps_acc)))))
              (fun _ => /- we found an unsequenced race (undefined behaviour) -/ none))
          else
            (one_step_unseq_aux_lemFuel lemFuel)
              (combine_dyn_annotations fps fps_acc, (cval :: cvals_acc)) xs)
        | e :: _ => /- all the operand of the unseq() must have already been reduced to values -/
          (failwithI
            (String.append "Core_reduction.one_step_unseq_aux ==> "
              (CerbPP.stringFromCore_expr e)) : Option (List dyn_annotation × List value))))

def one_step_unseq_aux { a b : Type } (p : (List dyn_annotation × List value))
    (lemTail : List (generic_expr b a sym)) :
    Option (List dyn_annotation × List value) :=
  one_step_unseq_aux_lemFuel (List.length lemTail + 1) p lemTail
theorem one_step_unseq_aux_lemFuel_zero { a b : Type } (p : (List dyn_annotation × List value))
    (lemTail : List (generic_expr b a sym)) :
    one_step_unseq_aux_lemFuel 0 p lemTail = ((fuelExhausted (fun _ => none)) lemTail) :=
  rfl

/- Effectless reductions ************************************************************************ -/
/- NOTE: for performance, we use scoped environment instead of substitutions for bound variables -/

def one_step0
    (eval_pexpr1 : generic_pexpr Unit sym → stExceptUndefM (generic_pexpr Unit sym) core_run_state
      core_run_cause)
    (full_eval_pexpr1 : generic_pexpr Unit sym → core_run_state → exceptM
      (t0 value × core_run_state) core_run_cause) (env1 : List (Fmap sym value))
    (g : generic_expr core_run_annotation Unit sym) :
    Option one_step :=
  match eval_pexpr1, full_eval_pexpr1, env1, g with
  | eval_pexpr1, full_eval_pexpr1, env1, expr1@(Expr annots1 expr_) =>
    (lem_if is_irreducible expr1 then
      none
    else
      match expr_ with
      | Epure pe =>
        (match valueFromPexpr pe with
         | some _ => none
         | none => /- reduction: PURE + PURE-UNDEF -/
           some
             (/-     eval e = v
                -------------------
                pure(e) --> pure(v) -/
             EVAL "Epure"
               (stExceptUndef_bind (full_eval_pexpr1 pe) (fun (cval : value) =>
                 stExceptUndef_return (Expr annots1 (Epure (mk_value_pe cval)))))))
      | Eannot xs1
        (Expr annots2
          (Eannot xs2 e)) => /- {A_1} {A_2} E --> {A_1 union A_2} E -/ /- reduction: ANNOTS -/
        some
          (TAU "Eannot" env1
            (Expr (annots1 ++ annots2) (Eannot (combine_dyn_annotations xs1 xs2) e)))
      | Ememop memop1 pes =>
        some
          (match valueFromPexprs pes with
           | some cvals => MEMOP memop1 cvals
           | none =>
             EVAL "Ememop"
               (stExceptUndef_bind (stExceptUndef_mapM eval_pexpr1 pes)
                 (fun (pes' : List (generic_pexpr Unit sym)) =>
                   stExceptUndef_return (Expr annots1 (Ememop memop1 pes')))))
      | Ecase (Pexpr _ () (PEconstrained xs)) _ =>
        (failwithI "TODO: Core_reduction.one_step, Ecase PEconstrained" : Option one_step)
      | Ecase pe pat_es => /- reduction: CASE + CASE-UNDEF -/
        some
          (match valueFromPexpr pe with
           | some cval =>
             (/- TODO: stop using subst? -/
             match select_case subst_sym_expr cval pat_es with
             | some e' => TAU "Ecase" env1 e'
             | none =>
               ILLTYPED (String.append "Ecase, mismatched ==> " (CerbPP.stringFromCore_expr expr1)))
           | none =>
             EVAL "Ecase"
               (stExceptUndef_bind (eval_pexpr1 pe) (fun (pe' : generic_pexpr Unit sym) =>
                 stExceptUndef_return (Expr annots1 (Ecase pe' pat_es)))))
      | Elet pat pe1 e2 =>
        (match valueFromPexpr pe1 with
         | some cval =>
           (/- let pat = v in E2 --> { v / pat } E2 -/
           /- reduction: LET(last step) -/
           /- FORK 2026-09-22 (upstream-tray draft 45; audit R2): Core_reduction is the
                 driver's stepping engine (drive_core_thread2 -> core_step2 -> step_ctx -> one_step);
                 its let-forms bind through update_env, which never consults the matcher. Check
                 that the pattern FITS first and report a non-fitting one (a tuple-arity mismatch
                 in particular) as the SAME Illformed_program the PElet route reports
                 (core_eval.lem select_case), through the same monadic channel — so the default
                 path and --rewrite (which turns this Elet into that PElet) agree. update_env's own
                 guard, tuple_arity_error, stays the loud backstop. -/
           match match_pattern pat cval with
           | none =>
             some
               (TAU_WITH_RUNSTATE "Elet"
                 (runEU
                   (exception_undef_fail (Illformed_program "Elet: the pattern didn't match pe1"))))
           | some _ => some (TAU "Elet" (update_env pat cval env1) e2))
         | none =>
           some
             (/-              eval e1 = v
                 -------------------------------------
                 let pat = e1 in E2 --> { v / pat } E2 -/
             /- reduction: LET(first step) + LET-UNDEF -/ TAU_WITH_RUNSTATE "Elet"
               (stExceptUndef_bind (full_eval_pexpr1 pe1)
                 (fun (cval :
                   value) => /- FORK 2026-09-22 (audit R2): the pattern must fit — see the value case above -/
                   match match_pattern pat cval with
                   | none =>
                     runEU
                       (exception_undef_fail
                         (Illformed_program "Elet: the pattern didn't match pe1"))
                   | some _ => stExceptUndef_return (update_env pat cval env1, e2)))))
      | Eif pe1 e2 e3 => /- reduction: IF-TRUE + IF-FALSE + IF-UNDEF -/
        some
          (TAU_WITH_RUNSTATE "Eif"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (x : value) =>
              match x with
              | Vtrue => stExceptUndef_return (env1, e2)
              | Vfalse => stExceptUndef_return (env1, e3)
              | _ =>
                (failwithI
                  "TODO(use the core_runM) ILLTYPED, the first operand of an Eif didn't evaluated to a boolean" :
                  core_run_state → exceptM
                  (t0 (List (Fmap sym value) × generic_expr core_run_annotation Unit sym) ×
                    core_run_state) core_run_cause))))
      | Eunseq es =>
        (/- assert: List.all is_irreducible es -/
        match one_step_unseq_aux (([] : List dyn_annotation), ([] : List value)) es with
        | none => /- reduction: UNSEQ-RACE -/ some UNSEQUENCED_RACE
        | some (fps, cvals) =>
          /- unseq({A_1}?v1, ..., {A_n}?vn) -->
                 {A_1 ...union... A_n}(v1, ..., v2)    (in the absence of race) -/
          /- reduction: UNSEQ-PURE + UNSEQ-ANNOT -/ some
            (TAU "Eunseq" env1 (Expr annots1 (Eannot fps (mk_value_e (Vtuple cvals))))))
      | Ewseq pat (Expr pe1_annots (Epure pe1)) e2 =>
        some
          (match valueFromPexpr pe1 with
           | some cval =>
             (/- letw pat = v in E2 --> { v / pat } E2 -/
             /- reduction: LETW-PURE -/
             /- FORK 2026-09-22 (audit R2): the pattern must fit — see Elet above -/
             match match_pattern pat cval with
             | none =>
               TAU_WITH_RUNSTATE "Ewseq"
                 (runEU
                   (exception_undef_fail (Illformed_program "Ewseq: the pattern didn't match e1")))
             | some _ => TAU "Ewseq" (update_env pat cval env1) e2)
           | none => (failwithI "Core_reduction.one_step Ewseq saw a non-evaluated e1" : one_step))
      | Ewseq pat (Expr annots11 (Eannot xs (Expr annots2 (Epure pe1)))) e2 =>
        some
          (match valueFromPexpr pe1 with
           | some cval =>
             (/- letw pat = {A}v in E2 --> {A} { v / pat } E2 -/
             /- reduction: LETW-ANNOT -/
             /- FORK 2026-09-22 (audit R2): the pattern must fit — see Elet above -/
             match match_pattern pat cval with
             | none =>
               TAU_WITH_RUNSTATE "Ewseq Eannot"
                 (runEU
                   (exception_undef_fail (Illformed_program "Ewseq: the pattern didn't match e1")))
             | some _ =>
               TAU "Ewseq Eannot" (update_env pat cval env1)
                 (Expr ([] : List annot) (Eannot xs e2)))
           | none =>
             (failwithI "Core_reduction.one_step Ewseq Eannot saw a non-evaluated e1" : one_step))
      | Esseq pat (Expr pe1_annots (Epure pe1)) e2 =>
        some
          (match valueFromPexpr pe1 with
           | some cval =>
             (/- lets pat = v in E2 --> { v / pat } E2 -/
             /- reduction: LETS-PURE -/
             /- FORK 2026-09-22 (audit R2): the pattern must fit — see Elet above -/
             match match_pattern pat cval with
             | none =>
               TAU_WITH_RUNSTATE "Esseq"
                 (runEU
                   (exception_undef_fail (Illformed_program "Esseq: the pattern didn't match e1")))
             | some _ => TAU "Esseq" (update_env pat cval env1) e2)
           | none => (failwithI "Core_reduction.one_step Esseq saw a non-evaluated e1" : one_step))
      | Esseq pat (Expr annots11 (Eannot xs (Expr annots2 (Epure pe1)))) e2 =>
        some
          (match valueFromPexpr pe1 with
           | some cval =>
             (/- lets pat = {A}v in E2 --> {A} { v / pat } E2 -/
             /- reduction: LETS-ANNOT -/
             /- FORK 2026-09-22 (audit R2): the pattern must fit — see Elet above -/
             match match_pattern pat cval with
             | none =>
               TAU_WITH_RUNSTATE "Esseq Eannot"
                 (runEU
                   (exception_undef_fail (Illformed_program "Esseq: the pattern didn't match e1")))
             | some _ =>
               TAU "Esseq Eannot" (update_env pat cval env1)
                 (Expr ([] : List annot) (Eannot xs e2)))
           | none =>
             (failwithI "Core_reduction.one_step Esseq Eannot saw a non-evaluated e1" : one_step))
      | Esave sym_bTy sym_bTy_pes e =>
        some
          (match valueFromPexprs
               (List.map
                 (fun (p :
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   match p with
                   | (_, (_, z)) => z) sym_bTy_pes) with
           | some cvals => /- reduction: SAVE (tau part) -/
             TAU "Esave"
               (List.foldl
                 (fun (acc : List (Fmap sym value))
                   (p :
                     ((sym ×
                       ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                         Unit sym)) × value)) =>
                   match acc, p with
                   | acc, ((sym1, ((bTy, _), _)), cval) =>
                     update_env (mk_sym_pat sym1 bTy) cval acc) env1 (lemListZip sym_bTy_pes cvals))
               e
           | none => /- reduction: SAVE (eval part) + SAVE-UNDEF -/
             EVAL "Esave"
               (stExceptUndef_bind
                 (stExceptUndef_mapM
                   (fun (p :
                     (sym ×
                       ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                         Unit sym))) =>
                     match p with
                     | (sym1, (bTy, pe)) =>
                       stExceptUndef_bind (eval_pexpr1 pe) (fun (pe' : generic_pexpr Unit sym) =>
                         stExceptUndef_return (sym1, (bTy, pe')))) sym_bTy_pes)
                 (fun (sym_bTy_pes' : List
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   stExceptUndef_return (Expr annots1 (Esave sym_bTy sym_bTy_pes' e)))))
      | End es => /- reduction: ND -/ some (ND0 es)
      | _ => none)

def has_ccall_lemFuel { a b c : Type } (lemFuel : Nat) (g : generic_expr c b a) : Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match g with
     | (Expr _ expr_) =>
       (match expr_ with
        | Epure _ => false
        | Ememop _ _ => false
        | Eaction _ => false
        | Ecase _ xs =>
          List.any xs (fun (p : (generic_pattern a × generic_expr c b a)) =>
            match p with
            | (_, e) => (has_ccall_lemFuel lemFuel) e)
        | Elet _ _ e => (has_ccall_lemFuel lemFuel) e
        | Eif _ e1 e2 => (has_ccall_lemFuel lemFuel) e1 || (has_ccall_lemFuel lemFuel) e2
        | Eccall _ _ _ _ => true
        | Eproc _ _ _ => false
        | Eunseq es => List.any es (has_ccall_lemFuel lemFuel)
        | Ewseq _ e1 e2 => (has_ccall_lemFuel lemFuel) e1 || (has_ccall_lemFuel lemFuel) e2
        | Esseq _ e1 e2 => (has_ccall_lemFuel lemFuel) e1 || (has_ccall_lemFuel lemFuel) e2
        | Ebound e =>
          (has_ccall_lemFuel lemFuel)
            e /- NOTE: this function should never see this case (for a C program) -/
        | End es => List.any es (has_ccall_lemFuel lemFuel)
        | Esave _ _ e =>
          (has_ccall_lemFuel lemFuel)
            e /- NOTE: this function should never see this case (for a C program) -/
        | Erun _ _ _ => false /- NOTE: this function should never see this case (for a C program) -/
        | Epar _ => false /- because any ccall is in the body of another thread -/
        | Ewait _ => false
        | Eannot _ e => (has_ccall_lemFuel lemFuel) e
        | Eexcluded _ _ => false))

def has_ccall { a b c : Type } (g : generic_expr c b a) : Bool :=
  has_ccall_lemFuel (generic_expr.lemSize g) g
theorem has_ccall_lemFuel_zero { a b c : Type } (g : generic_expr c b a) :
    has_ccall_lemFuel 0 g = (fuelExhausted false) :=
  rfl

def is_unseq_with_ccall_aux (acc : Bool) : context → Bool :=
  fun (x : context) =>
    match x with
    | CTX => acc
    | Cunseq _ es1 ctx' es2 =>
      (let acc' := acc || List.any (es1 ++ es2) has_ccall;
       is_unseq_with_ccall_aux acc' ctx')
    | Cwseq _ _ ctx' e2 => is_unseq_with_ccall_aux acc ctx'
    | Csseq _ _ ctx' e2 => is_unseq_with_ccall_aux acc ctx'
    | Cannot _ _ ctx' => is_unseq_with_ccall_aux acc ctx'
    | Cbound _ ctx' => is_unseq_with_ccall_aux false ctx'

def is_unseq_with_ccall (ctx : context) : Bool := is_unseq_with_ccall_aux false ctx
mutual
def get_ctx_lemFuel (lemFuel : Nat) (g : generic_expr core_run_annotation Unit sym) :
    List (context × generic_expr core_run_annotation Unit sym) :=
  match lemFuel with
  | 0 => (fuelExhausted [])
  | Nat.succ lemFuel =>
    (match g with
     | expr1@(Expr annot1 expr_) =>
       (lem_if is_irreducible expr1 then
         [(CTX, expr1)]
       else
         match expr_ with
         | Epure _ => [(CTX, expr1)]
         | Ememop _ _ => [(CTX, expr1)]
         | Eaction _ => [(CTX, expr1)]
         | Ecase _ _ => [(CTX, expr1)]
         | Elet _ _ _ => [(CTX, expr1)]
         | Eif _ _ _ => [(CTX, expr1)]
         | Eccall _ _ _ _ => [(CTX, expr1)]
         | Eproc _ _ _ => [(CTX, expr1)]
         | Eunseq es =>
           (lem_if List.all es is_irreducible then
             [(CTX, expr1)]
           else
             (get_ctx_unseq_aux_lemFuel lemFuel) annot1
               ([] : List (context × generic_expr core_run_annotation Unit sym))
               ([] : List (generic_expr core_run_annotation Unit sym)) es)
         | Ewseq pat e1 e2 =>
           (lem_if is_irreducible e1 then
             [(CTX, expr1)]
           else
             List.map
               (fun (p : (context × generic_expr core_run_annotation Unit sym)) =>
                 match p with
                 | (ctx, e) => (Cwseq annot1 pat ctx e2, e)) ((get_ctx_lemFuel lemFuel) e1))
         | Esseq pat e1 e2 =>
           (lem_if is_irreducible e1 then
             [(CTX, expr1)]
           else
             List.map
               (fun (p : (context × generic_expr core_run_annotation Unit sym)) =>
                 match p with
                 | (ctx, e) => (Csseq annot1 pat ctx e2, e)) ((get_ctx_lemFuel lemFuel) e1))
         | Ebound e =>
           (lem_if is_irreducible e then
             [(CTX, expr1)]
           else
             List.map
               (fun (p : (context × generic_expr core_run_annotation Unit sym)) =>
                 match p with
                 | (ctx, e) => (Cbound annot1 ctx, e)) ((get_ctx_lemFuel lemFuel) e))
         | End _ => [(CTX, expr1)]
         | Esave _ _ _ => [(CTX, expr1)]
         | Erun _ _ _ => [(CTX, expr1)]
         | Epar _ => [(CTX, expr1)]
         | Ewait _ => [(CTX, expr1)]
         | Eannot _ (Expr _ (Eannot _ e)) => [(CTX, expr1)]
         | Eannot xs e =>
           List.map
             (fun (p : (context × generic_expr core_run_annotation Unit sym)) =>
               match p with
               | (ctx, e) => (Cannot annot1 xs ctx, e)) ((get_ctx_lemFuel lemFuel) e)
         | Eexcluded _ _ => [(CTX, expr1)]))
def get_ctx_unseq_aux_lemFuel (lemFuel : Nat) (annot1 : List annot)
    (acc : List (context × generic_expr core_run_annotation Unit sym))
    (es1 : List (generic_expr core_run_annotation Unit sym))
    (lemTail : List (generic_expr core_run_annotation Unit sym)) :
    List (context × generic_expr core_run_annotation Unit sym) :=
  match lemFuel with
  | 0 => ((fuelExhausted (fun _ => acc)) lemTail)
  | Nat.succ lemFuel =>
    (match annot1, acc, es1 with
     | annot1, acc, es1 =>
       (match lemTail with
        | [] => acc
        | e :: es2 =>
          (lem_if is_irreducible e then
            (get_ctx_unseq_aux_lemFuel lemFuel) annot1 acc (es1 ++ [e]) es2
          else
            let zs :=
              List.map
                (fun (p : (context × generic_expr core_run_annotation Unit sym)) =>
                  match p with
                  | (ctx, e) => (Cunseq annot1 es1 ctx es2, e)) ((get_ctx_lemFuel lemFuel) e);
            (get_ctx_unseq_aux_lemFuel lemFuel) annot1 (zs ++ acc) (es1 ++ [e]) es2)))
end

def get_ctx (g : generic_expr core_run_annotation Unit sym) :
    List (context × expr core_run_annotation) :=
  get_ctx_lemFuel (CerbCoreMeasure.getCtxBound (Sum.inl g)) g
theorem get_ctx_lemFuel_zero (g : generic_expr core_run_annotation Unit sym) :
    get_ctx_lemFuel 0 g = (fuelExhausted []) :=
  rfl

def get_ctx_unseq_aux (annot1 : List annot)
    (acc : List (context × generic_expr core_run_annotation Unit sym))
    (es1 : List (generic_expr core_run_annotation Unit sym))
    (lemTail : List (generic_expr core_run_annotation Unit sym)) :
    List (context × generic_expr core_run_annotation Unit sym) :=
  get_ctx_unseq_aux_lemFuel (CerbCoreMeasure.getCtxBound (Sum.inr lemTail)) annot1 acc es1 lemTail
theorem get_ctx_unseq_aux_lemFuel_zero (annot1 : List annot)
    (acc : List (context × generic_expr core_run_annotation Unit sym))
    (es1 : List (generic_expr core_run_annotation Unit sym))
    (lemTail : List (generic_expr core_run_annotation Unit sym)) :
    get_ctx_unseq_aux_lemFuel 0 annot1 acc es1 lemTail = ((fuelExhausted (fun _ => acc)) lemTail) :=
  rfl

def apply_ctx (ctx : context) (expr1 : generic_expr core_run_annotation Unit sym) :
    generic_expr core_run_annotation Unit sym :=
  match ctx with
  | CTX => expr1
  | Cunseq annot1 es1 ctx' es2 => Expr annot1 (Eunseq (es1 ++ (apply_ctx ctx' expr1 :: es2)))
  | Cwseq annot1 pat ctx' e2 => Expr annot1 (Ewseq pat (apply_ctx ctx' expr1) e2)
  | Csseq annot1 pat ctx' e2 => Expr annot1 (Esseq pat (apply_ctx ctx' expr1) e2)
  | Cannot annot1 xs ctx' => Expr annot1 (Eannot xs (apply_ctx ctx' expr1))
  | Cbound annot1 ctx' => Expr annot1 (Ebound (apply_ctx ctx' expr1))

def act_valueFromPexpr : generic_pexpr Unit sym → Option value :=
  fun (x : generic_pexpr Unit sym) =>
    match x with
    | Pexpr _ _ (PEconstrained _) =>
      (failwithI "Core_reduction.step_action => PEconstrained" : Option value)
    | z => valueFromPexpr z

inductive action_step : Type where
  | ACTION_REQUEST :
      String → CerbLocation.Loc → action_request2 (expr core_run_annotation) → action_step
  | ACTION_EVAL : String → core_runM (action0 core_run_annotation) → action_step
  | ACTION_ILLTYPED : String → action_step
export action_step (ACTION_REQUEST ACTION_EVAL ACTION_ILLTYPED)
instance : Inhabited action_step where
  default := ACTION_REQUEST default default default
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def action_step.ctor_rank_ocaml : action_step → Nat
  | .ACTION_REQUEST _ _ _ => 0
  | .ACTION_EVAL _ _ => 1
  | .ACTION_ILLTYPED _ => 2
mutual
def action_step.beq_derived (cmpx_ cmpy_ : action_step) : Bool :=
  match cmpx_, cmpy_ with
  | .ACTION_REQUEST x1 x2 x3, .ACTION_REQUEST y1 y2 y3 => x1 == y1 && x2 == y2 && x3 == y3
  | .ACTION_EVAL x1 x2, .ACTION_EVAL y1 y2 => x1 == y1 && lemFunctionalBeq x2 y2
  | .ACTION_ILLTYPED x1, .ACTION_ILLTYPED y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def action_step.compare_derived (cmpx_ cmpy_ : action_step) : Ordering :=
  match cmpx_, cmpy_ with
  | .ACTION_REQUEST x1 x2 x3, .ACTION_REQUEST y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .ACTION_EVAL x1 x2, .ACTION_EVAL y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .ACTION_ILLTYPED x1, .ACTION_ILLTYPED y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (action_step.ctor_rank_ocaml xg) (action_step.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq action_step where
  beq := action_step.beq_derived
instance : Ord action_step where
  compare := action_step.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType action_step where
  setElemCompare x y :=
    match action_step.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 action_step where
  isEqual := action_step.beq_derived
  isInequal x y := !(action_step.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 action_step where
  compare x y :=
    match action_step.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match action_step.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match action_step.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match action_step.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match action_step.compare_derived x y with
    | .lt => false
    | _ => true
def step_action (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (e_annots : List annot)
    (full_eval_pexpr1 : generic_pexpr Unit sym → core_run_state → exceptM
      (t0 value × core_run_state) core_run_cause) (is_excluded : Option Nat)
    (g : generic_action core_run_annotation Unit sym) :
    action_step :=
  match e_annots, full_eval_pexpr1, is_excluded, g with
  | e_annots, full_eval_pexpr1, is_excluded, (Action loc1 act_annots act) =>
    (let wrap : generic_action_ Unit sym → generic_action core_run_annotation Unit sym :=
       (fun (z : generic_action_ Unit sym) => Action loc1 act_annots z);
     match act with
     | Create pe1 pe2 pref =>
       (match act_valueFromPexpr pe1, act_valueFromPexpr pe2 with
        | some (Vobject (OVinteger ival)), some (Vctype ty1) =>
          ACTION_REQUEST "CreateRequest" loc1
            (CreateRequest2 pref ival ty1 (get_with_address e_annots) none
              (fun (aid1 : Nat) (ptrval : CerbMem.PointerValue) =>
                mk_value_e (Vobject (OVpointer ptrval))))
        | some _, some _ => ACTION_ILLTYPED "Create"
        | _, _ =>
          ACTION_EVAL "eval operands of Create"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (cval1 : value) =>
              stExceptUndef_bind (full_eval_pexpr1 pe2) (fun (cval2 : value) =>
                stExceptUndef_return
                  (wrap (Create (mk_value_pe cval1) (mk_value_pe cval2) pref))))))
     | CreateReadOnly pe1 pe2 pe3 pref =>
       (match act_valueFromPexpr pe1, act_valueFromPexpr pe2, act_valueFromPexpr pe3 with
        | some (Vobject (OVinteger ival)), some (Vctype ty1), some cval3 =>
          (match (memValueFromValue _lemReader_enum_definitions _lemReader_tagDefs)
               (Ctype ([] : List annot) (unatomic_ ty1)) cval3 with
           | some mval =>
             ACTION_REQUEST "CreateRequest" loc1
               (CreateRequest2 pref ival ty1 (get_with_address e_annots) (some mval)
                 (fun (aid1 : Nat) (ptrval : CerbMem.PointerValue) =>
                   mk_value_e (Vobject (OVpointer ptrval))))
           | none =>
             ACTION_ILLTYPED
               (String.append (CerbLocation.stringFromLocation loc1)
                 (String.append "the value of a create_readonly("
                   (String.append
                     (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (unatomic_ ty1)))
                     (String.append ") didn't match the lvalue type: "
                       (CerbPP.stringFromCore_value cval3))))))
        | some _, some _, some _ => ACTION_ILLTYPED "CreateReadOnly"
        | _, _, _ =>
          ACTION_EVAL "eval operands of CreateReadOnly"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (cval1 : value) =>
              stExceptUndef_bind (full_eval_pexpr1 pe2) (fun (cval2 : value) =>
                stExceptUndef_bind (full_eval_pexpr1 pe3) (fun (cval3 : value) =>
                  stExceptUndef_return
                    (wrap
                      (CreateReadOnly (mk_value_pe cval1) (mk_value_pe cval2) (mk_value_pe cval3)
                        pref)))))))
     | Store0 is_locking pe1 pe2 (Pexpr _ () (PEconstrained xs3)) mo1 =>
       (failwithI "TODO: Core_reduction.step_action => Store pe1 pe2 PEconstrained" : action_step)
     | Store0 is_locking pe1 pe2 pe3 mo1 =>
       (match act_valueFromPexpr pe1, act_valueFromPexpr pe2, act_valueFromPexpr pe3 with
        | some (Vctype ty1), some (Vobject (OVpointer ptrval)), some cval =>
          (match (memValueFromValue _lemReader_enum_definitions _lemReader_tagDefs)
               (Ctype ([] : List annot) (unatomic_ ty1)) cval with
           | some mval =>
             ACTION_REQUEST "StoreRequest" loc1
               (StoreRequest2 mo1 ty1 is_locking ptrval mval
                 (fun (aid1 : Nat) (fp : CerbMem.Footprint) =>
                   let dyn_annots :=
                     match is_excluded with
                     | none => [DA_pos ([] : List Nat) fp]
                     | some excl_id => [DA_neg excl_id ([] : List Nat) fp];
                   Expr ([] : List annot) (Eannot dyn_annots (mk_value_e Vunit))))
           | none =>
             ACTION_ILLTYPED
               (String.append (CerbLocation.stringFromLocation loc1)
                 (String.append "the value of a store("
                   (String.append
                     (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (unatomic_ ty1)))
                     (String.append ") didn't match the lvalue type: "
                       (CerbPP.stringFromCore_value cval))))))
        | some _, some _, some _ => ACTION_ILLTYPED "Store"
        | _, _, _ =>
          ACTION_EVAL "eval operands of Store"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (cval1 : value) =>
              stExceptUndef_bind (full_eval_pexpr1 pe2) (fun (cval2 : value) =>
                stExceptUndef_bind (full_eval_pexpr1 pe3) (fun (cval3 : value) =>
                  stExceptUndef_return
                    (wrap
                      (Store0 is_locking (mk_value_pe cval1) (mk_value_pe cval2) (mk_value_pe cval3)
                        mo1)))))))
     | Load0 pe1 pe2 mo1 =>
       (match act_valueFromPexpr pe1, act_valueFromPexpr pe2 with
        | some (Vctype ty1), some (Vobject (OVpointer ptrval)) =>
          ACTION_REQUEST "LoadRequest" loc1
            (LoadRequest2 mo1 ty1 ptrval
              (fun (aid1 : Nat) (fp : CerbMem.Footprint) (mval : CerbMem.MemValue) =>
                let dyn_annots :=
                  match is_excluded with
                  | none => [DA_pos ([] : List Nat) fp]
                  | some excl_id => [DA_neg excl_id ([] : List Nat) fp];
                match valueFromMemValue mval with
                | (_, cval) => Expr ([] : List annot) (Eannot dyn_annots (mk_value_e cval))))
        | some _, some _ => ACTION_ILLTYPED "Load"
        | _, _ =>
          ACTION_EVAL "eval operands of Load"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (cval1 : value) =>
              stExceptUndef_bind (full_eval_pexpr1 pe2) (fun (cval2 : value) =>
                stExceptUndef_return (wrap (Load0 (mk_value_pe cval1) (mk_value_pe cval2) mo1))))))
     | SeqRMW _ _ _ _ _ =>
       (failwithI "Core_reduction.step_action ==> SeqRMW" :
         action_step) /- this should not be possible -/
     | Alloc0 pe1 pe2 pref =>
       (match act_valueFromPexpr pe1, act_valueFromPexpr pe2 with
        | some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
          ACTION_REQUEST "AllocRequest" loc1
            (AllocRequest2 pref ival1 ival2 (fun (aid1 : Nat) (ptrval : CerbMem.PointerValue) =>
              mk_value_e (Vobject (OVpointer ptrval))))
        | some _, some _ => ACTION_ILLTYPED "Alloc"
        | _, _ =>
          ACTION_EVAL "eval operands of Alloc"
            (stExceptUndef_bind (full_eval_pexpr1 pe1) (fun (cval1 : value) =>
              stExceptUndef_bind (full_eval_pexpr1 pe2) (fun (cval2 : value) =>
                stExceptUndef_return
                  (wrap (Alloc0 (mk_value_pe cval1) (mk_value_pe cval2) pref))))))
     | Kill kind1 pe =>
       (match act_valueFromPexpr pe with
        | some (Vobject (OVpointer ptrval)) =>
          ACTION_REQUEST "KillRequest" loc1
            (KillRequest2 (is_dynamic kind1) ptrval (fun (aid1 : Nat) => mk_value_e Vunit))
        | some _ => ACTION_ILLTYPED "Kill"
        | none =>
          ACTION_EVAL "eval operand of Kill"
            (stExceptUndef_bind (full_eval_pexpr1 pe) (fun (cval : value) =>
              stExceptUndef_return (wrap (Kill kind1 (mk_value_pe cval))))))
     | RMW0 _ _ _ _ _ _ => (failwithI "TODO[Core_reduction]: RMW" : action_step)
     | Fence0 _ => (failwithI "TODO[Core_reduction]: Fence" : action_step)
     | CompareExchangeStrong _ _ _ _ _ _ =>
       (failwithI "TODO[Core_reduction]: CompareExchangeStrong" : action_step)
     | CompareExchangeWeak _ _ _ _ _ _ =>
       (failwithI "TODO[Core_reduction]: CompareExchangeWeak" : action_step)
     | LinuxFence _ => (failwithI "TODO[Core_reduction]: LinuxFence" : action_step)
     | LinuxLoad _ _ _ => (failwithI "TODO[Core_reduction]: LinuxLoad" : action_step)
     | LinuxStore _ _ _ _ => (failwithI "TODO[Core_reduction]: LinuxStore" : action_step)
     | LinuxRMW _ _ _ _ => (failwithI "TODO[Core_reduction]: LinuxRMW" : action_step))
def break_at_sseq (ctx : context) :
    Option (context × generic_pattern sym × context × generic_expr core_run_annotation Unit sym) :=
  match ctx with
  | CTX => none
  | Cwseq annots1 pat ctx' e2 =>
    (match break_at_sseq ctx' with
     | none => none
     | some (ctxA, sseq_pat, ctxB, sseq_e2) =>
       some (Cwseq annots1 pat ctxA e2, sseq_pat, ctxB, sseq_e2))
  | Csseq annots1 pat ctx' e2 =>
    (match break_at_sseq ctx' with
     | none => some (CTX, pat, ctx', e2)
     | some (in_ctxA, in_pat, in_ctxB, in_e2) =>
       some (Csseq annots1 pat in_ctxA e2, in_pat, in_ctxB, in_e2))
  | Cunseq annots1 es1 ctx' es2 =>
    (match break_at_sseq ctx' with
     | none => none
     | some (ctxA, sseq_pat, ctxB, sseq_e2) =>
       some (Cunseq annots1 es1 ctxA es2, sseq_pat, ctxB, sseq_e2))
  | Cannot annots1 xs ctx' =>
    (match break_at_sseq ctx' with
     | none => none
     | some (ctxA, sseq_pat, ctxB, sseq_e2) =>
       some (Cannot annots1 xs ctxA, sseq_pat, ctxB, sseq_e2))
  | Cbound annots1 ctx' =>
    (failwithI "break_at_sseq, Cbound" : Option
      (context × generic_pattern sym × context × generic_expr core_run_annotation Unit sym))
/-
        match break_at_sseq ctx' with
          | Nothing ->
              Nothing
          | Just (ctxA, sseq_pat, ctxB, sseq_e2) ->
              Just (Cbound annots ctxA, sseq_pat, ctxB, sseq_e2)
        end
-/

inductive break0 : Type where
  | NO_BOUND : break0
  | BOUND_NO_SSEQ : context → context → break0
  | BOUND_WITH_SSEQ : context → context → pattern → context → expr core_run_annotation → break0
  deriving BEq, Ord
export break0 (NO_BOUND BOUND_NO_SSEQ BOUND_WITH_SSEQ)
instance : Inhabited break0 where
  default := NO_BOUND
instance (priority := 500) : Lem_Basic_classes.SetType break0 where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 break0 where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 break0 where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

def break_at_bound_and_sseq (ctx : context) : break0 :=
  match ctx with
  | CTX => NO_BOUND
  | Cwseq annots1 pat ctx' e2 =>
    (match break_at_bound_and_sseq ctx' with
     | NO_BOUND => NO_BOUND
     | BOUND_NO_SSEQ ctxA ctxB => BOUND_NO_SSEQ (Cwseq annots1 pat ctxA e2) ctxB
     | BOUND_WITH_SSEQ ctxA ctxB sseq_pat ctxC e2_sseq =>
       BOUND_WITH_SSEQ (Cwseq annots1 pat ctxA e2) ctxB sseq_pat ctxC e2_sseq)
  | Csseq annots1 pat ctx' e2 =>
    (match break_at_bound_and_sseq ctx' with
     | NO_BOUND => NO_BOUND
     | BOUND_NO_SSEQ ctxA ctxB => BOUND_NO_SSEQ (Csseq annots1 pat ctxA e2) ctxB
     | BOUND_WITH_SSEQ ctxA ctxB sseq_pat ctxC e2_sseq =>
       BOUND_WITH_SSEQ (Csseq annots1 pat ctxA e2) ctxB sseq_pat ctxC e2_sseq)
  | Cunseq annots1 es1 ctx' es2 =>
    (match break_at_bound_and_sseq ctx' with
     | NO_BOUND => NO_BOUND
     | BOUND_NO_SSEQ ctxA ctxB => BOUND_NO_SSEQ (Cunseq annots1 es1 ctxA es2) ctxB
     | BOUND_WITH_SSEQ ctxA ctxB sseq_pat ctxC e2_sseq =>
       BOUND_WITH_SSEQ (Cunseq annots1 es1 ctxA es2) ctxB sseq_pat ctxC e2_sseq)
  | Cannot annots1 xs ctx' =>
    (match break_at_bound_and_sseq ctx' with
     | NO_BOUND => NO_BOUND
     | BOUND_NO_SSEQ ctxA ctxB => BOUND_NO_SSEQ (Cannot annots1 xs ctxA) ctxB
     | BOUND_WITH_SSEQ ctxA ctxB sseq_pat ctxC e2_sseq =>
       BOUND_WITH_SSEQ (Cannot annots1 xs ctxA) ctxB sseq_pat ctxC e2_sseq)
  | Cbound annots1 ctx' =>
    (match break_at_sseq ctx' with
     | none => BOUND_NO_SSEQ (Cbound annots1 CTX) ctx'
     | some (ctxA, sseq_pat, ctxB, sseq_e2) =>
       BOUND_WITH_SSEQ (Cbound annots1 CTX) ctxA sseq_pat ctxB sseq_e2)

def pull_dyn_annotations (z : context) : (List (List dyn_annotation) × context) :=
  match z with
  | CTX => (([] : List (List dyn_annotation)), CTX)
  | Cunseq annots1 es1 ctx es2 =>
    (match pull_dyn_annotations ctx with
     | (acc, ctx') => (acc, Cunseq annots1 es1 ctx' es2))
  | Cwseq annots1 pat ctx e2 =>
    (match pull_dyn_annotations ctx with
     | (acc, ctx') => (acc, Cwseq annots1 pat ctx' e2))
  | Csseq annots1 pat ctx e2 =>
    (match pull_dyn_annotations ctx with
     | (acc, ctx') => (acc, Csseq annots1 pat ctx' e2))
  | Cannot annots1 xs ctx =>
    (match pull_dyn_annotations ctx with
     | (acc, ctx') => ((xs :: acc), ctx'))
  | Cbound annots1 ctx =>
    (match pull_dyn_annotations ctx with
     | (acc, ctx') => (acc, Cbound annots1 ctx'))

def add_exclusion (n : Nat) : context → context :=
  fun (x : context) =>
    match x with
    | CTX => CTX
    | Cunseq annots1 es1 ctx' es2 => Cunseq annots1 es1 (add_exclusion n ctx') es2
    | Cwseq annots1 pat ctx' e2 => Cwseq annots1 pat (add_exclusion n ctx') e2
    | Csseq annots1 pat ctx' e2 => Csseq annots1 pat (add_exclusion n ctx') e2
    | Cannot annots1 xs ctx' =>
      (let xs' :=
         List.map
           (fun (x : dyn_annotation) =>
             match x with
             | DA_neg id1 excl fp => DA_neg id1 (n :: excl) fp
             | DA_pos excl fp => DA_pos (n :: excl) fp) xs;
       Cannot annots1 xs' (add_exclusion n ctx'))
    | Cbound annots1 ctx' => Cbound annots1 (add_exclusion n ctx')

def process_impl_proc { a : Type }
    (full_eval_pexpr1 : generic_pexpr Unit sym → core_run_state → exceptM
      (t0 value × core_run_state) core_run_cause)
    (wrap_proc : List (generic_pexpr Unit sym) → thread_state)
    (wrap_expr : generic_expr a Unit sym → thread_state) (th_st : thread_state)
    (iCst : implementation_constant) (pes : List (generic_pexpr Unit sym)) :
    core_step2 :=
  let forceIntegerFromIntegerValue : String → CerbMem.IntegerValue → Int :=
    (fun (errmsg : String) (ival : CerbMem.IntegerValue) =>
      match integerFromIntegerValue ival with
      | some n => n
      | none => (failwithI errmsg : Int));
  match iCst with
  /- ----------------------------------------------------------- -/
  /- Cerberus headers <any.h> -/
  /- ----------------------------------------------------------- -/
  | BuiltinFunction "any_bounded_int" =>
    (failwithI "TODO Core_reduction ==> any_bounded_int()" : core_step2)
  /- ----------------------------------------------------------- -/
  /- 7.5 Errors <errno.h> -/
  /- ----------------------------------------------------------- -/
  | BuiltinFunction "errno" =>
    (match pes with
     | [] =>
       Step_tau2 "errno" TSK_Misc
         (wrap_expr (mk_pure_e (mk_specified_pe (mk_value_pe (Vobject (OVpointer th_st.errno))))))
     | _ => (failwithI "wrong arguments for __builtin_errno" : core_step2))
  /- ----------------------------------------------------------- -/
  /- 7.22 General utilities <stdlib.h> -/
  /- ----------------------------------------------------------- -/
  | BuiltinFunction "exit" =>
    (/- TODO: it should close all open resources -/
    match pes with
    | [pe] =>
      (match valueFromPexpr pe with
       | some cval => Step_done2 cval
       | none =>
         Step_with_runstate2 (RSK_eval "Eproc exit")
           (stExceptUndef_bind (full_eval_pexpr1 pe) (fun (cval : value) =>
             stExceptUndef_return (wrap_proc [mk_value_pe cval]))))
    | _ =>
      (failwithI
        (String.append "Core_reduction, exit given more than one argument ==> "
          (stringFromList CerbPP.stringFromCore_pexpr pes)) : core_step2))
  /- NOTE: some GCC builtins -/
  | BuiltinFunction "generic_ffs" =>
    Step_with_runstate2 (RSK_tau "Eproc builtin_generic_ffs" TSK_Misc)
      (match pes with
       | [pe] =>
         stExceptUndef_bind (full_eval_pexpr1 pe) (fun (x : value) =>
           match x with
           | Vobject (OVinteger n_ival) =>
             (let n' :=
                CerbUtils.gcc_builtin_generic_ffs
                  (forceIntegerFromIntegerValue "generic_ffs" n_ival);
              stExceptUndef_return (wrap_expr (mk_pure_e (mk_specified_pe (mk_integer_pe n')))))
           | _ =>
             (failwithI "TODO: generic_ffs illtyped" : core_run_state → exceptM
               (t0 thread_state × core_run_state) core_run_cause))
       | _ =>
         (failwithI "TODO: generic_ffs wrong number of args" : core_run_state → exceptM
           (t0 thread_state × core_run_state) core_run_cause))
  | BuiltinFunction "ctz" =>
    Step_with_runstate2 (RSK_tau "Eproc __builtin_ctz" TSK_Misc)
      (match pes with
       | [pe] =>
         stExceptUndef_bind (full_eval_pexpr1 pe) (fun (x : value) =>
           match x with
           | Vobject (OVinteger n_ival) =>
             (let n' := CerbUtils.gcc_builtin_ctz (forceIntegerFromIntegerValue "ctz" n_ival);
              stExceptUndef_return (wrap_expr (mk_pure_e (mk_specified_pe (mk_integer_pe n')))))
           | _ =>
             (failwithI "TODO: ctz illtyped" : core_run_state → exceptM
               (t0 thread_state × core_run_state) core_run_cause))
       | _ =>
         (failwithI "TODO: ctz wrong number of args" : core_run_state → exceptM
           (t0 thread_state × core_run_state) core_run_cause))
  /- TODO: factorise ... -/
  | BuiltinFunction "bswap16" =>
    Step_with_runstate2 (RSK_tau "Eproc __builtin_bswap16" TSK_Misc)
      (match pes with
       | [pe] =>
         stExceptUndef_bind (full_eval_pexpr1 pe) (fun (x : value) =>
           match x with
           | Vobject (OVinteger n_ival) =>
             (let n' :=
                CerbUtils.gcc_builtin_bswap16 (forceIntegerFromIntegerValue "bswap16" n_ival);
              stExceptUndef_return (wrap_expr (mk_pure_e (mk_specified_pe (mk_integer_pe n')))))
           | _ =>
             (failwithI "TODO: bswap16 illtyped" : core_run_state → exceptM
               (t0 thread_state × core_run_state) core_run_cause))
       | _ =>
         (failwithI "TODO: bswap16 wrong number of args" : core_run_state → exceptM
           (t0 thread_state × core_run_state) core_run_cause))
  | BuiltinFunction "bswap32" =>
    Step_with_runstate2 (RSK_tau "Eproc __builtin_bswap32" TSK_Misc)
      (match pes with
       | [pe] =>
         stExceptUndef_bind (full_eval_pexpr1 pe) (fun (x : value) =>
           match x with
           | Vobject (OVinteger n_ival) =>
             (let n' :=
                CerbUtils.gcc_builtin_bswap32 (forceIntegerFromIntegerValue "bswap32" n_ival);
              stExceptUndef_return (wrap_expr (mk_pure_e (mk_specified_pe (mk_integer_pe n')))))
           | _ =>
             (failwithI "TODO: bswap32 illtyped" : core_run_state → exceptM
               (t0 thread_state × core_run_state) core_run_cause))
       | _ =>
         (failwithI "TODO: bswap32 wrong number of args" : core_run_state → exceptM
           (t0 thread_state × core_run_state) core_run_cause))
  | BuiltinFunction "bswap64" =>
    Step_with_runstate2 (RSK_tau "Eproc __builtin_bswap64" TSK_Misc)
      (match pes with
       | [pe] =>
         stExceptUndef_bind (full_eval_pexpr1 pe) (fun (x : value) =>
           match x with
           | Vobject (OVinteger n_ival) =>
             (let n' :=
                CerbUtils.gcc_builtin_bswap64 (forceIntegerFromIntegerValue "bswap64" n_ival);
              stExceptUndef_return (wrap_expr (mk_pure_e (mk_specified_pe (mk_integer_pe n')))))
           | _ =>
             (failwithI "TODO: bswap64 illtyped" : core_run_state → exceptM
               (t0 thread_state × core_run_state) core_run_cause))
       | _ =>
         (failwithI "TODO: bswap64 wrong number of args" : core_run_state → exceptM
           (t0 thread_state × core_run_state) core_run_cause))
  | _ => (failwithI "Core_reduction.process_impl_proc ==> TODO" : core_step2)

def step_ctx [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (mem_st : CerbMem.MemState)
    (file1 : generic_file Unit core_run_annotation) (core_extern1 : Fmap sym sym)
    (current_tid : Nat) (p : (Option Nat × thread_state)) :
    List core_step2 :=
  match mem_st, file1, core_extern1, current_tid, p with
  | mem_st, file1, core_extern1, current_tid, (parent_tid_opt, th_st) =>
    (let eval_pexpr1 : generic_pexpr Unit sym → core_run_state → exceptM
       (t0 (generic_pexpr Unit sym) × core_run_state) core_run_cause :=
       (fun (pe : generic_pexpr Unit sym) =>
         stExceptUndef_bind
           ((eval_pexpr20 _lemReader_enum_definitions _lemReader_tagDefs) th_st core_extern1 mem_st
             file1 pe)
           (fun (x : Sum (generic_pexpr Unit sym) value) =>
             match x with
             | Sum.inl pe' => stExceptUndef_return pe'
             | Sum.inr cval => stExceptUndef_return (mk_value_pe cval)));
     let full_eval_pexpr' : generic_pexpr Unit sym → core_run_state → exceptM
       (t0 value × core_run_state) core_run_cause :=
       (fun (pe : generic_pexpr Unit sym) =>
         (full_eval_pexpr _lemReader_enum_definitions _lemReader_tagDefs) th_st core_extern1 mem_st
           file1 pe);
     List.map
       (fun (x : (context × generic_expr core_run_annotation Unit sym)) =>
         match x with
         | (CTX, Expr e_annots (Epure (Pexpr _ _ (PEval cval)))) =>
           (match th_st.stack0 with
            | Stack_empty =>
              (/- reached the end of the execution of a thread. -/
              match parent_tid_opt with
              | some parent_tid => /- reduction: THREAD-DONE -/ Step_thread_done2 parent_tid cval
              | none => /- this was the startup thread -/ /- reduction: PROGRAM-DONE -/
                Step_done2 cval)
            | Stack_cons2 parent_proc_opt caller_ctx sk' =>
              (/- reached the end of the execution of a procedure. -/
              let tsk :=
                match th_st.current_proc_opt with
                | some psym =>
                  (match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) psym
                       file1.funinfo) with
                   | some (_, _, ret_ty, _, _, _) =>
                     TSK_Return psym
                       ((memValueFromValue _lemReader_enum_definitions _lemReader_tagDefs) ret_ty
                         cval)
                   | none => TSK_Misc)
                | none => TSK_Misc;
              /- reduction: RETURN -/ Step_tau2 "end of procedure" tsk
                (match th_st.env with
                 | [] => (failwithI "end of proc, found an empty Core_run env" : thread_state)
                 | _ :: env' =>
                   { { { { th_st with current_proc_opt := parent_proc_opt } with env := env' } with
                       stack0 := sk' } with
                     arena := apply_ctx caller_ctx (Expr e_annots (Epure (mk_value_pe cval))) }))
            | Stack_cons _ _ _ => (failwithI "Core_reduction ==> Stack_cons" : core_step2))
         | (CTX,
           (Expr _
             (Eannot _
               (expr'@(Expr _
                   (Epure
                     (Pexpr _ _
                       (PEval
                         _)))))))) => /- {A}v -> v   (in empty context) -/ /- reduction: REMOVE-ANNOT -/
           Step_tau2 "CTX, Eannot(value)" TSK_Misc ({ th_st with arena := expr' })
         | (ctx, expr1) =>
           (match expr1 with
            | Expr e_annots expr_ =>
              (let maybe_loc := get_loc e_annots;
               let th_st :=
                 match maybe_loc with
                 | none => th_st
                 | some loc1 =>
                   (lem_if CerbLocation.isLibraryLocation loc1 then
                     th_st
                   else
                     { th_st with current_loc := loc1 });
               let wrap_expr : generic_expr core_run_annotation Unit sym → thread_state :=
                 (fun (z : generic_expr core_run_annotation Unit sym) =>
                   { th_st with arena := apply_ctx ctx z });
               let process_action : Option Nat →
                 (generic_action core_run_annotation Unit sym → generic_expr_ core_run_annotation
                   Unit sym) → generic_action core_run_annotation Unit sym → core_step2 :=
                 (fun (is_excluded : Option Nat)
                   (wrap_act : generic_action core_run_annotation Unit sym → generic_expr_
                     core_run_annotation Unit sym)
                   (z : generic_action core_run_annotation Unit sym) =>
                   match (step_action _lemReader_enum_definitions _lemReader_tagDefs) e_annots
                       full_eval_pexpr' is_excluded z with
                   | ACTION_REQUEST debug_str loc1 _request =>
                     (let loc' :=
                        lem_if CerbLocation.isLibraryLocation loc1 then th_st.current_loc else loc1;
                      Step_action_request2 debug_str loc' current_tid (is_unseq_with_ccall ctx)
                        (stExceptUndef_return
                          (match _request with
                           | CreateRequest2 pref ival ty1 req_addr_opt mval_opt mk_expr' =>
                             CreateRequest2 pref ival ty1 req_addr_opt mval_opt
                               (fun (aid1 : Nat) (ptrval : CerbMem.PointerValue) =>
                                 wrap_expr (mk_expr' aid1 ptrval))
                           | AllocRequest2 pref ival1 ival2 mk_expr' =>
                             AllocRequest2 pref ival1 ival2
                               (fun (aid1 : Nat) (ptrval : CerbMem.PointerValue) =>
                                 wrap_expr (mk_expr' aid1 ptrval))
                           | LoadRequest2 mo1 ty1 ptrval mk_expr' =>
                             LoadRequest2 mo1 ty1 ptrval
                               (fun (aid1 : Nat) (fp : CerbMem.Footprint)
                                 (mval : CerbMem.MemValue) =>
                                 wrap_expr (mk_expr' aid1 fp mval))
                           | StoreRequest2 mk ty1 is_locking ptrval mval mk_expr' =>
                             StoreRequest2 mk ty1 is_locking ptrval mval
                               (fun (aid1 : Nat) (fp : CerbMem.Footprint) =>
                                 wrap_expr (mk_expr' aid1 fp))
                           | KillRequest2 is_dynamic1 ptrval mk_expr' =>
                             KillRequest2 is_dynamic1 ptrval (fun (aid1 : Nat) =>
                               wrap_expr (mk_expr' aid1))
                           | SeqRMWRequest2 _ _ _ _ => /- this is not possible -/
                             (failwithI "Core_reduction step_action returned SeqRMWRequest2" :
                               action_request2 thread_state))))
                   | ACTION_EVAL debug_str eval_m =>
                     Step_with_runstate2 (RSK_eval debug_str)
                       (stExceptUndef_bind eval_m
                         (fun (act' : generic_action core_run_annotation Unit sym) =>
                           stExceptUndef_return (wrap_expr (Expr e_annots (wrap_act act')))))
                   | ACTION_ILLTYPED str => Step_error2 str);
               match expr_ with
               | Epure (Pexpr _ _ (PEval _)) =>
                 (failwithI
                   (String.append "Core_run.step_ctx ==> found a value with ctx <> CTX ==> "
                     (String.append (CerbPP.stringFromCore_expr expr1)
                       (String.append " <--> " (stringFromContext ctx)))) : core_step2)
               | Ebound
                 (Expr _
                   (Eannot _
                     (expr'@(Expr _
                         (Epure
                           (Pexpr _ _
                             (PEval _))))))) => /- bound({A}v)-> v -/ /- reduction: REMOVE-BOUND -/
                 Step_tau2 "CTX, Ebound Eannot(value)" TSK_Misc (wrap_expr expr')
               | Ebound
                 (expr'@(Expr _
                     (Epure
                       (Pexpr _ _ (PEval _))))) => /- bound(v)-> v -/ /- reduction: REMOVE-BOUND -/
                 Step_tau2 "CTX, Ebound(value)" TSK_Misc (wrap_expr expr')
               | Eaction (Paction p (Action loc1 _ (SeqRMW with_forward pe1 pe2 sym1 pe3))) =>
                 (lem_if p == Neg0 then
                   (failwithI
                     "TODO(better typing) negative SeqRMW should be forbidden by the typecheck" :
                     core_step2)
                 else
                   Step_action_request2 "SeqRMW" loc1 current_tid (is_unseq_with_ccall ctx)
                     (stExceptUndef_bind (full_eval_pexpr' pe1) (fun (cval1 : value) =>
                       stExceptUndef_bind (full_eval_pexpr' pe2) (fun (cval2 : value) =>
                         match cval1, cval2 with
                         | Vctype ty1, Vobject (OVpointer ptrval) =>
                           stExceptUndef_bind fresh_excluded_id (fun (n : Nat) =>
                             stExceptUndef_bind
                               /- hoisted from the pure result-callback below (arc-2
                           S1): the callback runs outside the monad, so the
                           fresh symbol is drawn here and captured -/
                               fresh_symbol0
                               (fun (rmw_sym : sym) =>
                                 stExceptUndef_return
                                   (SeqRMWRequest2 ty1 ptrval
                                     (fun (mval : CerbMem.MemValue) =>
                                       let th_st_tmp :=
                                         { th_st with
                                           env :=
                                             match th_st.env with
                                             | [] =>
                                               (failwithI
                                                 "Core_reduction.step_ctx, SeqRMW ==> env is empty" :
                                                 List (Fmap sym value))
                                             | x :: xs =>
                                               (fmapAddBy
                                                 (fun (sym1 : sym) (sym2 : sym)=>
                                                   ordCompare sym1 sym2) sym1
                                                 (Prod.snd (valueFromMemValue mval)) x) :: xs };
                                       stExceptUndef_bind
                                         ((full_eval_pexpr _lemReader_enum_definitions
                                           _lemReader_tagDefs) th_st_tmp core_extern1 mem_st file1
                                           pe3)
                                         (fun (cval3 : value) =>
                                           match (memValueFromValue _lemReader_enum_definitions
                                               _lemReader_tagDefs)
                                               (Ctype ([] : List annot) (unatomic_ ty1)) cval3 with
                                           | some mval' => stExceptUndef_return mval'
                                           | none =>
                                             (failwithI
                                               "TODO(use the error the monad) didn't match the lvalue type in SeqRMW" :
                                               core_run_state → exceptM
                                               (t0 CerbMem.MemValue × core_run_state)
                                               core_run_cause)))
                                     (fun (aid1 : Nat) (fp : CerbMem.Footprint)
                                       (mval : CerbMem.MemValue) (mval' : CerbMem.MemValue) =>
                                       let cval_e :=
                                         mk_value_e
                                           (Prod.snd
                                             (valueFromMemValue
                                               (lem_if with_forward then mval' else mval)));
                                       let mk_annot_e : generic_expr core_run_annotation Unit sym →
                                         generic_expr core_run_annotation Unit sym :=
                                         (fun (z : generic_expr core_run_annotation Unit sym) =>
                                           Expr ([] : List annot)
                                             (Eannot [DA_neg n ([] : List Nat) fp] z));
                                       /- TODO: try to factorize this with the code for negative actions -/
                                       match break_at_bound_and_sseq ctx with
                                       | NO_BOUND =>
                                         (failwithI "TODO: NO_BOUND (SeqRMW)" : thread_state)
                                       | BOUND_NO_SSEQ ctx_bound ctxA =>
                                         (let ctxA' := add_exclusion n ctxA;
                                          let sym1 := rmw_sym;
                                          let expr' :=
                                            mk_wseq_e
                                              (mk_tuple_pat
                                                [mk_empty_pat BTy_unit /- TODO:HACKHACK -/,
                                                  mk_sym_pat sym1 BTy_unit] /- TODO:HACKHACK -/)
                                              (mk_unseq_e
                                                [mk_annot_e (mk_value_e Vunit),
                                                  apply_ctx ctxA' cval_e])
                                              (mk_pure_e (mk_sym_pe sym1));
                                          { th_st with arena := apply_ctx ctx_bound expr' })
                                       | BOUND_WITH_SSEQ ctx_bound ctxA sseq_pat CTX
                                         sseq_e2 => /- TODO: check -/ /- Empty inner context, so no need to pull and annotate for exclusion -/
                                         { th_st with
                                           arena := apply_ctx ctx_bound
                                             (apply_ctx ctxA
                                               (mk_sseq_e sseq_pat (mk_annot_e cval_e) sseq_e2)) }
                                       | BOUND_WITH_SSEQ ctx_bound ctxA sseq_pat ctxB sseq_e2 =>
                                         (let ctxB' := add_exclusion n ctxB;
                                          let expr' :=
                                            mk_sseq_e
                                              (mk_tuple_pat
                                                [mk_empty_pat BTy_unit /- TODO:HACKHACK -/,
                                                  sseq_pat])
                                              (mk_unseq_e
                                                [mk_annot_e (mk_value_e Vunit),
                                                  apply_ctx ctxB' cval_e]) sseq_e2;
                                          { th_st with
                                            arena := apply_ctx ctx_bound
                                              (apply_ctx ctxA expr') })))))
                         | _, _ =>
                           (failwithI "TODO(use the error the monad) illtyped SeqRMW" :
                             core_run_state → exceptM
                             (t0 (action_request2 thread_state) × core_run_state)
                             core_run_cause)))))
               | Eaction (Paction p act) =>
                 (match act with
                  | Action loc1 _ _ =>
                    (/- DEBUG -/
                    match p with
                    | Pos =>
                      process_action none
                        /- not excluded -/ (fun (z : generic_action core_run_annotation Unit sym) =>
                          Eaction (Paction p z)) act
                    | Neg0 =>
                      (match break_at_bound_and_sseq ctx with
                       | NO_BOUND => (failwithI "TODO: NO_BOUND (Neg)" : core_step2)
