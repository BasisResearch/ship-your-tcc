                          lem_if not ((List.length sym_bTys) == (List.length pes)) then
                            runEU
                              (exception_undef_fail
                                (Illformed_program
                                  "Erun: the argument list does not fit the continuation's parameters"))
                          else
                            stExceptUndef_bind
                              (stExceptUndef_foldM
                                (fun (acc : List (Fmap sym value))
                                  (p : ((sym × core_base_type) × generic_pexpr Unit sym)) =>
                                  match acc, p with
                                  | acc, ((sym1, bTy), pe) =>
                                    stExceptUndef_bind (full_eval_pexpr' pe) (fun (cval : value) =>
                                      stExceptUndef_return
                                        (update_env (mk_sym_pat sym1 bTy) cval acc))) th_st.env
                                (lemListZip sym_bTys pes))
                              (fun (env' : List (Fmap sym value)) =>
                                stExceptUndef_return
                                  { { th_st with env := env' } with arena := cont_expr })))))
