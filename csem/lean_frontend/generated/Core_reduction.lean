                            | some proc_sym => proc_sym
                            | none => current_proc;
                          Lem_Maybe.bind0
                            ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
                              proc_sym run_st.labeled))
                            ((fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
                              sym1)))))
                      (fun (x : Option
                        (List (sym × core_base_type) × generic_expr core_run_annotation Unit
                          sym)) =>
                        match x with
                        | none =>
