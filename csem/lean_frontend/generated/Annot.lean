def get_cerb_magic_attr (annots1 : List annot) : List (CerbLocation.Loc × String) :=
  match get_attrs annots1 with
  | none => ([] : List (CerbLocation.Loc × String))
  | some (Attrs attributes2) =>
    List.flatten
      (List.map
        (fun (attr : attribute0) =>
          match attr.attr_ns, attr.attr_id with
          | some (Identifier _loc1 "cerb"), Identifier _loc2 "magic" =>
            List.map
              (fun (p : (CerbLocation.Loc × String × List (CerbLocation.Loc × String))) =>
                match p with
                | (loc1, arg, _) => (loc1, arg)) attr.attr_args
          | _, _ => ([] : List (CerbLocation.Loc × String))) attributes2)

