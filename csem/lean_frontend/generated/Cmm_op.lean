                          (Other "Inconsistent (locks_only_consistent_locks)")))
                    (fun (_ : Unit) =>
                      nd_guard (locks_only_consistent_lo ex)
                        (Other "Inconsistent (locks_only_consistent_lo)")))
                  (fun (_ : Unit) =>
                    nd_guard (sc_accesses_consistent_sc ex)
                      (Other "Inconsistent (sc_accesses_consistent_sc)")))
                (fun (_ : Unit) =>
                  nd_guard (sc_fenced_sc_fences_heeded ex)
                    (Other "Inconsistent (sc_fenced_sc_fences_heeded)")))
              (fun (_ : Unit) =>
                nd_guard (consistent_hb ex) (Other "Inconsistent (consistent_hb)")))
            (fun (_ : Unit) => nd_guard (det_read_alt ex) (Other "Inconsistent (det_read_alt)")))
          (fun (_ : Unit) =>
            nd_guard (consistent_non_atomic_rf ex)
              (Other "Inconsistent (consistent_non_atomic_rf)")))
        (fun (_ : Unit) =>
          nd_guard (consistent_atomic_rf ex) (Other "Inconsistent (consistent_atomic_rf)")))
      (fun (_ : Unit) =>
        nd_guard (coherent_memory_use ex) (Other "Inconsistent (coherent_memory_use)")))
    (fun (_ : Unit) =>
      nd_guard (sc_accesses_sc_reads_restricted ex)
        (Other "Inconsistent (sc_accesses_sc_reads_restricted)"))
def monCheckWitRestrict (new_wit : execution_witness) (committed : Pset action)
    (old_wit : execution_witness) :
    ndM Unit String String (mem_constraint CerbMem.IntegerValue) Unit :=
  nd_guard ((incWitRestrict new_wit committed) == old_wit)
    (Error0 CerbLocation.unknown
      "\"witnessRestrict new committed = old\" should hold by construction.")
def monCheckCommitmentOrder (pre : pre_execution) (wit : execution_witness)
    (committed : List action) (a : action) :
    ndM Unit String String (mem_constraint CerbMem.IntegerValue) Unit :=
  let rel1 := standard_relations pre wit;
  let order := incCom (pre, wit, rel1);
  nd_guard (respectsCom pre.actions committed order a)
    (Other
      (String.append "Committing action "
        (String.append (Lem_String_extra.stringFromNat (aid_of a))
          " does not respect the commitment order.")))
/- The semantics of performing an action -/

def monPerformLoad [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (lem_if is_seq_cst a then monAddToSc pre a s else nd_return s.incWit.sc)
    (fun (new_sc : Pset (action × action)) =>
      bindExhaustive (monAddToRfLoad pre a s)
        (fun (new_rf : Pset
          (action ×
            action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
          nd_return ({ { s.incWit with rf := new_rf } with sc := new_sc })))
def monPerformStore [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (lem_if is_seq_cst a then monAddToSc pre a s else nd_return s.incWit.sc)
    (fun (new_sc : Pset (action × action)) =>
      bindExhaustive
        (lem_if is_at_atomic_location pre.lk a then monAddToMo pre a s else nd_return s.incWit.mo)
        (fun (new_mo : Pset
          (action ×
            action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
          nd_return ({ { s.incWit with mo := new_mo } with sc := new_sc })))
def monPerformRmw [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (lem_if is_seq_cst a then monAddToSc pre a s else nd_return s.incWit.sc)
    (fun (new_sc : Pset (action × action)) =>
      bindExhaustive (monAddToRfRmw pre a s) (fun (new_rf : Pset (action × action)) =>
        bindExhaustive (monAddToMo pre a s)
          (fun (new_mo : Pset
            (action ×
              action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
            nd_return
              ({ { { s.incWit with mo := new_mo } with rf := new_rf } with sc := new_sc }))))
def monPerformLock [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (monAddToLo pre a s)
    (fun (new_lo : Pset
      (action × action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
      nd_return ({ s.incWit with lo := new_lo }))
def monPerformUnlock [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (monAddToLo pre a s)
    (fun (new_lo : Pset
      (action × action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
      nd_return ({ s.incWit with lo := new_lo }))
def monPerformFence [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (lem_if is_seq_cst a then monAddToSc pre a s else nd_return s.incWit.sc)
    (fun (new_sc : Pset
      (action × action)) => /- Without the extra brackets the generated isabelle code is invalid. -/
      nd_return ({ s.incWit with sc := new_sc }))
def monPerformAction [LemFuel] (pre : pre_execution) (s : incState) (a : action) :
    ndM execution_witness String String (mem_constraint CerbMem.IntegerValue) Unit :=
  match a with
  | Lock _ _ _ _ => monPerformLock pre s a
  | Unlock _ _ _ => monPerformUnlock pre s a
  | Load _ _ _ _ _ => monPerformLoad pre s a
  | Store _ _ _ _ _ => monPerformStore pre s a
  | RMW _ _ _ _ _ _ => monPerformRmw pre s a
  | Fence _ _ _ => monPerformFence pre s a
  | Blocked_rmw _ _ _ => nd_return s.incWit
  | Alloc _ _ _ => nd_return s.incWit
  | Dealloc _ _ _ => nd_return s.incWit

def monStep [LemFuel] (pre : pre_execution) (s : incState) :
    ndM (action × incState) String String (mem_constraint CerbMem.IntegerValue) Unit :=
  let uncommitted_actions :=
    let x2 := ([] : List action);
    lemListFoldr
      (fun (a : action) (x2 : List action) =>
        lem_if not (Lem_List.elem a s.incCommitted) then a :: x2 else x2) x2
      (setToList pre.actions);
  bindExhaustive (pick "monStep" uncommitted_actions) (fun (a : action) =>
    bindExhaustive (monPerformAction pre s a) (fun (new_wit : execution_witness) =>
      let new_committed := a :: s.incCommitted;
      let new_pre :=
        preRestrict pre
          ((setFromListBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
            new_committed));
      let new_ex := (new_pre, new_wit, standard_relations new_pre new_wit);
      bindExhaustive
        (bindExhaustive
          (bindExhaustive (monCheckConsistency new_ex) (fun (_ : Unit) =>
            monCheckWitRestrict new_wit
              ((setFromListBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                s.incCommitted)) s.incWit))
          (fun (_ : Unit) => monCheckCommitmentOrder pre new_wit s.incCommitted a))
        (fun (_ : Unit) =>
          let new_state := (({ incWit := new_wit, incCommitted := new_committed } : incState));
          nd_return (a, new_state))))
inductive monTrace [LemFuel] : pre_execution → incState → incState → Prop where
  | monReflexive : ∀ pre s, (
  well_formed_threads_opsem (pre, empty_witness, ([] : List (String × Pset (action × action))))) → monTrace pre s s
  | monStep : ∀ pre x y z a, (
  monTrace pre x y) → (
  nd_mem ((a : action), z) (monStep pre y)) → monTrace pre x z

/- The symbolic model -------------------------------------------------- -/

/- We have a different type of state, because pre-executions and the
   equality over cvalues can be updated. -/

structure symState where
  symPre : pre_execution
  symWit : execution_witness
  symCommitted : List action
  symUndefinedness : List undefinedness
  deriving BEq, Ord
instance : Inhabited symState where
  default :=
    { symPre := default, symWit := default, symCommitted := default, symUndefinedness := default }
instance (priority := 500) : Lem_Basic_classes.SetType symState where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 symState where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 symState where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

instance : Show symState where

    show0 state :=
      String.append "(pre_ex: "
        (String.append
          (stringFromSet Lem_String_extra.stringFromNat
            ((setMapBy defaultCompare aid_of state.symPre.actions)))
          (String.append ", wit: "
            (String.append
              (String.append "rf: "
                (String.append (action_rel_tostring state.symWit.rf)
                  (String.append ", mo: "
                    (String.append (action_rel_tostring state.symWit.mo)
                      (String.append ", sc: "
                        (String.append (action_rel_tostring state.symWit.sc)
                          (String.append ", lo: "
                            (String.append (action_rel_tostring state.symWit.lo)
                              (String.append ", tot: "
                                (action_rel_tostring state.symWit.tot))))))))))
              (String.append ", committed: "
                (String.append
                  (stringFromList Lem_String_extra.stringFromNat
                    (List.map aid_of state.symCommitted)) ")")))))

def defaultLk : location_kind := Non_Atomic
def symInitialPre : pre_execution :=
  (({ actions := setEmpty,
      threads := setEmpty,
      lk := (fun (_ : CerbMem.PointerValue) => defaultLk),
      sb := setEmpty,
      asw := setEmpty,
      dd := setEmpty } : pre_execution))
def symInitialState (pre : pre_execution) : symState :=
  (({ symPre := pre,
      symWit := empty_witness,
      symCommitted := ([] : List action),
      symUndefinedness := ([] : List undefinedness) } : symState))

