def symPerformFence [LemFuel] (s : symState) (a : action) :
    ndM (execution_witness × Option (cvalue × cvalue)) String String
        (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (monPerformFence s.symPre (symToIncState s) a) (fun (wit : execution_witness) =>
    nd_return (wit, none))
def symPerformAction [LemFuel] (s : symState) (a : action) :
    ndM (execution_witness × Option (cvalue × cvalue)) String String
        (mem_constraint CerbMem.IntegerValue) Unit :=
  match a with
  | Lock _ _ _ _ => symPerformLock s a
  | Unlock _ _ _ => symPerformUnlock s a
  | Load _ _ _ _ _ => symPerformLoad s a
  | Store _ _ _ _ _ => symPerformStore s a
  | RMW _ _ _ _ _ _ => symPerformRmw s a
  | Fence _ _ _ => symPerformFence s a
  | Blocked_rmw _ _ _ => nd_return (s.symWit, none)
  | Alloc _ _ _ => nd_return (s.symWit, none)
  | Dealloc _ _ _ => nd_return (s.symWit, none)

def symStep0 [LemFuel] (s : symState) :
    ndM symStep String String (mem_constraint CerbMem.IntegerValue) Unit :=
  let uncommitted_actions :=
    let x2 := ([] : List action);
    lemListFoldr
      (fun (a : action) (x2 : List action) =>
        lem_if not (Lem_List.elem a s.symCommitted) then a :: x2 else x2) x2
      (setToList s.symPre.actions);
  bindExhaustive (pick "symStep" uncommitted_actions) (fun (a : action) =>
    bindExhaustive (symPerformAction s a)
      (fun (p : (execution_witness × Option (CerbMem.MemValue × CerbMem.MemValue))) =>
        match p with
        | (new_wit, values) =>
          (let new_committed := a :: s.symCommitted;
           let new_pre :=
             preRestrict s.symPre
               ((setFromListBy
                 (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                 new_committed));
           let new_ex := (new_pre, new_wit, standard_relations new_pre new_wit);
           bindExhaustive
             (bindExhaustive
               (bindExhaustive (monCheckConsistency new_ex) (fun (_ : Unit) =>
                 monCheckWitRestrict new_wit
                   ((setFromListBy
                     (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                     s.symCommitted)) s.symWit))
               (fun (_ : Unit) => monCheckCommitmentOrder s.symPre new_wit s.symCommitted a))
             (fun (_ : Unit) =>
               let new_state := { { s with symCommitted := new_committed } with symWit := new_wit };
               match values with
               | some (v, w) => nd_return (ReadsFrom v w a new_state)
               | none => nd_return (ConcurrencyTau a new_state)))))
