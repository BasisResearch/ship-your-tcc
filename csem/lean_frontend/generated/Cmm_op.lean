def symUpdatePreEx (s : symState) (step1 : preExStep) : symState :=
  let pre := s.symPre;
  let new_lk :=
    match step1.locationKind, loc_of step1.newAction with
    | some loc_kind, some loc1 =>
      (fun (x : CerbMem.PointerValue) => lem_if x == loc1 then loc_kind else pre.lk x)
    | _, _ => pre.lk;
  let extra_sb :=
    (setCrossBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      (let x2 := setEmpty;
       setFold
         (fun (a : action) (x2 : Pset action) =>
           lem_if (setMemberBy defaultCompare (aid_of a) step1.sbBefore) then
             setAddBy setElemCompare a x2
           else
             x2) pre.actions x2) (setFromListBy setElemCompare [step1.newAction]));
  let extra_dd :=
    (setCrossBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      (let x2 := setEmpty;
       setFold
         (fun (a : action) (x2 : Pset action) =>
           lem_if (setMemberBy defaultCompare (aid_of a) step1.ddBefore) then
             setAddBy setElemCompare a x2
           else
             x2) pre.actions x2) (setFromListBy setElemCompare [step1.newAction]));
  let extra_asw :=
    (setCrossBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      (let x2 := setEmpty;
       setFold
         (fun (a : action) (x2 : Pset action) =>
           lem_if (setMemberBy defaultCompare (aid_of a) step1.aswBefore) then
             setAddBy setElemCompare a x2
           else
             x2) pre.actions x2) (setFromListBy setElemCompare [step1.newAction]));
  let new_pre :=
    (({ actions := (setAddBy setElemCompare step1.newAction pre.actions),
        threads := (setAddBy setElemCompare (tid_of step1.newAction) pre.threads),
        lk := new_lk,
        sb :=
          (setUnionBy
            (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) pre.sb
            extra_sb),
        asw :=
          (setUnionBy
            (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) pre.asw
            extra_asw),
        dd :=
          (setUnionBy
            (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) pre.dd
            extra_dd) } : pre_execution));
  { s with symPre := new_pre }

/- The return type of the step function. The threadwise model wants to
   know which values are being considered equal when a new rf-edge is
   formed. -/

inductive symStep : Type where
  | ConcurrencyTau : action → symState → symStep
  /- The first cvalue is the value written, the second the value read. -/
  | ReadsFrom : cvalue → cvalue → action → symState → symStep
  deriving BEq, Ord
export symStep (ConcurrencyTau ReadsFrom)
instance : Inhabited symStep where
  default := ConcurrencyTau default default
instance (priority := 500) : Lem_Basic_classes.SetType symStep where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 symStep where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 symStep where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

instance : Show symStep where

    show0 step :=
      match step with
      | ConcurrencyTau a state1 =>
        String.append "Tau ("
          (String.append (Lem_String_extra.stringFromNat (aid_of a))
            (String.append ", "
              (String.append
                (String.append "(pre_ex: "
                  (String.append
                    (stringFromSet Lem_String_extra.stringFromNat
                      ((setMapBy defaultCompare aid_of state1.symPre.actions)))
                    (String.append ", wit: "
                      (String.append
                        (String.append "rf: "
                          (String.append (action_rel_tostring state1.symWit.rf)
                            (String.append ", mo: "
                              (String.append (action_rel_tostring state1.symWit.mo)
                                (String.append ", sc: "
                                  (String.append (action_rel_tostring state1.symWit.sc)
                                    (String.append ", lo: "
                                      (String.append (action_rel_tostring state1.symWit.lo)
                                        (String.append ", tot: "
                                          (action_rel_tostring state1.symWit.tot))))))))))
                        (String.append ", committed: "
                          (String.append
                            (stringFromList Lem_String_extra.stringFromNat
                              (List.map aid_of state1.symCommitted)) ")")))))) ")")))
      | ReadsFrom v1 v2 a state1 =>
        String.append "ReadsFrom ("
          (String.append (Lem_String_extra.stringFromNat (aid_of a))
            (String.append ", "
              (String.append "TODO"
                (String.append " <- "
                  (String.append "TODO"
                    (String.append ", "
                      (String.append
                        (String.append "(pre_ex: "
                          (String.append
                            (stringFromSet Lem_String_extra.stringFromNat
                              ((setMapBy defaultCompare aid_of state1.symPre.actions)))
                            (String.append ", wit: "
                              (String.append
                                (String.append "rf: "
                                  (String.append (action_rel_tostring state1.symWit.rf)
                                    (String.append ", mo: "
                                      (String.append (action_rel_tostring state1.symWit.mo)
                                        (String.append ", sc: "
                                          (String.append (action_rel_tostring state1.symWit.sc)
                                            (String.append ", lo: "
                                              (String.append (action_rel_tostring state1.symWit.lo)
                                                (String.append ", tot: "
                                                  (action_rel_tostring state1.symWit.tot))))))))))
                                (String.append ", committed: "
                                  (String.append
                                    (stringFromList Lem_String_extra.stringFromNat
                                      (List.map aid_of state1.symCommitted)) ")")))))) ")")))))))

def stateOf (step1 : symStep) : symState :=
  match step1 with
  | ConcurrencyTau _ s => s
  | ReadsFrom _ _ _ s => s

def actionOf (step1 : symStep) : action :=
  match step1 with
  | ConcurrencyTau a _ => a
  | ReadsFrom _ _ a _ => a

/- Methods for updating the execution witness -/

def symToIncState (s : symState) : incState :=
  (({ incWit := s.symWit, incCommitted := s.symCommitted } : incState))
def symAddToRfLoad [LemFuel] (s : symState) (a : action) :
    ndM (Pset (action × action) × Option (cvalue × cvalue)) String String mem_iv_constraint Unit :=
  auxAddToRfLoad s.symPre a (symToIncState s)
def symAddToRfRmw [LemFuel] (s : symState) (a : action) :
    ndM (Pset (action × action) × Option (cvalue × cvalue)) String String mem_iv_constraint Unit :=
  auxAddToRfRmw s.symPre a (symToIncState s)
/- The semantics of performing an action -/

def symPerformLoad [LemFuel] (s : symState) (a : action) :
    ndM (execution_witness × Option (cvalue × cvalue)) String String
        (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive
    (lem_if is_seq_cst a then monAddToSc s.symPre a (symToIncState s) else nd_return s.symWit.sc)
    (fun (new_sc : Pset (action × action)) =>
      bindExhaustive (symAddToRfLoad s a)
        (fun (p : (Pset (action × action) × Option (cvalue × cvalue))) =>
          match p with
          | (new_rf, values) =>
            nd_return ({ { s.symWit with rf := new_rf } with sc := new_sc }, values)))
def symPerformStore [LemFuel] (s : symState) (a : action) :
    ndM (execution_witness × Option (cvalue × cvalue)) String String
        (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive (monPerformStore s.symPre (symToIncState s) a) (fun (wit : execution_witness) =>
    nd_return (wit, none))
def symPerformRmw [LemFuel] (s : symState) (a : action) :
    ndM (execution_witness × Option (cvalue × cvalue)) String String
        (mem_constraint CerbMem.IntegerValue) Unit :=
  bindExhaustive
    (lem_if is_seq_cst a then monAddToSc s.symPre a (symToIncState s) else nd_return s.symWit.sc)
    (fun (new_sc : Pset (action × action)) =>
      bindExhaustive (symAddToRfRmw s a)
        (fun (p : (Pset (action × action) × Option (cvalue × cvalue))) =>
          match p with
          | (new_rf, values) =>
            bindExhaustive (monAddToMo s.symPre a (symToIncState s))
              (fun (new_mo : Pset (action × action)) =>
                nd_return
                  ({ { { s.symWit with mo := new_mo } with rf := new_rf } with sc := new_sc },
                    values))))
