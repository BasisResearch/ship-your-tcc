def variably_modified (_ : ctype) : Bool :=
  (lemSeq
    (fun _ =>
      CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
        match u with
        | () => "AilTypesAux.variably_modified is BOGUS")) (fun _ => /- TODO -/ false))
def has_unknown_size { a : Type } (sigm : sigma a) (c : ctype) : Bool :=
  match sigm, c with
  | sigm, (Ctype _ ty_) =>
    (match ty_ with
     | Array0 _ none => true
     | Array0 elem_ty (some _) => is_incomplete sigm elem_ty
     | _ => (failwithI "AilTypesAux.has_unknown_size: not called an Array" : Bool))
def is_vla : ctype → Bool :=
  fun (x : ctype) =>
    match x with
    | _ =>
      ((lemSeq
        (fun _ =>
          CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
            match u with
            | () => "AilTypesAux.is_vla is BOGUS")) (fun _ => false))) /- TODO !!!!!!! -/

def is_complete_object { a : Type } (S : sigma a) (ty1 : ctype) : Bool :=
  is_object ty1 && is_complete S ty1
/- Adjustment for function parameter types -/

def adjust (qs : qualifiers) (c : ctype) : (qualifiers × ctype) :=
  match qs, c with
  | qs, (Ctype a ty1) =>
    (match ty1 with
     | Array0 elem_ty _ => /- STD §6.7.6.3#7 -/
       /- TODO: now that I removed qualifiers from Array, this function doesn't
         doesn't do the right thing. Cabs_to_ail should not use it anymore
         (at least not for Array) -/
       (no_qualifiers, Ctype a (Pointer qs elem_ty))
     | Function ret_qs_ty params isVariadic =>
       (/- STD §6.7.6.3#8 -/ (lemSeq
         (fun _ =>
           CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
             match u with
             | () => "(unsure) AilTypesAux.Function, qualifiers"))
         (fun _ =>
           (no_qualifiers,
             Ctype a
               (Pointer qs (Ctype ([] : List annot) (Function ret_qs_ty params isVariadic)))))))
     | FunctionNoParams _ =>
       (failwithI "AilTypesAux.adjust ==> FunctionNoParams" : (qualifiers × ctype))
     | ty1 => (qs, Ctype a ty1))
/- STD §6.3.2.1#2 -/

def lvalue_conversion { a : Type } (S : sigma a) (cty : ctype) : errorM ctype :=
  lem_if is_array cty then
    (failwithI "trying to do a lvalue conversion on an array type" : errorM ctype)
  else lem_if is_incomplete S cty && not (is_array cty) then
    ErrorM
      (fun (_ : List (List String)) =>
        Sum.inl
          ((match cty with
            | (Ctype annots1 _) => get_loc_ annots1),
            (TError_UndefinedBehaviour UB020_nonarray_incomplete_lvalue_conversion)))
      /- STD §6.3.2.1#2, sentence 2 -/
  else
    match cty with
    | Ctype _ (Atomic cty') => ErrorM (fun (ts : List (List String)) => Sum.inr (cty', ts))
    | _ =>
      /- NOTE: since the qualifiers of ty are not passed to this function, we
           have already "unqualified" the type -/
      ErrorM (fun (ts : List (List String)) => Sum.inr (cty, ts))

def compatibleWithQualifiedUnqualifiedVersionOf (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (ty1 : ctype)
    (tys : List ctype) :
    Bool :=
  List.any tys (fun (ty' : ctype) =>
    (are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (no_qualifiers, ty1)
      (no_qualifiers, ty'))
def referenced_type : ctype → Option ctype :=
  fun (x : ctype) =>
    match x with
    | Ctype _ (Pointer _ ref_ty) => some ref_ty
    | _ => none

/- TODO: this is such a bad name ... -/

partial def has_pointer_at_leafs (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Void0 => false
     | Basic _ => false
     | Array0 elem_ty _ => has_pointer_at_leafs elem_ty
     | Function _ _ _ => false
     | FunctionNoParams _ => false
     | Pointer _ _ => true
     | Atomic ty1 => has_pointer_at_leafs ty1
     | Struct _ => false
     | Union0 _ => false
     | Byte => false)

/- returns the order between the alignment constraint of two types.
   if this cannot be decided in an implementation agnostic way, return Nothing -/
partial def agnostic_alignment_requirement_ord (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) (c0 : ctype) :
    Option LemOrdering :=
  match c, c0 with
  | ty1@((Ctype _ ty1_)), ty2@((Ctype _ ty2_)) =>
    (lem_if ctypeEqual ty1 ty2 then
      some LemOrdering.EQ
    else lem_if is_character ty1 then
      some (lem_if is_character ty2 then LemOrdering.EQ else LemOrdering.LT)
    else lem_if is_character ty2 then
      some (lem_if is_character ty1 then LemOrdering.EQ else LemOrdering.GT)
    else
      match ty1_, ty2_ with
      | Basic (Integer ity1), Basic (Integer ity2) =>
        (lem_if is_corresponding_unsigned ity1 ity2 || is_corresponding_unsigned ity2
            ity1 then /- (STD §6.2.5#6, first sentence) -/
          some LemOrdering.EQ
        else
          none)
      | Pointer _ ref_ty1, Pointer _ ref_ty2 =>
        (lem_if (is_void ref_ty1 && is_character ref_ty2) ||
            (is_character ref_ty1 && is_void ref_ty2) then /- (STD §6.2.5#28, first sentence) -/
          some LemOrdering.EQ
        else lem_if (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
            (no_qualifiers, ref_ty1)
            (no_qualifiers, ref_ty2) then /- (STD §6.2.5#28, second sentence) -/
          some LemOrdering.EQ
        else lem_if is_struct ref_ty1 && is_struct
            ref_ty2 then /- (STD §6.2.5#28, third sentence) -/
          some LemOrdering.EQ
        else lem_if is_union ref_ty1 && is_union ref_ty2 then /- (STD §6.2.5#28, fourth sentence) -/
          some LemOrdering.EQ
        else
          none)
      | Array0 elem_ty1 _, _ =>
        (agnostic_alignment_requirement_ord _lemReader_enum_definitions _lemReader_tagDefs) elem_ty1
          ty2
      | _, Array0 elem_ty2 _ =>
        (agnostic_alignment_requirement_ord _lemReader_enum_definitions _lemReader_tagDefs) ty1
          elem_ty2
      | _, _ => none)
