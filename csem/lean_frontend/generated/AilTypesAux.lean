          Signed Int_
        else
          Unsigned Int_
      else
        ity)

def promotion [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (impl2 : implementation) :
    ctype → Option ctype :=
  fun (x : ctype) =>
    match x with
    | Ctype annots1 (Basic (Integer ity)) =>
      some
        (Ctype annots1
          (Basic
            (Integer
              ((integer_promotion _lemReader_enum_definitions _lemReader_tagDefs) impl2 ity))))
    | _ => none

def usual_arithmetic_integer_CHERI [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (impl2 : implementation)
    (ity1 : integerType) (ity2 : integerType) :
    integerType :=
  match ity1, ity2 with
  | Size_t, Signed Intptr_t => /- NON-std -/ Unsigned Intptr_t
  | Signed Intptr_t, Size_t => /- NON-std -/ Unsigned Intptr_t
  | Signed Intptr_t, Unsigned Intptr_t => /- NON-std -/ Unsigned Intptr_t
  | Signed Intptr_t, _ => /- NON-std -/ Signed Intptr_t
  | Unsigned Intptr_t, Signed Intptr_t => /- NON-std -/ Unsigned Intptr_t
  | _, Signed Intptr_t => /- NON-std -/ Signed Intptr_t
  | Unsigned Intptr_t, _ => /- NON-std -/ Unsigned Intptr_t
  | _, Unsigned Intptr_t => /- NON-std -/ Unsigned Intptr_t
  | Size_t, _ => /- NON-std -/ Size_t
  | _, Size_t => /- NON-std -/ Size_t
  | _, _ =>
    (let promoted_ity1 :=(integer_promotion _lemReader_enum_definitions _lemReader_tagDefs) impl2
         ity1;
     let promoted_ity2 :=(integer_promotion _lemReader_enum_definitions _lemReader_tagDefs) impl2
         ity2;
     lem_if ((is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 &&
         (is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity2) ||
         ((is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 &&
           (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity2) then
       lem_if lt_integer_rank promoted_ity1 promoted_ity2 then promoted_ity2 else promoted_ity1
     else lem_if (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 &&
         ge_integer_rank promoted_ity1 promoted_ity2 then
       promoted_ity1
     else lem_if (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity2 &&
         ge_integer_rank promoted_ity2 promoted_ity1 then
       promoted_ity2
     else lem_if (is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 then
       lem_if (le_integer_range _lemReader_enum_definitions _lemReader_tagDefs) impl2 promoted_ity2
           promoted_ity1 then
         promoted_ity1
       else
         make_corresponding_unsigned promoted_ity1
     else /- if is_signed_ity promoted_ity2 then -/ lem_if (le_integer_range
         _lemReader_enum_definitions _lemReader_tagDefs) impl2 promoted_ity1 promoted_ity2 then
       promoted_ity2
     else
       make_corresponding_unsigned promoted_ity2)

def usual_arithmetic_integer_default [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (impl2 : implementation)
    (ity1 : integerType) (ity2 : integerType) :
    integerType := /- TODO: this is not standard, but in cerberus we don't treat (u)intptr_t and size_t as an aliased types -/
  (lemSeq
    (fun _ =>
      CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
        match u with
        | () =>
          "NON STD: usual_arithmetic_integer ==> if any operand is of type size_t, then the common type is size_t"))
    (fun _ =>
      match ity1, ity2 with
      | Size_t, _ => /- NON-std -/ Size_t
      | _, Size_t => /- NON-std -/ Size_t
      | Signed Intptr_t, Unsigned Intptr_t => /- NON-std -/ Unsigned Intptr_t
      | Signed Intptr_t, _ => /- NON-std -/ Signed Intptr_t
      | Unsigned Intptr_t, Signed Intptr_t => /- NON-std -/ Unsigned Intptr_t
      | _, Signed Intptr_t => /- NON-std -/ Signed Intptr_t
      | Unsigned Intptr_t, _ => /- NON-std -/ Unsigned Intptr_t
      | _, Unsigned Intptr_t => /- NON-std -/ Unsigned Intptr_t
      | _, _ =>
        (let promoted_ity1 :=(integer_promotion _lemReader_enum_definitions _lemReader_tagDefs)
             impl2 ity1;
         let promoted_ity2 :=(integer_promotion _lemReader_enum_definitions _lemReader_tagDefs)
             impl2 ity2;
         lem_if ((is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 &&
             (is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity2) ||
             ((is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity1 &&
               (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs) promoted_ity2) then
           lem_if lt_integer_rank promoted_ity1 promoted_ity2 then promoted_ity2 else promoted_ity1
         else lem_if (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs)
             promoted_ity1 && ge_integer_rank promoted_ity1 promoted_ity2 then
           promoted_ity1
         else lem_if (is_unsigned_ity _lemReader_enum_definitions _lemReader_tagDefs)
             promoted_ity2 && ge_integer_rank promoted_ity2 promoted_ity1 then
           promoted_ity2
         else lem_if (is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs)
             promoted_ity1 then
           lem_if (le_integer_range _lemReader_enum_definitions _lemReader_tagDefs) impl2
               promoted_ity2 promoted_ity1 then
             promoted_ity1
           else
             make_corresponding_unsigned promoted_ity1
         else /- if is_signed_ity promoted_ity2 then -/ lem_if (le_integer_range
             _lemReader_enum_definitions _lemReader_tagDefs) impl2 promoted_ity1 promoted_ity2 then
           promoted_ity2
         else
           make_corresponding_unsigned promoted_ity2)))

def usual_arithmetic_integer [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (impl2 : implementation)
    (ity1 : integerType) (ity2 : integerType) :
    integerType := /- TODO: this is a temporary hack, we need to add a type alias mechanism to Ocaml_implemetation.implemention -/
  lem_if CerbGlobal.is_CHERI () then
    (usual_arithmetic_integer_CHERI _lemReader_enum_definitions _lemReader_tagDefs) impl2 ity1 ity2
  else
    (usual_arithmetic_integer_default _lemReader_enum_definitions _lemReader_tagDefs) impl2 ity1
      ity2
/- TODO -/

def usual_arithmetic_floating (impl2 : implementation) (ty1 : floatingType) (ty2 : floatingType) :
    floatingType :=
  ty1
/- STD §6.2.5#12 -/

def corresponding_real_type (c : ctype) : Option realFloatingType :=
  match c with
  | cty@(Ctype _ ty1) =>
    (lem_if is_floating cty then
      match ty1 with
      | Basic (Floating (RealFloating rfty)) => some rfty
      /-
    | Basic (Floating (Complex fty))
        Basic (Floating fty)
-/
      | _ => (failwithI "AilTypesAux.corresponding_real_type" : Option realFloatingType)
    else
      none)
/- assuming [ty] is an lvalue type, [modifiable ty] is true iff
   [ty] is modifiable lvalue type (see §6.3.2.1#1, sentence 3) -/
/-
A modifiable lvalue is an lvalue that does not have array type, does not have an incomplete type, does not have a const- qualified type, and if it is a structure or union, does not have any member (including, recursively, any member or element of all contained aggregates or unions) with a const- qualified type.
-/

def modifiable { a : Type } (sigm : sigma a) (qs : qualifiers) (ty1 : ctype) : Bool :=
  not (is_array ty1) && (not qs.const && (is_object ty1 && not (is_incomplete sigm ty1)))
def is_real (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Basic (Integer _) => true
     | Basic (Floating (RealFloating _)) => true
     | _ => false)
/- (§6.2.7) Compatible type -/

mutual
def are_compatible_lemFuel (lemFuel : Nat) (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (p : (qualifiers × ctype))
    (p0 : (qualifiers × ctype)) :
    Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match p, p0 with
     | (qs1, Ctype _ ty1), (qs2, Ctype _ ty2) =>
       qualifiersEqual qs1 qs2 &&
         (match ty1, ty2 with
          | Void0, Void0 => true
          | Basic bty1, Basic bty2 =>
            (match match bty1, bty2 with
                   | Integer ity1, Integer ity2 =>
                     (Integer
                       ((CerberusImpl.normalise_integerType _lemReader_enum_definitions
                         _lemReader_tagDefs) ity1),
                       Integer
                         ((CerberusImpl.normalise_integerType _lemReader_enum_definitions
                           _lemReader_tagDefs) ity2))
                   | Integer ity1, _ =>
                     (Integer
                       ((CerberusImpl.normalise_integerType _lemReader_enum_definitions
                         _lemReader_tagDefs) ity1), bty2)
                   | _, Integer ity2 =>
                     (bty1,
                       Integer
                         ((CerberusImpl.normalise_integerType _lemReader_enum_definitions
                           _lemReader_tagDefs) ity2))
                   /- | (Integer (Enum tag_sym1), Integer (Enum tag_sym2)) ->
              (Integer (Implementation.typeof_enum tag_sym1), Integer (Implementation.typeof_enum tag_sym2))
          | (Integer (Enum tag_sym1), _) ->
              (Integer (Implementation.typeof_enum tag_sym1), bty2)
          | (_, Integer (Enum tag_sym2)) ->
              (bty1, Integer (Implementation.typeof_enum tag_sym2)) -/
                   | _, _ => (bty1, bty2) with
             | (bty1', bty2') => basicTypeEqual bty1' bty2')
          | Array0 elem_ty1 n1_opt, Array0 elem_ty2 n2_opt => /- STD §6.7.6.2#6 -/
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (no_qualifiers, elem_ty1) (no_qualifiers, elem_ty2) &&
              (match n1_opt, n2_opt with
               | some n1, some n2 => n1 == n2
               | some _, none => true
               | none, some _ => true
               | none, none => true)
          | Function (ret_qs1, ret_ty1) params1 isVariadic1,
            Function (ret_qs2, ret_ty2) params2 isVariadic2 => /- STD §6.7.6.3#15 -/
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (ret_qs1, ret_ty1) (ret_qs2, ret_ty2) &&
              ((are_compatible_params_lemFuel lemFuel _lemReader_enum_definitions
                _lemReader_tagDefs) params1 params2 && (isVariadic1 == isVariadic2))
          | FunctionNoParams (ret_qs1, ret_ty1), FunctionNoParams (ret_qs2, ret_ty2) =>
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (ret_qs1, ret_ty1) (ret_qs2, ret_ty2)
          | Function (ret_qs1, ret_ty1) _ isVariadic1, FunctionNoParams (ret_qs2, ret_ty2) =>
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (ret_qs1, ret_ty1) (ret_qs2, ret_ty2) && not isVariadic1
          | FunctionNoParams (ret_qs1, ret_ty1), Function (ret_qs2, ret_ty2) _ isVariadic2 =>
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (ret_qs1, ret_ty1) (ret_qs2, ret_ty2) && not isVariadic2
          | Pointer ref_qs1 ref_ty1, Pointer ref_qs2 ref_ty2 => /- STD §6.7.6.1#2 -/
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (ref_qs1, ref_ty1) (ref_qs2, ref_ty2)
          | Struct tag1, Struct tag2 =>
            (match /- STD §6.2.7#1 -/ /- TODO: being conservative here (aka STD compliant) -/ tag1,
                 tag2 with
             | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
               (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                 lem_if natGteb 0 5 && (sd1 != sd2) then
                   (lemSeq
                     (fun _ =>
                       CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                         match u with
                         | () =>
                           String.append "[Symbol.symbolEqual] suspicious equality ==> "
                             (String.append (show_symbol_description sd1)
                               (String.append " <-> " (show_symbol_description sd2)))))
                     (fun _ => true))
                 else
                   true
               else
                 false)) /- TODO/NOTE: just looking at the tag should be enough since we only have one translation unit (?) -/
          | Union0 tag1, Union0 tag2 =>
            (match /- STD §6.2.7#1 -/ /- TODO: being conservative here (aka STD compliant) -/ tag1,
                 tag2 with
             | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
               (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                 lem_if natGteb 0 5 && (sd1 != sd2) then
                   (lemSeq
                     (fun _ =>
                       CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                         match u with
                         | () =>
                           String.append "[Symbol.symbolEqual] suspicious equality ==> "
                             (String.append (show_symbol_description sd1)
                               (String.append " <-> " (show_symbol_description sd2)))))
                     (fun _ => true))
                 else
                   true
               else
                 false)) /- TODO/NOTE: just looking at the tag should be enough since we only have one translation unit (?) -/
          | Atomic atom_ty1, Atomic atom_ty2 =>
            (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (no_qualifiers, atom_ty1) (no_qualifiers, atom_ty2)
          | Byte, Byte => true
          | _, _ => /- TODO: we can't see Enum types here and there is some impl-def stuff -/
            false))
def are_compatible_params_aux_lemFuel (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (acc : Bool)
    (lemTail : (List (qualifiers × ctype × Bool) × List (qualifiers × ctype × Bool))) :
    Bool :=
  match lemFuel with
  | 0 => ((fuelExhausted (fun _ => false)) lemTail)
  | Nat.succ lemFuel =>
    (match acc with
     | acc =>
       (match lemTail with
        | ([], []) => acc
        | (((qs1, ty1, _) :: params1), ((qs2, ty2, _) :: params2)) =>
          (are_compatible_params_aux_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
            (/- STD (§6.7.6.3#15) the unqualified versions of the parameters types are compared -/ acc &&
              (are_compatible_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
              (no_qualifiers, ty1) (no_qualifiers, ty2)) (params1, params2)
        | _ => /- the list of params must have the same length to be compatible -/ false))
def are_compatible_params_lemFuel (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (params1 : List (qualifiers × ctype × Bool)) (params2 : List (qualifiers × ctype × Bool)) :
    Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match params1, params2 with
     | params1, params2 =>
       (are_compatible_params_aux_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
         true (params1, params2))
end

def are_compatible (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (p : (qualifiers × ctype))
    (p0 : (qualifiers × ctype)) :
    Bool :=
  are_compatible_lemFuel (ctype.lemSize p.2 + ctype.lemSize p0.2 + 1) _lemReader_enum_definitions
    _lemReader_tagDefs p p0
theorem are_compatible_lemFuel_zero (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (p : (qualifiers × ctype))
    (p0 : (qualifiers × ctype)) :
    are_compatible_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs p p0 =
        (fuelExhausted false) :=
  rfl

def are_compatible_params_aux (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (acc : Bool)
    (lemTail : (List (qualifiers × ctype × Bool) × List (qualifiers × ctype × Bool))) :
    Bool :=
  are_compatible_params_aux_lemFuel
    (ctype_.lemSize_aux1 lemTail.1 + ctype_.lemSize_aux1 lemTail.2 + 1) _lemReader_enum_definitions
    _lemReader_tagDefs acc lemTail
theorem are_compatible_params_aux_lemFuel_zero (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (acc : Bool)
    (lemTail : (List (qualifiers × ctype × Bool) × List (qualifiers × ctype × Bool))) :
    are_compatible_params_aux_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs acc lemTail =
        ((fuelExhausted (fun _ => false)) lemTail) :=
  rfl

def are_compatible_params (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (params1 : List (qualifiers × ctype × Bool)) (params2 : List (qualifiers × ctype × Bool)) :
    Bool :=
  are_compatible_params_lemFuel (ctype_.lemSize_aux1 params1 + ctype_.lemSize_aux1 params2 + 2)
    _lemReader_enum_definitions _lemReader_tagDefs params1 params2
theorem are_compatible_params_lemFuel_zero (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (params1 : List (qualifiers × ctype × Bool)) (params2 : List (qualifiers × ctype × Bool)) :
    are_compatible_params_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs params1 params2 =
        (fuelExhausted false) :=
  rfl

partial def make_composite_params_aux (make_composite1 : ctype → ctype → Option ctype) :
    (List (qualifiers × ctype × Bool) × List (qualifiers × ctype × Bool)) → Option
        (List (qualifiers × ctype × Bool)) :=
  fun (x : (List (qualifiers × ctype × Bool) × List (qualifiers × ctype × Bool))) =>
    match x with
    | ([], []) => some ([] : List (qualifiers × ctype × Bool))
    | ((_, ty1, _) :: params1, (_, ty2, _) :: params2) =>
      (match make_composite1 ty1 ty2,
           make_composite_params_aux make_composite1 (params1, params2) with
       | some ty1, some p => some ((no_qualifiers, ty1, false) :: p)
       | _, _ => none)
    | _ => none

/- (§6.2.7#3) composite type -/
/- TODO: this function is defined over Ail types, so function types
   are simpler than what the desugaring can see (functions have parameters). So
   this function SHOULD NOT be used by the desugaring -/

partial def make_composite (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) (c0 : ctype) :
    Option ctype :=
  match c, c0 with
  | cty1@(Ctype a1 ty1), cty2@(Ctype a2 ty2) =>
    (let make_composite_params1 : List (qualifiers × ctype × Bool) → List
       (qualifiers × ctype × Bool) → Option (List (qualifiers × ctype × Bool)) :=
       (fun (params1 : List (qualifiers × ctype × Bool))
         (params2 : List (qualifiers × ctype × Bool)) =>
         make_composite_params_aux (make_composite _lemReader_enum_definitions _lemReader_tagDefs)
           (params1, params2));
     /- a composite type can only be made from two compatible types -/ lem_if not
         ((are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (no_qualifiers, cty1)
           (no_qualifiers, cty2)) then
       none
     else
       match ty1, ty2 with
       | Void0, Void0 => some (Ctype (a1 ++ a2) Void0)
       | Basic bty1, Basic bty2 => /- thanks to the compatibility test we know bty1 = bty2  -/
         some (Ctype (a1 ++ a2) (Basic bty1))
       | Array0 elem_ty1 n1_opt, Array0 elem_ty2 n2_opt =>
         (/- STD §6.2.7#3, first bullet -/
         /- TODO(vla): more would be needed if we want to support VLAs -/
         let n_opt :=
           match n1_opt, n2_opt with
           | some n1, some n2 => /- thanks to the compatibility test we know that n1 = n2  -/
             some n1
           | some n1, none => some n1
           | none, some n2 => some n2
           | none, none => none;
         Option.map (fun (ty1 : ctype) => Ctype (a1 ++ a2) (Array0 ty1 n_opt))
           ((make_composite _lemReader_enum_definitions _lemReader_tagDefs) elem_ty1 elem_ty2))
       | Function (ret_qs1, ret_ty1) params1 isVariadic1,
         Function (ret_qs2, ret_ty2) params2 isVariadic2 =>
         (/- TODO: return qualifiers? -/ /- TODO: like the preceding comment said, there is quite a bit of
           simplication here -/
         lem_if not
             ((fun x y => x == y) isVariadic1
               isVariadic2) then /- TODO: this is redundant given the compatibility check -/
           none
         else
           match (make_composite _lemReader_enum_definitions _lemReader_tagDefs) ret_ty1 ret_ty2,
               make_composite_params1 params1 params2 with
           | some ret_ty, some params =>
             some (Ctype (a1 ++ a2) (Function (ret_qs1, ret_ty) params isVariadic1))
           | _, _ => /- TODO: this is redundant given the compatibility check -/ none)
       | FunctionNoParams (ret_qs1, ret_ty1), FunctionNoParams (ret_qs2, ret_ty2) =>
         (match (make_composite _lemReader_enum_definitions _lemReader_tagDefs) ret_ty1 ret_ty2 with
          | some ret_ty => some (Ctype (a1 ++ a2) (FunctionNoParams (ret_qs1, ret_ty)))
          | none => none)
       | Function (ret_qs1, ret_ty1) params1 isVariadic1, FunctionNoParams (ret_qs2, ret_ty2) =>
         (lem_if isVariadic1 then /- TODO: this is redundant given the compatibility check -/
           none
         else
           match (make_composite _lemReader_enum_definitions _lemReader_tagDefs) ret_ty1
               ret_ty2 with
           | some ret_ty => some (Ctype (a1 ++ a2) (Function (ret_qs1, ret_ty) params1 isVariadic1))
           | none => /- TODO: this is redundant given the compatibility check -/ none)
       | FunctionNoParams (ret_qs1, ret_ty1), Function (ret_qs2, ret_ty2) params2 isVariadic2 =>
         (lem_if isVariadic2 then /- TODO: this is redundant given the compatibility check -/
           none
         else
           match (make_composite _lemReader_enum_definitions _lemReader_tagDefs) ret_ty1
               ret_ty2 with
           | some ret_ty => /- TODO: check the prototype thing -/
             some (Ctype (a1 ++ a2) (Function (ret_qs1, ret_ty) params2 isVariadic2))
           | none => /- TODO: this is redundant given the compatibility check -/ none)
       | _, FunctionNoParams _ =>
         (failwithI "AilTypesAux.make_composite ==> FunctionNoParams (right)" : Option ctype)
       | Pointer ref_qs1 ref_ty1,
         Pointer ref_qs2
           ref_ty2 => /- thanks to the compatibility test we know ref_qs1 = ref_qs2  -/
         Option.map (fun (ref_ty : ctype) => Ctype (a1 ++ a2) (Pointer ref_qs1 ref_ty))
           ((make_composite _lemReader_enum_definitions _lemReader_tagDefs) ref_ty1 ref_ty2)
       | Atomic atom_ty1, Atomic atom_ty2 =>
         Option.map (fun (atom_ty : ctype) => Ctype (a1 ++ a2) (Atomic atom_ty))
           ((make_composite _lemReader_enum_definitions _lemReader_tagDefs) atom_ty1 atom_ty2)
       | Struct tag1, Struct tag2 =>
         (lem_if (match tag1, tag2 with
                  | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                    (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                      lem_if natGteb 0 5 && (sd1 != sd2) then
                        (lemSeq
                          (fun _ =>
                            CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                              match u with
                              | () =>
                                String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                  (String.append (show_symbol_description sd1)
                                    (String.append " <-> " (show_symbol_description sd2)))))
                          (fun _ => true))
                      else
                        true
                    else
                      false)) then
           some cty1
         else
           none)
       | Union0 tag1, Union0 tag2 =>
         (lem_if (match tag1, tag2 with
                  | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                    (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                      lem_if natGteb 0 5 && (sd1 != sd2) then
                        (lemSeq
                          (fun _ =>
                            CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                              match u with
                              | () =>
                                String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                  (String.append (show_symbol_description sd1)
                                    (String.append " <-> " (show_symbol_description sd2)))))
                          (fun _ => true))
                      else
                        true
                    else
                      false)) then
           some cty1
         else
           none)
       | _, _ => none)
def make_composite_params (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (params1 : List (qualifiers × ctype × Bool)) (params2 : List (qualifiers × ctype × Bool)) :
    Option (List (qualifiers × ctype × Bool)) :=
  make_composite_params_aux (make_composite _lemReader_enum_definitions _lemReader_tagDefs)
    (params1, params2)
/- following (§6.3.2.1)#3 -/

def array_coercion (c : ctype) : ctype :=
  match c with
  | (Ctype loc1 ty1) =>
    Ctype loc1
      (match ty1 with
       | Array0 elem_ty _ => Pointer no_qualifiers elem_ty
       | ty1 => ty1)
/- following (§6.3.2.1)#4 -/

def function_coercion (c : ctype) : ctype :=
  match c with
  | (Ctype loc1 ty1) =>
    Ctype loc1
      (match ty1 with
       | Function ret_qs_ty params isVariadic =>
         Pointer no_qualifiers (Ctype ([] : List annot) (Function ret_qs_ty params isVariadic))
       | FunctionNoParams _ =>
         (failwithI "AilTypesAux.function_coercion ==> FunctionNoParams" : ctype_)
       | ty1 => ty1)
/- following (§6.3.2.1)#2 -/

def lvalue_convertible { a : Type } (S : sigma a) (ty1 : ctype) : Bool :=
  not (is_array ty1) && is_complete S ty1
/- following (§6.3.2.1)#2 and #3 -/

def lvalue_coercion { a : Type } (S : sigma a) (ty1 : ctype) : errorM ctype :=
  lem_if lvalue_convertible S ty1 then
    ErrorM (fun (ts : List (List String)) => Sum.inr (ty1, ts))
  else lem_if is_array ty1 then
    ErrorM (fun (ts : List (List String)) => Sum.inr ((array_coercion ty1), ts))
  else
    ErrorM (fun (_ : List (List String)) =>
      Sum.inl
        ((match ty1 with
          | (Ctype annots1 _) => get_loc_ annots1),
          (TError_UndefinedBehaviour UB020_nonarray_incomplete_lvalue_conversion)))
/- following (§6.3.2.1)#3 and #4 -/

def rvalue_coercion (ty1 : ctype) : ctype :=
  lem_if is_array ty1 then
    array_coercion ty1
  else lem_if is_function ty1 then function_coercion ty1 else ty1
def is_pointer_to_complete_object { a : Type } (S : sigma a) : ctype → Bool :=
  fun (x : ctype) =>
    match x with
    | Ctype _ (Pointer _ ty1) => is_complete S ty1
    | _ => false

def are_pointers_to_compatible_complete_objects { a : Type }
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (sigm : sigma a) (c : ctype)
    (c0 : ctype) :
    Bool :=
  match sigm, c, c0 with
  | sigm, (Ctype _ ty1), (Ctype _ ty2) =>
    (match ty1, ty2 with
     | Pointer ref_qs1 ref_ty1, Pointer ref_qs2 ref_ty2 =>
       is_complete sigm ref_ty1 &&
         (is_complete sigm ref_ty2 &&
           (are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (ref_qs1, ref_ty1)
           (ref_qs1, ref_ty2))
     | _, _ => false)
def are_pointers_to_compatible_objects (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) (c0 : ctype) :
    Bool :=
  match c, c0 with
  | (Ctype _ ty1), (Ctype _ ty2) =>
    (match ty1, ty2 with
     | Pointer ref_qs1 ref_ty1, Pointer ref_qs2 ref_ty2 =>
       is_object ref_ty1 &&
         (is_object ref_ty2 && (are_compatible _lemReader_enum_definitions _lemReader_tagDefs)
           (ref_qs1, ref_ty1) (ref_qs1, ref_ty2))
     | _, _ => false)
def is_pointer_to_object (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Pointer _ ref_ty => is_object ref_ty
     | _ => false)
def is_pointer_to_void (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Pointer _ (Ctype _ Void0) => true
     | _ => false)
def is_pointer_to_function (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Pointer _ ref_ty => is_function ref_ty
     | _ => false)
def pointers_to_compatible_types (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) (c0 : ctype) :
    Bool :=
  match c, c0 with
  | (Ctype _ ty1), (Ctype _ ty2) =>
    (match ty1, ty2 with
     | Pointer ref_qs1 ref_ty1, Pointer ref_qs2 ref_ty2 =>
       (are_compatible _lemReader_enum_definitions _lemReader_tagDefs) (ref_qs1, ref_ty1)
         (ref_qs1, ref_ty2)
     | _, _ => false)
/- STD §6.2.5#4, sentence 1 -/

def is_standard_signed_integer_type (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Basic (Integer (Signed Ichar)) => true
     | Basic (Integer (Signed Short)) => true
     | Basic (Integer (Signed Int_)) => true
     | Basic (Integer (Signed Long)) => true
     | Basic (Integer (Signed LongLong)) => true
     | _ => false)
/- TODO: no extended types for now -/
/- STD §6.2.5#4, sentence 3 -/

def is_extended_signed_integer_type (_ : ctype) : Bool := false
/- STD §6.2.5#4, sentence 4 -/

def is_signed_integer_type [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) :
    Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Basic (Integer ity) => (is_signed_ity0 _lemReader_enum_definitions _lemReader_tagDefs) ity
     | _ => false)
/- STD §6.2.5#6, sentences 1-2 -/

def is_standard_unsigned_integer_type (c : ctype) : Bool :=
  match c with
  | (Ctype _ ty1) =>
    (match ty1 with
     | Basic (Integer Bool0) => true
     | Basic (Integer (Unsigned Ichar)) => true
     | Basic (Integer (Unsigned Short)) => true
     | Basic (Integer (Unsigned Int_)) => true
     | Basic (Integer (Unsigned Long)) => true
     | Basic (Integer (Unsigned LongLong)) => true
     /- | Basic (Integer (Unsigned _)) ->
      true -/
     | _ => false)
/- TODO: no extended types for now -/
/- STD §6.2.5#6, sentence 3 -/

def is_extended_unsigned_integer_type (_ : ctype) : Bool := false
def is_unsigned_integer_type [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) :
    Bool :=
