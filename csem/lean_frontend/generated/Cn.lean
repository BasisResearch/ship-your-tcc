    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match cn_pat.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match cn_pat.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match cn_pat.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match cn_pat.compare_derived x y with
    | .lt => false
    | _ => true
instance { a : Type } [BEq a] : BEq (cn_pat_ a) where
  beq := cn_pat_.beq_derived
instance { a : Type } [Ord a] : Ord (cn_pat_ a) where
  compare := cn_pat_.compare_derived
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (cn_pat_ a) where
  setElemCompare x y :=
    match cn_pat_.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) { a : Type } [BEq a] : Lem_Basic_classes.Eq0 (cn_pat_ a) where
  isEqual := cn_pat_.beq_derived
  isInequal x y := !(cn_pat_.beq_derived x y)
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.Ord0 (cn_pat_ a) where
  compare x y :=
    match cn_pat_.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match cn_pat_.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match cn_pat_.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match cn_pat_.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match cn_pat_.compare_derived x y with
    | .lt => false
    | _ => true
/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def cn_pat.lemSize { a : Type } (sizex_ : cn_pat a) : Nat :=
  match sizex_ with
  | .CNPat _ x1 => 1 + cn_pat_.lemSize x1
termination_by structural sizex_
def cn_pat_.lemSize { a : Type } (sizex_ : cn_pat_ a) : Nat :=
  match sizex_ with
  | .CNPat_sym _ => 1
  | .CNPat_wild => 1
  | .CNPat_constructor _ x1 => 1 + cn_pat.lemSize_aux1 x1
termination_by structural sizex_
def cn_pat.lemSize_aux1 { a : Type } (sizex_ : List ((identifier × cn_pat a))) : Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + cn_pat.lemSize x1 + cn_pat.lemSize_aux1 xs0
termination_by structural sizex_
end

mutual
inductive cn_expr_ (a : Type) (ty : Type) : Type where
  | CNExpr_const : cn_const → cn_expr_ a ty
  | CNExpr_var : a → cn_expr_ a ty
  | CNExpr_list : List (cn_expr a ty) → cn_expr_ a ty
  | CNExpr_memberof : cn_expr a ty → identifier → cn_expr_ a ty
  | CNExpr_arrow : cn_expr a ty → identifier → cn_expr_ a ty
  | CNExpr_record : List (identifier × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_struct : a → List (identifier × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_memberupdates : cn_expr a ty → List (identifier × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_arrayindexupdates : cn_expr a ty → List (cn_expr a ty × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_binop : cn_binop → cn_expr a ty → cn_expr a ty → cn_expr_ a ty
  | CNExpr_sizeof : ty → cn_expr_ a ty
  | CNExpr_offsetof : a → identifier → cn_expr_ a ty
  | CNExpr_membershift : cn_expr a ty → Option ty → identifier → cn_expr_ a ty
  | CNExpr_addr : a → cn_expr_ a ty
  | CNExpr_cast : cn_base_type a → cn_expr a ty → cn_expr_ a ty
  | CNExpr_array_shift : cn_expr a ty → Option ty → cn_expr a ty → cn_expr_ a ty
  | CNExpr_call : a → List (cn_expr a ty) → cn_expr_ a ty
  | CNExpr_cons : a → List (identifier × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_each : a → cn_base_type a → (Int × Int) → cn_expr a ty → cn_expr_ a ty
  | CNExpr_let : a → cn_expr a ty → cn_expr a ty → cn_expr_ a ty
  | CNExpr_match : cn_expr a ty → List (cn_pat a × cn_expr a ty) → cn_expr_ a ty
  | CNExpr_ite : cn_expr a ty → cn_expr a ty → cn_expr a ty → cn_expr_ a ty
  | CNExpr_good : ty → cn_expr a ty → cn_expr_ a ty
  | CNExpr_deref : cn_expr a ty → cn_expr_ a ty
