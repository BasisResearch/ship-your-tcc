/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def cn_expr_.lemSize { a : Type } { ty : Type } (sizex_ : cn_expr_ a ty) : Nat :=
  match sizex_ with
  | .CNExpr_const _ => 1
  | .CNExpr_var _ => 1
  | .CNExpr_list x1 => 1 + cn_expr_.lemSize_aux1 x1
  | .CNExpr_memberof x1 _ => 1 + cn_expr.lemSize x1
  | .CNExpr_arrow x1 _ => 1 + cn_expr.lemSize x1
  | .CNExpr_record x1 => 1 + cn_expr_.lemSize_aux2 x1
  | .CNExpr_struct _ x1 => 1 + cn_expr_.lemSize_aux2 x1
  | .CNExpr_memberupdates x1 x2 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux2 x2
  | .CNExpr_arrayindexupdates x1 x2 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux3 x2
  | .CNExpr_binop _ x1 x2 => 1 + cn_expr.lemSize x1 + cn_expr.lemSize x2
  | .CNExpr_sizeof _ => 1
  | .CNExpr_offsetof _ _ => 1
  | .CNExpr_membershift x1 _ _ => 1 + cn_expr.lemSize x1
  | .CNExpr_addr _ => 1
  | .CNExpr_cast _ x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_array_shift x1 _ x2 => 1 + cn_expr.lemSize x1 + cn_expr.lemSize x2
  | .CNExpr_call _ x1 => 1 + cn_expr_.lemSize_aux1 x1
  | .CNExpr_cons _ x1 => 1 + cn_expr_.lemSize_aux2 x1
  | .CNExpr_each _ _ _ x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_let _ x1 x2 => 1 + cn_expr.lemSize x1 + cn_expr.lemSize x2
  | .CNExpr_match x1 x2 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux4 x2
  | .CNExpr_ite x1 x2 x3 => 1 + cn_expr.lemSize x1 + cn_expr.lemSize x2 + cn_expr.lemSize x3
  | .CNExpr_good _ x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_deref x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_value_of_c_atom _ _ => 1
  | .CNExpr_unchanged x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_at_env x1 _ => 1 + cn_expr.lemSize x1
  | .CNExpr_not x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_negate x1 => 1 + cn_expr.lemSize x1
  | .CNExpr_default _ => 1
  | .CNExpr_bnot x1 => 1 + cn_expr.lemSize x1
termination_by structural sizex_
def cn_expr.lemSize { a : Type } { ty : Type } (sizex_ : cn_expr a ty) : Nat :=
  match sizex_ with
  | .CNExpr _ x1 => 1 + cn_expr_.lemSize x1
termination_by structural sizex_
def cn_expr_.lemSize_aux1 { a ty : Type } (sizex_ : List (cn_expr a ty)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux1 xs0
termination_by structural sizex_
def cn_expr_.lemSize_aux2 { a ty : Type } (sizex_ : List ((identifier × cn_expr a ty))) : Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux2 xs0
termination_by structural sizex_
def cn_expr_.lemSize_aux3 { a ty : Type } (sizex_ : List ((cn_expr a ty × cn_expr a ty))) : Nat :=
  match sizex_ with
  | [] => 0
  | (x1, x2) :: xs0 => 1 + cn_expr.lemSize x1 + cn_expr.lemSize x2 + cn_expr_.lemSize_aux3 xs0
termination_by structural sizex_
def cn_expr_.lemSize_aux4 { a ty : Type } (sizex_ : List ((cn_pat a × cn_expr a ty))) : Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + cn_expr.lemSize x1 + cn_expr_.lemSize_aux4 xs0
termination_by structural sizex_
end

