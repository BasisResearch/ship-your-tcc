  default := CNErr_unknown_predicate
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def cn_error.ctor_rank_ocaml : cn_error → Nat
  | .CNErr_uppercase_function _ => 2
  | .CNErr_lowercase_predicate _ => 3
  | .CNErr_redeclaration _ => 4
  | .CNErr_unknown_predicate => 0
  | .CNErr_invalid_tag => 1
  | .CNErr_unknown_identifier _ _ => 5
  | .CNErr_unknown_c_identifier _ => 6
  | .CNErr_missing_oarg _ => 7
  | .CNErr_general _ => 8
  | .CNErr_duplicate_field _ => 9
mutual
def cn_error.beq_derived (cmpx_ cmpy_ : cn_error) : Bool :=
  match cmpx_, cmpy_ with
  | .CNErr_uppercase_function x1, .CNErr_uppercase_function y1 => x1 == y1
  | .CNErr_lowercase_predicate x1, .CNErr_lowercase_predicate y1 => x1 == y1
  | .CNErr_redeclaration x1, .CNErr_redeclaration y1 => x1 == y1
  | .CNErr_unknown_predicate, .CNErr_unknown_predicate => true
  | .CNErr_invalid_tag, .CNErr_invalid_tag => true
  | .CNErr_unknown_identifier x1 x2, .CNErr_unknown_identifier y1 y2 => x1 == y1 && x2 == y2
  | .CNErr_unknown_c_identifier x1, .CNErr_unknown_c_identifier y1 => x1 == y1
  | .CNErr_missing_oarg x1, .CNErr_missing_oarg y1 => x1 == y1
  | .CNErr_general x1, .CNErr_general y1 => x1 == y1
  | .CNErr_duplicate_field x1, .CNErr_duplicate_field y1 => x1 == y1
  | _, _ => false
termination_by structural cmpx_
def cn_error.compare_derived (cmpx_ cmpy_ : cn_error) : Ordering :=
  match cmpx_, cmpy_ with
  | .CNErr_uppercase_function x1, .CNErr_uppercase_function y1 => Ord.compare x1 y1
  | .CNErr_lowercase_predicate x1, .CNErr_lowercase_predicate y1 => Ord.compare x1 y1
  | .CNErr_redeclaration x1, .CNErr_redeclaration y1 => Ord.compare x1 y1
  | .CNErr_unknown_identifier x1 x2, .CNErr_unknown_identifier y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNErr_unknown_c_identifier x1, .CNErr_unknown_c_identifier y1 => Ord.compare x1 y1
  | .CNErr_missing_oarg x1, .CNErr_missing_oarg y1 => Ord.compare x1 y1
  | .CNErr_general x1, .CNErr_general y1 => Ord.compare x1 y1
  | .CNErr_duplicate_field x1, .CNErr_duplicate_field y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (cn_error.ctor_rank_ocaml xg) (cn_error.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq cn_error where
  beq := cn_error.beq_derived
instance : Ord cn_error where
  compare := cn_error.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType cn_error where
  setElemCompare x y :=
    match cn_error.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 cn_error where
  isEqual := cn_error.beq_derived
  isInequal x y := !(cn_error.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 cn_error where
  compare x y :=
    match cn_error.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match cn_error.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match cn_error.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match cn_error.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match cn_error.compare_derived x y with
    | .lt => false
    | _ => true

