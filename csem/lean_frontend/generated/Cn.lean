  | CNErr_invalid_tag : cn_error
  | CNErr_unknown_identifier : cn_namespace → identifier → cn_error
  | CNErr_unknown_c_identifier : identifier → cn_error
  | CNErr_missing_oarg : sym → cn_error
  | CNErr_general : String → cn_error
  | CNErr_duplicate_field : identifier → cn_error
export cn_error (CNErr_uppercase_function CNErr_lowercase_predicate CNErr_redeclaration
    CNErr_unknown_predicate CNErr_invalid_tag CNErr_unknown_identifier CNErr_unknown_c_identifier
    CNErr_missing_oarg CNErr_general CNErr_duplicate_field)
