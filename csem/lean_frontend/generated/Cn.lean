  | CNExpr : CerbLocation.Loc → cn_expr_ a ty → cn_expr a ty
end
export cn_expr_ (CNExpr_const CNExpr_var CNExpr_list CNExpr_memberof CNExpr_arrow CNExpr_record
    CNExpr_struct CNExpr_memberupdates CNExpr_arrayindexupdates CNExpr_binop CNExpr_sizeof
    CNExpr_offsetof CNExpr_membershift CNExpr_addr CNExpr_cast CNExpr_array_shift CNExpr_call
    CNExpr_cons CNExpr_each CNExpr_let CNExpr_match CNExpr_ite CNExpr_good CNExpr_deref
    CNExpr_value_of_c_atom CNExpr_unchanged CNExpr_at_env CNExpr_not CNExpr_negate CNExpr_default
    CNExpr_bnot)
export cn_expr (CNExpr)

instance { a ty : Type } : Inhabited (cn_expr_ a ty) where
  default := CNExpr_const default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_var default
instance (priority := low) { a ty : Type } : Inhabited (cn_expr_ a ty) where
  default := CNExpr_list default
instance (priority := low) { a ty : Type } : Inhabited (cn_expr_ a ty) where
  default := CNExpr_record default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_struct default default
instance (priority := low) { a ty : Type } [Inhabited ty] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_sizeof default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_offsetof default default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_addr default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_call default default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_cons default default
instance (priority := low) { a ty : Type } [Inhabited a] : Inhabited (cn_expr_ a ty) where
  default := CNExpr_value_of_c_atom default default
instance (priority := low) { a ty : Type } : Inhabited (cn_expr_ a ty) where
  default := CNExpr_default default
instance { a ty : Type } : Inhabited (cn_expr a ty) where
  default := CNExpr default default

/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def cn_expr_.ctor_rank_ocaml { a ty : Type } : cn_expr_ a ty → Nat
  | .CNExpr_const _ => 0
  | .CNExpr_var _ => 1
  | .CNExpr_list _ => 2
  | .CNExpr_memberof _ _ => 3
  | .CNExpr_arrow _ _ => 4
  | .CNExpr_record _ => 5
  | .CNExpr_struct _ _ => 6
  | .CNExpr_memberupdates _ _ => 7
  | .CNExpr_arrayindexupdates _ _ => 8
  | .CNExpr_binop _ _ _ => 9
  | .CNExpr_sizeof _ => 10
  | .CNExpr_offsetof _ _ => 11
  | .CNExpr_membershift _ _ _ => 12
  | .CNExpr_addr _ => 13
  | .CNExpr_cast _ _ => 14
  | .CNExpr_array_shift _ _ _ => 15
  | .CNExpr_call _ _ => 16
  | .CNExpr_cons _ _ => 17
  | .CNExpr_each _ _ _ _ => 18
  | .CNExpr_let _ _ _ => 19
  | .CNExpr_match _ _ => 20
  | .CNExpr_ite _ _ _ => 21
  | .CNExpr_good _ _ => 22
  | .CNExpr_deref _ => 23
  | .CNExpr_value_of_c_atom _ _ => 24
  | .CNExpr_unchanged _ => 25
  | .CNExpr_at_env _ _ => 26
  | .CNExpr_not _ => 27
  | .CNExpr_negate _ => 28
  | .CNExpr_default _ => 29
  | .CNExpr_bnot _ => 30
mutual
def cn_expr_.beq_derived { a : Type } [BEq a] { ty : Type } [BEq ty] (cmpx_ cmpy_ : cn_expr_ a ty) :
    Bool :=
  match cmpx_, cmpy_ with
  | .CNExpr_const x1, .CNExpr_const y1 => x1 == y1
  | .CNExpr_var x1, .CNExpr_var y1 => x1 == y1
  | .CNExpr_list x1, .CNExpr_list y1 => cn_expr_.beq_deriv_aux5 x1 y1
  | .CNExpr_memberof x1 x2, .CNExpr_memberof y1 y2 => cn_expr.beq_derived x1 y1 && x2 == y2
  | .CNExpr_arrow x1 x2, .CNExpr_arrow y1 y2 => cn_expr.beq_derived x1 y1 && x2 == y2
  | .CNExpr_record x1, .CNExpr_record y1 => cn_expr_.beq_deriv_aux6 x1 y1
  | .CNExpr_struct x1 x2, .CNExpr_struct y1 y2 => x1 == y1 && cn_expr_.beq_deriv_aux6 x2 y2
  | .CNExpr_memberupdates x1 x2, .CNExpr_memberupdates y1 y2 =>
    cn_expr.beq_derived x1 y1 && cn_expr_.beq_deriv_aux6 x2 y2
  | .CNExpr_arrayindexupdates x1 x2, .CNExpr_arrayindexupdates y1 y2 =>
    cn_expr.beq_derived x1 y1 && cn_expr_.beq_deriv_aux7 x2 y2
  | .CNExpr_binop x1 x2 x3, .CNExpr_binop y1 y2 y3 =>
    x1 == y1 && cn_expr.beq_derived x2 y2 && cn_expr.beq_derived x3 y3
  | .CNExpr_sizeof x1, .CNExpr_sizeof y1 => x1 == y1
  | .CNExpr_offsetof x1 x2, .CNExpr_offsetof y1 y2 => x1 == y1 && x2 == y2
  | .CNExpr_membershift x1 x2 x3, .CNExpr_membershift y1 y2 y3 =>
    cn_expr.beq_derived x1 y1 && x2 == y2 && x3 == y3
  | .CNExpr_addr x1, .CNExpr_addr y1 => x1 == y1
  | .CNExpr_cast x1 x2, .CNExpr_cast y1 y2 => x1 == y1 && cn_expr.beq_derived x2 y2
  | .CNExpr_array_shift x1 x2 x3, .CNExpr_array_shift y1 y2 y3 =>
    cn_expr.beq_derived x1 y1 && x2 == y2 && cn_expr.beq_derived x3 y3
  | .CNExpr_call x1 x2, .CNExpr_call y1 y2 => x1 == y1 && cn_expr_.beq_deriv_aux5 x2 y2
  | .CNExpr_cons x1 x2, .CNExpr_cons y1 y2 => x1 == y1 && cn_expr_.beq_deriv_aux6 x2 y2
  | .CNExpr_each x1 x2 x3 x4, .CNExpr_each y1 y2 y3 y4 =>
    x1 == y1 && x2 == y2 && x3 == y3 && cn_expr.beq_derived x4 y4
  | .CNExpr_let x1 x2 x3, .CNExpr_let y1 y2 y3 =>
    x1 == y1 && cn_expr.beq_derived x2 y2 && cn_expr.beq_derived x3 y3
  | .CNExpr_match x1 x2, .CNExpr_match y1 y2 =>
    cn_expr.beq_derived x1 y1 && cn_expr_.beq_deriv_aux8 x2 y2
  | .CNExpr_ite x1 x2 x3, .CNExpr_ite y1 y2 y3 =>
    cn_expr.beq_derived x1 y1 && cn_expr.beq_derived x2 y2 && cn_expr.beq_derived x3 y3
  | .CNExpr_good x1 x2, .CNExpr_good y1 y2 => x1 == y1 && cn_expr.beq_derived x2 y2
  | .CNExpr_deref x1, .CNExpr_deref y1 => cn_expr.beq_derived x1 y1
  | .CNExpr_value_of_c_atom x1 x2, .CNExpr_value_of_c_atom y1 y2 => x1 == y1 && x2 == y2
  | .CNExpr_unchanged x1, .CNExpr_unchanged y1 => cn_expr.beq_derived x1 y1
  | .CNExpr_at_env x1 x2, .CNExpr_at_env y1 y2 => cn_expr.beq_derived x1 y1 && x2 == y2
  | .CNExpr_not x1, .CNExpr_not y1 => cn_expr.beq_derived x1 y1
  | .CNExpr_negate x1, .CNExpr_negate y1 => cn_expr.beq_derived x1 y1
  | .CNExpr_default x1, .CNExpr_default y1 => x1 == y1
  | .CNExpr_bnot x1, .CNExpr_bnot y1 => cn_expr.beq_derived x1 y1
  | _, _ => false
termination_by structural cmpx_
def cn_expr_.compare_derived { a : Type } [Ord a] { ty : Type } [Ord ty]
    (cmpx_ cmpy_ : cn_expr_ a ty) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .CNExpr_const x1, .CNExpr_const y1 => Ord.compare x1 y1
  | .CNExpr_var x1, .CNExpr_var y1 => Ord.compare x1 y1
  | .CNExpr_list x1, .CNExpr_list y1 => cn_expr_.cmp_deriv_aux1 x1 y1
  | .CNExpr_memberof x1 x2, .CNExpr_memberof y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNExpr_arrow x1 x2, .CNExpr_arrow y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNExpr_record x1, .CNExpr_record y1 => cn_expr_.cmp_deriv_aux2 x1 y1
  | .CNExpr_struct x1 x2, .CNExpr_struct y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux2 x2 y2)
  | .CNExpr_memberupdates x1 x2, .CNExpr_memberupdates y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux2 x2 y2)
  | .CNExpr_arrayindexupdates x1 x2, .CNExpr_arrayindexupdates y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux3 x2 y2)
  | .CNExpr_binop x1 x2 x3, .CNExpr_binop y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match cn_expr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => cn_expr.compare_derived x3 y3))
  | .CNExpr_sizeof x1, .CNExpr_sizeof y1 => Ord.compare x1 y1
  | .CNExpr_offsetof x1 x2, .CNExpr_offsetof y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNExpr_membershift x1 x2 x3, .CNExpr_membershift y1 y2 y3 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .CNExpr_addr x1, .CNExpr_addr y1 => Ord.compare x1 y1
  | .CNExpr_cast x1 x2, .CNExpr_cast y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr.compare_derived x2 y2)
  | .CNExpr_array_shift x1 x2 x3, .CNExpr_array_shift y1 y2 y3 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => cn_expr.compare_derived x3 y3))
  | .CNExpr_call x1 x2, .CNExpr_call y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux1 x2 y2)
  | .CNExpr_cons x1 x2, .CNExpr_cons y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux2 x2 y2)
  | .CNExpr_each x1 x2 x3 x4, .CNExpr_each y1 y2 y3 y4 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match Ord.compare x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq => cn_expr.compare_derived x4 y4)))
  | .CNExpr_let x1 x2 x3, .CNExpr_let y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match cn_expr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => cn_expr.compare_derived x3 y3))
  | .CNExpr_match x1 x2, .CNExpr_match y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.cmp_deriv_aux4 x2 y2)
  | .CNExpr_ite x1 x2 x3, .CNExpr_ite y1 y2 y3 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match cn_expr.compare_derived x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => cn_expr.compare_derived x3 y3))
  | .CNExpr_good x1 x2, .CNExpr_good y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr.compare_derived x2 y2)
  | .CNExpr_deref x1, .CNExpr_deref y1 => cn_expr.compare_derived x1 y1
  | .CNExpr_value_of_c_atom x1 x2, .CNExpr_value_of_c_atom y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNExpr_unchanged x1, .CNExpr_unchanged y1 => cn_expr.compare_derived x1 y1
  | .CNExpr_at_env x1 x2, .CNExpr_at_env y1 y2 =>
    (match cn_expr.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .CNExpr_not x1, .CNExpr_not y1 => cn_expr.compare_derived x1 y1
  | .CNExpr_negate x1, .CNExpr_negate y1 => cn_expr.compare_derived x1 y1
  | .CNExpr_default x1, .CNExpr_default y1 => Ord.compare x1 y1
  | .CNExpr_bnot x1, .CNExpr_bnot y1 => cn_expr.compare_derived x1 y1
  | xg, yg => Ord.compare (cn_expr_.ctor_rank_ocaml xg) (cn_expr_.ctor_rank_ocaml yg)
termination_by structural cmpx_
def cn_expr.beq_derived { a : Type } [BEq a] { ty : Type } [BEq ty] (cmpx_ cmpy_ : cn_expr a ty) :
    Bool :=
  match cmpx_, cmpy_ with
  | .CNExpr x1 x2, .CNExpr y1 y2 => x1 == y1 && cn_expr_.beq_derived x2 y2
termination_by structural cmpx_
def cn_expr.compare_derived { a : Type } [Ord a] { ty : Type } [Ord ty]
    (cmpx_ cmpy_ : cn_expr a ty) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .CNExpr x1 x2, .CNExpr y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_expr_.compare_derived x2 y2)
