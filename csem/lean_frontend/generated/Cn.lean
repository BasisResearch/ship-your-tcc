/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def cn_to_instantiate.ctor_rank_ocaml { a ty : Type } : cn_to_instantiate a ty → Nat
  | .I_Function _ => 1
  | .I_Good _ => 2
  | .I_Everything => 0
mutual
def cn_to_instantiate.beq_derived { a : Type } [BEq a] { ty : Type } [BEq ty]
    (cmpx_ cmpy_ : cn_to_instantiate a ty) :
    Bool :=
  match cmpx_, cmpy_ with
  | .I_Function x1, .I_Function y1 => x1 == y1
  | .I_Good x1, .I_Good y1 => x1 == y1
  | .I_Everything, .I_Everything => true
  | _, _ => false
termination_by structural cmpx_
def cn_to_instantiate.compare_derived { a : Type } [Ord a] { ty : Type } [Ord ty]
    (cmpx_ cmpy_ : cn_to_instantiate a ty) :
    Ordering :=
  match cmpx_, cmpy_ with
  | .I_Function x1, .I_Function y1 => Ord.compare x1 y1
  | .I_Good x1, .I_Good y1 => Ord.compare x1 y1
  | xg, yg =>
    Ord.compare (cn_to_instantiate.ctor_rank_ocaml xg) (cn_to_instantiate.ctor_rank_ocaml yg)
