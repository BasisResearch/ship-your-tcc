     | .eq => cn_pat.cmp_deriv_aux1 x2 y2)
  | xg, yg => Ord.compare (cn_pat_.ctor_rank_ocaml xg) (cn_pat_.ctor_rank_ocaml yg)
termination_by structural cmpx_
def cn_pat.cmp_deriv_aux1 { a : Type } [Ord a] (cmpx_ cmpy_ : List ((identifier × cn_pat a))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => cn_pat.compare_derived x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => cn_pat.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def cn_pat.beq_deriv_aux2 { a : Type } [BEq a] (cmpx_ cmpy_ : List ((identifier × cn_pat a))) :
    Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    x1 == y1 && cn_pat.beq_derived x2 y2 && cn_pat.beq_deriv_aux2 xs0 ys0
  | _, _ => false
termination_by structural cmpx_
end

instance { a : Type } [BEq a] : BEq (cn_pat a) where
  beq := cn_pat.beq_derived
instance { a : Type } [Ord a] : Ord (cn_pat a) where
  compare := cn_pat.compare_derived
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (cn_pat a) where
  setElemCompare x y :=
    match cn_pat.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
