def sc_accesses_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Acquire, Relaxed, Seq_cst])))
            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Release, Relaxed, Seq_cst])))
            | RMW _ _ mo1 _ _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [Acq_rel, Acquire, Release, Relaxed, Seq_cst])))
            | Fence _ _ mo1 =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [Release, Acquire, Relaxed])))
            | Blocked_rmw _ _ _ => true
            | Alloc _ _ _ => false /- CSEM -/
            | Dealloc _ _ _ => false /- CSEM -/) Xo.actions) Xs
def sc_accesses_consistent_sc
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, Xw, ("hb", hb) :: _) =>
    relation_over Xo.actions Xw.sc &&
      (isTransitive Xw.sc &&
        (isIrreflexive Xw.sc && setForAll
          (fun (a : action) =>
            setForAll
              (fun (b : action) =>
                (((not
                  (setMemberBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                    Xw.sc)) || not
                  ((setMemberBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (b, a)
                    (setUnionBy
                      (pairCompare
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) hb
                      Xw.mo))))) &&
                  (((setMemberBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                    Xw.sc) ||
                    (setMemberBy
                      (pairCompare
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
