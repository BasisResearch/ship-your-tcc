  default := One0 (default, (fun (x10 : candidate_execution) => default))
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def fault_setgen.ctor_rank_ocaml : fault_setgen → Nat
  | .One0 _ => 0
  | .Two _ => 1
mutual
def fault_setgen.beq_derived (cmpx_ cmpy_ : fault_setgen) : Bool :=
  match cmpx_, cmpy_ with
  | .One0 (x1, x2), .One0 (y1, y2) => x1 == y1 && lemFunctionalBeq x2 y2
  | .Two (x1, x2), .Two (y1, y2) => x1 == y1 && lemFunctionalBeq x2 y2
  | _, _ => false
termination_by structural cmpx_
def fault_setgen.compare_derived (cmpx_ cmpy_ : fault_setgen) : Ordering :=
  match cmpx_, cmpy_ with
  | .One0 (x1, x2), .One0 (y1, y2) =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .Two (x1, x2), .Two (y1, y2) =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | xg, yg => Ord.compare (fault_setgen.ctor_rank_ocaml xg) (fault_setgen.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

