/- The above type (fault_setgen) is used for the
   undefinedness-predicates, where the kind of undefinedness is
   denoted by a string. To make it easier to work with, we provide
   alternative definitions of the undefinedness-predicates, that
   return a list of the following type. -/

inductive undefinedness : Type where
  | DataRaces : Pset (action × action) → undefinedness
  | UnsequencedRaces : Pset (action × action) → undefinedness
  | IndeterminateReads : Pset action → undefinedness
  | BadMutexes : Pset action → undefinedness
  | NotInSublanguage : undefinedness
export undefinedness (DataRaces UnsequencedRaces IndeterminateReads BadMutexes NotInSublanguage)
instance : Inhabited undefinedness where
  default := NotInSublanguage
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def undefinedness.ctor_rank_ocaml : undefinedness → Nat
  | .DataRaces _ => 1
  | .UnsequencedRaces _ => 2
  | .IndeterminateReads _ => 3
  | .BadMutexes _ => 4
  | .NotInSublanguage => 0
mutual
def undefinedness.beq_derived (cmpx_ cmpy_ : undefinedness) : Bool :=
  match cmpx_, cmpy_ with
  | .DataRaces x1, .DataRaces y1 => x1 == y1
  | .UnsequencedRaces x1, .UnsequencedRaces y1 => x1 == y1
  | .IndeterminateReads x1, .IndeterminateReads y1 => x1 == y1
  | .BadMutexes x1, .BadMutexes y1 => x1 == y1
  | .NotInSublanguage, .NotInSublanguage => true
  | _, _ => false
termination_by structural cmpx_
def undefinedness.compare_derived (cmpx_ cmpy_ : undefinedness) : Ordering :=
  match cmpx_, cmpy_ with
  | .DataRaces x1, .DataRaces y1 => Ord.compare x1 y1
  | .UnsequencedRaces x1, .UnsequencedRaces y1 => Ord.compare x1 y1
  | .IndeterminateReads x1, .IndeterminateReads y1 => Ord.compare x1 y1
  | .BadMutexes x1, .BadMutexes y1 => Ord.compare x1 y1
  | xg, yg => Ord.compare (undefinedness.ctor_rank_ocaml xg) (undefinedness.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

