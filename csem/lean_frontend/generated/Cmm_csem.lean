/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
mutual
def pre_execution.beq_derived (cmpx_ cmpy_ : pre_execution) : Bool :=
  match cmpx_, cmpy_ with
  | .mk x1 x2 x3 x4 x5 x6, .mk y1 y2 y3 y4 y5 y6 =>
    x1 == y1 && x2 == y2 && lemFunctionalBeq x3 y3 && x4 == y4 && x5 == y5 && x6 == y6
termination_by structural cmpx_
def pre_execution.compare_derived (cmpx_ cmpy_ : pre_execution) : Ordering :=
  match cmpx_, cmpy_ with
  | .mk x1 x2 x3 x4 x5 x6, .mk y1 y2 y3 y4 y5 y6 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match lemFunctionalCompare x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq =>
             (match Ord.compare x4 y4 with
              | .lt => Ordering.lt
              | .gt => Ordering.gt
              | .eq =>
                (match Ord.compare x5 y5 with
                 | .lt => Ordering.lt
                 | .gt => Ordering.gt
                 | .eq => Ord.compare x6 y6)))))
termination_by structural cmpx_
end

