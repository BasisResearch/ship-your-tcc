    show0 d :=
      match d with
      | DataRaces s =>
        String.append "DataRaces: "
          (stringFromSet
            (stringFromPair Lem_String_extra.stringFromNat Lem_String_extra.stringFromNat)
            (aid_of_rel2 s))
      | UnsequencedRaces s =>
        String.append "UnsequencedRaces: "
          (stringFromSet
