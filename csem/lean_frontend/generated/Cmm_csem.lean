def release_acquire_relaxed_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
