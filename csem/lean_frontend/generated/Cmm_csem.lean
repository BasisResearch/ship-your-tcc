                                ((setMemberBy
                                  (pairCompare
                                    (fun (x : action) (y : action)=>
                                      defaultCompare (aid_of x) (aid_of y))
                                    (fun (x : action) (y : action)=>
                                      defaultCompare (aid_of x) (aid_of y))) (head1, w) mo1) &&
                                  (setMemberBy
                                    (pairCompare
                                      (fun (x : action) (y : action)=>
                                        defaultCompare (aid_of x) (aid_of y))
                                      (fun (x : action) (y : action)=>
