def release_acquire_SC_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        atomic_initialisation_first (Xo, Xw, rl) && setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Acquire, Seq_cst])))
            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Release, Seq_cst])))
            | RMW _ _ mo1 _ _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Acq_rel, Seq_cst])))
            | Fence _ _ mo1 =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Seq_cst])))
            | Blocked_rmw _ _ _ => true
            | Alloc _ _ _ => false /- CSEM -/
            | Dealloc _ _ _ => false /- CSEM -/) Xo.actions) Xs

