def with_consume_cad_set { a b : Type } [Eq0 a] [SetType a] (actions1 : b) (sb1 : Pset (a × a))
    (dd1 : Pset (a × a)) (rf1 : Pset (a × a)) :
    Pset (a × a) :=
  (set_tcByCmp (pairCompare (@setElemCompare a _) (@setElemCompare a _))
    ((setUnionBy (pairCompare (@setElemCompare a _) (@setElemCompare a _))
      ((setInterBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) rf1 sb1)) dd1)))

def with_consume_dob (actions1 : Pset action) (rf1 : Pset (action × action))
    (rs : Pset (action × action)) (cad : Pset (action × action)) (w : action) (a : action) :
    Bool :=
  not ((tid_of w) == (tid_of a)) && setAny
    (fun (w' : action) =>
      setAny
        (fun (r : action) =>
          is_consume r &&
            ((setMemberBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (w, w')
              rs) &&
              ((setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (w', r)
                rf1) &&
                ((setMemberBy
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (r, a)
                  cad) || (r == a))))) actions1) actions1

def dependency_ordered_before (actions1 : Pset action) (rf1 : Pset (action × action))
    (rs : Pset (action × action)) (cad : Pset (action × action)) (a : action) (d : action) :
    Bool :=
  (setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) a actions1) &&
    ((setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) d
      actions1) &&
      (setAny
        (fun (b : action) =>
          is_release a &&
            (is_consume b &&
              ((setAny
                (fun (e : action) =>
                  (setMemberBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, e)
                    rs) &&
                    (setMemberBy
                      (pairCompare
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                      (e, b) rf1)) actions1) &&
                ((setMemberBy
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (b, d)
                  cad) || (b == d))))) actions1))

def with_consume_dob_set (actions1 : Pset action) (rf1 : Pset (action × action))
    (rs : Pset (action × action)) (cad : Pset (action × action)) :
    Pset (action × action) :=
  let x2 := setEmpty;
  setFold
    (fun (a : action) (x2 : Pset (action × action)) =>
      setFold
        (fun (b : action) (x2 : Pset (action × action)) =>
          lem_if dependency_ordered_before actions1 rf1 rs cad a b then
            setAddBy setElemCompare (a, b) x2
          else
            x2) actions1 x2) actions1 x2

def compose { a b c : Type } [Eq0 a] [SetType b] [SetType c] (R1 : Pset (b × a))
    (R2 : Pset (a × c)) :
    Pset (b × c) :=
  let x2 := setEmpty;
  setFold
    (fun (p : (b × a)) (x2 : Pset (b × c)) =>
      match p, x2 with
      | (w, x), x2 =>
        setFold
          (fun (p : (a × c)) (x2 : Pset (b × c)) =>
            match p, x2 with
            | (y, z), x2 => (lem_if (x == y) then setAddBy setElemCompare (w, z) x2 else x2)) R2 x2)
    R1 x2

def inter_thread_happens_before { a b : Type } [Eq0 a] [SetType a] (actions1 : b)
    (sb1 : Pset (a × a)) (sw : Pset (a × a)) (dob : Pset (a × a)) :
    Pset (a × a) :=
  let r :=
    (setUnionBy (pairCompare (@setElemCompare a _) (@setElemCompare a _))
      (setUnionBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) sw dob)
      (compose sw sb1));
  (set_tcByCmp (pairCompare (@setElemCompare a _) (@setElemCompare a _))
    ((setUnionBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) r (compose sb1 r))))

def happens_before { a b : Type } [SetType a] (actions1 : b) (sb1 : Pset a) (ithb : Pset a) :
    Pset a :=
  (setUnionBy (@setElemCompare a _) sb1 ithb)
def with_consume_relations (Xo : pre_execution) (Xw : execution_witness) :
    List (String × Pset (action × action)) :=
  let hrs := hypothetical_release_sequence_set Xo.actions Xo.lk Xw.mo;
  let rs := release_sequence_set Xo.actions Xo.lk Xw.mo;
  let sw := release_acquire_fenced_synchronizes_with_set Xo.actions Xo.sb Xo.asw Xw.rf Xw.lo rs hrs;
  let cad := with_consume_cad_set Xo.actions Xo.sb Xo.dd Xw.rf;
  let dob := with_consume_dob_set Xo.actions Xw.rf rs cad;
  let ithb := inter_thread_happens_before Xo.actions Xo.sb sw dob;
  let hb := happens_before Xo.actions Xo.sb ithb;
  let vse := visible_side_effect_set Xo.actions hb;
  [("hb", hb), ("vse", vse), ("ithb", ithb), ("sw", sw), ("rs", rs), ("hrs", hrs), ("dob", dob),
    ("cad", cad)]
