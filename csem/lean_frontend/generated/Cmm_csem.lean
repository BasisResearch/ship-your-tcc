def sc_fenced_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Acquire, Relaxed, Seq_cst])))
            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Release, Relaxed, Seq_cst])))
            | RMW _ _ mo1 _ _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [Acq_rel, Acquire, Release, Relaxed, Seq_cst])))
            | Fence _ _ mo1 =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [Release, Acquire, Relaxed, Seq_cst])))
