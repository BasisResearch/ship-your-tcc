def locks_only_sw { a : Type } (actions1 : a) (asw1 : Pset (action × action))
    (lo1 : Pset (action × action)) (a1 : action) (b : action) :
    Bool :=
  (not ((tid_of a1) == (tid_of b))) &&
    ((setMemberBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      /- thread sync -/ (a1, b) asw1) ||
      /- mutex sync -/ (is_unlock a1 &&
        (is_lock b &&
          (setMemberBy
            (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a1, b)
            lo1))))

