def standard_vsses (actions1 : Pset action) (lk1 : CerbMem.PointerValue → location_kind)
    (mo1 : Pset (action × action)) (hb : Pset (action × action)) (vse : Pset (action × action)) :
    Pset (action × action) :=
  let x2 := setEmpty;
  setFold
    (fun (v : action) (x2 : Pset (action × action)) =>
      setFold
        (fun (r : action) (x2 : Pset (action × action)) =>
          setFold
            (fun (head1 : action) (x2 : Pset (action × action)) =>
              lem_if is_at_atomic_location lk1 r &&
                  ((setMemberBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                    (head1, r) vse) &&
                    (not
                      (setAny
                        (fun (v' : action) =>
                          (setMemberBy
                            (pairCompare
