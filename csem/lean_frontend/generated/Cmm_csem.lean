def relation_over { a : Type } [SetType a] (s : Pset a) (rel1 : Pset (a × a)) : Bool :=
  relOver rel1 s

def inj_on { a b : Type } [Eq0 a] [Eq0 b] [Ord a] (f : a → b) (A : Pset a) : Bool :=
  (setForAll (fun (x : a) => (setForAll (fun (y : a) => ((not (f x == f y)) || (x == y))) A)) A)

def strict_total_order_over { a : Type } [Eq0 a] [SetType a] (s : Pset a) (ord : Pset (a × a)) :
    Bool :=
  relation_over s ord && isTotalOrderOn ord s

def adjacent_less_than { a : Type } [SetType a] (ord : Pset (a × a)) (s : Pset a) (x : a) (y : a) :
    Bool :=
  (setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (x, y) ord) && not
    (setAny
      (fun (z : a) =>
        (setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (x, z) ord) &&
          (setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (z, y) ord)) s)

def adjacent_less_than_such_that { a : Type } [SetType a] (pred1 : a → Bool) (ord : Pset (a × a))
    (s : Pset a) (x : a) (y : a) :
    Bool :=
  pred1 x &&
    ((setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (x, y) ord) && not
      (setAny
        (fun (z : a) =>
          pred1 z &&
            ((setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (x, z) ord) &&
              (setMemberBy (pairCompare (@setElemCompare a _) (@setElemCompare a _)) (z, y) ord)))
        s))
def finite_prefixes { a : Type } [SetType a] [Eq0 a] (r : Pset (a × a)) (s : Pset a) : Bool := true
def minimal_elements { a : Type } (s : Pset a) (r : Pset (a × a)) : Pset a := s

