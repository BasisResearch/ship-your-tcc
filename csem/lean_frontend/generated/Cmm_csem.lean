                            (pairCompare
                              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                              (fun (x : action) (y : action)=>
                                defaultCompare (aid_of x) (aid_of y))) (c, b) mo1))) || rs_element
                        rel1 c)) actions1))) then
            setAddBy setElemCompare (rel1, b) x2
          else
            x2) actions1 x2) actions1 x2
