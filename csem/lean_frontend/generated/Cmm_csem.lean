def well_formed_rf
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, Xw, _) =>
    setForAll
      (fun (p : (action × action)) =>
        match p with
        | (a, b) =>
          (setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) a
            Xo.actions) &&
            ((setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) b
              Xo.actions) &&
              ((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b)) &&
                (is_write a &&
                  (is_read b &&
                    ((maybeEqualBy (fun x y => x == y) (value_read_by b) (value_written_by a)) &&
                      setForAll
                      (fun (a' : action) =>
                        ((not
                          (setMemberBy
                            (pairCompare
                              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                              (fun (x : action) (y : action)=>
                                defaultCompare (aid_of x) (aid_of y))) (a', b) Xw.rf)) ||
                          (a == a'))) Xo.actions)))))) Xw.rf
def sc_mo_lo_empty
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (_, Xw, _) => setIsEmpty Xw.sc && (setIsEmpty Xw.mo && setIsEmpty Xw.lo)
def sc_mo_empty (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (_, Xw, _) => setIsEmpty Xw.sc && setIsEmpty Xw.mo
def sc_empty (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (_, Xw, _) => (setIsEmpty Xw.sc)
def tot_empty (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (_, Xw, _) => (setIsEmpty Xw.tot)

def single_thread_relations { a : Type } (Xo : pre_execution) (Xw : a) :
    List (String × Pset (action × action)) :=
  let hb := Xo.sb;
  let vse := visible_side_effect_set Xo.actions hb;
  [("hb", hb), ("vse", vse)]

def single_thread_consistent_execution : named_predicate_tree :=
  Node
    [("assumptions", Leaf assumptions), ("sc_mo_lo_empty", Leaf sc_mo_lo_empty),
      ("tot_empty", Leaf tot_empty), ("well_formed_threads", Leaf well_formed_threads),
      ("well_formed_rf", Leaf well_formed_rf),
      ("consistent_rf",
        Node
          [("det_read", Leaf det_read),
            ("consistent_non_atomic_rf", Leaf consistent_non_atomic_rf)])]
