def indeterminate_reads
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Pset action :=
  match p with
  | (Xo, Xw, _) =>
    (let x2 := setEmpty;
     setFold
       (fun (b : action) (x2 : Pset action) =>
         lem_if is_read b && not
             (setAny
               (fun (a : action) =>
                 (setMemberBy
                   (pairCompare
                     (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                     (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                   Xw.rf)) Xo.actions) then
           setAddBy setElemCompare b x2
         else
           x2) Xo.actions x2)
def unsequenced_races
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Pset (action × action) :=
  match p with
  | (Xo, _, _) =>
    (let x2 := setEmpty;
     setFold
       (fun (a : action) (x2 : Pset (action × action)) =>
         setFold
           (fun (b : action) (x2 : Pset (action × action)) =>
             lem_if is_at_non_atomic_location Xo.lk a &&
                 (not (a == b) &&
                   (((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) &&
                     ((is_write a || is_write b) &&
                       ((tid_of a == tid_of b) && not
                         ((setMemberBy
                           (pairCompare
                             (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                             (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                           (a, b) Xo.sb) ||
                           (setMemberBy
                             (pairCompare
                               (fun (x : action) (y : action)=>
                                 defaultCompare (aid_of x) (aid_of y))
                               (fun (x : action) (y : action)=>
                                 defaultCompare (aid_of x) (aid_of y))) (b, a) Xo.sb)))))) then
               setAddBy setElemCompare (a, b) x2
             else
               x2) Xo.actions x2) Xo.actions x2)

def single_thread_undefined_behaviour : List fault_setgen :=
  [Two ("unsequenced_races", unsequenced_races), One0 ("indeterminate_reads", indeterminate_reads)]

def no_CK (Xo : pre_execution) : Bool := /- CSEM -/
  setForAll (fun (a : action) => not_alloc_or_dealloc a) Xo.actions /- CSEM -/
def single_thread_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        setAny
          (fun (b : action) =>
            setForAll
              (fun (a : action) =>
                (tid_of a == tid_of b) &&
                  (match (loc_of a) with
                   | none => false
                   | some l => (Xo.lk l == Non_Atomic))) Xo.actions) Xo.actions) Xs

def single_thread_memory_model : memory_model :=
  (({ consistent := single_thread_consistent_execution,
      relation_calculation := single_thread_relations,
      undefined := single_thread_undefined_behaviour,
      relation_flags :=
        (({ rf_flag := true,
            mo_flag := false,
            sc_flag := false,
            lo_flag := false,
            tot_flag := false } : relation_usage_flags)) } : memory_model))

