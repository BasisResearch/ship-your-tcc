  setFold
    (fun (rel1 : action) (x2 : Pset (action × action)) =>
      setFold
        (fun (b : action) (x2 : Pset (action × action)) =>
          lem_if is_release rel1 &&
              ((b == rel1) ||
                ((setMemberBy
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
