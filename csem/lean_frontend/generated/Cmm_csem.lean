                                  defaultCompare (aid_of x) (aid_of y))) (head1, v') mo1))
                        actions1) &&
                      ((v == head1) ||
                        ((setMemberBy
                          (pairCompare
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                          (head1, v) mo1) &&
                          (not
                            ((setMemberBy
                              (pairCompare
                                (fun (x : action) (y : action)=>
                                  defaultCompare (aid_of x) (aid_of y))
                                (fun (x : action) (y : action)=>
                                  defaultCompare (aid_of x) (aid_of y))) (r, v) hb)) && setForAll
                            (fun (w : action) =>
