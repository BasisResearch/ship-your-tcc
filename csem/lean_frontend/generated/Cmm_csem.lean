def pre_execution_mask (Xo : pre_execution) (A : Pset action) : pre_execution :=
  let B :=
    (setInterBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) A
      Xo.actions);
  (({ actions := B,
      threads := Xo.threads,
      lk := Xo.lk,
      sb := (relRestrict Xo.sb B),
      asw := (relRestrict Xo.asw B),
      dd := (relRestrict Xo.dd B) } : pre_execution))

def replace_read_value (a : action) (v : CerbMem.MemValue) : action :=
  match a with
  | Lock aid1 tid1 loc1 out => Lock aid1 tid1 loc1 Blocked
  | Unlock aid1 tid1 loc1 => a
  | Load aid1 tid1 ord loc1 rval => Load aid1 tid1 ord loc1 v
  | Store aid1 tid1 ord loc1 wval => a
  | RMW aid1 tid1 ord loc1 rval wval => RMW aid1 tid1 ord loc1 v wval
  | Fence aid1 tid1 ord => a
  | Blocked_rmw aid1 tid1 loc1 => a
  | Alloc _ _ _ =>
    (failwithI
      "Incomplete Pattern at File \"frontend/concurrency/cmm_csem.lem\", line 1064, character 3 to line 1072, character 5" :
      action)
  | Dealloc _ _ _ =>
    (failwithI
      "Incomplete Pattern at File \"frontend/concurrency/cmm_csem.lem\", line 1064, character 3 to line 1072, character 5" :
      action)

def downclosed (A : Pset action) (R : Pset (action × action)) : Bool := true

def is_prefix { a : Type } (opsem : a → pre_execution → Bool) (p : a) (Xo : pre_execution)
    (A : Pset action) :
    Bool :=
  opsem p Xo &&
    ((setSubsetBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) A
      Xo.actions) && (downclosed A (sbasw Xo) && true))

def fringe_set (Xo : pre_execution) (A : Pset action) : Pset action :=
  minimal_elements
    ((setDiffBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) Xo.actions
      A)) (sbasw Xo)
def relation_plug (R : Pset (action × action)) (a : action) (a' : action) :
    Pset (action × action) :=
  setEmpty

def pre_execution_plug (Xo : pre_execution) (a : action) (a' : action) : pre_execution :=
  (({ actions :=
        (setUnionBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
          ((setDiffBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
            Xo.actions (setFromListBy setElemCompare [a]))) (setFromListBy setElemCompare [a'])),
      threads := Xo.threads,
      lk := Xo.lk,
      sb := (relation_plug Xo.sb a a'),
      asw := (relation_plug Xo.asw a a'),
      dd := (relation_plug Xo.dd a a') } : pre_execution))

def same_prefix (Xo1 : pre_execution) (Xo2 : pre_execution) (A : Pset action) : Bool :=
  let AF :=
    (setUnionBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) A
      (fringe_set Xo1 A));
  ((pre_execution_mask Xo1 AF) == (pre_execution_mask Xo2 AF)) &&
    ((setEqualBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
      (fringe_set Xo1 A) (fringe_set Xo2 A)))
/- For all subsets of actions in a pre_execution, If there is an sb minimal read, just outside the set, then we can rewrite its value if it is a read, and then find another pre_execution containing the set of actions, with the modified read still minimal and in the same thread. -/

def receptiveness (opsem : program → pre_execution → Bool) : Bool := true

/- If some property holds for a chain of prefixes, growing at least by the fringe actions at each step, then it holds for some full Xo.

What about finite executions? Their fringe action sets become empty at some point -/

def holds_over_prefix { a : Type } (opsem : a → pre_execution → Bool) (p : a) (Xo : pre_execution)
    (A : Pset action) (P : pre_execution → Bool) :
    Bool :=
  is_prefix opsem p Xo A && P (pre_execution_mask Xo A)
def extends_prefix (Xo : pre_execution) (A : Pset action) (A' : Pset action) : Bool := true
/- In proofs of the consistency predicate, I'll extend the total order to the set of fringe actions, value-change all reads accordingly, and then add them all. I can make all locks block by default too.

The above requires the fringe_set to be finite for tot_consistency and for inducting over the fringe. That is something I should make assumptions to satisfy (I will need to justify them). I would be requiring the number of sb unordered actions and the number of thread spawns between actions to be finite.
-/

def produce_well_formed_threads (opsem : program → pre_execution → Bool) : Bool := true

def opsem_assumptions (opsem : program → pre_execution → Bool) : Bool :=
  receptiveness opsem && produce_well_formed_threads opsem

