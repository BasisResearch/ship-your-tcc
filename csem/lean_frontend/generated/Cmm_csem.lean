/- ********************************************** -/
/- The overlap relation calculation -/

def visible_side_effect_set_fp (actions1 : Pset action) (hb : Pset (action × action)) :
    Pset (action × footprint_impl × action) :=
  let x : (action × action) → (action × footprint_impl × action) :=
    (fun (p : (action × action)) =>
      match p with
      | (a, b) =>
        (let overwriting_footprint :=
           footprint_bigunion
             (let x2 := setEmpty;
              setFold
                (fun (c : action) (x2 : Pset footprint_impl) =>
                  lem_if not
                      ((setMemberBy
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) c
                        (setFromListBy setElemCompare [a, b]))) &&
                      (is_write c &&
                        ((setMemberBy
                          (pairCompare
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                          (a, c) hb) &&
                          (setMemberBy
                            (pairCompare
                              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                              (fun (x : action) (y : action)=>
                                defaultCompare (aid_of x) (aid_of y))) (c, b) hb))) then
                    setAddBy setElemCompare (footprint_of c) x2
                  else
                    x2) actions1 x2);
         let remaining_footprint_of_a :=
           footprint_difference (footprint_of a) overwriting_footprint;
         let footprint_between_a_and_b :=
           footprint_intersection (footprint_of b) remaining_footprint_of_a;
         (a, footprint_between_a_and_b, b)));
  let x2 := setEmpty;
  setFold
    (fun (p : (action × footprint_impl × action)) (x2 : Pset (action × footprint_impl × action)) =>
      match p, x2 with
      | (a, f, b), x2 =>
        (lem_if is_write a && (is_read b && not (footprint_is_empty f)) then
          setAddBy setElemCompare (a, f, b) x2
        else
          x2))
    (setMapBy
      (tripleCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        defaultCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) x hb)
    x2
def overlap_relations (Xo : pre_execution) (Xw_fp : execution_witness_fp) : relation_list_fp :=
  let Xw := project_witness_fp Xw_fp;
  let hrs := hypothetical_release_sequence_set Xo.actions Xo.lk Xw.mo;
  let rs := release_sequence_set Xo.actions Xo.lk Xw.mo;
  let sw := release_acquire_fenced_synchronizes_with_set Xo.actions Xo.sb Xo.asw Xw.rf Xw.lo rs hrs;
  let hb := no_consume_hb Xo.sb sw;
  let vse := visible_side_effect_set_fp Xo.actions hb;
  (({ hb_fp := hb, vse_fp := vse, rest := [("sw", sw), ("rs", rs), ("hrs", hrs)] } :
    relation_list_fp))
/- ********************************************** -/
/- The overlap memory model -/

def overlap_memory_model : memory_model_fp :=
  (({ consistent_fp := overlap_consistent_execution,
      relation_calculation_fp := overlap_relations,
      undefined_fp := locks_only_undefined_behaviour,
      relation_flags_fp :=
        (({ rf_flag := true,
            mo_flag := true,
            sc_flag := true,
            lo_flag := true,
            tot_flag := false } : relation_usage_flags)) } : memory_model_fp))
