                                  (fun (x : action) (y : action)=>
                                    defaultCompare (aid_of x) (aid_of y))) (x, b) sb1))) actions1)
                    actions1))))))))

def release_acquire_fenced_synchronizes_with_set (actions1 : Pset action)
