/- ********************************************** -/
/- The overlap consistency predicates -/

def well_formed_rf_fp (p : (pre_execution × execution_witness_fp × relation_list_fp)) : Bool :=
  match p with
  | (Xo, Xw, _) =>
    (setForAll
      (fun (p : (action × footprint_impl × action)) =>
        match p with
        | (w, f, r) =>
          (setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) w
            Xo.actions) &&
            ((setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) r
              Xo.actions) &&
              (is_write w &&
                (is_read r &&
                  (not (footprint_is_empty f) &&
                    ((((not (is_at_non_atomic_location Xo.lk r)) ||
                      (setForAll
                        (fun (p : (action × footprint_impl × action)) =>
                          match p with
                          | (w', f', r') => ((not ((r == r') && (w == w'))) || (f == f')))
                        Xw.rf_fp))) &&
                      (((not (is_at_atomic_location Xo.lk r)) ||
                        (setForAll
                          (fun (p : (action × footprint_impl × action)) =>
                            match p with
                            | (w', f', r') => ((not (r == r')) || ((w == w') && (f == f'))))
                          Xw.rf_fp))))))))) Xw.rf_fp) &&
      (setForAll
        (fun (r : action) =>
          let writes_of_r :=
            let x2 := setEmpty;
            setFold
              (fun (p : (action × footprint_impl × action)) (x2 : Pset (action × footprint_impl)) =>
                match p, x2 with
                | (w, f, r'), x2 =>
                  (lem_if (r == r') then setAddBy setElemCompare (w, f) x2 else x2)) Xw.rf_fp x2;
          ((not (not (setIsEmpty writes_of_r))) ||
            (footprint_leq0
              (footprint_bigunion
                (let x2 := setEmpty;
                 setFold
                   (fun (p : (action × footprint_impl)) (x2 : Pset footprint_impl) =>
                     match p, x2 with
                     | (w, f), x2 => (lem_if true then setAddBy setElemCompare f x2 else x2))
                   writes_of_r x2)) (footprint_of r) &&
              (maybeEqualBy (fun x y => x == y) (value_read_by r)
                (combine_cvalues0
                  (Lem_Set.setMapMaybe
                    (fun (p : (action × footprint_impl)) =>
                      match p with
                      | (w, f) =>
                        (match value_written_by w with
                         | some v => some (v, footprint_of w, f)
                         | none => none)) writes_of_r)))))) Xo.actions)
def consistent_non_atomic_rf_fp (p : (pre_execution × execution_witness_fp × relation_list_fp)) :
    Bool :=
  match p with
  | (Xo, Xw, rel1) =>
    setForAll
      (fun (p : (action × footprint_impl × action)) =>
        match p with
        | (w, f, r) =>
          ((not (is_at_non_atomic_location Xo.lk r)) || setAny
            (fun (p : (action × footprint_impl × action)) =>
              match p with
              | (w', f', r') => (w == w') && ((r == r') && footprint_leq0 f f')) rel1.vse_fp))
      Xw.rf_fp
def det_read_fp (p : (pre_execution × execution_witness_fp × relation_list_fp)) : Bool :=
  match p with
  | (Xo, Xw, rel1) =>
    setForAll
      (fun (r : action) =>
        ((not (is_load r)) ||
          (footprint_bigunion
            (let x2 := setEmpty;
             setFold
               (fun (p : (action × footprint_impl × action)) (x2 : Pset footprint_impl) =>
                 match p, x2 with
                 | (w, f, r'), x2 => (lem_if (r == r') then setAddBy setElemCompare f x2 else x2))
               rel1.vse_fp x2) == footprint_bigunion
            (let x2 := setEmpty;
             setFold
               (fun (p : (action × footprint_impl × action)) (x2 : Pset footprint_impl) =>
                 match p, x2 with
                 | (w, f, r'), x2 => (lem_if (r == r') then setAddBy setElemCompare f x2 else x2))
               Xw.rf_fp x2)))) Xo.actions
