/- TODO: the following definition should use
action_respects_location_kind, instead of cloning the function
body. This hasn't been done yet, because it might break existing
proofs. -/

def actions_respect_location_kinds (actions1 : Pset action)
    (lk1 : CerbMem.PointerValue → location_kind) :
    Bool :=
  setForAll
    (fun (a : action) =>
      match a with
      | Lock _ _ l _ => lk1 l == Mutex
      | Unlock _ _ l => lk1 l == Mutex
      | Load _ _ mo1 l _ =>
        ((mo1 == NA) && (lk1 l == Non_Atomic)) || ((mo1 != NA) && (lk1 l == Atomic0))
      | Store _ _ mo1 l _ => ((mo1 == NA) && (lk1 l == Non_Atomic)) || (lk1 l == Atomic0)
      | RMW _ _ _ l _ _ => lk1 l == Atomic0
      | Fence _ _ _ => true
      | Blocked_rmw _ _ l => lk1 l == Atomic0
      | Alloc _ _ _ => true /- CSEM -/
      | Dealloc _ _ _ => true /- CSEM -/) actions1

def action_respects_location_kinds { a : Type } (action2 : a)
    (lk1 : CerbMem.PointerValue → location_kind) (a1 : action) :
    Bool :=
  match a1 with
  | Lock _ _ l _ => lk1 l == Mutex
  | Unlock _ _ l => lk1 l == Mutex
  | Load _ _ mo1 l _ =>
    ((mo1 == NA) && (lk1 l == Non_Atomic)) || ((mo1 != NA) && (lk1 l == Atomic0))
  | Store _ _ mo1 l _ => ((mo1 == NA) && (lk1 l == Non_Atomic)) || (lk1 l == Atomic0)
  | RMW _ _ _ l _ _ => lk1 l == Atomic0
  | Fence _ _ _ => true
  | Blocked_rmw _ _ l => lk1 l == Atomic0
  | Alloc _ _ _ => true /- CSEM -/
  | Dealloc _ _ _ => true /- CSEM -/

def is_at_mutex_location (lk1 : CerbMem.PointerValue → location_kind) (a : action) : Bool :=
  match loc_of a with
  | some l => (lk1 l == Mutex)
  | none => false

def is_at_non_atomic_location (lk1 : CerbMem.PointerValue → location_kind) (a : action) : Bool :=
  match loc_of a with
  | some l => (lk1 l == Non_Atomic)
  | none => false

def is_at_atomic_location (lk1 : CerbMem.PointerValue → location_kind) (a : action) : Bool :=
  match loc_of a with
  | some l => (lk1 l == Atomic0)
  | none => false

/- *************************************** -/
/-   - 2.5 - Well formed action -/
/- *************************************** -/

/- used in cppmem -/
def locations_of (actions1 : Pset action) : Pset CerbMem.PointerValue :=
  let x2 := setEmpty;
  setFold
    (fun (x1 : Option CerbMem.PointerValue) (x2 : Pset CerbMem.PointerValue) =>
      match x1 with
      | some l => (lem_if true then setAddBy setElemCompare l x2 else x2)
      | _ => x2)
    (let x2 := setEmpty;
     setFold
       (fun (a : action) (x2 : Pset (Option CerbMem.PointerValue)) =>
         lem_if true then setAddBy setElemCompare (loc_of a) x2 else x2) actions1 x2) x2

def well_formed_action (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ =>
    (setMemberBy defaultCompare mo1
      (setFromListBy setElemCompare [NA, Relaxed, Acquire, Seq_cst, Consume]))
  | Store _ _ mo1 _ _ =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [NA, Relaxed, Release, Seq_cst]))
  | RMW _ _ mo1 _ _ _ =>
    (setMemberBy defaultCompare mo1
      (setFromListBy setElemCompare [Relaxed, Release, Acquire, Acq_rel, Seq_cst]))
  | Fence _ _ mo1 =>
    (setMemberBy defaultCompare mo1
      (setFromListBy setElemCompare [Relaxed, Release, Acquire, Acq_rel, Consume, Seq_cst]))
  | _ => true

/- ********************************************** -/
/-  - 2.6 - Well formed threads and some assumptions -/
/- ********************************************** -/

def assumptions (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, Xw, _) =>
    finite_prefixes Xw.rf Xo.actions &&
      (finite_prefixes Xw.mo Xo.actions &&
        (finite_prefixes Xw.sc Xo.actions && finite_prefixes Xw.lo Xo.actions))

def blocking_observed (actions1 : Pset action) (sb1 : Pset (action × action)) : Bool :=
  (setForAll
    (fun (a : action) =>
      ((not (is_blocked_rmw a || is_blocked_lock a)) || not
        (setAny
          (fun (b : action) =>
            (setMemberBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b) sb1))
          actions1))) actions1)

/- Indeterminate sequencing from 1.9p15, noting that all atomic and
lock calls are functions. -/
def indeterminate_sequencing (Xo : pre_execution) : Bool :=
  setForAll
    (fun (a : action) =>
      setForAll
        (fun (b : action) =>
          ((not
            ((tid_of a == tid_of b) &&
              ((((fun (x : action) (y : action) => not (x == y)) a b)) && not
                (is_at_non_atomic_location Xo.lk a && is_at_non_atomic_location Xo.lk b)))) ||
            ((setMemberBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
              Xo.sb) ||
              (setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (b, a)
                Xo.sb)))) Xo.actions) Xo.actions

def sbasw (Xo : pre_execution) : Pset (action × action) :=
  (set_tcByCmp
    (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
    ((setUnionBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) Xo.sb Xo.asw)))

/- 7.22.3 p1 "Each such allocation shall yield a pointer to an object disjoint from any other object."  /- CSEM -/
   When we are going to make a distinction between regions and objects we have to revise this           /- CSEM -/
   (7.22.3 p1 says that the objects do not overlap, so only unused parts of                             /- CSEM -/
   the malloced regions overlap and that might be not-racy. -/ /- CSEM -/
def disjoint_allocs (actions1 : Pset action) : Bool := /- CSEM -/
  (setForAll
    (fun (a : action) =>
      setForAll
        (fun (b : action) =>
          ((not
            (is_alloc a &&
              (is_alloc b && ((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b)))))) ||
            (a == b))) actions1) actions1) /- CSEM -/
def well_formed_threads (p : (pre_execution × execution_witness × relation_list)) : Bool :=
  match p with
  | ((Xo, _, _) : (pre_execution × execution_witness × relation_list)) =>
    (setForAll (fun (a : action) => well_formed_action a) Xo.actions) &&
      (actions_respect_location_kinds Xo.actions Xo.lk &&
        (blocking_observed Xo.actions Xo.sb &&
          (inj_on aid_of Xo.actions &&
            (relation_over Xo.actions Xo.sb &&
              (relation_over Xo.actions Xo.asw &&
                (threadwise Xo.actions Xo.sb &&
                  (interthread Xo.actions Xo.asw &&
                    (isStrictPartialOrder Xo.sb &&
                      (isStrictPartialOrder Xo.dd &&
                        ((setSubsetBy
                          (pairCompare
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                          Xo.dd Xo.sb) &&
                          (indeterminate_sequencing Xo &&
                            (isIrreflexive (sbasw Xo) &&
                              (finite_prefixes (sbasw Xo) Xo.actions && disjoint_allocs
                                Xo.actions))))))))))))) /- CSEM -/

