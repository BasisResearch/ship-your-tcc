/- Footprints -/

abbrev footprint0 := footprint_impl

/- Instead of changing the type of actions to include a footprint, we
   use a projection function from locations (see
   csem/notes/notes39). -/

def footprint_of_loc : location_impl → footprint_impl := footprint_of_loc_impl
/- We use the following functions to manipulate footprints. -/

def footprint_leq0 : footprint_impl → footprint_impl → Bool := footprint_leq_impl
def footprint_empty : footprint_impl := footprint_empty_impl
def footprint_is_empty : footprint_impl → Bool := footprint_is_empty_impl
def footprint_difference : footprint_impl → footprint_impl → footprint_impl :=
  footprint_difference_impl
def footprint_intersection : footprint_impl → footprint_impl → footprint_impl :=
  footprint_intersection_impl
def footprint_bigunion : Pset footprint_impl → footprint_impl := footprint_bigunion_impl
def footprint_of (a : action) : footprint_impl :=
  match loc_of a with
  | none => footprint_empty
  | some l => footprint_of_loc l

/- We combine the values of the writes where a read reads from with
   the following function. -/

def combine_cvalues0 : Pset (cvalue × footprint0 × footprint0) → Option CerbMem.MemValue :=
  combine_cvalues_impl

/- ********************************************** -/

/- We model the readsfrom relation as follows, see csem/notes/notes40
   and notes39 for a discussion of the alternatives. -/

structure execution_witness_fp where
  rf_fp : Pset (action × footprint0 × action)
  mo_fp : Pset (action × action)
  sc_fp : Pset (action × action)
  lo_fp : Pset (action × action)
  tot_fp : Pset (action × action)
  deriving BEq, Ord
instance : Inhabited execution_witness_fp where
  default :=
    { rf_fp := default, mo_fp := default, sc_fp := default, lo_fp := default, tot_fp := default }
instance (priority := 500) : Lem_Basic_classes.SetType execution_witness_fp where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 execution_witness_fp where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 execution_witness_fp where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def aid_of_rel2_fp (s : Pset (action × footprint_impl × action)) : Pset (Nat × footprint_impl) :=
  (setMapBy (pairCompare defaultCompare defaultCompare)
    (fun (p : (action × footprint_impl × action)) =>
      match p with
      | (w, f, r) => (aid_of w, f)) s)

instance : Show execution_witness_fp where

    show0 wit :=
      String.append "rf: "
        (String.append
          (stringFromSet (stringFromPair Lem_String_extra.stringFromNat (fun x=> "FOOTPRINT"))
            (aid_of_rel2_fp wit.rf_fp))
          (String.append ", mo: "
            (String.append
              (stringFromSet
                (stringFromPair Lem_String_extra.stringFromNat Lem_String_extra.stringFromNat)
                (aid_of_rel2 wit.mo_fp))
              (String.append ", sc: "
                (String.append
                  (stringFromSet
                    (stringFromPair Lem_String_extra.stringFromNat Lem_String_extra.stringFromNat)
                    (aid_of_rel2 wit.sc_fp))
                  (String.append ", lo: "
                    (String.append
                      (stringFromSet
                        (stringFromPair Lem_String_extra.stringFromNat
                          Lem_String_extra.stringFromNat) (aid_of_rel2 wit.lo_fp))
                      (String.append ", tot: "
                        (stringFromSet
                          (stringFromPair Lem_String_extra.stringFromNat
                            Lem_String_extra.stringFromNat) (aid_of_rel2 wit.tot_fp))))))))))

def execution_witness_fp_setElemCompare
    (cmpa : Pset (action × footprint0 × action) → Pset (action × footprint0 × action) → LemOrdering)
    (cmpb : Pset (action × action) → Pset (action × action) → LemOrdering)
    (x : execution_witness_fp) (y : execution_witness_fp) :
    LemOrdering :=
  pairCompare cmpa (pairCompare cmpb (pairCompare cmpb (pairCompare cmpb cmpb)))
    (x.rf_fp, (x.mo_fp, (x.sc_fp, (x.lo_fp, x.tot_fp))))
    (y.rf_fp, (y.mo_fp, (y.sc_fp, (y.lo_fp, y.tot_fp))))

instance : SetType execution_witness_fp where

    setElemCompare x y :=
      execution_witness_fp_setElemCompare
        (setCompareBy
          (tripleCompare (fun x y=> defaultCompare (aid_of x) (aid_of y)) defaultCompare (fun x y=>
            defaultCompare (aid_of x) (aid_of y))))
        (setCompareBy
          (pairCompare (fun x y=> defaultCompare (aid_of x) (aid_of y)) (fun x y=>
            defaultCompare (aid_of x) (aid_of y)))) x y

def project_witness_fp (wit : execution_witness_fp) : execution_witness :=
  (({ rf :=
        (setMapBy
          (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
            (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
          (fun (p : (action × footprint_impl × action)) =>
            match p with
            | (w, f, r) => (w, r)) wit.rf_fp),
      mo := wit.mo_fp,
      sc := wit.sc_fp,
      lo := wit.lo_fp,
      tot := wit.tot_fp } : execution_witness))

structure relation_list_fp where
  /- The name hb clashes with variable names hb in Isabelle (same for
   vse). -/
  hb_fp : Pset (action × action)
  vse_fp : Pset (action × footprint0 × action)
  rest : relation_list /- TODO: find a better name -/
  deriving BEq, Ord
instance : Inhabited relation_list_fp where
  default := { hb_fp := default, vse_fp := default, rest := default }
instance (priority := 500) : Lem_Basic_classes.SetType relation_list_fp where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 relation_list_fp where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 relation_list_fp where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

def relation_list_fp_eq (x : relation_list_fp) (y : relation_list_fp) : Bool :=
  pairEqual (x.hb_fp, (x.vse_fp, x.rest)) (y.hb_fp, (y.vse_fp, y.rest))

instance : Eq0 relation_list_fp where

    isEqual x y := relation_list_fp_eq x y

    isInequal x y := not (relation_list_fp_eq x y)

def relation_list_fp_setElemCompare { a : Type }
    (cmp :
      (Pset (action × action) ×
        (Pset (action × footprint0 × action) × List (String × Pset (action × action)))) →
      (Pset (action × action) ×
        (Pset (action × footprint0 × action) × List (String × Pset (action × action)))) → a)
    (x : relation_list_fp) (y : relation_list_fp) :
    a :=
  cmp (x.hb_fp, (x.vse_fp, x.rest)) (y.hb_fp, (y.vse_fp, y.rest))

instance : SetType relation_list_fp where

    setElemCompare x y :=
      relation_list_fp_setElemCompare
        (pairCompare
          (setCompareBy
            (pairCompare (fun x y=> defaultCompare (aid_of x) (aid_of y)) (fun x y=>
              defaultCompare (aid_of x) (aid_of y))))
          (pairCompare
            (setCompareBy
              (tripleCompare (fun x y=> defaultCompare (aid_of x) (aid_of y)) defaultCompare
                (fun x y=> defaultCompare (aid_of x) (aid_of y))))
            (lexicographicCompareBy
              (pairCompare defaultCompare
                (setCompareBy
                  (pairCompare (fun x y=> defaultCompare (aid_of x) (aid_of y)) (fun x y=>
                    defaultCompare (aid_of x) (aid_of y)))))))) x y

def project_relation_list_fp (l : relation_list_fp) : List (String × Pset (action × action)) :=
  let new_vse :=
    (setMapBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      (fun (p : (action × footprint_impl × action)) =>
        match p with
        | (w, f, r) => (w, r)) l.vse_fp);
  ("hb", l.hb_fp) :: (("vse", new_vse) :: l.rest)

abbrev candidate_execution_fp := (pre_execution × execution_witness_fp × relation_list_fp)

def project_candidate_execution_fp (p : (pre_execution × execution_witness_fp × relation_list_fp)) :
    (pre_execution × execution_witness × List (String × Pset (action × action))) :=
  match p with
  | (Xo, Xw, rel1) => (Xo, project_witness_fp Xw, project_relation_list_fp rel1)

abbrev observable_execution_fp := (pre_execution × execution_witness_fp)

/- Because the type of candidate execution changed, we need a
   footprint-variant of the rest of the framework as well. -/

inductive named_predicate_tree_fp : Type where
  | Leaf_fp : (candidate_execution_fp → Bool) → named_predicate_tree_fp
  | Leaf_non_fp : (candidate_execution → Bool) → named_predicate_tree_fp
  | Node_fp : List (String × named_predicate_tree_fp) → named_predicate_tree_fp
export named_predicate_tree_fp (Leaf_fp Leaf_non_fp Node_fp)
instance : Inhabited named_predicate_tree_fp where
  default := Leaf_fp (fun (x7 : candidate_execution_fp) => default)
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def named_predicate_tree_fp.ctor_rank_ocaml : named_predicate_tree_fp → Nat
  | .Leaf_fp _ => 0
  | .Leaf_non_fp _ => 1
  | .Node_fp _ => 2
mutual
def named_predicate_tree_fp.beq_derived (cmpx_ cmpy_ : named_predicate_tree_fp) : Bool :=
  match cmpx_, cmpy_ with
  | .Leaf_fp x1, .Leaf_fp y1 => lemFunctionalBeq x1 y1
  | .Leaf_non_fp x1, .Leaf_non_fp y1 => lemFunctionalBeq x1 y1
  | .Node_fp x1, .Node_fp y1 => named_predicate_tree_fp.beq_deriv_aux2 x1 y1
  | _, _ => false
termination_by structural cmpx_
def named_predicate_tree_fp.compare_derived (cmpx_ cmpy_ : named_predicate_tree_fp) : Ordering :=
  match cmpx_, cmpy_ with
  | .Leaf_fp x1, .Leaf_fp y1 => lemFunctionalCompare x1 y1
  | .Leaf_non_fp x1, .Leaf_non_fp y1 => lemFunctionalCompare x1 y1
  | .Node_fp x1, .Node_fp y1 => named_predicate_tree_fp.cmp_deriv_aux1 x1 y1
  | xg, yg =>
    Ord.compare (named_predicate_tree_fp.ctor_rank_ocaml xg)
      (named_predicate_tree_fp.ctor_rank_ocaml yg)
termination_by structural cmpx_
def named_predicate_tree_fp.cmp_deriv_aux1
    (cmpx_ cmpy_ : List ((String × named_predicate_tree_fp))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => named_predicate_tree_fp.compare_derived x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => named_predicate_tree_fp.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def named_predicate_tree_fp.beq_deriv_aux2
    (cmpx_ cmpy_ : List ((String × named_predicate_tree_fp))) :
    Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    x1 == y1 && named_predicate_tree_fp.beq_derived x2 y2 && named_predicate_tree_fp.beq_deriv_aux2
      xs0 ys0
  | _, _ => false
termination_by structural cmpx_
end

instance : BEq named_predicate_tree_fp where
  beq := named_predicate_tree_fp.beq_derived
instance : Ord named_predicate_tree_fp where
  compare := named_predicate_tree_fp.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType named_predicate_tree_fp where
  setElemCompare x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 named_predicate_tree_fp where
  isEqual := named_predicate_tree_fp.beq_derived
  isInequal x y := !(named_predicate_tree_fp.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 named_predicate_tree_fp where
  compare x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match named_predicate_tree_fp.compare_derived x y with
    | .lt => false
    | _ => true
/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def named_predicate_tree_fp.lemSize (sizex_ : named_predicate_tree_fp) : Nat :=
  match sizex_ with
  | .Leaf_fp _ => 1
  | .Leaf_non_fp _ => 1
  | .Node_fp x1 => 1 + named_predicate_tree_fp.lemSize_aux1 x1
termination_by structural sizex_
def named_predicate_tree_fp.lemSize_aux1 (sizex_ : List ((String × named_predicate_tree_fp))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 =>
    1 + named_predicate_tree_fp.lemSize x1 + named_predicate_tree_fp.lemSize_aux1 xs0
termination_by structural sizex_
end

partial def apply_tree_fp_aux (pred_tree : named_predicate_tree_fp)
    (ex_fp : (pre_execution × execution_witness_fp × relation_list_fp))
    (ex : (pre_execution × execution_witness × relation_list)) :
    Bool :=
  match pred_tree with
  | Leaf_fp p => p ex_fp
  | Leaf_non_fp p => p ex
  | Node_fp l =>
    List.all l (fun (p : (String × named_predicate_tree_fp)) =>
      match p with
      | (_, branch) => apply_tree_fp_aux branch ex_fp ex)

def apply_tree_fp (tree : named_predicate_tree_fp)
    (ex_fp : (pre_execution × execution_witness_fp × relation_list_fp)) :
    Bool :=
  apply_tree_fp_aux tree ex_fp (project_candidate_execution_fp ex_fp)

