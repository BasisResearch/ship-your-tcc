def visible_side_effect_set (actions1 : Pset action) (hb : Pset (action × action)) :
    Pset (action × action) :=
  let x2 := setEmpty;
  setFold
    (fun (p : (action × action)) (x2 : Pset (action × action)) =>
      match p, x2 with
      | (a, b), x2 =>
        (lem_if is_write a &&
            (is_read b &&
              (((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) && not
                (setAny
                  (fun (c : action) =>
                    not
                      ((setMemberBy
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) c
                        (setFromListBy setElemCompare [a, b]))) &&
                      (is_write c &&
                        (((maybeEqualBy (fun x y => x == y) (loc_of c) (loc_of b))) &&
                          ((setMemberBy
                            (pairCompare
                              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                              (fun (x : action) (y : action)=>
                                defaultCompare (aid_of x) (aid_of y))) (a, c) hb) &&
                            (setMemberBy
                              (pairCompare
                                (fun (x : action) (y : action)=>
                                  defaultCompare (aid_of x) (aid_of y))
                                (fun (x : action) (y : action)=>
                                  defaultCompare (aid_of x) (aid_of y))) (c, b) hb)))))
                  actions1))) then
          setAddBy setElemCompare (a, b) x2
        else
          x2)) hb x2
def det_read (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, Xw, _ :: ("vse", vse) :: _) =>
    setForAll
      (fun (r : action) =>
        ((not (is_load r)) ||
          ((setAny
            (fun (w : action) =>
              (setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (w, r)
                vse)) Xo.actions) ==
            (setAny
              (fun (w' : action) =>
                (setMemberBy
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (w', r)
                  Xw.rf)) Xo.actions)))) Xo.actions
  | (_, _, []) =>
    (failwithI
      "Incomplete Pattern at File \"frontend/concurrency/cmm_csem.lem\", line 1195, character 1 to line 1199, character 50" :
      Bool)
  | (_, _, _ :: []) =>
    (failwithI
      "Incomplete Pattern at File \"frontend/concurrency/cmm_csem.lem\", line 1195, character 1 to line 1199, character 50" :
      Bool)
  | (_, _, _ :: (_, _) :: _) =>
    (failwithI
      "Incomplete Pattern at File \"frontend/concurrency/cmm_csem.lem\", line 1195, character 1 to line 1199, character 50" :
      Bool)
