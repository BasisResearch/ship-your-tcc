            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [NA, Release, Relaxed])))
            | RMW _ _ mo1 _ _ _ =>
              ((setMemberBy defaultCompare mo1
                (setFromListBy setElemCompare [Acq_rel, Acquire, Release, Relaxed])))
            | Fence _ _ _ => false
            | Blocked_rmw _ _ _ => true
            | Alloc _ _ _ => false /- CSEM -/
            | Dealloc _ _ _ => false /- CSEM -/) Xo.actions) Xs

def release_acquire_relaxed_synchronizes_with { a b : Type } [SetType a] (actions1 : Pset a)
    (sb1 : b) (asw1 : Pset (action × action)) (rf1 : Pset (a × action))
    (lo1 : Pset (action × action)) (rs : Pset (action × a)) (a1 : action) (b1 : action) :
    Bool :=
  (not ((tid_of a1) == (tid_of b1))) &&
    ((setMemberBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      /- thread sync -/ (a1, b1) asw1) ||
      (/- mutex sync -/ (is_unlock a1 &&
