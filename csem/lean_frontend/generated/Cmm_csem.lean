def atomic_initialisation_before_all
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, _, _) =>
    setForAll
      (fun (a : action) =>
        setForAll
          (fun (b : action) =>
            ((not
              (is_at_atomic_location Xo.lk a &&
                (is_NA_store a &&
                  (((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) &&
                    (((fun (x : action) (y : action) => not (x == y)) a b)))))) ||
              (((setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                (set_tcByCmp
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                  ((setUnionBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) Xo.sb
                    Xo.asw))))) && not (is_NA_store b)))) Xo.actions) Xo.actions
def bounded_executions (Xs : Pset candidate_execution) : Bool := true
def tot_condition (Xs : Pset candidate_execution) : Bool :=
  bounded_executions Xs && setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        atomic_initialisation_before_all (Xo, Xw, rl) && setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [NA, Seq_cst])))
            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [NA, Seq_cst])))
            | RMW _ _ mo1 _ _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Seq_cst])))
            | Fence _ _ mo1 => false
            | Blocked_rmw _ _ _ => true
            | Alloc _ _ _ => false /- CSEM -/
            | Dealloc _ _ _ => false /- CSEM -/) Xo.actions) Xs

