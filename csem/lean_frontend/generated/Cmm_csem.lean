def standard_relations (Xo : pre_execution) (Xw : execution_witness) :
    List (String × Pset (action × action)) :=
  let hrs := hypothetical_release_sequence_set Xo.actions Xo.lk Xw.mo;
  let rs := release_sequence_set Xo.actions Xo.lk Xw.mo;
  let sw := release_acquire_fenced_synchronizes_with_set Xo.actions Xo.sb Xo.asw Xw.rf Xw.lo rs hrs;
  let cad := with_consume_cad_set Xo.actions Xo.sb Xo.dd Xw.rf;
  let dob := with_consume_dob_set Xo.actions Xw.rf rs cad;
  let ithb := inter_thread_happens_before Xo.actions Xo.sb sw dob;
  let hb := happens_before Xo.actions Xo.sb ithb;
  let vse := visible_side_effect_set Xo.actions hb;
  let vsses := standard_vsses Xo.actions Xo.lk Xw.mo hb vse;
  [("hb", hb), ("vse", vse), ("ithb", ithb), ("vsses", vsses), ("sw", sw), ("rs", rs), ("hrs", hrs),
    ("dob", dob), ("cad", cad)]
