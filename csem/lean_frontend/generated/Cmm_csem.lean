                  (is_write b &&
                    (((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) &&
                      (((fun (x : action) (y : action) => not (x == y)) a b))))))) ||
              (((setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                (set_tcByCmp
                  (pairCompare
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                    (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                  ((setUnionBy
                    (pairCompare
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                      (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) Xo.sb
                    Xo.asw))))) && not (is_NA_store b)))) Xo.actions) Xo.actions
def release_acquire_condition (Xs : Pset candidate_execution) : Bool :=
  setForAll
    (fun (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) =>
      match p with
      | (Xo, Xw, rl) =>
        atomic_initialisation_first (Xo, Xw, rl) && setForAll
          (fun (a : action) =>
            match a with
            | Lock _ _ _ _ => true
            | Unlock _ _ _ => true
            | Load _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [NA, Acquire])))
            | Store _ _ mo1 _ _ =>
              ((setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [NA, Release])))
            | RMW _ _ mo1 _ _ _ => mo1 == Acq_rel
            | Fence _ _ _ => false
            | Blocked_rmw _ _ _ => true
            | Alloc _ _ _ => false /- CSEM -/
            | Dealloc _ _ _ => false /- CSEM -/) Xo.actions) Xs

def release_acquire_synchronizes_with { a b : Type } (actions1 : a) (sb1 : b)
    (asw1 : Pset (action × action)) (rf1 : Pset (action × action)) (lo1 : Pset (action × action))
    (a1 : action) (b1 : action) :
    Bool :=
  (not ((tid_of a1) == (tid_of b1))) &&
    ((setMemberBy
      (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
      /- thread sync -/ (a1, b1) asw1) ||
      (/- mutex sync -/ (is_unlock a1 &&
        (is_lock b1 &&
          (setMemberBy
            (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
              (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a1, b1)
            lo1))) ||
        /- rel/acq sync -/ (is_release a1 &&
          (is_acquire b1 &&
            (setMemberBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a1, b1)
              rf1)))))

def release_acquire_synchronizes_with_set { a : Type } (actions1 : Pset action) (sb1 : a)
    (asw1 : Pset (action × action)) (rf1 : Pset (action × action)) (lo1 : Pset (action × action)) :
    Pset (action × action) :=
  let x2 := setEmpty;
  setFold
    (fun (a : action) (x2 : Pset (action × action)) =>
      setFold
        (fun (b : action) (x2 : Pset (action × action)) =>
          lem_if release_acquire_synchronizes_with actions1 sb1 asw1 rf1 lo1 a b then
            setAddBy setElemCompare (a, b) x2
          else
            x2) actions1 x2) actions1 x2

def release_acquire_relations (Xo : pre_execution) (Xw : execution_witness) :
    List (String × Pset (action × action)) :=
  let sw := release_acquire_synchronizes_with_set Xo.actions Xo.sb Xo.asw Xw.rf Xw.lo;
  let hb := no_consume_hb Xo.sb sw;
  let vse := visible_side_effect_set Xo.actions hb;
  [("hb", hb), ("vse", vse), ("sw", sw)]
