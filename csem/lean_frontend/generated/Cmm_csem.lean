def tot_consistent_locks
    (p : (pre_execution × execution_witness × List (String × Pset (action × action)))) :
    Bool :=
  match p with
  | (Xo, Xw, _) =>
    (setForAll
      (fun (p : (action × action)) =>
        match p with
        | (a, c) =>
          ((not
            (is_successful_lock a &&
              (is_successful_lock c &&
                ((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of c)))))) ||
            (setAny
              (fun (b : action) =>
                ((maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) &&
                  (is_unlock b &&
                    ((setMemberBy
                      (pairCompare
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                        (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                      (a, b) Xw.tot) &&
                      (setMemberBy
                        (pairCompare
                          (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                          (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)))
                        (b, c) Xw.tot)))) Xo.actions))) Xw.tot)
def tot_consistent_tot
