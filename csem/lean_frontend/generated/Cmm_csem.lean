/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def named_predicate_tree.lemSize (sizex_ : named_predicate_tree) : Nat :=
  match sizex_ with
  | .Leaf _ => 1
  | .Node x1 => 1 + named_predicate_tree.lemSize_aux1 x1
termination_by structural sizex_
def named_predicate_tree.lemSize_aux1 (sizex_ : List ((String × named_predicate_tree))) : Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + named_predicate_tree.lemSize x1 + named_predicate_tree.lemSize_aux1 xs0
termination_by structural sizex_
end

partial def apply_tree (pred_tree : named_predicate_tree)
    (X : (pre_execution × execution_witness × relation_list)) :
    Bool :=
  match pred_tree with
  | Leaf p => p X
  | Node l =>
    List.all l (fun (p : (String × named_predicate_tree)) =>
      match p with
      | (name1, branch) => apply_tree branch X)

inductive fault_setgen : Type where
  |
    One0 : (String × (candidate_execution → Pset action)) → fault_setgen
  | Two : (String × (candidate_execution → Pset (action × action))) → fault_setgen
export fault_setgen (One0 Two)
