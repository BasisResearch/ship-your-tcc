/- The unpack functions are not used in the model itself, but are probably 
   needed by every user of the model. -/

def not_alloc_or_dealloc : action → Bool :=
  fun (x : action) =>
    match x with /- CSEM -/
    | Lock _ _ _ _ => true /- CSEM -/
    | Unlock _ _ _ => true /- CSEM -/
    | Load _ _ _ _ _ => true /- CSEM -/
    | Store _ _ _ _ _ => true /- CSEM -/
    | RMW _ _ _ _ _ _ => true /- CSEM -/
    | Fence _ _ _ => true /- CSEM -/
    | Blocked_rmw _ _ _ => true /- CSEM -/
    | Alloc _ _ _ => false /- CSEM -/
    | Dealloc _ _ _ => false /- CSEM -/
                                  /- CSEM -/

def is_fault (faults_list : List fault_setgen)
    (p : (pre_execution × execution_witness × List (String × Pset (action × action))))
    (a : action) :
    Bool :=
  match faults_list, p, a with
  | faults_list, (Xo, Xw, rl), a =>
    (let is_particular_fault : fault_setgen → Bool :=
       (fun (f : fault_setgen) =>
         match f with
         | One0 (_name, setgen) =>
           ((setMemberBy (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y)) a
             (setgen (Xo, Xw, rl))))
         | Two (_name, setgen) =>
           setAny
             (fun (b : action) =>
               ((setMemberBy
                 (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                   (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
                 (setgen (Xo, Xw, rl)))) ||
                 ((setMemberBy
                   (pairCompare
                     (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                     (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (b, a)
                   (setgen (Xo, Xw, rl))))) Xo.actions);
     List.any faults_list is_particular_fault)

def each_empty (faults_list : List fault_setgen)
    (X : (pre_execution × execution_witness × relation_list)) :
    Bool :=
  let faults_empty : fault_setgen → Bool :=
    (fun (f : fault_setgen) =>
      match f with
      | One0 (_name, setgen) => setIsEmpty (setgen X)
      | Two (_name, setgen) => setIsEmpty (setgen X));
  List.all faults_list faults_empty
/- FORK F3 (2026-09-24; base 0a6d59eed): the 23 LemUnsupported.Cmm.* reps below
   belong to {hol; isabelle; tex}-only definitions, which Lean never renders.
   They provide no Lean implementation or concurrency support. -/

def tid_of (a : action) : Nat :=
  match a with
  | Lock _ tid1 _ _ => tid1
  | Unlock _ tid1 _ => tid1
  | Load _ tid1 _ _ _ => tid1
  | Store _ tid1 _ _ _ => tid1
  | RMW _ tid1 _ _ _ _ => tid1
  | Fence _ tid1 _ => tid1
  | Blocked_rmw _ tid1 _ => tid1
  | Alloc _ tid1 _ => tid1 /- CSEM -/
  | Dealloc _ tid1 _ => tid1 /- CSEM -/

def loc_of (a : action) : Option CerbMem.PointerValue :=
  match a with
  | Lock _ _ l _ => some l
  | Unlock _ _ l => some l
  | Load _ _ _ l _ => some l
  | Store _ _ _ l _ => some l
  | RMW _ _ _ l _ _ => some l
  | Fence _ _ _ => none
  | Blocked_rmw _ _ l => some l
  | Alloc _ _ l => some l /- CSEM -/
  | Dealloc _ _ l => some l /- CSEM -/

def value_read_by (a : action) : Option CerbMem.MemValue :=
  match a with
  | Load _ _ _ _ v => some v
  | RMW _ _ _ _ v _ => some v
  | _ => none

def value_written_by (a : action) : Option CerbMem.MemValue :=
  match a with
  | Store _ _ _ _ v => some v
  | RMW _ _ _ _ _ v => some v
  | _ => none

def is_lock (a : action) : Bool :=
  match a with
  | Lock _ _ _ _ => true
  | _ => false

def is_successful_lock (a : action) : Bool :=
  match a with
  | Lock _ _ _ Locked => true
  | _ => false

def is_blocked_lock (a : action) : Bool :=
  match a with
  | Lock _ _ _ Blocked => true
  | _ => false

def is_unlock (a : action) : Bool :=
  match a with
  | Unlock _ _ _ => true
  | _ => false

def is_atomic_load (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ => mo1 != NA
  | _ => false

def is_atomic_store (a : action) : Bool :=
  match a with
  | Store _ _ mo1 _ _ => mo1 != NA
  | _ => false

def is_RMW (a : action) : Bool :=
  match a with
  | RMW _ _ _ _ _ _ => true
  | _ => false

def is_blocked_rmw (a : action) : Bool :=
  match a with
  | Blocked_rmw _ _ _ => true
  | _ => false

def is_NA_load (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ => mo1 == NA
  | _ => false

def is_NA_store (a : action) : Bool :=
  match a with
  | Store _ _ mo1 _ _ => mo1 == NA
  | _ => false

def is_load (a : action) : Bool :=
  match a with
  | Load _ _ _ _ _ => true
  | _ => false

def is_store (a : action) : Bool :=
  match a with
  | Store _ _ _ _ _ => true
  | _ => false

def is_fence (a : action) : Bool :=
  match a with
  | Fence _ _ _ => true
  | _ => false

def is_alloc (a : action) : Bool := /- CSEM -/
  match a with /- CSEM -/
  | Alloc _ _ _ => true /- CSEM -/
  | _ => false /- CSEM -/
                       /- CSEM -/

def is_dealloc (a : action) : Bool := /- CSEM -/
  match a with /- CSEM -/
  | Dealloc _ _ _ => true /- CSEM -/
  | _ => false /- CSEM -/
                        /- CSEM -/

def is_atomic_action (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ => mo1 != NA
  | Store _ _ mo1 _ _ => mo1 != NA
  | RMW _ _ _ _ _ _ => true
  | Blocked_rmw _ _ _ => true
  | _ => false

def is_read (a : action) : Bool :=
  match a with
  | Load _ _ _ _ _ => true
  | RMW _ _ _ _ _ _ => true
  | _ => false

def is_write (a : action) : Bool :=
  match a with
  | Store _ _ _ _ _ => true
  | RMW _ _ _ _ _ _ => true
  | _ => false

/- It is important to note that seq_cst atomics are both acquires and releases -/

def is_acquire (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Acquire, Seq_cst]))
  | RMW _ _ mo1 _ _ _ =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Acquire, Acq_rel, Seq_cst]))
  | Fence _ _ mo1 =>
    (setMemberBy defaultCompare mo1
      (setFromListBy setElemCompare [Acquire, Consume, Acq_rel, Seq_cst]))
  | _ => false

def is_release (a : action) : Bool :=
  match a with
  | Store _ _ mo1 _ _ =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Release, Seq_cst]))
  | RMW _ _ mo1 _ _ _ =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Release, Acq_rel, Seq_cst]))
  | Fence _ _ mo1 =>
    (setMemberBy defaultCompare mo1 (setFromListBy setElemCompare [Release, Acq_rel, Seq_cst]))
  | _ => false

def is_consume (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ => mo1 == Consume
  | _ => false

def is_seq_cst (a : action) : Bool :=
  match a with
  | Load _ _ mo1 _ _ => mo1 == Seq_cst
  | Store _ _ mo1 _ _ => mo1 == Seq_cst
  | RMW _ _ mo1 _ _ _ => mo1 == Seq_cst
  | Fence _ _ mo1 => mo1 == Seq_cst
  | _ => false

def threadwise { a : Type } (s : a) (rel1 : Pset (action × action)) : Bool :=
  setForAll
    (fun (p : (action × action)) =>
      match p with
      | (a, b) => tid_of a == tid_of b) rel1

def interthread { a : Type } (s : a) (rel1 : Pset (action × action)) : Bool :=
  setForAll
    (fun (p : (action × action)) =>
      match p with
      | (a, b) => not ((tid_of a) == (tid_of b))) rel1

def locationwise { a : Type } (s : a) (rel1 : Pset (action × action)) : Bool :=
  setForAll
    (fun (p : (action × action)) =>
      match p with
      | (a, b) => (maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) rel1

def per_location_total (s : Pset action) (rel1 : Pset (action × action)) : Bool :=
  setForAll
    (fun (a : action) =>
      setForAll
        (fun (b : action) =>
          ((not (maybeEqualBy (fun x y => x == y) (loc_of a) (loc_of b))) ||
            ((setMemberBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (a, b)
              rel1) ||
              ((setMemberBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) (b, a)
                rel1) || (a == b))))) s) s

