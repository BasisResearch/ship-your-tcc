  match p with
  | (Xo, Xw, _) =>
    relation_over Xo.actions Xw.tot &&
      (isTransitive Xw.tot &&
        (isIrreflexive Xw.tot &&
          (isTrichotomousOn Xw.tot Xo.actions &&
            ((setSubsetBy
              (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) Xo.sb
              Xw.tot) &&
              ((setSubsetBy
                (pairCompare (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))
                  (fun (x : action) (y : action)=> defaultCompare (aid_of x) (aid_of y))) Xo.asw
                Xw.tot) && finite_prefixes Xw.tot Xo.actions)))))
