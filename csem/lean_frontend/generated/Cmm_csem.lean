  |
    Leaf : (candidate_execution → Bool) → named_predicate_tree
  | Node : List (String × named_predicate_tree) → named_predicate_tree
export named_predicate_tree (Leaf Node)
instance : Inhabited named_predicate_tree where
  default := Leaf (fun (x11 : candidate_execution) => default)
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def named_predicate_tree.ctor_rank_ocaml : named_predicate_tree → Nat
  | .Leaf _ => 0
  | .Node _ => 1
mutual
def named_predicate_tree.beq_derived (cmpx_ cmpy_ : named_predicate_tree) : Bool :=
  match cmpx_, cmpy_ with
  | .Leaf x1, .Leaf y1 => lemFunctionalBeq x1 y1
  | .Node x1, .Node y1 => named_predicate_tree.beq_deriv_aux2 x1 y1
  | _, _ => false
termination_by structural cmpx_
def named_predicate_tree.compare_derived (cmpx_ cmpy_ : named_predicate_tree) : Ordering :=
  match cmpx_, cmpy_ with
  | .Leaf x1, .Leaf y1 => lemFunctionalCompare x1 y1
  | .Node x1, .Node y1 => named_predicate_tree.cmp_deriv_aux1 x1 y1
  | xg, yg =>
    Ord.compare (named_predicate_tree.ctor_rank_ocaml xg) (named_predicate_tree.ctor_rank_ocaml yg)
termination_by structural cmpx_
def named_predicate_tree.cmp_deriv_aux1 (cmpx_ cmpy_ : List ((String × named_predicate_tree))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => named_predicate_tree.compare_derived x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => named_predicate_tree.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def named_predicate_tree.beq_deriv_aux2 (cmpx_ cmpy_ : List ((String × named_predicate_tree))) :
    Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    x1 == y1 && named_predicate_tree.beq_derived x2 y2 && named_predicate_tree.beq_deriv_aux2 xs0
      ys0
  | _, _ => false
termination_by structural cmpx_
end

