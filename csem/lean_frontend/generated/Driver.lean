             nd_bind (store sint "st_dev" CerbFS.fs_dev) (fun (_ : CerbMem.Footprint) =>
               nd_bind (store ulonglong "st_ino" CerbFS.fs_ino) (fun (_ : CerbMem.Footprint) =>
                 nd_bind (store ushort "st_mode" CerbFS.fs_mode) (fun (_ : CerbMem.Footprint) =>
                   nd_bind (store ushort "st_nlink" CerbFS.fs_nlink) (fun (_ : CerbMem.Footprint) =>
                     nd_bind (store uint "st_uid" CerbFS.fs_uid) (fun (_ : CerbMem.Footprint) =>
                       nd_bind (store uint "st_gid" CerbFS.fs_gid) (fun (_ : CerbMem.Footprint) =>
                         nd_bind (store sint "st_rdev" CerbFS.fs_rdev)
                           (fun (_ : CerbMem.Footprint) =>
                             (store slonglong "st_size" CerbFS.fs_size)))))))));
         match res with
         | Sum.inl e =>
           nd_bind (store_error e) (fun (_ : CerbMem.Footprint) =>
             update1 fs_st (th_st_from_int ((0 : Int) - (1 : Int))))
         | Sum.inr stat =>
           nd_bind (liftMem (update_mem stat)) (fun (_ : CerbMem.Footprint) =>
             update1 fs_st (th_st_from_int ((0 : Int))))));
  match fs_oper1 with
  | FS_MKDIR path mode1 => return3 (CerbFS.fs_mkdir dr_st.fs_state0 path mode1)
  | FS_OPEN path oflag mode_opt => return3 (CerbFS.fs_open dr_st.fs_state0 path oflag mode_opt)
  | FS_CLOSE fd => return3 (CerbFS.fs_close dr_st.fs_state0 fd)
  | FS_WRITE fd buf size =>
    (match Int.natAbs (lemIntFromInteger fd) with
     | 0 =>
       (failwithI "driver_fs_step: stdin not supported yet." : ndM Unit step_kind driver_error
         (mem_constraint CerbMem.IntegerValue) driver_state)
     | 1 => update_stdout (List.take (Int.natAbs (lemIntFromInteger size)) buf)
     | 2 => update_stderr (List.take (Int.natAbs (lemIntFromInteger size)) buf)
     | _ => return3 (CerbFS.fs_write dr_st.fs_state0 fd buf size))
  | FS_READ fd ptr size => store_buffer ptr (CerbFS.fs_read dr_st.fs_state0 fd size)
  | FS_PWRITE fd buf size off => return3 (CerbFS.fs_pwrite dr_st.fs_state0 fd buf size off)
  | FS_PREAD fd ptr size off => store_buffer ptr (CerbFS.fs_pread dr_st.fs_state0 fd size off)
  | FS_UMASK mode1 => return3 (CerbFS.fs_umask dr_st.fs_state0 mode1)
  | FS_CHMOD path mode1 => return3 (CerbFS.fs_chmod dr_st.fs_state0 path mode1)
  | FS_CHDIR path => return3 (CerbFS.fs_chdir dr_st.fs_state0 path)
  | FS_CHOWN path uid gid => return3 (CerbFS.fs_chown dr_st.fs_state0 path uid gid)
  | FS_LINK oldpath newpath => return3 (CerbFS.fs_link dr_st.fs_state0 oldpath newpath)
  | FS_READLINK path ptr max2 =>
    store_buffer_trunc ptr max2 (CerbFS.fs_readlink dr_st.fs_state0 path)
  | FS_STAT path ptr => store_stat ptr (CerbFS.fs_stat dr_st.fs_state0 path)
  | FS_LSTAT path ptr => store_stat ptr (CerbFS.fs_lstat dr_st.fs_state0 path)
  | FS_SYMLINK target lpath => return3 (CerbFS.fs_symlink dr_st.fs_state0 target lpath)
  | FS_RMDIR path => return3 (CerbFS.fs_rmdir dr_st.fs_state0 path)
  | FS_TRUNCATE path len => return3 (CerbFS.fs_truncate dr_st.fs_state0 path len)
  | FS_UNLINK path => return3 (CerbFS.fs_unlink dr_st.fs_state0 path)
  | FS_LSEEK fd off whence => return3 (CerbFS.fs_lseek dr_st.fs_state0 fd off whence)
  | FS_RENAME oldpath newpath => return3 (CerbFS.fs_rename dr_st.fs_state0 oldpath newpath)
  | FS_OPENDIR path => return3 (CerbFS.fs_opendir dr_st.fs_state0 path)
  | FS_READDIR dir => store_dir (CerbFS.fs_readdir dr_st.fs_state0 dir)
  | FS_REWINDDIR dir => update1 (CerbFS.fs_rewinddir dr_st.fs_state0 dir) (th_st_from_void ())
  | FS_CLOSEDIR dir => return3 (CerbFS.fs_closedir dr_st.fs_state0 dir)
  | FS_PRINTF fmt args =>
    nd_bind
      (liftMem
        ((printf _lemReader_enum_definitions _lemReader_tagDefs) th_st.current_loc
          ((printf_eval_conv _lemReader_enum_definitions _lemReader_tagDefs) dr_st th_st) fmt args))
      (fun (x : Sum (CerbLocation.Loc × cause) (t0 (List Char))) =>
        match x with
        | Sum.inl err =>
          (failwithI "TODO: printf error" : ndM Unit step_kind driver_error
            (mem_constraint CerbMem.IntegerValue) driver_state)
        | Sum.inr (Defined buf) => update_stdout buf
        | Sum.inr (Error loc1 str) => kill (Error0 loc1 str)
        | Sum.inr (Undef loc1 ubs) => kill (Undef0 loc1 ubs))
  | FS_VPRINTF fd fmt ap =>
    nd_bind
      (liftMem
        ((vprintf _lemReader_enum_definitions _lemReader_tagDefs) th_st.current_loc
          ((printf_eval_conv _lemReader_enum_definitions _lemReader_tagDefs) dr_st th_st) fmt ap))
      (fun (x : Sum (CerbLocation.Loc × cause) (t0 (List Char))) =>
        match x with
        | Sum.inl err =>
          (failwithI "TODO: vprintf error" : ndM Unit step_kind driver_error
            (mem_constraint CerbMem.IntegerValue) driver_state)
        | Sum.inr (Defined buf) =>
          (let size := Int.ofNat (List.length buf);
           match Int.natAbs (lemIntFromInteger fd) with
           | 0 =>
             (failwithI "vprintf trying to output in the stdin" : ndM Unit step_kind driver_error
               (mem_constraint CerbMem.IntegerValue) driver_state)
           | 1 => update_stdout buf
           | 2 => update_stderr buf
           | _ => return3 (CerbFS.fs_write dr_st.fs_state0 fd buf size))
        | Sum.inr (Error loc1 str) => kill (Error0 loc1 str)
        | Sum.inr (Undef loc1 ubs) => kill (Undef0 loc1 ubs))
  | FS_VSNPRINTF ptr size fmt ap =>
    nd_bind
      (liftMem
        ((vsnprintf _lemReader_enum_definitions _lemReader_tagDefs) th_st.current_loc
          ((printf_eval_conv _lemReader_enum_definitions _lemReader_tagDefs) dr_st th_st) ptr size
          fmt ap))
      (fun (x : Sum (CerbLocation.Loc × cause) (t0 Int)) =>
        match x with
        | Sum.inl err =>
          (failwithI "TODO: vprintf error" : ndM Unit step_kind driver_error
            (mem_constraint CerbMem.IntegerValue) driver_state)
        | Sum.inr (Defined n) => update1 dr_st.fs_state0 (th_st_from_int n)
        | Sum.inr (Error loc1 str) => kill (Error0 loc1 str)
        | Sum.inr (Undef loc1 ubs) => kill (Undef0 loc1 ubs))

/-
val     drive_core_thread2: Mem.thread_id -> driverM (maybe Core_reduction.core_step2)
let rec drive_core_thread2 tid =
  ND.get >>= fun dr_st ->
  let th_info = match List.lookup tid dr_st.core_state.Core_run.thread_states with
    | Just z ->
        z /- (tid, z) -/
    | _ ->
        error "drive_core_thread, wrong tid"
  end in
  ND.mk_step (SK_misc ["drive_core_thread2"]) $ List.map (function
    | Core_reduction.Step_thread_done2 parent_tid cval ->
        ( SK_misc ["thread_done("^ show tid ^")"]
        , /- DEBUG -/ ND.print_debug 6 [Debug.DB_driver_step] (fun () ->
            "thread " ^ show tid ^ " is done"
          ) >>= fun () ->
          let actions_of_current_thread: set Cmm.action =
            Set.filter (fun act ->
              Cmm.tid_of act = tid
            ) $ dr_st.concurrency_state.Cmm_op.symPre.Cmm.actions in
          let last_actions_of_current_thread: set Cmm.action =
            Set.filter (fun act ->
              not (Set.any (fun (act', _) ->
                act = act'
              ) dr_st.concurrency_state.Cmm_op.symPre.Cmm.sb)
            ) actions_of_current_thread in
          ND.update (fun dr_st -> <| dr_st with
            core_state= Core_run.kill_thread tid parent_tid (Set.map Cmm.aid_of last_actions_of_current_thread) cval dr_st.core_state;
            dr_step_counter= dr_st.dr_step_counter + 1;
          |>) >>= fun () ->
          drive_core_thread2 parent_tid )
    | (Core_reduction.Step_blocked2 as step) ->
        (SK_misc ["blocked("^show tid^")"], ND.return (Just step))
    | Core_reduction.Step_done2 cval ->
        ( SK_done, ND.return Nothing )
/-
        ( SK_done
        , get_thread_states >>= fun th_sts ->
          let th_st = match lookup tid th_sts with
            | Just (_, th_st) -> th_st
            | Nothing -> error "WIP: Step_done2"
          end in
          ND.update (fun dr_st ->
            let core_st' = Core_run.update_thread_state tid
              <| Core_run_aux.arena= Core.Expr [] (Core.Epure (Core_aux.mk_value_pe cval));
                 Core_run_aux.stack= Core_run.Stack_empty;
                 Core_run_aux.errno= Mem.null_ptrval Ctype.signed_int;
                 Core_run_aux.env= th_st.Core_run_aux.env;
                /- Dummy locations -/
                 Core_run_aux.exec_loc= Core_run_aux.ELoc_globals;
                 Core_run_aux.current_loc= Loc.unknown;
              |> dr_st.core_state
            in
            <| dr_st with
              core_state= core_st';
              dr_step_counter= dr_st.dr_step_counter + 1;
            |>) >>= fun () ->
          ND.return Nothing)
-/
    
    | Core_reduction.Step_with_runstate2 rsk step_m ->
        match rsk with
          | Core_reduction.RSK_eval debug_str ->
              ( SK_eval debug_str
              , let () = Debug.print_debug 3 [] (fun () -> "Step_eval(" ^ debug_str ^ ")") in
                liftCore_run step_m >>= fun th_st' ->
                ND.update (fun dr_st -> <| dr_st with
                  core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
                  dr_step_counter= dr_st.dr_step_counter + 1
                |>) >>= fun () ->
                drive_core_thread2 tid )
          | Core_reduction.RSK_tau debug_str tsk ->
              ( SK_tau debug_str
              , let () = Debug.print_debug 3 [] (fun () -> "Step_tau(" ^ debug_str ^ ")") in
                liftCore_run step_m >>= fun th_st' ->
                match tsk with
                  | Core_run.TSK_Misc ->
                      ND.return ()
                  | Core_run.TSK_Return sym mval_opt ->
                      ND.update $ fun dr_st ->
                        <| dr_st with trace= ME_function_return sym mval_opt :: dr_st.trace |>
                  | _ ->
                      error "TODO: drive_core_thread2, non TSK_Misc"
                end >>= fun () ->
                begin
                  /- DEBUG -/ ND.print_debug 4 [Debug.DB_driver_step] (fun () -> "tau(tid_" ^ show tid ^ "): " ^ debug_str ^ " with arena= " ^
                  /- DEBUG -/                   Pp.stringFromCore_expr th_st'.Core_run.arena)
                end >>= fun () ->
                ND.update (fun dr_st -> <| dr_st with
                  core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
                  dr_step_counter= dr_st.dr_step_counter + 1
                |>) >>= fun () ->
                drive_core_thread2 tid )
        end
    
    | Core_reduction.Step_tau2 debug_str tsk th_st' ->
        ( SK_tau debug_str
        , let () = Debug.print_debug 3 [] (fun () -> "Step_tau(" ^ debug_str ^ ")") in
          match tsk with
            | Core_run.TSK_Misc ->
                ND.return ()
            | Core_run.TSK_Return sym mval_opt ->
                ND.update $ fun dr_st ->
                <| dr_st with
                  trace= ME_function_return sym mval_opt :: dr_st.trace
                |>
            | _ ->
                error "TODO: drive_core_thread2, non TSK_Misc"
          end >>= fun () ->
          
          begin
            /- DEBUG -/ ND.print_debug 4 [Debug.DB_driver_step] (fun () -> "tau(tid_" ^ show tid ^ "): " ^ debug_str ^ " with arena= " ^
            /- DEBUG -/                   Pp.stringFromCore_expr th_st'.Core_run.arena)
          end >>= fun () ->
          
          ND.update (fun dr_st -> <| dr_st with
            core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
            dr_step_counter= dr_st.dr_step_counter + 1
          |>) >>= fun () ->
          drive_core_thread2 tid )
    
    | Core_reduction.Step_spawn_threads2 mk_parent_th_st spawn_th_sts ->
        ( SK_misc ["spawn_threads("^show tid^")"]
          , let ((spawn_tids, core_st'), run_st') = State.runStateM (
              State.foldlM (fun (th_tids_, core_st_) th_st ->
                State.bind (Core_run.spawn_thread (Just tid) th_st core_st_)
                  (fun (tid, core_st_') -> State.return (tid :: th_tids_, core_st_'))
              ) ([], dr_st.core_state) spawn_th_sts
            ) dr_st.core_run_state in
            ND.update (fun dr_st -> <| dr_st with
              core_run_state= run_st';
              core_state= Core_run.update_thread_state tid
                            (mk_parent_th_st spawn_tids)
                            core_st';
            |>) >>= fun () ->
            ND.mapM_ drive_core_thread2 spawn_tids >>= fun () ->
            drive_core_thread2 tid )

    | Core_reduction.Step_fs2 tid th_st m_fs_step ->
        /- TODO: can m_fs_step change the thread state?, If so this is wrong -/
        ( SK_misc ["fs_step"]
        , liftCore_run m_fs_step                >>= fun fs_step ->
          drive_fs_step tid th_st dr_st fs_step >>= fun () ->
          drive_core_thread2 tid )

    | (Core_reduction.Step_nd2 th_sts) ->
        ( SK_misc ["nd"]
        , ND.pick (SK_misc ["nd"]) th_sts >>= fun th_st' ->
          ND.update (fun dr_st -> <| dr_st with
            core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
            dr_step_counter= dr_st.dr_step_counter + 1
          |>) >>= fun () ->
          drive_core_thread2 tid )

    | Core_reduction.Step_error2 debug_str ->
        error ("WIP: Step_error --> " ^ debug_str)
    | (Core_reduction.Step_action_request2 str _ _ _ _ as step) ->
        ( SK_action_request str
        , ND.return (Just step) )
    | (Core_reduction.Step_memop_request2 _ _ _ _ _ _ as step) -> 
        ( SK_memop_request
        , ND.return (Just step) )
  end) (Core_reduction.step_ctx dr_st.layout_state dr_st.core_file dr_st.core_extern tid th_info)
-/
/- 
/- perform drive_core_thread for all the core threads -/
val drive_core_threads: unit -> driverM (list (Mem.thread_id * maybe Core_reduction.core_step2))
let drive_core_threads () =
  ND.get >>= fun dr_st ->
  ND.mapM (fun (tid, _) ->
    ND.print_debug 9 [Debug.DB_driver] (fun () ->
      "BEFORE drive_core_thread, in drive_core_threads"
    ) >>= fun () ->
    drive_core_thread2 tid >>= fun step ->
    ND.return (tid, step)
  ) dr_st.core_state.Core_run.thread_states -/

def update_core_state (core_st : core_state) (dr_st : driver_state) : driver_state :=
  { dr_st with core_state0 := core_st }
/- POST REDUCTION SEMANTICS -/

def action_request_sequential2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (tid1 : Nat) (aid1 : Nat) :
    action_request2 thread_state → ndM Unit step_kind driver_error
        (mem_constraint CerbMem.IntegerValue) driver_state :=
  fun (x : action_request2 thread_state) =>
    match x with
    | AllocRequest2 pref align_ival size_ival mk_th_st' =>
      ((lemSeq
        (fun _ =>
          CerbDebug.print_debug_located 3 [DB_driver] loc1 (fun (u : Unit) =>
            match u with
            | () => "REQUEST ALLOC"))
        (fun _ =>
          nd_bind (/- DEBUG -/ liftMem (CerbMem.allocateRegion tid1 pref align_ival size_ival))
            (fun (ptrval : CerbMem.PointerValue) =>
              nd_update (fun (dr_st : driver_state) =>
                { { dr_st with
                    trace := ME_allocate_region tid1 pref align_ival size_ival ptrval ::
                      dr_st.trace } with
                  core_state0 := update_thread_state tid1 (mk_th_st' aid1 ptrval)
                    dr_st.core_state0 })))))
    | CreateRequest2 pref align_ival lvalue_ty req_addr_opt init_opt mk_th_st' =>
      ((lemSeq
        (fun _ =>
          CerbDebug.print_debug_located 3 [DB_driver] loc1 (fun (u : Unit) =>
            match u with
            | () => "REQUEST CREATE"))
        (fun _ =>
          nd_bind
            (/- DEBUG -/ liftMem
              ((CerbMem.allocateObject _lemReader_enum_definitions _lemReader_tagDefs) tid1 pref
                align_ival lvalue_ty req_addr_opt init_opt))
            (fun (ptrval : CerbMem.PointerValue) =>
              nd_update (fun (dr_st : driver_state) =>
                { { dr_st with
                    trace := ME_allocate_object tid1 pref align_ival lvalue_ty init_opt ptrval ::
                      dr_st.trace } with
                  core_state0 := update_thread_state tid1 (mk_th_st' aid1 ptrval)
                    dr_st.core_state0 })))))
    | LoadRequest2 mo1 lvalue_ty ptr_val mk_th_st' =>
      ((lemSeq
        (fun _ =>
          CerbDebug.print_debug_located 3 [DB_driver] loc1 (fun (u : Unit) =>
            match u with
            | () => "REQUEST LOAD"))
        (fun _ =>
          nd_bind
            (/- DEBUG -/ liftMem
              ((CerbMem.loadM _lemReader_enum_definitions _lemReader_tagDefs) loc1 lvalue_ty
                ptr_val))
            (fun (p : (CerbMem.Footprint × CerbMem.MemValue)) =>
              match p with
              | (fp, mval) =>
                nd_bind (liftMem (CerbMem.prefixOfPointer ptr_val)) (fun (pref : Option String) =>
                  nd_update (fun (dr_st : driver_state) =>
                    { { dr_st with
                        trace := ME_load loc1 pref lvalue_ty ptr_val mval :: dr_st.trace } with
                      core_state0 := update_thread_state tid1 (mk_th_st' aid1 fp mval)
                        dr_st.core_state0 }))))))
    | StoreRequest2 mo1 lvalue_ty is_locking ptr_val mem_val mk_th_st' =>
      ((lemSeq
        (fun _ =>
          CerbDebug.print_debug_located 3 [DB_driver] loc1 (fun (u : Unit) =>
            match u with
            | () => "REQUEST STORE"))
        (fun _ =>
          nd_bind
            (/- DEBUG -/ /- TODO: need to make memory layout detect unsequenced races (use to make
         the concurency to the check even in the sequential mode) -/
            liftMem
              ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs) loc1 lvalue_ty
                is_locking ptr_val mem_val))
            (fun (fp : CerbMem.Footprint) =>
              nd_bind (liftMem (CerbMem.prefixOfPointer ptr_val)) (fun (pref : Option String) =>
                nd_update (fun (dr_st : driver_state) =>
                  { { dr_st with
                      trace := ME_store loc1 pref lvalue_ty is_locking ptr_val mem_val ::
                        dr_st.trace } with
                    core_state0 := update_thread_state tid1 (mk_th_st' aid1 fp)
                      dr_st.core_state0 }))))))
    | SeqRMWRequest2 lvalue_ty ptr_val mk_mval' mk_th_st' =>
      nd_bind
        (liftMem
          ((CerbMem.loadM _lemReader_enum_definitions _lemReader_tagDefs) loc1 lvalue_ty ptr_val))
        (fun (p : (CerbMem.Footprint × CerbMem.MemValue)) =>
          match p with
          | (_, mval) =>
            nd_bind (liftCore_run (mk_mval' mval)) (fun (mval' : CerbMem.MemValue) =>
              nd_bind
                (liftMem
                  ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs) loc1 lvalue_ty
                    false ptr_val mval'))
                (fun (fp : CerbMem.Footprint) =>
                  nd_bind (liftMem (CerbMem.prefixOfPointer ptr_val)) (fun (pref : Option String) =>
                    nd_update (fun (dr_st : driver_state) =>
                      { { dr_st with
                          trace := ME_seq_rmw loc1 pref lvalue_ty ptr_val mval mval' ::
                            dr_st.trace } with
                        core_state0 := update_thread_state tid1 (mk_th_st' aid1 fp mval mval')
                          dr_st.core_state0 })))))
    /-
  | Core_run.RMWRequest loc sb_edges dd_edges asw_edges aid tid mo1 mo2 lvalue_ty ptr_val mval_expected mval_actual th_st' ->
      error "WIP: Driver.seq ==> RMWRequest"
  
  | Core_run.FenceRequest loc sb_edges dd_edges asw_edges aid tid mo th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST FENCE") in /- DEBUG -/
      ND.update (fun dr_st ->
        update_core_state (Core_run.update_thread_state tid th_st' dr_st.core_state) dr_st
      )
-/
    | KillRequest2 is_dynamic1 ptr_val mk_th_st' =>
      ((lemSeq
        (fun _ =>
          CerbDebug.print_debug_located 3 [DB_driver] loc1 (fun (u : Unit) =>
            match u with
            | () => "REQUEST KILL"))
        (fun _ =>
          nd_bind (/- DEBUG -/ liftMem (CerbMem.killM loc1 is_dynamic1 ptr_val)) (fun (_ : Unit) =>
            nd_update (fun (dr_st : driver_state) =>
              { { dr_st with trace := ME_kill loc1 is_dynamic1 ptr_val :: dr_st.trace } with
                core_state0 := update_thread_state tid1 (mk_th_st' aid1) dr_st.core_state0 })))))

def perform_action_request2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool)
    (loc1 : CerbLocation.Loc) (tid1 : Nat) (request : action_request2 thread_state) :
    ndM Unit step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  (lemSeq
    (fun _ =>
      match CerbGlobal.current_execution_mode () with
      | none => false
      | some mode1 => mode1 == CerbGlobal.ExecutionMode.random)
    (fun _ =>
      (lem_if with_concurrency then
        (failwithI "TODO: perform_action_request2 ==> concurrency" : ndM Unit step_kind driver_error
          (mem_constraint CerbMem.IntegerValue) driver_state)
      else
        nd_bind (liftCore_run (runS fresh_action_id')) (fun (aid1 : Nat) =>
          (action_request_sequential2 _lemReader_enum_definitions _lemReader_tagDefs) loc1 tid1 aid1
            request))))
def perform_memop_request2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (memop1 : generic_memop sym) (cvals : List value) (tid1 : Nat)
    (mk_th_st : value → thread_state) :
    ndM Unit step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  nd_bind
    (match memop1, cvals with
     | Ptrdiff, [Vctype ty1, Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind
         (liftMem
           ((CerbMem.diffPtrval _lemReader_enum_definitions _lemReader_tagDefs) loc1 ty1 ptr_val1
             ptr_val2))
         (fun (ival : CerbMem.IntegerValue) => nd_return (mk_th_st (Vobject (OVinteger ival))))
     | IntFromPtr,
       [Vctype ref_ty, Vctype (Ctype _ (Basic (Integer ity))), Vobject (OVpointer ptr_val)] =>
       nd_bind
         (lem_if integerTypeEqual ity Bool0 then
           print_debug 0 [DB_driver] (fun (u : Unit) =>
             match u with
             | () => "IntFromPtr called on _Bool --> this is probably a bug in the elaboration")
         else
           nd_return ())
         (fun (u : Unit) =>
           match u with
           | () =>
             nd_bind
               (/- DEBUG -/ liftMem
                 ((CerbMem.intfromptr _lemReader_enum_definitions _lemReader_tagDefs) loc1 ref_ty
                   ity ptr_val))
               (fun (ival : CerbMem.IntegerValue) =>
                 nd_return (mk_th_st (Vobject (OVinteger ival)))))
     | PtrFromInt,
       [Vctype (Ctype _ (Basic (Integer ity))), Vctype ref_ty, Vobject (OVinteger ival)] =>
       nd_bind (liftMem (CerbMem.ptrfromint loc1 ity ref_ty ival))
         (fun (ptrval : CerbMem.PointerValue) => nd_return (mk_th_st (Vobject (OVpointer ptrval))))
     | PtrValidForDeref, [Vctype ref_ty, Vobject (OVpointer ptr_val)] =>
       nd_bind
         (liftMem
           ((CerbMem.validForDerefPtrval _lemReader_enum_definitions _lemReader_tagDefs) ref_ty
             ptr_val))
         (fun (is_valid : Bool) => nd_return (mk_th_st (lem_if is_valid then Vtrue else Vfalse)))
     | PtrEq, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind
         (nd_bind
           (print_debug 2 [DB_driver] (fun (u : Unit) =>
             match u with
             | () => "PtrEq"))
           (fun (_ : Unit) => /- DEBUG -/ liftMem (CerbMem.eqPtrval loc1 ptr_val1 ptr_val2)))
         (fun (is_eq : Bool) => nd_return (mk_th_st (lem_if is_eq then Vtrue else Vfalse)))
     | PtrNe, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind (liftMem (CerbMem.nePtrval loc1 ptr_val1 ptr_val2)) (fun (is_ne : Bool) =>
         nd_return (mk_th_st (lem_if is_ne then Vtrue else Vfalse)))
     | PtrLt, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind (liftMem (CerbMem.ltPtrval loc1 ptr_val1 ptr_val2)) (fun (is_lt : Bool) =>
         nd_return (mk_th_st (lem_if is_lt then Vtrue else Vfalse)))
     | PtrGt, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind (liftMem (CerbMem.gtPtrval loc1 ptr_val1 ptr_val2)) (fun (is_gt : Bool) =>
         nd_return (mk_th_st (lem_if is_gt then Vtrue else Vfalse)))
     | PtrLe, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind (liftMem (CerbMem.lePtrval loc1 ptr_val1 ptr_val2)) (fun (is_le : Bool) =>
         nd_return (mk_th_st (lem_if is_le then Vtrue else Vfalse)))
     | PtrGe, [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2)] =>
       nd_bind (liftMem (CerbMem.gePtrval loc1 ptr_val1 ptr_val2)) (fun (is_ge : Bool) =>
         nd_return (mk_th_st (lem_if is_ge then Vtrue else Vfalse)))
     | Memcpy,
       [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2),
         Vobject (OVinteger size_ival)] =>
       nd_bind
         (liftMem
           ((CerbMem.memcpyM _lemReader_enum_definitions _lemReader_tagDefs) loc1 ptr_val1 ptr_val2
             size_ival))
         (fun (res : CerbMem.PointerValue) => nd_return (mk_th_st (Vobject (OVpointer res))))
     | Memcmp,
       [Vobject (OVpointer ptr_val1), Vobject (OVpointer ptr_val2),
         Vobject (OVinteger size_ival)] =>
       nd_bind
         (liftMem
           ((CerbMem.memcmpM _lemReader_enum_definitions _lemReader_tagDefs) ptr_val1 ptr_val2
             size_ival))
         (fun (res : CerbMem.IntegerValue) => nd_return (mk_th_st (Vobject (OVinteger res))))
     | PtrWellAligned, [Vctype ref_ty, Vobject (OVpointer ptrval)] =>
       nd_bind
         (liftMem
           ((CerbMem.isWellAlignedPtrval _lemReader_enum_definitions _lemReader_tagDefs) ref_ty
             ptrval)) (fun (b : Bool) => nd_return (mk_th_st (lem_if b then Vtrue else Vfalse)))
     | Realloc,
       [Vobject (OVinteger align_ival), Vobject (OVpointer old_ptr),
         Vobject (OVinteger size_ival)] =>
       nd_bind
         (liftMem
           ((CerbMem.reallocM _lemReader_enum_definitions _lemReader_tagDefs) loc1 tid1 align_ival
             old_ptr size_ival))
         (fun (res : CerbMem.PointerValue) => nd_return (mk_th_st (Vobject (OVpointer res))))
     | PtrArrayShift, [Vobject (OVpointer ptrval), Vctype ty1, Vobject (OVinteger n_ival)] =>
       nd_bind
         (liftMem
           ((CerbMem.effArrayShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs) loc1 ptrval
             ty1 n_ival))
         (fun (res : CerbMem.PointerValue) =>
           nd_bind
             (nd_update (fun (dr_st : driver_state) =>
               { dr_st with
                 trace := ME_eff_array_shift_ptrval ptrval ty1 n_ival res :: dr_st.trace }))
             (fun (_ : Unit) => nd_return (mk_th_st (Vobject (OVpointer res)))))
     | PtrMemberShift tag_sym membr_ident, [Vobject (OVpointer ptrval)] =>
       nd_bind
         (liftMem
           ((CerbMem.effMemberShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs) loc1
             ptrval tag_sym membr_ident))
         (fun (res : CerbMem.PointerValue) =>
           nd_bind
             (nd_update (fun (dr_st : driver_state) =>
               { dr_st with
                 trace := ME_eff_member_shift_ptrval tag_sym membr_ident ptrval res ::
                   dr_st.trace }))
             (fun (_ : Unit) => nd_return (mk_th_st (Vobject (OVpointer res)))))
     | Va_start, [Vlist _ ty_cvals] =>
       (let ty_ptrs :=
          List.map
            (fun (x : value) =>
              match x with
              | Vtuple [Vctype ty1, Vobject (OVpointer ptr)] => (ty1, ptr)
              | _ => (failwithI "va_start" : (ctype × CerbMem.PointerValue))) ty_cvals;
        nd_bind (liftMem (CerbMem.vaStart ty_ptrs)) (fun (res : CerbMem.IntegerValue) =>
          nd_return (mk_th_st (Vobject (OVinteger res)))))
     | Va_copy, [Vobject (OVinteger va)] =>
       nd_bind (liftMem (CerbMem.vaCopy va)) (fun (res : CerbMem.IntegerValue) =>
         nd_return (mk_th_st (Vobject (OVinteger res))))
     | Va_arg, [Vobject (OVinteger va), Vctype ty1] =>
       nd_bind (liftMem (CerbMem.vaArg va ty1)) (fun (res : CerbMem.PointerValue) =>
         nd_return (mk_th_st (Vobject (OVpointer res))))
     | Va_end, [Vobject (OVinteger va)] =>
       nd_bind (liftMem (CerbMem.vaEnd va)) (fun (_ : Unit) => nd_return (mk_th_st Vunit))
     | Copy_alloc_id, [Vobject (OVinteger ival), Vobject (OVpointer ptrval)] =>
       nd_bind
         (liftMem
           ((CerbMem.copyAllocId _lemReader_enum_definitions _lemReader_tagDefs) ival ptrval))
         (fun (ptrval' : CerbMem.PointerValue) =>
           nd_return (mk_th_st (Vobject (OVpointer ptrval'))))
     | CHERI_intrinsic str (ret_ty, tys), cvals =>
       (let mvals :=
          map2
            (fun (ty1 : ctype) (cval : value) =>
              (fromJustI "CHERI_intrinsic call"
                ((memValueFromValue _lemReader_enum_definitions _lemReader_tagDefs) ty1 cval) :
                CerbMem.MemValue)) tys cvals;
        nd_bind (liftMem (CerbMem.callIntrinsic loc1 str mvals))
          (fun (res_opt : Option CerbMem.MemValue) =>
            match res_opt with
            | some res => nd_return (mk_th_st (Vloaded (Prod.snd (loadedValueFromMemValue res))))
            | none => nd_return (mk_th_st Vunit)))
     | _, _ =>
       (failwithI
         (String.append "INVALID memop request: "
           (String.append
             ((fun (x : generic_memop sym) =>
               match x with
               | PtrEq => "ptreq"
               | PtrNe => "ptrne"
               | PtrLt => "ptrlt"
               | PtrGt => "ptrgt"
               | PtrLe => "ptrle"
               | PtrGe => "ptrge"
               | Ptrdiff => "ptrdiff"
               | IntFromPtr => "intfromptr"
               | PtrFromInt => "ptrfromint"
               | PtrValidForDeref => "ptrvalidforderef"
               | PtrWellAligned => "ptrwellaligned"
               | Memcpy => "memcpy"
               | Memcmp => "memcmp"
               | Realloc => "realloc"
               | PtrArrayShift => "ptrarrayshift"
               | PtrMemberShift tag_sym membr_ident =>
                 String.append "ptrmembershift["
                   (String.append (show_symbol tag_sym)
                     (String.append ", "
                       (String.append
                         (match membr_ident with
                          | Identifier _ str => str) "]")))
               | Va_start => "va_start"
               | Va_copy => "va_copy"
               | Va_arg => "va_arg"
               | Va_end => "va_end"
               | Copy_alloc_id => "copy_alloc_id"
               | CHERI_intrinsic str _ => String.append "cheri_" str) memop1)
             (String.append " ==> " (CerbPP.stringFromCore_value (Vtuple cvals))))) : ndM
         thread_state step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state))
    (fun (th_st' : thread_state) =>
      nd_update (fun (dr_st : driver_state) =>
        update_core_state (update_thread_state tid1 th_st' dr_st.core_state0) dr_st))

def can_advance : core_step2 → Bool :=
  fun (x : core_step2) =>
    match x with
    | Step_ccall2 _ _ => false
    | Step_with_runstate2 _ _ => true
    | Step_tau2 _ _ _ => true
    | Step_action_request2 _ _ _ is_unseq_with_ccall1
      _ => /- TODO: only correct if there is only ONE thread -/
      not is_unseq_with_ccall1 /- false -/
    | Step_blocked2 => false
    | Step_error2 str => (failwithI (String.append "can_advance: Step_error2 ==> " str) : Bool)
    | Step_thread_done2 _ _ => true
    | Step_done2 _ => false
    | Step_memop_request2 _ _ _ _ is_unseq_with_ccall1
      _ => /- TODO: only correct if there is only ONE thread -/
      not is_unseq_with_ccall1 /- false -/
    | Step_spawn_threads2 _ _ => true
    | Step_fs2 _ _ _ => false
    | Step_nd2 _ => true

inductive advance_info : Type where
  | NOWAKEUP : advance_info
  | WAKEUP : Bool → List thread_id → advance_info
  deriving BEq, Ord
export advance_info (NOWAKEUP WAKEUP)
instance : Inhabited advance_info where
  default := NOWAKEUP
instance (priority := 500) : Lem_Basic_classes.SetType advance_info where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 advance_info where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 advance_info where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

def advance_step [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (tid1 : Nat)
    (step1 : core_step2) :
    ndM advance_info step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  match step1 with
  | Step_ccall2 _ _ => nd_return NOWAKEUP
  | Step_with_runstate2 rsk step_m =>
    nd_bind
      (match rsk with
       | RSK_tau _ (TSK_Return sym1 mval_opt) =>
         nd_update (fun (dr_st : driver_state) =>
           { dr_st with trace := ME_function_return sym1 mval_opt :: dr_st.trace })
       | _ => nd_return ())
      (fun (u : Unit) =>
        match u with
        | () =>
          nd_bind (liftCore_run step_m) (fun (th_st' : thread_state) =>
            nd_bind
              (nd_update (fun (dr_st : driver_state) =>
                { { dr_st with dr_step_counter := dr_st.dr_step_counter + 1 } with
                  core_state0 := update_thread_state tid1 th_st' dr_st.core_state0 }))
              (fun (u : Unit) =>
                match u with
                | () => nd_return NOWAKEUP)))
  | Step_tau2 debug_str tsk th_st' =>
    nd_bind
      (match tsk with
       | TSK_Return sym1 mval_opt =>
         nd_update (fun (dr_st : driver_state) =>
           { dr_st with trace := ME_function_return sym1 mval_opt :: dr_st.trace })
       | _ => nd_return ())
      (fun (u : Unit) =>
        match u with
        | () =>
          nd_bind
            (nd_update (fun (dr_st : driver_state) =>
              { { dr_st with dr_step_counter := dr_st.dr_step_counter + 1 } with
                core_state0 := update_thread_state tid1 th_st' dr_st.core_state0 }))
            (fun (u : Unit) =>
              match u with
              | () => nd_return NOWAKEUP))
  | Step_action_request2 _ loc1 tid1 is_unseq_with_ccall1 m_request =>
    nd_bind
      (lem_if is_unseq_with_ccall1 then
        nd_return ()
      else
        nd_bind (liftCore_run m_request) (fun (request : action_request2 thread_state) =>
          (perform_action_request2 _lemReader_enum_definitions _lemReader_tagDefs) false
            /- TODO!!! with_concurrency -/ loc1 tid1 request))
      (fun (u : Unit) =>
        match u with
        | () => nd_return NOWAKEUP)
  | Step_blocked2 => nd_return NOWAKEUP
  | Step_error2 debug_str =>
    (failwithI (String.append "Driver.advance_step => Step_error2: " debug_str) : ndM advance_info
      step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state)
  | Step_thread_done2 parent_tid cval =>
    nd_bind
      (nd_read (fun (dr_st : driver_state) =>
        let actions_of_current_thread : Pset action :=
          setFilterBy setElemCompare (fun (act : action) => tid_of act == tid1)
            dr_st.concurrency_state.symPre.actions;
        setFilterBy setElemCompare
          (fun (act : action) =>
            not
              (setAny
                (fun (p : (action × action)) =>
                  match p with
                  | (act', _) => act == act') dr_st.concurrency_state.symPre.sb))
          actions_of_current_thread))
      (fun (last_actions_of_current_thread : Pset action) =>
        nd_bind
          (nd_update (fun (dr_st : driver_state) =>
            { { dr_st with dr_step_counter := dr_st.dr_step_counter + 1 } with
              core_state0 := kill_thread tid1 parent_tid
                ((setMapBy defaultCompare aid_of last_actions_of_current_thread)) cval
                dr_st.core_state0 }))
          (fun (u : Unit) =>
            match u with
            | () => nd_return (WAKEUP true [parent_tid])))
  | Step_done2 cval => nd_return NOWAKEUP
  | Step_memop_request2 loc1 memop1 cvals tid1 is_unseq_with_ccall1 mk_th_st =>
    nd_bind
      (lem_if is_unseq_with_ccall1 then
        nd_return ()
      else
        (perform_memop_request2 _lemReader_enum_definitions _lemReader_tagDefs) loc1 memop1 cvals
          tid1 mk_th_st)
      (fun (u : Unit) =>
        match u with
        | () => nd_return NOWAKEUP)
  | Step_spawn_threads2 mk_parent_th_st spawn_th_sts =>
    nd_bind
      (nd_read (fun (dr_st : driver_state) =>
        runStateM
          (foldlM
            (fun (p : (List Nat × core_state)) (th_st : thread_state) =>
              match p, th_st with
              | (th_tids_, core_st_), th_st =>
                bind1 (spawn_thread (some tid1) th_st core_st_) (fun (p : (Nat × core_state)) =>
                  match p with
                  | (tid1, core_st_') => return0 ((tid1 :: th_tids_), core_st_')))
            (([] : List Nat), dr_st.core_state0) spawn_th_sts) dr_st.core_run_state0))
      (fun (p : ((List thread_id × core_state) × core_run_state)) =>
        match p with
        | ((spawn_tids, core_st'), run_st') =>
          nd_bind
            (nd_update (fun (dr_st : driver_state) =>
              { { dr_st with
                  core_state0 := update_thread_state tid1 (mk_parent_th_st spawn_tids)
                    core_st' } with
                core_run_state0 := run_st' }))
            (fun (u : Unit) =>
              match u with
              | () => nd_return (WAKEUP false spawn_tids)))
  | Step_fs2 _ _ _ =>
    (failwithI "TODO: Step_fs2" : ndM advance_info step_kind driver_error
      (mem_constraint CerbMem.IntegerValue) driver_state)
  | Step_nd2 th_sts =>
    nd_bind (pick (SK_misc ["nd"]) th_sts) (fun (th_st' : thread_state) =>
      nd_bind
        (nd_update (fun (dr_st : driver_state) =>
          { { dr_st with dr_step_counter := dr_st.dr_step_counter + 1 } with
            core_state0 := update_thread_state tid1 th_st' dr_st.core_state0 }))
        (fun (u : Unit) =>
          match u with
          | () => nd_return NOWAKEUP))

def find_can_advance (steps : List core_step2) : Option core_step2 :=
  match steps with
  | [] => none
  | step1 :: steps' => (lem_if can_advance step1 then some step1 else find_can_advance steps')

def drive_nonmemory_steps_aux2_lemFuel [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (lemFuel : Nat) (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (acc : Fmap thread_id (List core_step2)) :
    List Nat → ndM (Fmap thread_id (List core_step2)) step_kind driver_error
        (mem_constraint CerbMem.IntegerValue) driver_state :=
  match lemFuel with
  | 0 =>
    (fun _ =>
      ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    (fun (x : List Nat) =>
      match x with
      | [] => nd_return acc
      | tid1 :: xs' =>
        nd_bind
          (nd_read (fun (dr_st : driver_state) =>
            let th_info :=
              match (lookupBy (fun x y => x == y) tid1 dr_st.core_state0.thread_states) with
              | some z => z
              | none =>
                (failwithI
                  (String.append "Driver.drive_nonmemory_steps_aux2 => invalid tid: "
                    (Lem_String_extra.stringFromNat tid1)) : (Option thread_id × thread_state));
            (step_ctx _lemReader_enum_definitions _lemReader_tagDefs) dr_st.layout_state
              dr_st.core_file dr_st.core_extern tid1 th_info))
          (fun (steps : List core_step2) =>
            match find_can_advance steps with
            | none =>
              (drive_nonmemory_steps_aux2_lemFuel lemFuel _lemReader_enum_definitions
                _lemReader_tagDefs) ((fmapAddBy defaultCompare tid1 steps acc)) xs'
            | some step1 =>
              nd_bind ((advance_step _lemReader_enum_definitions _lemReader_tagDefs) tid1 step1)
                (fun (wakeups : advance_info) =>
                  let xs'' :=
                    match wakeups with
                    | NOWAKEUP => tid1 :: xs'
                    | WAKEUP false tids => tid1 :: list_inserts tids xs'
                    | WAKEUP true tids => list_inserts tids xs';
                  (drive_nonmemory_steps_aux2_lemFuel lemFuel _lemReader_enum_definitions
                    _lemReader_tagDefs) acc xs'')))

def drive_nonmemory_steps_aux2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches] :
    (Fmap sym integerType) -> (Fmap sym (CerbLocation.Loc × tag_definition)) -> Fmap thread_id
        (List core_step2) → List Nat → ndM (Fmap thread_id (List core_step2)) step_kind driver_error
        (mem_constraint CerbMem.IntegerValue) driver_state :=
  drive_nonmemory_steps_aux2_lemFuel LemFuel.fuel
theorem drive_nonmemory_steps_aux2_lemFuel_zero [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (acc : Fmap thread_id (List core_step2)) :
    (drive_nonmemory_steps_aux2_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs acc : List
      Nat → ndM (Fmap thread_id (List core_step2)) step_kind driver_error
      (mem_constraint CerbMem.IntegerValue) driver_state) =
        (fun _ =>
          ND (fun st =>
            (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

/-
type next =
  | CONTINUE
  | SAVE_STEPS of Core_reduction.core_step2 * list Core_reduction.core_step2
  | STOP
  | PROGRAM_DONE of Core.value
  | WAKEUP of list Mem_common.thread_id

type continue =
  | DO_CONTINUE of list Core_reduction.core_step2
  | NEXT



let rec drive_nonmemory_steps_aux (acc: map Mem.thread_id (list Core_reduction.core_step2)) continue = function
  | [] ->
      ND.return acc
  | tid :: xs' ->
      match continue with
        | DO_CONTINUE continue_steps ->
            let () = Debug.print_debug 0 [] (fun () ->
              "DO_CONTINUE |continue_steps| = " ^ show (List.length continue_steps) ^ "==> " ^ show continue_steps
            ) in
            ND.return continue_steps
        | NEXT ->
          let () = Debug.print_debug 0 [] (fun () ->
            "NEXT"
          ) in
          ND.read (fun dr_st ->
            let th_info =
              match List.lookup tid dr_st.core_state.Core_run.thread_states with
                | Just z -> z
                | Nothing ->
                    error "Driver.drive_nonmemory_steps_aux => invalid tid"
              end in
            Core_reduction.step_ctx dr_st.layout_state dr_st.core_file dr_st.core_extern tid th_info
          )
      end >>= function
        | [] ->
            drive_nonmemory_steps_aux acc NEXT xs'
        | step :: next_steps ->
            let () =
              if List.length (step :: next_steps) > 1 then
                Debug.print_debug 0 [] (fun () ->
                  "ENTER |steps| = " ^ show (List.length (step :: next_steps)) ^ " ==> " ^ show (step :: next_steps)
                )
              else
                () in
            match step with
              | Core_reduction.Step_with_runstate2 rsk step_m ->
                  match rsk with
                    | Core_reduction.RSK_tau _ (Core_run.TSK_Return sym mval_opt) ->
                        ND.update (fun dr_st ->
                          <| dr_st with trace= ME_function_return sym mval_opt :: dr_st.trace |>
                        )
                    | _ ->
                        ND.return ()
                  end >>= fun () ->
                  liftCore_run step_m >>= fun th_st' ->
                  ND.update (fun dr_st -> <| dr_st with
                    core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
                    dr_step_counter= dr_st.dr_step_counter + 1
                  |>) >>= fun () ->
                  ND.return CONTINUE 
              
              | Core_reduction.Step_tau2 debug_str tsk th_st' ->
                  match tsk with
                    | Core_run.TSK_Return sym mval_opt ->
                        ND.update (fun dr_st ->
                          <| dr_st with trace= ME_function_return sym mval_opt :: dr_st.trace |>
                        )
                    | _ ->
                        ND.return ()
                  end >>= fun () ->          
                  ND.update (fun dr_st -> <| dr_st with
                    core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
                    dr_step_counter= dr_st.dr_step_counter + 1
                  |>) >>= fun () ->
                  ND.return CONTINUE

              | Core_reduction.Step_action_request2 _ _ _ _ ->
                  ND.return (SAVE_STEPS step next_steps)

              | Core_reduction.Step_aseq _ _ _ _ ->
                  error "TODO: Driver.drive_nonmemory_steps_aux => Step_aseq"
              
              | Core_reduction.Step_blocked2 ->
                  ND.return STOP

              | Core_reduction.Step_error2 debug_str ->
                  error ("Driver.drive_nonmemory_steps_aux => Step_error2: " ^ debug_str)

              | Core_reduction.Step_thread_done2 parent_tid cval ->
                  ND.read (fun dr_st ->
                    let actions_of_current_thread: set Cmm.action =
                      Set.filter (fun act ->
                        Cmm.tid_of act = tid
                      ) (dr_st.concurrency_state.Cmm_op.symPre.Cmm.actions) in
                    Set.filter (fun act ->
                      not (Set.any (fun (act', _) ->
                        act = act'
                      ) dr_st.concurrency_state.Cmm_op.symPre.Cmm.sb)
                    ) actions_of_current_thread
                  ) >>= fun (last_actions_of_current_thread: set Cmm.action) ->
                  ND.update (fun dr_st -> <| dr_st with
                    core_state= Core_run.kill_thread tid parent_tid (Set.map Cmm.aid_of last_actions_of_current_thread) cval dr_st.core_state;
                    dr_step_counter= dr_st.dr_step_counter + 1;
                  |>) >>= fun () ->
                  /- try to wake up the parent thread -/
                  ND.return (WAKEUP [parent_tid])

              | Core_reduction.Step_done2 cval ->
                  ND.return (PROGRAM_DONE cval)

              | Core_reduction.Step_memop_request2 _ _ _ _ ->
                  ND.return (SAVE_STEPS step next_steps)

              | Core_reduction.Step_spawn_threads2 mk_parent_th_st spawn_th_sts ->
                  ND.read (fun dr_st ->
                    State.runStateM (
                      State.foldlM (fun (th_tids_, core_st_) th_st ->
                        State.bind (Core_run.spawn_thread (Just tid) th_st core_st_)
                          (fun (tid, core_st_') -> State.return (tid :: th_tids_, core_st_'))
                      ) ([], dr_st.core_state) spawn_th_sts
                    ) dr_st.core_run_state
                  ) >>= fun ((spawn_tids, core_st'), run_st') ->
                  ND.update (fun dr_st -> <| dr_st with
                    core_run_state= run_st';
                    core_state= Core_run.update_thread_state tid
                                  (mk_parent_th_st spawn_tids)
                                  core_st';
                  |>) >>= fun () ->
                  ND.return (WAKEUP spawn_tids)

              | Core_reduction.Step_fs2 th_st m_fs_step ->
                  /- TODO: can m_fs_step change the thread state?, If so this is wrong -/
                  liftCore_run m_fs_step                >>= fun fs_step ->
                  ND.get >>= fun dr_st ->
                  drive_fs_step tid th_st dr_st fs_step >>= fun () ->
                  ND.return CONTINUE

              | Core_reduction.Step_nd2 _ ->
                  error "TODO: Step_nd2"
            end >>= function
              | PROGRAM_DONE cval ->
                  ND.return (Map.insert tid [Core_reduction.Step_done2 cval] Map.empty)
              | CONTINUE ->
                  let continue' =
                    match continue with
                      | NEXT -> NEXT
                      | DO_CONTINUE _ -> DO_CONTINUE next_steps
                    end in
                  drive_nonmemory_steps_aux acc continue' (tid :: xs')
              | SAVE_STEPS step next_steps ->
                  let () = Debug.print_debug 0 [] (fun () ->
                    "SAVE_STEPS |next_steps| = " ^ show (List.length next_steps) ^ "\n" ^ show next_steps
                  ) in
                  let acc' =
                    match Map.lookup tid acc with
                      | Nothing ->
                          Map.insert tid [step] acc
                      | Just steps ->
                          Map.insert tid (step :: steps) acc
                    end in
                  /- List.map (fun step -> (tid, Just step)) steps ++ acc in -/
                  match next_steps with
                    | [] ->
                        drive_nonmemory_steps_aux acc' NEXT xs'
                    | _ ->
                        drive_nonmemory_steps_aux acc' (DO_CONTINUE next_steps) (tid :: xs')
                  end
              | STOP ->
                  drive_nonmemory_steps_aux acc NEXT xs'
              | WAKEUP tids ->
                  drive_nonmemory_steps_aux acc NEXT (tids ++ xs')
            end
      end
end
-/

def new_drive_core_threads [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
