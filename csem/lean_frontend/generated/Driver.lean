                                                         String.append "RSK_tau["
                                                           (String.append debug_str
                                                             (String.append ", "
                                                               (String.append kind'_str "]"))));
                                                    String.append "Step_with_runstate2["
                                                      (String.append kind_str "]"))
                                                 | Step_tau2 debug_str kind1 _ =>
                                                   String.append "Step_tau2<TAU>["
                                                     (String.append debug_str "]")
                                                 | Step_action_request2 debug_str loc1 tid1
                                                   is_unseq_with_ccall1 _ =>
                                                   String.append "Step_action_request2["
                                                     (String.append debug_str
                                                       (String.append "] -- tid: "
                                                         (String.append
                                                           (Lem_String_extra.stringFromNat tid1)
                                                           (String.append
                                                             (lem_if is_unseq_with_ccall1 then
                                                               " [unseq_with_call]"
                                                             else
                                                               "")
                                                             (String.append " -- at loc: "
                                                               (CerbLocation.stringFromLocation
                                                                 loc1))))))
                                                 | Step_blocked2 => "Step_blocked2"
                                                 | Step_error2 debug_str =>
                                                   String.append "Step_error2["
                                                     (String.append debug_str "]")
                                                 | Step_thread_done2 tid1 cval =>
                                                   String.append "Step_thread_done2(tid: "
                                                     (String.append
                                                       (Lem_String_extra.stringFromNat tid1)
                                                       (String.append ") -- value: "
                                                         (CerbPP.stringFromCore_value cval)))
                                                 | Step_done2 cval =>
                                                   String.append "Step_done2 -- value: "
                                                     (CerbPP.stringFromCore_value cval)
                                                 | Step_memop_request2 loc1 memop1 _ tid1
                                                   is_unseq_with_ccall1 _ =>
                                                   String.append "Step_memop_request2["
                                                     (String.append
                                                       ((fun (x : generic_memop sym) =>
                                                         match x with
                                                         | PtrEq => "ptreq"
                                                         | PtrNe => "ptrne"
                                                         | PtrLt => "ptrlt"
                                                         | PtrGt => "ptrgt"
                                                         | PtrLe => "ptrle"
                                                         | PtrGe => "ptrge"
                                                         | Ptrdiff => "ptrdiff"
                                                         | IntFromPtr => "intfromptr"
                                                         | PtrFromInt => "ptrfromint"
                                                         | PtrValidForDeref => "ptrvalidforderef"
                                                         | PtrWellAligned => "ptrwellaligned"
                                                         | Memcpy => "memcpy"
                                                         | Memcmp => "memcmp"
                                                         | Realloc => "realloc"
                                                         | PtrArrayShift => "ptrarrayshift"
                                                         | PtrMemberShift tag_sym membr_ident =>
                                                           String.append "ptrmembershift["
                                                             (String.append (show_symbol tag_sym)
                                                               (String.append ", "
                                                                 (String.append
                                                                   (match membr_ident with
                                                                    | Identifier _ str => str)
                                                                   "]")))
                                                         | Va_start => "va_start"
                                                         | Va_copy => "va_copy"
                                                         | Va_arg => "va_arg"
                                                         | Va_end => "va_end"
                                                         | Copy_alloc_id => "copy_alloc_id"
                                                         | CHERI_intrinsic str _ =>
                                                           String.append "cheri_" str) memop1)
                                                       (String.append "] -- tid: "
                                                         (String.append
                                                           (Lem_String_extra.stringFromNat tid1)
                                                           (String.append
                                                             (lem_if is_unseq_with_ccall1 then
                                                               " [unseq_with_call]"
                                                             else
                                                               "")
                                                             (String.append " -- at loc: "
                                                               (CerbLocation.stringFromLocation
                                                                 loc1))))))
                                                 | Step_spawn_threads2 _ _ => "Step_spawn_threads2"
                                                 | Step_fs2 tid1 _ _ =>
                                                   String.append "Step_fs2 -- tid: "
                                                     (Lem_String_extra.stringFromNat tid1)
                                                 | Step_nd2 _ => "Step_nd2") x_opt)) tid_steps)))))
                           (fun _ => nd_return ()))
                       else
                         nd_return ())
                       (fun (u : Unit) =>
                         match u with
                         | () =>
                           nd_bind (pick (SK_misc ["driver non_blocked"]) non_blocked)
                             (fun (x : (Nat × Option core_step2)) =>
                               match x with
                               | (_, none) => /- TODO: hack hack, should just exit -/ nd_return ()
                               | (_, some step1) =>
                                 (process_core_step2 _lemReader_enum_definitions _lemReader_tagDefs)
                                   with_concurrency
                                   (driver2_lemFuel lemFuel _lemReader_enum_definitions
                                     _lemReader_tagDefs) step1))
                       /-
    ND.pick (SK_misc ["driver 4"]) non_blocked_th_sts >>= fun (tid, th_info) ->
    ND.pick (SK_misc ["driver 5"]) (Core_reduction.step_ctx post_core_dr_st.layout_state post_core_dr_st.core_file post_core_dr_st.core_extern tid th_info)
      >>= (process_core_step2 with_concurrency driver2)
    -/
                       )))))))))

def driver2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches] :
    (Fmap sym integerType) -> (Fmap sym (CerbLocation.Loc × tag_definition)) -> Bool → driverM
        Unit :=
  driver2_lemFuel LemFuel.fuel
theorem driver2_lemFuel_zero [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool) :
    driver2_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs with_concurrency =
        (ND (fun st =>
          (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

def hack_lemFuel [LemFuel] [CerbImplCfg.Impl] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (core_extern1 : Fmap sym sym) (env1 : List (Fmap sym value)) (mem_st : CerbMem.MemState)
    (core_file1 : generic_file Unit core_run_annotation) (concur_sym_map : Fmap sym object_value)
    (pexpr1 : generic_pexpr Unit sym) :
    value :=
  match lemFuel with
  | 0 => (fuelExhausted Vunit)
  | Nat.succ lemFuel =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
          match u with
          | () => "ENTERING Driver.hack"))
      (fun _ =>
        match (step_eval_pexpr _lemReader_enum_definitions _lemReader_tagDefs) 0
            (CerbLocation.other "Driver.hack") none core_extern1 env1 (some mem_st) core_file1 false
            pexpr1 with
        | Result (Defined pexpr') =>
          (match valueFromPexpr pexpr' with
           | some cval => cval
           | none =>
             (hack_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs) core_extern1 env1
               mem_st core_file1 concur_sym_map pexpr')
        | _ =>
          (failwithI
            (String.append "Driver.hack, UNDEF/ERROR:" (CerbPP.stringFromCore_pexpr pexpr1)) :
            value))))

def hack [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (core_extern1 : Fmap sym sym) (env1 : List (Fmap sym value)) (mem_st : CerbMem.MemState)
    (core_file1 : generic_file Unit core_run_annotation) (concur_sym_map : Fmap sym object_value)
    (pexpr1 : generic_pexpr Unit sym) :
    value :=
  hack_lemFuel (generic_pexpr.lemSize pexpr1) _lemReader_enum_definitions _lemReader_tagDefs
    core_extern1 env1 mem_st core_file1 concur_sym_map pexpr1
theorem hack_lemFuel_zero [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (core_extern1 : Fmap sym sym) (env1 : List (Fmap sym value)) (mem_st : CerbMem.MemState)
    (core_file1 : generic_file Unit core_run_annotation) (concur_sym_map : Fmap sym object_value)
    (pexpr1 : generic_pexpr Unit sym) :
    hack_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs core_extern1 env1 mem_st
        core_file1 concur_sym_map pexpr1 = (fuelExhausted Vunit) :=
  rfl

structure driver_result where
  dres_blocked : Bool
  dres_concurrency_state : symState
  dres_driver_steps : Nat
  dres_core_value : value
  dres_stdout : String
  dres_stderr : String
  deriving BEq, Ord
instance : Inhabited driver_result where
  default :=
    { dres_blocked := default,
      dres_concurrency_state := default,
      dres_driver_steps := default,
      dres_core_value := default,
      dres_stdout := default,
      dres_stderr := default }
instance (priority := 500) : Lem_Basic_classes.SetType driver_result where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 driver_result where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 driver_result where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual :=
    defaultGreaterEq /- (string * (bool * Cmm_op.symState * Core.value) * (nat * nat)) -/
def finalize [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (debug_str : String)
    (dr_st : driver_state) :
    driver_result :=
  match dr_st.core_state0.thread_states with
  | [(tid1, (_, th_st))] =>
    (let cval :=(hack _lemReader_enum_definitions _lemReader_tagDefs) dr_st.core_extern th_st.env
         dr_st.layout_state dr_st.core_file dr_st.symbolic_assoc
         (match to_pure th_st.arena with
          /-
              | Just (Core.PEval (Core.Vinteger ival)) ->
                  let Just symb = Mem_aux.symbolicFromIntegerValue ival in
                  Core_aux.unsymbolify symb
-/
          | some pe => pe
          | none =>
            (failwithI
              (String.append "Driver.finalize: the arena wasn't pure ==> "
                (CerbPP.stringFromCore_expr th_st.arena)) : generic_pexpr Unit sym));
     (({ dres_blocked := dr_st.blocked,
         dres_concurrency_state := dr_st.concurrency_state,
         dres_driver_steps := dr_st.dr_step_counter,
         dres_core_value := cval,
         dres_stdout := (lemListFoldr String.append "" (toList dr_st.core_state0.io.stdout)),
         dres_stderr := (lemListFoldr String.append "" (toList dr_st.core_state0.io.stderr)) } :
       driver_result)))
  | xs =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 3 [DB_driver] (fun (u : Unit) =>
          match u with
          | () =>
            String.append "ERROR (end of the Driver)\n"
              (CerbPP.stringFromCore_core_state dr_st.core_state0)))
      (fun _ => /- DEBUG -/
        (failwithI (String.append "BOOM finalize [" (String.append debug_str "]")) :
          driver_result))))

/- TODO: it is problematic for proofy backend that this function may diverge -/
/- TODO: HACK -/
/- C1 (effect retirement): the record builder is factored out so the
   const-expr mini-run can build the state from an EXPLICITLY threaded
   supply (initial_driver_state_given) while the production entry
   below keeps the one supply draw (Lean: supply-lifted via
   initial_core_run_state — signature Nat -> integer -> Symbol.digest -> file -> fs_state ->
   driver_state * Nat, entry shape (b); OCaml: unchanged behavior, the
   run-state redirect carries no draw). -/
def initial_driver_state_with (address_space_top1 : Int) (run_st : core_run_state)
    (file1 : generic_file Unit core_run_annotation) (fs_state2 : CerbFS.FsState) :
    driver_state :=
  (({ core_file := file1,
      core_extern := (create_extern_symmap file1),
      core_state0 := initial_core_state,
      core_run_state0 := run_st,
      layout_state := (CerbMem.initialMemState address_space_top1),
      concurrency_state := (symInitialState symInitialPre),
      fs_state0 := fs_state2,
      trace := ([] : List trace_event),
      symbolic_assoc := fmapEmpty,
      blocked := false,
      dr_step_counter := 0 } : driver_state))

/- address-space-bound slice (2026-09-17): the address-space top is the FIRST explicit
   parameter of every entry (the Lean supply binder the backend inserts stays ahead of
   it); a consumer theorem quantifies it. The run digest is the SECOND explicit
   parameter (D-S, 2026-09-22). -/
def initial_driver_state (_lemSupply_fresh_int : Nat) (address_space_top1 : Int) (digest1 : String)
    (file1 : generic_file Unit core_run_annotation) (fs_state2 : CerbFS.FsState) :
    (driver_state × Nat) :=
  let (_lemSupplyV0, _lemSupplyS1) :=
    (initial_core_run_state _lemSupply_fresh_int digest1 (collect_labeled_continuations_NEW file1));
  ((initial_driver_state_with address_space_top1 _lemSupplyV0 file1 fs_state2), _lemSupplyS1)

/- the explicit-supply variant for the const-expr mini-run: consumes
   exactly one draw (the run-seed), mirroring the lifted entry above -/
def initial_driver_state_given (sup : Nat) (address_space_top1 : Int) (digest1 : String)
    (file1 : generic_file Unit core_run_annotation) (fs_state2 : CerbFS.FsState) :
    (driver_state × Nat) :=
  (initial_driver_state_with address_space_top1
    (initial_core_run_state_given sup digest1 (collect_labeled_continuations_NEW file1)) file1
    fs_state2, (sup + 1))
def driver_spawn_thread { a b c : Type } [LemFuel] (parent_tid_opt : Option thread_id)
    (th_st : thread_state) :
    ndM Nat b c a driver_state :=
  nd_bind nd_get (fun (dr_st : driver_state) =>
    match runStateM (spawn_thread parent_tid_opt th_st dr_st.core_state0) dr_st.core_run_state0 with
    | ((tid1, core_st'), run_st') =>
      nd_bind
        (nd_update (fun (dr_st : driver_state) =>
          { { dr_st with core_run_state0 := run_st' } with core_state0 := core_st' }))
        (fun (_ : Unit) => nd_return tid1))

def driver_update_thread_state { a b c : Type } (tid1 : Nat) (th_st : thread_state) :
    ndM Unit b c a driver_state :=
  nd_update (fun (dr_st : driver_state) =>
    { dr_st with core_state0 := update_thread_state tid1 th_st dr_st.core_state0 })

def driver_globals [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool)
    (file1 : generic_file Unit core_run_annotation) :
    ndM Nat step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  nd_bind
    (/- spawning a thread for the initialisation of globals, and later the execution of main -/ driver_spawn_thread
      none
      (({ arena := (Expr ([] : List annot) (Epure (Pexpr ([] : List annot) () (PEval Vunit)))),
          stack0 := Stack_empty /- Core_run.push_empty_continuation Nothing Core_run.empty_stack -/,
          errno := (CerbMem.nullPtrval signed_int),
          env := [fmapEmpty],
          current_loc := CerbLocation.unknown,
          exec_loc := ELoc_globals,
          current_proc_opt := none } : thread_state)))
    (fun (tid0 : Nat) =>
      nd_bind (nd_read (fun (dr_st : driver_state) => dr_st.core_file.globs))
        (fun (globs1 : List (sym × generic_globs core_run_annotation Unit)) =>
          let glob_defs :=
            List.reverse
              (List.foldl
                (fun (acc : List (sym × core_base_type × generic_expr core_run_annotation Unit sym))
                  (p : (sym × generic_globs core_run_annotation Unit)) =>
                  match acc, p with
                  | acc, (sym1, glb) =>
                    (match glb with
                     | GlobalDef (bTy, _) e => (sym1, bTy, e) :: acc
                     | GlobalDecl _ => acc))
                ([] : List (sym × core_base_type × generic_expr core_run_annotation Unit sym))
                globs1);
          nd_bind
            (nd_mapM_
              (fun (p : (sym × core_base_type × generic_expr core_run_annotation Unit sym)) =>
                match p with
                | (glob_sym, glob_bTy, expr1) =>
                  ((lemSeq
                    (fun _ =>
                      CerbDebug.print_debug_pure 6 [DB_driver] (fun (u : Unit) =>
                        match u with
                        | () => /- DEBUG -/
                          String.append "Starting the evaluation of global `"
                            (String.append (show_symbol glob_sym) "'") /- DEBUG -/))
                    (fun _ =>
                      nd_bind
                        (nd_bind /- DEBUG -/
                          /- setting up the initialisation of the current global in thread 0 -/ get_thread_states
                          (fun (x : List (Nat × (Option thread_id × thread_state))) =>
                            match x with
                            | [(_, (_, th_st))] =>
                              driver_update_thread_state tid0
                                (({ arena := expr1,
                                    stack0 :=
                                      Stack_empty /- Core_run.push_empty_continuation Nothing Core_run.empty_stack -/,
                                    env := th_st.env,
                                    errno := (CerbMem.nullPtrval signed_int),
                                    current_loc :=
                                      (CerbLocation.other
                                        (String.append "global("
                                          (String.append (show_symbol glob_sym) ")"))),
                                    exec_loc := ELoc_globals,
                                    current_proc_opt := none } : thread_state))
                            | _ =>
                              (failwithI "ERROR (in Driver, global init didn't evaluate to value)" :
                                ndM Unit step_kind driver_error mem_iv_constraint driver_state)))
                        (fun (u : Unit) =>
                          match u with
                          | () =>
                            nd_bind
                              (/- evaluation of the initialisation -/ (driver2
                                _lemReader_enum_definitions _lemReader_tagDefs) with_concurrency)
                              (fun (u : Unit) =>
                                match u with
                                | () =>
                                  nd_bind get_thread_states
                                    (fun (x : List (Nat × (Option thread_id × thread_state))) =>
                                      match x with
                                      | [(_, (_, th_st))] =>
                                        (/- TODO: technically the arena should always be a value at this point -/
                                        match to_pure th_st.arena with
                                        | some pe =>
                                          (match valueFromPexpr pe with
                                           | none =>
                                             (failwithI "WIP: driver_globals" : ndM Unit step_kind
                                               driver_error mem_iv_constraint driver_state)
                                           | some cval =>
                                             driver_update_thread_state tid0
                                               { th_st with
                                                 env := update_env
                                                   (Pattern ([] : List annot)
                                                     (CaseBase (some glob_sym, glob_bTy))) cval
                                                   th_st.env }
                                               /-

                      ND.update (fun dr_st ->
                        <| dr_st with
                          core_run_state=
                            <| dr_st.core_run_state with Core_run.env= Core_aux.update_env (Core.Pattern [] (Core.CaseBase (Just (glob_sym), glob_bTy))) cval dr_st.core_run_state.Core_run.env |>
                        |>
                     ) -/
                                               )
                                        | none =>
                                          (failwithI
                                            "TODO(msg): Driver.driver_globals, the end of the evaluation of a glob didn't produce a value" :
                                            ndM Unit step_kind driver_error mem_iv_constraint
                                            driver_state))
                                      | _ =>
                                        (failwithI
                                          "ERROR (in Driver, global init didn't evaluate to value)" :
                                          ndM Unit step_kind driver_error mem_iv_constraint
                                          driver_state)))))))) glob_defs)
            (fun (_ : Unit) => nd_return tid0)))

def prepare_main_args [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (callconv : calling_convention) (tid0 : Nat) (main_sym : sym) (arg_strs : List String)
    (argc_sym : sym) (argv_sym : sym) :
    ndM (value × value) step_kind driver_error (mem_constraint CerbMem.IntegerValue)
        driver_state := /- memory_values to be stored in memory objects pointed to by the element of main.argv -/
  let args_mem_val_tys :=
    List.map
      (fun (arg_str : String) =>
        let mem_vals :=
          List.map
            (fun (c : Char) => /- TODO: fixing impl choice here (ASCII) -/
              integer_mval Char0 (CerbDecode.decode_character_constant (String.ofList [c])))
            (String.toList arg_str);
        /- NOTE: adding a null termination to the char array -/ (CerbMem.arrayMval
          (mem_vals ++ [integer_mval Char0 ((0 : Int))]),
          Ctype ([] : List annot)
            (Array0 char0 (some ((Int.ofNat (List.length mem_vals)) + (1 : Int)))))) arg_strs;
  let number_of_args := Int.ofNat (List.length args_mem_val_tys);
  nd_bind
    (/- allocating and initialising the objects pointed to by the elements of argv -/ nd_foldlM
      (fun (ptr_vals : List CerbMem.PointerValue) (p : (CerbMem.MemValue × ctype)) =>
        match ptr_vals, p with
        | ptr_vals, (arg_mem_val, arg_ty) =>
          liftMem
            (nd_bind
              ((CerbMem.allocateObject _lemReader_enum_definitions _lemReader_tagDefs) tid0
                (PrefOther "argv refs")
                ((CerbMem.alignofIval _lemReader_enum_definitions _lemReader_tagDefs) arg_ty) arg_ty
                none none)
              (fun (ptr_val : CerbMem.PointerValue) =>
                nd_bind
                  ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
                    (CerbLocation.other "argv refs init") arg_ty false ptr_val arg_mem_val)
                  (fun (_ : CerbMem.Footprint) => nd_return (ptr_val :: ptr_vals)))))
      ([] : List CerbMem.PointerValue) args_mem_val_tys)
    (fun (ptr_vals_rev : List CerbMem.PointerValue) =>
      nd_bind
        (/- allocating and initialising an object for main.argv -/ /- NOTE: the element argv[argc] is required to be a null pointer
      by the STD, hence argv has one more element than the number
      of supplied arguments -/
        liftMem
          (let pref := PrefSource loc1 [main_sym, argv_sym] /- TODO: change the sym? -/;
           let argv_array_ty :=
             Ctype ([] : List annot)
               (Array0 pointer_to_char (some ((1 : Int) + (Int.ofNat (List.length ptr_vals_rev)))));
           let argv_array_mem_val :=
             CerbMem.arrayMval
               (List.map (CerbMem.pointerMval char0)
                 (List.reverse (CerbMem.nullPtrval char0 :: ptr_vals_rev)));
           nd_bind
             ((CerbMem.allocateObject _lemReader_enum_definitions _lemReader_tagDefs) tid0 pref
               ((CerbMem.alignofIval _lemReader_enum_definitions _lemReader_tagDefs) argv_array_ty)
               argv_array_ty none none)
             (fun (ptr_val : CerbMem.PointerValue) =>
               nd_bind
                 ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
                   (CerbLocation.other "argv array init") argv_array_ty false ptr_val
                   argv_array_mem_val) (fun (_ : CerbMem.Footprint) => nd_return ptr_val))))
        (fun (argv_array_ptr_val : CerbMem.PointerValue) =>
          match callconv with
          | Normal_callconv =>
            (let argc_mem_val := integer_mval (Signed Int_) number_of_args;
             liftMem
               (let pref := PrefSource loc1 [main_sym, argc_sym];
                nd_bind
                  ((CerbMem.allocateObject _lemReader_enum_definitions _lemReader_tagDefs) tid0 pref
                    ((CerbMem.alignofIval _lemReader_enum_definitions _lemReader_tagDefs)
                      signed_int) signed_int none none)
                  (fun (argc_ptr_val : CerbMem.PointerValue) =>
                    nd_bind
                      ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
                        (CerbLocation.other "argc init") signed_int false argc_ptr_val argc_mem_val)
                      (fun (_ : CerbMem.Footprint) =>
                        /- NOTE: because of argument promotions, the char *argv[] is turned into a char **argv
              so two objects are allocated: an array and a pointer to that array (which is what argv designate) -/
                        let pref := PrefSource loc1 [main_sym, argv_sym];
                        let argv_ty := mk_ctype_pointer no_qualifiers pointer_to_char;
                        nd_bind
                          ((CerbMem.allocateObject _lemReader_enum_definitions _lemReader_tagDefs)
                            tid0 pref
                            ((CerbMem.alignofIval _lemReader_enum_definitions _lemReader_tagDefs)
                              argv_ty) argv_ty none none)
                          (fun (argv_ptr_val : CerbMem.PointerValue) =>
                            nd_bind
                              ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
                                (CerbLocation.other "argv init") argv_ty false argv_ptr_val
                                (CerbMem.pointerMval pointer_to_char argv_array_ptr_val))
                              (fun (_ : CerbMem.Footprint) =>
                                nd_return
                                  (Vobject (OVpointer argc_ptr_val),
                                    Vobject (OVpointer argv_ptr_val))))))))
          | Inner_arg_callconv =>
            (let argc_cval :=
               Vloaded (LVspecified (OVinteger (CerbMem.integerIval number_of_args)));
             let argv_cval := Vloaded (LVspecified (OVpointer argv_array_ptr_val));
             nd_return (argc_cval, argv_cval))))
def drive [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool)
    (file1 : generic_file Unit core_run_annotation) (arg_strs : List String) :
    ndM driver_result step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  nd_bind
    (/- Setting the read-only tag definitions (used by the memory model) -/ /- first we execute the body of global definitions and remove their symbols
     from the rest of the program -/
    (driver_globals _lemReader_enum_definitions _lemReader_tagDefs) with_concurrency file1)
    (fun (tid0 : Nat) /- , post_globals_dr_st) -/ =>
      nd_bind nd_get (fun (post_globals_dr_st : driver_state) =>
        nd_bind
          (/- we need a startup function to have been declared -/
          match post_globals_dr_st.core_file.main with
          | some sym1 => nd_return sym1
          | none => kill (Other (DErr_other "no startup function was declared")))
          (fun (main_sym :
            sym) => /- setting the arena of thread 0 to the body of the main function -/
            match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) main_sym
                post_globals_dr_st.core_file.funs) with
            | none => kill (Other (DErr_other "couldn't find the startup function"))
            | some decl =>
              nd_bind
                (match decl with
                 | Fun _ params pe =>
                   nd_return
                     (CerbLocation.other "main args", params, Expr ([] : List annot) (Epure pe))
                 | ProcDecl _ _ _ =>
                   kill (Other (DErr_other "the startup function has no definition"))
                 | BuiltinDecl _ _ _ =>
                   kill (Other (DErr_other "the startup function has no definition"))
                 | Proc loc1 _ _ params e => nd_return (loc1, params, e))
                (fun (p :
                  (CerbLocation.Loc × List (sym × core_base_type) × generic_expr core_run_annotation
                    Unit sym)) =>
                  match p with
                  | (loc1, params, expr1) =>
                    nd_bind
                      (match params with
                       | [(argc_sym, _), (argv_sym, _)] =>
                         nd_bind
                           (/-
              /- memory_values to be stored in memory objects pointed to by
                 the element of main.argv  -/
              let args_mem_val_tys =
                List.map (fun arg_str ->
                  let mem_vals =
                    List.map (fun c ->
                      /- TODO: fixing impl choice here (ASCII) -/
                      Mem.integer_mval Ctype.Char $ Decode.decode_character_constant (String.toString [c])
                    ) (String.toCharList arg_str) in
                  /- NOTE: adding a null termination to the char array -/
                  (
                    Mem.array_mval $ mem_vals ++ [Mem.integer_mval Ctype.Char 0],
                    Ctype.Ctype [] (Ctype.Array Ctype.char (Just ((integerFromNat (List.length mem_vals)) + 1)))
                  )
                ) arg_strs in
              
              /- memory value to be stored in the memory object pointed to by main.argc -/
              let number_of_args = integerFromNat (List.length args_mem_val_tys) in
              let argc_mem_val = Mem.integer_mval (Ctype.Signed Ctype.Int_) number_of_args in
              
              /- begin if false /- Global.has_switch Global.SW_inner_arg_temps -/ then
                /- in this switch (for CN) Core procedures elaborating C functions
                   receive values (and to the temp allocation themselves) -/
                   ND.return (Core.Vobject (Core.OVinteger (Mem.integer_ival number_of_args)))
              else -/
                /- allocating and initialising an object for main.argc -/
                liftMem (
                  Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argc_sym])
                              (Mem.alignof_ival Ctype.signed_int) Ctype.signed_int Nothing Nothing) (fun ptr_val ->
                    Mem.bind (Mem.store (Loc.other "argc init") Ctype.signed_int false ptr_val argc_mem_val) (fun _ ->
                      Mem.return (Core.Vobject (Core.OVpointer ptr_val))
                    )
                  )
                )
              /- end -/ >>= fun argc_cval ->
              
              /- allocating and initialising the objects pointed to by the elements of argv -/
              ND.foldlM (fun ptr_vals (arg_mem_val, arg_ty) ->
                liftMem (
                  Mem.bind (Mem.allocate_object tid0 (Symbol.PrefOther "argv refs") (Mem.alignof_ival arg_ty) arg_ty Nothing Nothing) (fun ptr_val ->
                    Mem.bind (Mem.store (Loc.other "argv refs init") arg_ty false ptr_val arg_mem_val) (fun _ ->
                      Mem.return (ptr_val :: ptr_vals)
                    )
                  )
                )
              ) [] args_mem_val_tys >>= fun ptr_vals_rev ->
              
              /- allocating and initialising an object for main.argv -/
              /- NOTE: the element argv[argc] is required to be a null pointer
                 by the STD, hence argv has one more element than the number
                 of supplied arguments -/
              let argv_array_elem_ty = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char) in
              let argv_array_ty = Ctype.Ctype [] (Ctype.Array argv_array_elem_ty (Just (1 + (integerFromNat $ List.length ptr_vals_rev)))) in
              let argv_array_mem_val = Mem.array_mval $
                List.map (Mem.pointer_mval Ctype.char) (List.reverse ptr_vals_rev ++ [Mem.null_ptrval Ctype.char]) in
              liftMem (
                Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argv_sym/- TODO: change the sym? -/])
                            (Mem.alignof_ival argv_array_ty) argv_array_ty Nothing Nothing) (fun array_ptr_val ->
                Mem.bind (Mem.store (Loc.other "argv array init") argv_array_ty false array_ptr_val argv_array_mem_val) (fun _ ->
                
                /- NOTE: because of argument promotions, the char *argv[] is turned into a char **argv
                   so two objects are allocated: an array and a pointer to that array (which is what argv designate) -/
                let argv_ty = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers (Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char))) in
                Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argv_sym])
                            (Mem.alignof_ival argv_ty) argv_ty Nothing Nothing) (fun argv_ptr_val ->
                Mem.bind (Mem.store (Loc.other "argv init") argv_ty false argv_ptr_val
                            (Mem.pointer_mval (Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char)) array_ptr_val)) ( fun _ ->

                Mem.return (Core.Vobject (Core.OVpointer argv_ptr_val))
                ))))
              ) >>= fun argv_cval ->
-/
                           (prepare_main_args _lemReader_enum_definitions _lemReader_tagDefs) loc1
                             file1.calling_convention0 tid0 main_sym arg_strs argc_sym argv_sym)
                           (fun (p : (value × value)) =>
                             match p with
                             | (argc_cval, argv_cval) =>
                               nd_bind
                                 (nd_bind
                                   /- Adding the values of argc and argv to the Core symbol environment -/ get_thread_states
                                   (fun (x : List (Nat × (Option thread_id × thread_state))) =>
                                     match x with
                                     | [(_, (_, th_st))] =>
                                       driver_update_thread_state tid0
                                         { th_st with
                                           env :=
                                             match th_st.env with
                                             | [] =>
                                               [Lem_Map.fromList
                                                 [(argc_sym, argc_cval), (argv_sym, argv_cval)]]
                                             | (xs :: xs') =>
                                               ((fmapAddBy
                                                 (fun (sym1 : sym) (sym2 : sym)=>
                                                   ordCompare sym1 sym2) argc_sym argc_cval
                                                 ((fmapAddBy
                                                   (fun (sym1 : sym) (sym2 : sym)=>
                                                     ordCompare sym1 sym2) argv_sym argv_cval
                                                   xs)))) :: xs' }
                                     | _ =>
                                       (failwithI "ERROR (in Driver 1)" : ndM Unit step_kind
                                         driver_error mem_iv_constraint driver_state)))
                                 (fun (u : Unit) =>
                                   match u with
                                   | () => nd_return expr1))
                       | _ => nd_return expr1)
                      (fun (expr1 : generic_expr core_run_annotation Unit sym) =>
                        nd_bind
                          (/- allocating and initialising errno -/ liftMem
                            (nd_bind
                              ((CerbMem.allocateObject _lemReader_enum_definitions
                                _lemReader_tagDefs) tid0 (PrefOther "errno")
                                ((CerbMem.alignofIval _lemReader_enum_definitions
                                  _lemReader_tagDefs) signed_int) signed_int none none)
                              (fun (ptr_val : CerbMem.PointerValue) =>
                                let zero :=
                                  CerbMem.integerValueMval (Signed Int_)
                                    (CerbMem.integerIval ((0 : Int)));
                                nd_bind
                                  ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
                                    (CerbLocation.other "errno init") signed_int false ptr_val zero)
                                  (fun (_ : CerbMem.Footprint) => nd_return ptr_val))))
                          (fun (errno_ptr_val : CerbMem.PointerValue) =>
                            nd_bind
                              (nd_bind
                                (nd_bind get_thread_states
                                  (fun (x : List (Nat × (Option thread_id × thread_state))) =>
                                    match x with
                                    | [(_, (_, th_st))] =>
                                      driver_update_thread_state tid0
                                        (({ arena := expr1,
                                            stack0 :=
                                              Stack_empty /- Core_run.push_empty_continuation (Just main_sym) Core_run.empty_stack -/,
                                            errno := errno_ptr_val,
                                            current_loc := (CerbLocation.other "Driver.drive"),
                                            exec_loc :=
                                              (ELoc_normal
                                                [(main_sym, CerbLocation.other "Driver.drive")]),
                                            env := th_st.env,
                                            current_proc_opt := (some main_sym) } : thread_state))
                                    | _ =>
                                      (failwithI "ERROR (in Driver 2)" : ndM Unit step_kind
                                        driver_error mem_iv_constraint driver_state)))
                                (fun (_ : Unit) =>
                                  (driver2 _lemReader_enum_definitions _lemReader_tagDefs)
                                    with_concurrency))
                              (fun (_ : Unit) =>
                                lem_if with_concurrency then
                                  (failwithI "CONCURRENCY IS BROKEN" : ndM driver_result step_kind
                                    driver_error (mem_constraint CerbMem.IntegerValue) driver_state)
                                else
                                  nd_bind nd_get (fun (dr_st' : driver_state) =>
                                    nd_return
                                      ((finalize _lemReader_enum_definitions _lemReader_tagDefs)
                                        "drive (without concur)" dr_st')))))))))
