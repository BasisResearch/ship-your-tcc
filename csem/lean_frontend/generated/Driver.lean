        (mem_constraint CerbMem.IntegerValue) driver_state :=
  nd_bind nd_get (fun (dr_st : driver_state) =>
    let tids := List.map Prod.fst dr_st.core_state0.thread_states;
    nd_bind
      ((drive_nonmemory_steps_aux2 _lemReader_enum_definitions _lemReader_tagDefs) fmapEmpty
        /- NEXT -/ tids)
      (fun (m : Fmap Nat (List core_step2)) =>
        nd_mapM
          (fun (p : (Nat × List core_step2)) =>
            match p with
            | (tid1, steps) =>
              (let size := List.length steps;
               (lemSeq
                 (fun _ =>
                   lem_if natGtb size 1 then
                     CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                       match u with
