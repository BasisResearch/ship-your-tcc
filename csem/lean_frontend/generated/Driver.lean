                                       | Step_fs2 tid1 _ _ =>
                                         String.append "Step_fs2 -- tid: "
                                           (Lem_String_extra.stringFromNat tid1)
                                       | Step_nd2 _ => "Step_nd2") steps))))))
                   else
                     ())
                 (fun _ =>
                   nd_bind (pick (SK_misc ["new_drive_core_threads"]) steps)
                     (fun (step1 : core_step2) =>
                       (lemSeq
                         (fun _ =>
                           lem_if natGtb size 1 then
                             CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                               match u with
                               | () =>
