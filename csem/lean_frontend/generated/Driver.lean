                                         match kind1 with
                                         | RSK_eval debug_str =>
                                           String.append "RSK_eval[" (String.append debug_str "]")
                                         | RSK_tau debug_str kind' =>
                                           (let kind'_str :=
                                              match kind' with
                                              | TSK_Ccall sym1 _ =>
                                                String.append "TSK_Ccall("
                                                  (String.append (show_symbol sym1) ")")
                                              | TSK_Return sym1 _ =>
                                                String.append "TSK_Return("
                                                  (String.append (show_symbol sym1) ")")
                                              | TSK_Misc => "TSK_Misc";
                                            String.append "RSK_tau["
                                              (String.append debug_str
                                                (String.append ", "
                                                  (String.append kind'_str "]"))));
                                       String.append "Step_with_runstate2["
                                         (String.append kind_str "]"))
                                    | Step_tau2 debug_str kind1 _ =>
                                      String.append "Step_tau2<TAU>[" (String.append debug_str "]")
                                    | Step_action_request2 debug_str loc1 tid1 is_unseq_with_ccall1
                                      _ =>
                                      String.append "Step_action_request2["
                                        (String.append debug_str
                                          (String.append "] -- tid: "
                                            (String.append (Lem_String_extra.stringFromNat tid1)
                                              (String.append
                                                (lem_if is_unseq_with_ccall1 then
                                                  " [unseq_with_call]"
                                                else
                                                  "")
                                                (String.append " -- at loc: "
                                                  (CerbLocation.stringFromLocation loc1))))))
                                    | Step_blocked2 => "Step_blocked2"
                                    | Step_error2 debug_str =>
                                      String.append "Step_error2[" (String.append debug_str "]")
                                    | Step_thread_done2 tid1 cval =>
                                      String.append "Step_thread_done2(tid: "
                                        (String.append (Lem_String_extra.stringFromNat tid1)
                                          (String.append ") -- value: "
                                            (CerbPP.stringFromCore_value cval)))
                                    | Step_done2 cval =>
                                      String.append "Step_done2 -- value: "
                                        (CerbPP.stringFromCore_value cval)
                                    | Step_memop_request2 loc1 memop1 _ tid1 is_unseq_with_ccall1
                                      _ =>
                                      String.append "Step_memop_request2["
                                        (String.append
                                          ((fun (x : generic_memop sym) =>
                                            match x with
                                            | PtrEq => "ptreq"
                                            | PtrNe => "ptrne"
                                            | PtrLt => "ptrlt"
                                            | PtrGt => "ptrgt"
                                            | PtrLe => "ptrle"
                                            | PtrGe => "ptrge"
                                            | Ptrdiff => "ptrdiff"
                                            | IntFromPtr => "intfromptr"
                                            | PtrFromInt => "ptrfromint"
                                            | PtrValidForDeref => "ptrvalidforderef"
                                            | PtrWellAligned => "ptrwellaligned"
                                            | Memcpy => "memcpy"
                                            | Memcmp => "memcmp"
                                            | Realloc => "realloc"
                                            | PtrArrayShift => "ptrarrayshift"
                                            | PtrMemberShift tag_sym membr_ident =>
                                              String.append "ptrmembershift["
                                                (String.append (show_symbol tag_sym)
                                                  (String.append ", "
                                                    (String.append
                                                      (match membr_ident with
                                                       | Identifier _ str => str) "]")))
                                            | Va_start => "va_start"
                                            | Va_copy => "va_copy"
                                            | Va_arg => "va_arg"
                                            | Va_end => "va_end"
                                            | Copy_alloc_id => "copy_alloc_id"
                                            | CHERI_intrinsic str _ => String.append "cheri_" str)
                                            memop1)
                                          (String.append "] -- tid: "
                                            (String.append (Lem_String_extra.stringFromNat tid1)
                                              (String.append
                                                (lem_if is_unseq_with_ccall1 then
                                                  " [unseq_with_call]"
                                                else
                                                  "")
                                                (String.append " -- at loc: "
                                                  (CerbLocation.stringFromLocation loc1))))))
                                    | Step_spawn_threads2 _ _ => "Step_spawn_threads2"
                                    | Step_fs2 tid1 _ _ =>
                                      String.append "Step_fs2 -- tid: "
                                        (Lem_String_extra.stringFromNat tid1)
                                    | Step_nd2 _ => "Step_nd2"))
                           else
                             ()) (fun _ => nd_return (tid1, some step1)))))))) (fmapElements m)))

def prepare_exit (core_st : core_state) (cval : value) : core_state :=
  match Lem_List.find
      (fun (x : (Nat × (Option Nat × thread_state))) =>
        match x with
        | (_, (none, _)) => true
        | _ => false) core_st.thread_states with
  | none => (failwithI "Driver.prepare_exit ==> failed to find the initial thread" : core_state)
  | some (tid0, (_, th_st)) =>
    (let th_st' := { { th_st with stack0 := Stack_empty } with arena := mk_value_e cval };
     { core_st with thread_states := [(tid0, (none, th_st'))] })

/- performing all action and memop requests until there are no more -/

def process_core_step2 [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool)
    (driver21 : Bool → ndM Unit step_kind driver_error (mem_constraint CerbMem.IntegerValue)
      driver_state) :
    core_step2 → ndM Unit step_kind driver_error (mem_constraint CerbMem.IntegerValue)
        driver_state :=
  fun (x : core_step2) =>
    match x with
    | Step_action_request2 _ loc1 tid1 _ m_request =>
      nd_bind (liftCore_run m_request) (fun (request : action_request2 thread_state) =>
        nd_bind
          ((perform_action_request2 _lemReader_enum_definitions _lemReader_tagDefs) with_concurrency
            loc1 tid1 request)
          (fun (u : Unit) =>
            match u with
            | () => driver21 with_concurrency))
    | Step_memop_request2 loc1 memop1 cvals tid1 _ mk_th_st =>
      nd_bind
        ((perform_memop_request2 _lemReader_enum_definitions _lemReader_tagDefs) loc1 memop1 cvals
          tid1 mk_th_st)
        (fun (u : Unit) =>
          match u with
          | () => driver21 with_concurrency)
    | Step_done2 cval =>
      nd_bind
        (print_debug 3 [DB_driver] (fun (u : Unit) =>
          match u with
          | () =>
            String.append "driver.process_core_step ==> Step_done2 with value: "
              (CerbPP.stringFromCore_value cval)))
        (fun (_ : Unit) => /- DEBUG -/ /- ND.return () -/
          nd_update
            (fun (dr_st :
              driver_state) => /- killing all threads and aborting the main thread and placing [cval] as its result -/
              { dr_st with core_state0 := prepare_exit dr_st.core_state0 cval }))
    | Step_ccall2 tid1 step_m =>
      nd_bind (liftCore_run step_m) (fun (th_st' : thread_state) =>
        nd_bind
          (nd_update (fun (dr_st : driver_state) =>
            { { dr_st with dr_step_counter := dr_st.dr_step_counter + 1 } with
              core_state0 := update_thread_state tid1 th_st' dr_st.core_state0 }))
          (fun (u : Unit) =>
            match u with
            | () => driver21 with_concurrency))
    | Step_fs2 tid1 th_st m_fs_step =>
      nd_bind (liftCore_run m_fs_step) (fun (x : fs_oper_or_done) =>
        match x with
        | FS_done cval =>
          nd_update
            (fun (dr_st :
              driver_state) => /- killing all threads and aborting the main thread and placing [cval] as its result -/
              { dr_st with core_state0 := prepare_exit dr_st.core_state0 cval })
        | FS_oper fs_step =>
          nd_bind nd_get (fun (dr_st : driver_state) =>
            nd_bind
              ((drive_fs_step _lemReader_enum_definitions _lemReader_tagDefs) tid1 th_st dr_st
                fs_step)
              (fun (u : Unit) =>
                match u with
                | () => driver21 with_concurrency)))
    | wrong_step =>
      (failwithI
        (String.append "Driver.process_core_step2: WRONG STEP ==> "
          (match wrong_step with
           | Step_ccall2 _ _ => "Step_ccall2"
           | Step_with_runstate2 kind1 _ =>
             (let kind_str :=
                match kind1 with
                | RSK_eval debug_str => String.append "RSK_eval[" (String.append debug_str "]")
                | RSK_tau debug_str kind' =>
                  (let kind'_str :=
                     match kind' with
                     | TSK_Ccall sym1 _ =>
                       String.append "TSK_Ccall(" (String.append (show_symbol sym1) ")")
                     | TSK_Return sym1 _ =>
                       String.append "TSK_Return(" (String.append (show_symbol sym1) ")")
                     | TSK_Misc => "TSK_Misc";
                   String.append "RSK_tau["
                     (String.append debug_str (String.append ", " (String.append kind'_str "]"))));
              String.append "Step_with_runstate2[" (String.append kind_str "]"))
           | Step_tau2 debug_str kind1 _ =>
             String.append "Step_tau2<TAU>[" (String.append debug_str "]")
           | Step_action_request2 debug_str loc1 tid1 is_unseq_with_ccall1 _ =>
             String.append "Step_action_request2["
               (String.append debug_str
                 (String.append "] -- tid: "
                   (String.append (Lem_String_extra.stringFromNat tid1)
                     (String.append (lem_if is_unseq_with_ccall1 then " [unseq_with_call]" else "")
                       (String.append " -- at loc: " (CerbLocation.stringFromLocation loc1))))))
           | Step_blocked2 => "Step_blocked2"
           | Step_error2 debug_str => String.append "Step_error2[" (String.append debug_str "]")
           | Step_thread_done2 tid1 cval =>
             String.append "Step_thread_done2(tid: "
               (String.append (Lem_String_extra.stringFromNat tid1)
                 (String.append ") -- value: " (CerbPP.stringFromCore_value cval)))
           | Step_done2 cval =>
             String.append "Step_done2 -- value: " (CerbPP.stringFromCore_value cval)
           | Step_memop_request2 loc1 memop1 _ tid1 is_unseq_with_ccall1 _ =>
             String.append "Step_memop_request2["
               (String.append
                 ((fun (x : generic_memop sym) =>
                   match x with
                   | PtrEq => "ptreq"
                   | PtrNe => "ptrne"
                   | PtrLt => "ptrlt"
                   | PtrGt => "ptrgt"
                   | PtrLe => "ptrle"
                   | PtrGe => "ptrge"
                   | Ptrdiff => "ptrdiff"
                   | IntFromPtr => "intfromptr"
                   | PtrFromInt => "ptrfromint"
                   | PtrValidForDeref => "ptrvalidforderef"
                   | PtrWellAligned => "ptrwellaligned"
                   | Memcpy => "memcpy"
                   | Memcmp => "memcmp"
                   | Realloc => "realloc"
                   | PtrArrayShift => "ptrarrayshift"
                   | PtrMemberShift tag_sym membr_ident =>
                     String.append "ptrmembershift["
                       (String.append (show_symbol tag_sym)
                         (String.append ", "
                           (String.append
                             (match membr_ident with
                              | Identifier _ str => str) "]")))
                   | Va_start => "va_start"
                   | Va_copy => "va_copy"
                   | Va_arg => "va_arg"
                   | Va_end => "va_end"
                   | Copy_alloc_id => "copy_alloc_id"
                   | CHERI_intrinsic str _ => String.append "cheri_" str) memop1)
                 (String.append "] -- tid: "
                   (String.append (Lem_String_extra.stringFromNat tid1)
                     (String.append (lem_if is_unseq_with_ccall1 then " [unseq_with_call]" else "")
                       (String.append " -- at loc: " (CerbLocation.stringFromLocation loc1))))))
           | Step_spawn_threads2 _ _ => "Step_spawn_threads2"
           | Step_fs2 tid1 _ _ =>
             String.append "Step_fs2 -- tid: " (Lem_String_extra.stringFromNat tid1)
           | Step_nd2 _ => "Step_nd2")) : ndM Unit step_kind driver_error
        (mem_constraint CerbMem.IntegerValue) driver_state)

def driver2_lemFuel [LemFuel] [CerbImplCfg.Impl] [CerbGlobal.Switches] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (with_concurrency : Bool) :
    ndM Unit step_kind driver_error (mem_constraint CerbMem.IntegerValue) driver_state :=
  match lemFuel with
  | 0 =>
    (ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
          match u with
          | () => "ENTERING Driver.driver2"))
      (fun _ =>
        nd_bind ((new_drive_core_threads _lemReader_enum_definitions _lemReader_tagDefs) ())
          (fun (tid_steps : List (Nat × Option core_step2)) =>
            nd_bind nd_get (fun (post_core_dr_st : driver_state) => /- TODO: hackish -/
              (lemSeq
                (fun _ =>
                  List.filter
                    (fun (p : (Nat × (Option thread_id × thread_state))) =>
                      match p with
                      | (tid1, th_info) =>
                        List.any
                          ((step_ctx _lemReader_enum_definitions _lemReader_tagDefs)
                            post_core_dr_st.layout_state post_core_dr_st.core_file
                            post_core_dr_st.core_extern tid1 th_info)
                          (fun (step1 : core_step2) => step1 != Step_blocked2))
                    post_core_dr_st.core_state0.thread_states)
                (fun _ =>
                  (lem_if (maybeEqualBy (fun x y => x == y) (CerbGlobal.current_execution_mode ())
                      (some CerbGlobal.ExecutionMode.random)) then
                    /- HACK The problem is that some threads are blocked (they wait
       for other threads to finish. If we randomly pick that thread to
       execute, there will not be any steps to execute, and the whole
       execution comes to a halt. To properly solve this, we need to
       implement back tracking. Since we haven't, we temporarily
       switch to exhaustive mode and also compute the steps of the
       other threads. -/
                    /-
    ND.bindExhaustive (ND.pick (SK_misc ["driver 2"]) non_blocked_th_sts)
                      (fun (tid, th_info) ->
                       ND.pick (SK_misc ["driver 3"]) $
                        Core_reduction.step_ctx post_core_dr_st.layout_state post_core_dr_st.core_file post_core_dr_st.core_extern tid th_info)
-/
                    bindExhaustive (pick (SK_misc ["driver 2"]) tid_steps)
                      (fun (p : (Nat × Option core_step2)) =>
                        match p with
                        | (tid1, step_opt) =>
                          ((lemSeq
                            (fun _ =>
                              CerbDebug.print_debug_pure 3 ([] : List domain) (fun (u : Unit) =>
                                match u with
                                | () =>
                                  String.append (Lem_String_extra.stringFromNat tid1)
                                    (String.append " ==> "
                                      (Lem_Maybe.maybe0 "Nothing"
                                        (fun (step1 : core_step2)=>
                                          match step1 with
                                          | Step_ccall2 _ _ => "Step_ccall2"
                                          | Step_with_runstate2 kind1 _ =>
                                            (let kind_str :=
                                               match kind1 with
                                               | RSK_eval debug_str =>
                                                 String.append "RSK_eval["
                                                   (String.append debug_str "]")
                                               | RSK_tau debug_str kind' =>
                                                 (let kind'_str :=
                                                    match kind' with
                                                    | TSK_Ccall sym1 _ =>
                                                      String.append "TSK_Ccall("
                                                        (String.append (show_symbol sym1) ")")
                                                    | TSK_Return sym1 _ =>
                                                      String.append "TSK_Return("
                                                        (String.append (show_symbol sym1) ")")
