                   (match Ord.compare x6 y6 with
                    | .lt => Ordering.lt
                    | .gt => Ordering.gt
                    | .eq =>
                      (match Ord.compare x7 y7 with
                       | .lt => Ordering.lt
                       | .gt => Ordering.gt
                       | .eq => Ord.compare x8 y8)))))))
  | .KillRequest x1 x2 x3 x4 x5 x6 x7 x8 x9, .KillRequest y1 y2 y3 y4 y5 y6 y7 y8 y9 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match Ord.compare x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq =>
             (match Ord.compare x4 y4 with
              | .lt => Ordering.lt
              | .gt => Ordering.gt
              | .eq =>
                (match Ord.compare x5 y5 with
