inductive core_tau_step_kind : Type where
  | TSK_Ccall : sym → List CerbMem.MemValue → core_tau_step_kind
  | TSK_Return : sym → Option CerbMem.MemValue → core_tau_step_kind
  | TSK_Misc : core_tau_step_kind
export core_tau_step_kind (TSK_Ccall TSK_Return TSK_Misc)
instance : Inhabited core_tau_step_kind where
  default := TSK_Misc
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def core_tau_step_kind.ctor_rank_ocaml : core_tau_step_kind → Nat
  | .TSK_Ccall _ _ => 1
  | .TSK_Return _ _ => 2
  | .TSK_Misc => 0
mutual
def core_tau_step_kind.beq_derived (cmpx_ cmpy_ : core_tau_step_kind) : Bool :=
  match cmpx_, cmpy_ with
  | .TSK_Ccall x1 x2, .TSK_Ccall y1 y2 => x1 == y1 && x2 == y2
  | .TSK_Return x1 x2, .TSK_Return y1 y2 => x1 == y1 && x2 == y2
  | .TSK_Misc, .TSK_Misc => true
  | _, _ => false
termination_by structural cmpx_
def core_tau_step_kind.compare_derived (cmpx_ cmpy_ : core_tau_step_kind) : Ordering :=
  match cmpx_, cmpy_ with
  | .TSK_Ccall x1 x2, .TSK_Ccall y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .TSK_Return x1 x2, .TSK_Return y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | xg, yg =>
    Ord.compare (core_tau_step_kind.ctor_rank_ocaml xg) (core_tau_step_kind.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq core_tau_step_kind where
