inductive core_step : Type where
  | Step_action_request : String → core_runM action_request → core_step
  | Step_memop_request :
      CerbLocation.Loc → memop → List value → thread_id → (value → thread_state) → core_step
  | Step_tau : String → core_tau_step_kind → core_runM thread_state → core_step
  | Step_eval : String → core_runM thread_state → core_step
  | Step_thread_done : thread_id → value → core_step
  /-  | Step_nd of string * list core_step -/
  | Step_blocked : core_step
  | Step_error : String → core_step
  | Step_constrained : String → List (mem_iv_constraint × core_runM thread_state) → core_step
  | Step_done : value → core_step
  | Step_spawn_threads :
      (expr core_run_annotation → thread_state) → List thread_state →
          core_step /- initial states for the children -/
  | Step_fs : thread_state → fs_oper → core_step
  | Step_bound : core_runM thread_state → core_step
export core_step (Step_action_request Step_memop_request Step_tau Step_eval Step_thread_done
    Step_blocked Step_error Step_constrained Step_done Step_spawn_threads Step_fs Step_bound)
instance : Inhabited core_step where
  default := Step_blocked
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def core_step.ctor_rank_ocaml : core_step → Nat
  | .Step_action_request _ _ => 1
  | .Step_memop_request _ _ _ _ _ => 2
  | .Step_tau _ _ _ => 3
  | .Step_eval _ _ => 4
  | .Step_thread_done _ _ => 5
  | .Step_blocked => 0
  | .Step_error _ => 6
  | .Step_constrained _ _ => 7
  | .Step_done _ => 8
  | .Step_spawn_threads _ _ => 9
  | .Step_fs _ _ => 10
  | .Step_bound _ => 11
mutual
def core_step.beq_derived (cmpx_ cmpy_ : core_step) : Bool :=
  match cmpx_, cmpy_ with
  | .Step_action_request x1 x2, .Step_action_request y1 y2 => x1 == y1 && lemFunctionalBeq x2 y2
  | .Step_memop_request x1 x2 x3 x4 x5, .Step_memop_request y1 y2 y3 y4 y5 =>
    x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && lemFunctionalBeq x5 y5
  | .Step_tau x1 x2 x3, .Step_tau y1 y2 y3 => x1 == y1 && x2 == y2 && lemFunctionalBeq x3 y3
  | .Step_eval x1 x2, .Step_eval y1 y2 => x1 == y1 && lemFunctionalBeq x2 y2
  | .Step_thread_done x1 x2, .Step_thread_done y1 y2 => x1 == y1 && x2 == y2
  | .Step_blocked, .Step_blocked => true
  | .Step_error x1, .Step_error y1 => x1 == y1
  | .Step_constrained x1 x2, .Step_constrained y1 y2 => x1 == y1 && core_step.beq_deriv_aux2 x2 y2
  | .Step_done x1, .Step_done y1 => x1 == y1
  | .Step_spawn_threads x1 x2, .Step_spawn_threads y1 y2 => lemFunctionalBeq x1 y1 && x2 == y2
  | .Step_fs x1 x2, .Step_fs y1 y2 => x1 == y1 && x2 == y2
  | .Step_bound x1, .Step_bound y1 => lemFunctionalBeq x1 y1
  | _, _ => false
termination_by structural cmpx_
def core_step.compare_derived (cmpx_ cmpy_ : core_step) : Ordering :=
  match cmpx_, cmpy_ with
  | .Step_action_request x1 x2, .Step_action_request y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .Step_memop_request x1 x2 x3 x4 x5, .Step_memop_request y1 y2 y3 y4 y5 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq =>
          (match Ord.compare x3 y3 with
           | .lt => Ordering.lt
           | .gt => Ordering.gt
           | .eq =>
             (match Ord.compare x4 y4 with
              | .lt => Ordering.lt
              | .gt => Ordering.gt
              | .eq => lemFunctionalCompare x5 y5))))
  | .Step_tau x1 x2 x3, .Step_tau y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => lemFunctionalCompare x3 y3))
  | .Step_eval x1 x2, .Step_eval y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => lemFunctionalCompare x2 y2)
  | .Step_thread_done x1 x2, .Step_thread_done y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .Step_error x1, .Step_error y1 => Ord.compare x1 y1
  | .Step_constrained x1 x2, .Step_constrained y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => core_step.cmp_deriv_aux1 x2 y2)
  | .Step_done x1, .Step_done y1 => Ord.compare x1 y1
  | .Step_spawn_threads x1 x2, .Step_spawn_threads y1 y2 =>
    (match lemFunctionalCompare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .Step_fs x1 x2, .Step_fs y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .Step_bound x1, .Step_bound y1 => lemFunctionalCompare x1 y1
  | xg, yg => Ord.compare (core_step.ctor_rank_ocaml xg) (core_step.ctor_rank_ocaml yg)
termination_by structural cmpx_
def core_step.cmp_deriv_aux1 (cmpx_ cmpy_ : List ((mem_iv_constraint × core_runM thread_state))) :
    Ordering :=
  match cmpx_, cmpy_ with
  | [], [] => Ordering.eq
  | [], _ :: _ => Ordering.lt
  | _ :: _, [] => Ordering.gt
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    (match (match Ord.compare x1 y1 with
            | .lt => Ordering.lt
            | .gt => Ordering.gt
            | .eq => lemFunctionalCompare x2 y2) with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => core_step.cmp_deriv_aux1 xs0 ys0)
termination_by structural cmpx_
def core_step.beq_deriv_aux2 (cmpx_ cmpy_ : List ((mem_iv_constraint × core_runM thread_state))) :
    Bool :=
  match cmpx_, cmpy_ with
  | [], [] => true
  | (x1, x2) :: xs0, (y1, y2) :: ys0 =>
    x1 == y1 && lemFunctionalBeq x2 y2 && core_step.beq_deriv_aux2 xs0 ys0
  | _, _ => false
termination_by structural cmpx_
end

