       (failwithI "WIP: LinuxRMW" : core_step)
       /-
  | FenceRequest of Loc.t * set action_id * set action_id * set action_id *
                    action_id * Mem_common.thread_id * Cmm.memory_order * ctype *
                    thread_state
-/
       )
def core_thread_step2 [LemFuel] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (mem_st : CerbMem.MemState)
    (file1 : generic_file Unit core_run_annotation) (core_extern1 : Fmap sym sym)
    (m : Fmap sym object_value) (current_tid : Nat) (p : (Option thread_id × thread_state)) :
    List core_step :=
  match mem_st, file1, core_extern1, m, current_tid, p with
  | mem_st, file1, core_extern1, _, /- concur_sym_map -/ current_tid, (parent_tid_opt, th_st) =>
    (let one : core_step → List core_step := (fun (z : core_step) => [z]);
     match th_st.arena with
     | Expr arena_annots expr_ =>
       (let maybe_loc := get_loc arena_annots;
        let th_st :=
          match maybe_loc with
          | none => th_st
          | some loc1 =>
            (lem_if CerbLocation.isLibraryLocation loc1 then
              th_st
            else
              { th_st with current_loc := loc1 });
        match expr_, th_st.stack0 with
        | _, Stack_cons2 _ _ _ =>
          (failwithI "Core_run.core_thread_step2 ==> Stack_cons2" : List core_step)
        | Eannot _ _, _ => (failwithI "Core_run.core_thread_step2 ==> Eannot" : List core_step)
        | Eexcluded _ _, _ =>
          (failwithI "Core_run.core_thread_step2 ==> Eexcluded" : List core_step)
        /-
    | (Eskip, Stack_empty) ->
        error "reached empty stack with an Eskip"
    
    | (Eskip, Stack_cons current_proc_opt cont sk') ->
/- -----------------------------------------
   <skip, κ.κs, Λ> --τ--> <κ(unit), ɛ.κs, Λ> -/
        one $ Step_tau "Eskip" TSK_Misc (
          E.return <| th_st with
            arena= apply_continuation cont (Expr arena_annots (Epure (Pexpr [] () (PEval Vunit))));
            stack= Stack_cons current_proc_opt [] sk'
