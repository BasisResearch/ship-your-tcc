def core_action_step [LemFuel] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (arena_annots : List annot)
    (core_extern1 : Fmap sym sym) (mem_st : CerbMem.MemState)
    (file1 : generic_file Unit core_run_annotation) (current_tid : Nat)
    (p0 : (Option Nat × thread_state)) (g : generic_paction core_run_annotation Unit sym) :
    core_step :=
  match arena_annots, core_extern1, mem_st, file1, current_tid, p0, g with
  | arena_annots, core_extern1, mem_st, file1, current_tid, (parent_tid_opt, th_st),
    (Paction p (Action loc1 annots1 act)) =>
    (let sb_before1 :=
       (/- filter out actions from other threads -/ setMapBy defaultCompare Prod.snd
         (setFilterBy setElemCompare
           (fun (p : (Nat × Nat)) =>
             match p with
             | (tid1, _) => tid1 == current_tid) annots1.sb_before));
     let dd_before1 := setEmpty;
     let asw_before_ :=
       lem_if has_sbBefore_on_thread current_tid annots1 then
         setEmpty
       else
         (setMapBy defaultCompare Prod.snd
           (setFilterBy setElemCompare
             (fun (p : (Nat × Nat)) =>
               match p with
               | (tid1, _) =>
                 (match parent_tid_opt with
                  | some parent_tid => tid1 == parent_tid
                  | _ => false)) annots1.sb_before));
     let asw_before1 := (setUnionBy defaultCompare annots1.asw_before asw_before_);
     match act with
     | Create pe1 pe2 pref =>
       (/- TODO: the russian doll pattern matching is because Lem is too slow on tuples -/
       match pe1 with
       | Pexpr _ () (PEconstrained xs1) => (failwithI "Create PEconstrained 1" : core_step)
       | _ =>
         (match pe2 with
          | Pexpr _ () (PEconstrained xs2) => (failwithI "Create PEconstrained 2" : core_step)
          | _ =>
            (match valueFromPexpr pe1, valueFromPexpr pe2 with
             | some (Vobject (OVinteger ival)), some (Vctype ty1) =>
               Step_action_request "CreateRequest"
                 (stExceptUndef_bind fresh_action_id (fun (create_aid : Nat) =>
                   core_run_return
                     (CreateRequest loc1 sb_before1 dd_before1 asw_before1 create_aid current_tid
                       pref ival ty1 none
                       (fun (ptr_val : CerbMem.PointerValue) =>
                         { { th_st with
                             stack0 := add_to_sb_stack
                               (setFromListBy setElemCompare [(p, (current_tid, create_aid))])
                               /- TODO: remove for sequential !!! -/ th_st.stack0 } with
                           arena := Expr arena_annots
                             (Epure
                               (Pexpr ([] : List annot) ()
                                 (PEval (Vobject (OVpointer ptr_val))))) }))))
             | some _, some _ =>
               Step_error
                 (String.append "found a create() with ill-typed operands ["
                   (String.append (CerbPP.stringFromSymbol_prefix pref) "]"))
             | none, _ =>
               Step_eval "first operand of a Create"
                 (stExceptUndef_bind
                   ((wrapped_eval_pexpr2 _lemReader_enum_definitions _lemReader_tagDefs) th_st
                     core_extern1 mem_st file1 pe1)
                   (fun (pe1' : generic_pexpr Unit sym) =>
                     core_run_return
                       { th_st with
                         arena := Expr arena_annots
