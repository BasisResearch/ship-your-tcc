                    | .gt => Ordering.gt
                    | .eq =>
                      (match Ord.compare x7 y7 with
                       | .lt => Ordering.lt
                       | .gt => Ordering.gt
                       | .eq =>
                         (match Ord.compare x8 y8 with
                          | .lt => Ordering.lt
                          | .gt => Ordering.gt
                          | .eq => Ord.compare x9 y9))))))))
  | xg, yg => Ord.compare (action_request.ctor_rank_ocaml xg) (action_request.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

