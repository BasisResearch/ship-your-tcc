              else
                (let xs :=
                   List.map
                     (fun (p :
                       (List (expr core_run_annotation) × generic_expr core_run_annotation Unit
                         sym × List (expr core_run_annotation))) =>
                       match p with
                       | (es1, ej, es2) =>
                         Step_tau "Eunseq" TSK_Misc
