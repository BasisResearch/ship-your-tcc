        (fmapElements st.allocations);
    let distinctness_constrs :=/- forall z_id: allocations, -/ List.map
        (fun (p : (Nat × storage)) =>
          match p with
          | (z_id, z_stor) =>
            (match match z_stor with
                   | Storage_static pref ty1 _ => (pref, IVsizeof ty1)
                   | Storage_dynamic pref ival_ _ => (pref, ival_) with
             | (z_pref,
               z_size_ival_) => /- @z_id + sizeof(int) <= @alloc_id \/ @alloc_id + sizeof(int) <= @z_id -/
