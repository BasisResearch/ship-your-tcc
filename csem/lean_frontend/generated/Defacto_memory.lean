/- Memory value destructor -/
def impl_case_mem_value { a : Type } [Inhabited a] (mval : impl_mem_value) (funspec : ctype → a)
    (fconcur : integerType → sym → a) (fival : integerType → impl_integer_value → a)
    (ffval : floatingType → impl_floating_value → a) (fptrval : ctype → impl_pointer_value → a)
    (farr : List impl_mem_value → a)
    (fstruct : sym → List (identifier × ctype × impl_mem_value) → a)
    (funion : sym → identifier → impl_mem_value → a) :
    a :=
  match mval with
  | MVinteger ity (ival@(IV _ ival_)) =>
    (match ival_ with
     | IVunspecified => funspec (Ctype ([] : List annot) (Basic (Integer ity)))
     | IVconcurRead ity2 sym1 => /- TODO: check ity1 vs ity2 ? -/ fconcur ity2 sym1
     | _ => fival ity ival)
  | MVfloating fty fval =>
    (match fval with
     | FVunspecified => funspec (Ctype ([] : List annot) (Basic (Floating fty)))
     | _ => ffval fty fval)
  | MVpointer ref_ty (ptrval@(PV _ ptrval_ _)) =>
    (match ptrval_ with
     | PVunspecified _ => /- TODO: or use the type in PVunspecified? -/
       funspec (Ctype ([] : List annot) (Pointer no_qualifiers ref_ty))
     | _ => fptrval ref_ty ptrval)
  | MVarray mvals => farr mvals
  | MVstruct tag_sym xs => fstruct tag_sym xs
  | MVunion tag_sym memb_ident mval => funion tag_sym memb_ident mval
  | MVdelayed _ _ => (failwithI "TODO: Defacto_memory.impl_case_mem_value, MVdelayed" : a)
  | MVcomposite _ _ => (failwithI "TODO: Defacto_memory.impl_case_mem_value, MVcomposite" : a)

def impl_case_fval { a : Type } (fval : impl_floating_value) (funspec : Unit → a)
    (fconcrete : CerbFloat.Value → a) :
    a :=
  match fval with
  | FVunspecified => funspec ()
  | FVconcrete str => fconcrete str

