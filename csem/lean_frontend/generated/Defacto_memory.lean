def memcmp_load_aux_lemFuel [LemFuel] [CerbImplCfg.Impl] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptrval : impl_pointer_value) (offset : Int) (max_offset : Int) (acc : List impl_mem_value) :
    ndM (List impl_mem_value) String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match lemFuel with
  | 0 =>
    (ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    (lem_if intGteb offset max_offset then
      nd_return (List.reverse acc)
    else
      let ptrval' :=(impl_array_shift_ptrval _lemReader_enum_definitions _lemReader_tagDefs) ptrval
          unsigned_char (IV Prov_none (IVconcrete offset));
      nd_bind
        ((impl_load _lemReader_enum_definitions _lemReader_tagDefs)
          (CerbLocation.other "memcmp_load_aux") unsigned_char ptrval')
        (fun (p : (impl_footprint × impl_mem_value)) =>
          match p with
          | (fp, mval) =>
            (memcmp_load_aux_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs) ptrval
              (offset + (1 : Int)) max_offset (mval :: acc)))

def memcmp_load_aux [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptrval : impl_pointer_value) (offset : Int) (max_offset : Int) (acc : List impl_mem_value) :
    impl_memM (List impl_mem_value) :=
  memcmp_load_aux_lemFuel (Int.toNat (max_offset - offset) + 1) _lemReader_enum_definitions
    _lemReader_tagDefs ptrval offset max_offset acc
theorem memcmp_load_aux_lemFuel_zero [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptrval : impl_pointer_value) (offset : Int) (max_offset : Int) (acc : List impl_mem_value) :
    memcmp_load_aux_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs ptrval offset
        max_offset acc =
        (ND (fun st =>
          (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

def memcmp_compare [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (p : (impl_mem_value × impl_mem_value)) :
    impl_memM Int :=
  match p with
  | (mval1, mval2) =>
    (match mval1, mval2 with
     | MVinteger ity1 (IV _ (IVbyteof offset_ival1 mval1')),
       MVinteger ity2 (IV _ (IVbyteof offset_ival2 mval2')) =>
       ifM "memcmp_compare(byte offsets)" (mk_iv_constr MC_eq offset_ival1 offset_ival2)
         ((memcmp_compare _lemReader_enum_definitions _lemReader_tagDefs) (mval1', mval2'))
         (defacto_fail CerbLocation.unknown (MerrWIP "memcmp, two IVbyteof with different offsets"))
     | MVpointer ref_ty1 ptrval1, MVpointer ref_ty2 ptrval2 =>
       nd_bind
         ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs) ptrval1)
         (fun (ival1 : integer_value_base) =>
           nd_bind
             ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs)
               ptrval2)
             (fun (ival2 : integer_value_base) =>
               ifM "memcmp_compare(two pointers equals?)" (mk_iv_constr MC_eq ival1 ival2)
                 (nd_return ((0 : Int)))
                 (ifM "memcmp_compare(two pointers equals?)" (mk_iv_constr MC_lt ival1 ival2)
                   (nd_return ((0 : Int) - (1 : Int))) (nd_return ((1 : Int))))))
     | _, _ =>
       (failwithI "memcmp_compare" : ndM Int String mem_error (mem_constraint impl_integer_value)
         impl_mem_state))

def fold_memcmp_compare [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (mvals1 : List impl_mem_value) (mvals2 : List impl_mem_value) (ord_acc : Int) :
    ndM Int String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  lem_if ord_acc == (0 : Int) then
    match mvals1, mvals2 with
    | [], [] => nd_return ((0 : Int))
    | mval1 :: xs1, mval2 :: xs2 =>
      nd_bind ((memcmp_compare _lemReader_enum_definitions _lemReader_tagDefs) (mval1, mval2))
        (fun (ord : Int) =>
          (fold_memcmp_compare _lemReader_enum_definitions _lemReader_tagDefs) xs1 xs2 ord)
    | _, _ =>
      (failwithI "Impossible: fold_memcmp_compare" : ndM Int String mem_error
        (mem_constraint impl_integer_value) impl_mem_state)
  else
    nd_return ord_acc

def impl_memcmp [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptr_val1 : impl_pointer_value) (ptr_val2 : impl_pointer_value)
    (size_ival : impl_integer_value) :
    ndM impl_integer_value String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match size_ival with
  | IV _ (IVsizeof ty1) =>
    nd_bind
      ((impl_load _lemReader_enum_definitions _lemReader_tagDefs)
        (CerbLocation.other "memcmp, 1st pointer") ty1 ptr_val1)
      (fun (p : (impl_footprint × impl_mem_value)) =>
        match p with
        | (fp1, mval1) =>
          nd_bind
            ((impl_load _lemReader_enum_definitions _lemReader_tagDefs)
              (CerbLocation.other "memcmp, 2nd pointer") ty1 ptr_val2)
            (fun (p : (impl_footprint × impl_mem_value)) =>
              match p with
              | (fp2, mval2) =>
                (failwithI "Mem.impl_memcmp" : ndM impl_integer_value String mem_error
                  (mem_constraint impl_integer_value) impl_mem_state)))
  | IV _ (IVconcrete n) =>
    nd_bind
      ((memcmp_load_aux _lemReader_enum_definitions _lemReader_tagDefs) ptr_val1 ((0 : Int)) n
        ([] : List impl_mem_value))
      (fun (mvals1 : List impl_mem_value) =>
        nd_bind
