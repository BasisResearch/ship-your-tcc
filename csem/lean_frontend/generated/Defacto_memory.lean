def impl_sizeof_ival_aux [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) :
    integer_value_base :=
  match c with
  | cty@(Ctype _ ty1) =>
    (match ty1 with
     | Void0 => (failwithI "Mem.impl_sizeof_ival_aux, Void" : integer_value_base)
     | Basic (Integer ity) =>
       (match (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) ity with
        | some n => IVconcrete (Int.ofNat n)
        | none => IVsizeof cty)
     | Basic (Floating fty) =>
       (match CerberusImpl.sizeof_fty fty with
        | some n => IVconcrete (Int.ofNat n)
        | none => IVsizeof cty)
     | Array0 _ none => (failwithI "Mem.impl_sizeof_ival_aux, Array Nothing" : integer_value_base)
     | Array0 elem_ty (some n) =>
       IVop IntMul
         [(impl_sizeof_ival_aux _lemReader_enum_definitions _lemReader_tagDefs) elem_ty,
           IVconcrete n]
     | Function _ _ _ => (failwithI "Mem.impl_sizeof_ival_aux, Function" : integer_value_base)
     | FunctionNoParams _ =>
       (failwithI "Mem.impl_sizeof_ival_aux, FunctionNoParams" : integer_value_base)
     | Pointer _ _ => IVconcrete ((8 : Int)) /- TODO -/
     | Atomic atom_ty =>
       (impl_sizeof_ival_aux _lemReader_enum_definitions _lemReader_tagDefs) atom_ty
     | Struct tag_sym => /- TODO: move the code from mem_simplify -/
       IVsizeof (Ctype ([] : List annot) (Struct tag_sym))
     | Union0 tag_sym => /- TODO: move the code from mem_simplify -/
       IVsizeof (Ctype ([] : List annot) (Union0 tag_sym))
     | Byte => IVconcrete ((1 : Int)))

