/- WIP -/
def impl_eq_ptrval { a : Type } [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : a)
    (ptr_val1 : impl_pointer_value) (ptr_val2 : impl_pointer_value) :
    ndM Bool String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  nd_bind
    (print_debugM 6 (fun (u : Unit) =>
      match u with
      | () =>
        String.append "Mem.eq_ptrval: "
          (String.append (CerbPP.stringFromPointer_value ptr_val1)
            (String.append " vs " (CerbPP.stringFromPointer_value ptr_val2)))))
    (fun (_ : Unit) =>
      match ptr_val1, ptr_val2 with
      | PV _ (PVnull _) [], PV _ (PVnull _) [] => /- STD §6.5.9#6 -/ nd_return true
      | PV _ (PVnull _) sh1, PV _ (PVnull _) sh2 =>
        (lem_if false /- ISO mode -/ then /- STD §6.5.9#6 -/ /- TODO: check. I guess not UB here, because the UB should have come when shifting the pointer? -/
          nd_return false
        else
          condM "shifted null pointers equality"
            (mk_iv_constr MC_eq
              ((integer_value_baseFromShift_path _lemReader_enum_definitions _lemReader_tagDefs)
                sh1)
              ((integer_value_baseFromShift_path _lemReader_enum_definitions _lemReader_tagDefs)
                sh2)))
      | PV _ (PVfunction sym1) [], PV _ (PVfunction sym2) [] =>
        nd_return
          (match sym1, sym2 with
           | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
             (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
               lem_if natGteb 0 5 && (sd1 != sd2) then
                 (lemSeq
                   (fun _ =>
                     CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                       match u with
                       | () =>
                         String.append "[Symbol.symbolEqual] suspicious equality ==> "
                           (String.append (show_symbol_description sd1)
                             (String.append " <-> " (show_symbol_description sd2)))))
                   (fun _ => true))
               else
                 true
             else
               false))
      | PV _ (PVnull _) _, _ => /- STD §6.5.9#6 -/ nd_return false
      | _, PV _ (PVnull _) _ => /- STD §6.5.9#6 -/ nd_return false
      | PV prov1 ptr_val1_ sh1, PV prov2 ptr_val2_ sh2 =>
        (let do_honest_equality :=
           nd_bind
             ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs)
               ptr_val1)
             (fun (addr_ival_1 : integer_value_base) =>
               nd_bind
                 ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs)
                   ptr_val2)
                 (fun (addr_ival_2 : integer_value_base) =>
                   condM "honest pointer equality" (mk_iv_constr MC_eq addr_ival_1 addr_ival_2)));
         match prov1, prov2 with
         | Prov_some alloc_id1, Prov_some alloc_id2 =>
           ifFlag Allow_disjoint_alloc_tests
             /- defacto flag -/ (lem_if pairEqual alloc_id1 alloc_id2 then
               do_honest_equality
             else
               msum "pointer equality"
                 [("using provenance", nd_return false),
                   ("ignoring provenance", do_honest_equality)])
             /- STD case -/ (lem_if pairEqual alloc_id1 alloc_id2 then
               /- this tests that at least one pointer is to a base object and the two
                       is to either also to that base object or a beginning subobject -/
               lem_if isEmptyShift sh1 then
                 (isBeginningShift _lemReader_enum_definitions _lemReader_tagDefs) sh2
               else lem_if isEmptyShift sh2 then
                 (isBeginningShift _lemReader_enum_definitions _lemReader_tagDefs) sh1
               else /- the pointers are to a same subobject -/
                 nd_return ((listEqualBy (fun x y => x == y) sh1 sh2))
             else
               nd_bind
                 ((is_one_past_pointer _lemReader_enum_definitions _lemReader_tagDefs) ptr_val1)
                 (fun (x : Bool) =>
                   match x with
                   | true =>
                     nd_bind
                       ((address_expression_of_pointer _lemReader_enum_definitions
                         _lemReader_tagDefs) ptr_val1)
                       (fun (addr_ival_1 : integer_value_base) =>
                         nd_bind
                           ((address_expression_of_pointer _lemReader_enum_definitions
                             _lemReader_tagDefs) ptr_val2)
                           (fun (addr_ival_2 : integer_value_base) =>
                             condM "eq_ptrval - left is one past"
                               (mk_iv_constr MC_eq addr_ival_1 addr_ival_2)))
                   | false =>
                     nd_bind
                       ((is_one_past_pointer _lemReader_enum_definitions _lemReader_tagDefs)
                         ptr_val2)
                       (fun (x : Bool) =>
                         match x with
                         | true =>
                           nd_bind
                             ((address_expression_of_pointer _lemReader_enum_definitions
                               _lemReader_tagDefs) ptr_val1)
                             (fun (addr_ival_1 : integer_value_base) =>
                               nd_bind
                                 ((address_expression_of_pointer _lemReader_enum_definitions
                                   _lemReader_tagDefs) ptr_val2)
                                 (fun (addr_ival_2 : integer_value_base) =>
                                   condM "eq_ptrval - right is one past"
                                     (mk_iv_constr MC_eq addr_ival_1 addr_ival_2)))
                         | false => nd_return false)))
         | Prov_some _, _ => do_honest_equality
         | _, Prov_some _ => do_honest_equality
         | _, _ =>
           (failwithI "WIP: Mem.eq_ptrval, not (Just alloc_id1, Just alloc_id2)" : ndM Bool String
             mem_error (mem_constraint impl_integer_value) impl_mem_state)))

def silly_sh_eq [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (sh1 : List shift_path_element) (sh2 : List shift_path_element) :
    Option Bool :=
  match sh1, sh2 with
  | [], [] => some true
  | SPE_array ty1 ival_1 :: sh1', SPE_array ty2 ival_2 :: sh2' =>
    (lem_if ctypeEqual ty1 ty2 then
      match (eval_integer_value_base _lemReader_enum_definitions _lemReader_tagDefs) ival_1,
          (eval_integer_value_base _lemReader_enum_definitions _lemReader_tagDefs) ival_2 with
      | some n1, some n2 =>
        (lem_if n1 == n2 then
          (silly_sh_eq _lemReader_enum_definitions _lemReader_tagDefs) sh1' sh2'
        else
          none)
      | _, _ => none
    else
      none)
  | SPE_member tag_sym1 membr_ident1 :: sh1', SPE_member tag_sym2 membr_ident2 :: sh2' =>
    (lem_if (match tag_sym1, tag_sym2 with
             | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
               (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                 lem_if natGteb 0 5 && (sd1 != sd2) then
                   (lemSeq
                     (fun _ =>
                       CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                         match u with
                         | () =>
                           String.append "[Symbol.symbolEqual] suspicious equality ==> "
                             (String.append (show_symbol_description sd1)
                               (String.append " <-> " (show_symbol_description sd2)))))
                     (fun _ => true))
                 else
                   true
               else
                 false)) && idEqual membr_ident1 membr_ident2 then
      (silly_sh_eq _lemReader_enum_definitions _lemReader_tagDefs) sh1' sh2'
    else
      none)
  | _, _ => some false

