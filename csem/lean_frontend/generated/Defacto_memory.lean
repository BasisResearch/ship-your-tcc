      mk_iv_constr MC_eq (IVop IntRem_f [IVaddress alloc_id pref, align_ival_])
        (IVconcrete ((0 : Int)));
    nd_bind
      (addConstraints "address constraint"
        (/- simplify_constraint $ -/ MC_conj (align_constr :: distinctness_constrs)))
      (fun (_ :
        Unit) => /- TODO: hack simplifying intptr_t/uintptr_t (cast to uintptr_t is the identity for Z3) -/
