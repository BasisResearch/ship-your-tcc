def project_to_lvalue_type { a b c d : Type } [CerbImplCfg.Impl] [Inhabited a]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c1 : ctype)
    (mval : impl_mem_value) :
    ndM impl_mem_value c d b a :=
  match c1, mval with
  | (Ctype _ lvalue_ty), mval =>
    (match lvalue_ty, mval with
     | Basic (Integer (Unsigned Ichar)), MVinteger (Unsigned Ichar) _ => nd_return mval
     | Basic (Integer (uchar_ity@((Unsigned Ichar)))), _ =>
       (let mval_prov :=
          match mval with
          | MVinteger _ (IV prov _) => prov
          | MVpointer _ (PV prov _ _) => prov
          | _ => Prov_none;
        nd_return (MVinteger uchar_ity (IV mval_prov (IVbyteof (IVconcrete ((0 : Int))) mval))))
     | Basic (Integer lvalue_ity), MVinteger mval_ity ival =>
       (lem_if integerTypeEqual lvalue_ity mval_ity then
         nd_return mval /- TODO: check that we really allow arbitrary bytes accesses like this -/
       else
         match (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) lvalue_ity with
         | none => (failwithI "WIP: project_to_lvalue_type" : ndM impl_mem_value c d b a)
         | some size =>
           (let ival_' :=
              IVcomposite
                (List.map (fun (i : Nat) => IVbyteof (IVconcrete (Int.ofNat i)) mval)
                  (enumFromTo 0 (size - 1)));
            nd_return (MVinteger lvalue_ity (IV Prov_none /- TODO -/ ival_'))))
     | Basic (Floating lvalue_fty), MVfloating mval_fty fval =>
       (failwithI "WIP: project_to_lvalue_type floating" : ndM impl_mem_value c d b a)
     | Pointer _ lvalue_ref_ty, MVpointer mval_ref_ty (PV prov _ _) =>
       (lem_if ctypeEqual lvalue_ref_ty mval_ref_ty then
         nd_return mval
       else
         (failwithI
           "project_to_lvalue_type: Pointer vs MVpointer, with different referenced types" : ndM
           impl_mem_value c d b a))
     | _, MVarray mvals => /- TODO: I guess that's not allowed -/
       (failwithI "WIP: project_to_lvalue_type MVarray" : ndM impl_mem_value c d b a)
     | Struct lvalue_tag_sym, MVstruct mval_tag_sym _ =>
       (lem_if (match lvalue_tag_sym, mval_tag_sym with
                | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                  (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                    lem_if natGteb 0 5 && (sd1 != sd2) then
                      (lemSeq
                        (fun _ =>
                          CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                            match u with
                            | () =>
                              String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                (String.append (show_symbol_description sd1)
                                  (String.append " <-> " (show_symbol_description sd2)))))
                        (fun _ => true))
                    else
                      true
                  else
                    false)) then
         nd_return mval
       else
         (failwithI "project_to_lvalue_type: Struct vs MVstruct with non-equal tags" : ndM
           impl_mem_value c d b a))
     | Union0 lvalue_tag_sym, MVunion mval_tag_sym memb_ident _ =>
       (lem_if (match lvalue_tag_sym, mval_tag_sym with
                | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                  (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                    lem_if natGteb 0 5 && (sd1 != sd2) then
                      (lemSeq
                        (fun _ =>
                          CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                            match u with
                            | () =>
                              String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                (String.append (show_symbol_description sd1)
                                  (String.append " <-> " (show_symbol_description sd2)))))
                        (fun _ => true))
                    else
                      true
                  else
                    false)) then
         nd_return mval
       else
         (failwithI "project_to_lvalue_type: Union vs MVunion with non-equal tags" : ndM
           impl_mem_value c d b a))
     | _, MVunion mval_tag memb_ident memb_mval =>
       (/- TODO: this implementing that casting a pointer to a union, to
           a pointer to one of it's member -/
       match (get_unionDef _lemReader_enum_definitions _lemReader_tagDefs) mval_tag with
       | (x, xs) =>
         (match (lookupBy idEqual memb_ident (x :: xs)) with
          | none =>
            (failwithI "project_to_lvalue_type, MVunion was ill-typed (wrong member_ident)" : ndM
              impl_mem_value c d b a)
          | some (_, _, _, Ctype _ memb_ty) =>
            (lem_if lvalue_ty == memb_ty then
              nd_return memb_mval
            else
              (failwithI "TODO: project_to_lvalue_type, union punning" : ndM impl_mem_value c d b
                a))))
     | _, _ =>
       (/- TODO -/ /- return mval -/ (lemSeq
         (fun _ =>
           CerbDebug.print_debug_pure 1 ([] : List domain) (fun (u : Unit) =>
             match u with
             | () =>
               String.append "lvalue_ty  ===> "
                 (String.append (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) lvalue_ty))
                   (String.append "\nmval ===> " (CerbPP.stringFromMem_value mval)))))
         (fun _ => (failwithI "TODO: project_to_lvalue_type" : ndM impl_mem_value c d b a)))))

def apply_shift_path [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (lvalue_ty : ctype)
    (sh : List shift_path_element) (mval : impl_mem_value) :
    ndM impl_mem_value String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match sh with
  | [] =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 1 ([] : List domain) (fun (u : Unit) =>
          match u with
          | () =>
            String.append "Mem.apply_shift_path, sh == []  ===> "
              (CerbPP.stringFromMem_value mval)))
      (fun _ =>
        (project_to_lvalue_type _lemReader_enum_definitions _lemReader_tagDefs) lvalue_ty mval)))
  | _ =>
    nd_foldlM
      (fun (acc : impl_mem_value) (spe : shift_path_element) =>
        (apply_shift_path_element _lemReader_enum_definitions _lemReader_tagDefs) lvalue_ty spe acc)
      mval
      sh
      /- >>=
        project_to_lvalue_type lvalue -/

