def easy_update_mem_value_aux_lemFuel [LemFuel] [CerbImplCfg.Impl] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (is_strong : Bool) (write_ty : ctype) (sh : List shift_path_element)
    (write_mval : impl_mem_value) (current_mval : impl_mem_value) :
    ndM impl_mem_value String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match lemFuel with
  | 0 =>
    (ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 [DB_memory] (fun (u : Unit) =>
          match u with
          | () =>
            String.append "ENTERING: easy_update_mem_value_aux\n"
              (String.append "current_mval ==> "
                (String.append (CerbPP.stringFromMem_value current_mval)
                  (String.append "\n"
                    (String.append "sh ==> " (CerbPP.stringFromShift_path sh)))))))
      (fun _ =>
        let easy_update_mem_value_aux1 :=(easy_update_mem_value_aux_lemFuel lemFuel
            _lemReader_enum_definitions _lemReader_tagDefs) loc1 is_strong;
        match current_mval, sh with
        | _,
          [] => /- SIMPLIFICATION: we assume that the footprint of the new value covers all of the old value -/
          nd_return write_mval
        | MVarray mvals, SPE_array elem_ty ival_ :: sh' =>
          (match Option.map (fun (n : Int)=> Int.natAbs (lemIntFromInteger n))
               ((eval_integer_value_base _lemReader_enum_definitions _lemReader_tagDefs) ival_) with
           | some n =>
             (lem_if natLteb 0 n && natLtb n (List.length mvals) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.print_debug_pure 2 [DB_memory] (fun (u : Unit) =>
                     match u with
                     | () => "EXITING: easy_update_mem_value_aux, MVarray"))
                 (fun _ =>
                   match listGetOpt mvals n with
                   | some at_n_mval =>
                     nd_bind (easy_update_mem_value_aux1 write_ty sh' write_mval at_n_mval)
                       (fun (at_n_mval' : impl_mem_value) =>
                         nd_return (MVarray (lemListUpdate mvals n at_n_mval')))
                   | none => /- NOTE: this is impossible -/
                     defacto_fail loc1
                       (MerrInternal "easy_update_mem_value_aux, out of array index")))
             else /- TODO: if this can actually happen, then the error needs to be in the monad? -/
               (failwithI "easy_update_mem_value_aux ==> concrete SPE_array was out of bound" : ndM
                 impl_mem_value String mem_error (mem_constraint impl_integer_value)
                 impl_mem_state))
           | none =>
             nd_bind (find_array_index (List.length mvals) 0 ival_) (fun (n : Nat) =>
               match listGetOpt mvals n with
               | some at_n_mval =>
                 nd_bind (easy_update_mem_value_aux1 write_ty sh' write_mval at_n_mval)
                   (fun (at_n_mval' : impl_mem_value) =>
                     nd_return (MVarray (lemListUpdate mvals n at_n_mval')))
               | none => /- NOTE: this is impossible -/
                 defacto_fail loc1
                   (MerrInternal "easy_update_mem_value_aux, out of array index (symb)")))
        | MVstruct tag_sym xs, SPE_member tag_sym_ memb_ident :: sh' =>
          (lem_if not
              (match tag_sym, tag_sym_ with
               | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                 (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                   lem_if natGteb 0 5 && (sd1 != sd2) then
                     (lemSeq
                       (fun _ =>
                         CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                           match u with
                           | () =>
                             String.append "[Symbol.symbolEqual] suspicious equality ==> "
                               (String.append (show_symbol_description sd1)
                                 (String.append " <-> " (show_symbol_description sd2)))))
                       (fun _ => true))
                   else
                     true
                 else
                   false)) then
            (failwithI
              "WIP[easy_update_mem_value_aux]: TODO error message ===> struct value accessed with incompatible SPE" :
              ndM impl_mem_value String mem_error (mem_constraint impl_integer_value)
              impl_mem_state)
          else
            (lemSeq
              (fun _ =>
                CerbDebug.print_debug_pure 2 [DB_memory] (fun (u : Unit) =>
                  match u with
                  | () => "EXITING: easy_update_mem_value_aux, MVstruct"))
              (fun _ =>
                nd_bind
                  (nd_mapM
                    (fun (p : (identifier × ctype × impl_mem_value)) =>
                      match p with
                      | (ident, memb_ty, memb_mval) =>
                        nd_bind (easy_update_mem_value_aux1 write_ty sh' write_mval memb_mval)
                          (fun (memb_mval : impl_mem_value) =>
                            nd_return (ident, memb_ty, memb_mval))) xs)
                  (fun (x : List (identifier × ctype × impl_mem_value))=>
                    nd_return (MVstruct tag_sym x)))))
        | MVunion tag_sym old_memb_ident old_memb_mval, SPE_member tag_sym_ new_memb_ident :: sh' =>
          (lem_if not
              (match tag_sym, tag_sym_ with
               | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                 (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                   lem_if natGteb 0 5 && (sd1 != sd2) then
                     (lemSeq
                       (fun _ =>
                         CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                           match u with
                           | () =>
                             String.append "[Symbol.symbolEqual] suspicious equality ==> "
                               (String.append (show_symbol_description sd1)
                                 (String.append " <-> " (show_symbol_description sd2)))))
                       (fun _ => true))
                   else
                     true
                 else
                   false)) then
            (failwithI
              "WIP[easy_update_mem_value_aux]: TODO error message ===> union value stored with incompatible SPE_member tag" :
              ndM impl_mem_value String mem_error (mem_constraint impl_integer_value)
              impl_mem_state)
          else
            match (get_unionDef _lemReader_enum_definitions _lemReader_tagDefs) tag_sym with
            | (x, xs) =>
              (match (lookupBy idEqual new_memb_ident (x :: xs)) with
               | none =>
                 (failwithI
                   "WIP[easy_update_mem_value_aux]: TODO error message ===> union value stored with incompatible SPE_member memb_ident" :
                   ndM impl_mem_value String mem_error (mem_constraint impl_integer_value)
                   impl_mem_state)
               | some _ =>
                 nd_bind (easy_update_mem_value_aux1 write_ty sh' write_mval old_memb_mval)
                   (fun (new_memb_mval : impl_mem_value) =>
                     nd_return (MVunion tag_sym new_memb_ident new_memb_mval))))
        | _, _ =>
          (lem_if is_strong then
            match sh with
            | SPE_member tag_sym memb_ident :: sh' =>
              nd_bind
                (nd_mapM
                  (fun (p : (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
                    match p with
                    | (ident, (_, _, _, ty1)) =>
                      (lem_if idEqual ident memb_ident then
                        nd_bind
                          (easy_update_mem_value_aux1 write_ty sh' write_mval
                            ((mkUnspec _lemReader_enum_definitions _lemReader_tagDefs) ty1))
                          (fun (mval' : impl_mem_value) => nd_return (ident, ty1, mval'))
                      else
                        nd_return
                          (ident, ty1,
                            (mkUnspec _lemReader_enum_definitions _lemReader_tagDefs) ty1)))
                  (Prod.fst
                    ((get_structDef _lemReader_enum_definitions _lemReader_tagDefs) tag_sym)))
                (fun (x : List (identifier × ctype × impl_mem_value))=>
                  nd_return
                    (/- TODO(check) ignoring potential flexible array member, because we are dealing with a struct as value -/ MVstruct
                      tag_sym x))
            | _ =>
              (failwithI "WIP: easy_update_mem_value_aux, _, is_strong" : ndM impl_mem_value String
                mem_error (mem_constraint impl_integer_value) impl_mem_state)
          else /- TODO: this might need to be before the test on "is_strong" -/
            match sh with
            | [SPE_array (Ctype _ (Basic (Integer (Unsigned Ichar)))) byte_ival_] =>
              nd_return (MVdelayed [(sh, write_mval)] current_mval)
            /-
                match write_mval with
                  | MVinteger _ write_ival ->
                      MVcomposite [(mk_op_ival_ IntMul byte_ival_ (IVsizeof spe_ty), write_ival)] current_mval
                  | _ ->
                      error ("TODO: easy_update_mem_value_aux: object repr access; current_mval = " ^ stringFromMem_value current_mval)
                end
-/
            | _ =>
              (/- -/ (lemSeq
                (fun _ =>
                  CerbDebug.print_debug_pure 1 ([] : List domain) (fun (u : Unit) =>
                    match u with
                    | () =>
                      String.append "loc          = "
                        (String.append (CerbLocation.stringFromLocation loc1)
                          (String.append "\n"
                            (String.append "sh           = "
                              (String.append (CerbPP.stringFromShift_path sh)
                                (String.append "\n"
                                  (String.append "current_mval = "
                                    (CerbPP.stringFromMem_value current_mval)))))))))
                (fun _ =>
                  (failwithI "WIP: easy_update_mem_value_aux" : ndM impl_mem_value String mem_error
                    (mem_constraint impl_integer_value) impl_mem_state))))))))

def easy_update_mem_value_aux [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (is_strong : Bool) (write_ty : ctype) (sh : List shift_path_element)
    (write_mval : impl_mem_value) (current_mval : impl_mem_value) :
