def get_allocation_size { a b c : Type } [LemFuel] (alloc_id : Nat) :
    ndM integer_value_base b c a impl_mem_state :=
  nd_bind nd_get (fun (st : impl_mem_state) =>
    match (fmapLookupBy defaultCompare alloc_id st.allocations) with
    | some (Storage_static _ ty1 _) => nd_return (IVsizeof ty1)
    | some (Storage_dynamic _ ival_ _) => nd_return ival_
    | none =>
      (failwithI "Mem.get_allocation_size: TODO make it an error in the monad" : ndM
        integer_value_base b c a impl_mem_state))
/- Decide whether a given pointer value can be use to perform a store -/

def can_store [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (i : impl_pointer_value) :
    ndM (Sum access_error Nat) String mem_error (mem_constraint impl_integer_value)
        impl_mem_state :=
  match loc1, i with
  | loc1, ptr_val@(PV prov ptr_val_ sh) =>
    (match ptr_val_ with /- null and function pointers obviously can't be used for stores. -/
     | PVnull _ => nd_return (Sum.inl NullPtr)
     | PVfunction _ =>
       nd_return (Sum.inl FunctionPtr) /- by WF-invariants, we have a pointer to an object -/
     | _ =>
       nd_bind (explicitAllocationIdFromPointer_value_aux ptr_val_)
         (fun (x : Option (Nat × prefix0)) =>
           match x with
           | some (alloc_id, pref) =>
             nd_bind (is_dead alloc_id)
               (fun (x : Bool) =>
                 match x with
                 | true =>
                   ((lemSeq
                     (fun _ =>
                       CerbDebug.print_debug_pure 5 [DB_memory] (fun (u : Unit) =>
                         match u with
                         | () =>
                           String.append "CAN'T STORE : is_dead ==> "
                             (CerbPP.stringFromPointer_value ptr_val)))
                     (fun _ => /- can't store with a pointer to an object whose lifetime ended. -/
                       nd_return (Sum.inl DeadPtr))))
                 | false =>
                   nd_bind
                     (/- add the constraint that the ptr is inside the object -/ get_allocation_size
                       alloc_id)
                     (fun (size_ival_ : integer_value_base) =>
                       (lemSeq
                         (fun _ =>
                           CerbDebug.print_debug_pure 1 ([] : List domain) (fun (u : Unit) =>
                             match u with
                             | () =>
                               String.append "CAN STORE size_ival_ ===> "
                                 (CerbPP.stringFromInteger_value (IV Prov_none size_ival_))))
                         (fun _ =>
                           let ptr_ival_ :=(real_address_expression_of_pointer
                               _lemReader_enum_definitions _lemReader_tagDefs) ptr_val;
                           ifM
                             (String.append "can_store["
                               (String.append (CerbLocation.stringFromLocation loc1) "]"))
                             (MC_conj
                               [mk_iv_constr MC_le (IVaddress alloc_id pref) ptr_ival_,
                                 mk_iv_constr MC_lt ptr_ival_
                                   (IVop IntAdd [IVaddress alloc_id pref, size_ival_])])
                             (nd_return (Sum.inr alloc_id))
                             (nd_return
                               (Sum.inl
                                 OutOfBoundPtr)))))) /- we couldn't find an explicit allocation event -/
           | none =>
             (failwithI
               "WIP: can_store ==> don't know how to deal with the absence of explicit allocation id for now." :
               ndM (Sum access_error Nat) String mem_error (mem_constraint impl_integer_value)
               impl_mem_state)))

def find_array_index_lemFuel (lemFuel : Nat) (size : Nat) (i : Nat) (ival_ : integer_value_base) :
    ndM Nat String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match lemFuel with
  | 0 =>
    (ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    (lem_if natGteb i size then
      (defacto_fail CerbLocation.unknown (MerrOther "find_array_index failed"))
    else
      ifM "find_array_index" (mk_iv_constr MC_eq ival_ (IVconcrete (Int.ofNat i))) (nd_return i)
        ((find_array_index_lemFuel lemFuel) size (i + 1) ival_))

def find_array_index (size : Nat) (i : Nat) (ival_ : integer_value_base) :
    ndM Nat String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  find_array_index_lemFuel (size - i + 1) size i ival_
theorem find_array_index_lemFuel_zero (size : Nat) (i : Nat) (ival_ : integer_value_base) :
    find_array_index_lemFuel 0 size i ival_ =
        (ND (fun st =>
          (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

