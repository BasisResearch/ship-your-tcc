def apply_shift_path_element [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (lvalue_ty : ctype)
    (spe : shift_path_element) (mval : impl_mem_value) :
    ndM impl_mem_value String mem_error (mem_constraint impl_integer_value)
        impl_mem_state := /- TODO: use lvalue_ty -/
  match spe, mval with
  | SPE_array elem_ty ival_, MVarray mvals =>
    (match (eval_integer_value_base _lemReader_enum_definitions _lemReader_tagDefs) ival_ with
     | some n =>
       (let n := Int.natAbs (lemIntFromInteger n);
        lem_if natLtb n 0 || natLteb (List.length mvals) n then
          (failwithI "Mem.apply_shift_path_element: out of bound array" : ndM impl_mem_value String
            mem_error (mem_constraint impl_integer_value) impl_mem_state)
        else
          nd_return
            ((fromJustI "Defacto_memory.apply_shift_path_element, SPE_array vs MVarray"
              (listGetOpt mvals n) : impl_mem_value)))
     | none =>
       (failwithI
         (String.append "Mem.apply_shift_path_element: symbolic array index ==> "
           (CerbPP.stringFromInteger_value (IV Prov_none ival_))) : ndM impl_mem_value String
         mem_error (mem_constraint impl_integer_value) impl_mem_state))
  | SPE_array elem_ty ival_, MVpointer _ _ =>
    (/-
       if lvalue_ty <> Basic (Integer (Unsigned Ichar)) then
         error ("WIP ==> result_ty <> not unsigned char, SPE_array, MVpointer ===> result_ty = " ^ stringFromCtype result_ty)
       else
-/
    match lvalue_ty with
    | Ctype _ (Basic (Integer lvalue_ity)) =>
      nd_return
        (MVinteger lvalue_ity
          (IV Prov_none
            (IVbyteof
              ((mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntMul ival_
                (IVsizeof elem_ty)) mval)))
    | _ =>
      (failwithI
        (String.append
          "WIP ==> lvalue_ty <> not an integer value, SPE_array, MVpointer ===> lvalue_ty = "
          (CerbPP.stringFromCtype lvalue_ty)) : ndM impl_mem_value String mem_error
        (mem_constraint impl_integer_value) impl_mem_state))
  | SPE_member tag_sym memb_ident, MVstruct tag_sym_ xs =>
    (lem_if not
        (match tag_sym, tag_sym_ with
         | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
           (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
             lem_if natGteb 0 5 && (sd1 != sd2) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                     match u with
                     | () =>
                       String.append "[Symbol.symbolEqual] suspicious equality ==> "
                         (String.append (show_symbol_description sd1)
                           (String.append " <-> " (show_symbol_description sd2))))) (fun _ => true))
             else
               true
           else
             false)) then
      defacto_fail CerbLocation.unknown
        (MerrOther
          (String.append "tried to read member of type '"
            (String.append (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (Struct tag_sym)))
              (String.append "', but a value of type '"
                (String.append
                  (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (Struct tag_sym_)))
                  "' was found.")))))
    else
      nd_return
        ((fromJustI "Defacto_memory.apply_shift_path_element, SPE_member vs MVstruct"
          ((lookupBy idEqual memb_ident
            (List.map
              (fun (p : (identifier × ctype × impl_mem_value)) =>
                match p with
                | (a, _, b) => (a, b)) xs))) : impl_mem_value)))
  | SPE_member tag_sym memb_ident, MVunion tag_sym_ memb_ident_ mval' =>
    (lem_if not
        (match tag_sym, tag_sym_ with
         | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
           (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
             lem_if natGteb 0 5 && (sd1 != sd2) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                     match u with
                     | () =>
                       String.append "[Symbol.symbolEqual] suspicious equality ==> "
                         (String.append (show_symbol_description sd1)
                           (String.append " <-> " (show_symbol_description sd2))))) (fun _ => true))
             else
               true
           else
             false)) then
      defacto_fail CerbLocation.unknown
        (MerrOther
          (String.append "tried to read member of type '"
            (String.append (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (Union0 tag_sym)))
              (String.append "', but a value of type '"
                (String.append
                  (CerbPP.stringFromCore_ctype (Ctype ([] : List annot) (Union0 tag_sym_)))
                  "' was found.")))))
    else
      /-
         let UnionDef xs = Ctype_aux.get_membersDefs tag_sym in
-/
      lem_if idEqual memb_ident memb_ident_ then
        nd_return mval'
      else
        (failwithI "TODO: union punning" : ndM impl_mem_value String mem_error
          (mem_constraint impl_integer_value) impl_mem_state))
  | SPE_array elem_ty ival_1, MVinteger ity ival_2 =>
    (failwithI
      (String.append "lvalue_ty: "
        (String.append (CerbPP.stringFromCtype lvalue_ty)
          (String.append ", spe: "
            (String.append (CerbPP.stringFromShift_path [spe])
              (String.append ", ity: "
                (CerbPP.stringFromCtype (Ctype ([] : List annot) (Basic (Integer ity))))))))) : ndM
      impl_mem_value String mem_error (mem_constraint impl_integer_value) impl_mem_state)
  | SPE_array elem_ty offset_ival_, MVdelayed xs under_mval =>
    (match xs with
     | [(sh, new_mval)] =>
       ifM "apply_shift_path_element"
         (mk_iv_constr MC_eq
           ((integer_value_baseFromShift_path _lemReader_enum_definitions _lemReader_tagDefs)
             [SPE_array elem_ty offset_ival_])
           ((integer_value_baseFromShift_path _lemReader_enum_definitions _lemReader_tagDefs) sh))
         (nd_return new_mval)
         /- TODO: hack -/ (wip
           (String.append "Mem.apply_shift_path_element, todo MVdelayed ==> didn't match ==> sh: "
             (String.append (CerbPP.stringFromShift_path [spe])
               (String.append " -- mval: "
                 (CerbPP.stringFromMem_value
                   mval))))) /- (return (MVinteger (Unsigned Ichar) (IV Prov_none (IVconcrete 142)))) -/
     | _ =>
       (failwithI "Mem.apply_shift_path_element, HELLO KKK" : ndM impl_mem_value String mem_error
         (mem_constraint impl_integer_value) impl_mem_state))
  | SPE_array _ _, _ =>
    (failwithI
      (String.append "Mem.apply_shift_path_element, SPE_array ==> mval: "
        (String.append (CerbPP.stringFromMem_value mval)
          (String.append ", lvalue_ty: " (CerbPP.stringFromCtype lvalue_ty)))) : ndM impl_mem_value
      String mem_error (mem_constraint impl_integer_value) impl_mem_state)
  | SPE_member _ _, _ =>
    (failwithI
      (String.append "Mem.apply_shift_path_element, SPE_member ==> "
        (CerbPP.stringFromMem_value mval)) : ndM impl_mem_value String mem_error
      (mem_constraint impl_integer_value) impl_mem_state)

