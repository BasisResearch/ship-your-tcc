def insert_element_to_path [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (sh : List shift_path_element) (spe2 : shift_path_element) :
    List shift_path_element :=
  match Lem_List.dest_init sh with
  | some (sh', spe1) =>
    (match spe1, spe2 with
     | SPE_array ty1 ival1, SPE_array ty2 ival2 =>
       (lem_if ctypeEqual ty1 ty2 then
         sh' ++
           [SPE_array ty1
             ((mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntAdd ival1 ival2)]
       else
         Lem_List.snoc spe2 sh)
     | _, _ => Lem_List.snoc spe2 sh)
  | none => [spe2]

def internal_shift_ptrval [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptr_val : impl_pointer_value) (spe : shift_path_element) :
    impl_pointer_value :=
  match ptr_val with
  /-
    | PV Prov_none _ ->
        Left (MerrOther "attempted to shift a pointer value with no provenance")
-/
  | PV prov ptr_val_ sh =>
    (match get_allocation_id ptr_val_ with
     | some alloc_id => /- TODO: there should a be check for when we go out of an object -/
       PV prov ptr_val_
         ((insert_element_to_path _lemReader_enum_definitions _lemReader_tagDefs) sh spe)
     | none => /- TODO: here we are probably shifting a NULL pointer, so in ISO this is "unclear" -/ /- TODO: add a warning or error in ISO mode -/
       PV prov ptr_val_
         ((insert_element_to_path _lemReader_enum_definitions _lemReader_tagDefs) sh spe)
         /-
              error ("TODO internal_shift_ptrval: shift 2 ==>" ^
                     stringFromPointer_value ptr_val)
-/
         )

def impl_array_shift_ptrval [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptr_val : impl_pointer_value) (ty1 : ctype) (i : impl_integer_value) :
    impl_pointer_value :=
  match ptr_val, ty1, i with
  | ptr_val, ty1, (IV _ ival_) =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 5 [DB_memory] (fun (u : Unit) =>
          match u with
          | () =>
            String.append "Mem.array_shift_ptrval: " (CerbPP.stringFromPointer_value ptr_val)))
      (fun _ =>
        (internal_shift_ptrval _lemReader_enum_definitions _lemReader_tagDefs) ptr_val
          (SPE_array ty1 ival_))))

def impl_member_shift_ptrval [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (ptr_val : impl_pointer_value) (tag_sym : sym) (memb_ident : identifier) :
