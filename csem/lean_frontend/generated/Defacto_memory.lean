def easy_update_mem_value [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (is_strong : Bool)
    (w : write_event) (current_mval : impl_mem_value) :
    ndM impl_mem_value String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match is_strong, w, current_mval with
  | is_strong, (WriteEvent loc1 write_ty (ptr_val@(PV prov ptr_val_ sh)) write_mval),
    current_mval =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 2 [DB_memory] (fun (u : Unit) =>
          match u with
          | () =>
            String.append "easy_update_mem_value: ptrval="
              (String.append (CerbPP.stringFromPointer_value ptr_val)
                (String.append ", mval= " (CerbPP.stringFromMem_value write_mval)))))
      (fun _ =>
        nd_bind
          ((easy_update_mem_value_aux _lemReader_enum_definitions _lemReader_tagDefs) loc1 is_strong
            write_ty sh write_mval current_mval)
          (fun (ret : impl_mem_value) => /- DEBUG -/
            (lemSeq
              (fun _ =>
                CerbDebug.print_debug_pure 2 [DB_memory] (fun (u : Unit) =>
                  match u with
                  | () =>
                    String.append "DONE WITH easy_update_mem_value: ptrval="
                      (String.append (CerbPP.stringFromPointer_value ptr_val)
                        (String.append ", mval= " (CerbPP.stringFromMem_value write_mval)))))
              (fun _ => nd_return ret))))))
/- update the memory state with a write event for a given allocation id -/

def register_write_event [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (alloc_id : Nat)
    (w0 : write_event) :
    ndM Unit String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match alloc_id, w0 with
  | alloc_id, w@(WriteEvent loc1 _ _ mval) =>
    nd_bind
      (nd_bind
        (print_debugM 5 (fun (u : Unit) =>
          match u with
          | () => String.append "REGISTER_WRITE_EVENT: " (CerbPP.stringFromMem_value mval)))
        (fun (_ : Unit) => nd_get))
      (fun (st : impl_mem_state) =>
        nd_bind
          (match (fmapLookupBy defaultCompare alloc_id st.allocations) with
           | some (Storage_static pref obj_ty current) =>
             (let is_strong := false;
              let current_mval :=
                match current with
                | some current_mval => current_mval
                | none => (mkUnspec _lemReader_enum_definitions _lemReader_tagDefs) obj_ty;
              nd_bind
                ((easy_update_mem_value _lemReader_enum_definitions _lemReader_tagDefs) is_strong w
                  current_mval)
                (fun (new_mval : impl_mem_value) =>
                  nd_put
                    { st with
                      allocations :=
                        (fmapAddBy defaultCompare alloc_id
                          (Storage_static pref obj_ty (some new_mval)) st.allocations) }))
           | some
             (Storage_dynamic pref size_ival_
               ws) => /- TODO: check that the write offset is within range? -/
             nd_put
               { st with
                 allocations :=
                   (fmapAddBy defaultCompare alloc_id (Storage_dynamic pref size_ival_ (w :: ws))
                     st.allocations) }
           | none =>
             (failwithI "Mem.register_write_event, Nothing" : ndM Unit String mem_error
               (mem_constraint impl_integer_value) impl_mem_state))
          (fun (_ : Unit) =>
            print_debugM 5 (fun (u : Unit) =>
              match u with
              | () => "EXITING register_write_event")))
def perform_access { a : Type } [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (accessKind : access_kind)
    (loc1 : CerbLocation.Loc) (lvalue_ty : ctype) (ptrval : impl_pointer_value)
    (do_normal : Nat → ndM a String mem_error (mem_constraint impl_integer_value) impl_mem_state)
    (do_device : ndM a String mem_error (mem_constraint impl_integer_value) impl_mem_state) :
    ndM a String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match ptrval with
  /- null and function pointers obviously can't be used for accesses. -/
  | PV _ (PVnull _) _ => defacto_fail loc1 (MerrAccess accessKind NullPtr)
  | PV _ (PVfunction _) _ => defacto_fail loc1 (MerrAccess accessKind FunctionPtr)
  | PV Prov_none _ _ => defacto_fail loc1 (MerrAccess accessKind NoProvPtr)
  /- by WF-invariants, we have a pointer to an object -/
  | ptrval@(PV (Prov_some (alloc_id, pref)) _ _) =>
    nd_bind (is_dead alloc_id) (fun (x : Bool) =>
      match x with
      | true =>
        ((lemSeq
          (fun _ =>
            CerbDebug.print_debug_pure 5 [DB_memory] (fun (u : Unit) =>
              match u with
              | () =>
                String.append "CAN'T ACCESS : is_dead ==> "
                  (CerbPP.stringFromPointer_value ptrval)))
          (fun _ => /- can't store with a pointer to an object whose lifetime ended. -/
            defacto_fail loc1 (MerrAccess accessKind DeadPtr))))
      | false =>
        nd_bind
          (/- add the constraint that the ptr is inside the object -/ get_allocation_size alloc_id)
          (fun (size_ival_ : integer_value_base) =>
            nd_bind
              ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs)
                ptrval)
              (fun (ptr_ival_ : integer_value_base) =>
                /- NOTE: the MC_lt in the second constraint, i.e. we can't
                 have a "one past" pointer -/
                ifM
                  (String.append "perform_access["
                    (String.append (CerbLocation.stringFromLocation loc1) "] provenance check"))
                  (MC_conj
                    [mk_iv_constr MC_le (IVaddress alloc_id pref) ptr_ival_,
                      mk_iv_constr MC_le (IVop IntAdd [ptr_ival_, IVsizeof lvalue_ty])
                        (IVop IntAdd [IVaddress alloc_id pref, size_ival_])]) (do_normal alloc_id)
                  (defacto_fail loc1 (MerrAccess accessKind OutOfBoundPtr)))))
  /- device memory -/
  | (PV Prov_device _ _) => do_device
  | (PV Prov_wildcard _ _) =>
    (failwithI "TODO perform_access: Prov_wildcard" : ndM a String mem_error
      (mem_constraint impl_integer_value) impl_mem_state)

def stringFromWrite_event (w : write_event) : String :=
  match w with
  | (WriteEvent loc1 ty1 ptrval mval) =>
    String.append "WriteEvent["
      (String.append (CerbLocation.stringFromLocation loc1)
        (String.append "] ("
          (String.append (CerbPP.stringFromCore_ctype ty1)
            (String.append ") ==> ptrval= "
              (String.append (CerbPP.stringFromPointer_value ptrval)
                (String.append "; mval= " (CerbPP.stringFromMem_value mval)))))))
def ival_footprintFromWrite_event [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (w : write_event) :
    ndM (integer_value_base × integer_value_base) String mem_error
        (mem_constraint impl_integer_value) impl_mem_state :=
  match w with
  | (WriteEvent loc1 ty1 ptrval mval) =>
    nd_bind ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs) ptrval)
      (fun (ptr_ival_ : integer_value_base) =>
        nd_return
          (ptr_ival_,
            (mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntAdd ptr_ival_
              ((mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntSub (IVsizeof ty1)
                (IVconcrete ((1 : Int))))))
def isOccludedBy [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (wevent1 : write_event)
    (wevent2 : write_event) :
    ndM Bool String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  nd_bind ((ival_footprintFromWrite_event _lemReader_enum_definitions _lemReader_tagDefs) wevent1)
    (fun (p : (integer_value_base × integer_value_base)) =>
      match p with
      | (min_ival_1, max_ival_1) =>
        nd_bind
          ((ival_footprintFromWrite_event _lemReader_enum_definitions _lemReader_tagDefs) wevent2)
          (fun (p : (integer_value_base × integer_value_base)) =>
            match p with
            | (min_ival_2, max_ival_2) =>
              condM "isOccludedBy"
                (MC_conj
                  [mk_iv_constr MC_le min_ival_2 min_ival_1,
                    mk_iv_constr MC_le max_ival_1 max_ival_2])))

def anyM { a b c d e : Type } [LemFuel] (pred1 : e → ndM Bool c d b a) :
    List e → ndM Bool c d b a :=
  fun (x : List e) =>
    match x with
    | [] => nd_return false
    | x :: xs =>
      nd_bind (pred1 x) (fun (x : Bool) =>
        match x with
        | true => nd_return true
        | false => anyM pred1 xs)

def discardOccluded_write_events [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (view_ptrval : impl_pointer_value) (view_ty : ctype) (wevents : List write_event) :
    ndM (List write_event) String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  nd_bind
    ((address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs) view_ptrval)
    (fun (view_ptr_ival_ : integer_value_base) =>
      let min_view_ival_ := view_ptr_ival_;
      let max_view_ival_ :=(mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntAdd
          view_ptr_ival_
          ((mk_op_ival_ _lemReader_enum_definitions _lemReader_tagDefs) IntSub (IVsizeof view_ty)
            (IVconcrete ((1 : Int))));
      nd_foldlM
        (fun (acc : List write_event) (wevent : write_event) =>
          nd_bind
            ((ival_footprintFromWrite_event _lemReader_enum_definitions _lemReader_tagDefs) wevent)
            (fun (p : (integer_value_base × integer_value_base)) =>
              match p with
              | (min_wevent_ival_, max_wevent_ival_) =>
                ifM "discardOccluded_write_events"
                  /- if the view is outside the footprint of the write event -/ (MC_or
                    (mk_iv_constr MC_lt max_view_ival_ min_wevent_ival_)
                    (mk_iv_constr MC_lt max_wevent_ival_ min_view_ival_)) (nd_return acc)
                  (nd_bind
                    (anyM ((isOccludedBy _lemReader_enum_definitions _lemReader_tagDefs) wevent)
                      acc)
                    (fun (x : Bool) =>
                      match x with
                      | true => nd_return acc
                      | false => nd_return (wevent :: acc))))) ([] : List write_event) wevents)

