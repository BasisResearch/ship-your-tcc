       (let ival_1'' :=(lifted_simplify_integer_value_base _lemReader_enum_definitions
            _lemReader_tagDefs) ival_1';
        let ival_2'' :=(lifted_simplify_integer_value_base _lemReader_enum_definitions
            _lemReader_tagDefs) ival_2';
        match ival_1'', ival_2'' with
        | IVconcrete n1, IVconcrete n2 => some (intLtb n1 n2)
        | _, _ => /- TODO -/ none))

/- TODO: temporary hack for concurrency (need to use a sat solver) -/
def has_concurRead_lemFuel (lemFuel : Nat) (ival_ : integer_value_base) : Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match ival_ with
     | IVunspecified => false
     | IVconcurRead _ _ => true
     | IVconcrete _ => false
     | IVaddress _ _ => false
     | IVfromptr _ _ _ _ => false
     | IVop _ ival_s => List.any ival_s (has_concurRead_lemFuel lemFuel)
     | IVmin _ => false
     | IVmax _ => false
     | IVsizeof _ => false
     | IValignof _ => false
     | IVoffsetof _ _ => false
     | IVpadding _ _ => false
     | IVptrdiff _ _ _ => false
     | IVbyteof _ _ => false
     | IVcomposite ival_s => List.any ival_s (has_concurRead_lemFuel lemFuel)
     | IVbitwise _ (BW_complement ival_) => (has_concurRead_lemFuel lemFuel) ival_
     | IVbitwise _ (BW_AND ival_1 ival_2) =>
       (has_concurRead_lemFuel lemFuel) ival_1 || (has_concurRead_lemFuel lemFuel) ival_2
     | IVbitwise _ (BW_OR ival_1 ival_2) =>
       (has_concurRead_lemFuel lemFuel) ival_1 || (has_concurRead_lemFuel lemFuel) ival_2
     | IVbitwise _ (BW_XOR ival_1 ival_2) =>
       (has_concurRead_lemFuel lemFuel) ival_1 || (has_concurRead_lemFuel lemFuel) ival_2)

def has_concurRead (ival_ : integer_value_base) : Bool :=
  has_concurRead_lemFuel (integer_value_base.lemSize ival_) ival_
theorem has_concurRead_lemFuel_zero (ival_ : integer_value_base) :
    has_concurRead_lemFuel 0 ival_ = (fuelExhausted false) :=
  rfl

