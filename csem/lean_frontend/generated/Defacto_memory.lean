def isEmptyShift : List shift_path_element → Bool :=
  fun (x : List shift_path_element) =>
    match x with
    | [] => true
    | _ => false

def isBeginningShift (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (sh : List shift_path_element) :
    ndM Bool String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match sh with
  | [] => nd_return true
  | (SPE_array _ ival_) :: sh' =>
    ifM "isBeginningShift" (mk_iv_constr MC_eq ival_ (IVconcrete ((0 : Int))))
      ((isBeginningShift _lemReader_enum_definitions _lemReader_tagDefs) sh') (nd_return false)
  | (SPE_member tag_sym memb_ident) :: sh' =>
    (let xs :=
       match (get_membersDefs _lemReader_enum_definitions _lemReader_tagDefs) tag_sym with
       | StructDef z none => z
       | StructDef _ (some _) =>
         (failwithI
           "TODO: Defacto_memory.isBeginningShift ==> for struct with flexible array member" : List
           (identifier × (attributes × Option alignment × qualifiers × ctype)))
       | UnionDef z => z;
     match xs with
     | [] =>
       (failwithI "Mem.isBeginningShift, get_membersDefs returning an empty list" : ndM Bool String
         mem_error (mem_constraint impl_integer_value) impl_mem_state)
     | (memb_ident', _) :: _ => nd_return (idEqual memb_ident memb_ident'))

def is_one_past_pointer [LemFuel] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (i : impl_pointer_value) :
    ndM Bool String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match i with
  | (PV _ ptr_val_ sh) =>
    (match ptr_val_ with
     | PVnull _ => nd_return false
     | PVfunction _ => nd_return false
     | _ =>
       nd_bind (explicitAllocationIdFromPointer_value_aux ptr_val_)
         (fun (x : Option (Nat × prefix0)) =>
           match x with
           | some (alloc_id, _) =>
             nd_bind (resolve_allocation alloc_id) (fun (stor : storage) =>
               let size_ival_ :=
                 match stor with
                 | Storage_static _ ty1 _ => IVsizeof ty1
                 | Storage_dynamic _ ival_ _ => ival_;
               /- |sh| = sizeof ty -/ condM "is_one_past_pointer"
                 (mk_iv_constr MC_eq
                   ((integer_value_baseFromShift_path _lemReader_enum_definitions
                     _lemReader_tagDefs) sh) size_ival_))
           | none => wip "is_one_past_pointer, implicit allocation"))

/-
let address_expression_of_pointer (PV _ ptr_val_ sh) =
  match ptr_val_ with
    | PVnull _ ->
        fail (MerrInternal "called [address_expression_of_pointer] on null pointer")
    | PVfunction _ ->
        fail (MerrInternal "called [address_expression_of_pointer] on function pointer")
    | _ ->
        explicitAllocationIdFromPointer_value_aux ptr_val_ >>= function
          | Just alloc_id ->
              resolve_allocation alloc_id >>= function
                | Storage_static ty _ ->
                  return $ mk_op_ival_ IntAdd (IVaddress alloc_id) (IVsizeof ty)
                | Storage_dynamic ival_ _ ->
                  return $ mk_op_ival_ IntAdd (IVaddress alloc_id) ival_
              end
          | Nothing ->
              wip "address_expression_of_pointer, implicit allocation"
        end
end
-/

