def impl_load [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (lvalue_ty : ctype) (i : impl_pointer_value) :
    impl_memM (impl_footprint × impl_mem_value) :=
  match loc1, lvalue_ty, i with
  | loc1, lvalue_ty, ptrval@(PV _ ptrval_ sh) =>
    nd_bind
      (print_debugM 1 (fun (u : Unit) =>
        match u with
        | () =>
          String.append "LOAD ["
            (String.append (CerbPP.stringFromCtype lvalue_ty)
              (String.append "]: with pointer value: " (CerbPP.stringFromPointer_value ptrval)))))
      (fun (_ : Unit) =>
        (perform_access _lemReader_enum_definitions _lemReader_tagDefs) LoadAccess loc1 lvalue_ty
          ptrval
          (fun (alloc_id : Nat) =>
            nd_bind (/- addToLog alloc_id >> -/ resolve_allocation alloc_id) (fun (x : storage) =>
              match x with
              | Storage_static stor_pref stor_ty (some mval) =>
                nd_bind
                  (/- found a stored value static memory -/ (apply_shift_path
                    _lemReader_enum_definitions _lemReader_tagDefs) lvalue_ty sh mval)
                  (fun (mval' : impl_mem_value) =>
                    nd_bind
                      (print_debugM 5 (fun (u : Unit) =>
                        match u with
                        | () =>
                          String.append "==> found value (static): "
                            (CerbPP.stringFromMem_value mval')))
                      (fun (_ : Unit) =>
                        /-
            if stor_ty = lvalue_ty then
              return (FP_alloc alloc_id lvalue_ty, mval')
            else
              error "WIP: LOAD, lvalue_ty <> stor_ty"
-/
                        nd_return (FP_alloc alloc_id lvalue_ty, mval')))
              | Storage_static _ _ none => /- loading from uninitialised static memory -/
                nd_return
                  (FP_alloc alloc_id lvalue_ty,
                    (mkUnspec _lemReader_enum_definitions _lemReader_tagDefs) lvalue_ty)
              | Storage_dynamic _ _ ws =>
                nd_bind
                  (nd_bind
                    (/- loading from dynamic memory -/ print_debugM 1 (fun (u : Unit) =>
                      match u with
                      | () =>
                        String.append "Loading from dynamic storage, found "
                          (String.append (Lem_String_extra.stringFromNat (List.length ws))
                            " write events")))
                    (fun (_ : Unit) =>
                      (discardOccluded_write_events _lemReader_enum_definitions _lemReader_tagDefs)
                        ptrval lvalue_ty ws))
                  (fun (visible_ws : List write_event) =>
                    nd_bind
                      (print_debugM 1 (fun (u : Unit) =>
                        match u with
                        | () =>
                          String.append "found "
                            (String.append (Lem_String_extra.stringFromNat (List.length visible_ws))
                              " visible write events")))
                      (fun (_ : Unit) => wip "TODO: loading from dynamic memory"))))
          (wip
            (String.append "TODO: load from device memory ==> "
              (CerbPP.stringFromPointer_value ptrval))))
