def impl_store [LemFuel] [CerbImplCfg.Impl] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (lvalue_ty : ctype) (is_locking : Bool) (ptrval : impl_pointer_value) (mval : impl_mem_value) :
    ndM impl_footprint String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  nd_bind
    (/- TODO: is_locking -/ print_debugM 5 (fun (u : Unit) =>
      match u with
      | () =>
        String.append "STORE ["
          (String.append (CerbPP.stringFromCtype lvalue_ty)
            (String.append "]: with pointer value: "
              (String.append (CerbPP.stringFromPointer_value ptrval)
                (String.append " and value: " (CerbPP.stringFromMem_value mval)))))))
    (fun (_ : Unit) =>
      let wevent := WriteEvent loc1 lvalue_ty ptrval mval;
      (perform_access _lemReader_enum_definitions _lemReader_tagDefs) StoreAccess loc1 lvalue_ty
        ptrval
        (fun (alloc_id : Nat) =>
          nd_bind
            (/- addToLog alloc_id >> -/ (register_write_event _lemReader_enum_definitions
              _lemReader_tagDefs) alloc_id wevent)
            (fun (_ : Unit) => nd_return (FP_alloc alloc_id lvalue_ty)))
        (nd_bind nd_get (fun (st : impl_mem_state) =>
          nd_bind
            (nd_bind (nd_put { st with device_memory := wevent :: st.device_memory })
              (fun (_ : Unit) =>
                (address_expression_of_pointer _lemReader_enum_definitions _lemReader_tagDefs)
                  ptrval))
            (fun (ptr_ival_ : integer_value_base) => nd_return (FP_device ptr_ival_ lvalue_ty)))))

