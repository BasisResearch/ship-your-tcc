    | (IVfromptr _ (Unsigned Intptr_t) _, IVmin (Unsigned Intptr_t)) ->
        let () = Debug.print_debug 3 [Debug.DB_memory] (fun () ->
          "using axiom ==> forall ref_ty ptrval, Ivfromptr(ref_ty, ptrval) < Ivmin(\"uintptr_t\")"
        ) in
        Just false
    
    | (IVmax (Signed Intptr_t), IVfromptr _ (Signed Intptr_t) _) ->
        let () = Debug.print_debug 3 [Debug.DB_memory] (fun () ->
          "using axiom ==> forall ref_ty ptrval, Ivmax(\"intptr_t\") < Ivfromptr(ref_ty, ptrval)"
        ) in
        Just false
    
    | (IVmax (Unsigned Intptr_t), IVfromptr _ (Unsigned Intptr_t) _) ->
        let () = Debug.print_debug 3 [Debug.DB_memory] (fun () ->
          "using axiom ==> forall ref_ty ptrval,  Ivmax(\"uintptr_t\") < Ivfromptr(ref_ty, ptrval)"
        ) in
        Just false
-/
     | IVbitwise ity1 _, IVmin ity2 => (lem_if integerTypeEqual ity1 ity2 then some false else none)
     | IVmax ity1, IVbitwise ity2 _ => (lem_if integerTypeEqual ity1 ity2 then some false else none)
     | IVconcrete n, IVsizeof _ => (lem_if intLteb n ((0 : Int)) then some true else none)
     | IVmin _, IVsizeof _ =>
       ((lemSeq
         (fun _ =>
           CerbDebug.warn [DB_memory] (fun (u : Unit) =>
             match u with
             | () => "assuming that no integer type has a strictly positive minimal value"))
         (fun _ => some true)))
     | IVmin _, IValignof _ =>
       ((lemSeq
         (fun _ =>
           CerbDebug.warn [DB_memory] (fun (u : Unit) =>
             match u with
             | () => "assuming that no integer type has a strictly positive minimal value"))
         (fun _ => some true)))
     | IVconcrete n, IVoffsetof tag_sym membr_ident => (failwithI "WIP" : Option Bool)
     /-
        if n <= 0 then
          match get_membersDefs tag_sym with
            | (ident', _)::_ ->
                if membr_ident = ident' then
                  /- TODO: assuming no prefix padding -/
                  Just false
                else
                  Just true
            | _ ->
                error "Mem.lt_ival, get_membersDefs returned an empty list"
          end
        else
          Nothing
-/
     | IVmin ity, IVconcrete n =>
       (match minimal_range ity with
        | (is_exact, min2, _) =>
          (lem_if is_exact then
            some (intLtb min2 n)
          else lem_if intLtb min2 n then some true else none))
     | IVconcrete n, IVmax ity =>
       (match minimal_range ity with
        | (is_exact, _, max2) =>
          (lem_if is_exact then
