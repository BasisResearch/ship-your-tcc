              Just true
-/
           | IVmin ity, IVbitwise ity' _ =>
             (lem_if integerTypeEqual ity ity' then some true else none)
           | IVbitwise ity _, IVmax ity' =>
             (lem_if integerTypeEqual ity ity' then some true else none)
           | IVmin ity, IVconcurRead ity' _ =>
             (lem_if integerTypeEqual ity ity' then some true else none)
           | IVconcurRead ity' _, IVmax ity =>
             (lem_if integerTypeEqual ity ity' then some true else none)
           | IVmin ity, IVconcrete n =>
             (match minimal_range ity with
              | (is_exact, min2, _) =>
                (lem_if is_exact then
                  some (intLteb min2 n)
                else lem_if intLteb min2 n then some true else none))
           | IVconcrete n, IVsizeof _ => (lem_if intLteb n ((0 : Int)) then some true else none)
           | IVmin _, IVsizeof _ =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () => "assuming that no integer type has a strictly positive minimal value"))
               (fun _ => some true)))
           | IVmin _, IValignof _ =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () => "assuming that no integer type has a strictly positive minimal value"))
               (fun _ => some true)))
           | IVconcrete n, IVmax ity =>
             (match minimal_range ity with
              | (is_exact, _, max2) =>
                (lem_if is_exact then
                  some (intLteb n max2)
                else lem_if intLteb n max2 then some true else none))
           | IVmin Size_t, IVoffsetof tag_sym membr_ident =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () =>
                     String.append "we are assuming that struct/union type '"
                       (String.append (show_symbol tag_sym)
                         (String.append "' isn't so big the offset to member '"
                           (String.append
                             (match membr_ident with
                              | Identifier _ str => str) "' is representable in size_t")))))
               (fun _ => /- TODO: check that -/ some true)))
           | IVoffsetof tag_sym membr_ident, IVmax Size_t =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () =>
                     String.append "we are assuming that struct/union type '"
                       (String.append (show_symbol tag_sym)
                         (String.append "' isn't so big the offset to member '"
                           (String.append
                             (match membr_ident with
                              | Identifier _ str => str) "' is representable in size_t")))))
               (fun _ => some true)))
           | IVconcrete n, IVoffsetof tag_sym membr_ident =>
             (lem_if intLteb n ((0 : Int)) then
               some true
             else
               none) /- a byte always range over uchar -/
           | IVmin (Unsigned Ichar), IVbyteof _ _ => some true
           | IVbyteof _ _, IVmax (Unsigned Ichar) => some true
           | IVmin (Signed Int_), IVbyteof _ _ =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () => "TODO: check + document")) (fun _ => some true)))
           | IVbyteof _ _, IVmax (Signed Int_) =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () => "TODO: check + document"))
               (fun _ => some true))) /- sizeof and alignof are always in range of size_t -/
           /-
          | (IVmin Size_t, IVsizeof _) ->
              Just true
-/
           | IVsizeof _, IVmax Size_t => some true
           /-
          | (IVmin Size_t, IValignof _) ->
              Just true
-/
           | IValignof _, IVmax Size_t => some true
           | IVop IntSub [IVoffsetof tag_sym1 membr_ident1, IVoffsetof tag_sym2 membr_ident2],
             IVmax Size_t =>
             (lem_if (match tag_sym1, tag_sym2 with
                      | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                        (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                          lem_if natGteb 0 5 && (sd1 != sd2) then
                            (lemSeq
                              (fun _ =>
                                CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                  match u with
                                  | () =>
                                    String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                      (String.append (show_symbol_description sd1)
                                        (String.append " <-> " (show_symbol_description sd2)))))
                              (fun _ => true))
                          else
                            true
                        else
                          false)) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                     match u with
                     | () =>
                       String.append "we are assuming that the delta between members '"
                         (String.append
                           (match membr_ident1 with
                            | Identifier _ str => str)
                           (String.append "' and '"
                             (String.append
                               (match membr_ident2 with
                                | Identifier _ str => str)
                               (String.append "' of struct/union type '"
                                 (String.append (show_symbol tag_sym1)
                                   "' is representable in size_t"))))))) (fun _ => some true))
             else
               none)
           | IVconcrete n,
             IVop IntSub [IVoffsetof tag_sym1 membr_ident1, IVoffsetof tag_sym2 membr_ident2] =>
             (lem_if intLteb n ((0 : Int)) then some true else none)
           | IVsizeof (Ctype _ (Pointer _ _)), IVmax _ =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.warn [DB_memory] (fun (u : Unit) =>
                   match u with
                   | () => "TODO: document")) (fun _ => some true)))
           | _, _ =>
             (let ival_1'' :=(lifted_simplify_integer_value_base _lemReader_enum_definitions
                  _lemReader_tagDefs) ival_1';
              let ival_2'' :=(lifted_simplify_integer_value_base _lemReader_enum_definitions
                  _lemReader_tagDefs) ival_2';
              match ival_1'', ival_2'' with
              | IVconcrete n1, IVconcrete n2 =>
                some (intLteb n1 n2) /- !!!!!! BEGIN HACK FOR CONCURRENCY, WILL FIX LATER -/
              | IVmin _, _ => some true /- if has_concurRead ival_2'' then Just true else Nothing -/
              | _, IVmax _ =>
                some
                  true /- if has_concurRead ival_1'' then Just true else Nothing -/ /- !!!!!! END HACK FOR CONCURRENCY, WILL FIX LATER -/
              | _, _ => /- TODO -/ none)))))

/- Converting an integer value into a pointer value -/
/-
let impl_ptrcast_ival int_ty ref_ty (IV prov ival_) =
  /- TODO: check the types -/
  match ival_ with
    | IVfromptr ty ity ptrval_ ->
        /- The integer value was made from an pointer value. the provenance is passed on -/
        return (PV prov ptrval_ [])
    | _ ->
        ifM "ptrcast_ival, null pointer"
          (mk_iv_constr MC_eq ival_ (IVconcrete 0))
          /- if the integer value is zero, then we make a null pointer (see Q28 in notes30) -/
          (return (impl_null_ptrval ref_ty))
          
          begin
            ifM "ptrcast_ival, device pointer"
              (MC_in_device (IV Prov_none ival_))
              /- if the integer value is within the device memory range -/
              (return (PV Prov_device (PVfromint ival_) []))
              /- otherwise we produce a runtime error (check with P) -/
              (fail (MerrWIP "tried to cast to a pointer type an (non device) integer value non-equal to zero"))
          end
  end
-/
def impl_ptrcast_ival { a : Type } (loc1 : CerbLocation.Loc) (int_ty : a) (ref_ty : ctype)
    (ival : impl_integer_value) :
    ndM impl_pointer_value String mem_error (mem_constraint impl_integer_value)
        impl_mem_state := /- TODO: check the types -/
  match ival with
  | IV prov
    (IVfromptr ty1 ity ptrval_
      sh) => /- The integer value was made from an pointer value. the provenance is passed on -/
    nd_return (PV prov ptrval_ sh)
  | IV (prov@(Prov_some _)) ival_ =>
    nd_return (PV prov (PVfromint ival_) ([] : List shift_path_element))
  | IV _ ival_ =>
    ifM "ptrcast_ival, null pointer" (mk_iv_constr MC_eq ival_ (IVconcrete ((0 : Int))))
      /- if the integer value is zero, then we make a null pointer (see Q28 in notes30) -/ (nd_return
        (impl_null_ptrval ref_ty))
      (ifM "ptrcast_ival, device pointer" (MC_in_device (IV Prov_none ival_))
        /- if the integer value is within the device memory range -/ (nd_return
          (PV Prov_device (PVfromint ival_) ([] : List shift_path_element)))
        /- otherwise we produce a runtime error (check with P) -/ (defacto_fail loc1
          (MerrWIP
            "tried to cast to a pointer type an (non device) integer value non-equal to zero")))

def impl_bytefromint { a : Type } (ival : a) : a := ival

def impl_intfrombyte { a : Type } (ival : a) : a := ival

