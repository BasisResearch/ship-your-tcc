def impl_allocate_object { a b c : Type } [LemFuel] (tid1 : a) (pref : prefix0)
    (i : impl_integer_value) (ty1 : ctype) (x : b) (init_opt : c) :
    ndM impl_pointer_value String mem_error (mem_constraint impl_integer_value) impl_mem_state :=
  match tid1, pref, i, ty1, x, init_opt with
  | tid1, pref, (IV _ align_ival_), ty1, _, init_opt =>
    nd_bind fresh_allocation_id (fun (alloc_id : Nat) =>
      nd_bind
        (nd_bind (register_address_constraints pref alloc_id (IVsizeof ty1) align_ival_)
          (fun (_ : Unit) => register_allocation alloc_id (Storage_static pref ty1 none)))
        (fun (_ : Unit) =>
          let ptr_val :=
            PV (Prov_some (alloc_id, pref)) (PVbase alloc_id pref) ([] : List shift_path_element);
          nd_bind
            (print_debugM 1 (fun (u : Unit) =>
              match u with
              | () =>
                String.append "Allocating (static) with type ["
                  (String.append (CerbPP.stringFromCtype ty1)
                    (String.append "] alloc_id= "
                      (String.append (Lem_String_extra.stringFromNat alloc_id)
                        (String.append ": " (CerbPP.stringFromPointer_value ptr_val)))))))
            (fun (_ : Unit) => /- DEBUG -/ nd_return ptr_val)))

/-
  /- the allocated object is given a new address (distinct from all other
     existing addresses) -/
  fresh_address pref >>= fun addr ->
  register_distinctness_constraints addr (IVsizeof ty) >>
  
  fresh_allocation_id >>= fun alloc_id ->
  register_allocation alloc_id (Alloc_static ty addr, Nothing /- mkUnspec ty -/) >>
  
  let ptr_val = PV (Prov_some alloc_id) (PVbase alloc_id pref) [] in
  print_debugM 4 (fun () -> "Allocating (static) with type [" ^ stringFromCtype ty ^ "]: " ^ stringFromPointer_value ptr_val) >> /- DEBUG -/
  
  return ptr_val
-/

