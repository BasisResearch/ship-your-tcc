  | .LabelRedefinition x1, .LabelRedefinition y1 => Ord.compare x1 y1
  | .CaseStatementOverlap x1, .CaseStatementOverlap y1 => Ord.compare x1 y1
  | .MutipleDefaultStatement x1, .MutipleDefaultStatement y1 => Ord.compare x1 y1
  | .UndeclaredLabel x1, .UndeclaredLabel y1 => Ord.compare x1 y1
  | .ReturnAsSimpleAssignment x1 x2 x3, .ReturnAsSimpleAssignment y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .ExternalRedefinition x1, .ExternalRedefinition y1 => Ord.compare x1 y1
  | .FunctionParameterAsSimpleAssignment x1 x2 x3, .FunctionParameterAsSimpleAssignment y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => Ord.compare x3 y3))
  | .TentativeNotCompleted x1, .TentativeNotCompleted y1 => Ord.compare x1 y1
  | .AtomicAddressArgumentMustBeAtomic x1 x2, .AtomicAddressArgumentMustBeAtomic y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .AtomicAddressArgumentMustBePointer x1 x2, .AtomicAddressArgumentMustBePointer y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .GNUConditionalOperatorInvalidOperandType x1, .GNUConditionalOperatorInvalidOperandType y1 =>
    Ord.compare x1 y1
  | xg, yg => Ord.compare (violation.ctor_rank_ocaml xg) (violation.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq violation where
  beq := violation.beq_derived
instance : Ord violation where
  compare := violation.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType violation where
  setElemCompare x y :=
    match violation.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 violation where
  isEqual := violation.beq_derived
  isInequal x y := !(violation.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 violation where
  compare x y :=
    match violation.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match violation.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match violation.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match violation.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match violation.compare_derived x y with
    | .lt => false
    | _ => true

abbrev assignment_violation := simple_assignment_violation → ctype → genType → violation

def std_of_assign_violation : simple_assignment_violation → List String :=
  fun (x : simple_assignment_violation) =>
    match x with
    | IncompatibleType => ["§6.5.16.1#1", "FOOTNOTE.112"]
    | IncompatiblePointerType => ["§6.5.16.1#1, bullet 3 and 4", "FOOTNOTE.112"]
    | DiscardsQualifiers => ["§6.5.16.1#1, bullet 3 and 4", "FOOTNOTE.112"]
    | NotArithmetic => ["§6.5.16.1#1, bullet 1"]
    | BoolExpectsArithmeticOrPointer => ["§6.5.16.1#1, bullet 6"]

