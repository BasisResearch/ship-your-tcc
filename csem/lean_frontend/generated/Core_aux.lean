def update_env_aux_lemFuel { a : Type } [MapKeyType a] (lemFuel : Nat) (g : generic_pattern a)
    (cval : value) (env1 : Fmap a value) :
    Fmap a value :=
  match lemFuel with
  | 0 => (fuelExhausted env1)
  | Nat.succ lemFuel =>
    (match g, cval, env1 with
     | (Pattern _ pat), cval, env1 =>
       (match pat, cval with
        | CaseBase (none, _), _ => /- e[_ \ v] = e -/ env1
        | CaseBase (some sym1, _), _ =>
          (/- e[sym \ v] -/ fmapAddBy (@mapKeyCompare a _) sym1 cval env1)
        | CaseCtor (Cnil _) [], Vlist _ [] => /- empty list (value) -/ env1
        | CaseCtor Ccons [pat1, pat2],
          Vlist bTy_elem (cval1 :: cvals) => /- populated list (value) -/
          (update_env_aux_lemFuel lemFuel) pat1 cval1
            ((update_env_aux_lemFuel lemFuel) pat2 (Vlist bTy_elem cvals) env1)
        | CaseCtor Ctuple pats', Vtuple cvals =>
          (/- FORK 2026-09-22: arity guard (see tuple_arity_error) — the let-forms of
           BOTH engines (Core_run, Core_reduction) check match_pattern first and
           report Illformed_program; this leaf is the backstop -/
          lem_if not ((List.length pats') == (List.length cvals)) then
            tuple_arity_error "update_env_aux" (List.length pats') (List.length cvals)
          else
            lemListFoldr
              (fun (p : (generic_pattern a × value)) (acc : Fmap a value) =>
                match p, acc with
                | (pat', cval'), acc => (update_env_aux_lemFuel lemFuel) pat' cval' acc) env1
              (lemListZip pats' cvals))
        | CaseCtor Cspecified [pat'], Vloaded (LVspecified oval) =>
          (update_env_aux_lemFuel lemFuel) pat' (Vobject oval) env1
        | CaseCtor Cunspecified [pat'], Vloaded (LVunspecified ty1) =>
          (update_env_aux_lemFuel lemFuel) pat' (Vctype ty1) env1
        | CaseCtor ctor1 pats, _ =>
          (let str_ctor :=
             match ctor1 with
             | Cnil _ => "nil"
             | Ccons => "cons"
             | Ctuple => "tuple"
             | Carray => "array"
             | Civmax => "ivmax"
             | Civmin => "ivmin"
             | Civsizeof => "ivsizeof"
             | Civalignof => "ivalignof"
             | CivCOMPL => "ivCOMPL"
             | CivAND => "ivAND"
             | CivOR => "ivOR"
             | CivXOR => "ivXOR"
             | Cspecified => "specified"
             | Cunspecified => "unspecified"
             | Cfvconvert => "Cfvconvert"
             | CfvconvertLoaded => "CfvconvertLoaded"
             | CfvfromintTyped => "CfvfromintTyped"
             | CfvfromintTypedLoaded => "CfvfromintTypedLoaded"
             | Cfvneg => "Cfvneg"
             | Cfvfromint => "fvfromint"
             | Civfromfloat => "ivfromfloat"
             | CivNULLcap is_signed =>
               String.append "ivNULLcap("
                 (lem_if is_signed then "signed" else String.append "unsigned" ")");
           (failwithI
             (String.append "WIP: Core_aux.update_env_aux ==> ctor= "
               (String.append str_ctor
                 (String.append ", |pats|= "
                   (String.append (Lem_String_extra.stringFromNat (List.length pats))
                     (String.append " -- " (CerbPP.stringFromCore_value cval)))))) : Fmap a
             value))))

def update_env_aux { a : Type } [MapKeyType a] (g : generic_pattern a) (cval : value)
    (env1 : Fmap a value) :
    Fmap a value :=
  update_env_aux_lemFuel (generic_pattern.lemSize g) g cval env1
theorem update_env_aux_lemFuel_zero { a : Type } [MapKeyType a] (g : generic_pattern a)
    (cval : value) (env1 : Fmap a value) :
    update_env_aux_lemFuel 0 g cval env1 = (fuelExhausted env1) :=
  rfl

def update_env (pat : generic_pattern sym) (cval : value) :
    List (Fmap sym value) → List (Fmap sym value) :=
  fun (x : List (Fmap sym value)) =>
    match x with
    | [] => (failwithI "Core_aux.update_env: found empty env" : List (Fmap sym value))
    | env1 :: xs => update_env_aux pat cval env1 :: xs

def lookup_env { a b : Type } [MapKeyType b] (sym1 : b) : List (Fmap b a) → Option a :=
  fun (x : List (Fmap b a)) =>
    match x with
    | [] => none
    | env1 :: xs =>
      (match (fmapLookupBy (@mapKeyCompare b _) sym1 env1) with
       | none => lookup_env sym1 xs
       | some ret => some ret)

