def seq_rmw { a : Type } [Default a] (loc1 : CerbLocation.Loc) (with_forward : Bool)
    (ty1 : generic_pexpr Unit sym) (oTy : core_object_type) (x : generic_pexpr Unit sym)
    (sym1 : sym) (upd : generic_pexpr Unit sym) :
    generic_expr a Unit sym :=
  let backend := CerbGlobal.backend_name ();
  lem_if (backend == "Cn") ||
      (backend == "Bmc") then /- TODO: compatibility mode for Cn, until SeqRMW is supported -/
    lem_if with_forward then
      (failwithI "TODO: Core_aux.seq_rmw (comptability mode) with_forward" : generic_expr a Unit
        sym)
    else
      Expr ([] : List annot)
        (Ewseq (mk_sym_pat sym1 /- TODO -/ (BTy_loaded oTy)) (pload loc1 ty1 x NA)
          (Expr ([] : List annot)
            (Ewseq (mk_empty_pat BTy_unit) (pstore loc1 ty1 x upd NA)
              (Expr ([] : List annot) (Epure (mk_sym_pe sym1))))))
  else
    Expr ([] : List annot)
      (Eaction (Paction Pos (Action loc1 (@default0 a _) (SeqRMW with_forward ty1 x sym1 upd))))

/- for a given Ctype returns the corresponding "zero" value -/
/- val     zeros: AilSyntax.tag_definition -> ctype -> pexpr -/
/- see §6.7.9#10 -/
def zeros_aux_lemFuel { a : Type } [CerbImplCfg.Impl] (lemFuel : Nat)
    (tagDefs1 : Fmap sym (a × tag_definition)) (c : ctype) :
    CerbMem.MemValue :=
  match lemFuel with
  | 0 => (CerbMem.zerosFuelExhausted ())
  | Nat.succ lemFuel =>
    (match tagDefs1, c with
     | tagDefs1, (Ctype _ ty1) =>
       (let zero_ival := CerbMem.integerIval ((0 : Int));
        match ty1 with
        | Basic (Integer ity) => CerbMem.integerValueMval ity zero_ival
        | Basic (Floating fty) => CerbMem.floatingValueMval fty CerbMem.zeroFval
        | Array0 elem_ty (some n) =>
          CerbMem.arrayMval
            (List.replicate (Int.natAbs (lemIntFromInteger n))
              ((zeros_aux_lemFuel lemFuel) tagDefs1 elem_ty))
        /-
  Mem.array_mval (List.replicate (natFromInteger n) (Mem.integer_value_mval zero_ival))
-/
        | Pointer _ ref_ty => CerbMem.pointerMval ref_ty (CerbMem.nullPtrval ref_ty)
        | Atomic ty' => (zeros_aux_lemFuel lemFuel) tagDefs1 ty'
        | Struct tag =>
          (match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag
               tagDefs1) with
           | some (_, StructDef ident_tys none) =>
             CerbMem.structMval tag
               (List.map
                 (fun (p : (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
                   match p with
                   | (ident, (_, _, _, ty1)) =>
                     (ident, ty1, (zeros_aux_lemFuel lemFuel) tagDefs1 ty1)) ident_tys)
           | some
             (_,
               StructDef ident_tys
                 (some (FlexibleArrayMember _ flex_ident flex_qs flex_elem_ty))) =>
             ((lemSeq
               (fun _ =>
                 CerbDebug.print_debug_pure 0 ([] : List domain) (fun (u : Unit) =>
                   match u with
                   | () => "TODO: check Core_aux.zeros_aux for flexible array member"))
               (fun _ =>
                 CerbMem.structMval tag
                   (List.map
                     (fun (p :
                       (identifier × (attributes × Option alignment × qualifiers × ctype))) =>
                       match p with
                       | (ident, (_, _, _, ty1)) =>
                         (ident, ty1, (zeros_aux_lemFuel lemFuel) tagDefs1 ty1)) ident_tys))))
           | _ => (failwithI "Core_aux.zeros_aux, not StructDef" : CerbMem.MemValue))
        | Union0 tag =>
          (match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) tag
               tagDefs1) with
           | some (_, UnionDef ((ident, (_, _, _, ty')) :: _)) =>
             CerbMem.unionMval tag ident ((zeros_aux_lemFuel lemFuel) tagDefs1 ty')
           | _ => (failwithI "Core_aux.zeros_aux, not UnionDef" : CerbMem.MemValue))
        | _ =>
          (failwithI "Core_aux.zeros should only be called on complete types" : CerbMem.MemValue)))

def zeros_aux { a : Type } [LemFuel] [CerbImplCfg.Impl] :
    Fmap sym (a × tag_definition) → ctype → CerbMem.MemValue :=
  zeros_aux_lemFuel LemFuel.fuel
theorem zeros_aux_lemFuel_zero { a : Type } [CerbImplCfg.Impl]
    (tagDefs1 : Fmap sym (a × tag_definition)) (c : ctype) :
    zeros_aux_lemFuel 0 tagDefs1 c = (CerbMem.zerosFuelExhausted ()) :=
  rfl

/- Arc-1 totality: zeros_aux is NOT structurally recursive — the Struct/Union
   cases recurse on member types fetched from tagDefs (env-mediated, the
   golean '.defined-through-the-environment' class; Lean's checker rejects
   it, verified 2026-08-18). Fuel-threaded instead: the worker is total,
   fuel bounds type-nesting depth only, and exhaustion panics like the
   existing failwith invariant branches (a well-formed program never
   reaches it). -/

def zeros [LemFuel] [CerbImplCfg.Impl] (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (ty1 : ctype) :
    generic_pexpr Unit sym := /- TODO: yucky -/
  Pexpr ([] : List annot) ()
    /-
    (PEval (Vobject (snd $ objectValueFromMemValue (zeros_aux ty))))
-/
    (PEval (Prod.snd (valueFromMemValue (zeros_aux tagDefs1 ty1))))
/-


/-

TODO: bring back structs/unions

  let proj_member = function
    | Ail.MEMBER ty               -> MEMBER (proj_ctype ty)
    | Ail.BITFIELD ty w is_packed -> BITFIELD (proj_ctype ty) w is_packed
  end in
-/
  match ty with
    | Ctype.Void             -> Void
    | Ctype.Basic bt         -> Basic bt
    | Ctype.Array ty n       -> Array (proj_ctype ty) n
    | Ctype.Function ty ps b -> Function (proj_ctype ty) (List.map (proj_ctype -| snd) ps) b
    | Ctype.Pointer _ ty    -> Pointer (proj_ctype ty)
    | Ctype.Atomic ty        -> Atomic (proj_ctype ty)
/-
    | Ail.STRUCT _ tag members -> STRUCT tag (List.map (fun (a, m) -> (a, proj_member m)) members)
    | Ail.UNION  _ tag members -> UNION  tag (List.map (fun (a, m) -> (a, proj_member m)) members)
    | Ail.ENUM id              -> ENUM id
    | Ail.ATOMIC ty            -> ATOMIC (proj_ctype ty)
    | Ail.TYPEDEF _            -> error "[Core_aux.proj_ctype] found a A.TYPEDEF"
    | Ail.SIZE_T               -> SIZE_T
    | Ail.INTPTR_T             -> INTPTR_T
    | Ail.WCHAR_T              -> WCHAR_T
    | Ail.CHAR16_T             -> CHAR16_T
    | Ail.CHAR32_T             -> CHAR32_T
-/
end
-/
/-
/- Bring back a Core.ctype into a Ail.ctype (with loss of qualifiers if coming from proj_ctype) -/
let rec unproj_ctype ty =
  Ctype.Ctype [] (match ty with
    | Void ->
        Ctype.Void
    | Basic bty ->
        Ctype.Basic bty
    | Array ty n_opt ->
        Ctype.Array (unproj_ctype ty) n_opt
    | Function (qs, ty) qs_tys is_variadic ->
        /- NOTE: there is a potential loss of information here for hasProto and
           inside the parameters with isRegister. But this shouldn't matter to
           the dynamics -/
        Ctype.Function false (qs, unproj_ctype ty) (
          List.map (fun (qs,ty) ->
            (qs, unproj_ctype ty, false)
          ) qs_tys
        ) is_variadic
    | Pointer qs ty ->
        Ctype.Pointer qs (unproj_ctype ty)
    | Atomic ty ->
        Ctype.Atomic (unproj_ctype ty)
    | Struct tag ->
        Ctype.Struct tag
    | Union tag ->
        Ctype.Union tag
  end)
-/
/-
/-
  let unproj_member = function
    | MEMBER ty               -> Ail.MEMBER (unproj_ctype ty)
    | BITFIELD ty w is_packed -> Ail.BITFIELD (unproj_ctype ty) w is_packed
  end in
-/
  match ty with
    | Void              -> Ctype.Void
    | Basic bt          -> Ctype.Basic bt
    | Array ty n        -> Ctype.Array (unproj_ctype ty) n
    | Function ty tys b -> Ctype.Function (unproj_ctype ty) (List.map (Product.make Ctype.no_qualifiers -| unproj_ctype) tys) b
    | Pointer ty        -> Ctype.Pointer Ctype.no_qualifiers (unproj_ctype ty)
    | Atomic ty         -> Ctype.Atomic (unproj_ctype ty)
/-
    | STRUCT tag members -> Ail.STRUCT Ail.no_qualifiers tag (List.map (fun (a, m) -> (a, unproj_member m)) members)
    | UNION  tag members -> Ail.UNION  Ail.no_qualifiers tag (List.map (fun (a, m) -> (a, unproj_member m)) members)
    | ENUM id            -> Ail.ENUM id
    | ATOMIC ty          -> Ail.ATOMIC (unproj_ctype ty)
    | SIZE_T             -> Ail.SIZE_T
    | INTPTR_T           -> Ail.INTPTR_T
    | WCHAR_T            -> Ail.WCHAR_T
    | CHAR16_T           -> Ail.CHAR16_T
    | CHAR32_T           -> Ail.CHAR32_T
-/
end
-/
/-
let rec mk_wseqs_aux end_e pat_es =
  match pat_es with
    | []               -> end_e
    | (pat, e) :: pat_es' -> Ewseq pat e (mk_wseqs_aux end_e pat_es')
end

val mk_wseqs: expr unit -> list (pattern * expr unit) -> expr unit
let mk_wseqs end_e = function
  | [] ->
      end_e
  | [(_, e)] ->
      e
  | pat_es ->
      mk_wseqs_aux end_e pat_es
end
-/

def annotate_integer_type_expr (ity : integerType) (g : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  match ity, g with
  | ity, (Expr annots1 expr_) => Expr (Avalue (Ainteger ity) :: annots1) expr_
def maybe_annotate_integer_type (c : ctype) (g : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  match c, g with
  | (Ctype _ ty_), (Expr annots1 expr_) =>
    (let annots1 :=
       match ty_ with
       | Basic (Integer ity) => Avalue (Ainteger ity) :: annots1
       | _ => annots1;
     Expr annots1 expr_)
def mk_sseqs (pat_es : List (generic_pattern sym × generic_expr Unit Unit sym)) :
    generic_expr Unit Unit sym → generic_expr Unit Unit sym :=
  fun (z : generic_expr Unit Unit sym) =>
    match pat_es with
    | [] => z
    | (pat, e) :: pat_es' => Expr ([] : List annot) (Esseq pat e (mk_sseqs pat_es' z))

/-
/- val     mk_sseq: forall 'a. list (pattern * expr 'a) -> expr 'a -/
let rec mk_sseq a_opts_es =
  match a_opts_es with
    | []               -> Eskip
    | [(_, e)]         -> e
    | (a_opts, e)::es' -> Esseq a_opts e (mk_sseq es')
end

/- val     mk_sseq': forall 'a. list (pattern * expr 'a) -> expr 'a -> expr 'a -/
let rec mk_sseq' a_opts_es z =
  match a_opts_es with
    | []               -> z
    | [(_, e)]         -> e
    | (a_opts, e)::es' -> Esseq a_opts e (mk_sseq' es' z)
end
-/

def mk_unseq { a b : Type } : List (generic_expr b Unit a) → generic_expr b Unit a :=
  fun (x : List (generic_expr b Unit a)) =>
    match x with
    | [] => Expr ([] : List annot) (Epure (Pexpr ([] : List annot) () (PEval Vunit)))
    | [e] => e
    | es => Expr ([] : List annot) (Eunseq es)

def mk_unit_sseq (es : List (generic_expr Unit Unit sym)) :
    generic_expr Unit Unit sym → generic_expr Unit Unit sym :=
  fun (z : generic_expr Unit Unit sym) =>
    match es with
    | [] => z
    /-
      | [e] ->
          e
-/
    | e :: es' => Expr ([] : List annot) (Esseq (mk_empty_pat BTy_unit) e (mk_unit_sseq es' z))

def mk_bTy_sseqs (bTy_es : List (core_base_type × generic_expr Unit Unit sym)) :
    generic_expr Unit Unit sym :=
  match bTy_es with
  | [] => Expr ([] : List annot) (Epure (Pexpr ([] : List annot) () (PEval Vunit)))
  | [(_, e)] => e
  | (bTy, e) :: bTy_es' =>
    Expr ([] : List annot) (Esseq (mk_empty_pat bTy) e (mk_bTy_sseqs bTy_es'))

def concat_sseq { a b : Type } (g : generic_expr b a sym) (e' : generic_expr b a sym) :
    generic_expr b a sym :=
  match g, e' with
  | e@((Expr annot1 e_)), e' =>
    (match e_ with
     | Esseq pat e1 e2 => Expr annot1 (Esseq pat e1 (concat_sseq e2 e'))
     | Epure (Pexpr _ _ (PEval Vunit)) => e'
     | _ => Expr ([] : List annot) (Esseq (mk_empty_pat BTy_unit) e e'))

def is_negative { a b c : Type } : generic_expr c b a → Bool :=
  fun (x : generic_expr c b a) =>
    match x with
    | Expr _ (Eaction (Paction Neg0 _)) => true
    | _ => false

def is_negative_action { a b c : Type } : generic_paction c b a → Bool :=
  fun (x : generic_paction c b a) =>
    match x with
    | (Paction Neg0 _) => true
    | _ => false

