def valueFromPexpr : generic_pexpr Unit sym → Option value :=
  fun (x : generic_pexpr Unit sym) =>
    match x with
    | Pexpr _ () (PEval cval) => some (/- flatten_constrained_value -/ cval)
    | _ => none

def valueFromPexprs (pes : List (generic_pexpr Unit sym)) : Option (List value) :=
  lemListFoldr
    (fun (pe : generic_pexpr Unit sym) (acc_opt : Option (List value)) =>
      match valueFromPexpr pe, acc_opt with
      | some cval, some acc => some (cval :: acc)
      | _, _ => none) (some ([] : List value)) pes
def valueOrPEconstrainedFromPexpr (pe : generic_pexpr Unit sym) :
    Option (Sum value (generic_pexpr Unit sym)) :=
  match pe with
  | Pexpr _ () (PEval cval) => some (Sum.inl cval)
  | Pexpr _ () (PEconstrained _) => some (Sum.inr pe)
  | _ => none

def valueOrPEconstrainedFromPexprs (pes : List (generic_pexpr Unit sym)) :
    Option
        (Sum (List value)
          ((Nat × List (mem_iv_constraint × generic_pexpr Unit sym)) × List
            (generic_pexpr Unit sym))) :=
  Prod.snd
    (lemListFoldr
      (fun (pe : generic_pexpr Unit sym)
        (p :
          (Nat × Option
            (Sum (List value)
              ((Nat × List (mem_iv_constraint × generic_pexpr Unit sym)) × List
                (generic_pexpr Unit sym))))) =>
        match pe, p with
        | pe, (i, acc) =>
          ((i + 1),
            match valueOrPEconstrainedFromPexpr pe, acc with
            | some (Sum.inl cval), some (Sum.inl cvals) => some (Sum.inl (cval :: cvals))
            | some (Sum.inr (pe@(Pexpr _ () (PEconstrained xs)))), some (Sum.inl cvals) =>
              some
                (Sum.inr
                  ((i, xs),
                    (pe ::
                      (List.map (fun (v : value) => Pexpr ([] : List annot) () (PEval v)) cvals))))
            | some (Sum.inr pe), some (Sum.inr (i_xs, pes)) => some (Sum.inr (i_xs, (pe :: pes)))
            | _, _ => none)) (0, some (Sum.inl ([] : List value))) pes)
def core_aux_to_integer (pe : generic_pexpr Unit sym) : Option Int :=
  match valueFromPexpr pe with
  | some (Vobject (OVinteger ival)) => integerFromIntegerValue ival
  | _ => none

/- check if a symbolic names is part of a pattern -/

def in_pattern_lemFuel (lemFuel : Nat) (sym1 : sym) (g : generic_pattern sym) : Bool :=
  match lemFuel with
  | 0 => (fuelExhausted false)
  | Nat.succ lemFuel =>
    (match sym1, g with
     | sym1, (Pattern _ pat) =>
       (match pat with
        | CaseBase (sym_opt, _) =>
          maybe0 false
            (fun (sym' : sym) =>
              match sym1, sym' with
              | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                  lem_if natGteb 0 5 && (sd1 != sd2) then
                    (lemSeq
                      (fun _ =>
                        CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                          match u with
                          | () =>
                            String.append "[Symbol.symbolEqual] suspicious equality ==> "
                              (String.append (show_symbol_description sd1)
                                (String.append " <-> " (show_symbol_description sd2)))))
                      (fun _ => true))
                  else
                    true
                else
                  false)) sym_opt
        | CaseCtor _ pats' => List.any pats' ((in_pattern_lemFuel lemFuel) sym1)))

def in_pattern (sym1 : sym) (g : generic_pattern sym) : Bool :=
  in_pattern_lemFuel (generic_pattern.lemSize g) sym1 g
theorem in_pattern_lemFuel_zero (sym1 : sym) (g : generic_pattern sym) :
    in_pattern_lemFuel 0 sym1 g = (fuelExhausted false) :=
  rfl

def subst_sym_pexpr_lemFuel (lemFuel : Nat) (sym1 : sym) (cval : value)
    (g : generic_pexpr Unit sym) :
    generic_pexpr Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match sym1, cval, g with
     | sym1, cval, (Pexpr annot1 bty pexpr_) =>
       Pexpr annot1 bty
         (match pexpr_ with
          | PEsym sym' =>
            (lem_if (match sym1, sym' with
                     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                         lem_if natGteb 0 5 && (sd1 != sd2) then
                           (lemSeq
                             (fun _ =>
                               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                 match u with
                                 | () =>
                                   String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                     (String.append (show_symbol_description sd1)
                                       (String.append " <-> " (show_symbol_description sd2)))))
                             (fun _ => true))
                         else
                           true
                       else
                         false)) then
              PEval cval
            else
              pexpr_)
          | PEimpl _ => pexpr_
          | PEval _ => pexpr_
          | PEconstrained xs =>
            PEconstrained
              (List.map
                (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                  match p with
                  | (constrs, pe) => (constrs, (subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)) xs)
          | PEundef _ _ => pexpr_
          | PEerror str pe => PEerror str ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEctor ctor1 pes =>
            PEctor ctor1 (List.map ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval) pes)
          | PEcase pe xs =>
            PEcase ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_pexpr Unit sym)) =>
                  match p with
                  | (pat, pe) =>
                    (pat,
                      (lem_if in_pattern sym1 pat then
                        pe
                      else
                        (subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe))) xs)
          | PEarray_shift pe1 ty1 pe2 =>
            PEarray_shift ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1) ty1
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
          | PEmember_shift pe tag_sym memb_ident =>
            PEmember_shift ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe) tag_sym memb_ident
          | PEmemop mop pes =>
            PEmemop mop (List.map ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval) pes)
          | PEnot pe => PEnot ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEop bop pe1 pe2 =>
            PEop bop ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
          | PEconv_int ty1 pe => PEconv_int ty1 ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEwrapI ty1 iop1 pe1 pe2 =>
            PEwrapI ty1 iop1 ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
          | PEcatch_exceptional_condition ty1 iop1 pe1 pe2 =>
            PEcatch_exceptional_condition ty1 iop1 ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
          | PEstruct tag_sym xs =>
            PEstruct tag_sym
              (List.map
                (fun (p : (identifier × generic_pexpr Unit sym)) =>
                  match p with
                  | (ident, pe) => (ident, (subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)) xs)
          | PEunion tag_sym ident pe =>
            PEunion tag_sym ident ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEcfunction pe => PEcfunction ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEmemberof tag_sym memb_ident pe =>
            PEmemberof tag_sym memb_ident ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEcall nm pes => PEcall nm (List.map ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval) pes)
          | PElet pat pe1 pe2 =>
            PElet pat ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              (lem_if in_pattern sym1 pat then
                pe2
              else
                (subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
          | PEif pe1 pe2 pe3 =>
            PEif ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe3)
          | PEis_scalar pe => PEis_scalar ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEis_integer pe => PEis_integer ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEis_signed pe => PEis_signed ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEis_unsigned pe => PEis_unsigned ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEbmc_assume pe => PEbmc_assume ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe)
          | PEare_compatible pe1 pe2 =>
            PEare_compatible ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe1)
              ((subst_sym_pexpr_lemFuel lemFuel) sym1 cval pe2)))

def subst_sym_pexpr (sym1 : sym) (cval : value) (g : generic_pexpr Unit sym) : pexpr :=
  subst_sym_pexpr_lemFuel (generic_pexpr.lemSize g) sym1 cval g
theorem subst_sym_pexpr_lemFuel_zero (sym1 : sym) (cval : value) (g : generic_pexpr Unit sym) :
    subst_sym_pexpr_lemFuel 0 sym1 cval g = (fuelExhausted g) :=
  rfl

def subst_sym_action_ (sym1 : sym) (cval : value) :
    generic_action_ Unit sym → generic_action_ Unit sym :=
  match sym1, cval with
  | sym1, cval =>
    (fun (x : generic_action_ Unit sym) =>
      match x with
      | Create pe1 pe2 pref =>
        Create (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2) pref
      | CreateReadOnly pe1 pe2 pe3 pref =>
        CreateReadOnly (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) pref
      | Alloc0 pe1 pe2 pref =>
        Alloc0 (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2) pref
      | Kill kind1 pe => Kill kind1 (subst_sym_pexpr sym1 cval pe)
      | Store0 b pe1 pe2 pe3 mo1 =>
        Store0 b (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) mo1
      | Load0 pe1 pe2 mo1 =>
        Load0 (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2) mo1
      | SeqRMW b pe1 pe2 sym' pe3 =>
        SeqRMW b (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2) sym'
          (lem_if (match sym1, sym' with
                   | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                     (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                       lem_if natGteb 0 5 && (sd1 != sd2) then
                         (lemSeq
                           (fun _ =>
                             CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                               match u with
                               | () =>
                                 String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                   (String.append (show_symbol_description sd1)
                                     (String.append " <-> " (show_symbol_description sd2)))))
                           (fun _ => true))
                       else
                         true
                     else
                       false)) then
            pe3
          else
            subst_sym_pexpr sym1 cval pe3)
      | RMW0 pe1 pe2 pe3 pe4 mo1 mo2 =>
        RMW0 (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) (subst_sym_pexpr sym1 cval pe4) mo1 mo2
      | Fence0 mo1 => Fence0 mo1
      | CompareExchangeStrong pe1 pe2 pe3 pe4 mo1 mo2 =>
        CompareExchangeStrong (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) (subst_sym_pexpr sym1 cval pe4) mo1 mo2
      | CompareExchangeWeak pe1 pe2 pe3 pe4 mo1 mo2 =>
        CompareExchangeWeak (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) (subst_sym_pexpr sym1 cval pe4) mo1 mo2
      | LinuxFence mo1 => LinuxFence mo1
      | LinuxStore pe1 pe2 pe3 mo1 =>
        LinuxStore (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) mo1
      | LinuxLoad pe1 pe2 mo1 =>
        LinuxLoad (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2) mo1
      | LinuxRMW pe1 pe2 pe3 mo1 =>
        LinuxRMW (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
          (subst_sym_pexpr sym1 cval pe3) mo1)
def subst_sym_action { a : Type } (sym1 : sym) (cval : value) (g : generic_action a Unit sym) :
    generic_action a Unit sym :=
  match sym1, cval, g with
  | sym1, cval, (Action loc1 bs act_) => Action loc1 bs (subst_sym_action_ sym1 cval act_)
def subst_sym_paction { a : Type } (sym1 : sym) (cval : value) (g : generic_paction a Unit sym) :
    generic_paction a Unit sym :=
  match sym1, cval, g with
  | sym1, cval, (Paction p act) => Paction p (subst_sym_action sym1 cval act)
def subst_sym_expr_lemFuel { a : Type } (lemFuel : Nat) (sym1 : sym) (cval : value)
    (g : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match sym1, cval, g with
     | sym1, cval, (Expr annot1 expr_) =>
       Expr annot1
         (match expr_ with
          | Epure pe => Epure (subst_sym_pexpr sym1 cval pe)
          | Ememop memop1 pes => Ememop memop1 (List.map (subst_sym_pexpr sym1 cval) pes)
          | Elet pat pe1 e2 =>
            Elet pat (subst_sym_pexpr sym1 cval pe1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (subst_sym_expr_lemFuel lemFuel) sym1 cval e2)
          | Eif pe1 e2 e3 =>
            Eif (subst_sym_pexpr sym1 cval pe1) ((subst_sym_expr_lemFuel lemFuel) sym1 cval e2)
              ((subst_sym_expr_lemFuel lemFuel) sym1 cval e3)
          | Ecase pe pat_es =>
            Ecase (subst_sym_pexpr sym1 cval pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
                  match p with
                  | (pat, e) =>
                    (pat,
                      (lem_if in_pattern sym1 pat then
                        e
                      else
                        (subst_sym_expr_lemFuel lemFuel) sym1 cval e))) pat_es)
          | Eccall annot1 pe1 pe2 pes =>
            Eccall annot1 (subst_sym_pexpr sym1 cval pe1) (subst_sym_pexpr sym1 cval pe2)
              (List.map (subst_sym_pexpr sym1 cval) pes)
          | Eproc annot1 nm pes => Eproc annot1 nm (List.map (subst_sym_pexpr sym1 cval) pes)
          | Eaction pact => Eaction (subst_sym_paction sym1 cval pact)
          | Eunseq es => Eunseq (List.map ((subst_sym_expr_lemFuel lemFuel) sym1 cval) es)
          | Ewseq pat e1 e2 =>
            Ewseq pat ((subst_sym_expr_lemFuel lemFuel) sym1 cval e1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (subst_sym_expr_lemFuel lemFuel) sym1 cval e2)
          | Esseq pat e1 e2 =>
            Esseq pat ((subst_sym_expr_lemFuel lemFuel) sym1 cval e1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (subst_sym_expr_lemFuel lemFuel) sym1 cval e2)
          | Ebound e => Ebound ((subst_sym_expr_lemFuel lemFuel) sym1 cval e)
          | Esave lab_sym sym_bTy_pes e =>
            (let sym_bTy_pes' :=
               List.map
                 (fun (p :
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   match p with
                   | (z, (bTy, pe)) => (z, (bTy, subst_sym_pexpr sym1 cval pe))) sym_bTy_pes;
             lem_if List.any sym_bTy_pes
                 (fun (p :
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   match p with
                   | (z, _) =>
                     (match sym1, z with
                      | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                        (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                          lem_if natGteb 0 5 && (sd1 != sd2) then
                            (lemSeq
                              (fun _ =>
                                CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                  match u with
                                  | () =>
                                    String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                      (String.append (show_symbol_description sd1)
                                        (String.append " <-> " (show_symbol_description sd2)))))
                              (fun _ => true))
                          else
                            true
                        else
                          false))) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                     match u with
                     | () => "subst, Esave ==> shadowing"))
                 (fun _ => /- TODO: check -/ Esave lab_sym sym_bTy_pes' e))
             else
               Esave lab_sym sym_bTy_pes' ((subst_sym_expr_lemFuel lemFuel) sym1 cval e))
          | Erun annot1 lab_sym pes =>
            Erun annot1 lab_sym (List.map (subst_sym_pexpr sym1 cval) pes)
          | End es => End (List.map ((subst_sym_expr_lemFuel lemFuel) sym1 cval) es)
          | Epar es => Epar (List.map ((subst_sym_expr_lemFuel lemFuel) sym1 cval) es)
          | Ewait _ => expr_
          | Eannot xs e => Eannot xs ((subst_sym_expr_lemFuel lemFuel) sym1 cval e)
          | Eexcluded n act =>
            Eexcluded n
              (subst_sym_action sym1 cval act)
              /-
    | Eloc loc e ->
        Eloc loc (subst_sym_expr sym cval e)
    | Estd str e ->
        Estd str (subst_sym_expr sym cval e)
-/
              ))

def subst_sym_expr { a : Type } (sym1 : sym) (cval : value) (g : generic_expr a Unit sym) :
    expr a :=
  subst_sym_expr_lemFuel (generic_expr.lemSize g) sym1 cval g
theorem subst_sym_expr_lemFuel_zero { a : Type } (sym1 : sym) (cval : value)
    (g : generic_expr a Unit sym) :
    subst_sym_expr_lemFuel 0 sym1 cval g = (fuelExhausted g) :=
  rfl

/- FORK 2026-09-22 (closure round 2): match_pattern MOVED here, verbatim, from its place
   just before select_case — Lem is definition-before-use and subst_pattern (below)
   now uses it as its fit test. Body unchanged (the round-1 arity guard included). -/

def match_pattern_lemFuel (lemFuel : Nat) (g : generic_pattern sym) (cval : value) :
    Option (List (sym × value)) :=
  match lemFuel with
  | 0 => (fuelExhausted none)
  | Nat.succ lemFuel =>
    (match g, cval with
     | (Pattern _ pat), cval =>
       (match pat, cval with
        | CaseBase (none, _), _ => some ([] : List (sym × value))
        | CaseBase (some sym1, _), _ =>
          some [(sym1, cval)] /-      | Vobject of (generic_object_value 'sym) -/
        | CaseCtor Cspecified [pat'], Vloaded (LVspecified oval) =>
          (match_pattern_lemFuel lemFuel) pat' (Vobject oval)
        | CaseCtor Cunspecified [pat'], Vloaded (LVunspecified ty1) =>
          (match_pattern_lemFuel lemFuel) pat'
            (Vctype ty1) /-      | Vlist of core_base_type * list (generic_value 'sym) -/
        | CaseCtor Ctuple pats', Vtuple cvals' =>
          (/- FORK 2026-09-20 (cerberus-sl hidden-state note item 7; upstream-tray
           draft 45): fail CLOSED on a tuple-arity mismatch. Lem's List.zip
           TRUNCATES (library/list.lem:987-992, `| _ -> []` on unequal tails), so
           without this guard a pattern of arity 2 MATCHED a value of arity 3
           (binding the prefix) and a pattern of arity 3 matched a value of
           arity 2. Mirrors upstream's own guard in simpl_match_pattern
           (core_rewrite.lem:1287-1290). Nothing = NO MATCH, so select_case
           tries the next arm; the bindings and their order are unchanged. -/
          lem_if not ((List.length pats') == (List.length cvals')) then
            none
          else
            lemListFoldr
              (fun (p : (generic_pattern sym × value)) (acc : Option (List (sym × value))) =>
                match p, acc with
                | (pat', cval'), acc =>
                  Lem_Maybe.bind0 acc (fun (xs : List (sym × value)) =>
                    Lem_Maybe.bind0 ((match_pattern_lemFuel lemFuel) pat' cval')
                      (fun (x : List (sym × value)) => some (x ++ xs))))
              (some ([] : List (sym × value))) (lemListZip pats' cvals'))
        | CaseCtor (Cnil _) [], Vlist _ [] =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () => "Pattern matching nil without checking types!"))
            (fun _ => some ([] : List (sym × value)))))
        | CaseCtor Ccons [pat_x, pat_xs], Vlist ty1 (x :: xs) =>
          Lem_Maybe.bind0 ((match_pattern_lemFuel lemFuel) pat_x x) (fun (x : List (sym × value)) =>
            Lem_Maybe.bind0 ((match_pattern_lemFuel lemFuel) pat_xs (Vlist ty1 xs))
              (fun (xs : List (sym × value)) => some (x ++ xs)))
        | _, _ => none))

def match_pattern (g : generic_pattern sym) (cval : value) : Option (List (sym × value)) :=
  match_pattern_lemFuel (generic_pattern.lemSize g) g cval
theorem match_pattern_lemFuel_zero (g : generic_pattern sym) (cval : value) :
    match_pattern_lemFuel 0 g cval = (fuelExhausted none) :=
  rfl

/- FORK 2026-09-22 (upstream-tray draft 45; R2 of the pre-merge audit
   lean_frontend/docs/2026-09-21_enum-repairs-and-match-pattern-arity-audit.md):
   THE ONE loud leaf of the non-`maybe` tuple-BINDING helpers below —
   subst_pattern_val, unsafe_subst_pattern, update_env_aux — on a tuple-arity
   mismatch. Each binds a tuple pattern against a tuple by List.zip, which
   TRUNCATES (library/list.lem:987-992): a pattern of arity 2 against a tuple
   of arity 3 silently bound the prefix. The policy (closure rounds 1-2, audit
   R2): a mismatch is a malformed Core program (the Core typechecker is OFF by
   default) and every path reports it through ONE outcome kind — the let-forms
   of both engines (Core_run, Core_reduction) check match_pattern and raise
   Illformed_program exactly as the PElet route does; the `maybe`-returning
   subst_pattern DECLINES (Nothing) so the rewriter/to_pure leave the binding
   to the runtime; and these three helpers, whose live callers are all
   post-match, keep this loud backstop: OCaml Cerb_debug.error, Lean
   LemLib.failwithI — one reviewed row of scripts/failure_reach_register.txt. -/

def tuple_arity_error { a : Type } [Inhabited a] (who : String) (n_pats : Nat) (n_vals : Nat) : a :=
  (failwithI
    (String.append "Core_aux."
      (String.append who
        (String.append ": tuple pattern of arity "
          (String.append (Lem_String_extra.stringFromNat n_pats)
            (String.append " bound to a tuple of arity "
              (String.append (Lem_String_extra.stringFromNat n_vals)
                " (upstream-tray draft 45)")))))) : a)
def subst_pattern_val_lemFuel { a : Type } (lemFuel : Nat) (g : generic_pattern sym) (cval : value)
    (expr1 : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted expr1)
  | Nat.succ lemFuel =>
    (match g, cval, expr1 with
     | (Pattern _ pat), cval, expr1 =>
       (match pat, cval with
        | CaseBase (none, _), _ => /- e[_ \ v] = e -/ expr1
        | CaseBase (some sym1, _), _ => /- e[sym \ v] -/ subst_sym_expr sym1 cval expr1
        | CaseCtor (Cnil _) [], Vlist _ [] => /- empty list (value) -/ expr1
        | CaseCtor Ccons [pat1, pat2],
          Vlist bTy_elem (cval1 :: cvals) => /- populated list (value) -/
          (subst_pattern_val_lemFuel lemFuel) pat1 cval1
            ((subst_pattern_val_lemFuel lemFuel) pat2 (Vlist bTy_elem cvals) expr1)
        | CaseCtor Ctuple pats', Vtuple cvals =>
          (/- FORK 2026-09-22: arity guard (see tuple_arity_error above) -/ lem_if not
              ((List.length pats') == (List.length cvals)) then
            tuple_arity_error "subst_pattern_val" (List.length pats') (List.length cvals)
          else
            lemListFoldr
              (fun (p : (generic_pattern sym × value)) (acc : generic_expr a Unit sym) =>
                match p, acc with
                | (pat', cval'), acc => (subst_pattern_val_lemFuel lemFuel) pat' cval' acc) expr1
              (lemListZip pats' cvals))
        | CaseCtor Cspecified [pat'], Vloaded (LVspecified oval) =>
          (subst_pattern_val_lemFuel lemFuel) pat' (Vobject oval) expr1
        | CaseCtor Cunspecified [pat'], Vloaded (LVunspecified ty1) =>
          (subst_pattern_val_lemFuel lemFuel) pat' (Vctype ty1) expr1
        | CaseCtor ctor1 pats, _ =>
          (let str_ctor :=
             match ctor1 with
             | Cnil _ => "nil"
             | Ccons => "cons"
             | Ctuple => "tuple"
             | Carray => "array"
             | Civmax => "ivmax"
             | Civmin => "ivmin"
             | Civsizeof => "ivsizeof"
             | Civalignof => "ivalignof"
             | CivCOMPL => "ivCOMPL"
             | CivAND => "ivAND"
             | CivOR => "ivOR"
             | CivXOR => "ivXOR"
             | Cspecified => "specified"
             | Cunspecified => "unspecified"
             | Cfvconvert => "Cfvconvert"
             | CfvconvertLoaded => "CfvconvertLoaded"
             | CfvfromintTyped => "CfvfromintTyped"
             | CfvfromintTypedLoaded => "CfvfromintTypedLoaded"
             | Cfvneg => "Cfvneg"
             | Cfvfromint => "fvfromint"
             | Civfromfloat => "ivfromfloat"
             | CivNULLcap is_signed =>
               String.append "ivNULLcap("
                 (lem_if is_signed then "signed" else String.append "unsigned" ")");
           (failwithI
             (String.append "WIP: Core_aux.subst_pattern_val ==> ctor= "
               (String.append str_ctor
                 (String.append ", |pats|= "
                   (String.append (Lem_String_extra.stringFromNat (List.length pats))
                     (String.append " -- " (CerbPP.stringFromCore_value cval)))))) : generic_expr a
             Unit sym))))

def subst_pattern_val { a : Type } (g : generic_pattern sym) (cval : value)
    (expr1 : generic_expr a Unit sym) :
    expr a :=
  subst_pattern_val_lemFuel (generic_pattern.lemSize g) g cval expr1
theorem subst_pattern_val_lemFuel_zero { a : Type } (g : generic_pattern sym) (cval : value)
    (expr1 : generic_expr a Unit sym) :
    subst_pattern_val_lemFuel 0 g cval expr1 = (fuelExhausted expr1) :=
  rfl

/- substitute in an expression a symbolic name with a (pure) expression -/
/- NOTE: this is usually unsound to use if pe' doesn't evaluate to a defined value or generates memory constraints -/

def unsafe_subst_sym_pexpr_lemFuel (lemFuel : Nat) (sym1 : sym) (g : generic_pexpr Unit sym)
    (g0 : generic_pexpr Unit sym) :
    generic_pexpr Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g0)
  | Nat.succ lemFuel =>
    (match sym1, g, g0 with
     | sym1, pe'@(Pexpr annot1 bty pe_'), (Pexpr _ _ pe_) =>
       Pexpr annot1 bty
         (match pe_ with
          | PEsym sym' =>
            (lem_if (match sym1, sym' with
                     | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                       (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                         lem_if natGteb 0 5 && (sd1 != sd2) then
                           (lemSeq
                             (fun _ =>
                               CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                 match u with
                                 | () =>
                                   String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                     (String.append (show_symbol_description sd1)
                                       (String.append " <-> " (show_symbol_description sd2)))))
                             (fun _ => true))
                         else
                           true
                       else
                         false)) then
              pe_'
            else
              pe_)
          | PEimpl _ => pe_
          | PEval _ => pe_
          | PEconstrained xs =>
            PEconstrained
              (List.map
                (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                  match p with
                  | (constrs, pe) =>
                    (constrs, (unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)) xs)
          | PEundef _ _ => pe_
          | PEerror str pe => PEerror str ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEctor ctor1 pes =>
            PEctor ctor1 (List.map ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe') pes)
          | PEcase pe xs =>
            PEcase ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_pexpr Unit sym)) =>
                  match p with
                  | (pat, pe) =>
                    (pat,
                      (lem_if in_pattern sym1 pat then
                        pe
                      else
                        (unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe))) xs)
          | PEarray_shift pe1 ty1 pe2 =>
            PEarray_shift ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1) ty1
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
          | PEmember_shift pe tag_sym memb_ident =>
            PEmember_shift ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe) tag_sym memb_ident
          | PEmemop mop pes =>
            PEmemop mop (List.map ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe') pes)
          | PEnot pe => PEnot ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEop bop pe1 pe2 =>
            PEop bop ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
          | PEconv_int ty1 pe =>
            PEconv_int ty1 ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEwrapI ty1 iop1 pe1 pe2 =>
            PEwrapI ty1 iop1 ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
          | PEcatch_exceptional_condition ty1 iop1 pe1 pe2 =>
            PEcatch_exceptional_condition ty1 iop1
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
          | PEstruct tag_sym xs =>
            PEstruct tag_sym
              (List.map
                (fun (p : (identifier × generic_pexpr Unit sym)) =>
                  match p with
                  | (ident, pe) => (ident, (unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe))
                xs)
          | PEunion tag_sym ident pe =>
            PEunion tag_sym ident ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEcfunction pe => PEcfunction ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEmemberof tag_sym memb_ident pe =>
            PEmemberof tag_sym memb_ident ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEcall nm pes =>
            PEcall nm (List.map ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe') pes)
          | PElet pat pe1 pe2 =>
            PElet pat ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              (lem_if in_pattern sym1 pat then
                pe2
              else
                (unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
          | PEif pe1 pe2 pe3 =>
            PEif ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe3)
          | PEis_scalar pe => PEis_scalar ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEis_integer pe => PEis_integer ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEis_signed pe => PEis_signed ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEis_unsigned pe => PEis_unsigned ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEbmc_assume pe => PEbmc_assume ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe)
          | PEare_compatible pe1 pe2 =>
            PEare_compatible ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe1)
              ((unsafe_subst_sym_pexpr_lemFuel lemFuel) sym1 pe' pe2)))

def unsafe_subst_sym_pexpr (sym1 : sym) (g : generic_pexpr Unit sym) (g0 : generic_pexpr Unit sym) :
    pexpr :=
  unsafe_subst_sym_pexpr_lemFuel (generic_pexpr.lemSize g0) sym1 g g0
theorem unsafe_subst_sym_pexpr_lemFuel_zero (sym1 : sym) (g : generic_pexpr Unit sym)
    (g0 : generic_pexpr Unit sym) :
    unsafe_subst_sym_pexpr_lemFuel 0 sym1 g g0 = (fuelExhausted g0) :=
  rfl

/- NOTE: this is usually unsound to use if pe' doesn't evaluate to a defined value or generates memory constraints -/

def unsafe_subst_sym_action_ (a : sym) (pe' : generic_pexpr Unit sym) :
    generic_action_ Unit sym → generic_action_ Unit sym :=
  match a, pe' with
  | a, pe' =>
    (fun (x : generic_action_ Unit sym) =>
      match x with
      | Create pe1 pe2 pref =>
        Create (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) pref
      | CreateReadOnly pe1 pe2 pe3 pref =>
        CreateReadOnly (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) pref
      | Alloc0 pe1 pe2 pref =>
        Alloc0 (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) pref
      | Kill kind1 pe => Kill kind1 (unsafe_subst_sym_pexpr a pe' pe)
      | Store0 b pe1 pe2 pe3 mo1 =>
        Store0 b (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) mo1
      | Load0 pe1 pe2 mo1 =>
        Load0 (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) mo1
      | SeqRMW b pe1 pe2 sym' pe3 =>
        SeqRMW b (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) sym'
          (lem_if (match a, sym' with
                   | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                     (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                       lem_if natGteb 0 5 && (sd1 != sd2) then
                         (lemSeq
                           (fun _ =>
                             CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                               match u with
                               | () =>
                                 String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                   (String.append (show_symbol_description sd1)
                                     (String.append " <-> " (show_symbol_description sd2)))))
                           (fun _ => true))
                       else
                         true
                     else
                       false)) then
            pe3
          else
            unsafe_subst_sym_pexpr a pe' pe3)
      | RMW0 pe1 pe2 pe3 pe4 mo1 mo2 =>
        RMW0 (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) (unsafe_subst_sym_pexpr a pe' pe4) mo1 mo2
      | Fence0 mo1 => Fence0 mo1
      | CompareExchangeStrong pe1 pe2 pe3 pe4 mo1 mo2 =>
        CompareExchangeStrong (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) (unsafe_subst_sym_pexpr a pe' pe4) mo1 mo2
      | CompareExchangeWeak pe1 pe2 pe3 pe4 mo1 mo2 =>
        CompareExchangeWeak (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) (unsafe_subst_sym_pexpr a pe' pe4) mo1 mo2
      | LinuxFence mo1 => LinuxFence mo1
      | LinuxStore pe1 pe2 pe3 mo1 =>
        LinuxStore (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3) mo1
      | LinuxLoad pe1 pe2 mo1 =>
        LinuxLoad (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) mo1
      | LinuxRMW pe1 pe2 pe3 mo1 =>
        LinuxRMW (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2)
          (unsafe_subst_sym_pexpr a pe' pe3)
          mo1
          /-
  | CompareExchangeWeak pe1 pe2 pe3 pe4 mo1 mo2 ->
        CompareExchangeWeak (unsafe_subst_sym_pexpr a pe' pe1) (unsafe_subst_sym_pexpr a pe' pe2) (unsafe_subst_sym_pexpr a pe' pe3) (unsafe_subst_sym_pexpr a pe' pe4) mo1 mo2
-/
          )
def unsafe_subst_sym_action { a : Type } (a1 : sym) (pe' : generic_pexpr Unit sym)
    (g : generic_action a Unit sym) :
    generic_action a Unit sym :=
  match a1, pe', g with
  | a1, pe', (Action loc1 bs act_) => Action loc1 bs (unsafe_subst_sym_action_ a1 pe' act_)
def unsafe_subst_sym_paction { a : Type } (a1 : sym) (pe' : generic_pexpr Unit sym)
    (g : generic_paction a Unit sym) :
    generic_paction a Unit sym :=
  match a1, pe', g with
  | a1, pe', (Paction p act) => Paction p (unsafe_subst_sym_action a1 pe' act)
def unsafe_subst_sym_expr_lemFuel { a : Type } (lemFuel : Nat) (sym1 : sym)
    (pe' : generic_pexpr Unit sym) (g : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match sym1, pe', g with
     | sym1, pe', (Expr annot1 expr_) =>
       Expr annot1
         (match expr_ with
          | Epure pe => Epure (unsafe_subst_sym_pexpr sym1 pe' pe)
          | Ememop memop1 pes => Ememop memop1 (List.map (unsafe_subst_sym_pexpr sym1 pe') pes)
          | Elet pat pe1 e2 =>
            Elet pat (unsafe_subst_sym_pexpr sym1 pe' pe1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e2)
          | Eif pe1 e2 e3 =>
            Eif (unsafe_subst_sym_pexpr sym1 pe' pe1)
              ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e2)
              ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e3)
          | Ecase pe pat_es =>
            Ecase (unsafe_subst_sym_pexpr sym1 pe' pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
                  match p with
                  | (pat, e) =>
                    (pat,
                      (lem_if in_pattern sym1 pat then
                        e
                      else
                        (unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e))) pat_es)
          | Eccall annot1 pe1 pe2 pes =>
            Eccall annot1 (unsafe_subst_sym_pexpr sym1 pe' pe1)
              (unsafe_subst_sym_pexpr sym1 pe' pe2) (List.map (unsafe_subst_sym_pexpr sym1 pe') pes)
          | Eproc annot1 nm pes => Eproc annot1 nm (List.map (unsafe_subst_sym_pexpr sym1 pe') pes)
          | Eaction pact => Eaction (unsafe_subst_sym_paction sym1 pe' pact)
          | Eunseq es => Eunseq (List.map ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe') es)
          | Ewseq pat e1 e2 =>
            Ewseq pat ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e2)
          | Esseq pat e1 e2 =>
            Esseq pat ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e1)
              (lem_if in_pattern sym1 pat then
                e2
              else
                (unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e2)
          | Ebound e => Ebound ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e)
          | Esave lab_sym sym_bTy_pes e =>
            (let sym_bTy_pes' :=
               List.map
                 (fun (p :
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   match p with
                   | (z, (bTy, pe)) => (z, (bTy, unsafe_subst_sym_pexpr sym1 pe' pe))) sym_bTy_pes;
             lem_if List.any sym_bTy_pes
                 (fun (p :
                   (sym ×
                     ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                       Unit sym))) =>
                   match p with
                   | (z, _) =>
                     (match sym1, z with
                      | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                        (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                          lem_if natGteb 0 5 && (sd1 != sd2) then
                            (lemSeq
                              (fun _ =>
                                CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                  match u with
                                  | () =>
                                    String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                      (String.append (show_symbol_description sd1)
                                        (String.append " <-> " (show_symbol_description sd2)))))
                              (fun _ => true))
                          else
                            true
                        else
                          false))) then
               (lemSeq
                 (fun _ =>
                   CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                     match u with
                     | () => "unsafe_subst, Esave ==> shadowing"))
                 (fun _ => /- TODO: check -/ Esave lab_sym sym_bTy_pes' e))
             else
               Esave lab_sym sym_bTy_pes' ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e))
          | Erun annot1 lab_sym pes =>
            Erun annot1 lab_sym (List.map (unsafe_subst_sym_pexpr sym1 pe') pes)
          | End es => End (List.map ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe') es)
          | Epar es => Epar (List.map ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe') es)
          | Ewait _ => expr_
          | Eannot xs e => Eannot xs ((unsafe_subst_sym_expr_lemFuel lemFuel) sym1 pe' e)
          | Eexcluded n act =>
            Eexcluded n
              (unsafe_subst_sym_action sym1 pe' act)
              /-
    | Eloc loc e ->
        Eloc loc (unsafe_subst_sym_expr sym pe' e)
    | Estd s e ->
        Estd s (unsafe_subst_sym_expr sym pe' e)
-/
              ))

def unsafe_subst_sym_expr { a : Type } (sym1 : sym) (pe' : generic_pexpr Unit sym)
    (g : generic_expr a Unit sym) :
    expr a :=
  unsafe_subst_sym_expr_lemFuel (generic_expr.lemSize g) sym1 pe' g
theorem unsafe_subst_sym_expr_lemFuel_zero { a : Type } (sym1 : sym) (pe' : generic_pexpr Unit sym)
    (g : generic_expr a Unit sym) :
    unsafe_subst_sym_expr_lemFuel 0 sym1 pe' g = (fuelExhausted g) :=
  rfl

/- TODO: [unsafe_subst_pattern _as v e] substitute the symbols _as with the corresponding
   of the value expression [v] in the expression [e]. This function leads
   to a crash if [v] is not a value or its type doesn't match the symbolic
   pattern -/
/- NOTE: this is usually unsound to use if pe' doesn't evaluate to a defined value or generates memory constraints -/

def unsafe_subst_pattern_lemFuel { a : Type } (lemFuel : Nat) (g : generic_pattern sym)
    (pe' : generic_pexpr Unit sym) (expr1 : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted expr1)
  | Nat.succ lemFuel =>
    (match g, pe', expr1 with
     | (Pattern _ pat), pe', expr1 =>
       (match pat, pe' with
        | CaseBase (none, _), _ => expr1
        | CaseBase (some sym1, _), _ => unsafe_subst_sym_expr sym1 pe' expr1
        | CaseCtor (Cnil _) [], Pexpr _ _ (PEval (Vlist _ [])) => /- empty list (value) -/ expr1
        | CaseCtor (Cnil _) [], Pexpr _ _ (PEctor (Cnil _) []) => /- empty list (pure expr) -/ expr1
        | CaseCtor Ccons [pat1, pat2],
          Pexpr _ () (PEval (Vlist bTy_elem (cval :: cvals))) => /- populated list (value) -/
          subst_pattern_val pat1 cval (subst_pattern_val pat2 (Vlist bTy_elem cvals) expr1)
        | CaseCtor Ccons [pat1, pat2],
          Pexpr _ _ (PEctor Ccons [pe1, pe2]) => /- populated list (pure expr) -/
          (unsafe_subst_pattern_lemFuel lemFuel) pat1 pe1
            ((unsafe_subst_pattern_lemFuel lemFuel) pat2 pe2 expr1)
        | CaseCtor Ctuple pats', Pexpr _ () (PEval (Vtuple cvals)) =>
          (/- FORK 2026-09-22: arity guards (see tuple_arity_error) -/ lem_if not
              ((List.length pats') == (List.length cvals)) then
            tuple_arity_error "unsafe_subst_pattern" (List.length pats') (List.length cvals)
          else
            lemListFoldr
              (fun (p : (generic_pattern sym × value)) (acc : generic_expr a Unit sym) =>
                match p, acc with
                | (pat', cval), acc => subst_pattern_val pat' cval acc) expr1
              (lemListZip pats' cvals))
        | CaseCtor Ctuple pats', Pexpr _ _ (PEctor Ctuple pes) =>
          (lem_if not ((List.length pats') == (List.length pes)) then
            tuple_arity_error "unsafe_subst_pattern" (List.length pats') (List.length pes)
          else
            lemListFoldr
              (fun (p : (generic_pattern sym × generic_pexpr Unit sym))
                (acc : generic_expr a Unit sym) =>
                match p, acc with
                | (pat', pe), acc => (unsafe_subst_pattern_lemFuel lemFuel) pat' pe acc) expr1
              (lemListZip pats'
                pes)) /- TODO (maybe), Carray, Civmax, Civmin, Civsizeof, Civalignof -/
        | CaseCtor Cspecified [pat'], Pexpr _ () (PEval (Vloaded (LVspecified oval))) =>
          subst_pattern_val pat' (Vobject oval) expr1
        | CaseCtor Cspecified [pat'], Pexpr _ () (PEctor Cspecified [pe'']) =>
          (unsafe_subst_pattern_lemFuel lemFuel) pat' pe'' expr1
        | CaseCtor Cunspecified [pat'], Pexpr _ () (PEval (Vloaded (LVunspecified ty1))) =>
          subst_pattern_val pat' (Vctype ty1) expr1
        | CaseCtor Cunspecified [pat'], Pexpr _ () (PEctor Cunspecified [pe'']) =>
          (unsafe_subst_pattern_lemFuel lemFuel) pat' pe'' expr1
        | CaseCtor ctor1 pats, _ =>
          (let str_ctor :=
             match ctor1 with
             | Cnil _ => "nil"
             | Ccons => "cons"
             | Ctuple => "tuple"
             | Carray => "array"
             | Civmax => "ivmax"
             | Civmin => "ivmin"
             | Civsizeof => "ivsizeof"
             | Civalignof => "ivalignof"
             | CivCOMPL => "ivCOMPL"
             | CivAND => "ivAND"
             | CivOR => "ivOR"
             | CivXOR => "ivXOR"
             | Cspecified => "specified"
             | Cunspecified => "unspecified"
             | Cfvconvert => "Cfvconvert"
             | CfvconvertLoaded => "CfvconvertLoaded"
             | CfvfromintTyped => "CfvfromintTyped"
             | CfvfromintTypedLoaded => "CfvfromintTypedLoaded"
             | Cfvneg => "Cfvneg"
             | Cfvfromint => "fvfromint"
             | Civfromfloat => "ivfromfloat"
             | CivNULLcap is_signed =>
               String.append "ivNULLcap("
                 (lem_if is_signed then "signed" else String.append "unsigned" ")");
           (failwithI
             (String.append "WIP: Core_aux.unsafe_subst_pattern ==> ctor= "
               (String.append str_ctor
                 (String.append ", |pats|= "
                   (String.append (Lem_String_extra.stringFromNat (List.length pats))
                     (String.append " -- " (CerbPP.stringFromCore_pexpr pe')))))) : generic_expr a
             Unit sym))))

def unsafe_subst_pattern { a : Type } (g : generic_pattern sym) (pe' : generic_pexpr Unit sym)
    (expr1 : generic_expr a Unit sym) :
    expr a :=
  unsafe_subst_pattern_lemFuel (generic_pattern.lemSize g) g pe' expr1
theorem unsafe_subst_pattern_lemFuel_zero { a : Type } (g : generic_pattern sym)
    (pe' : generic_pexpr Unit sym) (expr1 : generic_expr a Unit sym) :
    unsafe_subst_pattern_lemFuel 0 g pe' expr1 = (fuelExhausted expr1) :=
  rfl

def subst_pattern_lemFuel { a : Type } (lemFuel : Nat) (g : generic_pattern sym)
    (pe' : generic_pexpr Unit sym) (expr1 : generic_expr a Unit sym) :
    Option (generic_expr a Unit sym) :=
  match lemFuel with
  | 0 => (fuelExhausted none)
  | Nat.succ lemFuel =>
    (match g, pe', expr1 with
     | (Pattern _ pat), pe', expr1 =>
       (match pat, pe' with
        | CaseBase (none, _), _ => some expr1
        | CaseBase (some sym1, _), _ => some (unsafe_subst_sym_expr sym1 pe' expr1)
        | CaseCtor (Cnil _) [], Pexpr _ _ (PEval (Vlist _ [])) => /- empty list (value) -/
          some expr1
        | CaseCtor (Cnil _) [], Pexpr _ _ (PEctor (Cnil _) []) => /- empty list (pure expr) -/
          some expr1
        | CaseCtor Ccons [pat1, pat2], Pexpr _ () (PEval (Vlist bTy_elem (cval :: cvals))) =>
          (/- populated list (value) -/
          /- FORK 2026-09-22 (closure round 2, audit R2 ruling): DECLINE (Nothing) unless the
           whole pattern FITS the value — the same predicate as the let-forms and
           select_case — so a tuple-arity mismatch anywhere inside is left to the
           runtime's Illformed_program route, never to subst_pattern_val's loud leaf.
           (match_pattern's Cnil arm Debug.warn is silent below debug level 2.) -/
          match match_pattern (Pattern ([] : List annot) (CaseCtor Ccons [pat1, pat2]))
              (Vlist bTy_elem (cval :: cvals)) with
          | none => none
          | some _ =>
            some
              (subst_pattern_val pat1 cval (subst_pattern_val pat2 (Vlist bTy_elem cvals) expr1)))
        | CaseCtor Ccons [pat1, pat2], Pexpr _ _ (PEctor Ccons [pe1, pe2]) =>
          (/- populated list (pure expr) -/
          match (subst_pattern_lemFuel lemFuel) pat2 pe2 expr1 with
          | some e => (subst_pattern_lemFuel lemFuel) pat1 pe1 e
          | none => none)
        | CaseCtor Ctuple pats', Pexpr _ () (PEval (Vtuple cvals)) =>
          (/- FORK 2026-09-22 (closure round 2, audit R2 ruling): DECLINE (Nothing) unless the
           whole tuple pattern FITS the tuple value (match_pattern: equal arity here and
           in every nested tuple) — see the Ccons arm above. -/
          match match_pattern (Pattern ([] : List annot) (CaseCtor Ctuple pats'))
              (Vtuple cvals) with
          | none => none
          | some _ =>
            some
              (lemListFoldr
                (fun (p : (generic_pattern sym × value)) (acc : generic_expr a Unit sym) =>
                  match p, acc with
                  | (pat', cval), acc => subst_pattern_val pat' cval acc) expr1
                (lemListZip pats' cvals)))
        | CaseCtor Ctuple pats', Pexpr _ _ (PEctor Ctuple pes) =>
          (/- FORK 2026-09-22 (closure round 2): DECLINE (Nothing) on unequal arity; nested
           mismatches decline through the recursive subst_pattern calls below. -/
          lem_if not ((List.length pats') == (List.length pes)) then
            none
          else
            lemListFoldr
              (fun (p : (generic_pattern sym × generic_pexpr Unit sym))
                (acc : Option (generic_expr a Unit sym)) =>
                match p, acc with
                | (pat', pe), acc =>
                  (match acc with
                   | some e => (subst_pattern_lemFuel lemFuel) pat' pe e
                   | none => none)) (some expr1)
              (lemListZip pats'
                pes)) /- TODO (maybe), Carray, Civmax, Civmin, Civsizeof, Civalignof -/
        | CaseCtor Cspecified [pat'], Pexpr _ () (PEval (Vloaded (LVspecified oval))) =>
          some (subst_pattern_val pat' (Vobject oval) expr1)
        | CaseCtor Cspecified [pat'], Pexpr _ () (PEctor Cspecified [pe'']) =>
          (subst_pattern_lemFuel lemFuel) pat' pe'' expr1
        | CaseCtor Cunspecified [pat'], Pexpr _ () (PEval (Vloaded (LVunspecified ty1))) =>
          some (subst_pattern_val pat' (Vctype ty1) expr1)
        | CaseCtor Cunspecified [pat'], Pexpr _ () (PEctor Cunspecified [pe'']) =>
          (subst_pattern_lemFuel lemFuel) pat' pe'' expr1
        | CaseCtor ctor1 pats, _ => none))

def subst_pattern { a : Type } (g : generic_pattern sym) (pe' : generic_pexpr Unit sym)
    (expr1 : generic_expr a Unit sym) :
    Option (expr a) :=
  subst_pattern_lemFuel (generic_pattern.lemSize g) g pe' expr1
theorem subst_pattern_lemFuel_zero { a : Type } (g : generic_pattern sym)
    (pe' : generic_pexpr Unit sym) (expr1 : generic_expr a Unit sym) :
    subst_pattern_lemFuel 0 g pe' expr1 = (fuelExhausted none) :=
  rfl

mutual
def to_pure_lemFuel { a : Type } (lemFuel : Nat) (g : generic_expr a Unit sym) :
    Option (generic_pexpr Unit sym) :=
  match lemFuel with
  | 0 => (fuelExhausted none)
  | Nat.succ lemFuel =>
    (match g with
     | (Expr annot1 expr_) =>
       (let to_pure_aux : generic_pattern sym → generic_pexpr Unit sym → generic_expr a Unit sym →
          Option (generic_pexpr Unit sym) :=
          (fun (pat : generic_pattern sym) (pe1 : generic_pexpr Unit sym)
            (e2 : generic_expr a Unit sym) =>
            match subst_pattern pat pe1 e2 with
            | some e => (to_pure_lemFuel lemFuel) e
            | none =>
              (match (to_pure_lemFuel lemFuel) e2 with
               | none => none
               | some pe2 => some (Pexpr ([] : List annot) () (PElet pat pe1 pe2))));
        match expr_ with
        | Epure pe => some pe
        | Ememop _ _ => none
        | Elet pat pe1 e2 =>
          (match (to_pure_lemFuel lemFuel) e2 with
           | some (pe2@(Pexpr annot1 bTy _)) => some (Pexpr annot1 bTy (PElet pat pe1 pe2))
           | _ => none)
        | Eif pe1 e2 e3 =>
          (match (to_pure_lemFuel lemFuel) e2, (to_pure_lemFuel lemFuel) e3 with
           | some (pe2@(Pexpr annot1 bTy _)), some pe3 => some (Pexpr annot1 bTy (PEif pe1 pe2 pe3))
           | _, _ => none)
        | Eccall _ _ _ _ => none
        | Eproc _ _ _ => none
        | Eaction _ => none
        | Eunseq es =>
          (match (to_pures_lemFuel lemFuel) es with
           | some pes => some (Pexpr ([] : List annot) () (PEctor Ctuple pes))
           | none => none)
        | Ewseq pat e1 e2 =>
          (match (to_pure_lemFuel lemFuel) e1 with
           | some pe1 => to_pure_aux pat pe1 e2
           | none => none)
        | Esseq pat e1 e2 =>
          (match (to_pure_lemFuel lemFuel) e1 with
           | some pe1 => to_pure_aux pat pe1 e2
           | none => none)
        | Ebound e => /- TODO: check -/ (to_pure_lemFuel lemFuel) e
        | Esave _ _ _ => none
        | Erun _ _ _ => none
        | End _ => none
        | Epar _ => none
        | Ewait _ => none
        | Eannot _ _ => (failwithI "to_pure Eannot" : Option (generic_pexpr Unit sym))
        | Eexcluded _ _ => (failwithI "to_pure Eexcluded" : Option (generic_pexpr Unit sym))
        /-
    | Eloc _ e ->
        to_pure e
    | Estd _ e ->
        to_pure e
-/
        | Ecase pe pat_es =>
          (match lemListUnzip pat_es with
           | (pats, es) =>
             (match (to_pures_lemFuel lemFuel) es with
              | some (pes@((Pexpr annot1 bTy _ :: _))) =>
                some (Pexpr annot1 bTy (PEcase pe (lemListZip pats pes)))
              | _ => none))))
def to_pures_lemFuel { a : Type } (lemFuel : Nat) (l : List (expr a)) :
    Option (List (generic_pexpr Unit sym)) :=
  match lemFuel with
  | 0 => (fuelExhausted none)
  | Nat.succ lemFuel =>
    (match l with
     | (es : List (expr a)) =>
       lemListFoldr
         (fun (e : generic_expr a Unit sym) (acc_opt : Option (List (generic_pexpr Unit sym))) =>
           match (to_pure_lemFuel lemFuel) e, acc_opt with
           | some pe, some acc => some (pe :: acc)
           | _, _ => none) (some ([] : List (generic_pexpr Unit sym))) es)
end

def to_pure { a : Type } (g : generic_expr a Unit sym) : Option pexpr :=
  to_pure_lemFuel (generic_expr.lemSize g) g
theorem to_pure_lemFuel_zero { a : Type } (g : generic_expr a Unit sym) :
    to_pure_lemFuel 0 g = (fuelExhausted none) :=
  rfl

def to_pures { a : Type } (l : List (expr a)) : Option (List (generic_pexpr Unit sym)) :=
  to_pures_lemFuel (List.length l + 1) l
theorem to_pures_lemFuel_zero { a : Type } (l : List (expr a)) :
    to_pures_lemFuel 0 l = (fuelExhausted none) :=
  rfl

def subst_wait_lemFuel { a : Type } (lemFuel : Nat) (tid1 : Nat) (v : value)
    (g : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match tid1, v, g with
     | tid1, v, (Expr annot1 expr_) =>
       Expr annot1
         (match expr_ with
          | Epure _ => expr_
          | Ememop _ _ => expr_
          | Elet sym1 pe1 e2 => Elet sym1 pe1 ((subst_wait_lemFuel lemFuel) tid1 v e2)
          | Eif pe1 e2 e3 =>
            Eif pe1 ((subst_wait_lemFuel lemFuel) tid1 v e2)
              ((subst_wait_lemFuel lemFuel) tid1 v e3)
          | Ecase pe pat_es =>
            Ecase pe
              (List.map
                (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
                  match p with
                  | (pat, e) => (pat, (subst_wait_lemFuel lemFuel) tid1 v e)) pat_es)
          | Eccall _ _ _ _ => expr_
          | Eproc _ _ _ => expr_
          | Eaction _ => expr_
          | Eunseq es => Eunseq (List.map ((subst_wait_lemFuel lemFuel) tid1 v) es)
          | Ewseq _as e1 e2 =>
            Ewseq _as ((subst_wait_lemFuel lemFuel) tid1 v e1)
              ((subst_wait_lemFuel lemFuel) tid1 v e2)
          | Esseq _as e1 e2 =>
            Esseq _as ((subst_wait_lemFuel lemFuel) tid1 v e1)
              ((subst_wait_lemFuel lemFuel) tid1 v e2)
          | Ebound e => Ebound ((subst_wait_lemFuel lemFuel) tid1 v e)
          /-
   | Esave ksym sym_tys e ->
       Esave ksym sym_tys (subst_wait tid v e)
   | (Erun _ _ _ as expr) ->
       expr
-/
          | Esave sym1 sym_bTys e => Esave sym1 sym_bTys ((subst_wait_lemFuel lemFuel) tid1 v e)
          | Erun _ _ _ => expr_
          | End es => End (List.map ((subst_wait_lemFuel lemFuel) tid1 v) es)
          | Epar es => Epar (List.map ((subst_wait_lemFuel lemFuel) tid1 v) es)
          | Ewait tid' =>
            (lem_if tid1 == tid' then
              match v with
              | Vunit => Epure (Pexpr ([] : List annot) () (PEval Vunit))
              | _ => Epure (Pexpr ([] : List annot) () (PEval v))
            else
              Ewait tid')
          | Eannot xs e => Eannot xs ((subst_wait_lemFuel lemFuel) tid1 v e)
          | Eexcluded _ _ =>
            expr_
            /-
   | Eloc loc e ->
       Eloc loc (subst_wait tid v e)
   | Estd s e ->
       Estd s (subst_wait tid v e)
-/
            ))

def subst_wait { a : Type } (tid1 : Nat) (v : value) (g : generic_expr a Unit sym) : expr a :=
  subst_wait_lemFuel (generic_expr.lemSize g) tid1 v g
theorem subst_wait_lemFuel_zero { a : Type } (tid1 : Nat) (v : value)
    (g : generic_expr a Unit sym) :
    subst_wait_lemFuel 0 tid1 v g = (fuelExhausted g) :=
  rfl

def find_labeled_continuation_lemFuel { a b c : Type } [Eq0 a] (lemFuel : Nat) (sym1 : a)
    (g : generic_expr c b a) :
    Option (List a × generic_expr c b a) :=
  match lemFuel with
  | 0 => (fuelExhausted none)
  | Nat.succ lemFuel =>
    (match sym1, g with
     | sym1, (Expr annot1 expr_) =>
       (match expr_ with
        | Epure _ => none
        | Ememop _ _ => none
        | Eaction _ => none
        | Ecase _ pat_es =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation assumes there is atmost single match inside a Ecase"))
            (fun _ =>
              List.foldl
                (fun (acc : Option (List a × generic_expr c b a))
                  (p : (generic_pattern a × generic_expr c b a)) =>
                  match acc, p with
                  | acc, (_, e) =>
                    (match acc with
                     | some _ => acc
                     | none =>
                       (match (find_labeled_continuation_lemFuel lemFuel) sym1 e with
                        | none => none
                        | some ret => some ret))) none pat_es)))
        | Elet _ _ e2 => (find_labeled_continuation_lemFuel lemFuel) sym1 e2
        | Eif _ e2 e3 =>
          (/- NOTE: in a well formed Core expr, [sym] cannot be bound in both e2 and e3. -/
          match (find_labeled_continuation_lemFuel lemFuel) sym1 e2 with
          | some z => some z
          | none => (find_labeled_continuation_lemFuel lemFuel) sym1 e3)
        | Eccall _ _ _ _ => none
        | Eproc _ _ _ => none
        | Eunseq _ => /- NOTE: Typing forbids labeled continuation bindings inside unseq() -/ none
        | Ewseq pat e1 e2 =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation assumes the bindings of an Esave inside a Ewseq don't clash"))
            (fun _ =>
              match (find_labeled_continuation_lemFuel lemFuel) sym1 e1 with
              | some (syms, cont_expr) => some (syms, Expr annot1 (Ewseq pat cont_expr e2))
              | none => (find_labeled_continuation_lemFuel lemFuel) sym1 e2)))
        | Esseq pat e1 e2 =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation assumes the bindings of an Esave inside a Esseq don't clash"))
            (fun _ =>
              match (find_labeled_continuation_lemFuel lemFuel) sym1 e1 with
              | some (syms, cont_expr) => some (syms, Expr annot1 (Esseq pat cont_expr e2))
              | none => (find_labeled_continuation_lemFuel lemFuel) sym1 e2)))
        | Ebound _ => /- NOTE: Typing forbids labeled continuation bindings inside bound() -/ none
        | End _ => /- NOTE: Typing forbids labeled continuation bindings in inside nd() -/ none
        | Esave (sym', _) sym_bTys e =>
          (lem_if sym1 == sym' then
            some (List.map Prod.fst sym_bTys, e)
          else
            (find_labeled_continuation_lemFuel lemFuel) sym1 e)
        | Erun annot1 sym1 pes => none
        | Epar es =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation assumes there are no Esave inside par()"))
            (fun _ => none)))
        | Ewait _ => none
        | Eannot _ _ =>
          /- NOTE: Eannot only appear at runtime, and inside an Ebound, where
                 typing forbids labeled continuation bindings. -/
          none
        | Eexcluded _ _ =>
          /- NOTE: Eexcluded only appear at runtime, and inside an Eexcluded, where
                 typing forbids labeled continuation bindings. -/
          none
          /-
    | Eloc _ e ->
        find_labeled_continuation sym e
    | Estd _ e ->
        find_labeled_continuation sym e
-/
          ))

def find_labeled_continuation { a b c : Type } [Eq0 a] (sym1 : a) (g : generic_expr c b a) :
    Option (List a × generic_expr c b a) :=
  find_labeled_continuation_lemFuel (generic_expr.lemSize g) sym1 g
theorem find_labeled_continuation_lemFuel_zero { a b c : Type } [Eq0 a] (sym1 : a)
    (g : generic_expr c b a) :
    find_labeled_continuation_lemFuel 0 sym1 g = (fuelExhausted none) :=
  rfl
/-  maybe ((list Symbol.sym * expr 'a) * map Symbol.sym (list Symbol.sym * expr 'a)) -/

def find_labeled_continuation2_aux_lemFuel { a : Type } (lemFuel : Nat)
    (acc : Fmap sym (List sym × generic_expr a Unit sym)) (sym1 : sym)
    (g : generic_expr a Unit sym) :
    Fmap sym (List sym × generic_expr a Unit sym) :=
  match lemFuel with
  | 0 => (fuelExhausted acc)
  | Nat.succ lemFuel =>
    (match acc, sym1, g with
     | acc, sym1, (Expr annot1 expr_) =>
       (match expr_ with
        | Epure _ => acc
        | Ememop _ _ => acc
        | Eaction _ => acc
        | Ecase _ pat_es =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation2_aux assumes there is atmost single match inside a Ecase"))
            (fun _ =>
              List.foldl
                (fun (acc' : Fmap sym (List sym × generic_expr a Unit sym))
                  (p : (generic_pattern sym × generic_expr a Unit sym)) =>
                  match acc', p with
                  | acc', (_, e) => (find_labeled_continuation2_aux_lemFuel lemFuel) acc' sym1 e)
                acc pat_es)))
        | Elet _ _ e2 => (find_labeled_continuation2_aux_lemFuel lemFuel) acc sym1 e2
        | Eif _ e2 e3 =>
          (let acc' :=(find_labeled_continuation2_aux_lemFuel lemFuel) acc sym1 e2;
           (find_labeled_continuation2_aux_lemFuel lemFuel) acc' sym1 e3)
        | Eccall _ _ _ _ => acc
        | Eproc _ _ _ => acc
        | Eunseq _ => /- NOTE: Typing forbids labeled continuation bindings inside unseq() -/ acc
        | Ewseq pat e1 e2 =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation2_aux assumes the bindings of an Esave inside a Ewseq don't clash"))
            (fun _ =>
              let acc' :=
                fmapMap
                  (fun (p : (List sym × generic_expr a Unit sym)) =>
                    match p with
                    | (syms, z) => (syms, Expr annot1 (Ewseq pat z e2)))
                  ((find_labeled_continuation2_aux_lemFuel lemFuel) fmapEmpty sym1 e1);
              (find_labeled_continuation2_aux_lemFuel lemFuel)
                (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) acc acc') sym1
                e2)))
        | Esseq pat e1 e2 =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation2_aux assumes the bindings of an Esave inside a Esseq don't clash"))
            (fun _ =>
              let acc' :=
                fmapMap
                  (fun (p : (List sym × generic_expr a Unit sym)) =>
                    match p with
                    | (syms, z) => (syms, Expr annot1 (Esseq pat z e2)))
                  ((find_labeled_continuation2_aux_lemFuel lemFuel) fmapEmpty sym1 e1);
              (find_labeled_continuation2_aux_lemFuel lemFuel)
                (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) acc acc') sym1
                e2)))
        | Ebound _ => /- NOTE: Typing forbids labeled continuation bindings inside bound() -/ acc
        | End _ => /- NOTE: Typing forbids labeled continuation bindings in inside nd() -/ acc
        | Esave (sym', _) sym_bTys e =>
          (lem_if (match sym1, sym' with
                   | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                     (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                       lem_if natGteb 0 5 && (sd1 != sd2) then
                         (lemSeq
                           (fun _ =>
                             CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                               match u with
                               | () =>
                                 String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                   (String.append (show_symbol_description sd1)
                                     (String.append " <-> " (show_symbol_description sd2)))))
                           (fun _ => true))
                       else
                         true
                     else
                       false)) then
            (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
              (List.map Prod.fst sym_bTys, e) acc)
          else
            (find_labeled_continuation2_aux_lemFuel lemFuel)
              ((fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym'
                (List.map Prod.fst sym_bTys, e) acc)) sym1 e)
        | Erun annot1 sym1 pes => acc
        | Epar es =>
          ((lemSeq
            (fun _ =>
              CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
                match u with
                | () =>
                  "Core_aux.find_labeled_continuation2_aux assumes there are no Esave inside par()"))
            (fun _ => acc)))
        | Ewait _ => acc
        | Eannot _ _ => /- NOTE: Typing forbids labeled continuation bindings inside annot() -/ acc
        | Eexcluded _
          _ => /- NOTE: Typing forbids labeled continuation bindings inside excluded() -/
          acc
          /-
    | Eloc _ e ->
        find_labeled_continuation2_aux acc sym e
    | Estd _ e ->
        find_labeled_continuation2_aux acc sym e
-/
          ))

def find_labeled_continuation2_aux { a : Type }
    (acc : Fmap sym (List sym × generic_expr a Unit sym)) (sym1 : sym)
    (g : generic_expr a Unit sym) :
    Fmap sym (List sym × expr a) :=
  find_labeled_continuation2_aux_lemFuel (generic_expr.lemSize g) acc sym1 g
theorem find_labeled_continuation2_aux_lemFuel_zero { a : Type }
    (acc : Fmap sym (List sym × generic_expr a Unit sym)) (sym1 : sym)
    (g : generic_expr a Unit sym) :
    find_labeled_continuation2_aux_lemFuel 0 acc sym1 g = (fuelExhausted acc) :=
  rfl

def find_labeled_continuation2 { a : Type } (sym1 : sym) (e : generic_expr a Unit sym) :
    Option ((List sym × expr a) × Fmap sym (List sym × expr a)) :=
  let lconts := find_labeled_continuation2_aux fmapEmpty sym1 e;
  match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1 lconts) with
  | some cont => some (cont, lconts)
  | none => none

def unsafe_subst_sym_fun_map { a : Type } (sym1 : sym) (pe' : generic_pexpr Unit sym)
    (funs1 : Fmap sym (generic_fun_map_decl Unit a)) :
    Fmap sym (generic_fun_map_decl Unit a) :=
  fmapMap
    (fun (x : generic_fun_map_decl Unit a) =>
      match x with
      | Fun bTy params pe => Fun bTy params (unsafe_subst_sym_pexpr sym1 pe' pe)
      | ProcDecl loc1 bTy params => ProcDecl loc1 bTy params
      | BuiltinDecl loc1 bTy params => BuiltinDecl loc1 bTy params
      | Proc loc1 mrk bTy params e => Proc loc1 mrk bTy params (unsafe_subst_sym_expr sym1 pe' e))
    funs1 /- * core_base_type -/

def collect_labeled_continuations { a : Type } (g : generic_expr a Unit sym) :
    Fmap sym (List sym × generic_expr a Unit sym) :=
  match g with
  | (Expr annot1 expr_) =>
    (match expr_ with
     | Epure _ => fmapEmpty
     | Ememop _ _ => fmapEmpty
     | Elet _ _ e2 => collect_labeled_continuations e2
     | Eif pe1 e2 e3 =>
       fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
         (collect_labeled_continuations e2) (collect_labeled_continuations e3)
     | Ecase pe pat_es => fmapEmpty /- TODO THIS IS WRONG!!!!! -/
     | Eproc _ _ _ => fmapEmpty
     | Eccall _ _ _ _ => fmapEmpty
     | Eaction _ => fmapEmpty
     | Eunseq _ => fmapEmpty
     | Ewseq _as e1 e2 =>
       fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
         (fmapMap
           (fun (p : (List sym × generic_expr a Unit sym)) =>
             match p with
             | (a_tys, e) => (a_tys, Expr annot1 (Ewseq _as e e2)))
           (collect_labeled_continuations e1)) (collect_labeled_continuations e2)
     | Esseq _as e1 e2 =>
       fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
         (fmapMap
           (fun (p : (List sym × generic_expr a Unit sym)) =>
             match p with
             | (a_tys, e) => (a_tys, Expr annot1 (Esseq _as e e2)))
           (collect_labeled_continuations e1)) (collect_labeled_continuations e2)
     | Ebound _ => fmapEmpty
     | Esave (sym_lab, _) sym_bTys e =>
       (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym_lab
         (List.map Prod.fst sym_bTys, e) (collect_labeled_continuations e))
     | Erun _ _ _ => fmapEmpty
     | End _ => /- TODO: check -/ fmapEmpty
     | Epar _ => /- TODO: check -/ fmapEmpty
     | Ewait _ => fmapEmpty
     | Eannot _ _ => fmapEmpty
     | Eexcluded _ _ =>
       fmapEmpty
       /-
    | Eloc loc e ->
        collect_labeled_continuations e
    | Estd _ e ->
        collect_labeled_continuations e
-/
       )
def is_unseq_with_negative { a : Type } : generic_expr a Unit sym → Bool :=
  fun (x : generic_expr a Unit sym) =>
    match x with
    | Expr _ (Eunseq es) => List.any es is_negative
    | _ => false

/-
val     has_sseqs: forall 'a. expr 'a -> bool
let rec has_sseqs expr =
  match expr with
    | Epure _ ->
        false
    | Ememop _ _ ->
        false
    | Eaction p ->
        false
    | Ecase _ pat_es ->
        List.any (fun (_, e) -> has_sseqs e) pat_es
    | Elet _ _ e2 ->
        has_sseqs e2
    | Eif _ e2 e3 ->
        has_sseqs e2 || has_sseqs e3
    | Eskip ->
        false
    | Eccall _ _ _ ->
        /- TODO: look into the called body -/
        false
    | Eproc _ _ _ ->
        /- TODO: look into the called body -/
        false
    | Eunseq es ->
        List.any has_sseqs es
    | Ewseq _ e1 e2 ->
        has_sseqs e1 || has_sseqs e2
    | Esseq _ _ _ ->
        true
    | Ebound e ->
        has_sseqs e
    | Esave _ _ e ->
        has_sseqs e
    | Erun _ _ _ ->
        false
    | End es ->
        List.any has_sseqs es
    | Epar _ ->
        /- TODO: I think -/
        false
    | Ewait _ ->
        false
    | Eloc _ e ->
        has_sseqs e
  end
-/

def select_case { a : Type } (subst_sym : sym → value → a → a) (cval : value) :
    List (generic_pattern sym × a) → Option a :=
  fun (x : List (generic_pattern sym × a)) =>
    match x with
    | [] => none
    | (pat, pe) :: pat_pes' =>
      (match match_pattern pat cval with
       | none => /- trying the next branch -/ select_case subst_sym cval pat_pes'
       | some sym_cvals =>
         some
           (lemListFoldr
             (fun (p : (sym × value)) (acc : a) =>
               match p, acc with
               | (sym1, cval'), acc => subst_sym sym1 cval' acc) pe sym_cvals))

/-
val isConstrainedValue: value -> bool
let isConstrainedValue cval =
  match flatten_constrained_value cval with
    | Vconstrained _ ->
        true
    | _ ->
        false
  end
-/

def mk_pure_e { a : Type } (pe : generic_pexpr Unit sym) : generic_expr a Unit sym :=
  Expr ([] : List annot) (Epure pe)
def mk_value_e { a : Type } (cval : value) : generic_expr a Unit sym := mk_pure_e (mk_value_pe cval)
def mk_skip_e : generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Epure (Pexpr ([] : List annot) () (PEval Vunit)))
def mk_unseq_e { a : Type } (es : List (generic_expr a Unit sym)) : generic_expr a Unit sym :=
  Expr ([] : List annot) (Eunseq es)
def mk_case_e (pe : generic_pexpr Unit sym)
    (pat_es : List (generic_pattern sym × generic_expr Unit Unit sym)) :
    generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Ecase pe pat_es)
def mk_wseq_e { a : Type } (pat : generic_pattern sym) (e1 : generic_expr a Unit sym)
    (e2 : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  Expr ([] : List annot) (Ewseq pat e1 e2)
def mk_sseq_e { a : Type } (pat : generic_pattern sym) (e1 : generic_expr a Unit sym)
    (e2 : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  Expr ([] : List annot) (Esseq pat e1 e2)
def mk_save_e_ (annots1 : List annot) (sym_ty : (sym × core_base_type))
    (sym_ty_pes : List
      (sym ×
        ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr Unit sym)))
    (e : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  Expr annots1 (Esave sym_ty sym_ty_pes e)
def mk_save_e (sym_ty : (sym × core_base_type))
    (sym_ty_pes : List
      (sym ×
        ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr Unit sym)))
    (e : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Esave sym_ty sym_ty_pes e)
def mk_run_e (sym1 : sym) (pes : List (generic_pexpr Unit sym)) : generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Erun () sym1 pes)
def mk_nd_e (es : List (generic_expr Unit Unit sym)) : generic_expr Unit Unit sym :=
  Expr ([] : List annot) (End es)
def mk_if_e_ (annots1 : List annot) (pe : generic_pexpr Unit sym) (e1 : generic_expr Unit Unit sym)
    (e2 : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  Expr annots1 (Eif pe e1 e2)
def mk_if_e (pe : generic_pexpr Unit sym) (e1 : generic_expr Unit Unit sym)
    (e2 : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Eif pe e1 e2)
def mk_let_e (pat : generic_pattern sym) (pe : generic_pexpr Unit sym)
    (e : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Elet pat pe e)
def mk_ccall_e_ (annots1 : List annot) (cty : generic_pexpr Unit sym) (pe : generic_pexpr Unit sym)
    (pes : List (generic_pexpr Unit sym)) :
    generic_expr Unit Unit sym :=
  Expr annots1 (Eccall () cty pe pes)
def mk_memop_e (mop : generic_memop sym) (pes : List (generic_pexpr Unit sym)) :
    generic_expr Unit Unit sym :=
  Expr ([] : List annot) (Ememop mop pes)
def mk_wait_e { a : Type } (tid1 : Nat) : generic_expr a Unit sym :=
  Expr ([] : List annot) (Ewait tid1)

def add_loc (loc1 : CerbLocation.Loc) (g : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  match loc1, g with
  | loc1, (Expr annot1 expr_) =>
    (let pred1 : annot → Bool :=
       fun (x : annot) =>
         match x with
         | Aloc _ => true
         | _ => false;
     Expr
       (match lemListDeleteFirst pred1 annot1 with
        | none => (Aloc loc1) :: annot1
        | some xs' => (Aloc loc1) :: xs') expr_)
def add_stmt (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match g with
  | (Expr annot1 expr_) => Expr (Astmt :: annot1) expr_
def add_expr (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match g with
  | (Expr annot1 expr_) => Expr (Aexpr :: annot1) expr_
def add_std (str : String) (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match str, g with
  | str, (Expr annot1 expr_) => Expr (Astd str :: annot1) expr_
def add_stds (strs : List String) (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match strs, g with
  | strs, (Expr annot1 expr_) => Expr (List.map (fun (z : String) => Astd z) strs ++ annot1) expr_
def add_attrs (attrs1 : attributes) (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match attrs1, g with
  | attrs1, expr1@(Expr annot1 expr_) =>
    (match attrs1 with
     | Attrs [] => expr1
     | _ => Expr (Aattrs attrs1 :: annot1) expr_)
def add_annot (annot1 : annot) (g : generic_expr Unit Unit sym) : generic_expr Unit Unit sym :=
  match annot1, g with
  | annot1, (Expr annots1 expr_) => Expr (annot1 :: annots1) expr_
def add_annots (annots1 : List annot) (g : generic_expr Unit Unit sym) :
    generic_expr Unit Unit sym :=
  match annots1, g with
  | annots1, (Expr annots2 expr_) => Expr (annots1 ++ annots2) expr_

structure collect_saves_state (a : Type) where
  tmp_acc : Fmap sym (List (sym × core_base_type) × expr a) /- Core.labeled_continuations 'a; -/
  closed_acc : Fmap sym (List (sym × core_base_type) × expr a) /- Core.labeled_continuations 'a; -/
  deriving BEq, Ord
instance { a : Type } : Inhabited (collect_saves_state a) where
  default := collect_saves_state.mk default default
instance (priority := 500) { a : Type } [Ord a] :
    Lem_Basic_classes.SetType (collect_saves_state a) where
  setElemCompare := defaultCompare
instance (priority := 500) { a : Type } [BEq a] :
    Lem_Basic_classes.Eq0 (collect_saves_state a) where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) { a : Type } [Ord a] :
    Lem_Basic_classes.Ord0 (collect_saves_state a) where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

@[never_extract] def empty_saves { a : Type } : collect_saves_state a :=
  (({ tmp_acc := fmapEmpty, closed_acc := fmapEmpty } : collect_saves_state a))

def union_saves { a : Type } (st1 : collect_saves_state a) (st2 : collect_saves_state a) :
    collect_saves_state a :=
  (({ tmp_acc :=
        (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st1.tmp_acc
          st2.tmp_acc),
      closed_acc :=
        (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st1.closed_acc
          st2.closed_acc) } : collect_saves_state a))
/- NOTE: assumes the expression is well formed/typed -/

def collect_saves_aux_lemFuel { a : Type } (lemFuel : Nat) (st : collect_saves_state a)
    (g : generic_expr a Unit sym) :
    collect_saves_state a :=
  match lemFuel with
  | 0 => (fuelExhausted st)
  | Nat.succ lemFuel =>
    (match st, g with
     | st, (Expr annots1 expr_) =>
       (match expr_ with
        | Epure _ => st
        | Ememop _ _ => st
        | Eaction _ => st
        | Ecase _ pat_es =>
          List.foldl
            (fun (acc : collect_saves_state a)
              (p : (generic_pattern sym × generic_expr a Unit sym)) =>
              match acc, p with
              | acc, (_, e) => (collect_saves_aux_lemFuel lemFuel) acc e) st pat_es
        | Elet _ _ e => (collect_saves_aux_lemFuel lemFuel) st e
        | Eif _ e1 e2 =>
          (collect_saves_aux_lemFuel lemFuel) ((collect_saves_aux_lemFuel lemFuel) st e1) e2
        | Eccall _ _ _ _ => st
        | Eproc _ _ _ => st
        | Eunseq es => List.foldl (collect_saves_aux_lemFuel lemFuel) st es
        | Ewseq pat e1 e2 =>
          (let st1 :=(collect_saves_aux_lemFuel lemFuel) empty_saves e1;
           let st2 :=(collect_saves_aux_lemFuel lemFuel) empty_saves e2;
           union_saves st
             (union_saves
               { st1 with
                 tmp_acc := fmapMap
                   (fun (p : (List (sym × core_base_type) × generic_expr a Unit sym)) =>
                     match p with
                     | (syms, e) => (syms, Expr annots1 (Ewseq pat e e2))) st1.tmp_acc } st2))
        | Esseq pat e1 e2 =>
          (let st1 :=(collect_saves_aux_lemFuel lemFuel) empty_saves e1;
           let st2 :=(collect_saves_aux_lemFuel lemFuel) empty_saves e2;
           union_saves st
             (union_saves
               { st1 with
                 tmp_acc := fmapMap
                   (fun (p : (List (sym × core_base_type) × generic_expr a Unit sym)) =>
                     match p with
                     | (syms, e) => (syms, Expr annots1 (Esseq pat e e2))) st1.tmp_acc } st2))
        | Ebound _ => /- typing forbids "saves" inside a "bound()" -/ st
        | End _ => /- typing forbids "saves" inside a "nd()" -/ st
        | Esave (sym1, _) params e =>
          (collect_saves_aux_lemFuel lemFuel)
            { st with
              tmp_acc :=
                (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                  (List.map
                    (fun (p :
                      (sym ×
                        ((core_base_type × Option (ctype × pass_by_value_or_pointer)) ×
                          generic_pexpr Unit sym))) =>
                      match p with
                      | (x, ((y, _), _)) => (x, y)) params, e) st.tmp_acc) } e
        | Erun _ _ _ => st
        | Epar es =>
          (let acc := List.foldl (collect_saves_aux_lemFuel lemFuel) empty_saves es;
           { st with
             closed_acc := fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
               (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) acc.tmp_acc
                 acc.closed_acc) st.closed_acc })
        | Ewait _ => st
        | Eannot _ _ => /- typing forbids "saves" inside a "annot()" -/ st
        | Eexcluded _ _ => /- typing forbids "saves" inside a "excluded()" -/ st))

def collect_saves_aux { a : Type } (st : collect_saves_state a) (g : generic_expr a Unit sym) :
    collect_saves_state a :=
  collect_saves_aux_lemFuel (generic_expr.lemSize g) st g
theorem collect_saves_aux_lemFuel_zero { a : Type } (st : collect_saves_state a)
    (g : generic_expr a Unit sym) :
    collect_saves_aux_lemFuel 0 st g = (fuelExhausted st) :=
  rfl
 /- Core.labeled_continuations 'a -/
def collect_saves { a : Type } (expr1 : generic_expr a Unit sym) :
    Fmap sym (List (sym × core_base_type) × expr a) :=
  let st :=
    collect_saves_aux (({ tmp_acc := fmapEmpty, closed_acc := fmapEmpty } : collect_saves_state a))
      expr1;
  fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st.tmp_acc st.closed_acc

/- The same again, now collecting more information about the
   esave. The above could be defined in terms of the below, but I
   didn't want to mess that up, so leaving for now. -/

abbrev m_labeled_continuation (a : Type) :=
  (core_base_type × List
    (sym × ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × pexpr)) × (expr a) × List
    annot)

abbrev m_labeled_continuations (a : Type) := Fmap sym (m_labeled_continuation a)

structure m_collect_saves_state (a : Type) where
  m_tmp_acc : m_labeled_continuations a
  m_closed_acc : m_labeled_continuations a
  deriving BEq, Ord
instance { a : Type } : Inhabited (m_collect_saves_state a) where
  default := m_collect_saves_state.mk default default
instance (priority := 500) { a : Type } [Ord a] :
    Lem_Basic_classes.SetType (m_collect_saves_state a) where
  setElemCompare := defaultCompare
instance (priority := 500) { a : Type } [BEq a] :
    Lem_Basic_classes.Eq0 (m_collect_saves_state a) where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) { a : Type } [Ord a] :
    Lem_Basic_classes.Ord0 (m_collect_saves_state a) where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

@[never_extract] def m_empty_saves { a : Type } : m_collect_saves_state a :=
  (({ m_tmp_acc := fmapEmpty, m_closed_acc := fmapEmpty } : m_collect_saves_state a))

def m_union_saves { a : Type } (st1 : m_collect_saves_state a) (st2 : m_collect_saves_state a) :
    m_collect_saves_state a :=
  (({ m_tmp_acc :=
        (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st1.m_tmp_acc
          st2.m_tmp_acc),
      m_closed_acc :=
        (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st1.m_closed_acc
          st2.m_closed_acc) } : m_collect_saves_state a))
/- NOTE: assumes the expression is well formed/typed -/

def m_collect_saves_aux_lemFuel { a : Type } (lemFuel : Nat) (st : m_collect_saves_state a)
    (g : generic_expr a Unit sym) :
    m_collect_saves_state a :=
  match lemFuel with
  | 0 => (fuelExhausted st)
  | Nat.succ lemFuel =>
    (match st, g with
     | st, (Expr annots1 expr_) =>
       (match expr_ with
        | Epure _ => st
        | Ememop _ _ => st
        | Eaction _ => st
        | Ecase _ pat_es =>
          List.foldl
            (fun (acc : m_collect_saves_state a)
              (p : (generic_pattern sym × generic_expr a Unit sym)) =>
              match acc, p with
              | acc, (_, e) => (m_collect_saves_aux_lemFuel lemFuel) acc e) st pat_es
        | Elet _ _ e => (m_collect_saves_aux_lemFuel lemFuel) st e
        | Eif _ e1 e2 =>
          (m_collect_saves_aux_lemFuel lemFuel) ((m_collect_saves_aux_lemFuel lemFuel) st e1) e2
        | Eccall _ _ _ _ => st
        | Eproc _ _ _ => st
        | Eunseq es => List.foldl (m_collect_saves_aux_lemFuel lemFuel) st es
        | Ewseq pat e1 e2 =>
          (let st1 :=(m_collect_saves_aux_lemFuel lemFuel) m_empty_saves e1;
           let st2 :=(m_collect_saves_aux_lemFuel lemFuel) m_empty_saves e2;
           m_union_saves st
             (m_union_saves
               { st1 with
                 m_tmp_acc := fmapMap
                   (fun (p :
                     (core_base_type × List
                       (sym ×
                         ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × pexpr)) ×
                       generic_expr a Unit sym × List annot)) =>
                     match p with
                     | (cbt, args, body, annots') =>
                       (cbt, args, Expr annots1 (Ewseq pat body e2), annots')) st1.m_tmp_acc } st2))
        | Esseq pat e1 e2 =>
          (let st1 :=(m_collect_saves_aux_lemFuel lemFuel) m_empty_saves e1;
           let st2 :=(m_collect_saves_aux_lemFuel lemFuel) m_empty_saves e2;
           m_union_saves st
             (m_union_saves
               { st1 with
                 m_tmp_acc := fmapMap
                   (fun (p :
                     (core_base_type × List
                       (sym ×
                         ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × pexpr)) ×
                       generic_expr a Unit sym × List annot)) =>
                     match p with
                     | (cbt, args, body, annots') =>
                       (cbt, args, Expr annots1 (Esseq pat body e2), annots')) st1.m_tmp_acc } st2))
        | Ebound _ => /- typing forbids "saves" inside a "bound()" -/ st
        | End _ => /- typing forbids "saves" inside a "nd()" -/ st
        | Esave (sym1, ty1) params e =>
          (let oloc := get_loc annots1;
           (lemSeq
             (fun _ =>
               match oloc with
               | some _ => ()
               | _ =>
                 CerbDebug.print_debug_pure 0 ([] : List domain) (fun (u : Unit) =>
                   match u with
                   | () =>
                     String.append "label "
                       (String.append (show_symbol sym1) "missing label location")))
             (fun _ =>
               (m_collect_saves_aux_lemFuel lemFuel)
                 { st with
                   m_tmp_acc :=
                     (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                       (ty1, params, e, annots1) st.m_tmp_acc) } e)))
        | Erun _ _ _ => st
        | Epar es =>
          (let acc := List.foldl (m_collect_saves_aux_lemFuel lemFuel) m_empty_saves es;
           { st with
             m_closed_acc := fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
               (fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) acc.m_tmp_acc
                 acc.m_closed_acc) st.m_closed_acc })
        | Ewait _ => st
        | Eannot _ _ => st
        | Eexcluded _ _ => st))

def m_collect_saves_aux { a : Type } (st : m_collect_saves_state a) (g : generic_expr a Unit sym) :
    m_collect_saves_state a :=
  m_collect_saves_aux_lemFuel (generic_expr.lemSize g) st g
theorem m_collect_saves_aux_lemFuel_zero { a : Type } (st : m_collect_saves_state a)
    (g : generic_expr a Unit sym) :
    m_collect_saves_aux_lemFuel 0 st g = (fuelExhausted st) :=
  rfl

def m_collect_saves { a : Type } (expr1 : generic_expr a Unit sym) :
    Fmap sym
        (core_base_type × List
          (sym × ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × pexpr)) × expr a ×
          List annot) :=
  let st :=
    m_collect_saves_aux
      (({ m_tmp_acc := fmapEmpty, m_closed_acc := fmapEmpty } : m_collect_saves_state a)) expr1;
  fmapUnionBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) st.m_tmp_acc st.m_closed_acc

