        exception_undef_return (PEop binop1 pe1' pe2')))
/- evaluation of pure expressions (will crash on ill-typed and/or non pure
   expressions).  Note that this evaluation may be partial; that is, the
   result of eval may be another unevaluated expression rather than a value.
   This is to ensure that the eval function will always terminate (which is
   important for the Coq backend).  To fully evaluate a pure expression,
   it is necessary to call eval repeatedly until is_value returns True. -/

def step_eval_pexpr_lemFuel [LemFuel] [CerbImplCfg.Impl] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (n : Nat)
    (loc1 : CerbLocation.Loc) (parent_call_loc_opt : Option CerbLocation.Loc)
    (core_extern1 : Fmap sym sym) (env1 : List (Fmap sym value))
    (mem_st_opt : Option CerbMem.MemState) (file1 : generic_file Unit core_run_annotation)
    (hasConstrained : Bool) (pexpr1 : generic_pexpr Unit sym) :
    exceptM (t0 (generic_pexpr Unit sym)) core_run_cause :=
  match lemFuel with
  | 0 => (fuelExhausted (Result (Undef CerbLocation.Loc.unknown [])))
  | Nat.succ lemFuel =>
    (match pexpr1 with
     | Pexpr _ () pexpr_ =>
       (let strip1 : generic_pexpr Unit sym → generic_pexpr_ Unit sym :=
          (fun (g : generic_pexpr Unit sym) =>
            match g with
            | (Pexpr _ _ pe_) => pe_);
        let self : generic_pexpr Unit sym → exceptM (t0 (generic_pexpr Unit sym)) core_run_cause :=
          (fun (pe : generic_pexpr Unit sym) =>
            (step_eval_pexpr_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs) (n + 1)
              loc1 parent_call_loc_opt core_extern1 env1 mem_st_opt file1 /- hasConstrained -/ false
              pe);
        exception_undef_fmap (Pexpr ([] : List annot) ())
          (match pexpr_ with /- NEW pull_constrained -/
           | PEconstrained xs => exception_undef_return pexpr_
           /-
        if hasConstrained then
          let (cs, pe') = List.unzip xs in
          match Caux.valueFromPexprs pe' with
            | Just cvals ->
/-
                EU.return $ PEconstrained (List.zip cs (List.map Caux.mk_value_pe cvals))
-/
                error ("EU.return $ PEval (Vconstrained (List.zip cs cvals))\n cvals= " ^
                       Pp.stringFromCore_value (Vtuple cvals))
            | Nothing ->
                EU.return $ PEconstrained (List.zip cs pe')
          end
        else
          error ("step_eval_pexpr, hasConstrained = False  ==>  " ^
                 Pp.stringFromCore_pexpr pexpr)
-/
           | PEsym sym1 =>
             (let sym1 :=
                match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                    core_extern1) with
                | some sym1 => sym1
                | none => sym1;
              match lookup_env sym1 env1 with
              | none =>
                (/- NOTE: check if it is a procedure pointer -/
                match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                    file1.funs) with
                | some (Proc _ _ _ _ _) =>
                  exception_undef_return
                    (PEval
                      (Vobject (OVpointer (CerbMem.nullPtrval (Ctype ([] : List annot) Void0)))))
                | _ => exception_undef_fail (Unresolved_symbol loc1 sym1))
              | some cval => exception_undef_return (PEval cval))
           | PEimpl iCst =>
             (match (fmapLookupBy implementation_constant_compare iCst file1.impl0) with
              | some (Def _ pe) => exception_undef_return (strip1 pe)
              | _ => exception_undef_fail Unknown_impl)
           | PEval cval => exception_undef_return pexpr_
           | PEundef undef_loc ub =>
             (let loc' :=
                match ub, parent_call_loc_opt with
                | UB088_reached_end_of_function, some call_loc => call_loc
                | _, _ =>
                  (lem_if CerbLocation.isLibraryLocation undef_loc then loc1 else undef_loc);
              except_return (undef loc' [ub]))
           | PEerror str debug_pe => except_return (error0 loc1 str)
           | PEctor ctor1 pes =>
             exception_undef_bind (exception_undef_mapM self pes) (fun (pes' : List pexpr) =>
               match ctor1, valueFromPexprs pes' with
               | Cnil bTy, some [] => exception_undef_return (PEval (Vlist bTy ([] : List value)))
               | Ccons, some [cval1, Vlist bTy' cvals] =>
                 exception_undef_return (PEval (Vlist bTy' (cval1 :: cvals)))
               | Ctuple, some cvals => exception_undef_return (PEval (Vtuple cvals))
               | Carray, some cvals =>
                 (/- By typing all the [cvals] must be loaded_values -/
                 match lemListFoldr
                     (fun (cval : value) (acc : Option (List loaded_value)) =>
                       match cval, acc with
                       | Vloaded lval, some lvals => some (lval :: lvals)
                       | _, _ => none) (some ([] : List loaded_value)) cvals with
                 | none =>
                   exception_undef_fail
                     (Illformed_program
                       (String.append
                         "PEctor, Carray: one of the operands didn't evaluate to a loaded value ==> "
                         (stringFromList CerbPP.stringFromCore_value cvals)))
                 | some lvals => exception_undef_return (PEval (Vobject (OVarray lvals))))
               | Civmax, some [Vctype ty1] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval
                        (Vobject
                          (OVinteger
                            ((CerbMem.maxIval _lemReader_enum_definitions _lemReader_tagDefs)
                              ity))))
                  | _ =>
                    (failwithI
                      (String.append "Core_eval ivmax"
                        (/- DEBUG -/ CerbPP.stringFromCore_expr
                          (Expr ([] : List annot)
                            (Epure (Pexpr ([] : List annot) () (PEval (Vctype ty1)))) : expr
                            Unit))) : exceptM (t0 (generic_pexpr_ Unit sym))
                      core_run_cause) /- DEBUG -/)
               | Civmin, some [Vctype ty1] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval
                        (Vobject
                          (OVinteger
                            ((CerbMem.minIval _lemReader_enum_definitions _lemReader_tagDefs)
                              ity))))
                  | _ =>
                    (failwithI
                      (String.append "Core_eval ivmin ["
                        (String.append (CerbLocation.stringFromLocation loc1)
                          (String.append "] ==> "
                            (/- DEBUG -/ CerbPP.stringFromCore_expr
                              (Expr ([] : List annot)
                                (Epure (Pexpr ([] : List annot) () (PEval (Vctype ty1)))) : expr
                                Unit))))) : exceptM (t0 (generic_pexpr_ Unit sym))
                      core_run_cause) /- DEBUG -/)
               | Civsizeof, some [Vctype ty1] =>
                 exception_undef_return
                   (PEval
                     (Vobject
                       (OVinteger
                         ((CerbMem.sizeofIval _lemReader_enum_definitions _lemReader_tagDefs)
                           ty1))))
               | Civalignof, some [Vctype ty1] =>
                 exception_undef_return
                   (PEval
                     (Vobject
                       (OVinteger
                         ((CerbMem.alignofIval _lemReader_enum_definitions _lemReader_tagDefs)
                           ty1))))
               | CivCOMPL, some [Vctype ty1, Vobject (OVinteger ival)] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval (Vobject (OVinteger (CerbMem.bitwiseComplementIval ity ival))))
                  | _ =>
                    (failwithI "Core_Eval ivCOMPL, not (is_integer ty)" : exceptM
                      (t0 (generic_pexpr_ Unit sym)) core_run_cause))
               | CivAND, some [Vctype ty1, Vobject (OVinteger ival1), Vobject (OVinteger ival2)] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval (Vobject (OVinteger (CerbMem.bitwiseAndIval ity ival1 ival2))))
                  | _ =>
                    (failwithI "Core_Eval ivAND, not (is_integer ty)" : exceptM
                      (t0 (generic_pexpr_ Unit sym)) core_run_cause))
               | CivOR, some [Vctype ty1, Vobject (OVinteger ival1), Vobject (OVinteger ival2)] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval (Vobject (OVinteger (CerbMem.bitwiseOrIval ity ival1 ival2))))
                  | _ =>
                    (failwithI "Core_Eval ivOR, not (is_integer ty)" : exceptM
                      (t0 (generic_pexpr_ Unit sym)) core_run_cause))
               | CivXOR, some [Vctype ty1, Vobject (OVinteger ival1), Vobject (OVinteger ival2)] =>
                 (match unatomic_ ty1 with
                  | (Basic (Integer ity)) =>
                    exception_undef_return
                      (PEval (Vobject (OVinteger (CerbMem.bitwiseXorIval ity ival1 ival2))))
                  | _ =>
                    (failwithI "Core_Eval ivXOR, not (is_integer ty)" : exceptM
                      (t0 (generic_pexpr_ Unit sym)) core_run_cause))
               | Cspecified, some [Vobject oval] =>
                 exception_undef_return (PEval (Vloaded (LVspecified oval)))
               | Cunspecified, some [Vctype ty1] =>
                 exception_undef_return (PEval (Vloaded (LVunspecified ty1)))
               | Cfvconvert,
                 some [Vctype (Ctype _ (Basic (Floating ft))), Vobject (OVfloating x)] =>
                 exception_undef_return (PEval (Vobject (OVfloating (CerbMem.convertFval ft x))))
               | CfvconvertLoaded,
                 some
                   [Vctype (Ctype _ (Basic (Floating ft))), Vloaded (LVspecified (OVfloating x))] =>
                 exception_undef_return
                   (PEval (Vloaded (LVspecified (OVfloating (CerbMem.convertFval ft x)))))
               | CfvconvertLoaded, some [Vctype ty1, Vloaded (LVunspecified _)] =>
                 exception_undef_return (PEval (Vloaded (LVunspecified ty1)))
               | CfvfromintTyped,
                 some [Vctype (Ctype _ (Basic (Floating ft))), Vobject (OVinteger x)] =>
                 exception_undef_return (PEval (Vobject (OVfloating (CerbMem.fvfromintTyped ft x))))
               | CfvfromintTypedLoaded,
                 some
                   [Vctype (Ctype _ (Basic (Floating ft))), Vloaded (LVspecified (OVinteger x))] =>
                 exception_undef_return
                   (PEval (Vloaded (LVspecified (OVfloating (CerbMem.fvfromintTyped ft x)))))
               | CfvfromintTypedLoaded, some [Vctype ty1, Vloaded (LVunspecified _)] =>
                 exception_undef_return (PEval (Vloaded (LVunspecified ty1)))
               | Cfvneg, some [Vobject (OVfloating fv)] =>
                 exception_undef_return (PEval (Vobject (OVfloating (CerbMem.negFval fv))))
               | Cfvfromint, some [Vobject (OVinteger ival)] =>
                 exception_undef_return (PEval (Vobject (OVfloating (CerbMem.fvfromint ival))))
               | Civfromfloat,
                 some [Vctype (Ctype _ (Basic (Integer ity))), Vobject (OVfloating fval)] =>
                 (lem_if CerbMem.finiteFval fval then
                   exception_undef_return
                     (PEval (Vobject (OVinteger (CerbMem.ivfromfloat ity fval))))
                 else
                   except_return (undef loc1 [UB017_out_of_range_floating_integer_conversion]))
               | CivNULLcap is_signed, some [] =>
                 exception_undef_return (PEval (Vobject (OVinteger (CerbMem.nullCap is_signed))))
               | _, some cvals =>
                 (lem_if false /- List.any Caux.isConstrainedValue cvals -/ then
                   /- if some operands of the ctor are constrained, the following pulls the PEconstrained operator
                   outside of the PEctor -/
                   /- TODO: check this code -/
                   let xs : List (mem_iv_constraint × List pexpr) :=
                     List.foldl
                       (fun (acc : List
                         (mem_constraint CerbMem.IntegerValue × List (generic_pexpr Unit sym)))
                         (cval : value) =>
                         /-
                    match cval with
                      | Vconstrained xs ->
                          List.map (fun ((xs_cs, xsCval), (acc_cs, accPes)) ->
                            (ND.concat xs_cs acc_cs, Pexpr [] () (PEval xsCval) :: accPes)
                          ) (Utils.product_list xs acc)
                      | _ ->
                          List.map (fun (cs, pes) -> (cs, Pexpr [] () (PEval cval) :: pes)) acc
                    end
-/
                         List.map
                           (fun (p :
                             (mem_constraint CerbMem.IntegerValue × List
                               (generic_pexpr Unit sym))) =>
                             match p with
                             | (cs, pes) => (cs, (Pexpr ([] : List annot) () (PEval cval) :: pes)))
                           acc) [(MC_empty, ([] : List (generic_pexpr Unit sym)))] cvals;
                   exception_undef_return
                     (PEconstrained
                       (List.map
                         (fun (p :
                           (mem_constraint CerbMem.IntegerValue × List (generic_pexpr Unit sym))) =>
                           match p with
                           | (cs, pes') => (cs, Pexpr ([] : List annot) () (PEctor ctor1 pes')))
                         xs))
                 else
                   exception_undef_fail
                     (Illformed_program
                       (String.append "PEctor: one of the operands was ill-typed ==> "
                         (String.append (CerbPP.stringFromCore_pexpr pexpr1)
                           (String.append " <====> "
                             (stringFromList CerbPP.stringFromCore_value cvals))))))
               | _, none => exception_undef_return (PEctor ctor1 pes'))
           | PEcase pe pat_pes =>
             exception_undef_bind (self pe) (fun (x : generic_pexpr Unit sym) =>
               match x with
