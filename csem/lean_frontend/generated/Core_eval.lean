def pull_helper { a b : Type } (pull : generic_pexpr Unit sym → generic_pexpr Unit sym)
    (pe_cons : List (a × generic_pexpr Unit sym) → generic_pexpr_ Unit b) (ps : List (a × pexpr)) :
    generic_pexpr_ Unit b :=
  match List.foldl
      (fun (acc : Sum
        (List (mem_constraint CerbMem.IntegerValue × List (a × generic_pexpr Unit sym)))
        (List (a × generic_pexpr Unit sym))) (p : (a × generic_pexpr Unit sym)) =>
        match acc, p with
        | acc, (a1, pe) =>
          (match pull pe with
           | Pexpr _ () (PEconstrained xs) =>
             (let ys :=
                match acc with
                | Sum.inr pes => [(MC_empty, pes)]
                | Sum.inl ys => ys;
              Sum.inl
                (List.map
                  (fun (p :
                    ((mem_constraint CerbMem.IntegerValue × List (a × generic_pexpr Unit sym)) ×
                      (mem_constraint CerbMem.IntegerValue × List (a × generic_pexpr Unit sym)))) =>
                    match p with
                    | ((cs1, pes1), (cs2, pes2)) => (MC_conj [cs1, cs2], (pes1 ++ pes2)))
                  (product_list
                    (List.map
                      (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                        match p with
                        | (cs, pe) => (cs, [(a1, pe)])) xs) ys)))
           | pe' =>
             (match acc with
              | Sum.inr pes' => Sum.inr ((a1, pe) :: pes')
              | Sum.inl ys =>
                Sum.inl
                  (List.map
                    (fun (p :
                      (mem_constraint CerbMem.IntegerValue × List (a × generic_pexpr Unit sym))) =>
                      match p with
                      | (cs, pes) => (cs, ((a1, pe') :: pes))) ys)))) (Sum.inr []) ps with
  | Sum.inl ys =>
    PEconstrained
      (List.map
        (fun (p : (mem_constraint CerbMem.IntegerValue × List (a × generic_pexpr Unit sym))) =>
          match p with
          | (cs, pes_rev) => (cs, Pexpr ([] : List annot) () (pe_cons (List.reverse pes_rev)))) ys)
  | Sum.inr pes_rev => pe_cons (List.reverse pes_rev)

def pull_constrained_lemFuel (lemFuel : Nat) (n : Nat) (g : generic_pexpr Unit sym) :
    generic_pexpr Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match n, g with
     | n, (Pexpr _ () pexpr_) =>
       (let self : generic_pexpr Unit sym → generic_pexpr Unit sym :=
          (fun (pe : generic_pexpr Unit sym) => (pull_constrained_lemFuel lemFuel) (n + 1) pe);
        let wrap : (generic_pexpr Unit sym → generic_pexpr_ Unit sym) → generic_pexpr Unit sym →
          generic_pexpr_ Unit sym :=
          (fun (f : generic_pexpr Unit sym → generic_pexpr_ Unit sym)
            (pe : generic_pexpr Unit sym) =>
            match self pe with
            | Pexpr _ () (PEconstrained xs) =>
              PEconstrained
                (List.map
                  (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                    match p with
                    | (cs, pe') => (cs, Pexpr ([] : List annot) () (f pe'))) xs)
            | pe' => f pe');
        let wrap_bin : (generic_pexpr Unit sym → generic_pexpr Unit sym → generic_pexpr_ Unit sym) →
          generic_pexpr Unit sym → generic_pexpr Unit sym → generic_pexpr_ Unit sym :=
          (fun (f : generic_pexpr Unit sym → generic_pexpr Unit sym → generic_pexpr_ Unit sym)
            (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
            match self pe1, self pe2 with
            | Pexpr _ () (PEconstrained xs1), Pexpr _ () (PEconstrained xs2) =>
              PEconstrained
                (List.map
                  (fun (p :
                    ((mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym) ×
                      (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym))) =>
                    match p with
                    | ((cs1, pe1), (cs2, pe2)) =>
                      (MC_conj [cs1, cs2], Pexpr ([] : List annot) () (f pe1 pe2)))
                  (product_list xs1 xs2))
            | Pexpr _ () (PEconstrained xs1), pe2' =>
              PEconstrained
                (List.map
                  (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                    match p with
                    | (cs, pe) => (cs, Pexpr ([] : List annot) () (f pe pe2'))) xs1)
            | pe1', Pexpr _ () (PEconstrained xs2) =>
              PEconstrained
                (List.map
                  (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                    match p with
                    | (cs, pe) => (cs, Pexpr ([] : List annot) () (f pe1' pe))) xs2)
            | pe1', pe2' => f pe1' pe2');
        let wrap_list : (List (generic_pexpr Unit sym) → generic_pexpr_ Unit sym) → List
          (generic_pexpr Unit sym) → generic_pexpr_ Unit sym :=
          (fun (f : List (generic_pexpr Unit sym) → generic_pexpr_ Unit sym)
            (pes : List (generic_pexpr Unit sym)) =>
            pull_helper self
              (fun (xs : List (Unit × generic_pexpr Unit sym)) => f (List.map Prod.snd xs))
              (List.map (fun (pe : generic_pexpr Unit sym) => ((), pe)) pes));
        Pexpr ([] : List annot) ()
          (match pexpr_ with
           | PEsym _ => pexpr_
           | PEimpl _ => pexpr_
           | PEval _ => pexpr_
           | PEconstrained xs =>
             PEconstrained
               (List.foldl
                 (fun (acc : List (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym))
                   (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                   match acc, p with
                   | acc, (cs, pe) =>
                     (match self pe with
                      | Pexpr _ () (PEconstrained xs) =>
                        (List.map
                          (fun (p :
                            (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                            match p with
                            | (cs', pe') => (MC_conj [cs, cs'], pe')) xs) ++ acc
                      | pe' => (cs, pe') :: acc))
                 ([] : List (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) xs)
           | PEundef _ _ => pexpr_
           | PEerror err_str pe => wrap (PEerror err_str) pe
           | PEctor ctor1 pes => wrap_list (PEctor ctor1) pes
           | PEcase pe pat_pes =>
             (match self pe with
              | Pexpr annots1 () (PEconstrained xs) =>
                PEconstrained
                  (List.map
                    (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr Unit sym)) =>
                      match p with
                      | (cs, pe) => (cs, Pexpr annots1 () (pull_helper self (PEcase pe) pat_pes)))
                    xs)
              | pe' => pull_helper self (PEcase pe') pat_pes)
           | PEarray_shift pe1 cty pe2 =>
             wrap_bin
               (fun (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
                 PEarray_shift pe1 cty pe2) pe1 pe2
           | PEmember_shift pe sym1 cid =>
             wrap (fun (pe : generic_pexpr Unit sym) => PEmember_shift pe sym1 cid) pe
           | PEmemop memop1 pes => wrap_list (PEmemop memop1) pes
           | PEnot pe => wrap PEnot pe
           | PEop binop1 pe1 pe2 => wrap_bin (PEop binop1) pe1 pe2
           | PEconv_int ity pe => wrap (PEconv_int ity) pe
           | PEwrapI ity iop1 pe1 pe2 => wrap_bin (PEwrapI ity iop1) pe1 pe2
           | PEcatch_exceptional_condition ity iop1 pe1 pe2 =>
             wrap_bin (PEcatch_exceptional_condition ity iop1) pe1 pe2
           | PEstruct sym1 xs => pull_helper self (PEstruct sym1) xs
           | PEunion sym1 cid pe => wrap (PEunion sym1 cid) pe
           | PEcfunction pe => wrap PEcfunction pe
           | PEmemberof tag_sym memb_ident pe => wrap (PEmemberof tag_sym memb_ident) pe
           | PEcall nm pes => wrap_list (PEcall nm) pes
           | PElet pat pe1 pe2 => wrap_bin (PElet pat) pe1 pe2
           | PEif pe1 pe2 pe3 =>
             (/- TODO: not sure about this one! -/
             let aux : List (generic_pexpr Unit sym) → generic_pexpr_ Unit sym :=
               fun (x : List (generic_pexpr Unit sym)) =>
                 match x with
                 | [pe1, pe2, pe3] => PEif pe1 pe2 pe3
                 | _ => (failwithI "impossible => Core_eval" : generic_pexpr_ Unit sym);
             wrap_list aux [pe1, pe2, pe3])
           | PEis_scalar pe => wrap PEis_scalar pe
           | PEis_integer pe => wrap PEis_integer pe
           | PEis_signed pe => wrap PEis_signed pe
           | PEis_unsigned pe => wrap PEis_unsigned pe
           | PEbmc_assume pe => wrap PEbmc_assume pe
           | PEare_compatible pe1 pe2 => wrap_bin PEare_compatible pe1 pe2)))

def pull_constrained (n : Nat) (g : generic_pexpr Unit sym) : pexpr :=
  pull_constrained_lemFuel (generic_pexpr.lemSize g) n g
theorem pull_constrained_lemFuel_zero (n : Nat) (g : generic_pexpr Unit sym) :
    pull_constrained_lemFuel 0 n g = (fuelExhausted g) :=
  rfl

def step_eval_peop [CerbImplCfg.Impl] (loc1 : CerbLocation.Loc)
    (self : generic_pexpr Unit sym → exceptM (t0 (generic_pexpr Unit sym)) core_run_cause)
    (binop1 : binop) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) :
    exceptM (t0 (generic_pexpr_ Unit sym)) core_run_cause :=
  exception_undef_bind (self pe1) (fun (pe1' : generic_pexpr Unit sym) =>
    exception_undef_bind (self pe2) (fun (pe2' : generic_pexpr Unit sym) =>
      match binop1, valueFromPexpr pe1', valueFromPexpr pe2' with
      /-
        | (_, Just (Vconstrained xs1), Just (Vconstrained xs2)) ->
            EU.return (
              PEconstrained $ List.map (fun ((cs1, v1), (cs2, v2)) ->
                  (ND.concat cs1 cs2, Pexpr [] () (PEop binop (Pexpr [] () (PEval v1)) (Pexpr [] () (PEval v2))))
              ) (Utils.product_list xs1 xs2)
            )
        
        | (_, Just (Vconstrained xs1), Just v2) ->
            EU.return (
              PEconstrained $ List.map (fun (cs1, v1) ->
                  (cs1, Pexpr [] () (PEop binop (Pexpr [] () (PEval v1)) (Pexpr [] () (PEval v2))))
              ) xs1
            )
        
        | (_, Just v1, Just (Vconstrained xs2)) ->
            EU.return (
              PEconstrained $ List.map (fun (cs1, v2) ->
                  (cs1, Pexpr [] () (PEop binop (Pexpr [] () (PEval v1)) (Pexpr [] () (PEval v2))))
              ) xs2
            )
-/
      /- Ctype equality -/
      | OpEq, some (Vctype ty1), some (Vctype ty2) =>
        exception_undef_return (PEval (lem_if ctypeEqual ty1 ty2 then Vtrue else Vfalse))
      /- Integer equality -/
      | OpEq, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (match CerbMem.eqIval ival1 ival2 with
         | some b => exception_undef_return (PEval (lem_if b then Vtrue else Vfalse))
         | none =>
           (/- when both outcomes are still possible -/
           let eq_constr := MC_eq ival1 ival2;
           /-
                  let () = Debug.print_debug 1 [] (fun () ->
                    "SYMBOLIC INT EQ ==> " ^
                    Pp.stringFromMem_iv_mem_constraint eq_constr
                  ) in
-/
           exception_undef_return
             (PEconstrained
               [(eq_constr, Pexpr ([] : List annot) () (PEval Vtrue)),
                 (MC_not eq_constr, Pexpr ([] : List annot) () (PEval Vfalse))])))
      | OpEq, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        exception_undef_return (PEval (lem_if CerbMem.eqFval fval1 fval2 then Vtrue else Vfalse))
      | OpLt, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (match CerbMem.ltIval ival1 ival2 with
         | some b => exception_undef_return (PEval (lem_if b then Vtrue else Vfalse))
         | none =>
           (/- when both outcomes are still possible -/
           let lt_constr := MC_lt ival1 ival2;
           exception_undef_return
             (PEconstrained
               [(lt_constr, Pexpr ([] : List annot) () (PEval Vtrue)),
                 (MC_not lt_constr, Pexpr ([] : List annot) () (PEval Vfalse))])))
      | OpLt, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        exception_undef_return (PEval (lem_if CerbMem.ltFval fval1 fval2 then Vtrue else Vfalse))
      | OpLe, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (match CerbMem.leIval ival1 ival2 with
         | some b => exception_undef_return (PEval (lem_if b then Vtrue else Vfalse))
         | none =>
           (/- when both outcomes are still possible -/
           let le_constr := MC_le ival1 ival2;
           exception_undef_return
             (PEconstrained
               [(le_constr, Pexpr ([] : List annot) () (PEval Vtrue)),
                 (MC_not le_constr, Pexpr ([] : List annot) () (PEval Vfalse))])))
      | OpLe, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        exception_undef_return (PEval (lem_if CerbMem.leFval fval1 fval2 then Vtrue else Vfalse))
      | OpGe, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (/- TODO CHECK -/
        match CerbMem.leIval ival2 ival1 with
        | some b => exception_undef_return (PEval (lem_if b then Vtrue else Vfalse))
        | none =>
          (/- when both outcomes are still possible -/
          let ge_constr := MC_le ival2 ival1;
          exception_undef_return
            (PEconstrained
              [(ge_constr, Pexpr ([] : List annot) () (PEval Vtrue)),
                (MC_not ge_constr, Pexpr ([] : List annot) () (PEval Vfalse))])))
      | OpGe, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        exception_undef_return (PEval (lem_if CerbMem.leFval fval2 fval1 then Vtrue else Vfalse))
      | OpGt, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (/- TODO CHECK -/
        match CerbMem.ltIval ival2 ival1 with
        | some b => exception_undef_return (PEval (lem_if b then Vtrue else Vfalse))
        | none =>
          (/- when both outcomes are still possible -/
          let gt_constr := MC_lt ival2 ival1;
          exception_undef_return
            (PEconstrained
              [(gt_constr, Pexpr ([] : List annot) () (PEval Vtrue)),
                (MC_not gt_constr, Pexpr ([] : List annot) () (PEval Vfalse))])))
      | OpGt, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        exception_undef_return (PEval (lem_if CerbMem.ltFval fval2 fval1 then Vtrue else Vfalse))
      | _, some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
        (let iop1 :=
           match binop1 with
           | OpAdd => IntAdd
           | OpSub => IntSub
           | OpMul => IntMul
           | OpDiv => IntDiv
           | OpRem_t => IntRem_t
           | OpRem_f => IntRem_f
           | OpExp => IntExp
           | _ =>
             (failwithI
               (String.append "Core_eval.eval_pexpr, PEop Vinteger Vinteger: "
                 (match binop1 with
                  | OpAdd => "OpAdd"
                  | OpSub => "OpSub"
                  | OpMul => "OpMul"
                  | OpDiv => "OpDiv"
                  | OpRem_t => "OpRem_t"
                  | OpRem_f => "OpRem_f"
                  | OpExp => "OpExp"
                  | OpEq => "OpEq"
                  | OpGt => "OpGt"
                  | OpLt => "OpLt"
                  | OpGe => "OpGe"
                  | OpLe => "OpLe"
                  | OpAnd => "OpAnd"
                  | OpOr => "OpOr")) : integer_operator);
         exception_undef_return (PEval (Vobject (OVinteger (CerbMem.opIval iop1 ival1 ival2)))))
      | _, some (Vobject (OVfloating fval1)), some (Vobject (OVfloating fval2)) =>
        (let fop :=
           match binop1 with
           | OpAdd => FloatAdd
           | OpSub => FloatSub
           | OpMul => FloatMul
           | OpDiv => FloatDiv
           | _ =>
             (failwithI
               (String.append "Core_eval.eval_pexpr, PEop Vfloating Vfloating "
                 (match binop1 with
                  | OpAdd => "OpAdd"
                  | OpSub => "OpSub"
                  | OpMul => "OpMul"
                  | OpDiv => "OpDiv"
                  | OpRem_t => "OpRem_t"
                  | OpRem_f => "OpRem_f"
                  | OpExp => "OpExp"
                  | OpEq => "OpEq"
                  | OpGt => "OpGt"
                  | OpLt => "OpLt"
                  | OpGe => "OpGe"
                  | OpLe => "OpLe"
                  | OpAnd => "OpAnd"
                  | OpOr => "OpOr")) : floating_operator);
         exception_undef_return (PEval (Vobject (OVfloating (CerbMem.opFval fop fval1 fval2)))))
      | OpAnd, some v1, some v2 =>
        (let v1 :=/- Core_aux.flatten_constrained_value -/ v1;
         let v2 :=/- Core_aux.flatten_constrained_value -/ v2;
         /- TODO: factorise -/
         match v1, v2 with
         | Vtrue, Vtrue => exception_undef_return (PEval Vtrue)
         | Vtrue, Vfalse => exception_undef_return (PEval Vfalse)
         | Vfalse, Vtrue => exception_undef_return (PEval Vfalse)
         | Vfalse, Vfalse => exception_undef_return (PEval Vfalse)
         /-
              | (Vtrue, Vconstrained xs) ->
                  /- true /\ constrained v --> constrained v -/
                  EU.return (PEval (Vconstrained (List.map (fun (consts, v) -> (consts, v)) xs)))
              | (Vfalse, Vconstrained xs) ->
                  /- false /\ constrained v --> false -/
                  EU.return (PEval Vfalse)
              | (Vconstrained xs, Vtrue) ->
                  /- constrained v /\ true --> constrained v -/
                  EU.return (PEval (Vconstrained (List.map (fun (consts, v) -> (consts, v)) xs)))
              | (Vconstrained xs, Vfalse) ->
