               | Pexpr _ _ (PEval cval) =>
                 (match select_case subst_sym_pexpr cval pat_pes with
                  | some pe'' => exception_undef_return (strip1 pe'')
                  | none =>
                    (failwithI
                      (String.append "PEcase, mismatched ==> ["
                        (String.append (CerbLocation.stringFromLocation loc1)
                          (String.append "]" (CerbPP.stringFromCore_value cval)))) : exceptM
                      (t0 (generic_pexpr_ Unit sym)) core_run_cause))
               | pe' => exception_undef_return (PEcase pe' pat_pes))
           | PEarray_shift pe1 ty1 pe2 =>
             exception_undef_bind (self pe1) (fun (pe1' : generic_pexpr Unit sym) =>
               exception_undef_bind (self pe2) (fun (pe2' : generic_pexpr Unit sym) =>
                 match valueFromPexpr pe1', valueFromPexpr pe2' with
                 | some (Vobject (OVpointer ptr_val)), some (Vobject (OVinteger ival)) =>
                   exception_undef_return
                     (PEval
                       (Vobject
                         (OVpointer
                           ((CerbMem.arrayShiftPtrval _lemReader_enum_definitions
                             _lemReader_tagDefs) ptr_val ty1 ival))))
                 | some _, some _ =>
                   exception_undef_fail
                     (Illformed_program
                       (String.append "PEarray_shift: type error ==> "
                         (CerbPP.stringFromCore_pexpr
                           (Pexpr ([] : List annot) () (PEarray_shift pe1' ty1 pe2')))))
                 | _, _ => exception_undef_return (PEarray_shift pe1' ty1 pe2')))
           | PEmember_shift pe tag_sym member_ident =>
             exception_undef_bind (self pe) (fun (pe' : generic_pexpr Unit sym) =>
               match valueFromPexpr pe' with
               | some (Vobject (OVpointer ptr_val)) =>
                 exception_undef_return
                   (PEval
                     (Vobject
                       (OVpointer
                         ((CerbMem.memberShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs)
                           ptr_val tag_sym member_ident))))
               | some _ => exception_undef_fail (Illformed_program "PEmember_shift")
               | _ => exception_undef_return (PEmember_shift pe' tag_sym member_ident))
           | PEmemop memop1 pes =>
             exception_undef_bind (exception_undef_mapM self pes) (fun (pes' : List pexpr) =>
               match memop1, valueFromPexprs pes' with
