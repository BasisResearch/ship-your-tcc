          String.append "CALL_FUNCTION: "
            (CerbPP.stringFromCore_pexpr
              (Pexpr ([] : List annot) () (PEcall f_nm (List.map mk_value_pe arg_cvals))))))
    (fun _ =>
      except_bind
        (match f_nm with
         | Sym f_a =>
           (match (fmapLookupBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) f_a
                file1.stdlib) with
            | some z => /- callign a function from the Core standard library -/ except_return z
            | none =>
