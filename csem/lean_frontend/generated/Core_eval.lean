                  | PEval Vtrue => exception_undef_return (PEval Vfalse)
                  | PEval Vfalse => exception_undef_return (PEval Vtrue)
                  | PEval _ =>
                    exception_undef_fail (Illformed_program "PEnot: operand should be a boolean")
                  | _ => exception_undef_return (PEnot pe')))
           | PEop binop1 pe1 pe2 => step_eval_peop loc1 self binop1 pe1 pe2
           | PEconv_int ity pe =>
             exception_undef_bind (self pe) (fun (x : generic_pexpr Unit sym) =>
               match x with
               | Pexpr _ _ (PEval (Vobject (OVinteger ival))) =>
                 exception_undef_return
                   (PEval
                     (Vobject
                       (OVinteger
                         ((mk_conv_int _lemReader_enum_definitions _lemReader_tagDefs) ity ival))))
               | Pexpr _ _ (PEval _) =>
                 exception_undef_fail
