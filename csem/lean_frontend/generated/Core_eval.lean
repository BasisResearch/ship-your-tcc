                 some [Vobject (OVinteger ival1), Vobject (OVinteger ival2)] =>
                 exception_undef_return
                   (PEval (Vobject (OVinteger (CerbMem.deriveCap is_signed op ival1 ival2))))
               | CapAssignValue, some [Vobject (OVinteger ival1), Vobject (OVinteger ival2)] =>
                 exception_undef_return
                   (PEval (Vobject (OVinteger (CerbMem.capAssignValue loc1 ival1 ival2))))
               | Ptr_tIntValue, some [Vobject (OVinteger ival)] =>
                 exception_undef_return (PEval (Vobject (OVinteger (CerbMem.ptrTIntValue ival))))
               | ByteFromInt, some [Vobject (OVinteger ival)] =>
                 exception_undef_return (PEval (Vobject (OVinteger (CerbMem.bytefromint ival))))
               | IntFromByte, some [Vobject (OVinteger ival)] =>
                 exception_undef_return (PEval (Vobject (OVinteger (CerbMem.intfrombyte ival))))
               | _, some _ => exception_undef_fail (Illformed_program "PEmemop")
               | _, none => exception_undef_return (PEmemop memop1 pes'))
           | PEnot (pe@(Pexpr annot1 pe_bTy _)) =>
             exception_undef_bind (self pe) (fun (g : generic_pexpr Unit sym) =>
               match g with
