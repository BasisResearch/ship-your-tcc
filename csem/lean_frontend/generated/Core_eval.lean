        (match v1, v2 with
         | Vtrue, Vtrue => exception_undef_return (PEval Vtrue)
         | Vtrue, Vfalse => exception_undef_return (PEval Vtrue)
         | Vfalse, Vtrue => exception_undef_return (PEval Vtrue)
         | Vfalse, Vfalse => exception_undef_return (PEval Vfalse)
         | _, _ =>
           exception_undef_fail
             (Illformed_program
               (String.append "["
                 (String.append (CerbLocation.stringFromLocation loc1)
                   "] the two operands of \\/ should be booleans"))))
      | _, some _, some _ =>
        exception_undef_fail
          (Illformed_program
            (String.append "["
              (String.append (CerbLocation.stringFromLocation loc1)
                (String.append "] ill-typed PEop ==> "
                  (CerbPP.stringFromCore_pexpr (mk_op_pe binop1 pe1 pe2))))))
