          | Pexpr _ _ (PEval (Vconstrained xs)) ->
              EU.return (
                PEconstrained (
                  List.map (fun (cs, cval) ->
                    (cs, Caux.mk_case_pe (Caux.mk_value_pe cval) pat_pes)
