def eval_pexpr_aux2_lemFuel [LemFuel] [CerbImplCfg.Impl] (lemFuel : Nat)
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (current_call_loc_opt : Option CerbLocation.Loc) (core_extern1 : Fmap sym sym)
    (env1 : List (Fmap sym value)) (mem_st_opt : Option CerbMem.MemState)
    (file1 : generic_file Unit core_run_annotation) (pe : generic_pexpr Unit sym) :
    exceptM (t0 (Sum (generic_pexpr Unit sym) value)) core_run_cause :=
  match lemFuel with
  | 0 => (Result (Error CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg))
  | Nat.succ lemFuel =>
    ((lemSeq
      (fun _ =>
        CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
          match u with
          | () =>
            String.append "ENTERING Core_eval.eval_pexpr_aux2 ==> "
              (CerbPP.stringFromCore_pexpr pe)))
      (fun _ =>
        match let pulled := pull_constrained 0 pe;
              (lemSeq
                (fun _ =>
                  CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                    match u with
                    | () => String.append "pulled ==> " (CerbPP.stringFromCore_pexpr pulled)))
                (fun _ => pulled)) with
        | pulled_pe@((Pexpr _ () (PEconstrained _))) => exception_undef_return (Sum.inl pulled_pe)
        | pulled_pe =>
          exception_undef_bind
            ((step_eval_pexpr _lemReader_enum_definitions _lemReader_tagDefs) 0 loc1
              current_call_loc_opt core_extern1 env1 mem_st_opt file1 false pulled_pe)
            (fun (pe' : generic_pexpr Unit sym) =>
              match valueFromPexpr pe' with
              | some cval => exception_undef_return (Sum.inr cval)
              | none =>
                (eval_pexpr_aux2_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
                  loc1 current_call_loc_opt core_extern1 env1 mem_st_opt file1 pe'))))

