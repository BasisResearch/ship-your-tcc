                         (OVinteger
                           ((mk_wrapI_op _lemReader_enum_definitions _lemReader_tagDefs) ity iop1
                             ival1 ival2))))
                 | some _, some _ =>
                   exception_undef_fail
                     (Illformed_program "PEwrapI: operands should be an object integers")
                 | _, _ => exception_undef_return (PEwrapI ity iop1 pe1' pe2')))
           | PEcatch_exceptional_condition ity iop1 pe1 pe2 =>
             exception_undef_bind (self pe1) (fun (pe1' : generic_pexpr Unit sym) =>
               exception_undef_bind (self pe2) (fun (pe2' : generic_pexpr Unit sym) =>
                 match valueFromPexpr pe1', valueFromPexpr pe2' with
                 | some (Vobject (OVinteger ival1)), some (Vobject (OVinteger ival2)) =>
