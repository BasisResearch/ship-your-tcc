/- justify the result of a conversion.
   This correspond to the flag: - 0
   ASSUMES that length str < fw -/

def justify (p_opt : Option precision) (cspec : conversion_specifier) (fs : flags) (fw : Nat)
    (str : List Char) :
    List Char :=
  let d := fw - List.length str;
  /- see (§7.21.6.1#6 flag 0) -/
  let j :=
    lem_if elem cspec [CS_di, CS_o, CS_u, CS_x, CS_X] then
      lem_if fs.flag_zero && (not fs.flag_minus && isNothing p_opt) then '0' else ' '
    else lem_if elem cspec [CS_f] then
      lem_if fs.flag_zero && not fs.flag_minus then '0' else ' '
    else
      ' ';
  lem_if fs.flag_minus then str ++ List.replicate d j else List.replicate d j ++ str
