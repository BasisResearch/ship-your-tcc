           nd_bind
             ((CerbMem.loadM _lemReader_enum_definitions _lemReader_tagDefs)
               (CerbLocation.other "printf() %s") arg_ty arg_ptr)
             (fun (p : (CerbMem.Footprint × CerbMem.MemValue)) =>
               match p with
               | (_, mval) =>
                 (let prec :=
                    match prec_opt with
                    | some (P_num z) => some z
                    | some P_asterisk =>
                      (failwithI "TODO(2): Formatted.convert, * prec" : Option Nat) /- TODO -/
                    | none => none;
                  lem_if isUnspecifiedMemValue mval then
                    nd_return (Sum.inr (undef loc1 [UB_unspecified_lvalue]))
                  else
                    match pointerValueFromMemValue mval with
                    | some (_, ptrval) =>
                      nd_bind
                        ((load_character_array _lemReader_enum_definitions _lemReader_tagDefs)
                          ref_ty ptrval prec)
                        (fun (chars : List Char) =>
                          nd_return (Sum.inr (Defined (false, chars, args'))))
                    | none =>
                      (failwithI "WIP[error message], Formatted => CS_s, didn't load a pointer" :
                        ndM
                        (Sum (CerbLocation.Loc × cause)
                          (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue)))) String
                        mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState))))
       | (ty1, pe) :: _ =>
         (failwithI
           (String.append "WIP, Formatted => CS_s, ty <> Pointer ==> "
             (stringFromPair CerbPP.stringFromCore_ctype CerbPP.stringFromMem_mem_value
               (ty1, CerbMem.pointerMval ty1 pe))) : ndM
           (Sum (CerbLocation.Loc × cause)
             (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue)))) String mem_error
           (mem_constraint CerbMem.IntegerValue) CerbMem.MemState)))
  | CS_p =>
    (let do_common : ctype → CerbMem.PointerValue → List (ctype × CerbMem.PointerValue) → ndM
       (Sum (CerbLocation.Loc × cause)
         (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue)))) String mem_error
       (mem_constraint CerbMem.IntegerValue) CerbMem.MemState :=
       (fun (arg_ty : ctype) (arg_ptr : CerbMem.PointerValue)
         (args' : List (ctype × CerbMem.PointerValue)) =>
         nd_bind
           ((CerbMem.loadM _lemReader_enum_definitions _lemReader_tagDefs)
             (CerbLocation.other "printf() %p") arg_ty arg_ptr)
           (fun (p : (CerbMem.Footprint × CerbMem.MemValue)) =>
             match p with
             | (_, mval) =>
               (lem_if isUnspecifiedMemValue mval then
                 nd_return (Sum.inr (undef loc1 [UB_unspecified_lvalue]))
               else
                 match pointerValueFromMemValue mval with
                 | some (_, ptrval) =>
                   nd_return
                     (Sum.inr
                       (Defined
                         (false,
                           String.toList (CerbPP.stringFromPointerValue flags3.flag_hash ptrval),
                           args')))
                 | none =>
                   (failwithI "WIP[error message], Formatted => CS_p, didn't load a pointer" : ndM
                     (Sum (CerbLocation.Loc × cause)
                       (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue)))) String
                     mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState))));
     let do_illtyped := nd_return (Sum.inr (undef loc1 [UB153b_illtyped_argument_for_format]));
     match args with
     | [] => nd_return (Sum.inr (undef loc1 [UB153a_insufficient_arguments_for_format]))
     | (arg_ty@(Ctype _ (Pointer _ (Ctype _ Void0))), arg_ptr) :: args' =>
       do_common arg_ty arg_ptr args'
     | (arg_ty@(Ctype _ (Pointer _ _)), arg_ptr) :: args' =>
       (lem_if CerbGlobal.has_switch CerbGlobal.CerbSwitch.permissive_printf then
         do_common arg_ty arg_ptr args'
       else
         do_illtyped)
     | _ => do_illtyped)
  | CS_n =>
    (failwithI "WIP: Formatted.convert, CS_n" : ndM
      (Sum (CerbLocation.Loc × cause) (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue))))
      String mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState)
  | CS_percent => /- TODO: it seems that if there is a length, modif, flags, precision, ... it is undefined behaviour .... -/
    nd_return (Sum.inr (Defined (false, ['%'], args)))
  /- Ctype.ctype -> -/

def printf_aux [LemFuel] [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (eval_conv : ctype → CerbMem.MemValue → memM (Sum error (t0 value))) (acc : List Char)
    (fs : List format_) (ty_ptrvals : List (ctype × CerbMem.PointerValue)) :
    ndM (Sum (CerbLocation.Loc × cause) (t0 (List Char))) String mem_error
        (mem_constraint CerbMem.IntegerValue) CerbMem.MemState :=
  match fs, ty_ptrvals with
  | F_text str :: fs, ty_ptrvals =>
    (printf_aux _lemReader_enum_definitions _lemReader_tagDefs) loc1 eval_conv (acc ++ str) fs
      ty_ptrvals
  | F_conv cp :: fs, ty_ptrvals =>
    nd_bind
      ((convert _lemReader_enum_definitions _lemReader_tagDefs) loc1 eval_conv cp.cp_precision
        cp.cp_length_modifier cp.cp_conversion_specifier cp.cp_flags ty_ptrvals)
      (fun (x : Sum (CerbLocation.Loc × cause)
        (t0 (Bool × List Char × List (ctype × CerbMem.PointerValue)))) =>
        match x with
        | Sum.inr (Defined (is_zero, str, ty_ptrvals')) =>
          (let hash_CSs :=
             lem_if CerbGlobal.is_CHERI () then
               [CS_o, CS_x, CS_X, CS_f,
                 CS_p] /- NON-STD: CHERI supports # for the %p conversion specifier -/
             else
               [CS_o, CS_x, CS_X, CS_f];
           lem_if cp.cp_flags.flag_plus && not
               (isSignedConversion
                 cp.cp_conversion_specifier) then /- TODO: add a proper UB variant -/
             nd_return
               (Sum.inr
                 (undef loc1
                   [DUMMY
                     "+ flag with unsigned conversion"])) /- TODO: CS_F | CS_e | CS_E | CS_g | CS_G | CS_a | CS_A -/
           else lem_if cp.cp_flags.flag_hash && not
               (Lem_List.elem cp.cp_conversion_specifier hash_CSs) then
             nd_return (Sum.inr (undef loc1 [UB157]))
           else lem_if cp.cp_flags.flag_zero && not
               (Lem_List.elem cp.cp_conversion_specifier [CS_di, CS_o, CS_u, CS_x, CS_X, CS_f]) then
             nd_return (Sum.inr (undef loc1 [UB157]))
           else
             let expanded := expand is_zero cp.cp_flags cp.cp_conversion_specifier str;
             let justified :=
               match cp.cp_field_width with
               | none => expanded
               | some (FW_num fw) =>
                 (lem_if natLtb (List.length expanded) fw then
                   justify cp.cp_precision cp.cp_conversion_specifier cp.cp_flags fw expanded
                 else
                   expanded)
               | some FW_asterisk => (failwithI "TODO: formatted.lem 6" : List Char);
             (printf_aux _lemReader_enum_definitions _lemReader_tagDefs) loc1 eval_conv
               (acc ++ justified) fs ty_ptrvals')
        | Sum.inr (Error loc1 str) => nd_return (Sum.inr (Error loc1 str))
        | Sum.inr (Undef loc1 ubs) => nd_return (Sum.inr (Undef loc1 ubs))
        | Sum.inl err =>
          ((lemSeq
            (fun _ =>
              CerbDebug.print_debug_pure 1 ([] : List domain) (fun (u : Unit) =>
                match u with
                | () => "PRINTF ERR 2")) (fun _ => nd_return (Sum.inl err)))))
  | _, _ => nd_return (Sum.inr (return1 acc))

/- Structural on the format list `fs` (both recursive calls pass a
   tail); recursion under monadic continuations — Lean derives it
   (threadB finding 3). -/

def store_chars_in_array [LemFuel] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (zero_terminated : Bool)
    (ptrval : CerbMem.PointerValue) :
    List Char → ndM Unit String mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState :=
  fun (x : List Char) =>
    match x with
    | [] =>
      (lem_if zero_terminated then
        nd_bind
          ((CerbMem.storeM _lemReader_enum_definitions _lemReader_tagDefs)
            (CerbLocation.other "store_chars_in_array()") char0 false ptrval
            (CerbMem.integerValueMval Char0 (CerbMem.integerIval ((0 : Int)))))
          (fun (_ : CerbMem.Footprint) => nd_return ())
      else
        nd_return ())
    | c :: cs =>
      (let c_mval :=
         CerbMem.integerValueMval Char0
           (CerbMem.integerIval (CerbDecode.decode_character_constant (CerbDecode.escaped_char c)));
       nd_bind
         (/- TODO: maybe needs to be unsigned char -/ (CerbMem.storeM _lemReader_enum_definitions
           _lemReader_tagDefs) (CerbLocation.other "store_chars_in_array()") char0 false ptrval
           c_mval)
         (fun (_ : CerbMem.Footprint) =>
           nd_bind
             (lem_if CerbGlobal.is_CHERI () then
               (CerbMem.effArrayShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs)
                 (CerbLocation.other "store_chars_in_array()") ptrval char0
                 (CerbMem.integerIval ((1 : Int)))
             else
               nd_return
                 ((CerbMem.arrayShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs) ptrval
                   char0 (CerbMem.integerIval ((1 : Int)))))
             (fun (ptrval' : CerbMem.PointerValue) =>
               (store_chars_in_array _lemReader_enum_definitions _lemReader_tagDefs) zero_terminated
                 ptrval' cs)))

/- Structural on the char list (tail per step, pointer re-bound);
   recursion under monadic continuations — Lean derives it. -/
/- Ctype.ctype -> -/

def vsnprintf [LemFuel] [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (eval_conv : ctype → CerbMem.MemValue → memM (Sum error (t0 value)))
    (s_ptrval : CerbMem.PointerValue) (n_ival : CerbMem.IntegerValue) (frmt : List Char)
    (ap_idx : Int) :
    ndM (Sum (CerbLocation.Loc × cause) (t0 Int)) String mem_error
        (mem_constraint CerbMem.IntegerValue) CerbMem.MemState :=
  let n :=
    CerbMem.caseIntegerValue n_ival (fun (n : Int) => n) (fun (u : Unit) =>
      match u with
      | () => (failwithI "TODO: vsnprintf(), symbolic value for the size n" : Int));
  /- TODO: overlap undefined behaviour -/ lem_if n == (0 : Int) then
    nd_return (Sum.inr (return1 ((0 : Int))))
  else
    match parse format0 frmt with
    | [(fs, [])] =>
      nd_bind (CerbMem.vaList ap_idx) (fun (args : List (ctype × CerbMem.PointerValue)) =>
        nd_bind
          ((printf_aux _lemReader_enum_definitions _lemReader_tagDefs) loc1 eval_conv
            ([] : List Char) fs args)
          (fun (x : Sum (CerbLocation.Loc × cause) (t0 (List Char))) =>
            match x with
            | Sum.inr (Defined cs) =>
              (let cs' := List.take (Int.natAbs (lemIntFromInteger (n - (1 : Int)))) cs;
               nd_bind
                 ((store_chars_in_array _lemReader_enum_definitions _lemReader_tagDefs) true
                   s_ptrval cs')
                 (fun (u : Unit) =>
                   match u with
                   | () => nd_return (Sum.inr (return1 (Int.ofNat (List.length cs'))))))
            | _ =>
              (failwithI "TODO: snprintf()" : ndM (Sum (CerbLocation.Loc × cause) (t0 Int)) String
                mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState)))
    | _ => nd_return (Sum.inr (undef loc1 [Invalid_format (String.ofList frmt)]))

