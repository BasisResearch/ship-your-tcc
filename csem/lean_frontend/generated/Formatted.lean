/- if the given flags require it, prefix the given result of the conversion with
   a sign or space or convert it to an "alternative form".
   This correspond to the flags: + space # -/

def expand (is_zero : Bool) (fs : flags) (cspec : conversion_specifier) (str : List Char) :
    List Char := /- first doing the # flag -/
  let str :=
    lem_if fs.flag_hash then
      match cspec with
      | CS_o => (lem_if isPrefixOf ['0'] str then str else '0' :: str)
      | CS_x => (lem_if is_zero then str else '0' :: ('x' :: str))
      | CS_X => (lem_if is_zero then str else '0' :: ('X' :: str))
      | _ => /- NOTE: must be a, A, e, E, f, F, g, or G -/ /- NOTE: this is checked earlier -/ /- TODO: not doing the right thing for now -/
        str
    else
      str;
  lem_if isPrefixOf ['-'] str then
    str
  else lem_if fs.flag_plus then '+' :: str else lem_if fs.flag_space then ' ' :: str else str
