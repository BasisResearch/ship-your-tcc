/- Unbounded memory-walk recursion (reads until NUL or the precision
   bound; no structural decrease): fuel, threadB recipe. Sentinel =
   the empty-result memM, reached only through the LOUD fuelExhausted
   panic. -/
/- FUEL-PARAMETER ARC C2 (2026-09-04; Lean-only): the memory walk's exhaustion
   payload is the ND monad's ABSORBING kill at the fuel atom (as the driver
   family's), never `nd_return []` — a value printf would continue with. -/

def load_character_array [LemFuel] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (elem_ty : ctype)
    (ptrval : CerbMem.PointerValue) (prec_n_opt : Option Nat) :
    ndM (List Char) String mem_error (mem_constraint CerbMem.IntegerValue) CerbMem.MemState :=
  nd_bind
    (lem_if CerbGlobal.is_CHERI () then
      (CerbMem.effArrayShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs)
        (CerbLocation.other "printf()") ptrval elem_ty (CerbMem.integerIval ((0 : Int)))
    else
      nd_return
        ((CerbMem.arrayShiftPtrval _lemReader_enum_definitions _lemReader_tagDefs) ptrval elem_ty
          (CerbMem.integerIval ((0 : Int)))))
    (fun (ptrval' : CerbMem.PointerValue) =>
      (load_character_array_aux _lemReader_enum_definitions _lemReader_tagDefs) elem_ty ptrval'
        prec_n_opt ([] : List Char))

def is_illtyped_conversion (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (expected_ty : ctype)
    (arg_ty : ctype) :
    Bool :=
  let arg_ty' :=(normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) arg_ty;
  lem_if ctypeEqual expected_ty arg_ty' then
    false
  else
    match expected_ty, arg_ty' with
    | Ctype _ (Basic (Integer expected_ity)), Ctype _ (Basic (Integer Size_t)) =>
      not ((is_compatible_with_size_t _lemReader_enum_definitions _lemReader_tagDefs) expected_ity)
    | Ctype _ (Basic (Integer expected_ity)), Ctype _ (Basic (Integer Ptrdiff_t)) =>
      not
        ((is_compatible_with_ptrdiff_t _lemReader_enum_definitions _lemReader_tagDefs) expected_ity)
    | _, _ => true

