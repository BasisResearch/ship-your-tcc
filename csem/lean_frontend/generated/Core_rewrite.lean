  | expr1@(Expr annot1 expr_) =>
    (match expr_ with
     | Epure pe => /- unchanged -/ expr1
     | Ememop _ _ => /- unchanged -/ expr1
     | Eaction _ => /- unchanged -/ expr1
     | Ecase pe pat_es => /- just traversing -/
       Expr annot1
         (Ecase pe
           (List.map
             (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
               match p with
