partial def isAlwaysDefined { a b : Type } (g : generic_pexpr b a) : Bool :=
  match g with
  | (Pexpr _ _ pexpr_) =>
    (match pexpr_ with
     | PEsym _ => true
     | PEimpl _ => true /- TODO: check -/
     | PEval _ => true
     | PEconstrained xs =>
       List.all xs (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr b a)) =>
         match p with
         | (_, pe) => isAlwaysDefined pe)
     | PEundef _ _ => false
     | PEerror _ _ => false
     | PEctor _ pes => List.all pes isAlwaysDefined
     | PEcase pe pat_pes =>
       isAlwaysDefined pe && List.all pat_pes (fun (p : (generic_pattern a × generic_pexpr b a)) =>
         match p with
         | (_, pe) => isAlwaysDefined pe)
     | PEarray_shift pe1 _ pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2
     | PEmember_shift pe _ _ => isAlwaysDefined pe
     | PEmemop mop pes =>
       (/- NOTE: doing this in case we ever add new memops that can be UB -/ (lemSeq
         (fun _ =>
           match mop with
           | DeriveCap _ _ => ()
           | CapAssignValue => ()
           | Ptr_tIntValue => ()
           | ByteFromInt => ()
           | IntFromByte => ()) (fun _ => List.all pes isAlwaysDefined)))
     | PEnot pe => isAlwaysDefined pe
     | PEop _ pe1 pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2
     | PEconv_int _ pe => isAlwaysDefined pe
     | PEwrapI _ _ pe1 pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2
     | PEcatch_exceptional_condition _ _ pe1 pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2
     | PEstruct _ ident_pes =>
       List.all ident_pes (fun (p : (identifier × generic_pexpr b a)) =>
         match p with
         | (_, pe) => isAlwaysDefined pe)
     | PEunion _ _ pe => isAlwaysDefined pe
     | PEcfunction pe => isAlwaysDefined pe
     | PEmemberof _ _ pe => isAlwaysDefined pe
     | PEcall _ pes => /- the called function may raise an undef/error -/
       false /- List.all isAlwaysDefined pes -/
     | PElet _ pe1 pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2
     | PEif pe1 pe2 pe3 => isAlwaysDefined pe1 && (isAlwaysDefined pe2 && isAlwaysDefined pe3)
     | PEis_scalar pe => isAlwaysDefined pe
     | PEis_integer pe => isAlwaysDefined pe
     | PEis_signed pe => isAlwaysDefined pe
     | PEis_unsigned pe => isAlwaysDefined pe
     | PEbmc_assume _ => false
     | PEare_compatible pe1 pe2 => isAlwaysDefined pe1 && isAlwaysDefined pe2)

partial def pure_propagation2 { a : Type } (g : generic_expr a Unit sym) :
    generic_expr a Unit sym :=
  match g with
  | expr1@(Expr annot1 expr_) =>
    (let to_pure' : generic_expr a Unit sym → Option (generic_pexpr Unit sym) :=
       (fun (e : generic_expr a Unit sym) =>
         match to_pure e with
         | some pe => (lem_if isAlwaysDefined pe then some pe else none)
         | none => none);
     let to_pures' : List (generic_expr a Unit sym) → Option (List (generic_pexpr Unit sym)) :=
       (fun (es : List (generic_expr a Unit sym)) =>
         lemListFoldr
           (fun (e : generic_expr a Unit sym) (acc_opt : Option (List (generic_pexpr Unit sym))) =>
             match to_pure' e, acc_opt with
             | some pe, some acc => some (pe :: acc)
             | _, _ => none) (some ([] : List (generic_pexpr Unit sym))) es);
     match expr_ with
     | Epure _ => expr1
     | Ememop _ _ => expr1
     | Eaction _ => expr1
     | Ecase pe pat_es =>
       (/- TODO: do more -/
       let pat_es' :=
         List.map
           (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
             match p with
             | (pat, e) => (pat, pure_propagation2 e)) pat_es;
       Expr annot1 (Ecase pe pat_es'))
     | Elet pat pe1 e2 =>
       (let e2' := pure_propagation2 e2;
        match to_pure' e2' with
        | some (pe2@(Pexpr annot1 bTy _)) => /- TODO: loosing std annot -/
          mk_pure_e (Pexpr annot1 bTy (PElet pat pe1 pe2))
        | none => Expr annot1 (Elet pat pe1 e2'))
     | Eif pe1 e2 e3 =>
       (let e2' := pure_propagation2 e2;
        let e3' := pure_propagation2 e3;
        match to_pure' e2', to_pure' e3' with
        | some (pe2@(Pexpr annot1 bTy _)), some pe3 => /- TODO: loosing std annot -/
          mk_pure_e (Pexpr annot1 bTy (PEif pe1 pe2 pe3))
        | some pe2, none => Expr annot1 (Eif pe1 (mk_pure_e pe2) e3')
        | none, some pe3 => Expr annot1 (Eif pe1 e2' (mk_pure_e pe3))
        | none, none => Expr annot1 (Eif pe1 e2' e3'))
     | Eccall _ _ _ _ => expr1
     | Eproc _ _ _ => expr1
     | Eunseq es =>
       (/- TODO: do better -/
       let es' := List.map pure_propagation2 es;
       match to_pures' es' with
       | some pes => mk_pure_e (mk_tuple_pe pes)
       | none =>
         (let es'' :=
            List.map
              (fun (e : generic_expr a Unit sym) =>
                match to_pure' e with
                | some pe => mk_pure_e pe
                | none => e) es';
          Expr annot1 (Eunseq es'')))
     /-
    | Ewseq (Pattern annot_ctor (CaseCtor Ctuple pats)) (Expr annot_unseq (Eunseq es)) e2 ->
        let (cont, pats', es') =
          List.foldr (fun (pat, e) (cont, pats_acc, es_acc) ->
            let e = (pure_propagation2 e) in
            match to_pure' e with
              | Just pe ->
                  (fun z -> unsafe_subst_pattern pat pe (cont z), pats_acc, es_acc)
              | Nothing ->
                  (cont, pat :: pats_acc, e :: es_acc)
            end) (id, [], []) (List.zip pats es) in
       match (pats', es') with
         | ([], []) ->
             pure_propagation2 (cont e2)
         | ([pat'], [e']) ->
             Expr annot (Ewseq pat' e' (pure_propagation2 (cont e2)))
         | _ ->
             Expr annot (Ewseq (Pattern annot_ctor (CaseCtor Ctuple pats')) (Expr annot_unseq (Eunseq es')) (pure_propagation2 (cont e2)))
       end
       -/
     | Ewseq pat e1 e2 =>
       (let e1' := pure_propagation2 e1;
        match to_pure' e1' with
        | some pe1 =>
          (match subst_pattern pat pe1 e2 with
           | some e => pure_propagation2 e
           | none =>
             Expr annot1
               (Ewseq pat e1'
                 (pure_propagation2 e2))) /- pure_propagation2 (unsafe_subst_pattern pat pe1 e2) -/
        | none => Expr annot1 (Ewseq pat e1' (pure_propagation2 e2)))
     /-
    | Esseq (Pattern annot_ctor (CaseCtor Ctuple pats)) (Expr annot_unseq (Eunseq es)) e2 ->
        let (cont, pats', es') =
          List.foldr (fun (pat, e) (cont, pats_acc, es_acc) ->
            let e = (pure_propagation2 e) in
            match to_pure' e with
              | Just pe ->
                  (fun z -> unsafe_subst_pattern pat pe (cont z), pats_acc, es_acc)
              | Nothing ->
                  (cont, pat :: pats_acc, e :: es_acc)
            end) (id, [], []) (List.zip pats es) in
       match (pats', es') with
         | ([], []) ->
             pure_propagation2 (cont e2)
         | ([pat'], [e']) ->
             Expr annot (Esseq pat' e' (pure_propagation2 (cont e2)))
         | _ ->
             Expr annot (Esseq (Pattern annot_ctor (CaseCtor Ctuple pats')) (Expr annot_unseq (Eunseq es')) (pure_propagation2 (cont e2)))
       end
       -/
     | Esseq pat e1 e2 =>
       (let e1' := pure_propagation2 e1;
        match to_pure' e1' with
        | some pe1 =>
          (match subst_pattern pat pe1 e2 with
           | some e => pure_propagation2 e
           | none =>
             Expr annot1
               (Esseq pat e1'
                 (pure_propagation2 e2))) /- pure_propagation2 (unsafe_subst_pattern pat pe1 e2) -/
        | none => Expr annot1 (Esseq pat e1' (pure_propagation2 e2)))
     | Ebound e => Expr annot1 (Ebound (pure_propagation2 e))
     | End es => Expr annot1 (End (List.map pure_propagation2 es))
     | Esave sym1 sym_tys e => Expr annot1 (Esave sym1 sym_tys (pure_propagation2 e))
     | Erun _ _ _ => expr1
     | Epar es => Expr annot1 (Epar (List.map pure_propagation2 es))
     | Ewait _ => expr1
     | Eannot xs e => Expr annot1 (Eannot xs (pure_propagation2 e))
     | Eexcluded _ _ => expr1)

