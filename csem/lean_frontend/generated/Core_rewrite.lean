     | Elet pat pe1 e2 => /- just traversing -/ Expr annot1 (Elet pat pe1 (remove_skips e2))
     | Eif pe1 e2 e3 => /- just traversing -/
       Expr annot1 (Eif pe1 (remove_skips e2) (remove_skips e3))
     | Eccall _ _ _ _ => /- unchanged -/ expr1
     | Eproc _ _ _ => /- unchanged -/ expr1
     | Eunseq es => /- just traversing -/ Expr annot1 (Eunseq (List.map remove_skips es))
