/- returns a Right iff the expression always ends with a return() -/

def extract_either { a : Type } : Sum a a → a :=
  fun (x : Sum a a) =>
    match x with
    | Sum.inl z => z
    | Sum.inr z => z

partial def remove_dead_aux { a b c : Type } (g : generic_expr c b a) :
    Sum (generic_expr c b a) (generic_expr c b a) :=
  match g with
  | expr1@(Expr annot1 expr_) =>
    (match expr_ with
     | Epure _ => Sum.inl expr1
     | Ememop _ _ => Sum.inl expr1
     | Eaction _ => Sum.inl expr1
     | Ecase pe pat_es =>
       (let aux : (generic_pattern a × generic_expr c b a) → Sum
          (generic_pattern a × generic_expr c b a) (generic_pattern a × generic_expr c b a) :=
          (fun (p : (generic_pattern a × generic_expr c b a)) =>
            match p with
            | (pat, e) =>
              Lem_Either.either0 (fun (e' : generic_expr c b a) => Sum.inl (pat, e'))
                (fun (e' : generic_expr c b a) => Sum.inr (pat, e')) (remove_dead_aux e));
        let _rev_pat_es' :=
          List.foldl
            (fun (_acc : Sum (List (generic_pattern a × generic_expr c b a))
              (List (generic_pattern a × generic_expr c b a)))
              (_pat_e' : Sum (generic_pattern a × generic_expr c b a)
                (generic_pattern a × generic_expr c b a)) =>
              match _pat_e', _acc with
              | Sum.inr pat_e', Sum.inr acc => Sum.inr (pat_e' :: acc)
              | _, _ => Sum.inl ((extract_either _pat_e') :: (extract_either _acc))) (Sum.inr [])
            (List.map aux pat_es);
        match _rev_pat_es' with
        | Sum.inl rev_pat_es' => Sum.inl (Expr annot1 (Ecase pe (List.reverse rev_pat_es')))
        | Sum.inr rev_pat_es' => Sum.inr (Expr annot1 (Ecase pe (List.reverse rev_pat_es'))))
     | Elet pat pe1 e2 =>
       (match remove_dead_aux e2 with
        | Sum.inl e2' => Sum.inl (Expr annot1 (Elet pat pe1 e2'))
        | Sum.inr e2' => Sum.inr (Expr annot1 (Elet pat pe1 e2')))
     | Eif pe1 e2 e3 =>
       (match remove_dead_aux e2, remove_dead_aux e3 with
        | Sum.inr e2', Sum.inr e3' => Sum.inr (Expr annot1 (Eif pe1 e2' e3'))
        | Sum.inl e2', Sum.inr e3' => Sum.inl (Expr annot1 (Eif pe1 e2' e3'))
        | Sum.inr e2', Sum.inl e3' => Sum.inl (Expr annot1 (Eif pe1 e2' e3'))
        | Sum.inl e2', Sum.inl e3' => Sum.inl (Expr annot1 (Eif pe1 e2' e3')))
     | Eccall _ _ _ _ => Sum.inl expr1
     | Eproc _ _ _ => Sum.inl expr1
     | Eunseq es =>
       (let _es' := List.map remove_dead_aux es;
        /- TODO: this is inefficient (but readable) see Ecase, End, Epar for the
           unreadable but efficient alternative. We should rewrite some
           combinator for either -/
        lem_if List.all _es' (fun (x : Sum (generic_expr c b a) (generic_expr c b a)) =>
            match x with
            | Sum.inr _ => true
            | Sum.inl _ => false) then
          Sum.inr (Expr annot1 (Eunseq (List.map extract_either _es')))
        else
          Sum.inl (Expr annot1 (Eunseq (List.map extract_either _es'))))
     | Ewseq _as e1 e2 =>
       (match remove_dead_aux e1 with
        | Sum.inl e1' =>
          (match remove_dead_aux e2 with
           | Sum.inl e2' => Sum.inl (Expr annot1 (Ewseq _as e1' e2'))
           | Sum.inr e2' => Sum.inr (Expr annot1 (Ewseq _as e1' e2')))
        | Sum.inr e1' => Sum.inr e1')
     | Esseq _as e1 e2 =>
       (match remove_dead_aux e1 with
        | Sum.inl e1' =>
          (match remove_dead_aux e2 with
           | Sum.inl e2' => Sum.inl (Expr annot1 (Esseq _as e1' e2'))
           | Sum.inr e2' => Sum.inr (Expr annot1 (Esseq _as e1' e2')))
        | Sum.inr e1' => Sum.inr e1')
     | Ebound e =>
       (match remove_dead_aux e with
        | Sum.inl e' => Sum.inl (Expr annot1 (Ebound e'))
        | Sum.inr e' => Sum.inr (Expr annot1 (Ebound e')))
     | End es =>
       (let _rev_es' :=
          List.foldl
            (fun (_acc : Sum (List (generic_expr c b a)) (List (generic_expr c b a)))
              (_e' : Sum (generic_expr c b a) (generic_expr c b a)) =>
              match _e', _acc with
              | Sum.inr e', Sum.inr acc => Sum.inr (e' :: acc)
              | _, _ => Sum.inl ((extract_either _e') :: (extract_either _acc))) (Sum.inr [])
            (List.map remove_dead_aux es);
        match _rev_es' with
        | Sum.inl rev_es' => Sum.inl (Expr annot1 (End (List.reverse rev_es')))
        | Sum.inr rev_es' => Sum.inr (Expr annot1 (End (List.reverse rev_es'))))
     | Esave sym_bTy sym_bTy_pes e =>
       (match remove_dead_aux e with
        | Sum.inl e' => Sum.inl (Expr annot1 (Esave sym_bTy sym_bTy_pes e'))
        | Sum.inr e' => Sum.inr (Expr annot1 (Esave sym_bTy sym_bTy_pes e')))
     | Erun _ _ _ => Sum.inl expr1
     | Epar es =>
       (let _rev_es' :=
          List.foldl
            (fun (_acc : Sum (List (generic_expr c b a)) (List (generic_expr c b a)))
              (_e' : Sum (generic_expr c b a) (generic_expr c b a)) =>
              match _e', _acc with
              | Sum.inr e', Sum.inr acc => Sum.inr (e' :: acc)
              | _, _ => Sum.inl ((extract_either _e') :: (extract_either _acc))) (Sum.inr [])
            (List.map remove_dead_aux es);
        match _rev_es' with
        | Sum.inl rev_es' => Sum.inl (Expr annot1 (Epar (List.reverse rev_es')))
        | Sum.inr rev_es' => Sum.inr (Expr annot1 (Epar (List.reverse rev_es'))))
     | Ewait _ => Sum.inl expr1
     | Eannot xs e =>
       (match remove_dead_aux e with
        | Sum.inl e' => Sum.inl (Expr annot1 (Eannot xs e'))
        | Sum.inr e' => Sum.inr (Expr annot1 (Eannot xs e')))
     | Eexcluded _ _ => Sum.inl expr1)

def remove_dead { a b c : Type } (expr1 : generic_expr a b c) : generic_expr a b c :=
  match remove_dead_aux expr1 with
  | Sum.inl expr' => expr'
  | Sum.inr expr' => expr'

partial def flatten_seqs { a b c : Type } (g : generic_expr c b a) : generic_expr c b a :=
  match g with
  | expr1@(Expr annot1 expr_) =>
    (match expr_ with
     | Epure _ => expr1
     | Ememop _ _ => expr1
     | Eaction _ => expr1
     | Ecase pe pat_es =>
       Expr annot1
         (Ecase pe
           (List.map
             (fun (p : (generic_pattern a × generic_expr c b a)) =>
               match p with
               | (pat, e) => (pat, flatten_seqs e)) pat_es))
     | Elet pat pe1 e2 => Expr annot1 (Elet pat pe1 (flatten_seqs e2))
     | Eif pe1 e2 e3 => Expr annot1 (Eif pe1 (flatten_seqs e2) (flatten_seqs e3))
     | Eccall _ _ _ _ => expr1
     | Eproc _ _ _ => expr1
     | Eunseq es => Expr annot1 (Eunseq (List.map flatten_seqs es))
     | Ewseq (Pattern _ (CaseBase (none, _))) (Expr _ (Epure (Pexpr _ _ (PEval Vunit))))
       e2 => /- TODO: could be generalised to any "always defined" Epure -/
       flatten_seqs e2
     | Ewseq pat e1 e2 =>
       (match flatten_seqs e1, flatten_seqs e2 with
        | Expr annot11 (Ewseq pat1 e11 e12), e2' =>
          Expr annot11 (Ewseq pat1 e11 (flatten_seqs (Expr annot1 (Ewseq pat e12 e2'))))
        /-
          | (Expr annot1 (Esseq pat1 e11 e12), e2') ->
              Expr annot1 (Esseq pat1 e11 (flatten_seqs (Expr annot (Ewseq pat e12 e2'))))
-/
        | e1', e2' => Expr annot1 (Ewseq pat e1' e2'))
     | Esseq (Pattern _ (CaseBase (none, _))) (Expr _ (Epure (Pexpr _ _ (PEval Vunit))))
       e2 => /- TODO: could be generalised to any "always defined" Epure -/
       flatten_seqs e2
     | Esseq pat e1 e2 =>
       (match flatten_seqs e1, flatten_seqs e2 with
        /- THIS IS WRONG, shouldn't lift a wseq past a sseq
          | (Expr annot1 (Ewseq pat1 e11 e12), e2') ->
              Expr annot1 (Ewseq pat1 e11 (flatten_seqs (Expr annot (Esseq pat e12 e2'))))
-/
        | Expr annot11 (Esseq pat1 e11 e12), e2' =>
          Expr annot11 (Esseq pat1 e11 (flatten_seqs (Expr annot1 (Esseq pat e12 e2'))))
        | e1', e2' => Expr annot1 (Esseq pat e1' e2'))
     | Ebound e => Expr annot1 (Ebound (flatten_seqs e))
     | End es => Expr annot1 (End (List.map flatten_seqs es))
     | Esave sym1 sym_bTys e => Expr annot1 (Esave sym1 sym_bTys (flatten_seqs e))
     | Erun _ _ _ => expr1
     | Epar es => Expr annot1 (Epar (List.map flatten_seqs es))
     | Ewait _ => expr1
     | Eannot xs e => Expr annot1 (Eannot xs (flatten_seqs e))
     | Eexcluded _ _ => expr1)
