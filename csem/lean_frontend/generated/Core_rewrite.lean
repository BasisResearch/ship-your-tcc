partial def simpl_match_pattern { a : Type } (g : generic_pattern a) (pe : generic_pexpr Unit sym) :
    Option (List (a × generic_pexpr Unit sym)) :=
  match g, pe with
  | (Pattern _ pat), pe =>
    (lem_if not (isAlwaysDefined pe) then
      none
    else
      match pat, pe with
      /-
    | (_, Pexpr _ (PEval cval)) ->
        List.map (fun (sym, cval) ->
          (sym, Pexpr (bTy (PEval
        ) (Caux.match_pattern pat cval)
-/
      | CaseBase (none, _), _ => some []
      | CaseBase (some sym1, _), _ => some [(sym1, pe)]
      | CaseCtor Cspecified [pat'], Pexpr _ _ (PEval (Vloaded (LVspecified cval))) =>
        simpl_match_pattern pat' (mk_value_pe (Vobject cval))
      | CaseCtor Cspecified [pat'], Pexpr _ _ (PEctor Cspecified [pe']) =>
        simpl_match_pattern pat' pe'
      /-
    | (CaseCtor Cunspecified [pat'], Vloaded (LVunspecified ty)) ->
        match_pattern pat' (Vctype ty)
-/
      | CaseCtor Ctuple pats', Pexpr _ _ (PEval (Vtuple cvals)) =>
        (lem_if not ((List.length pats') == (List.length cvals)) then
          none
        else
          lemListFoldr
            (fun (p : (generic_pattern a × value))
              (acc : Option (List (a × generic_pexpr Unit sym))) =>
              match p, acc with
              | (pat', cval), acc =>
                Lem_Maybe.bind0 acc (fun (xs : List (a × generic_pexpr Unit sym)) =>
                  Lem_Maybe.bind0 (simpl_match_pattern pat' (mk_value_pe cval))
                    (fun (x : List (a × generic_pexpr Unit sym)) => some (x ++ xs)))) (some [])
            (lemListZip pats' cvals))
      | CaseCtor Ctuple pats', Pexpr _ _ (PEctor Ctuple pes') =>
        (lem_if not ((List.length pats') == (List.length pes')) then
          none
        else
          lemListFoldr
            (fun (p : (generic_pattern a × generic_pexpr Unit sym))
              (acc : Option (List (a × generic_pexpr Unit sym))) =>
              match p, acc with
              | (pat', pe'), acc =>
                Lem_Maybe.bind0 acc (fun (xs : List (a × generic_pexpr Unit sym)) =>
                  Lem_Maybe.bind0 (simpl_match_pattern pat' pe')
                    (fun (x : List (a × generic_pexpr Unit sym)) => some (x ++ xs)))) (some [])
            (lemListZip pats' pes'))
      | _, _ => none)

partial def simpl_select_case { a b : Type } (unsafe_subst_sym : b → generic_pexpr Unit sym → a → a)
    (match_pe : generic_pexpr Unit sym) :
    List (generic_pattern b × a) → Option a :=
  fun (x : List (generic_pattern b × a)) =>
    match x with
    | [] => none
    | (pat, e) :: pat_es' =>
      (match simpl_match_pattern pat match_pe with
       | none => /- trying the next branch -/ simpl_select_case unsafe_subst_sym match_pe pat_es'
       | some sym_pes =>
         some
           (lemListFoldr
             (fun (p : (b × generic_pexpr Unit sym)) (acc : a) =>
               match p, acc with
               | (sym1, pe'), acc => unsafe_subst_sym sym1 pe' acc) e sym_pes))

partial def simpl_case_pexpr (g : generic_pexpr Unit sym) : generic_pexpr Unit sym :=
  match g with
  | pexpr1@(Pexpr annot1 bTy pexpr_) =>
    (let wrap : generic_pexpr_ Unit sym → generic_pexpr Unit sym :=
       (fun (z : generic_pexpr_ Unit sym) => Pexpr annot1 bTy z);
     match pexpr_ with
     | PEsym _ => pexpr1
     | PEimpl _ => pexpr1
     | PEval _ => pexpr1
     | PEconstrained _ => pexpr1
     | PEundef _ _ => pexpr1
     | PEerror _ _ => pexpr1
     | PEctor ctor1 pes => wrap (PEctor ctor1 (List.map simpl_case_pexpr pes))
     | PEcase pe pat_pes =>
       (match simpl_select_case unsafe_subst_sym_pexpr pe pat_pes with
        | none =>
          wrap
            (PEcase (simpl_case_pexpr pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_pexpr Unit sym)) =>
                  match p with
                  | (pat, pe) => (pat, simpl_case_pexpr pe)) pat_pes))
        | some pe' => simpl_case_pexpr pe')
     | PEarray_shift pe1 ty1 pe2 =>
       wrap (PEarray_shift (simpl_case_pexpr pe1) ty1 (simpl_case_pexpr pe2))
     | PEmember_shift pe sym1 ident => wrap (PEmember_shift (simpl_case_pexpr pe) sym1 ident)
     | PEmemop mop pes => wrap (PEmemop mop (List.map simpl_case_pexpr pes))
     | PEnot pe => wrap (PEnot (simpl_case_pexpr pe))
     | PEop bop pe1 pe2 => wrap (PEop bop (simpl_case_pexpr pe1) (simpl_case_pexpr pe2))
     | PEconv_int ity pe => wrap (PEconv_int ity (simpl_case_pexpr pe))
     | PEwrapI ity iop1 pe1 pe2 =>
       wrap (PEwrapI ity iop1 (simpl_case_pexpr pe1) (simpl_case_pexpr pe2))
     | PEcatch_exceptional_condition ity iop1 pe1 pe2 =>
       wrap (PEcatch_exceptional_condition ity iop1 (simpl_case_pexpr pe1) (simpl_case_pexpr pe2))
     | PEstruct sym1 ident_pes =>
       wrap
         (PEstruct sym1
           (List.map
             (fun (p : (identifier × generic_pexpr Unit sym)) =>
               match p with
               | (ident, pe) => (ident, simpl_case_pexpr pe)) ident_pes))
     | PEunion sym1 ident pe => wrap (PEunion sym1 ident (simpl_case_pexpr pe))
     | PEcfunction pe => wrap (PEcfunction (simpl_case_pexpr pe))
     | PEmemberof tag_sym memb_ident pe =>
       wrap (PEmemberof tag_sym memb_ident (simpl_case_pexpr pe))
     | PEcall nm pes => wrap (PEcall nm (List.map simpl_case_pexpr pes))
     | PElet pat pe1 pe2 => wrap (PElet pat (simpl_case_pexpr pe1) (simpl_case_pexpr pe2))
     | PEif pe1 pe2 pe3 =>
       wrap (PEif (simpl_case_pexpr pe1) (simpl_case_pexpr pe2) (simpl_case_pexpr pe3))
     | PEis_scalar pe => wrap (PEis_scalar (simpl_case_pexpr pe))
     | PEis_integer pe => wrap (PEis_integer (simpl_case_pexpr pe))
     | PEis_signed pe => wrap (PEis_signed (simpl_case_pexpr pe))
     | PEis_unsigned pe => wrap (PEis_unsigned (simpl_case_pexpr pe))
     | PEbmc_assume pe => pexpr1
     | PEare_compatible pe1 pe2 =>
       wrap (PEare_compatible (simpl_case_pexpr pe1) (simpl_case_pexpr pe2)))

partial def simpl_case { a : Type } (g : generic_expr a Unit sym) : generic_expr a Unit sym :=
  match g with
  | expr1@(Expr annot1 expr_) =>
    (let wrap : generic_expr_ a Unit sym → generic_expr a Unit sym :=
       (fun (z : generic_expr_ a Unit sym) => Expr annot1 z);
     match expr_ with
     | Epure pe => wrap (Epure (simpl_case_pexpr pe))
     | Ememop _ _ => expr1
     | Eaction _ => expr1
     | Ecase pe pat_es =>
       (match simpl_select_case unsafe_subst_sym_expr pe pat_es with
        | none =>
          wrap
            (Ecase (simpl_case_pexpr pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_expr a Unit sym)) =>
                  match p with
                  | (pat, e) => (pat, simpl_case e)) pat_es))
        | some e' => simpl_case e')
     | Elet pat pe1 e2 => wrap (Elet pat pe1 (simpl_case e2))
     | Eif pe1 e2 e3 => wrap (Eif pe1 (simpl_case e2) (simpl_case e3))
     | Eccall _ _ _ _ => expr1
     | Eproc _ _ _ => expr1
     | Eunseq es => wrap (Eunseq (List.map simpl_case es))
     | Ewseq pat e1 e2 => wrap (Ewseq pat (simpl_case e1) (simpl_case e2))
     | Esseq pat e1 e2 => wrap (Esseq pat (simpl_case e1) (simpl_case e2))
     | Ebound e => wrap (Ebound (simpl_case e))
     | End es => wrap (End (List.map simpl_case es))
     | Esave sym_bTy xs e => wrap (Esave sym_bTy xs (simpl_case e))
     | Erun _ _ _ => expr1
     | Epar es => wrap (Epar (List.map simpl_case es))
     | Ewait _ => expr1
     | Eannot xs e => wrap (Eannot xs (simpl_case e))
     | Eexcluded _ _ => expr1)

/- ========================================================================== -/

def rewrite_pexpr { a : Type } (pexpr1 : a) : a := /-  remove_conv_int_pexpr pexpr -/ pexpr1

def rewrite_expr { a : Type } (expr1 : generic_expr a Unit sym) : generic_expr a Unit sym :=
  ((fun (x : generic_expr a Unit sym)=> /- simpl_case -| -/ pure_propagation2 (flatten_seqs x)))
    expr1
/-
  (pure_propagation2 -| remove_conv_int -| flatten_seqs -|
   /- remove_dead -| remove_seqs -| remove_unseqs -| flatten_seqs -| -/ remove_skips -|
   sequentialise_creates_kills) expr
-/

def rewrite_fun_map { a b : Type } [MapKeyType b]
    (fun_map1 : Fmap b (generic_fun_map_decl Unit a)) :
    Fmap b (generic_fun_map_decl Unit a) :=
  fmapMap
    (fun (x : generic_fun_map_decl Unit a) =>
      match x with
      | Fun ty1 params pe => Fun ty1 params (rewrite_pexpr pe)
      | ProcDecl loc1 ty1 params => ProcDecl loc1 ty1 params
      | BuiltinDecl loc1 ty1 params => BuiltinDecl loc1 ty1 params
      | Proc loc1 mrk ty1 params e => Proc loc1 mrk ty1 params (rewrite_expr e)) fun_map1

def rewrite_glob_map { a b : Type } (globs_map : List (a × generic_globs b Unit)) :
    List (a × generic_globs b Unit) :=
  List.map
    (fun (p : (a × generic_globs b Unit)) =>
      match p with
      | (name1, glb) =>
        (name1,
          match glb with
          | GlobalDef ty1 e => GlobalDef ty1 (rewrite_expr e)
          | GlobalDecl ty1 => GlobalDecl ty1)) globs_map

