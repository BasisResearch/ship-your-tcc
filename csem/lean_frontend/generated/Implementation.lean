partial def normalise_ctype (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (c : ctype) :
    ctype :=
  match c with
  | (Ctype annots1 ty_) =>
    Ctype annots1
      (match ty_ with
       | Void0 => ty_
       | Basic
         (Integer
           ity) => /- replacing alias type or Enum with the implementtion-defined corresponding integer type -/
         Basic
           (Integer
             ((CerberusImpl.normalise_integerType _lemReader_enum_definitions _lemReader_tagDefs)
               ity))
       | Basic (Floating _) => ty_
       | Array0 elem_ty n_opt =>
         Array0 ((normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) elem_ty) n_opt
       | Function (qs, ret_ty) params is_variadic =>
         Function (qs, (normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) ret_ty)
           (List.map
             (fun (p : (qualifiers × ctype × Bool)) =>
               match p with
               | (qs, ty1, b) =>
                 (qs, (normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) ty1, b))
             params) is_variadic
       | FunctionNoParams (qs, ret_ty) =>
         FunctionNoParams
           (qs, (normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) ret_ty)
       | Pointer qs ref_ty =>
         Pointer qs ((normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) ref_ty)
       | Atomic atom_ty =>
         Atomic ((normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) atom_ty)
       | Struct _ => ty_
       | Union0 _ => ty_
       | Byte => ty_)

def is_compatible_with_size_t (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (ity : integerType) :
    Bool :=
  match (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) ity,
      (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) Size_t with
  | some sz1, some sz2 =>
    (sz1 == sz2) && not ((is_signed_ity _lemReader_enum_definitions _lemReader_tagDefs) ity)
  | _, _ => /- the Implementation is not sufficiently specified -/
    (failwithI "Implementation.is_compatible_with_size_t" : Bool)

def is_compatible_with_ptrdiff_t (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (ity : integerType) :
    Bool :=
  match (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) ity,
      (sizeof_ity _lemReader_enum_definitions _lemReader_tagDefs) Ptrdiff_t with
  | some sz1, some sz2 =>
    (sz1 == sz2) && (is_signed_ity _lemReader_enum_definitions _lemReader_tagDefs) ity
  | _, _ => /- the Implementation is not sufficiently specified -/
    (failwithI "Implementation.is_compatible_with_ptrdiff_t" : Bool)

  /- val is_signed_ity: Ctype.integerType -> bool
val sizeof_ity: Ctype.integerType -> maybe nat -/

def is_signed_or_unsigned_aux (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (ibty : integerBaseType) :
    ctype → Bool :=
  fun (c : ctype) =>
    match c with
    | (Ctype _ ty_) =>
      (match ty_ with
       | Basic (Integer Char0) =>
         (failwithI "TODO: Implementation.is_signed_or_unsigned Char" : Bool) /- ibty = Ichar -/
       | Basic (Integer Bool0) =>
         (failwithI "TODO: Implementation.is_signed_or_unsigned Bool" : Bool)
       | Basic (Integer (Signed ibty')) => integerBaseTypeEqual ibty' ibty
       | Basic (Integer (Unsigned ibty')) => integerBaseTypeEqual ibty' ibty
       | Basic (Integer (Enum0 tag_sym)) => /- this should not be possible -/
         (failwithI "Implementation.is_signed_or_unsigned_aux: Enum" : Bool)
       | Basic (Integer Wchar_t) =>
         (failwithI "TODO: Implementation.is_signed_or_unsigned Wchar_t" : Bool)
       | Basic (Integer Wint_t) =>
         (failwithI "TODO: Implementation.is_signed_or_unsigned Wint_t" : Bool)
       | Basic (Integer Size_t) =>
         (is_compatible_with_size_t _lemReader_enum_definitions _lemReader_tagDefs) (Unsigned ibty)
       | Basic (Integer Ptrdiff_t) =>
         (is_compatible_with_ptrdiff_t _lemReader_enum_definitions _lemReader_tagDefs) (Signed ibty)
       | _ => false)
def is_signed_or_unsigned (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (ibty : integerBaseType) :
    ctype → Bool :=
  fun (ty1 : ctype) =>
    (is_signed_or_unsigned_aux _lemReader_enum_definitions _lemReader_tagDefs) ibty
      ((normalise_ctype _lemReader_enum_definitions _lemReader_tagDefs) ty1)
