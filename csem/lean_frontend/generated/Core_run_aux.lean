structure core_run_state where
  tid_supply : thread_id
  aid_supply : aid
  excluded_supply : Nat
  /- Symbol-id supply for symbols created DURING execution (arc-2 S1):
     threaded like the other supplies instead of the ambient
     Symbol.fresh counter, so the run relation is a pure function of its
     state. On Lean, seeded from the explicitly threaded frontend supply
     (one supply draw at init; the _given constructor takes it directly).
     PRECISE invariant (audit-corrected): ids are unique WITHIN a driver
     run, and distinct from all frontend ids drawn BEFORE that run's
     init. A run's threaded range can overlap frontend ids drawn AFTER
     init (e.g. desugaring resuming past a mid-desugar const-expr run) —
     latent-safe because run-created symbols do not escape their run
     (they appear only as arena binders and Load value names); a
     Phase-2 differential obligation asserts non-escape. -/
  sym_supply : Nat
  /- The digest every run-minted symbol carries; seeded by the driver entry; no step writes it. -/
  sym_digest : String
  /- Pre-calculated map of labeled continuations (aka. save()).
     the map is over procedure symbols (NOTE: read-only) -/
  labeled : Fmap sym (labeled_continuations core_run_annotation)
  deriving BEq, Ord
