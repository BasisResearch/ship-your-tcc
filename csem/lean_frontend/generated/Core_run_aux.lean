def convert_pexpr_lemFuel { bty : Type } (lemFuel : Nat) (g : generic_pexpr bty sym) :
    generic_pexpr Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted (Pexpr [] () (PEval Vunit)))
  | Nat.succ lemFuel =>
    (match g with
     | (Pexpr annot1 _ pexpr_) =>
       Pexpr annot1 ()
         (match pexpr_ with
          | PEsym sym1 => PEsym sym1
          | PEimpl iCst => PEimpl iCst
          | PEval cval => PEval cval
          | PEconstrained xs =>
            PEconstrained
              (List.map
                (fun (p : (mem_constraint CerbMem.IntegerValue × generic_pexpr bty sym)) =>
                  match p with
                  | (constrs, pe) => (constrs, (convert_pexpr_lemFuel lemFuel) pe)) xs)
          | PEundef loc1 ub => PEundef loc1 ub
          | PEerror str pe => PEerror str ((convert_pexpr_lemFuel lemFuel) pe)
          | PEctor ctor1 pes => PEctor ctor1 (List.map (convert_pexpr_lemFuel lemFuel) pes)
          | PEcase pe pat_pes =>
            PEcase ((convert_pexpr_lemFuel lemFuel) pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_pexpr bty sym)) =>
                  match p with
                  | (pat, pe) => (pat, (convert_pexpr_lemFuel lemFuel) pe)) pat_pes)
          | PEarray_shift pe1 ty1 pe2 =>
            PEarray_shift ((convert_pexpr_lemFuel lemFuel) pe1) ty1
              ((convert_pexpr_lemFuel lemFuel) pe2)
          | PEmember_shift pe sym1 ident =>
            PEmember_shift ((convert_pexpr_lemFuel lemFuel) pe) sym1 ident
          | PEmemop mop pes => PEmemop mop (List.map (convert_pexpr_lemFuel lemFuel) pes)
          | PEnot pe => PEnot ((convert_pexpr_lemFuel lemFuel) pe)
          | PEop bop pe1 pe2 =>
            PEop bop ((convert_pexpr_lemFuel lemFuel) pe1) ((convert_pexpr_lemFuel lemFuel) pe2)
          | PEconv_int ity pe => PEconv_int ity ((convert_pexpr_lemFuel lemFuel) pe)
          | PEwrapI ity iop1 pe1 pe2 =>
            PEwrapI ity iop1 ((convert_pexpr_lemFuel lemFuel) pe1)
              ((convert_pexpr_lemFuel lemFuel) pe2)
          | PEcatch_exceptional_condition ity iop1 pe1 pe2 =>
            PEcatch_exceptional_condition ity iop1 ((convert_pexpr_lemFuel lemFuel) pe1)
              ((convert_pexpr_lemFuel lemFuel) pe2)
          | PEstruct sym1 ident_pes =>
            PEstruct sym1
              (List.map
                (fun (p : (identifier × generic_pexpr bty sym)) =>
                  match p with
                  | (ident, pe) => (ident, (convert_pexpr_lemFuel lemFuel) pe)) ident_pes)
          | PEunion sym1 ident pe => PEunion sym1 ident ((convert_pexpr_lemFuel lemFuel) pe)
          | PEcfunction pe => PEcfunction ((convert_pexpr_lemFuel lemFuel) pe)
          | PEmemberof tag_sym memb_ident pe =>
            PEmemberof tag_sym memb_ident ((convert_pexpr_lemFuel lemFuel) pe)
          | PEcall nm pes => PEcall nm (List.map (convert_pexpr_lemFuel lemFuel) pes)
          | PElet pat pe1 pe2 =>
            PElet pat ((convert_pexpr_lemFuel lemFuel) pe1) ((convert_pexpr_lemFuel lemFuel) pe2)
          | PEif pe1 pe2 pe3 =>
            PEif ((convert_pexpr_lemFuel lemFuel) pe1) ((convert_pexpr_lemFuel lemFuel) pe2)
              ((convert_pexpr_lemFuel lemFuel) pe3)
          | PEis_scalar pe => PEis_scalar ((convert_pexpr_lemFuel lemFuel) pe)
          | PEis_integer pe => PEis_integer ((convert_pexpr_lemFuel lemFuel) pe)
          | PEis_signed pe => PEis_signed ((convert_pexpr_lemFuel lemFuel) pe)
          | PEis_unsigned pe => PEis_unsigned ((convert_pexpr_lemFuel lemFuel) pe)
          | PEbmc_assume pe => PEbmc_assume ((convert_pexpr_lemFuel lemFuel) pe)
          | PEare_compatible pe1 pe2 =>
            PEare_compatible ((convert_pexpr_lemFuel lemFuel) pe1)
              ((convert_pexpr_lemFuel lemFuel) pe2)))

def convert_pexpr { bty : Type } (g : generic_pexpr bty sym) : pexpr :=
  convert_pexpr_lemFuel (generic_pexpr.lemSize g) g
theorem convert_pexpr_lemFuel_zero { bty : Type } (g : generic_pexpr bty sym) :
    convert_pexpr_lemFuel 0 g = (fuelExhausted (Pexpr [] () (PEval Vunit))) :=
  rfl

def convert_action_ { bty : Type } (act_ : generic_action_ bty sym) : generic_action_ Unit sym :=
  match act_ with
  | act_ =>
    (match act_ with
     | Create pe1 pe2 pref => Create (convert_pexpr pe1) (convert_pexpr pe2) pref
     | CreateReadOnly pe1 pe2 pe3 pref =>
       CreateReadOnly (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3) pref
     | Alloc0 pe1 pe2 pref => Alloc0 (convert_pexpr pe1) (convert_pexpr pe2) pref
     | Kill kind1 pe => Kill kind1 (convert_pexpr pe)
     | Store0 b pe1 pe2 pe3 mo1 =>
       Store0 b (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3) mo1
     | SeqRMW b pe1 pe2 sym1 pe3 =>
       SeqRMW b (convert_pexpr pe1) (convert_pexpr pe2) sym1 (convert_pexpr pe3)
     | Load0 pe1 pe2 mo1 => Load0 (convert_pexpr pe1) (convert_pexpr pe2) mo1
     | RMW0 pe1 pe2 pe3 pe4 mo1 mo2 =>
       RMW0 (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3) (convert_pexpr pe4) mo1 mo2
     | Fence0 mo1 => Fence0 mo1
     | CompareExchangeStrong pe1 pe2 pe3 pe4 mo1 mo2 =>
       CompareExchangeStrong (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3)
         (convert_pexpr pe4) mo1 mo2
     | CompareExchangeWeak pe1 pe2 pe3 pe4 mo1 mo2 =>
       CompareExchangeWeak (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3)
         (convert_pexpr pe4) mo1 mo2
     | LinuxFence mo1 => LinuxFence mo1
     | LinuxStore pe1 pe2 pe3 mo1 =>
       LinuxStore (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3) mo1
     | LinuxLoad pe1 pe2 mo1 => LinuxLoad (convert_pexpr pe1) (convert_pexpr pe2) mo1
     | LinuxRMW pe1 pe2 pe3 mo1 =>
       LinuxRMW (convert_pexpr pe1) (convert_pexpr pe2) (convert_pexpr pe3) mo1)
def convert_action { a bty : Type } (act : generic_action a bty sym) :
    generic_action core_run_annotation Unit sym :=
  match act with
  | act =>
    (match act with
     | Action loc1 _ act_ => Action loc1 empty_annotation (convert_action_ act_))
def convert_paction { a bty : Type } (pact : generic_paction a bty sym) :
    generic_paction core_run_annotation Unit sym :=
  match pact with
  | pact =>
    (match pact with
     | Paction p act => Paction p (convert_action act))
def convert_expr_lemFuel { a bty : Type } (lemFuel : Nat) (g : generic_expr a bty sym) :
    generic_expr core_run_annotation Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted (Expr [] (Epure (Pexpr [] () (PEval Vunit)))))
  | Nat.succ lemFuel =>
    (match g with
     | (Expr annot1 expr_) =>
       Expr annot1
         (match expr_ with
          | Epure pe => Epure (convert_pexpr pe)
          | Ememop memop1 pes => Ememop memop1 (List.map convert_pexpr pes)
          | Elet pat pe1 e2 => Elet pat (convert_pexpr pe1) ((convert_expr_lemFuel lemFuel) e2)
          | Eif pe1 e2 e3 =>
            Eif (convert_pexpr pe1) ((convert_expr_lemFuel lemFuel) e2)
              ((convert_expr_lemFuel lemFuel) e3)
          | Ecase pe pat_es =>
            Ecase (convert_pexpr pe)
              (List.map
                (fun (p : (generic_pattern sym × generic_expr a bty sym)) =>
                  match p with
                  | (pat, e) => (pat, (convert_expr_lemFuel lemFuel) e)) pat_es)
          | Eccall _ ty1 pe pes =>
            Eccall empty_annotation (convert_pexpr ty1) (convert_pexpr pe)
              (List.map convert_pexpr pes)
          | Eproc _ nm pes => Eproc empty_annotation nm (List.map convert_pexpr pes)
          | Eaction pact => Eaction (convert_paction pact)
          | Eunseq es => Eunseq (List.map (convert_expr_lemFuel lemFuel) es)
          | Ewseq pat e1 e2 =>
            Ewseq pat ((convert_expr_lemFuel lemFuel) e1) ((convert_expr_lemFuel lemFuel) e2)
          | Esseq pat e1 e2 =>
            Esseq pat ((convert_expr_lemFuel lemFuel) e1) ((convert_expr_lemFuel lemFuel) e2)
          | Ebound e => Ebound ((convert_expr_lemFuel lemFuel) e)
          | Esave sym1 xs e =>
            Esave sym1
              (List.map
                (fun (p :
                  (sym ×
                    ((core_base_type × Option (ctype × pass_by_value_or_pointer)) × generic_pexpr
                      bty sym))) =>
                  match p with
                  | (sym1, (bTy, pe)) => (sym1, (bTy, convert_pexpr pe))) xs)
              ((convert_expr_lemFuel lemFuel) e)
          | Erun _ sym1 pes => Erun empty_annotation sym1 (List.map convert_pexpr pes)
          | End es => End (List.map (convert_expr_lemFuel lemFuel) es)
          | Epar es => Epar (List.map (convert_expr_lemFuel lemFuel) es)
          | Ewait tid1 => Ewait tid1
          | Eannot fps e => Eannot fps ((convert_expr_lemFuel lemFuel) e)
          | Eexcluded n act =>
            Eexcluded n
              (convert_action act)
              /-
    | Eloc loc e ->
        Eloc loc (convert_expr e)
    | Estd s e ->
        Estd s (convert_expr e)
-/
              ))

def convert_expr { a bty : Type } (g : generic_expr a bty sym) : expr core_run_annotation :=
  convert_expr_lemFuel (generic_expr.lemSize g) g
theorem convert_expr_lemFuel_zero { a bty : Type } (g : generic_expr a bty sym) :
    convert_expr_lemFuel 0 g = (fuelExhausted (Expr [] (Epure (Pexpr [] () (PEval Vunit))))) :=
  rfl

def convert_impl_decl { a : Type } : generic_impl_decl a → generic_impl_decl Unit :=
  fun (x : generic_impl_decl a) =>
    match x with
    | Def bTy pe => Def bTy (convert_pexpr pe)
    | IFun bTy sym_bTys pe => IFun bTy sym_bTys (convert_pexpr pe)

def convert_globs { a b c : Type } (p : (a × generic_globs b c)) :
    (a × generic_globs core_run_annotation Unit) :=
  match p with
  | (name1, glb) =>
    (name1,
      match glb with
      | GlobalDef bTy e => GlobalDef bTy (convert_expr e)
      | GlobalDecl bTy => GlobalDecl bTy)
def convert_file { a bty : Type } (file1 : generic_file bty a) :
    generic_file Unit core_run_annotation :=
  let convert_fun_map_decl : generic_fun_map_decl bty a → generic_fun_map_decl Unit
    core_run_annotation :=
    fun (x : generic_fun_map_decl bty a) =>
      match x with
      | Fun bTy params pe => Fun bTy params (convert_pexpr pe)
      | ProcDecl loc1 bTy params => ProcDecl loc1 bTy params
      | BuiltinDecl loc1 bTy params => BuiltinDecl loc1 bTy params
      | Proc loc1 mrk bTy params e => Proc loc1 mrk bTy params (convert_expr e);
  (({ main := file1.main,
      calling_convention0 := file1.calling_convention0,
      tagDefs := file1.tagDefs,
      enumDefs := file1.enumDefs,
      stdlib := (fmapMap convert_fun_map_decl file1.stdlib),
      impl0 := (fmapMap convert_impl_decl file1.impl0),
      globs := (List.map convert_globs file1.globs),
      funs := (fmapMap convert_fun_map_decl file1.funs),
      extern := file1.extern,
      funinfo := file1.funinfo,
      loop_attributes1 := file1.loop_attributes1,
      visible_objects_env0 := file1.visible_objects_env0 } : generic_file Unit core_run_annotation))
