/- TODO: here I'm annotating all actions instead (this may reduce the number of
         epsilon transitions) -/
/- [annotate b e] add on each sb-minimal action of [e] an annotation meaning
                  that this action is sequenced-after [act]
  
  in the rules comments, this function is noted: <b> e
 -/
/- val     annotate_expr: forall 'a. SetType 'a => polarity * 'a -> expr 'a -> expr 'a -/

def add_to_sb_lemFuel (lemFuel : Nat) (p_aids : Pset (polarity × (thread_id × aid)))
    (g : generic_expr core_run_annotation Unit sym) :
    generic_expr core_run_annotation Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match p_aids, g with
     | p_aids, expr1@(Expr annot1 expr_) =>
       (lem_if CerbGlobal.using_concurrency () then
         Expr annot1
           (match expr_ with
            | Epure _ => /- no change -/ expr_
            | Ememop _ _ => /- no change -/ expr_
            | Eaction (Paction p' (Action loc1 annots1 a)) =>
              Eaction
                (Paction p'
                  (Action loc1
                    { annots1 with
                      sb_before :=
                        (setUnionBy (pairCompare defaultCompare defaultCompare)
                          ((setMapBy (pairCompare defaultCompare defaultCompare) Prod.snd p_aids))
                          annots1.sb_before) } a))
            | Ecase pe pat_es =>
              Ecase pe
                (List.map
                  (fun (p : (generic_pattern sym × generic_expr core_run_annotation Unit sym)) =>
                    match p with
                    | (pat, e) => (pat, (add_to_sb_lemFuel lemFuel) p_aids e)) pat_es)
            | Elet a pe1 e2 => Elet a pe1 ((add_to_sb_lemFuel lemFuel) p_aids e2)
            | Eif pe1 e2 e3 =>
              Eif pe1 ((add_to_sb_lemFuel lemFuel) p_aids e2)
                ((add_to_sb_lemFuel lemFuel) p_aids e3)
            | Eccall annots1 ty1 pe pes =>
              Eccall
                { annots1 with
                  sb_before :=
                    (setUnionBy (pairCompare defaultCompare defaultCompare)
                      ((setMapBy (pairCompare defaultCompare defaultCompare) Prod.snd p_aids))
                      annots1.sb_before) } ty1 pe pes
            | Eproc annots1 nm pes =>
              Eproc
                { annots1 with
                  sb_before :=
                    (setUnionBy (pairCompare defaultCompare defaultCompare)
                      ((setMapBy (pairCompare defaultCompare defaultCompare) Prod.snd p_aids))
                      annots1.sb_before) } nm pes
            | Eunseq es => Eunseq (List.map ((add_to_sb_lemFuel lemFuel) p_aids) es)
            | Ewseq _as e1 e2 =>
              (let is_positive : (polarity × (thread_id × aid)) → Bool :=
                 fun (x : (polarity × (thread_id × aid))) =>
                   match x with
                   | (Pos, _) => true
                   | _ => false;
               Ewseq _as ((add_to_sb_lemFuel lemFuel) p_aids e1)
                 ((add_to_sb_lemFuel lemFuel) (setFilterBy setElemCompare is_positive p_aids) e2))
            | Esseq _as e1 e2 =>
              Esseq _as ((add_to_sb_lemFuel lemFuel) p_aids e1)
                ((add_to_sb_lemFuel lemFuel) p_aids e2)
            | Ebound _ =>
              (failwithI "Core_run_aux.add_to_sb, Ebound" : generic_expr_ core_run_annotation Unit
                sym)
            | End es => End (List.map ((add_to_sb_lemFuel lemFuel) p_aids) es)
            | Esave sym_bTy xs e => Esave sym_bTy xs ((add_to_sb_lemFuel lemFuel) p_aids e)
            | Erun annots1 sym1 pes =>
              Erun
                { annots1 with
                  sb_before :=
                    (setUnionBy (pairCompare defaultCompare defaultCompare)
                      ((setMapBy (pairCompare defaultCompare defaultCompare) Prod.snd p_aids))
                      annots1.sb_before) } sym1 pes
            | Epar es => Epar (List.map ((add_to_sb_lemFuel lemFuel) p_aids) es)
            | Ewait _ => /- no change -/ expr_
            | Eannot _ _ =>
              (failwithI "Core_run_aux.add_to_sb, Eannot" : generic_expr_ core_run_annotation Unit
                sym)
            | Eexcluded _ _ =>
              (failwithI "Core_run_aux.add_to_sb, Eexcluded" : generic_expr_ core_run_annotation
                Unit sym))
       else
         expr1))

def add_to_sb (p_aids : Pset (polarity × (thread_id × aid)))
    (g : generic_expr core_run_annotation Unit sym) :
    expr core_run_annotation :=
  add_to_sb_lemFuel (generic_expr.lemSize g) p_aids g
theorem add_to_sb_lemFuel_zero (p_aids : Pset (polarity × (thread_id × aid)))
    (g : generic_expr core_run_annotation Unit sym) :
    add_to_sb_lemFuel 0 p_aids g = (fuelExhausted g) :=
  rfl

def add_to_sb_continuation (p_aids : Pset (polarity × (thread_id × aid))) :
    List (continuation_element core_run_annotation) → List
        (continuation_element core_run_annotation) :=
  fun (x : List (continuation_element core_run_annotation)) =>
    match x with
    | [] => ([] : List (continuation_element core_run_annotation))
    | Kunseq annots1 es1 es2 :: cont => Kunseq annots1 es1 es2 :: add_to_sb_continuation p_aids cont
    | Kwseq annots1 _as e2 :: cont =>
      (let is_positive : (polarity × (thread_id × aid)) → Bool :=
         fun (x : (polarity × (thread_id × aid))) =>
           match x with
           | (Pos, _) => true
           | _ => false;
       Kwseq annots1 _as (add_to_sb (setFilterBy setElemCompare is_positive p_aids) e2) ::
         add_to_sb_continuation p_aids cont)
    | Ksseq annots1 _as e2 :: cont =>
      Ksseq annots1 _as (add_to_sb p_aids e2) :: add_to_sb_continuation p_aids cont

def add_to_sb_stack (p_aids : Pset (polarity × (thread_id × aid)))
    (sk : stack core_run_annotation) :
    stack core_run_annotation :=
  lem_if CerbGlobal.using_concurrency () then
    match sk with
    | Stack_empty => Stack_empty
    | Stack_cons proc_opt cont sk =>
      ((lemSeq
        (fun _ =>
          CerbDebug.warn ([] : List domain) (fun (u : Unit) =>
            match u with
            | () => "(UNSURE) Core_run_aux.add_to_sb_stack ==> is not touching lconts"))
        (fun _ =>
          Stack_cons proc_opt (add_to_sb_continuation p_aids cont) (add_to_sb_stack p_aids sk))))
    | Stack_cons2 _ _ _ => (failwithI "add_to_sb_stack ==> Stack_cons2" : stack core_run_annotation)
  else
    sk
def add_to_asw_lemFuel (lemFuel : Nat) (aids : Pset Nat)
    (g : generic_expr core_run_annotation Unit sym) :
    generic_expr core_run_annotation Unit sym :=
  match lemFuel with
  | 0 => (fuelExhausted g)
  | Nat.succ lemFuel =>
    (match aids, g with
     | aids, expr1@(Expr annot1 expr_) =>
       (lem_if CerbGlobal.using_concurrency () then
         (lemSeq
           (fun _ =>
             CerbDebug.print_debug_pure 5 [DB_driver, DB_concurrency] (fun (u : Unit) =>
               match u with
               | () => "HELLO add_to_asw ===="))
           (fun _ =>
             Expr annot1
               (match expr_ with
                | Epure _ => /- no change -/ expr_
                | Ememop _ _ => /- no change -/ expr_
                | Eaction (Paction p' (Action loc1 annots1 a)) =>
                  ((lemSeq
                    (fun _ =>
                      (setMapBy defaultCompare
                        (fun (aid1 : Nat) =>
                          CerbDebug.print_debug_pure 5 [DB_driver, DB_concurrency]
                            (fun (u : Unit) =>
                              match u with
                              | () =>
                                String.append "ADD_TO_ASW ==> "
                                  (Lem_String_extra.stringFromNat aid1))) aids))
                    (fun _ =>
                      Eaction
                        (Paction p'
                          (Action loc1
                            { annots1 with
                              asw_before := (setUnionBy defaultCompare aids annots1.asw_before) }
                            a)))))
                | Ecase pe pat_es =>
                  Ecase pe
                    (List.map
                      (fun (p :
                        (generic_pattern sym × generic_expr core_run_annotation Unit sym)) =>
                        match p with
                        | (pat, e) => (pat, (add_to_asw_lemFuel lemFuel) aids e)) pat_es)
                | Elet a pe1 e2 => Elet a pe1 ((add_to_asw_lemFuel lemFuel) aids e2)
                | Eif pe1 e2 e3 =>
                  Eif pe1 ((add_to_asw_lemFuel lemFuel) aids e2)
                    ((add_to_asw_lemFuel lemFuel) aids e3)
                | Eccall annots1 ty1 pe pes =>
                  Eccall
                    { annots1 with
                      asw_before := (setUnionBy defaultCompare aids annots1.asw_before) } ty1 pe pes
                | Eproc annots1 nm pes =>
                  Eproc
                    { annots1 with
                      asw_before := (setUnionBy defaultCompare aids annots1.asw_before) } nm pes
                | Eunseq es => Eunseq (List.map ((add_to_asw_lemFuel lemFuel) aids) es)
                | Ewseq _as e1 e2 =>
                  Ewseq _as ((add_to_asw_lemFuel lemFuel) aids e1)
                    ((add_to_asw_lemFuel lemFuel) aids e2) /- TODO this is wrong -/
                | Esseq _as e1 e2 =>
                  Esseq _as ((add_to_asw_lemFuel lemFuel) aids e1)
                    ((add_to_asw_lemFuel lemFuel) aids e2) /- TODO this is wrong -/
                | Ebound _ =>
                  (failwithI "Core_run_aux.add_to_asw, Ebound" : generic_expr_ core_run_annotation
                    Unit sym)
                | Esave sym_bTy xs e => Esave sym_bTy xs ((add_to_asw_lemFuel lemFuel) aids e)
                | Erun annots1 sym1 pes =>
                  Erun
                    { annots1 with
                      asw_before := (setUnionBy defaultCompare aids annots1.asw_before) } sym1 pes
                | End es => End (List.map ((add_to_asw_lemFuel lemFuel) aids) es)
                | Epar es => Epar (List.map ((add_to_asw_lemFuel lemFuel) aids) es)
                | Ewait _ => /- no change -/ expr_
                | Eannot _ _ =>
                  (failwithI "Core_run_aux.add_to_asw, Eannot" : generic_expr_ core_run_annotation
                    Unit sym)
                | Eexcluded _ _ =>
                  (failwithI "Core_run_aux.add_to_asw, Eexcluded" : generic_expr_
                    core_run_annotation Unit sym))))
       else
         expr1))

def add_to_asw (aids : Pset Nat) (g : generic_expr core_run_annotation Unit sym) :
    expr core_run_annotation :=
  add_to_asw_lemFuel (generic_expr.lemSize g) aids g
theorem add_to_asw_lemFuel_zero (aids : Pset Nat) (g : generic_expr core_run_annotation Unit sym) :
    add_to_asw_lemFuel 0 aids g = (fuelExhausted g) :=
  rfl

def add_to_asw_continuation (aids : Pset aid) :
    List (continuation_element core_run_annotation) → List
        (continuation_element core_run_annotation) :=
  fun (x : List (continuation_element core_run_annotation)) =>
    match x with
    | [] => ([] : List (continuation_element core_run_annotation))
    | Kunseq annots1 es1 es2 :: cont =>
      Kunseq annots1 (List.map (add_to_asw aids) es1) (List.map (add_to_asw aids) es2) ::
        add_to_asw_continuation aids cont
    | Kwseq annots1 _as e2 :: cont =>
      Kwseq annots1 _as (add_to_asw aids e2) :: add_to_asw_continuation aids cont
    | Ksseq annots1 _as e2 :: cont =>
      Ksseq annots1 _as (add_to_asw aids e2) :: add_to_asw_continuation aids cont

def add_to_asw_stack (aids : Pset aid) (sk : stack core_run_annotation) :
    stack core_run_annotation :=
  (lemSeq
    (fun _ =>
      CerbDebug.print_debug_pure 5 [DB_driver, DB_concurrency] (fun (u : Unit) =>
        match u with
        | () => "BOOM add_to_asw_stack ==> " /- ^ Pp.stringFromCore_stack sk -/))
    (fun _ =>
      lem_if CerbGlobal.using_concurrency () then
        match sk with
        | Stack_empty => Stack_empty
        | Stack_cons proc_opt cont sk =>
          Stack_cons proc_opt (add_to_asw_continuation aids cont) (add_to_asw_stack aids sk)
        | Stack_cons2 _ _ _ =>
          (failwithI "add_to_asw_stack ==> Stack_cons2" : stack core_run_annotation)
      else
        sk))
def comma_list { a : Type } (f : a → String) : List a → String :=
  fun (x : List a) =>
    match x with
    | [] => ""
    | x :: xs => String.append (f x) (String.append ", " (comma_list f xs))

