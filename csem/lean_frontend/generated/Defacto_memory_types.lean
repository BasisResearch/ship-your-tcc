/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def impl_pointer_value.lemSize (sizex_ : impl_pointer_value) : Nat :=
  match sizex_ with
  | .PV _ x1 x2 => 1 + pointer_value_base.lemSize x1 + impl_pointer_value.lemSize_aux1 x2
termination_by structural sizex_
def pointer_value_base.lemSize (sizex_ : pointer_value_base) : Nat :=
  match sizex_ with
  | .PVunspecified _ => 1
  | .PVnull _ => 1
  | .PVfunction _ => 1
  | .PVbase _ _ => 1
  | .PVfromint x1 => 1 + integer_value_base.lemSize x1
termination_by structural sizex_
def shift_path_element.lemSize (sizex_ : shift_path_element) : Nat :=
  match sizex_ with
  | .SPE_array _ x1 => 1 + integer_value_base.lemSize x1
  | .SPE_member _ _ => 1
termination_by structural sizex_
def impl_integer_value.lemSize (sizex_ : impl_integer_value) : Nat :=
  match sizex_ with
  | .IV _ x1 => 1 + integer_value_base.lemSize x1
termination_by structural sizex_
def integer_value_base.lemSize (sizex_ : integer_value_base) : Nat :=
  match sizex_ with
  | .IVunspecified => 1
  | .IVconcurRead _ _ => 1
  | .IVconcrete _ => 1
  | .IVaddress _ _ => 1
  | .IVfromptr _ _ x1 x2 => 1 + pointer_value_base.lemSize x1 + impl_pointer_value.lemSize_aux1 x2
  | .IVop _ x1 => 1 + impl_pointer_value.lemSize_aux2 x1
  | .IVmin _ => 1
  | .IVmax _ => 1
  | .IVsizeof _ => 1
  | .IValignof _ => 1
  | .IVoffsetof _ _ => 1
  | .IVpadding _ _ => 1
  | .IVptrdiff _ (x1, x2) (x3, x4) =>
    1 + pointer_value_base.lemSize x1 + impl_pointer_value.lemSize_aux1 x2 +
      pointer_value_base.lemSize x3 + impl_pointer_value.lemSize_aux1 x4
  | .IVbyteof x1 x2 => 1 + integer_value_base.lemSize x1 + impl_mem_value.lemSize x2
  | .IVcomposite x1 => 1 + impl_pointer_value.lemSize_aux2 x1
  | .IVbitwise _ x1 => 1 + bitwise_operation.lemSize x1
termination_by structural sizex_
def bitwise_operation.lemSize (sizex_ : bitwise_operation) : Nat :=
  match sizex_ with
  | .BW_complement x1 => 1 + integer_value_base.lemSize x1
  | .BW_AND x1 x2 => 1 + integer_value_base.lemSize x1 + integer_value_base.lemSize x2
  | .BW_OR x1 x2 => 1 + integer_value_base.lemSize x1 + integer_value_base.lemSize x2
  | .BW_XOR x1 x2 => 1 + integer_value_base.lemSize x1 + integer_value_base.lemSize x2
termination_by structural sizex_
def impl_floating_value.lemSize (sizex_ : impl_floating_value) : Nat :=
  match sizex_ with
  | .FVunspecified => 1
  | .FVconcrete _ => 1
def impl_mem_value.lemSize (sizex_ : impl_mem_value) : Nat :=
  match sizex_ with
  | .MVinteger _ x1 => 1 + impl_integer_value.lemSize x1
  | .MVfloating _ x1 => 1 + impl_floating_value.lemSize x1
  | .MVpointer _ x1 => 1 + impl_pointer_value.lemSize x1
  | .MVarray x1 => 1 + impl_pointer_value.lemSize_aux3 x1
  | .MVstruct _ x1 => 1 + impl_pointer_value.lemSize_aux4 x1
  | .MVunion _ _ x1 => 1 + impl_mem_value.lemSize x1
  | .MVdelayed x1 x2 => 1 + impl_pointer_value.lemSize_aux5 x1 + impl_mem_value.lemSize x2
  | .MVcomposite x1 x2 => 1 + impl_pointer_value.lemSize_aux6 x1 + impl_mem_value.lemSize x2
termination_by structural sizex_
def impl_pointer_value.lemSize_aux1 (sizex_ : List shift_path_element) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + shift_path_element.lemSize x1 + impl_pointer_value.lemSize_aux1 xs0
termination_by structural sizex_
def impl_pointer_value.lemSize_aux2 (sizex_ : List integer_value_base) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + integer_value_base.lemSize x1 + impl_pointer_value.lemSize_aux2 xs0
termination_by structural sizex_
def impl_pointer_value.lemSize_aux3 (sizex_ : List impl_mem_value) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + impl_mem_value.lemSize x1 + impl_pointer_value.lemSize_aux3 xs0
termination_by structural sizex_
def impl_pointer_value.lemSize_aux4 (sizex_ : List ((identifier × ctype × impl_mem_value))) : Nat :=
  match sizex_ with
  | [] => 0
  | (_, _, x1) :: xs0 => 1 + impl_mem_value.lemSize x1 + impl_pointer_value.lemSize_aux4 xs0
termination_by structural sizex_
def impl_pointer_value.lemSize_aux5 (sizex_ : List ((List shift_path_element × impl_mem_value))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (x1, x2) :: xs0 =>
    1 + impl_pointer_value.lemSize_aux1 x1 + impl_mem_value.lemSize x2 +
      impl_pointer_value.lemSize_aux5 xs0
termination_by structural sizex_
def impl_pointer_value.lemSize_aux6 (sizex_ : List ((integer_value_base × impl_integer_value))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (x1, x2) :: xs0 =>
    1 + integer_value_base.lemSize x1 + impl_integer_value.lemSize x2 +
      impl_pointer_value.lemSize_aux6 xs0
termination_by structural sizex_
end

/-
type allocation =
  | Alloc_static  of ctype /- * address -/
  | Alloc_dynamic of integer_value_base /- * address -/
-/

/- TODO: simplified for now (only work for scalars) -/
inductive impl_footprint : Type where
  | FP_alloc : allocation_id → ctype → impl_footprint
  | FP_device : integer_value_base → ctype → impl_footprint
  deriving BEq, Ord
export impl_footprint (FP_alloc FP_device)
instance : Inhabited impl_footprint where
  default := FP_alloc default default
instance (priority := 500) : Lem_Basic_classes.SetType impl_footprint where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 impl_footprint where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 impl_footprint where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def impl_overlapping (_ : impl_footprint) (_ : impl_footprint) : Bool :=
  (failwithI "impl_overlapping" : Bool)
