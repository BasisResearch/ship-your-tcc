def impl_mem_value.beq_derived (cmpx_ cmpy_ : impl_mem_value) : Bool :=
  match cmpx_, cmpy_ with
  | .MVinteger x1 x2, .MVinteger y1 y2 => x1 == y1 && impl_integer_value.beq_derived x2 y2
  | .MVfloating x1 x2, .MVfloating y1 y2 => x1 == y1 && impl_floating_value.beq_derived x2 y2
  | .MVpointer x1 x2, .MVpointer y1 y2 => x1 == y1 && impl_pointer_value.beq_derived x2 y2
  | .MVarray x1, .MVarray y1 => impl_pointer_value.beq_deriv_aux9 x1 y1
  | .MVstruct x1 x2, .MVstruct y1 y2 => x1 == y1 && impl_pointer_value.beq_deriv_aux10 x2 y2
  | .MVunion x1 x2 x3, .MVunion y1 y2 y3 => x1 == y1 && x2 == y2 && impl_mem_value.beq_derived x3 y3
  | .MVdelayed x1 x2, .MVdelayed y1 y2 =>
    impl_pointer_value.beq_deriv_aux11 x1 y1 && impl_mem_value.beq_derived x2 y2
  | .MVcomposite x1 x2, .MVcomposite y1 y2 =>
    impl_pointer_value.beq_deriv_aux12 x1 y1 && impl_mem_value.beq_derived x2 y2
  | _, _ => false
termination_by structural cmpx_
def impl_mem_value.compare_derived (cmpx_ cmpy_ : impl_mem_value) : Ordering :=
  match cmpx_, cmpy_ with
  | .MVinteger x1 x2, .MVinteger y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_integer_value.compare_derived x2 y2)
  | .MVfloating x1 x2, .MVfloating y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_floating_value.compare_derived x2 y2)
  | .MVpointer x1 x2, .MVpointer y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_pointer_value.compare_derived x2 y2)
  | .MVarray x1, .MVarray y1 => impl_pointer_value.cmp_deriv_aux5 x1 y1
  | .MVstruct x1 x2, .MVstruct y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_pointer_value.cmp_deriv_aux6 x2 y2)
  | .MVunion x1 x2 x3, .MVunion y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => impl_mem_value.compare_derived x3 y3))
  | .MVdelayed x1 x2, .MVdelayed y1 y2 =>
    (match impl_pointer_value.cmp_deriv_aux7 x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_mem_value.compare_derived x2 y2)
  | .MVcomposite x1 x2, .MVcomposite y1 y2 =>
    (match impl_pointer_value.cmp_deriv_aux8 x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => impl_mem_value.compare_derived x2 y2)
  | xg, yg => Ord.compare (impl_mem_value.ctor_rank_ocaml xg) (impl_mem_value.ctor_rank_ocaml yg)
termination_by structural cmpx_
