                                                        lvalue_wrp.sym_pe
                                                        (mk_specified_pe shift_wrp.sym_pe) NA)))))
                                              (mk_pure_e load_wrp.sym_pe))),
                                          (mk_unspecified_pat (mk_empty_pat BTy_ctype),
                                            mk_pure_e (mk_unspecified_pe ty1))])))))
                        | _ => mk_common ()
                      else
                        mk_common ())))))))
def translate_assignment_conversion [CerberusFresh.Digest] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (translate_expr : expression genTypeCategory → elab_state →
      (generic_expr Unit Unit sym × elab_state)) (stdlib1 : translation_stdlib) (ty1 : ctype)
    (e2 : expression genTypeCategory) :
    elab_state →
        ((core_object_type × generic_expr Unit Unit sym ×
          (generic_pexpr Unit sym → generic_pexpr Unit sym)) × elab_state) :=
  let ty2 := unatomic ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2);
  (lem_if atomic_qualified_unqualified is_array ty1 then
    bind1 (translate_expr e2) (fun (core_e2 : generic_expr Unit Unit sym) =>
      return0
        (force_core_object_type_of_ctype ty2, core_e2, (fun (z : generic_pexpr Unit sym) => z)))
  else lem_if atomic_qualified_unqualified is_arithmetic ty1 && is_arithmetic ty2 then
    bind1 (translate_expr e2) (fun (core_e2 : generic_expr Unit Unit sym) =>
      return0
        (force_core_object_type_of_ctype ty2, core_e2,
          conv_loaded_arith stdlib1 ty2 (unatomic ty1)))
  else lem_if atomic_qualified_unqualified is_struct_or_union ty1 || atomic_qualified_unqualified
      is_byte ty1 then
    bind1
      (/- NOTE: the two struct/union types could be from two different translation units,
             but as far as I can things are sufficiently restricted such that no conversion is needed here -/
      translate_expr e2)
      (fun (core_e2 : generic_expr Unit Unit sym) =>
        return0
