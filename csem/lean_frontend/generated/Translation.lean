    (usual_arithmetic_conversion : ctype → ctype → generic_pexpr Unit sym → generic_pexpr Unit sym →
      (pexpr × pexpr)) (result_ty : ctype) (bop : binaryOperator) (e1 : expression genTypeCategory)
    (e2 : expression genTypeCategory) :
    elab_state → (generic_expr Unit Unit sym × elab_state) := /- STD "§6.5.8" -/
  let oTy1 :=
    force_core_object_type_of_ctype ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1);
  let oTy2 :=
    force_core_object_type_of_ctype ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2);
  bind1 (translate_expr e1) (fun (core_e1 : generic_expr Unit Unit sym) =>
    bind1 (translate_expr e2) (fun (core_e2 : generic_expr Unit Unit sym) =>
      bind1 (wrapped_fresh_symbol (BTy_loaded oTy1)) (fun (e1_wrp : wrapped_symbol) =>
        bind1 (wrapped_fresh_symbol (BTy_loaded oTy2)) (fun (e2_wrp : wrapped_symbol) =>
          bind1 (wrapped_fresh_symbol (BTy_object oTy1)) (fun (obj1_wrp : wrapped_symbol) =>
            bind1 (wrapped_fresh_symbol (BTy_object oTy2)) (fun (obj2_wrp : wrapped_symbol) =>
              bind1 (wrapped_fresh_symbol BTy_boolean)
                (fun (memop_wrp :
                  wrapped_symbol) => /- The object type on which the Core operator is going to work on. -/ /- From Ail's typing it is enough to look at the type of one of the operand (see STD §6.5.8#2) -/
                  let real_bop :=
                    match bop with
                    | Lt => OpLt
                    | Gt => OpGt
                    | Le => OpLe
                    | Ge => OpGe
                    | /- BISECT-IGNORE -/ _ =>
                      (failwithI
                        "[Translation.translate_relational_operator], 'bop' must be relational" :
                        binop);
                  return0
                    (add_std "§6.5.8"
                      (mk_wseq_e (mk_tuple_pat [e1_wrp.sym_pat, e2_wrp.sym_pat])
                        (mk_unseq [core_e1, core_e2])
                        (mk_case_e (mk_tuple_pe [e1_wrp.sym_pe, e2_wrp.sym_pe])
                          [(mk_tuple_pat
                            [mk_specified_pat obj1_wrp.sym_pat, mk_specified_pat obj2_wrp.sym_pat],
                            (lem_if is_real
                                ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1) then
                              match mk_std_pair_pe "§6.5.8#3"
                                  (usual_arithmetic_conversion
                                    ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1)
                                    ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2)
                                    obj1_wrp.sym_pe obj2_wrp.sym_pe) with
                              | (promoted1_pe, promoted2_pe) =>
                                add_std "§6.5.8#6"
                                  (mk_pure_e
                                    (mk_if_pe (mk_op_pe real_bop promoted1_pe promoted2_pe)
                                      (mk_specified_pe (mk_integer_pe ((1 : Int))))
                                      (mk_specified_pe (mk_integer_pe ((0 : Int))))))
                            else
                              let memop1 :=
                                match bop with
                                | Lt => PtrLt
                                | Gt => PtrGt
                                | Le => PtrLe
                                | Ge => PtrGe
                                | /- BISECT-IGNORE -/ _ =>
                                  (failwithI
                                    "[Translation.translate_relational_operator], 'bop' must be relational" :
                                    generic_memop sym);
                              mk_wseq_e memop_wrp.sym_pat
                                (Expr ([] : List annot)
                                  (Ememop memop1 [obj1_wrp.sym_pe, obj2_wrp.sym_pe]))
                                (add_std "§6.5.8#6"
                                  (mk_pure_e
                                    (mk_if_pe memop_wrp.sym_pe
                                      (mk_specified_pe (mk_integer_pe ((1 : Int))))
                                      (mk_specified_pe (mk_integer_pe ((0 : Int))))))))),
                            (mk_empty_pat (BTy_tuple [BTy_loaded oTy1, BTy_loaded oTy2]),
                              mk_pure_e (mk_unspecified_pe result_ty))]))))))))))
/- STD §6.5.9 Equality operators -/
/- MUST BE in { A.Eq, A.Ne } -/

def translate_equality_operator [CerberusFresh.Digest] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (translate_expr : expression genTypeCategory → elab_state →
      (generic_expr Unit Unit sym × elab_state))
    (usual_arithmetic_conversion : ctype → ctype → generic_pexpr Unit sym → generic_pexpr Unit sym →
      (pexpr × pexpr)) (result_ty : ctype) (bop : binaryOperator) (e1 : expression genTypeCategory)
    (e2 : expression genTypeCategory) :
    elab_state → (generic_expr Unit Unit sym × elab_state) := /- STD §6.5.9 -/
  lem_if (is_null_pointer_constant e1 && is_pointer
      ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2)) ||
      (is_pointer ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1) &&
        is_null_pointer_constant
        e2) then /- equality test between a null pointer constant and pointer -/
    let e := lem_if is_null_pointer_constant e1 then e2 else e1;
    let nullptr_pe :=
      mk_std_pe "§6.5.9#5, sentence 2"
        (mk_nullptr_pe ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e));
    bind1 (translate_expr e) (fun (core_e : generic_expr Unit Unit sym) =>
      bind1 (wrapped_fresh_symbol (BTy_loaded OTy_pointer)) (fun (e_wrp : wrapped_symbol) =>
        bind1 (wrapped_fresh_symbol (BTy_object OTy_pointer)) (fun (obj_wrp : wrapped_symbol) =>
          bind1 (wrapped_fresh_symbol BTy_boolean) (fun (memop_wrp : wrapped_symbol) =>
            let memop1 :=
              match bop with
              | Eq1 => PtrEq
              | Ne0 => PtrNe
              | /- BISECT-IGNORE -/ _ =>
                (failwithI
                  "[Translation.translate_equality_operator], 'bop' must be an equality operator" :
                  generic_memop sym);
            return0
              (mk_wseq_e e_wrp.sym_pat core_e
                (mk_case_e e_wrp.sym_pe
                  [(mk_specified_pat obj_wrp.sym_pat,
                    mk_wseq_e memop_wrp.sym_pat (mk_memop_e memop1 [obj_wrp.sym_pe, nullptr_pe])
                      (add_std "§6.5.9#3"
                        (mk_pure_e
                          (mk_if_pe memop_wrp.sym_pe (mk_specified_pe (mk_integer_pe ((1 : Int))))
                            (mk_specified_pe (mk_integer_pe ((0 : Int)))))))),
                    (mk_empty_pat (BTy_loaded OTy_pointer),
                      mk_pure_e
                        (mk_undef_pe loc1
                          (UB_CERB004_unspecified UB_unspec_equality_ptr_vs_NULL)))]))))))
  else /- operands both have arithmetic or pointer types -/ /- The object type on which the Core operator is going to work on. -/
    let oTy1 :=
      force_core_object_type_of_ctype
        ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1);
    let oTy2 :=
      force_core_object_type_of_ctype
        ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2);
    bind1 (wrapped_fresh_symbol (BTy_loaded oTy1)) (fun (e1_wrp : wrapped_symbol) =>
      bind1 (wrapped_fresh_symbol (BTy_loaded oTy2)) (fun (e2_wrp : wrapped_symbol) =>
        bind1 (wrapped_fresh_symbol (BTy_object oTy1)) (fun (obj1_wrp : wrapped_symbol) =>
          bind1 (wrapped_fresh_symbol (BTy_object oTy2)) (fun (obj2_wrp : wrapped_symbol) =>
            bind1 (wrapped_fresh_symbol BTy_boolean) (fun (memop_wrp : wrapped_symbol) =>
              bind1 (translate_expr e1) (fun (core_e1 : generic_expr Unit Unit sym) =>
                bind1 (translate_expr e2) (fun (core_e2 : generic_expr Unit Unit sym) =>
                  return0
                    (mk_wseq_e (mk_tuple_pat [e1_wrp.sym_pat, e2_wrp.sym_pat])
                      (mk_unseq [core_e1, core_e2])
                      (lem_if is_arithmetic
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1) &&
                          is_arithmetic
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2) then
                        let mk_op_pe1 :=
                          match bop with
                          | Eq1 => mk_op_pe OpEq
                          | Ne0 =>
                            (fun (x : generic_pexpr Unit sym) (y : generic_pexpr Unit sym) =>
                              mk_not_pe (mk_op_pe OpEq x y))
                          | /- BISECT-IGNORE -/ _ =>
                            (failwithI
                              "[Translation.translate_equality_operator], 'bop' must be an equality operator" :
                              pexpr → pexpr → pexpr);
                        mk_pure_e
                          (mk_case_pe (mk_tuple_pe [e1_wrp.sym_pe, e2_wrp.sym_pe])
                            [(mk_tuple_pat
                              [mk_specified_pat obj1_wrp.sym_pat,
                                mk_specified_pat obj2_wrp.sym_pat],
                              match mk_std_pair_pe "§6.5.9#4, sentence 1"
                                  (usual_arithmetic_conversion
                                    ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1)
                                    ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2)
                                    obj1_wrp.sym_pe obj2_wrp.sym_pe) with
                              | (promoted1_pe, promoted2_pe) =>
                                mk_std_pe "§6.5.9#3"
                                  (mk_if_pe
                                    (mk_std_pe "§6.5.9#4, sentence 3"
                                      (mk_op_pe1 promoted1_pe promoted2_pe))
                                    (mk_specified_pe (mk_integer_pe ((1 : Int))))
                                    (mk_specified_pe (mk_integer_pe ((0 : Int)))))),
                              (mk_empty_pat (BTy_tuple [BTy_loaded oTy1, BTy_loaded oTy2]),
                                mk_unspecified_pe result_ty)])
                      else /- both operand have pointer type -/
                        let memop1 :=
                          match bop with
                          | Eq1 => PtrEq
                          | Ne0 => PtrNe
                          | /- BISECT-IGNORE -/ _ =>
                            (failwithI
                              "[Translation.translate_equality_operator], 'bop' must be an equality operator" :
                              generic_memop sym);
                        /- NOTE: our modelling of ptr <-> ptr casting is the identity,
              so nothing is done here for (§6.5.9#5 sentence 3) -/
                        mk_case_e (mk_tuple_pe [e1_wrp.sym_pe, e2_wrp.sym_pe])
                          [(mk_tuple_pat
                            [mk_specified_pat obj1_wrp.sym_pat, mk_specified_pat obj2_wrp.sym_pat],
                            mk_wseq_e memop_wrp.sym_pat
                              (Expr ([] : List annot)
                                (Ememop memop1 [obj1_wrp.sym_pe, obj2_wrp.sym_pe]))
                              (mk_pure_e
                                (mk_std_pe "§6.5.9#3"
                                  (mk_if_pe memop_wrp.sym_pe
                                    (mk_specified_pe (mk_integer_pe ((1 : Int))))
                                    (mk_specified_pe (mk_integer_pe ((0 : Int)))))))),
                            (mk_empty_pat (BTy_tuple [BTy_loaded oTy1, BTy_loaded oTy2]),
                              mk_pure_e
                                (mk_undef_pe loc1
                                  (UB_CERB004_unspecified
                                    UB_unspec_equality_both_arith_or_ptr)))])))))))))
/- STD §6.5.10  Bitwise AND operator          -/
/- STD §6.5.11  Bitwise exclusive OR operator -/
/- STD §6.5.12  Bitwise inclusive OR operator -/
/- MUST BE in { A.Band, A.Bxor, A.Bor } -/

def translate_bitwise_operator [CerberusFresh.Digest] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (translate_expr : expression genTypeCategory → elab_state →
      (generic_expr Unit Unit sym × elab_state))
    (usual_arithmetic_conversion : ctype → ctype → generic_pexpr Unit sym → generic_pexpr Unit sym →
      (pexpr × pexpr)) (stdlib1 : translation_stdlib) (result_ty : ctype) (aop : arithmeticOperator)
    (e1 : expression genTypeCategory) (e2 : expression genTypeCategory) :
    elab_state → (generic_expr Unit Unit sym × elab_state) :=
  match match aop with
        | Band =>
          ("§6.5.10",
            (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
              Pexpr ([] : List annot) () (PEctor CivAND [mk_ail_ctype_pe ty1, pe1, pe2])))
        | Bxor =>
          ("§6.5.11",
            (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
              Pexpr ([] : List annot) () (PEctor CivXOR [mk_ail_ctype_pe ty1, pe1, pe2])))
        | Bor =>
          ("§6.5.12",
            (fun (ty1 : ctype) (pe1 : generic_pexpr Unit sym) (pe2 : generic_pexpr Unit sym) =>
              Pexpr ([] : List annot) () (PEctor CivOR [mk_ail_ctype_pe ty1, pe1, pe2])))
        | /- BISECT-IGNORE -/ _ =>
          (failwithI "[Translation.translate_bitwise_operator], 'bop' must be a bitwise operator" :
            (String ×
              (ctype → generic_pexpr Unit sym → generic_pexpr Unit sym → generic_pexpr Unit
                sym))) with
  | (std_id, stdlib_call) =>
    bind1 (wrapped_fresh_symbol (BTy_loaded OTy_integer))
      (fun (e1_wrp : wrapped_symbol) =>
        bind1 (wrapped_fresh_symbol (BTy_loaded OTy_integer)) (fun (e2_wrp : wrapped_symbol) =>
          bind1 (wrapped_fresh_symbol (BTy_object OTy_integer)) (fun (obj1_wrp : wrapped_symbol) =>
            bind1 (wrapped_fresh_symbol (BTy_object OTy_integer))
              (fun (obj2_wrp : wrapped_symbol) =>
                bind1 (translate_expr e1) (fun (core_e1 : generic_expr Unit Unit sym) =>
                  bind1 (translate_expr e2) (fun (core_e2 : generic_expr Unit Unit sym) =>
                    match mk_std_pair_pe (String.append std_id "#3")
                        (usual_arithmetic_conversion
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e1)
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e2)
                          obj1_wrp.sym_pe obj2_wrp.sym_pe) with
                    | (promoted1_pe, promoted2_pe) =>
                      (let core_bop := stdlib_call result_ty promoted1_pe promoted2_pe;
                       return0
                         (add_std std_id
                           (mk_wseq_e (mk_tuple_pat [e1_wrp.sym_pat, e2_wrp.sym_pat])
                             (mk_unseq_e [core_e1, core_e2])
                             (mk_pure_e
                               (mk_case_pe (mk_tuple_pe [e1_wrp.sym_pe, e2_wrp.sym_pe])
                                 [(mk_tuple_pat
                                   [mk_specified_pat obj1_wrp.sym_pat,
                                     mk_specified_pat
                                       obj2_wrp.sym_pat], /- Both operand are specified -/
                                   mk_specified_pe
                                     (mk_std_pe (String.append std_id "#4")
                                       (lem_if CerbGlobal.is_CHERI () && is_ptr_t result_ty then
                                         mk_cheri_derive_and_assign_cap
                                           ((is_signed_integer_type _lemReader_enum_definitions
                                             _lemReader_tagDefs) result_ty)
                                           (DCbinary (Arithmetic aop))
                                           (obj1_wrp.sym_pe, obj2_wrp.sym_pe) core_bop
                                       else
                                         core_bop))),
                                   (mk_empty_pat
                                     (BTy_tuple [BTy_loaded OTy_integer, BTy_loaded OTy_integer]),
                                     mk_unspecified_pe
                                       result_ty)]))))))))))) /- MUST BE in { A.PostfixIncr, A.PostfixDecr } -/

def translate_postfix [CerberusFresh.Digest] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) (loc1 : CerbLocation.Loc)
    (translate_expr : expression genTypeCategory → elab_state →
      (generic_expr Unit Unit sym × elab_state)) (stdlib1 : translation_stdlib) (result_ty : ctype)
    (op : unaryOperator) (e : expression genTypeCategory) :
    elab_state →
        (generic_expr Unit Unit sym ×
          elab_state) := /- TODO: use atomic RMW if the type is atomic -/
  /- NOTE: if I read N2329 correctly, in C2X this will not be an RMW for the atomic case (but a do while
           with compare_exchange_weak with seq_cst, seq_cst) -/
  match match op with
        | PostfixIncr => ("#2", OpAdd, IOpAdd, (1 : Int))
        | PostfixDecr => ("#3", OpSub, IOpSub, ((0 : Int) - (1 : Int)))
        | /- BISECT-IGNORE -/ _ =>
