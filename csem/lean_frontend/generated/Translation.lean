def wrapped_translate_expression [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl]
    [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (translate_block_opt : Option
      ((expression genTypeCategory → elabM (expr Unit)) → bindings → List
        (statement genTypeCategory) → elabM (expr Unit))) (is_used : Bool) (ctx : expr_ctx)
    (variadic_env : (Option sym × Option sym)) (stdlib1 : translation_stdlib)
    (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition)) (e : expression genTypeCategory) :
    elab_state → (generic_expr Unit Unit sym × elab_state) :=
  bind1
    (track_temporary_objects
      ((translate_expression _lemReader_enum_definitions _lemReader_tagDefs) translate_block_opt
        is_used ctx variadic_env stdlib1 tagDefs1 e))
    (fun (p : (List (wrapped_symbol × ctype) × generic_expr Unit Unit sym)) =>
      match p with
      | (xs, core_e) =>
        (let bound_core := Expr [Astd "§6.5#2"] (Ebound core_e);
         match xs with
         | [] => return0 bound_core
         | _ =>
           (let loc1 :=
              match e with
              | (AnnotatedExpression _ _ loc1 _) => loc1;
            match lemListUnzip
                (List.map
                  (fun (p : (wrapped_symbol × ctype)) =>
                    match p with
                    | (ptr_wrp, ty1) =>
                      ((ptr_wrp.sym_pat,
                        (let core_ty := mk_ail_ctype_pe ty1;
                         pcreate loc1 (mk_alignof_pe core_ty) core_ty
                           (PrefTemporaryLifetime loc1 (digest_of_sym ptr_wrp.sym_sym)))),
                        pkill loc1 (Static0 ty1) ptr_wrp.sym_pe)) xs) with
            | (core_creates, core_kills) =>
              bind1
                (wrapped_fresh_symbol
                  (maybe0 BTy_unit BTy_loaded
                    (core_object_type_of_ctype
                      ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e))))
                (fun (e_wrp : wrapped_symbol) =>
                  return0
                    (add_std "§6.2.4#8"
                      (mk_sseqs core_creates
                        (mk_sseq_e e_wrp.sym_pat bound_core
                          (mk_unit_sseq core_kills (mk_pure_e e_wrp.sym_pe)))))))))

/- TODO: make use of this function for elaboration of normal AilSblock statements -/
def translate_block { a b : Type } [CerberusFresh.Digest] [CerbImplCfg.Impl]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (translate_expr_opt : Option
      (expression genTypeCategory → elab_state → (generic_expr Unit Unit sym × elab_state)))
    (self : statement genTypeCategory → stateM (generic_expr Unit Unit sym) elab_state)
    (loc1 : CerbLocation.Loc) (f : sym)
    (binds : List (sym × ((CerbLocation.Loc × b × a) × Option alignment × qualifiers × ctype)))
    (ss : List (statement genTypeCategory)) :
    elab_state → (generic_expr Unit Unit sym × elab_state) :=
  let decls_with_loc :=
    let x2 := ([] : List (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype)));
    lemListFoldr
      (fun (p : (sym × ((CerbLocation.Loc × b × a) × Option alignment × qualifiers × ctype)))
        (x2 : List (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
        match p, x2 with
        | (sym1, ((ident_loc, _, _), align_opt, qs, ty1)), x2 =>
          (lem_if true then (sym1, ident_loc, (align_opt, qs, ty1)) :: x2 else x2)) x2 binds;
  let decls1 :=
    List.map
      (fun (p : (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
        match p with
        | (sym1, _, (_, qs, ty1)) => (sym1, (qs, ty1))) decls_with_loc;
  bind1
    (with_block_objects decls1
      (match Lem_List.dest_init ss with
       | none => return0 (fun (kills : List (expr Unit)) => mk_unit_sseq kills mk_skip_e)
       | some (first_ss, last_s) =>
         (match translate_expr_opt with
          | none =>
            bind1 (mapM0 self ss) (fun (core_ss : List (generic_expr Unit Unit sym)) =>
              return0 (fun (kills : List (generic_expr Unit Unit sym)) =>
                mk_unit_sseq (core_ss ++ kills) mk_skip_e))
          | some translate_expr =>
            (match last_s.node with
             | AilSexpr e =>
               (let ty1 :=(ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e;
                let bTy :=
                  lem_if is_void ty1 then
                    BTy_unit
                  else
                    BTy_loaded (force_core_object_type_of_ctype ty1);
                bind1 (wrapped_fresh_symbol bTy) (fun (e_wrp : wrapped_symbol) =>
                  bind1 (mapM0 self first_ss) (fun (core_first_ss : List (expr Unit)) =>
                    bind1 (translate_expr e) (fun (core_e : generic_expr Unit Unit sym) =>
                      return0 (fun (kills : List (expr Unit)) =>
                        mk_unit_sseq core_first_ss
                          (mk_sseq_e e_wrp.sym_pat core_e
                            (mk_unit_sseq kills (mk_pure_e e_wrp.sym_pe))))))))
             | _ =>
               bind1 (mapM0 self ss) (fun (core_ss : List (generic_expr Unit Unit sym)) =>
                 return0 (fun (kills : List (generic_expr Unit Unit sym)) =>
                   mk_unit_sseq (core_ss ++ kills) mk_skip_e))))))
    (fun (p :
      (List (sym × (qualifiers × ctype × sym)) × List
        (CerbLocation.Loc × prefix0 × sym × Bool × ctype) ×
        (List (generic_expr Unit Unit sym) → generic_expr Unit Unit sym))) =>
      match p with
      | (const_aliases, compound_lits, mk_core) =>
        (let lit_pats_core_creates : List (pattern × expr Unit) :=
           List.map
             (fun (p : (CerbLocation.Loc × prefix0 × sym × Bool × ctype)) =>
               match p with
               | (loc1, prefix2, sym1, is_const, ty1) =>
                 (let core_ty := mk_ail_ctype_pe ty1;
                  (mk_sym_pat sym1 (BTy_object OTy_pointer),
                    pcreate loc1 (mk_alignof_pe core_ty) core_ty prefix2))) compound_lits;
         /- the symbolic names and create actions for the local variables -/
         let pats_core_creates : List (pattern × expr Unit) :=
           List.map
             (fun (p : (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
               match p with
               | (sym1, ident_loc, (align_opt, qs, ty1)) =>
                 (let c_ty := mk_ail_ctype_pe ty1;
                  let align_ival :=
                    match align_opt with
                    | some (AlignInteger n) => mk_integer_pe n
                    | some (AlignType al_ty) => mk_alignof_pe (mk_ail_ctype_pe al_ty)
                    | none => mk_alignof_pe c_ty;
                  (mk_sym_pat sym1 (BTy_object OTy_pointer),
                    pcreate (CerbLocation.withCursorFrom loc1 ident_loc) align_ival c_ty
                      (PrefSource ident_loc [f, sym1])))) decls_with_loc;
         let cheri_const_intrinsic :=
           lem_if CerbGlobal.is_CHERI () then
             List.map
               (fun (p : (sym × (qualifiers × ctype × sym))) =>
                 match p with
                 | (sym1, (qs, ty1, sym')) =>
                   (/- TODO: the partial pattern match in the lets is tasteless (even though the memop()
          never evaluates to an unspecified value) -/
                   let ptr_ty := mk_ctype_pointer qs ty1;
                   (mk_specified_pat (mk_sym_pat sym' (BTy_object OTy_pointer)),
                     cheri_readonly_perms ptr_ty (mk_sym_pe sym1)))) const_aliases
           else
             ([] : List (generic_pattern sym × generic_expr Unit Unit sym));
         let pat_core_kills : List (expr Unit) :=
           List.map
             (fun (p : (CerbLocation.Loc × prefix0 × sym × Bool × ctype)) =>
               match p with
               | (loc1, _, sym1, _, ty1) =>
                 pkill (CerbLocation.withCursorFrom loc1 loc1) (Static0 ty1) (mk_sym_pe sym1))
             compound_lits;
         /- NOTE: doing the kills here is now redundant if there is are returns before all exit point.
      but it may be nasty to do the check.
      For non-void function however we know (?) that their must be these returns ?? so we could drop the kills here -/
         /- the kill actions for the local variables -/
         let core_kills : List (expr Unit) :=
           List.map
             (fun (p : (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
               match p with
               | (sym1, ident_loc, (_, _, ty1)) =>
                 pkill (CerbLocation.withCursorFrom loc1 ident_loc) (Static0 ty1) (mk_sym_pe sym1))
             decls_with_loc;
         return0
           (/- NOTE: we sequence (left-to-right) the creates and kills of the block-scoped objects -/ mk_sseqs
             ((lit_pats_core_creates ++ pats_core_creates) ++ cheri_const_intrinsic)
             (mk_core (core_kills ++ pat_core_kills)))))

def translate_stmt_lemFuel [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (lemFuel : Nat) (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (stdlib1 : translation_stdlib) (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (f : sym) (env1 : translate_stmt_env) (stmt : statement genTypeCategory) :
    elabM (expr Unit) :=
  match lemFuel with
  | 0 => (failwithI CerbFuel.fuelExhaustedMsg)
  | Nat.succ lemFuel =>
    (let loc1 := stmt.loc;
     let self :=(translate_stmt_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs)
         stdlib1 tagDefs1 f env1;
     let translate_expression1 : Bool → expression genTypeCategory → elab_state →
       (generic_expr Unit Unit sym × elab_state) :=
       (fun (is_used : Bool) =>
         (wrapped_translate_expression _lemReader_enum_definitions _lemReader_tagDefs)
           (some
             (fun (translate_expr : expression genTypeCategory → elab_state →
               (generic_expr Unit Unit sym × elab_state)) =>
               (translate_block _lemReader_enum_definitions _lemReader_tagDefs)
                 (some translate_expr) self loc1 f)) is_used ECTX_other
           (env1.variadic_sym_opt, env1.last_arg_sym_opt) stdlib1 tagDefs1);
     let translate_cases_block : List (case_selector0 × sym) → Option sym → statement
       genTypeCategory → stateM (generic_expr Unit Unit sym) elab_state :=
       (fun (case_labs1 : List (case_selector0 × sym)) (default_lab1 : Option sym) =>
         (translate_stmt_lemFuel lemFuel _lemReader_enum_definitions _lemReader_tagDefs) stdlib1
           tagDefs1 f { { env1 with default_lab := default_lab1 } with case_labs := case_labs1 });
     bind1
       (match stmt.node with
        | AilSskip => return0 mk_skip_e
        | AilSexpr e =>
          bind1 (translate_expression1 false e) (fun (core_e : generic_expr Unit Unit sym) =>
            return0
              (mk_sseq_e
                (mk_empty_pat
                  (maybe0 BTy_unit BTy_loaded
                    (core_object_type_of_ctype
                      ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e)))) core_e
                (mk_pure_e mk_unit_pe)))
        /- | A.AilSblock [] ss ->
        E.with_block_objects [] (E.mapM self ss) >>= fun (_, core_ss) ->
        E.return (Caux.mk_unit_sseq core_ss Caux.mk_skip_e)
    
    | A.AilSblock [(sym, ((ident_loc, _, _), align_opt, qs, ty))] ss ->
        let c_ty = Caux.mk_ail_ctype_pe ty in
        let align_ival  =
        match align_opt with
          | Just (Ctype.AlignInteger n) ->
              Caux.mk_integer_pe n
          | Just (Ctype.AlignType al_ty) ->
              Caux.mk_alignof_pe (Caux.mk_ail_ctype_pe al_ty)
          | Nothing ->
              Caux.mk_alignof_pe c_ty
        end in
        E.with_block_objects [(sym, (qs, ty))] begin
          E.mapM self ss
        end >>= fun (_, core_ss) ->
        let new_loc = Loc.with_cursor_from loc ident_loc in
        E.return begin
          Caux.mk_sseq_e (Caux.mk_sym_pat sym (C.BTy_object C.OTy_pointer))
             (Caux.pcreate new_loc align_ival c_ty (Symbol.PrefSource ident_loc [f; sym])) (
            List.foldr (fun core_s acc ->
              Caux.mk_sseq_e (Caux.mk_empty_pat C.BTy_unit) core_s acc
            ) (Caux.pkill new_loc (C.Static ty) (Caux.mk_sym_pe sym)) core_ss
          )
        end -/
        | AilSblock binds ss =>
          (let decls_with_loc :=
             let x2 :=
               ([] : List (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype)));
             lemListFoldr
               (fun (p :
                 (sym ×
                   ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers ×
                     ctype)))
                 (x2 : List (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
                 match p, x2 with
                 | (sym1, ((ident_loc, _, _), align_opt, qs, ty1)), x2 =>
                   (lem_if true then (sym1, ident_loc, (align_opt, qs, ty1)) :: x2 else x2)) x2
               binds;
           let decls1 :=
             List.map
               (fun (p : (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
                 match p with
                 | (sym1, _, (_, qs, ty1)) => (sym1, (qs, ty1))) decls_with_loc;
           bind1 (with_block_objects decls1 (mapM0 self ss))
             (fun (p :
               (List (sym × (qualifiers × ctype × sym)) × List
                 (CerbLocation.Loc × prefix0 × sym × Bool × ctype) × List
                 (generic_expr Unit Unit sym))) =>
               match p with
               | (const_aliases, compound_lits, core_ss) =>
                 (let lit_pats_core_creates : List (pattern × expr Unit) :=
                    List.map
                      (fun (p : (CerbLocation.Loc × prefix0 × sym × Bool × ctype)) =>
                        match p with
                        | (loc1, prefix2, sym1, is_const, ty1) =>
                          (let core_ty := mk_ail_ctype_pe ty1;
                           (mk_sym_pat sym1 (BTy_object OTy_pointer),
                             pcreate loc1 (mk_alignof_pe core_ty) core_ty prefix2))) compound_lits;
                  /- the symbolic names and create actions for the local variables -/
                  let pats_core_creates : List (pattern × expr Unit) :=
                    List.map
                      (fun (p :
                        (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
                        match p with
                        | (sym1, ident_loc, (align_opt, qs, ty1)) =>
                          (let c_ty := mk_ail_ctype_pe ty1;
                           let align_ival :=
                             match align_opt with
                             | some (AlignInteger n) => mk_integer_pe n
                             | some (AlignType al_ty) => mk_alignof_pe (mk_ail_ctype_pe al_ty)
                             | none => mk_alignof_pe c_ty;
                           (mk_sym_pat sym1 (BTy_object OTy_pointer),
                             pcreate (CerbLocation.withCursorFrom loc1 ident_loc) align_ival c_ty
                               (PrefSource ident_loc [f, sym1])))) decls_with_loc;
                  let cheri_const_intrinsic :=
                    lem_if CerbGlobal.is_CHERI () then
                      List.map
                        (fun (p : (sym × (qualifiers × ctype × sym))) =>
                          match p with
                          | (sym1, (qs, ty1, sym')) =>
                            (/- TODO: the partial pattern match in the lets is tasteless (even though the memop()
                never evaluates to an unspecified value) -/
                            let ptr_ty := mk_ctype_pointer qs ty1;
                            (mk_specified_pat (mk_sym_pat sym' (BTy_object OTy_pointer)),
                              cheri_readonly_perms ptr_ty (mk_sym_pe sym1)))) const_aliases
                    else
                      ([] : List (generic_pattern sym × generic_expr Unit Unit sym));
                  let pat_core_kills : List (expr Unit) :=
                    List.map
                      (fun (p : (CerbLocation.Loc × prefix0 × sym × Bool × ctype)) =>
                        match p with
                        | (loc1, _, sym1, _, ty1) =>
                          pkill (CerbLocation.withCursorFrom loc1 loc1) (Static0 ty1)
                            (mk_sym_pe sym1)) compound_lits;
                  /- NOTE: doing the kills here is now redundant if there is are returns before all exit point.
            but it may be nasty to do the check.
            For non-void function however we know (?) that their must be these returns ?? so we could drop the kills here -/
                  /- the kill actions for the local variables -/
                  let core_kills : List (expr Unit) :=
                    List.map
                      (fun (p :
                        (sym × CerbLocation.Loc × (Option alignment × qualifiers × ctype))) =>
                        match p with
                        | (sym1, ident_loc, (_, _, ty1)) =>
                          pkill (CerbLocation.withCursorFrom loc1 ident_loc) (Static0 ty1)
                            (mk_sym_pe sym1)) decls_with_loc;
                  return0
                    (/- NOTE: we sequence (left-to-right) the creates and kills of the block-scoped objects -/ mk_sseqs
                      ((lit_pats_core_creates ++ pats_core_creates) ++ cheri_const_intrinsic)
                      (mk_unit_sseq ((core_ss ++ core_kills) ++ pat_core_kills) mk_skip_e)))))
        | AilSif e s1 s2 =>
          bind1 (wrapped_fresh_symbol BTy_boolean) (fun (do_then_wrp : wrapped_symbol) =>
            bind1 (wrapped_fresh_symbol (BTy_loaded OTy_integer))
              (fun (test_wrp : wrapped_symbol) =>
                bind1 (wrapped_fresh_symbol (BTy_object OTy_integer))
                  (fun (case_wrp : wrapped_symbol) =>
                    bind1
                      (translate_expression1 true
                        ((mkTestExpression _lemReader_enum_definitions _lemReader_tagDefs) TestEq
                          e))
                      (fun (core_test : generic_expr Unit Unit sym) =>
                        bind1 (self s1) (fun (core_s1 : generic_expr Unit Unit sym) =>
                          bind1 (self s2)
                            (fun (core_s2 : generic_expr Unit Unit
                              sym) => /- NOTE: here we fix the strictness of unspecified values -/
                              return0
                                (/- NOTE: the case-of producing a boolean (instead of directly doing the control
             with the case) is to prevent possible combinatorial explosions of the generated Core code -/
                                mk_sseq_e test_wrp.sym_pat core_test
                                  (mk_sseq_e do_then_wrp.sym_pat
                                    (mk_case_e test_wrp.sym_pe
                                      [(mk_specified_pat case_wrp.sym_pat,
                                        mk_pure_e
                                          (mk_if_pe
                                            (mk_not_pe
                                              (mk_op_pe OpEq case_wrp.sym_pe
                                                (mk_integer_pe ((1 : Int))))) (mk_boolean_pe true)
                                            (mk_boolean_pe
                                              false))) /- non-deterministic branching if the test expression had unspecified value -/,
                                        (mk_unspecified_pat (mk_empty_pat BTy_ctype),
                                          mk_nd_e
                                            [mk_pure_e (mk_boolean_pe true),
                                              mk_pure_e (mk_boolean_pe false)])])
                                    (mk_if_e do_then_wrp.sym_pe core_s1 core_s2)))))))))
        | AilSwhile e s loop_id1 =>
          bind1
            (/- NOTE: the object type is OTy_integer since we are using mkTestExpression which turns [e] into [e == 0] -/ fresh_elab_pretty_with_id
              (fun (x : Nat) => String.append "while_" (Lem_String_extra.stringFromNat x)))
            (fun (sym_loop : sym) =>
              bind1 (wrapped_fresh_symbol BTy_boolean) (fun (do_loop_wrp : wrapped_symbol) =>
                bind1 (wrapped_fresh_symbol (BTy_loaded OTy_integer))
                  (fun (test_wrp : wrapped_symbol) =>
                    bind1 (wrapped_fresh_symbol (BTy_object OTy_integer))
                      (fun (case_wrp : wrapped_symbol) =>
                        bind1
                          (translate_expression1 true
                            ((mkTestExpression _lemReader_enum_definitions _lemReader_tagDefs)
                              TestEq e))
                          (fun (core_test : generic_expr Unit Unit sym) =>
                            bind1 (self s) (fun (core_s : generic_expr Unit Unit sym) =>
                              bind1 get_visible_objects
                                (fun (visible_syms1 : List
                                  sym) => /- TODO: the types of the annotations in Esave are dummy, but this is not observable for now -/
                                  let core_s_loop :=
                                    mk_sseq_e (mk_empty_pat BTy_unit) core_s
                                      (mk_run_e sym_loop
                                        (let x2 := ([] : List (generic_pexpr Unit sym));
                                         lemListFoldr
                                           (fun (sym1 : sym) (x2 : List (generic_pexpr Unit sym)) =>
                                             lem_if true then mk_sym_pe sym1 :: x2 else x2) x2
                                           visible_syms1));
                                  bind1
                                    (mapM0
                                      (fun (sym1 : sym) =>
                                        bind1 (resolve_object_type sym1)
                                          (fun (p : (qualifiers × ctype)) =>
                                            match p with
                                            | (_, ty1) =>
                                              return0
                                                (sym1,
                                                  ((BTy_object OTy_pointer, some (ty1, By_pointer)),
                                                    mk_sym_pe sym1)))) visible_syms1)
                                    (fun (args : List
                                      (sym ×
                                        ((core_base_type × Option
                                          (ctype × pass_by_value_or_pointer)) × pexpr))) =>
                                      return0
                                        (mk_save_e_ [Alabel (LAloop loop_id1)] (sym_loop, BTy_unit)
                                          args
                                          (mk_sseq_e test_wrp.sym_pat core_test
                                            (mk_sseq_e do_loop_wrp.sym_pat
                                              (mk_case_e test_wrp.sym_pe
                                                [(mk_specified_pat case_wrp.sym_pat,
                                                  mk_pure_e
