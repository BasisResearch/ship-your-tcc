    AtomicCompareExchangeStrongExplicit AtomicCompareExchangeWeakExplicit LinuxStore0 LinuxLoad0
    LinuxFence0 LinuxRMW0)
instance : Inhabited atomic_explicit where
  default := AtomicStoreExplicit
instance (priority := 500) : Lem_Basic_classes.SetType atomic_explicit where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 atomic_explicit where
  isEqual x y := x == y
