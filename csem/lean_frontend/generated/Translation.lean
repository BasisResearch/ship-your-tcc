        elabM (expr Unit) :=
  translate_stmt_lemFuel LemFuel.fuel
theorem translate_stmt_lemFuel_zero [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl]
    [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (stdlib1 : translation_stdlib) (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (f : sym) (env1 : translate_stmt_env) (stmt : statement genTypeCategory) :
    translate_stmt_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs stdlib1 tagDefs1 f env1
        stmt = (failwithI CerbFuel.fuelExhaustedMsg) :=
  rfl

def translate_tag_definitions
    (ctx : List (sym × (CerbLocation.Loc × attributes × tag_definition))) :
    Fmap sym (CerbLocation.Loc × tag_definition) :=
  Lem_Map.fromList
    (List.map
      (fun (p : (sym × (CerbLocation.Loc × attributes × tag_definition))) =>
        match p with
        | (x, (loc1, _, y)) => (x, (loc1, y))) ctx)

def translate_program [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl] [CerbGlobal.Switches]
    (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (stdlib1 : translation_stdlib) (p : (Option sym × sigma genTypeCategory)) :
    elab_state →
        ((Fmap sym (CerbLocation.Loc × tag_definition) × Fmap sym integerType × List
          (sym × generic_globs Unit Unit) × Fmap sym (generic_fun_map_decl Unit Unit) × Fmap sym
          (CerbLocation.Loc × attributes × ctype × List (Option sym × ctype) × Bool × Bool)) ×
          elab_state) :=
  match stdlib1, p with
  | stdlib1, (startup_sym_opt, sigm) =>
    (let core_tagDefs := translate_tag_definitions sigm.tag_definitions;
     /- program-data parameters E-A (2026-09-20): the enums' compatible types
     ride beside the tag definitions into the Core file -/
     let core_enumDefs := Lem_Map.fromList sigm.enum_definitions;
     bind1
       (foldlM
         (fun (p :
           (List (sym × generic_globs Unit Unit) × Fmap sym (generic_fun_map_decl Unit Unit) × Fmap
             sym (CerbLocation.Loc × attributes × ctype × List (Option sym × ctype) × Bool × Bool)))
           (p0 : (sym × (CerbLocation.Loc × attributes × declaration))) =>
           match p, p0 with
           | (gacc, facc, finfoacc), (sym1, (loc1, decl_attrs, decl)) =>
             (/- for each Ail declaration -/
             match decl with
             | Decl_object _ align qs ty1 =>
               (/- elaboration of a global variables -/
               let core_ty := mk_ail_ctype_pe ty1;
               let align_ival :=
                 match align with
                 | some (AlignInteger n) => mk_integer_pe n
                 | some (AlignType al_ty) => mk_alignof_pe (mk_ail_ctype_pe al_ty)
                 | none => mk_alignof_pe (mk_ail_ctype_pe ty1);
               let core_create :=(match decode_with_address decl_attrs with
                                  | Sum.inr (some addr) =>
                                    add_annot (Acerb (ACerb_with_address addr))
                                  | _ => (fun (z : generic_expr Unit Unit sym) => z))
                   (pcreate loc1 align_ival core_ty (PrefSource loc1 [sym1]));
               bind1
                 (/- C1 m1: the mint stays UNCONDITIONAL (it is unused on the
             external-object branch — kept to preserve numbering) -/
                 fresh_elab_sym SD_None)
                 (fun (sym_global : sym) =>
                   match (lookupBy
                       (fun (sym1 : sym) (sym2 : sym)=>
                         match sym1, sym2 with
                         | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                           (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) &&
                               (n1 == n2) then
                             lem_if natGteb 0 5 && (sd1 != sd2) then
                               (lemSeq
                                 (fun _ =>
                                   CerbDebug.print_debug_pure 5 ([] : List domain)
                                     (fun (u : Unit) =>
                                       match u with
                                       | () =>
                                         String.append
                                           "[Symbol.symbolEqual] suspicious equality ==> "
                                           (String.append (show_symbol_description sd1)
                                             (String.append " <-> "
                                               (show_symbol_description sd2))))) (fun _ => true))
                             else
                               true
                           else
                             false)) sym1 sigm.object_definitions) with
                   | none => /- we are dealing with an external object -/
                     return0
                       (((sym1, GlobalDecl (BTy_object OTy_pointer, ty1)) :: gacc), facc, finfoacc)
                   | some expr1 =>
                     bind1
                       (lem_if is_pointer ty1 && is_null_pointer_constant expr1 then
                         return0
                           (BTy_loaded OTy_pointer, mk_pure_e (mk_specified_pe (mk_nullptr_pe ty1)))
                       else
                         bind1
                           (/- NOTE: we use `with_block_objects`, for the compound_literal tracking -/ with_block_objects
                             ([] : List (sym × (qualifiers × ctype)))
                             ((wrapped_translate_expression _lemReader_enum_definitions
                               _lemReader_tagDefs) none true (ECTX_glob sym1 sym_global)
                               ((none : Option sym), (none : Option sym)) stdlib1 core_tagDefs
                               expr1))
                           (fun (p :
                             (List (sym × (qualifiers × ctype × sym)) × List
                               (CerbLocation.Loc × prefix0 × sym × Bool × ctype) × generic_expr Unit
                               Unit sym)) =>
                             match p with
                             | (_, compound_lits, core) =>
                               (let lit_pats_core_creates : List (pattern × expr Unit) :=
                                  List.map
                                    (fun (p : (CerbLocation.Loc × prefix0 × sym × Bool × ctype)) =>
                                      match p with
                                      | (loc1, prefix2, sym1, is_const, ty1) =>
                                        (let core_ty := mk_ail_ctype_pe ty1;
                                         (mk_sym_pat sym1 (BTy_object OTy_pointer),
                                           pcreate loc1 (mk_alignof_pe core_ty) core_ty prefix2)))
                                    compound_lits;
                                return0
                                  (BTy_loaded
                                    (force_core_object_type_of_ctype
                                      ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs)
                                        expr1)), mk_sseqs lit_pats_core_creates core))))
                       (fun (p : (core_base_type × generic_expr Unit Unit sym)) =>
                         match p with
                         | (e_bTy, core_e) =>
                           bind1 (fresh_elab_sym SD_None) (fun (e_sym : sym) =>
                             let core_init_e :=
                               lem_if is_integer ty1 || is_floating ty1 then
                                 conv_loaded_arith stdlib1
                                   ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) expr1)
                                   ty1 (mk_sym_pe e_sym)
                               else
                                 mk_sym_pe e_sym;
                             let mk_store :=/- const-qualified globals are made read-only -/ lem_if qs.const then
                                 (@pstore_lock sym Unit Unit _)
                               else
                                 (@pstore sym Unit Unit _);
                             let core_e :=
                               add_loc
                                 (match core_e with
                                  | (Expr annots1 _) => get_loc_ annots1)
                                 (mk_sseq_e (mk_sym_pat sym_global (BTy_object OTy_pointer))
                                   core_create
                                   (mk_sseq_e (mk_sym_pat e_sym e_bTy) core_e
                                     (mk_sseq_e (mk_empty_pat BTy_unit)
                                       /- TODO: proper memory order -/ (mk_store loc1 core_ty
                                         (mk_sym_pe sym_global) core_init_e NA)
                                       (mk_pure_e (mk_sym_pe sym_global)))));
                             return0
                               (((sym1, GlobalDef (BTy_object OTy_pointer, ty1) core_e) :: gacc),
                                 facc, finfoacc)))))
             | Decl_function has_proto (_, return_ty1) params is_variadic is_inline is_Noreturn1 =>
               (let is_using_inner_arg_temps :=/- NOTE: we exclude main because the driver allocates the objects for argc and argvs -/ /- with this switch the argument temporary objects are allocated in the function -/ CerbGlobal.has_switch
                    CerbGlobal.CerbSwitch.inner_arg_temps;
                /- elaboration of a function -/
                let ret_bTy :=
                  lem_if is_void return_ty1 then
                    BTy_unit
                  else
                    BTy_loaded (force_core_object_type_of_ctype return_ty1);
                let param_bTys :=
                  lem_if is_using_inner_arg_temps then
                    List.map
                      (fun (p : (qualifiers × ctype × Bool)) =>
                        match p with
                        | (_, ty1, _) => BTy_loaded (force_core_object_type_of_ctype ty1)) params
                  else
                    List.replicate (List.length params) (BTy_object OTy_pointer);
                match (lookupBy
                    (fun (sym1 : sym) (sym2 : sym)=>
                      match sym1, sym2 with
                      | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                        (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                          lem_if natGteb 0 5 && (sd1 != sd2) then
                            (lemSeq
                              (fun _ =>
                                CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                                  match u with
                                  | () =>
                                    String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                      (String.append (show_symbol_description sd1)
                                        (String.append " <-> " (show_symbol_description sd2)))))
                              (fun _ => true))
                          else
                            true
                        else
                          false)) sym1 sigm.function_definitions) with
                | none =>
                  (/- if the function has no definition, we create a Core procedure declaration -/
                  let finfo :=/- TODO: plug in non-empty attributes -/ (loc1, decl_attrs,
                      return_ty1 /- TODO: check if we need qualifiers too -/,
                      List.map
                        (fun (p : (qualifiers × ctype × Bool)) =>
                          match p with
                          | (_, ty1, _) => (none, ty1)) params, is_variadic, has_proto);
                  return0
                    (gacc,
                      (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                        (ProcDecl loc1 ret_bTy param_bTys)
                        facc) /- get the correct symbol if a proxy exists -/,
                      match sym1 with
                      | Symbol _ _ (SD_Id str) =>
                        (match (fmapLookupBy defaultCompare str stdlib1.ailnames) with
                         | some sym_proxy =>
                           (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2)
                             sym_proxy finfo finfoacc)
                         | none =>
                           (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1
                             finfo finfoacc))
                      | _ =>
                        (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) sym1 finfo
                          finfoacc)))
                | some (loc1, mrk, _, param_syms, stmt) =>
                  bind1
                    (mapM0
                      (fun (p : (sym × core_base_type)) =>
                        match p with
                        | (s, bTy) =>
                          (let descr :=
                             lem_if not
                                 (CerbGlobal.has_switch CerbGlobal.CerbSwitch.inner_arg_temps) then
                               SD_None
                             else
                               match symbol_description0 s with
                               | SD_ObjectAddress v => SD_FunArgValue v
                               | _ =>
                                 (failwithI
                                   "function argument does not have SD_ObjectAddress description" :
                                   symbol_description);
                           bind1 (wrapped_fresh_symbol_ descr bTy)
                             (fun (p : (sym × generic_pattern sym × generic_pexpr Unit sym)) =>
                               match p with
                               | (sym1, _, sym_pe1) => return0 (sym1, sym_pe1))))
                      (lemListZip param_syms param_bTys))
                    (fun (arg_value_decls : List (sym × generic_pexpr Unit sym)) =>
                      let finfo :=/- NOTE: the attributes in the Ail function declarations includes the ones only present on both
                     the Cabs function declaration and definition -/
                        (loc1, decl_attrs, return_ty1 /- TODO: check if we need qualifiers too -/,
                          List.map
                            (fun (p : (sym × (qualifiers × ctype × Bool))) =>
                              match p with
                              | (sym1, (_, ty1, _)) =>
                                (lem_if CerbGlobal.has_switch
                                    CerbGlobal.CerbSwitch.inner_arg_temps then
                                  let descr :=
                                    match symbol_description0 sym1 with
                                    | SD_ObjectAddress v => SD_FunArgValue v
                                    | _ =>
                                      (failwithI
                                        "function argument does not have SD_ObjectAddress description" :
                                        symbol_description);
                                  (some (set_symbol_description sym1 descr), ty1)
                                else
                                  (some sym1, ty1))) (lemListZip param_syms params), is_variadic,
                          has_proto);
                      bind1
                        (/- C1 m1: fn-def prefix mints in prefix order (ret_label,
                   then the erase pass's contiguous block, then the
                   variadic mint) -/
                        fresh_elab_pretty_with_id
                          (fun (x : Nat) =>
                            String.append "ret_" (Lem_String_extra.stringFromNat x)))
                        (fun (ret_label : sym) =>
                          bind1 (erase_loop_control stmt) (fun (stmt : statement genTypeCategory) =>
                            let visibles := collect_visibles stmt;
                            bind1
                              (lem_if is_variadic then
                                match List.reverse param_syms with
                                | [] =>
                                  (failwithI
                                    "variadic functions need to have at least one parameter" :
                                    elab_state → ((Option sym × Option sym) × elab_state))
                                | sym1 :: _ =>
                                  bind1 (fresh_elab_sym SD_None) (fun (variadic_sym : sym) =>
                                    return0 (some variadic_sym, some sym1))
                              else
                                return0 (none, none))
                              (fun (p : (Option sym × Option sym)) =>
                                match p with
                                | (variadic_sym_opt1, last_arg_sym_opt1) =>
                                  (match lem_if is_using_inner_arg_temps then
                                       let xs :=
                                         List.map
                                           (fun (p : (sym × (qualifiers × ctype × Bool))) =>
                                             match p with
                                             | (sym1, (_, ty1, _)) => (sym1, ty1))
                                           (lemListZip param_syms params);
                                       ((fun (z : elab_state →
                                         (generic_expr Unit Unit sym × elab_state)) =>
                                         bind1
                                           (with_block_objects
                                             (List.map
                                               (fun (p : (sym × ctype)) =>
                                                 match p with
                                                 | (sym1, ty1) => (sym1, (no_qualifiers, ty1))) xs)
                                             z)
                                           (fun (p :
                                             (List (sym × (qualifiers × ctype × sym)) × List
                                               compound_literal_info × generic_expr Unit Unit
                                               sym)) =>
                                             match p with
                                             | (_, _, ret) => return0 ret)),
                                         fmapMap (fun (z : List (sym × ctype)) => z ++ xs)
                                           visibles.label_visibles_)
                                     else
                                       ((fun (z : elab_state →
                                         (generic_expr Unit Unit sym × elab_state)) =>
                                         z), visibles.label_visibles_) with
                                   | (mk_body_wrapper, label_visibles1) =>
                                     bind1
                                       (mk_body_wrapper
                                         ((translate_stmt _lemReader_enum_definitions
                                           _lemReader_tagDefs) stdlib1 core_tagDefs sym1
                                           (({ return_ty := return_ty1,
                                               return_lab := ret_label,
                                               variadic_sym_opt := variadic_sym_opt1,
                                               last_arg_sym_opt := last_arg_sym_opt1,
                                               is_Noreturn := is_Noreturn1,
                                               default_lab := none,
                                               case_labs := ([] : List (case_selector0 × sym)),
                                               loop := none,
                                               break1 := none,
                                               label_visibles := label_visibles1 } :
                                             translate_stmt_env)) stmt))
                                       (fun (core_body : generic_expr Unit Unit sym) =>
                                         let add_prelude_and_epilogue : generic_expr Unit Unit sym →
                                           generic_expr Unit Unit sym :=
                                           (fun (z : generic_expr Unit Unit sym) =>
                                             lem_if is_using_inner_arg_temps then
                                               mk_sseqs
                                                 (List.flatten
                                                   (lemListMapi
                                                     (fun (i : Nat)
                                                       (p :
                                                         ((qualifiers × ctype × Bool) ×
                                                           (sym ×
                                                             (sym × generic_pexpr Unit sym)))) =>
                                                       match i, p with
                                                       | i,
                                                         ((_, ty1, _),
                                                           (ptr_sym, (_, value_sym_pe))) =>
                                                         (let ty_pe := mk_ctype_pe ty1;
                                                          [(mk_sym_pat ptr_sym
                                                            (BTy_object OTy_pointer),
                                                            pcreate loc1 (mk_alignof_pe ty_pe) ty_pe
                                                              (PrefFunArg loc1
                                                                CerberusFresh.Digest.digest
                                                                (Int.ofNat i))),
                                                            (mk_empty_pat BTy_unit,
                                                              pstore loc1 ty_pe (mk_sym_pe ptr_sym)
                                                                value_sym_pe NA)]))
                                                     (lemListZip params
                                                       (lemListZip param_syms arg_value_decls))))
                                                 (mk_unit_sseq
                                                   (z :: List.map
                                                     (fun (p :
                                                       (sym × (qualifiers × ctype × Bool))) =>
                                                       match p with
                                                       | (ptr_sym, (_, ty1, _)) =>
                                                         pkill loc1 (Static0 ty1)
                                                           (mk_sym_pe ptr_sym))
                                                     (lemListZip param_syms params))
                                                   (mk_pure_e mk_unit_pe))
                                             else
                                               z);
                                         bind1
                                           (/- let is_used_sym = Symbol.fresh () in
                let is_used_arg_type = (is_used_sym, C.BTy_boolean) in -/
                                           fresh_elab_sym SD_None)
                                           (fun (ret_sym : sym) =>
                                             let core_return :=
                                               let ret_pe :=
                                                 lem_if (maybeEqualBy
                                                     (fun (sym1 : sym) (sym2 : sym)=>
                                                       match sym1, sym2 with
                                                       | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                                                         (lem_if (CerberusFresh.digest_compare d1
                                                             d2 == (0 : Int)) && (n1 == n2) then
                                                           lem_if natGteb 0 5 && (sd1 != sd2) then
                                                             (lemSeq
                                                               (fun _ =>
                                                                 CerbDebug.print_debug_pure 5
                                                                   ([] : List domain)
                                                                   (fun (u : Unit) =>
                                                                     match u with
                                                                     | () =>
                                                                       String.append
                                                                         "[Symbol.symbolEqual] suspicious equality ==> "
                                                                         (String.append
                                                                           (show_symbol_description
                                                                             sd1)
                                                                           (String.append " <-> "
                                                                             (show_symbol_description
                                                                               sd2)))))
                                                               (fun _ => true))
                                                           else
                                                             true
                                                         else
                                                           false)) startup_sym_opt
                                                     (some
                                                       sym1)) then /- STD §5.1.2.2.3#1 sentence 1 -/
                                                   mk_specified_pe (mk_integer_pe ((0 : Int)))
                                                 else lem_if is_void return_ty1 && is_Noreturn1 then
                                                   mk_std_undef_pe loc1 "§6.7.4#8" UB071_noreturn
                                                 else lem_if is_void return_ty1 then
                                                   mk_unit_pe
                                                 else
                                                   /- Caux.mk_if_pe (Caux.mk_sym_pe is_used_sym)
                        (Caux.mk_std_undef_pe loc "§6.9.1#12" Undefined.UB088_reached_end_of_function)
                        (Caux.mk_unspecified_pe return_ty) in -/
                                                   mk_std_undef_pe loc1 "§6.9.1#12"
                                                     UB088_reached_end_of_function;
                                               mk_save_e_ [Alabel LAreturn, Aloc loc1]
                                                 (ret_label, ret_bTy)
                                                 [(ret_sym,
                                                   ((ret_bTy, some (return_ty1, By_value)),
                                                     ret_pe))] (mk_pure_e (mk_sym_pe ret_sym));
                                             let variadic_arg_type :=
                                               match variadic_sym_opt1 with
                                               | some sym1 =>
                                                 [(sym1,
                                                   BTy_list
                                                     (BTy_tuple
                                                       [BTy_ctype, BTy_object OTy_pointer]))]
                                               | none => ([] : List (sym × core_base_type));
                                             let param_syms :=
                                               lem_if is_using_inner_arg_temps then
                                                 List.map Prod.fst arg_value_decls
                                               else
                                                 param_syms;
                                             return0
                                               (gacc,
                                                 (fmapAddBy
                                                   (fun (sym1 : sym) (sym2 : sym)=>
                                                     ordCompare sym1 sym2) sym1
                                                   (Proc loc1 (some mrk) ret_bTy
                                                     (/- is_used_arg_type :: -/ lemListZip
                                                       param_syms param_bTys ++ variadic_arg_type)
                                                     (mk_sseq_e (mk_empty_pat BTy_unit)
                                                       (add_prelude_and_epilogue core_body)
                                                       core_return)) facc),
                                                 (fmapAddBy
                                                   (fun (sym1 : sym) (sym2 : sym)=>
                                                     ordCompare sym1 sym2) sym1 finfo
                                                   finfoacc))))))))))))
         (([] : List (sym × generic_globs Unit Unit)), fmapEmpty, fmapEmpty)
         (List.reverse sigm.declarations))
       (fun (p :
         (List (sym × generic_globs Unit Unit) × Fmap sym (generic_fun_map_decl Unit Unit) × Fmap
           sym
           (CerbLocation.Loc × attributes × ctype × List (Option sym × ctype) × Bool × Bool))) =>
         match p with
         | (globs1, cfuns, funinfo1) =>
           bind1 /- adding string literals as Core globals -/ get_string_literals
             (fun (xs : List (CerbLocation.Loc × sym × ctype × generic_pexpr Unit sym)) =>
               bind1
                 (foldlM
                   (lem_if CerbGlobal.is_CHERI
                       () then /- For CHERI we do not use create_readonly() -/
                     fun (acc : List (sym × generic_globs Unit Unit))
                       (p : (CerbLocation.Loc × sym × ctype × generic_pexpr Unit sym)) =>
                       match acc, p with
                       | acc, (loc1, sym1, ty1, e_init) =>
                         (let ptr_ty := array_coercion ty1;
                          bind1 (wrapped_fresh_symbol (BTy_object OTy_pointer))
                            (fun (ptr_wrp : wrapped_symbol) =>
                              bind1 (wrapped_fresh_symbol (BTy_loaded OTy_pointer))
                                (fun (tmp_wrp : wrapped_symbol) =>
                                  /-
          lets ptr = create(Ivalignof([| ty |]), [| ty |]) in
          lets _   = store_lock(TY, ptr, [| e_init |]) in
          LET mask = [| ~(CAP_PERM_STORE || CAP_PERM_STORE_CAP || CAP_PERM_STORE_LOCAL_CAP) |] IN
          lets tmp = memop(cheri_perms_and, ptr, mask) in
          case tmp of
            | Specifed(ptr) => pure(ptr)
            | Unspecified(_) => pure(undef("Unspecified cheri_perms_and()"))
          end
        -/
                                  let expr1 :=
                                    let ty_pe := mk_ctype_pe ty1;
                                    mk_sseqs
                                      [(ptr_wrp.sym_pat,
                                        pcreate loc1 (mk_alignof_pe ty_pe) ty_pe
                                          (PrefStringLiteral loc1 (digest_of_sym sym1))),
                                        (mk_empty_pat BTy_unit,
                                          pstore_lock loc1 ty_pe ptr_wrp.sym_pe e_init NA)]
                                      (mk_sseq_e tmp_wrp.sym_pat
                                        (cheri_readonly_perms ptr_ty ptr_wrp.sym_pe)
                                        (mk_case_e tmp_wrp.sym_pe
                                          [(mk_specified_pat ptr_wrp.sym_pat,
                                            mk_pure_e ptr_wrp.sym_pe),
                                            (mk_unspecified_pat (mk_empty_pat BTy_ctype),
                                              mk_pure_e
                                                (mk_undef_pe loc1
                                                  (DUMMY "Unspecified cheri_perms_and()")))]));
                                  return0
                                    ((sym1, GlobalDef (BTy_object OTy_pointer, ty1) expr1) ::
                                      acc))))
                   else
                     fun (acc : List (sym × generic_globs Unit Unit))
                       (p : (CerbLocation.Loc × sym × ctype × generic_pexpr Unit sym)) =>
                       match acc, p with
                       | acc, (loc1, sym1, ty1, e_init) =>
                         (let expr1 :=
                            pcreate_readonly loc1 (mk_alignof_pe (mk_ctype_pe ty1))
                              (mk_ctype_pe ty1) e_init
                              (PrefStringLiteral loc1 (digest_of_sym sym1));
                          return0 ((sym1, GlobalDef (BTy_object OTy_pointer, ty1) expr1) :: acc)))
                   globs1 (List.reverse xs))
                 (fun (globs' : List (sym × generic_globs Unit Unit)) =>
                   return0 (core_tagDefs, core_enumDefs, globs', cfuns, funinfo1)))))

def translate_extern_map { a b : Type } (p : (b × sigma a)) :
    Fmap identifier (List sym × linking_kind) :=
  match p with
  | (_, sigm) =>
    fmapMap
      (fun (p : (sym × id_kind)) =>
        match p with
        | (sym1, kind1) =>
          (match kind1 with
           | IK_declaration => ([sym1], LK_none)
           | IK_tentative => ([sym1], LK_tentative sym1)
           | IK_definition => ([sym1], LK_normal sym1))) sigm.extern_idmap
/- This is the entry function (called from main.ml).
