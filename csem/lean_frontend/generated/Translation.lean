inductive expr_ctx : Type where
  | ECTX_glob : sym → sym → expr_ctx
  | ECTX_logical_operator : expr_ctx /- when elborating the desugaring of && or || -/
  | ECTX_other : expr_ctx
export expr_ctx (ECTX_glob ECTX_logical_operator ECTX_other)
instance : Inhabited expr_ctx where
  default := ECTX_logical_operator
/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def expr_ctx.ctor_rank_ocaml : expr_ctx → Nat
  | .ECTX_glob _ _ => 2
  | .ECTX_logical_operator => 0
  | .ECTX_other => 1
mutual
def expr_ctx.beq_derived (cmpx_ cmpy_ : expr_ctx) : Bool :=
  match cmpx_, cmpy_ with
  | .ECTX_glob x1 x2, .ECTX_glob y1 y2 => x1 == y1 && x2 == y2
  | .ECTX_logical_operator, .ECTX_logical_operator => true
  | .ECTX_other, .ECTX_other => true
  | _, _ => false
termination_by structural cmpx_
def expr_ctx.compare_derived (cmpx_ cmpy_ : expr_ctx) : Ordering :=
  match cmpx_, cmpy_ with
  | .ECTX_glob x1 x2, .ECTX_glob y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | xg, yg => Ord.compare (expr_ctx.ctor_rank_ocaml xg) (expr_ctx.ctor_rank_ocaml yg)
termination_by structural cmpx_
end

instance : BEq expr_ctx where
  beq := expr_ctx.beq_derived
instance : Ord expr_ctx where
  compare := expr_ctx.compare_derived
instance (priority := 500) : Lem_Basic_classes.SetType expr_ctx where
  setElemCompare x y :=
    match expr_ctx.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) : Lem_Basic_classes.Eq0 expr_ctx where
  isEqual := expr_ctx.beq_derived
  isInequal x y := !(expr_ctx.beq_derived x y)
instance (priority := 500) : Lem_Basic_classes.Ord0 expr_ctx where
  compare x y :=
    match expr_ctx.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match expr_ctx.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match expr_ctx.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match expr_ctx.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match expr_ctx.compare_derived x y with
    | .lt => false
    | _ =>
      true /- whether the value of the expression is used (i.e. the expression is directly applied to AilSexpr) -/

def translate_expression_lemFuel [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl]
    [CerbGlobal.Switches] (lemFuel : Nat) (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (translate_block_opt : Option
      ((expression genTypeCategory → elab_state → (generic_expr Unit Unit sym × elab_state)) → List
        (ail_identifier ×
          ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
        List (statement genTypeCategory) → elab_state → (generic_expr Unit Unit sym × elab_state)))
    (is_used : Bool) (ctx : expr_ctx) (variadic_env : (Option sym × Option sym))
    (stdlib1 : translation_stdlib) (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (a_expr : expression genTypeCategory) :
    elab_state → (generic_expr Unit Unit sym × elab_state) :=
  match lemFuel with
  | 0 => (failwithI CerbFuel.fuelExhaustedMsg)
  | Nat.succ lemFuel =>
    (let self :=(translate_expression_lemFuel lemFuel _lemReader_enum_definitions
         _lemReader_tagDefs) translate_block_opt true ctx variadic_env stdlib1 tagDefs1;
     let translate_expression1 :=(translate_expression_lemFuel lemFuel _lemReader_enum_definitions
         _lemReader_tagDefs) translate_block_opt;
     let is_lvalue1 :=
       match genTypeCategoryOf a_expr with
       | GenLValueType _ _ _ => true
       | GenRValueType _ => false;
     let integer_promotion_and_type : ctype → ((pexpr → pexpr) × integerType) :=
       (fun (ty1 : ctype) =>
         let promoted_ty :=(fromJustI "Translation_aux.integer_promotion"
             ((promotion _lemReader_enum_definitions _lemReader_tagDefs)
               ((integerImpl _lemReader_enum_definitions _lemReader_tagDefs) ()) ty1) : ctype);
         let promoted_ity :=
           match promoted_ty with
           | Ctype _ (Basic (Integer ity)) => ity
           | _ => (failwithI "impossible" : integerType);
         (stdlib1.mkcall_conv_int promoted_ty, promoted_ity));
     let integer_promotion2 : ctype → generic_pexpr Unit sym → generic_pexpr Unit sym :=
       (fun (ty1 : ctype) (e : generic_pexpr Unit sym) =>
         match integer_promotion_and_type ty1 with
         | (mk_conversion, promoted_type) => mk_conversion e);
     /- STD §6.3.1.8 -/
     let usual_arithmetic_conversion_aux : Bool → ctype → ctype → generic_pexpr Unit sym →
       generic_pexpr Unit sym → (generic_pexpr Unit sym × generic_pexpr Unit sym) :=
       (fun (is_TMP_new : Bool) (ty1 : ctype) (ty2 : ctype) (e1 : pexpr) (e2 : pexpr) =>
         let r1 := corresponding_real_type ty1;
         let r2 := corresponding_real_type ty2;
         let rt :=
           lem_if (maybeEqualBy (fun x y => x == y) r1 (some LongDouble)) ||
               (maybeEqualBy (fun x y => x == y) r2 (some LongDouble)) then
             LongDouble
           else lem_if (maybeEqualBy (fun x y => x == y) r1 (some Double)) ||
               (maybeEqualBy (fun x y => x == y) r2 (some Double)) then
             Double
           else
             Float0;
         let result_ty := Ctype ([] : List annot) (Basic (Floating (RealFloating rt)));
         match corresponding_real_type ty1, corresponding_real_type ty2 with
         | some _, some _ =>
           (Pexpr ([] : List annot) () (PEctor Cfvconvert [mk_ail_ctype_pe result_ty, e1]),
             Pexpr ([] : List annot) () (PEctor Cfvconvert [mk_ail_ctype_pe result_ty, e2]))
         | some _, _ =>
           (Pexpr ([] : List annot) () (PEctor Cfvconvert [mk_ail_ctype_pe result_ty, e1]),
             Pexpr ([] : List annot) () (PEctor CfvfromintTyped [mk_ail_ctype_pe result_ty, e2]))
         | _, some _ =>
           (Pexpr ([] : List annot) () (PEctor CfvfromintTyped [mk_ail_ctype_pe result_ty, e1]),
             Pexpr ([] : List annot) () (PEctor Cfvconvert [mk_ail_ctype_pe result_ty, e2]))
         | none, none =>
           (let mk_conv_int1 : integerType → generic_pexpr Unit sym → generic_pexpr Unit sym :=
              (fun (ity : integerType) (pe : generic_pexpr Unit sym) =>
                lem_if is_TMP_new then
                  mk_conv_int_pe ity pe
                else
                  stdlib1.mkcall_conv_int (Ctype ([] : List annot) (Basic (Integer ity))) pe);
            /- STD §6.3.1.8#1, bullet 4 -/
            match (promotion _lemReader_enum_definitions _lemReader_tagDefs)
                ((integerImpl _lemReader_enum_definitions _lemReader_tagDefs) ()) ty1,
                (promotion _lemReader_enum_definitions _lemReader_tagDefs)
                  ((integerImpl _lemReader_enum_definitions _lemReader_tagDefs) ()) ty2 with
            | some (ty1'@(Ctype _ (Basic (Integer ity1')))),
              some (ty2'@(Ctype _ (Basic (Integer ity2')))) =>
              (/- "If both operants have the same type, then no further conversion is needed." -/ lem_if ctypeEqual
                  ty1' ty2' then
                (mk_conv_int1 ity1' e1, mk_conv_int1 ity2' e2)
                /- "Otherwise, if both operands have signed integer types or both have unsigned integer types,
                    the operand with the type of lesser integer conversion rank is converted to the type
                    of the operand with greater rank." -/
              else lem_if ((is_signed_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                  ty1' && (is_signed_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                  ty2') ||
                  ((is_unsigned_integer_type _lemReader_enum_definitions _lemReader_tagDefs) ty1' &&
                    (is_unsigned_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                    ty2') then
                lem_if lt_integer_rank ity1' ity2' then
                  (mk_conv_int1 ity2' e1, mk_conv_int1 ity2' e2)
                else
                  (mk_conv_int1 ity1' e1, mk_conv_int1 ity1' e2)
                  /- "Otherwise, if the operand that has unsigned type has rank greater or equal to the rank of the
                    rank of the type of the other operand, then the operand with signed integer type is converted
                    to the type of the operand with unsigned integer type." -/
              else lem_if (is_unsigned_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                  ty1' && ge_integer_rank ity1' ity2' then
                (mk_conv_int1 ity1' e1, mk_conv_int1 ity1' e2)
              else lem_if (is_unsigned_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                  ty2' && ge_integer_rank ity2' ity1' then
                (mk_conv_int1 ity2' e1, mk_conv_int1 ity2' e2)
                /- "Otherwise, if the type of the operand with signed integer type can represent all of the values
                    of the type of the operand with unsigned integer type, then the operand with unsigned integer
                    type is converted to the type of the operand with signed integer type." -/
              else lem_if (is_signed_integer_type _lemReader_enum_definitions _lemReader_tagDefs)
                  ty1' then
                (mk_if_pe (stdlib1.mkcall_all_values_representable_in ty2' ty1')
                  (mk_conv_int1 ity1' e1)
                  /- "Otherwise, both operands are converted to the unsigned integer type corresponding to the type
                         of the operand with signed integer type". -/
                  (mk_conv_int1 (make_corresponding_unsigned ity1') e1),
                  mk_if_pe (stdlib1.mkcall_all_values_representable_in ty2' ty1')
                    (mk_conv_int1 ity1' e2) (mk_conv_int1 (make_corresponding_unsigned ity1') e2))
              else
                (mk_if_pe (stdlib1.mkcall_all_values_representable_in ty1' ty2')
                  (mk_conv_int1 ity2' e1) (mk_conv_int1 (make_corresponding_unsigned ity2') e1),
                  mk_if_pe (stdlib1.mkcall_all_values_representable_in ty1' ty2')
                    (mk_conv_int1 ity2' e2) (mk_conv_int1 (make_corresponding_unsigned ity2') e2)))
            | _, _ =>
              (failwithI "Translation.usual_arithmetic_conversion: not (integer vs integer)" :
                (generic_pexpr Unit sym × generic_pexpr Unit sym))));
     let usual_arithmetic_conversion := usual_arithmetic_conversion_aux false;
     let usual_arithmetic_conversion_TMP_new := usual_arithmetic_conversion_aux true;
     let result_ty :=(ctype_of _lemReader_enum_definitions _lemReader_tagDefs) a_expr;
     lem_if is_pointer result_ty && is_null_pointer_constant
         a_expr then /- NOTE: this is a bit tasteless as it makes the case AilEconst, ConstantNull unreachable -/
       return0 (mk_pure_e (mk_specified_pe (mk_nullptr_pe result_ty)))
     else
       match a_expr with
       | AnnotatedExpression annot1 std_annots loc1 expr1 =>
         bind1
           (/- [FOR CN] If the Ail has a marker annotation (e.g. because we are dealing
       with a C function call with some CN ghost parameters), we need to add a
       object_types_marker in the generated Core. -/
           match get_marker std_annots with
           | some _ =>
             bind1 (record_object_types_marker ()) (fun (id1 : Nat) =>
               return0 (Amarker_object_types id1 :: std_annots))
           | none => return0 std_annots)
           (fun (std_annots : List annot) =>
             bind1
               (match expr1 with
                | AilEunary Plus e =>
                  (/- STD §6.5.3.3#2 -/
                  match lem_if is_integer result_ty then
                      (OTy_integer,
                        integer_promotion2
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e))
                    else
                      (OTy_floating, (fun (z : generic_pexpr Unit sym) => z)) with
                  | (oTy, mk_conversion) =>
                    bind1 (wrapped_fresh_symbol (BTy_object oTy)) (fun (obj_wrp : wrapped_symbol) =>
                      bind1 (wrapped_fresh_symbol (BTy_loaded oTy)) (fun (e_wrp : wrapped_symbol) =>
                        bind1 (self e) (fun (core_e : generic_expr Unit Unit sym) =>
                          return0
                            (add_std "§6.5.3.3#2"
                              (mk_wseq_e e_wrp.sym_pat core_e
                                (mk_pure_e
                                  (mk_case_pe e_wrp.sym_pe
                                    [(mk_specified_pat obj_wrp.sym_pat,
                                      mk_specified_pe (mk_conversion obj_wrp.sym_pe)),
                                      (mk_unspecified_pat (mk_empty_pat BTy_ctype),
                                        mk_unspecified_pe result_ty)]))))))))
                | AilEunary Minus e =>
                  (/- STD §6.5.3.3#3 -/
