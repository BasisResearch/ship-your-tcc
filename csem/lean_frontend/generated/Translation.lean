                          (BTy_object OTy_pointer))
                        (fun (e_wrp : wrapped_symbol) =>
                          bind1 (wrapped_fresh_symbol (BTy_object OTy_pointer))
                            (fun (res_wrp : wrapped_symbol) =>
                              return0
                                (mk_wseq_e e_wrp.sym_pat core_e
                                  (match referenced_type result_ty with
                                   | /- BISECT-IGNORE -/ none =>
                                     illTypedAil loc1 "AilEarray_decay, result_ty not a pointer"
                                   | some ref_ty =>
                                     Expr [Astd "§6.3.2.1#3"]
                                       (lem_if CerbGlobal.has_strict_pointer_arith () ||
                                           (CerbGlobal.is_CHERI () || CerbGlobal.is_PNVI ()) then
                                         Ewseq res_wrp.sym_pat
                                           (Expr ([] : List annot)
                                             (Ememop PtrArrayShift
                                               [e_wrp.sym_pe, mk_ail_ctype_pe ref_ty,
                                                 mk_integer_pe ((0 : Int))]))
                                           (mk_pure_e (mk_specified_pe res_wrp.sym_pe))
                                       else
                                         Epure
                                           (mk_specified_pe
                                             (mk_array_shift e_wrp.sym_pe ref_ty
                                               (mk_integer_pe ((0 : Int))))))))))
                    | GenRValueType _ =>
                      (/- TODO: this is different from what the standard says in two ways:
                    1. we should be allocating a object of the whole struct/union
                       that contains this array (rvalue array_decay only occur when there is such
                       a struct/union)
                    2. the allocation should happen at the evaluation of struct/union rvalue, not
                       at the beginning of the evaluation of the containing full expression -/
                      let oTy :=
                        force_core_object_type_of_ctype
                          ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e);
                      bind1 (wrapped_fresh_symbol (BTy_loaded oTy)) (fun (e_wrp : wrapped_symbol) =>
                        bind1 (wrapped_fresh_symbol (BTy_object OTy_pointer))
                          (fun (res_wrp : wrapped_symbol) =>
                            bind1
                              (register_temporary_object res_wrp
                                ((ctype_of _lemReader_enum_definitions _lemReader_tagDefs) e))
                              (fun (u : Unit) =>
                                match u with
                                | () =>
                                  return0
                                    (mk_wseq_e e_wrp.sym_pat core_e
                                      (mk_wseq_e (mk_empty_pat BTy_unit)
                                        (add_std "§6.2.4#8"
                                          (pstore_lock loc1
                                            (mk_ail_ctype_pe
                                              ((ctype_of _lemReader_enum_definitions
                                                _lemReader_tagDefs) e)) res_wrp.sym_pe e_wrp.sym_pe
                                            NA)) (mk_pure_e (mk_specified_pe res_wrp.sym_pe)))))))))
                | AilEfunction_decay e =>
                  (translate_function_designator _lemReader_enum_definitions _lemReader_tagDefs)
                    self stdlib1 e
                | AilEatomic e => self e
                | AilEgcc_statement bs ss =>
                  (match translate_block_opt with
                   | none => illTypedAil loc1 "AilEgcc_statement"
                   | some translate_block1 => translate_block1 self bs ss)
                | AilEinvalid _ _ =>
                  (failwithI "Translation called on Ail program with an invalid node" : elab_state →
                    (generic_expr Unit Unit sym × elab_state)))
               (fun (a : generic_expr Unit Unit sym) =>
                 return0
                   ((Function.comp (Function.comp (add_loc loc1) add_expr)
                     (lem_if is_lvalue1 then
                       (fun (z : generic_expr Unit Unit sym) => z)
                     else
                       maybe_annotate_integer_type result_ty)) a))))

def translate_expression [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl] [CerbGlobal.Switches] :
    (Fmap sym integerType) -> (Fmap sym (CerbLocation.Loc × tag_definition)) -> Option
        ((expression genTypeCategory → elabM (expr Unit)) → bindings → List
          (statement genTypeCategory) → elabM (expr Unit)) → Bool → expr_ctx →
        (Option sym × Option sym) → translation_stdlib → core_tag_definitions → expression
        genTypeCategory → elabM (expr Unit) :=
  translate_expression_lemFuel LemFuel.fuel
theorem translate_expression_lemFuel_zero [LemFuel] [CerberusFresh.Digest] [CerbImplCfg.Impl]
    [CerbGlobal.Switches] (_lemReader_enum_definitions : Fmap sym integerType)
    (_lemReader_tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
    (translate_block_opt : Option
      ((expression genTypeCategory → elab_state → (generic_expr Unit Unit sym × elab_state)) → List
        (ail_identifier ×
          ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype)) →
        List (statement genTypeCategory) → elab_state → (generic_expr Unit Unit sym × elab_state)))
    (is_used : Bool) (ctx : expr_ctx) (variadic_env : (Option sym × Option sym))
    (stdlib1 : translation_stdlib) (tagDefs1 : Fmap sym (CerbLocation.Loc × tag_definition))
    (a_expr : expression genTypeCategory) :
    translate_expression_lemFuel 0 _lemReader_enum_definitions _lemReader_tagDefs
        translate_block_opt is_used ctx variadic_env stdlib1 tagDefs1 a_expr =
        (failwithI CerbFuel.fuelExhaustedMsg) :=
  rfl

structure collect_cases_state where
  found_default : Bool
  case_csts : List Int
  case_ranges : List (Int × Int)
  deriving BEq, Ord
instance : Inhabited collect_cases_state where
  default := { found_default := default, case_csts := default, case_ranges := default }
instance (priority := 500) : Lem_Basic_classes.SetType collect_cases_state where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 collect_cases_state where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 collect_cases_state where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def collect_cases__lemFuel (lemFuel : Nat) (stmt : statement genTypeCategory) :
    collect_cases_state → (Unit × collect_cases_state) :=
  match lemFuel with
  | 0 => (fuelExhausted (fun st => ((), st)))
  | Nat.succ lemFuel =>
    (let register_case1 : Int → collect_cases_state → (Unit × collect_cases_state) :=
       (fun (n : Int) =>
         update (fun (s : collect_cases_state) => { s with case_csts := n :: s.case_csts }));
     let register_case_range : Int → Int → collect_cases_state → (Unit × collect_cases_state) :=
       (fun (n1 : Int) (n2 : Int) =>
         update (fun (s : collect_cases_state) =>
           { s with case_ranges := (n1, n2) :: s.case_ranges }));
     let register_default1 :=
       update (fun (s : collect_cases_state) => { s with found_default := true });
     match stmt.node with
     | AilSskip => return0 ()
     | AilSexpr _ => return0 ()
     | AilSblock binds ss => mapM_ (collect_cases__lemFuel lemFuel) ss
     | AilSif _ s1 s2 =>
       bind1 ((collect_cases__lemFuel lemFuel) s1) (fun (_ : Unit) =>
         (collect_cases__lemFuel lemFuel) s2)
     | AilSwhile _ s _ => (collect_cases__lemFuel lemFuel) s
     | AilSdo s _ _ => (collect_cases__lemFuel lemFuel) s
     | AilSbreak => return0 ()
     | AilScontinue => return0 ()
     | AilSreturnVoid => return0 ()
     | AilSreturn _ => return0 ()
     | AilSswitch _ _ => return0 ()
     | AilScase n s =>
       bind1 (register_case1 n) (fun (_ : Unit) => (collect_cases__lemFuel lemFuel) s)
     | AilScase_rangeGNU n1 n2 s =>
       (lem_if intLtb n1 n2 then
         bind1 (register_case_range n1 n2) (fun (_ : Unit) => (collect_cases__lemFuel lemFuel) s)
       else /- the frontend should catch this -/
         (failwithI "Translation found a GNU case with empty range" : collect_cases_state →
           (Unit × collect_cases_state)))
     | AilSdefault s =>
       bind1 register_default1 (fun (_ : Unit) => (collect_cases__lemFuel lemFuel) s)
     | AilSlabel _ s _ => (collect_cases__lemFuel lemFuel) s
     | AilSgoto _ => return0 ()
     | AilSdeclaration _ => return0 ()
     | AilSpar ss => mapM_ (collect_cases__lemFuel lemFuel) ss
     | AilSreg_store _ _ => return0 ()
     | AilSmarker _ s => (collect_cases__lemFuel lemFuel) s)

def collect_cases_ (stmt : statement genTypeCategory) : stateM Unit collect_cases_state :=
  collect_cases__lemFuel (statement.lemSize stmt) stmt
theorem collect_cases__lemFuel_zero (stmt : statement genTypeCategory) :
    collect_cases__lemFuel 0 stmt = (fuelExhausted (fun st => ((), st))) :=
  rfl

def collect_cases (s : statement genTypeCategory) : collect_cases_state :=
  Prod.snd
    (runStateM (collect_cases_ s)
      (({ found_default := false,
          case_csts := ([] : List Int),
          case_ranges := ([] : List (Int × Int)) } : collect_cases_state)))

structure erase_loop_control_state where
  elc_continue : Option sym
  elc_break : Option sym
  /- C1 m1b (charter section 3.4 b'): the pass's own supply component.
     DEAD on the OCaml target (elc_fresh_int redirects to the ambient
     counter); on Lean it is seeded from the elaboration supply at the
     erase_loop_control call and returned to it. -/
  elc_supply : Nat
  deriving BEq, Ord
instance : Inhabited erase_loop_control_state where
  default := { elc_continue := default, elc_break := default, elc_supply := default }
instance (priority := 500) : Lem_Basic_classes.SetType erase_loop_control_state where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 erase_loop_control_state where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 erase_loop_control_state where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def elc_fresh_int : erase_loop_control_state → (Nat × erase_loop_control_state) :=
  fun (st : erase_loop_control_state) =>
    let n := st.elc_supply;
    (n, { st with elc_supply := n + 1 })
def erase_loop_control_aux_lemFuel [CerberusFresh.Digest] (lemFuel : Nat)
    (stmt : statement genTypeCategory) :
    erase_loop_control_state → (statement genTypeCategory × erase_loop_control_state) :=
  match lemFuel with
  | 0 => (fuelExhausted (fun st => (stmt, st)))
  | Nat.succ lemFuel =>
    (let loc1 := stmt.loc;
     let with_fresh_labels :
       (erase_loop_control_state → (statement genTypeCategory × erase_loop_control_state)) →
       erase_loop_control_state →
       ((sym × sym × statement genTypeCategory) × erase_loop_control_state) :=
       (fun (mf : erase_loop_control_state →
         (statement genTypeCategory × erase_loop_control_state)) =>
         fun (st : erase_loop_control_state) =>
           /- C1 m1b: the label mints draw from the pass's supply at the same
         run-time firing point as the former ambient draws (continue
         then break); the inner run inherits the advanced supply and
         hands its final supply back to the outer state (the original
         code discarded the inner state entirely — the label fields are
         still discarded, only the supply flows back). -/
           match elc_fresh_int st with
           | (nc, st_c) =>
             (match elc_fresh_int st_c with
              | (nb, st_b) =>
                (let continue_sym :=
                   set_symbol_description (fresh_given_int CerberusFresh.Digest.digest nc)
                     (SD_Id (String.append "continue_" (Lem_String_extra.stringFromNat nc)));
                 let break_sym :=
                   set_symbol_description (fresh_given_int CerberusFresh.Digest.digest nb)
                     (SD_Id (String.append "break_" (Lem_String_extra.stringFromNat nb)));
                 match mf
                     (({ elc_continue := (some continue_sym),
                         elc_break := (some break_sym),
                         elc_supply := st_b.elc_supply } : erase_loop_control_state)) with
                 | (ret, st') =>
                   ((continue_sym, break_sym, ret), { st_b with elc_supply := st'.elc_supply }))));
     state_fmap (mk_statement_full loc1 stmt.desug_info0 stmt.attrs)
       (match stmt.node with
        | AilSskip => return0 stmt.node
        | AilSexpr _ => return0 stmt.node
        | AilSblock binds ss =>
          state_fmap (AilSblock binds) (mapM0 (erase_loop_control_aux_lemFuel lemFuel) ss)
        | AilSif e s1 s2 =>
          app (state_fmap (AilSif e) ((erase_loop_control_aux_lemFuel lemFuel) s1))
            ((erase_loop_control_aux_lemFuel lemFuel) s2)
        | AilSwhile e s loop_id1 =>
          bind1
            (/- STD §6.8.6.2#2 and §6.8.6.3#2 -/ with_fresh_labels
              ((erase_loop_control_aux_lemFuel lemFuel) s))
            (fun (p : (sym × sym × statement genTypeCategory)) =>
              match p with
              | (continue_sym, break_sym, s') =>
                return0
                  (AilSblock
                    ([] : List
                      (ail_identifier ×
                        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                          qualifiers × ctype)))
                    [mk_statement loc1
                      (AilSwhile e
                        (mk_statement loc1
                          (AilSblock
                            ([] : List
                              (ail_identifier ×
                                ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                  qualifiers × ctype)))
                            [s',
                              mk_statement loc1
                                (AilSlabel continue_sym (mk_statement loc1 AilSskip)
                                  (some (LAloop_continue loop_id1)))])) loop_id1),
                      mk_statement loc1
                        (AilSlabel break_sym (mk_statement loc1 AilSskip)
                          (some (LAloop_break loop_id1)))]))
        | AilSdo s e loop_id1 =>
          bind1
            (/- STD §6.8.6.2#2 and §6.8.6.3#2 -/ with_fresh_labels
              ((erase_loop_control_aux_lemFuel lemFuel) s))
            (fun (p : (sym × sym × statement genTypeCategory)) =>
              match p with
              | (continue_sym, break_sym, s') =>
                return0
                  (AilSblock
                    ([] : List
                      (ail_identifier ×
                        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                          qualifiers × ctype)))
                    [mk_statement loc1
                      (AilSdo
                        (mk_statement loc1
                          (AilSblock
                            ([] : List
                              (ail_identifier ×
                                ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                  qualifiers × ctype)))
                            [s',
                              mk_statement loc1
                                (AilSlabel continue_sym (mk_statement loc1 AilSskip)
                                  (some (LAloop_continue loop_id1)))])) e loop_id1),
                      mk_statement loc1
                        (AilSlabel break_sym (mk_statement loc1 AilSskip)
                          (some (LAloop_break loop_id1)))]))
        | AilSbreak =>
          bind1 get0 (fun (x : erase_loop_control_state) => /- BISECT-IGNORE -/
            match x.elc_break with
            | some break_sym => return0 (AilSgoto break_sym)
            | _ => illTypedAil loc1 "AilSbreak")
        | AilScontinue =>
          bind1 get0 (fun (x : erase_loop_control_state) => /- BISECT-IGNORE -/
            match x.elc_continue with
            | some continue_sym => return0 (AilSgoto continue_sym)
            | _ => illTypedAil loc1 "AilScontinue")
        | AilSreturnVoid => return0 stmt.node
        | AilSreturn _ => return0 stmt.node
        | AilSswitch e s =>
          bind1 (with_fresh_labels ((erase_loop_control_aux_lemFuel lemFuel) s))
            (fun (p : (sym × sym × statement genTypeCategory)) =>
              match p with
              | (_, break_sym, s') =>
                return0
                  (AilSblock
                    ([] : List
                      (ail_identifier ×
                        ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                          qualifiers × ctype)))
                    [mk_statement loc1
                      (AilSswitch e
                        (mk_statement loc1
                          (AilSblock
                            ([] : List
                              (ail_identifier ×
                                ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                                  qualifiers × ctype)))
                            [mk_statement loc1 (AilSgoto break_sym), s']))),
                      mk_statement loc1
                        (AilSlabel break_sym (mk_statement loc1 AilSskip) (some LAswitch))]))
        | AilScase n s => state_fmap (AilScase n) ((erase_loop_control_aux_lemFuel lemFuel) s)
        | AilScase_rangeGNU n1 n2 s =>
          state_fmap (AilScase_rangeGNU n1 n2) ((erase_loop_control_aux_lemFuel lemFuel) s)
        | AilSdefault s => state_fmap AilSdefault ((erase_loop_control_aux_lemFuel lemFuel) s)
        | AilSlabel sym1 s m_loop_annot =>
          bind1 ((erase_loop_control_aux_lemFuel lemFuel) s) (fun (s : statement genTypeCategory) =>
            return0 (AilSlabel sym1 s m_loop_annot))
        | AilSgoto _ => return0 stmt.node
        | AilSdeclaration _ => return0 stmt.node
        | AilSpar ss => state_fmap AilSpar (mapM0 (erase_loop_control_aux_lemFuel lemFuel) ss)
        | AilSreg_store _ _ => return0 stmt.node
        | AilSmarker id1 s =>
          state_fmap (AilSmarker id1) ((erase_loop_control_aux_lemFuel lemFuel) s)))

def erase_loop_control_aux [CerberusFresh.Digest] (stmt : statement genTypeCategory) :
    stateM (statement genTypeCategory) erase_loop_control_state :=
  erase_loop_control_aux_lemFuel (statement.lemSize stmt) stmt
theorem erase_loop_control_aux_lemFuel_zero [CerberusFresh.Digest]
    (stmt : statement genTypeCategory) :
    erase_loop_control_aux_lemFuel 0 stmt = (fuelExhausted (fun st => (stmt, st))) :=
  rfl

/- C1 m1b: the pass runs to completion atomically from the fn-def
   elaboration prefix; its supply is seeded from the elaboration supply
   and the final value is returned to it (the pass's draws stay a
   contiguous block — contiguity only, per charter section 3.4 b'). -/

def erase_loop_control [CerberusFresh.Digest] (stmt : statement genTypeCategory) :
    elab_state → (statement genTypeCategory × elab_state) :=
  with_fresh_supply (fun (sup : Nat) =>
    match runStateM (erase_loop_control_aux stmt)
        (({ elc_continue := none, elc_break := none, elc_supply := sup } :
          erase_loop_control_state)) with
    | (stmt', elc_st) => (stmt', elc_st.elc_supply))

structure collect_visibles_state where
  visible_syms : List (sym × ctype)
  label_visibles_ : Fmap sym (List (sym × ctype))
  deriving BEq, Ord
instance : Inhabited collect_visibles_state where
  default := { visible_syms := default, label_visibles_ := default }
instance (priority := 500) : Lem_Basic_classes.SetType collect_visibles_state where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 collect_visibles_state where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 collect_visibles_state where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq
def collect_visibles__lemFuel (lemFuel : Nat) (stmt : statement genTypeCategory) :
    collect_visibles_state → (Unit × collect_visibles_state) :=
  match lemFuel with
  | 0 => (fuelExhausted (fun st => ((), st)))
  | Nat.succ lemFuel =>
    (match stmt.node with
     | AilSskip => return0 ()
     | AilSexpr _ => return0 ()
     | AilSblock binds ss =>
       bind1 get0 (fun (st : collect_visibles_state) =>
         let saved_syms := st.visible_syms;
         bind1
           (bind1
             (update (fun (st : collect_visibles_state) =>
               { st with
                 visible_syms := List.map
                   (fun (p :
                     (sym ×
                       ((CerbLocation.Loc × storageDuration × Bool) × Option alignment ×
                         qualifiers × ctype))) =>
                     match p with
                     | (sym1, (_, _, _, ty1)) => (sym1, ty1)) binds ++ st.visible_syms }))
             (fun (_ : Unit) => mapM_ (collect_visibles__lemFuel lemFuel) ss))
           (fun (_ : Unit) =>
             update (fun (st : collect_visibles_state) => { st with visible_syms := saved_syms })))
     | AilSif _ s1 s2 =>
       bind1 ((collect_visibles__lemFuel lemFuel) s1) (fun (_ : Unit) =>
         (collect_visibles__lemFuel lemFuel) s2)
     | AilSwhile _ s _ => (collect_visibles__lemFuel lemFuel) s
     | AilSdo s _ _ => (collect_visibles__lemFuel lemFuel) s
     | AilSbreak => return0 ()
     | AilScontinue => return0 ()
     | AilSreturnVoid => return0 ()
     | AilSreturn _ => return0 ()
     | AilSswitch _ s => (collect_visibles__lemFuel lemFuel) s
     | AilScase _ s => (collect_visibles__lemFuel lemFuel) s
     | AilScase_rangeGNU _ _ s => (collect_visibles__lemFuel lemFuel) s
     | AilSdefault s => (collect_visibles__lemFuel lemFuel) s
     | AilSlabel label s _ =>
       bind1
         (update (fun (st : collect_visibles_state) =>
           { st with
             label_visibles_ :=
               (fmapAddBy (fun (sym1 : sym) (sym2 : sym)=> ordCompare sym1 sym2) label
                 st.visible_syms st.label_visibles_) }))
         (fun (_ : Unit) => (collect_visibles__lemFuel lemFuel) s)
     | AilSgoto label => return0 ()
     | AilSdeclaration _ => return0 ()
     | AilSpar ss => mapM_ (collect_visibles__lemFuel lemFuel) ss
     | AilSreg_store _ _ => return0 ()
     | AilSmarker _ s => (collect_visibles__lemFuel lemFuel) s)

def collect_visibles_ (stmt : statement genTypeCategory) : stateM Unit collect_visibles_state :=
  collect_visibles__lemFuel (statement.lemSize stmt) stmt
theorem collect_visibles__lemFuel_zero (stmt : statement genTypeCategory) :
    collect_visibles__lemFuel 0 stmt = (fuelExhausted (fun st => ((), st))) :=
  rfl

def collect_visibles (stmt : statement genTypeCategory) : collect_visibles_state :=
  Prod.snd
    (runStateM (collect_visibles_ stmt)
      (({ visible_syms := ([] : List (sym × ctype)), label_visibles_ := fmapEmpty } :
        collect_visibles_state)))
def mk_run_with_lifetime_e (loc1 : CerbLocation.Loc) (sym1 : sym)
    (visibles_before : List (sym × ctype)) (visibles_after : List (sym × ctype))
    (pes : List (generic_pexpr Unit sym)) :
    generic_expr Unit Unit sym :=
  let killed_syms_tys :=
    List.filter
      (fun (p : (sym × ctype)) =>
        match p with
        | (sym1, _ty) =>
          Lem_Maybe.isNothing
            ((lookupBy
              (fun (sym1 : sym) (sym2 : sym)=>
                match sym1, sym2 with
                | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                  (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                    lem_if natGteb 0 5 && (sd1 != sd2) then
                      (lemSeq
                        (fun _ =>
                          CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                            match u with
                            | () =>
                              String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                (String.append (show_symbol_description sd1)
                                  (String.append " <-> " (show_symbol_description sd2)))))
                        (fun _ => true))
                    else
                      true
                  else
                    false)) sym1 visibles_after))) visibles_before;
  let mk_kills_e :=
    mk_unit_sseq
      (List.map
        (fun (p : (sym × ctype)) =>
          match p with
          | (sym1, ty1) => pkill loc1 (Static0 ty1) (mk_sym_pe sym1)) killed_syms_tys);
  let created_sym_tys :=
    List.filter
      (fun (p : (sym × ctype)) =>
        match p with
        | (sym1, _) =>
          not
            (List.any visibles_before (fun (p : (sym × ctype)) =>
              match p with
              | (sym', _) =>
                (match sym1, sym' with
                 | Symbol d1 n1 sd1, Symbol d2 n2 sd2 =>
                   (lem_if (CerberusFresh.digest_compare d1 d2 == (0 : Int)) && (n1 == n2) then
                     lem_if natGteb 0 5 && (sd1 != sd2) then
                       (lemSeq
                         (fun _ =>
                           CerbDebug.print_debug_pure 5 ([] : List domain) (fun (u : Unit) =>
                             match u with
                             | () =>
                               String.append "[Symbol.symbolEqual] suspicious equality ==> "
                                 (String.append (show_symbol_description sd1)
                                   (String.append " <-> " (show_symbol_description sd2)))))
                         (fun _ => true))
                     else
                       true
                   else
                     false))))) visibles_after;
  let mk_creates_e :=
    mk_sseqs
      (List.map
        (fun (p : (sym × ctype)) =>
          match p with
          | (sym1, ty1) =>
            (Pattern ([] : List annot) (CaseBase (some sym1, BTy_object OTy_pointer)),
              (let core_ty := mk_ail_ctype_pe ty1;
               pcreate loc1 (mk_alignof_pe core_ty) core_ty (PrefSource loc1 [/- f; -/ sym1]))))
        created_sym_tys);
  mk_kills_e
    (mk_creates_e
      (mk_run_e sym1
        ((List.map
          (fun (p : (sym × ctype)) =>
            match p with
            | (sym1, _) => mk_sym_pe sym1) visibles_after) ++ pes)))

