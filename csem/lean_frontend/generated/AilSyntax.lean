/- lem: equality and comparison for these types, matching OCaml's
   polymorphic (=) and compare: structural equality; nullary constructors
   before non-nullary ones, declaration order within each group; fields
   compared left to right; leaf fields by their Lean BEq/Ord instances. -/
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def expression_.ctor_rank_ocaml { a : Type } : expression_ a → Nat
  | .AilEunary _ _ => 0
  | .AilEbinary _ _ _ => 1
  | .AilEassign _ _ => 2
  | .AilEcompoundAssign _ _ _ => 3
  | .AilEcond _ _ _ => 4
  | .AilEcast _ _ _ => 5
  | .AilEcall _ _ => 6
  | .AilEassert _ => 7
  | .AilEoffsetof _ _ => 8
  | .AilEgeneric _ _ _ => 9
  | .AilEarray _ _ _ => 10
  | .AilEstruct _ _ => 11
  | .AilEunion _ _ _ => 12
  | .AilEcompound _ _ _ => 13
  | .AilEmemberof _ _ => 14
  | .AilEmemberofptr _ _ => 15
  | .AilEbuiltin _ => 16
  | .AilEstr _ => 17
  | .AilEconst _ => 18
  | .AilEident _ => 19
  | .AilEsizeof _ _ => 20
  | .AilEsizeof_expr _ => 21
  | .AilEalignof _ _ => 22
  | .AilEannot _ _ => 23
  | .AilEva_start _ _ => 24
  | .AilEva_arg _ _ => 25
  | .AilEva_copy _ _ => 26
  | .AilEva_end _ => 27
  | .AilEprint_type _ => 28
  | .AilEbmc_assume _ => 29
  | .AilEreg_load _ => 30
  | .AilErvalue _ => 31
  | .AilEarray_decay _ => 32
  | .AilEfunction_decay _ => 33
  | .AilEatomic _ => 34
  | .AilEgcc_statement _ _ => 35
  | .AilEinvalid _ _ => 36
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def generic_association.ctor_rank_ocaml { a : Type } : generic_association a → Nat
  | .AilGAtype _ _ _ => 0
  | .AilGAdefault _ => 1
/- lem: constructor rank for OCaml's polymorphic compare: nullary
   constructors (immediates) sort below non-nullary ones (blocks);
   declaration order within each group. -/
def statement_.ctor_rank_ocaml { a : Type } : statement_ a → Nat
  | .AilSskip => 0
  | .AilSexpr _ => 4
  | .AilSblock _ _ => 5
  | .AilSif _ _ _ => 6
  | .AilSwhile _ _ _ => 7
  | .AilSdo _ _ _ => 8
  | .AilSbreak => 1
  | .AilScontinue => 2
  | .AilSreturnVoid => 3
  | .AilSreturn _ => 9
  | .AilSswitch _ _ => 10
  | .AilScase _ _ => 11
  | .AilScase_rangeGNU _ _ _ => 12
  | .AilSdefault _ => 13
  | .AilSlabel _ _ _ => 14
  | .AilSgoto _ => 15
  | .AilSdeclaration _ => 16
  | .AilSpar _ => 17
  | .AilSreg_store _ _ => 18
  | .AilSmarker _ _ => 19
mutual
def expression_.beq_derived { a : Type } [BEq a] (cmpx_ cmpy_ : expression_ a) : Bool :=
  match cmpx_, cmpy_ with
  | .AilEunary x1 x2, .AilEunary y1 y2 => x1 == y1 && expression.beq_derived x2 y2
  | .AilEbinary x1 x2 x3, .AilEbinary y1 y2 y3 =>
    expression.beq_derived x1 y1 && x2 == y2 && expression.beq_derived x3 y3
  | .AilEassign x1 x2, .AilEassign y1 y2 =>
    expression.beq_derived x1 y1 && expression.beq_derived x2 y2
  | .AilEcompoundAssign x1 x2 x3, .AilEcompoundAssign y1 y2 y3 =>
    expression.beq_derived x1 y1 && x2 == y2 && expression.beq_derived x3 y3
  | .AilEcond x1 x2 x3, .AilEcond y1 y2 y3 =>
    expression.beq_derived x1 y1 && expression_.beq_deriv_aux7 x2 y2 && expression.beq_derived x3 y3
  | .AilEcast x1 x2 x3, .AilEcast y1 y2 y3 => x1 == y1 && x2 == y2 && expression.beq_derived x3 y3
  | .AilEcall x1 x2, .AilEcall y1 y2 =>
    expression.beq_derived x1 y1 && expression_.beq_deriv_aux8 x2 y2
  | .AilEassert x1, .AilEassert y1 => expression.beq_derived x1 y1
  | .AilEoffsetof x1 x2, .AilEoffsetof y1 y2 => x1 == y1 && x2 == y2
  | .AilEgeneric x1 x2 x3, .AilEgeneric y1 y2 y3 =>
    expression.beq_derived x1 y1 && x2 == y2 && expression_.beq_deriv_aux9 x3 y3
  | .AilEarray x1 x2 x3, .AilEarray y1 y2 y3 =>
    x1 == y1 && x2 == y2 && expression_.beq_deriv_aux10 x3 y3
  | .AilEstruct x1 x2, .AilEstruct y1 y2 => x1 == y1 && expression_.beq_deriv_aux11 x2 y2
  | .AilEunion x1 x2 x3, .AilEunion y1 y2 y3 =>
    x1 == y1 && x2 == y2 && expression_.beq_deriv_aux7 x3 y3
  | .AilEcompound x1 x2 x3, .AilEcompound y1 y2 y3 =>
    x1 == y1 && x2 == y2 && expression.beq_derived x3 y3
  | .AilEmemberof x1 x2, .AilEmemberof y1 y2 => expression.beq_derived x1 y1 && x2 == y2
  | .AilEmemberofptr x1 x2, .AilEmemberofptr y1 y2 => expression.beq_derived x1 y1 && x2 == y2
  | .AilEbuiltin x1, .AilEbuiltin y1 => x1 == y1
  | .AilEstr x1, .AilEstr y1 => x1 == y1
  | .AilEconst x1, .AilEconst y1 => x1 == y1
  | .AilEident x1, .AilEident y1 => x1 == y1
  | .AilEsizeof x1 x2, .AilEsizeof y1 y2 => x1 == y1 && x2 == y2
  | .AilEsizeof_expr x1, .AilEsizeof_expr y1 => expression.beq_derived x1 y1
  | .AilEalignof x1 x2, .AilEalignof y1 y2 => x1 == y1 && x2 == y2
  | .AilEannot x1 x2, .AilEannot y1 y2 => x1 == y1 && expression.beq_derived x2 y2
  | .AilEva_start x1 x2, .AilEva_start y1 y2 => expression.beq_derived x1 y1 && x2 == y2
  | .AilEva_arg x1 x2, .AilEva_arg y1 y2 => expression.beq_derived x1 y1 && x2 == y2
  | .AilEva_copy x1 x2, .AilEva_copy y1 y2 =>
    expression.beq_derived x1 y1 && expression.beq_derived x2 y2
  | .AilEva_end x1, .AilEva_end y1 => expression.beq_derived x1 y1
  | .AilEprint_type x1, .AilEprint_type y1 => expression.beq_derived x1 y1
  | .AilEbmc_assume x1, .AilEbmc_assume y1 => expression.beq_derived x1 y1
  | .AilEreg_load x1, .AilEreg_load y1 => x1 == y1
  | .AilErvalue x1, .AilErvalue y1 => expression.beq_derived x1 y1
  | .AilEarray_decay x1, .AilEarray_decay y1 => expression.beq_derived x1 y1
  | .AilEfunction_decay x1, .AilEfunction_decay y1 => expression.beq_derived x1 y1
  | .AilEatomic x1, .AilEatomic y1 => expression.beq_derived x1 y1
  | .AilEgcc_statement x1 x2, .AilEgcc_statement y1 y2 =>
    x1 == y1 && expression_.beq_deriv_aux12 x2 y2
  | .AilEinvalid x1 x2, .AilEinvalid y1 y2 => x1 == y1 && x2 == y2
  | _, _ => false
termination_by structural cmpx_
def expression_.compare_derived { a : Type } [Ord a] (cmpx_ cmpy_ : expression_ a) : Ordering :=
  match cmpx_, cmpy_ with
  | .AilEunary x1 x2, .AilEunary y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => expression.compare_derived x2 y2)
  | .AilEbinary x1 x2 x3, .AilEbinary y1 y2 y3 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression.compare_derived x3 y3))
  | .AilEassign x1 x2, .AilEassign y1 y2 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => expression.compare_derived x2 y2)
  | .AilEcompoundAssign x1 x2 x3, .AilEcompoundAssign y1 y2 y3 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression.compare_derived x3 y3))
  | .AilEcond x1 x2 x3, .AilEcond y1 y2 y3 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match expression_.cmp_deriv_aux1 x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression.compare_derived x3 y3))
  | .AilEcast x1 x2 x3, .AilEcast y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression.compare_derived x3 y3))
  | .AilEcall x1 x2, .AilEcall y1 y2 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => expression_.cmp_deriv_aux2 x2 y2)
  | .AilEassert x1, .AilEassert y1 => expression.compare_derived x1 y1
  | .AilEoffsetof x1 x2, .AilEoffsetof y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .AilEgeneric x1 x2 x3, .AilEgeneric y1 y2 y3 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression_.cmp_deriv_aux3 x3 y3))
  | .AilEarray x1 x2 x3, .AilEarray y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression_.cmp_deriv_aux4 x3 y3))
  | .AilEstruct x1 x2, .AilEstruct y1 y2 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => expression_.cmp_deriv_aux5 x2 y2)
  | .AilEunion x1 x2 x3, .AilEunion y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression_.cmp_deriv_aux1 x3 y3))
  | .AilEcompound x1 x2 x3, .AilEcompound y1 y2 y3 =>
    (match Ord.compare x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq =>
       (match Ord.compare x2 y2 with
        | .lt => Ordering.lt
        | .gt => Ordering.gt
        | .eq => expression.compare_derived x3 y3))
  | .AilEmemberof x1 x2, .AilEmemberof y1 y2 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .AilEmemberofptr x1 x2, .AilEmemberofptr y1 y2 =>
    (match expression.compare_derived x1 y1 with
     | .lt => Ordering.lt
     | .gt => Ordering.gt
     | .eq => Ord.compare x2 y2)
  | .AilEbuiltin x1, .AilEbuiltin y1 => Ord.compare x1 y1
  | .AilEstr x1, .AilEstr y1 => Ord.compare x1 y1
