    match statement_.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match statement_.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match statement_.compare_derived x y with
    | .lt => false
    | _ => true
instance { a : Type } [BEq a] : BEq (statement a) where
  beq := statement.beq_derived
instance { a : Type } [Ord a] : Ord (statement a) where
  compare := statement.compare_derived
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (statement a) where
  setElemCompare x y :=
    match statement.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
instance (priority := 500) { a : Type } [BEq a] : Lem_Basic_classes.Eq0 (statement a) where
  isEqual := statement.beq_derived
  isInequal x y := !(statement.beq_derived x y)
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.Ord0 (statement a) where
  compare x y :=
    match statement.compare_derived x y with
    | .lt => LemOrdering.LT
    | .eq => LemOrdering.EQ
    | .gt => LemOrdering.GT
  isLess x y :=
    match statement.compare_derived x y with
    | .lt => true
    | _ => false
  isLessEqual x y :=
    match statement.compare_derived x y with
    | .gt => false
    | _ => true
  isGreater x y :=
    match statement.compare_derived x y with
    | .gt => true
    | _ => false
  isGreaterEqual x y :=
    match statement.compare_derived x y with
    | .lt => false
    | _ => true
/- lem: computable structural size `lemSize x`, for fuel measures: one
   per constructor node of these types and per non-nullary container
   constructor (`::`/`some`/`inl`/`inr`); tuples are transparent; every
   other field counts 0. -/
mutual
def expression_.lemSize { a : Type } (sizex_ : expression_ a) : Nat :=
  match sizex_ with
  | .AilEunary _ x1 => 1 + expression.lemSize x1
  | .AilEbinary x1 _ x2 => 1 + expression.lemSize x1 + expression.lemSize x2
  | .AilEassign x1 x2 => 1 + expression.lemSize x1 + expression.lemSize x2
  | .AilEcompoundAssign x1 _ x2 => 1 + expression.lemSize x1 + expression.lemSize x2
  | .AilEcond x1 x2 x3 =>
    1 + expression.lemSize x1 + expression_.lemSize_aux1 x2 + expression.lemSize x3
  | .AilEcast _ _ x1 => 1 + expression.lemSize x1
  | .AilEcall x1 x2 => 1 + expression.lemSize x1 + expression_.lemSize_aux2 x2
  | .AilEassert x1 => 1 + expression.lemSize x1
  | .AilEoffsetof _ _ => 1
  | .AilEgeneric x1 _ x2 => 1 + expression.lemSize x1 + expression_.lemSize_aux3 x2
  | .AilEarray _ _ x1 => 1 + expression_.lemSize_aux4 x1
  | .AilEstruct _ x1 => 1 + expression_.lemSize_aux5 x1
  | .AilEunion _ _ x1 => 1 + expression_.lemSize_aux1 x1
  | .AilEcompound _ _ x1 => 1 + expression.lemSize x1
  | .AilEmemberof x1 _ => 1 + expression.lemSize x1
  | .AilEmemberofptr x1 _ => 1 + expression.lemSize x1
  | .AilEbuiltin _ => 1
  | .AilEstr _ => 1
  | .AilEconst _ => 1
  | .AilEident _ => 1
  | .AilEsizeof _ _ => 1
  | .AilEsizeof_expr x1 => 1 + expression.lemSize x1
  | .AilEalignof _ _ => 1
  | .AilEannot _ x1 => 1 + expression.lemSize x1
  | .AilEva_start x1 _ => 1 + expression.lemSize x1
  | .AilEva_arg x1 _ => 1 + expression.lemSize x1
  | .AilEva_copy x1 x2 => 1 + expression.lemSize x1 + expression.lemSize x2
  | .AilEva_end x1 => 1 + expression.lemSize x1
  | .AilEprint_type x1 => 1 + expression.lemSize x1
  | .AilEbmc_assume x1 => 1 + expression.lemSize x1
  | .AilEreg_load _ => 1
  | .AilErvalue x1 => 1 + expression.lemSize x1
  | .AilEarray_decay x1 => 1 + expression.lemSize x1
  | .AilEfunction_decay x1 => 1 + expression.lemSize x1
  | .AilEatomic x1 => 1 + expression.lemSize x1
  | .AilEgcc_statement _ x1 => 1 + expression_.lemSize_aux6 x1
  | .AilEinvalid _ _ => 1
termination_by structural sizex_
def generic_association.lemSize { a : Type } (sizex_ : generic_association a) : Nat :=
  match sizex_ with
  | .AilGAtype _ _ x1 => 1 + expression.lemSize x1
  | .AilGAdefault x1 => 1 + expression.lemSize x1
termination_by structural sizex_
def expression.lemSize { a : Type } (sizex_ : expression a) : Nat :=
  match sizex_ with
  | .AnnotatedExpression _ _ _ x1 => 1 + expression_.lemSize x1
termination_by structural sizex_
def statement_.lemSize { a : Type } (sizex_ : statement_ a) : Nat :=
  match sizex_ with
  | .AilSskip => 1
  | .AilSexpr x1 => 1 + expression.lemSize x1
  | .AilSblock _ x1 => 1 + expression_.lemSize_aux6 x1
  | .AilSif x1 x2 x3 => 1 + expression.lemSize x1 + statement.lemSize x2 + statement.lemSize x3
  | .AilSwhile x1 x2 _ => 1 + expression.lemSize x1 + statement.lemSize x2
  | .AilSdo x1 x2 _ => 1 + statement.lemSize x1 + expression.lemSize x2
  | .AilSbreak => 1
  | .AilScontinue => 1
  | .AilSreturnVoid => 1
  | .AilSreturn x1 => 1 + expression.lemSize x1
  | .AilSswitch x1 x2 => 1 + expression.lemSize x1 + statement.lemSize x2
  | .AilScase _ x1 => 1 + statement.lemSize x1
  | .AilScase_rangeGNU _ _ x1 => 1 + statement.lemSize x1
  | .AilSdefault x1 => 1 + statement.lemSize x1
  | .AilSlabel _ x1 _ => 1 + statement.lemSize x1
  | .AilSgoto _ => 1
  | .AilSdeclaration x1 => 1 + expression_.lemSize_aux7 x1
  | .AilSpar x1 => 1 + expression_.lemSize_aux6 x1
  | .AilSreg_store _ x1 => 1 + expression.lemSize x1
  | .AilSmarker _ x1 => 1 + statement.lemSize x1
termination_by structural sizex_
def statement.lemSize { a : Type } (sizex_ : statement a) : Nat :=
  match sizex_ with
  | .mk _ _ _ x1 => 1 + statement_.lemSize x1
termination_by structural sizex_
def expression_.lemSize_aux1 { a : Type } (sizex_ : Option (expression a)) : Nat :=
  match sizex_ with
  | none => 0
  | some x1 => 1 + expression.lemSize x1
termination_by structural sizex_
def expression_.lemSize_aux2 { a : Type } (sizex_ : List (expression a)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + expression.lemSize x1 + expression_.lemSize_aux2 xs0
termination_by structural sizex_
def expression_.lemSize_aux3 { a : Type } (sizex_ : List (generic_association a)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + generic_association.lemSize x1 + expression_.lemSize_aux3 xs0
termination_by structural sizex_
def expression_.lemSize_aux4 { a : Type } (sizex_ : List (Option (expression a))) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + expression_.lemSize_aux1 x1 + expression_.lemSize_aux4 xs0
termination_by structural sizex_
def expression_.lemSize_aux5 { a : Type } (sizex_ : List ((identifier × Option (expression a)))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + expression_.lemSize_aux1 x1 + expression_.lemSize_aux5 xs0
termination_by structural sizex_
def expression_.lemSize_aux6 { a : Type } (sizex_ : List (statement a)) : Nat :=
  match sizex_ with
  | [] => 0
  | x1 :: xs0 => 1 + statement.lemSize x1 + expression_.lemSize_aux6 xs0
termination_by structural sizex_
def expression_.lemSize_aux7 { a : Type }
    (sizex_ : List ((ail_identifier × Option (expression a)))) :
    Nat :=
  match sizex_ with
  | [] => 0
  | (_, x1) :: xs0 => 1 + expression_.lemSize_aux1 x1 + expression_.lemSize_aux7 xs0
termination_by structural sizex_
end

def mk_statement { a : Type } (loc1 : CerbLocation.Loc) (node1 : statement_ a) : statement a :=
  let desug_info2 := (({ is_forloop_body := false, desug_case0 := none } : desug_info));
  (({ loc := loc1, desug_info0 := desug_info2, attrs := no_attributes, node := node1 } : statement
    a))

def mk_statement_full { a : Type } (loc1 : CerbLocation.Loc) (desug_info2 : desug_info)
    (attrs1 : attributes) (node1 : statement_ a) :
    statement a :=
  (({ loc := loc1, desug_info0 := desug_info2, attrs := attrs1, node := node1 } : statement a))

instance (a : Type) : Located (expression a) where

    locOf a_expr :=
      match a_expr with
      | (AnnotatedExpression _ _ loc1 _) => loc1

instance (a : Type) : Located (statement a) where

    locOf stmt := stmt.loc

inductive declaration : Type where
  | Decl_object : (storageDuration × Bool) → Option alignment → qualifiers → ctype → declaration
  | Decl_function : Bool /- has_prototype -/
                    → (qualifiers × ctype) /- return qualifiers -/
                    → (List ((qualifiers × ctype × /- isRegister -/ Bool)))
                    → Bool /- is_variadic -/
                    → Bool /- is_inline -/
                    → Bool → declaration
  deriving BEq, Ord
export declaration (Decl_object Decl_function)
instance : Inhabited declaration where
  default := Decl_object (default, default) default default default
instance (priority := 500) : Lem_Basic_classes.SetType declaration where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 declaration where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 declaration where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq /- is_Noreturn -/

/- external identifier kind -/
inductive id_kind : Type where
  | IK_declaration : id_kind
  | IK_tentative : id_kind
  | IK_definition : id_kind
  deriving BEq, Ord
export id_kind (IK_declaration IK_tentative IK_definition)
instance : Inhabited id_kind where
  default := IK_declaration
instance (priority := 500) : Lem_Basic_classes.SetType id_kind where
  setElemCompare := defaultCompare
instance (priority := 500) : Lem_Basic_classes.Eq0 id_kind where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) : Lem_Basic_classes.Ord0 id_kind where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

abbrev sigma_declaration := (ail_identifier × (CerbLocation.Loc × attributes × declaration))

abbrev sigma_object_definition (a : Type) := (ail_identifier × (expression a))

abbrev sigma_function_definition (a : Type) :=
  (ail_identifier × (CerbLocation.Loc × Nat × attributes × List ail_identifier × statement a))

abbrev sigma_static_assertion (a : Type) := (expression a × stringLiteral)

abbrev sigma_tag_definition := (ail_identifier × (CerbLocation.Loc × attributes × tag_definition))

abbrev sigma_extern_id := (ail_identifier × id_kind)

abbrev sigma_cn_function := cn_function sym ctype

abbrev sigma_cn_lemmata := cn_lemma sym ctype

abbrev sigma_cn_predicate := cn_predicate sym ctype

abbrev sigma_cn_datatype := cn_datatype sym

abbrev sigma_cn_decl_spec := (Nat × sym × cn_decl_spec identifier type_name)

abbrev sigma_cn_ident := (cn_namespace × identifier)

structure sigma (a : Type) where
  declarations : List sigma_declaration
  object_definitions : List (sigma_object_definition a)
  /- the list of identifiers are the parameter names used in the body -/
  function_definitions : List (sigma_function_definition a)
  static_assertions : List (sigma_static_assertion a)
  tag_definitions : List sigma_tag_definition
  /- program-data parameters E-A (2026-09-20): the compatible integer type
     the desugarer decided for each enum tag (GCC's rule,
     Implementation.enum_compatible_type) — PROGRAM DATA beside the tag
     definitions; on OCaml the same decision also lives in the
     DefaultImpl registry, which the oracle keeps reading. -/
  enum_definitions : List (sym × integerType)
  extern_idmap : Fmap identifier sigma_extern_id
  typedef_attributes : Fmap ail_identifier attributes
  loop_attributes0 : loop_attributes
  cn_functions : List sigma_cn_function
  cn_lemmata : List sigma_cn_lemmata
  cn_predicates : List sigma_cn_predicate
  cn_datatypes : List sigma_cn_datatype
  cn_decl_specs : List sigma_cn_decl_spec
  cn_idents : Fmap sigma_cn_ident sym
  deriving BEq, Ord
instance { a : Type } : Inhabited (sigma a) where
  default :=
    sigma.mk default default default default default default default default default default default
      default default default default
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.SetType (sigma a) where
  setElemCompare := defaultCompare
instance (priority := 500) { a : Type } [BEq a] : Lem_Basic_classes.Eq0 (sigma a) where
  isEqual x y := x == y
  isInequal x y := !(x == y)
instance (priority := 500) { a : Type } [Ord a] : Lem_Basic_classes.Ord0 (sigma a) where
  compare := defaultCompare
  isLess := defaultLess
  isLessEqual := defaultLessEq
  isGreater := defaultGreater
  isGreaterEqual := defaultGreaterEq

@[never_extract] def empty_sigma { a : Type } : sigma a :=
  (({ declarations := ([] : List (ail_identifier × (CerbLocation.Loc × attributes × declaration))),
      object_definitions := [],
      function_definitions := [],
      static_assertions := [],
      tag_definitions :=
        ([] : List (ail_identifier × (CerbLocation.Loc × attributes × tag_definition))),
      enum_definitions := ([] : List (sym × integerType)),
      extern_idmap := fmapEmpty,
      typedef_attributes := fmapEmpty,
      loop_attributes0 := fmapEmpty,
      cn_functions := ([] : List (cn_function sym ctype)),
      cn_lemmata := ([] : List (cn_lemma sym ctype)),
      cn_predicates := ([] : List (cn_predicate sym ctype)),
      cn_datatypes := ([] : List (cn_datatype sym)),
      cn_decl_specs := ([] : List (Nat × sym × cn_decl_spec identifier type_name)),
      cn_idents := fmapEmpty } : sigma a))

abbrev gamma :=
  List
    (ail_identifier ×
      ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype))

abbrev ail_program (a : Type) := (Option ail_identifier × sigma a)
