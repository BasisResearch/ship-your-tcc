mutual
inductive expression_ (a : Type) : Type where
  | AilEunary : unaryOperator → expression a → expression_ a
  | AilEbinary : expression a → binaryOperator → expression a → expression_ a
  | AilEassign : expression a → expression a → expression_ a
  | AilEcompoundAssign : expression a → arithmeticOperator → expression a → expression_ a
  | AilEcond : expression a → Option (expression a) → expression a → expression_ a
  | AilEcast : qualifiers → ctype → expression a → expression_ a
  | AilEcall : expression a → List (expression a) → expression_ a
  | AilEassert : expression a → expression_ a
  | AilEoffsetof : ctype → identifier → expression_ a
  /- the maybe nat is the index of the selected association, this is added by
     the Ail typing -/
  | AilEgeneric : expression a → Option Nat → List (generic_association a) → expression_ a
  /- NOTE: these don't exist in C (apart from in decl)
   * the boolean says whether this array was created from a string literal
   * used to initialise a pointer to an array of character -/
  | AilEarray : Bool → ctype → List (Option (expression a)) → expression_ a
  | AilEstruct :
      ail_identifier → List (identifier × Option (expression a)) → expression_
          a /- tag, pairs of member id, expression -/
  | AilEunion : ail_identifier → identifier → Option (expression a) → expression_ a
  /- NOTE: the expression obviously need to match the type, and will typically
   * be a AilEarray or AilEstruct -/
  | AilEcompound : qualifiers → ctype → expression a → expression_ a
  | AilEmemberof : expression a → identifier → expression_ a
  | AilEmemberofptr : expression a → identifier → expression_ a
  | AilEbuiltin : ail_builtin → expression_ a
  | AilEstr : stringLiteral → expression_ a
  | AilEconst : constant → expression_ a
  | AilEident : ail_identifier → expression_ a
  | AilEsizeof : qualifiers → ctype → expression_ a
  | AilEsizeof_expr : expression a → expression_ a
  | AilEalignof : qualifiers → ctype → expression_ a
  /- NOTE: type annotation on expression, used to remember the type of desugared
   * enumeration constants -/
  | AilEannot : ctype → (expression a) → expression_ a
  | AilEva_start : expression a → ail_identifier → expression_ a
  | AilEva_arg : expression a → ctype → expression_ a
  | AilEva_copy : expression a → expression a → expression_ a
  | AilEva_end : expression a → expression_ a
  | AilEprint_type : expression a → expression_ a
  | AilEbmc_assume : expression a → expression_ a
  | AilEreg_load : reg → expression_ a
  /- §6.3.2.1#2, the result of a non-array lvalue conversion -/
  | AilErvalue : expression a → expression_ a /- NOTE: never generated by the desugaring -/
  /- §6.3.2.1#3 -/
  | AilEarray_decay : expression a → expression_ a /- NOTE: never generated by the desugaring -/
  /- §6.3.2.1#4 -/
  | AilEfunction_decay : expression a → expression_ a /- NOTE: never generated by the desugaring -/
  | AilEatomic : expression a → expression_ a /- NOTE: never generated by the desugaring -/
  | AilEgcc_statement :
      bindings → List (statement a) → expression_
          a /- TODO: during Cabs to Ail we currently drop the content of the statement -/
  /- This variant is used when the deguaring or typing failed to produce a
     valid sub-tree. This is meant to be used both when the C source was valid,
     or when cerberus failed (e.g. because of a bug or unsupported input). -/
  | AilEinvalid : ctype → ail_invalid_reason → expression_ a
inductive generic_association (a : Type) : Type where
  | AilGAtype : qualifiers → ctype → expression a → generic_association a
  | AilGAdefault : expression a → generic_association a
inductive expression (a : Type) : Type where
  | AnnotatedExpression : a → List annot → CerbLocation.Loc → expression_ a → expression a
inductive statement_ (a : Type) : Type where
  | AilSskip : statement_ a
  | AilSexpr : expression a → statement_ a
  | AilSblock : bindings → List (statement a) → statement_ a
  | AilSif : expression a → statement a → statement a → statement_ a
  | AilSwhile : expression a → statement a → loop_id → statement_ a
  | AilSdo : statement a → expression a → loop_id → statement_ a
  | AilSbreak : statement_ a
  | AilScontinue : statement_ a
  | AilSreturnVoid : statement_ a
  | AilSreturn : expression a → statement_ a
  | AilSswitch : expression a → statement a → statement_ a
  | AilScase : Int → statement a → statement_ a
  | AilScase_rangeGNU : Int → Int → statement a → statement_ a /- GNU C extension -/
  | AilSdefault : statement a → statement_ a
  | AilSlabel : ail_identifier → statement a → Option label_annot → statement_ a
  | AilSgoto : ail_identifier → statement_ a
  | AilSdeclaration : List (ail_identifier × Option (expression a)) → statement_ a
  | AilSpar : List (statement a) → statement_ a /- NON-STD cppmem threads -/
  | AilSreg_store : reg → expression a → statement_ a
  /- for CN -/
  | AilSmarker : Nat → statement a → statement_ a
/- NOTE: this is placeholder we used to carry annotations for CN -/
structure statement (a : Type) where
  loc : CerbLocation.Loc
  desug_info0 : desug_info
  attrs : attributes
  node : statement_ a
end
export expression_ (AilEunary AilEbinary AilEassign AilEcompoundAssign AilEcond AilEcast AilEcall
    AilEassert AilEoffsetof AilEgeneric AilEarray AilEstruct AilEunion AilEcompound AilEmemberof
    AilEmemberofptr AilEbuiltin AilEstr AilEconst AilEident AilEsizeof AilEsizeof_expr AilEalignof
    AilEannot AilEva_start AilEva_arg AilEva_copy AilEva_end AilEprint_type AilEbmc_assume
    AilEreg_load AilErvalue AilEarray_decay AilEfunction_decay AilEatomic AilEgcc_statement
    AilEinvalid)
export generic_association (AilGAtype AilGAdefault)
export expression (AnnotatedExpression)
export statement_ (AilSskip AilSexpr AilSblock AilSif AilSwhile AilSdo AilSbreak AilScontinue
    AilSreturnVoid AilSreturn AilSswitch AilScase AilScase_rangeGNU AilSdefault AilSlabel AilSgoto
    AilSdeclaration AilSpar AilSreg_store AilSmarker)
open statement
