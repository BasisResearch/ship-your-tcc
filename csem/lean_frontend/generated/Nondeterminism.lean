/- Monadic operations -/

def nd_return { a b c d e : Type } (a1 : a) : ndM a e d c b :=
  ND (fun (st : b) => (NDactive a1, st))

def nd_bind_lemFuel { a b c d e f : Type } (lemFuel : Nat) (n : ndM f b d a c)
    (f1 : f → ndM e b d a c) :
    ndM e b d a c :=
  match lemFuel with
  | 0 =>
    (ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st)))
  | Nat.succ lemFuel =>
    (match n, f1 with
     | (ND m_act), f1 =>
       ND (fun (st : c) =>
         match m_act st with
         | (NDactive z, st') =>
           (match f1 z with
            | ND m_act' => m_act' st')
         | (NDkilled r, st') => (NDkilled r, st')
         | (NDnd debug_str str_ms, st') =>
           (NDnd debug_str
             (List.map
               (fun (p : (b × ndM f b d a c)) =>
                 match p with
                 | (str, m) => (str, (nd_bind_lemFuel lemFuel) m f1)) str_ms), st')
         | (NDguard debug_str cs m_act', st') =>
           (NDguard debug_str cs ((nd_bind_lemFuel lemFuel) m_act' f1), st')
         | (NDbranch debug_str cs m_act1 m_act2, st') =>
           (NDbranch debug_str cs ((nd_bind_lemFuel lemFuel) m_act1 f1)
             ((nd_bind_lemFuel lemFuel) m_act2 f1), st')
         | (NDstep info str_ms, st') =>
           (NDstep info
             (List.map
               (fun (p : (b × ndM f b d a c)) =>
                 match p with
                 | (str, m) => (str, (nd_bind_lemFuel lemFuel) m f1)) str_ms), st')))

def nd_bind { a b c d e f : Type } [LemFuel] :
    ndM f b d a c → (f → ndM e b d a c) → ndM e b d a c :=
  nd_bind_lemFuel LemFuel.fuel
theorem nd_bind_lemFuel_zero { a b c d e f : Type } (n : ndM f b d a c) (f1 : f → ndM e b d a c) :
    nd_bind_lemFuel 0 n f1 =
        (ND (fun st =>
          (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

