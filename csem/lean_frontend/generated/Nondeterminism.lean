  | Nat.succ lemFuel =>
    (match get2, put1, liftInfo, liftErr, n with
     | get2, put1, liftInfo, liftErr, (ND m) =>
       ND (fun (st21 : st2) =>
         match m (get2 st21) with
         | (act, st1') =>
           ((liftAction_lemFuel lemFuel) get2 put1 liftInfo liftErr act, put1 st21 st1')))
def liftAction_lemFuel { a cs err1 err2 info1 info2 st1 st2 : Type } (lemFuel : Nat)
    (get2 : st2 → st1) (put1 : st2 → st1 → st2) (liftInfo : info1 → info2) (liftErr : err1 → err2) :
    nd_action a info1 err1 cs st1 → nd_action a info2 err2 cs st2 :=
  match lemFuel with
  | 0 => (fun _ => NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg))
  | Nat.succ lemFuel =>
    (match get2, put1, liftInfo, liftErr with
     | get2, put1, liftInfo, liftErr =>
       (fun (x : nd_action a info1 err1 cs st1) =>
         match x with
         | NDactive a1 => NDactive a1
         | NDkilled r =>
           NDkilled
             (match r with
              | Undef0 loc1 ubs => Undef0 loc1 ubs
              | Error0 loc1 str => Error0 loc1 str
              | Other err => Other (liftErr err))
         | NDnd info str_ms =>
           NDnd (liftInfo info)
             (List.map
               (fun (p : (info1 × ndM a info1 err1 cs st1)) =>
                 match p with
                 | (info, m_act) =>
                   (liftInfo info, (liftND_lemFuel lemFuel) get2 put1 liftInfo liftErr m_act))
               str_ms)
         | NDguard info cs1 act =>
           NDguard (liftInfo info) cs1 ((liftND_lemFuel lemFuel) get2 put1 liftInfo liftErr act)
         | NDbranch info cs1 m_act1 m_act2 =>
           NDbranch (liftInfo info) cs1 ((liftND_lemFuel lemFuel) get2 put1 liftInfo liftErr m_act1)
             ((liftND_lemFuel lemFuel) get2 put1 liftInfo liftErr m_act2)
         | NDstep info info_ms =>
           NDstep (liftInfo info)
             (List.map
               (fun (p : (info1 × ndM a info1 err1 cs st1)) =>
                 match p with
                 | (info, m) =>
                   (liftInfo info, (liftND_lemFuel lemFuel) get2 put1 liftInfo liftErr m))
               info_ms)))
end

def liftND { a cs err1 err2 info1 info2 st1 st2 : Type } [LemFuel] :
    (st2 → st1) → (st2 → st1 → st2) → (info1 → info2) → (err1 → err2) → ndM a info1 err1 cs st1 →
        ndM a info2 err2 cs st2 :=
  liftND_lemFuel LemFuel.fuel
theorem liftND_lemFuel_zero { a cs err1 err2 info1 info2 st1 st2 : Type } (get2 : st2 → st1)
    (put1 : st2 → st1 → st2) (liftInfo : info1 → info2) (liftErr : err1 → err2)
    (n : ndM a info1 err1 cs st1) :
    liftND_lemFuel 0 get2 put1 liftInfo liftErr n =
        (ND (fun st =>
          (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))) :=
  rfl

def liftAction { a cs err1 err2 info1 info2 st1 st2 : Type } [LemFuel] :
    (st2 → st1) → (st2 → st1 → st2) → (info1 → info2) → (err1 → err2) → nd_action a info1 err1 cs
        st1 → nd_action a info2 err2 cs st2 :=
  liftAction_lemFuel LemFuel.fuel
theorem liftAction_lemFuel_zero { a cs err1 err2 info1 info2 st1 st2 : Type } (get2 : st2 → st1)
    (put1 : st2 → st1 → st2) (liftInfo : info1 → info2) (liftErr : err1 → err2) :
    (liftAction_lemFuel 0 get2 put1 liftInfo liftErr : nd_action a info1 err1 cs st1 → nd_action a
      info2 err2 cs st2) =
        (fun _ => NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg)) :=
  rfl

def mk_step { a b c d e : Type } [Show a] (info : a) (xs : List (a × ndM e a d c b)) :
    ndM e a d c b :=
  (lemSeq
    (fun _ =>
      CerbDebug.print_debug_pure 2 ([] : List domain) (fun (u : Unit) =>
        match u with
        | () =>
          String.append "ND2.mk_step ["
            (String.append (show0 info)
              (String.append "] (|ms| = "
                (String.append (Lem_String_extra.stringFromNat (List.length xs)) ")")))))
    (fun _ => ND (fun (st : b) => (NDstep info xs, st))))

