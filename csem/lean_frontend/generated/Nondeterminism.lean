val msum: forall 'a 'err 'cs 'st. Constraints 'cs => string -> list (string * ndM 'a 'err 'cs 'st) -> ndM 'a 'err 'cs 'st 
let msum debug_str = function
  | [] ->
      error "ND2.msum []"
  | [(_, m)] ->
      m
  | str_ms ->
    let () = Debug.print_debug 2 [] (fun () ->
      "ND2.msum (|ms| = " ^ show (List.length str_ms) ^ ")"
    ) in
    ND (fun st ->
