import Tcc.Ccp.Sum.Seg.C0
import Tcc.Ccp.Sum.Seg.C1
import Tcc.Ccp.Sum.Seg.C2
import Tcc.Ccp.Sum.Seg.C3
import Tcc.Ccp.Lemmas

/-!
# The first 100,000 steps of the compile phase, on the evaluator

The four kernel-checked chunks `seg0 … seg3` (25,000 steps each, generated by
`scripts/gen_ccp.py --chain 25000:100000`) joined by `run_trans`: from the
reset state `st0` the evaluator runs 100,000 steps without a fault to `st4`,
the native trace's state at step 100,000 (PC, all GPRs, every known byte).
-/

namespace Tcc.Ccp.Sum
open Tcc.Ccp

theorem run_100000 : run code 100000 st0 = some st4 := by
  have h := run_trans (run_trans (run_trans seg0 seg1) seg2) seg3
  rwa [show (25000 + 25000 + 25000 + 25000 : Nat) = 100000 from rfl] at h

end Tcc.Ccp.Sum
