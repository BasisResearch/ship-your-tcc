+let rec add_binding_attr attr (Cabs.Declarator (p, d)) =
+  let rec direct = function
+    | Cabs.DDecl_identifier (Annot.Attrs xs, i) -> Cabs.DDecl_identifier (Annot.Attrs (xs @ [attr]), i)
+    | Cabs.DDecl_declarator d -> Cabs.DDecl_declarator (add_binding_attr attr d)
+    | Cabs.DDecl_array (d, a) -> Cabs.DDecl_array (direct d, a)
+    | Cabs.DDecl_function (d, ps) -> Cabs.DDecl_function (direct d, ps) in
+  Cabs.Declarator (p, direct d)
+
+let with_binding_attr decl = function
+  | None -> decl
+  | Some attr -> add_binding_attr attr decl
 
