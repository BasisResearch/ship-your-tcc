+(* Explicit positioned-token test boundary. The witness is supplied by the
+   raw opening adapter, with exact source/layout content pins. Presumed #line
+   labels and builtin spellings never authorize a compiler opening. No witness
+   means the historical text frontend has no injection authority. *)
+let compiler_opening_witness = lazy (
+  match Sys.getenv_opt "SYT_COMPILER_OPENING_WITNESS" with
+  | None -> None
+  | Some path ->
+      let channel = open_in path in
+      let rec lines acc =
+        match input_line channel with
+        | line -> lines (line :: acc)
+        | exception End_of_file -> close_in channel; List.rev acc in
+      match List.map (String.split_on_char '\t') (lines []) with
+      | ["source"; source; source_digest] :: ["layout"; layout; layout_digest] :: rows ->
+          if Digest.to_hex (Digest.file source) <> source_digest ||
+             Digest.to_hex (Digest.file layout) <> layout_digest then
+            failwith "compiler opening witness: changed source/layout";
+          let tokens = List.map (function
+            | ["token"; line] -> int_of_string line
+            | _ -> failwith "compiler opening witness: malformed token") rows in
+          Some (source, tokens)
+      | _ -> failwith "compiler opening witness: malformed pins")
+
+let is_compiler_injected loc =
+  let start = match loc with
+    | Loc_point p | Loc_region (p, _, _) | Loc_regions ((p, _) :: _, _) -> Some p
+    | _ -> None in
+  match start, Lazy.force compiler_opening_witness with
+  | Some p, Some (source, tokens) ->
+      let actual = Cerb_position.to_file_lexing p in
+      actual.pos_fname = source && List.mem actual.pos_lnum tokens
+  | _ -> false
+
 let is_library_location loc =
