+/-- (ship-your-tcc patch 0002) The semantics of the two uninterpreted families,
+    as a parameter: `externalCallWith X` is `externalCall` with `X` in place of
+    the axioms above, and `StepWith X` (`CCLib.Clight`) is `Step` with it.
+    `certoraExtEnv` is the original choice, and `externalCall`/`Step` are
+    defined as its instance, so everything downstream is unchanged. -/
+structure ExtEnv where
+  external : String → Signature → ExtcallSem
+  inlineAsm : String → Signature → ExtcallSem
+
+/-- Certora's choice: the axiomatised relations. -/
+def certoraExtEnv : ExtEnv := ⟨externalFunctionsSem, inlineAssemblySem⟩
+
+/-- `Events.external_call` over an `ExtEnv`. -/
+def externalCallWith (X : ExtEnv) : ExtFun → ExtcallSem
+  | .EF_external name sg => X.external name sg
+  | .EF_builtin name sg => X.external name sg
+  | .EF_runtime name sg => X.external name sg
+  | .EF_vload chunk => VolatileLoadSem chunk
+  | .EF_vstore chunk => VolatileStoreSem chunk
+  | .EF_malloc => ExtcallMallocSem
+  | .EF_free => ExtcallFreeSem
+  | .EF_memcpy sz al => ExtcallMemcpySem sz al
+  | .EF_annot _ txt targs => ExtcallAnnotSem txt targs
+  | .EF_annot_val _ txt targ => ExtcallAnnotValSem txt targ
+  | .EF_inline_asm txt sg _ => X.inlineAsm txt sg
+  | .EF_debug _ _ _ => ExtcallDebugSem
+
 /-- `Events.external_call` — the semantics of an external function. -/
-def externalCall : ExtFun → ExtcallSem
+def externalCall (ef : ExtFun) : ExtcallSem := externalCallWith certoraExtEnv ef
+
+/-- The original definition, case by case (ship-your-tcc patch 0002). -/
+def externalCallOrig : ExtFun → ExtcallSem
   | .EF_external name sg => externalFunctionsSem name sg
   | .EF_builtin name sg => builtinOrExternalSem name sg
   | .EF_runtime name sg => builtinOrExternalSem name sg
