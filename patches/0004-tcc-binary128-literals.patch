+#ifdef TCC_BAREMETAL
+/* newlib 4.5.0 strtold writes x87, and strtodg has binary128 boundary
+   defects. Reuse newlib's integer bignums directly and round an exact
+   decimal rational once. Private ABI: sys/reent.h and stdlib/mprec.h;
+   see ATTRIBUTION.md. No floating-point arithmetic occurs here. */
+#include <reent.h>
+#if __LDBL_MANT_DIG__ != 113 || __LDBL_MAX_EXP__ != 16384 \
+    || __SIZEOF_LONG_DOUBLE__ != 16 || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
