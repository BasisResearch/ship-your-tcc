+    for (i = 112; i >= 0; --i) {
+        tmp = tcc_big_shift(tcc_big_copy(den), i);
+        if (__mcmp(num, tmp) >= 0) {
+            rem = tcc_big_checked(__mdiff(_REENT, num, tmp));
+            _Bfree(_REENT, num);
+            num = rem;
+            words[i / 32] |= (__ULong)1 << (i % 32);
+        }
+        _Bfree(_REENT, tmp);
+    }
+    num = tcc_big_shift(num, 1);
+    cmp = __mcmp(num, den);
+    carry = cmp > 0 || (cmp == 0 && (words[0] & 1));
+    for (i = 0; carry && i < 4; ++i)
+        carry = ++words[i] == 0;
+    if (words[3] & 0x20000u) {
+        memset(words, 0, sizeof words);
+        words[3] = 0x10000u;
+        ++quantum;
+    }
+    if (words[3] & 0x10000u) {
+        if (quantum > 16271) goto infinity;
+        words[3] = (words[3] & 0xffffu) | ((__ULong)(quantum + 16495) << 16);
+    }
+    goto done;
+infinity:
+    memset(words, 0, sizeof words);
+    words[3] = 0x7fff0000u;
+done:
+    _Bfree(_REENT, num);
+    if (den) _Bfree(_REENT, den);
+    memcpy(&result, words, sizeof result);
+    return result;
+}
