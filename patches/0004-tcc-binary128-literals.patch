+#endif
+extern struct _Bigint *_Balloc(struct _reent *, int);
+extern void _Bfree(struct _reent *, struct _Bigint *);
+extern struct _Bigint *__i2b(struct _reent *, int);
+extern struct _Bigint *__multadd(struct _reent *, struct _Bigint *, int, int);
+extern struct _Bigint *__pow5mult(struct _reent *, struct _Bigint *, int);
+extern struct _Bigint *__lshift(struct _reent *, struct _Bigint *, int);
+extern struct _Bigint *__mdiff(struct _reent *, struct _Bigint *, struct _Bigint *);
+extern int __mcmp(struct _Bigint *, struct _Bigint *);
+extern int __hi0bits(__ULong);
+
+static struct _Bigint *tcc_big_checked(struct _Bigint *b)
+{
+    if (!b)
+        tcc_error("memory full (binary128 literal)");
+    return b;
+}
+
+static struct _Bigint *tcc_big_copy(struct _Bigint *b)
+{
+    struct _Bigint *r = tcc_big_checked(_Balloc(_REENT, b->_k));
+    r->_sign = b->_sign;
+    r->_wds = b->_wds;
+    memcpy(r->_x, b->_x, b->_wds * sizeof b->_x[0]);
+    return r;
+}
+
+static struct _Bigint *tcc_big_shift(struct _Bigint *b, int shift)
+{
+    return tcc_big_checked(__lshift(_REENT, b, shift));
+}
+
+static int tcc_big_bits(struct _Bigint *b)
+{
+    return 32 * b->_wds - __hi0bits(b->_x[b->_wds - 1]);
+}
+
+static long double tcc_strtold_binary128(const char *s)
+{
+    struct _Bigint *num = tcc_big_checked(__i2b(_REENT, 0));
+    struct _Bigint *den = NULL, *tmp, *rem;
+    __ULong words[4] = { 0, 0, 0, 0 };
+    long double result;
+    int e10 = 0, digits = 0, dot = 0, nonzero = 0, exp10 = 0;
+    int negexp = 0, exponent, quantum, i, cmp, carry;
+
+    /* parse_number has already validated this unsigned decimal token. */
+    for (; (*s >= '0' && *s <= '9') || *s == '.'; ++s) {
+        if (*s == '.') {
+            dot = 1;
+        } else {
+            num = tcc_big_checked(__multadd(_REENT, num, 10, *s - '0'));
+            if (*s != '0') nonzero = 1;
+            if (nonzero) ++digits;
+            if (dot) --e10;
+        }
+    }
+    if (*s == 'e' || *s == 'E') {
+        ++s;
+        if (*s == '-' || *s == '+') negexp = *s++ == '-';
+        for (; *s >= '0' && *s <= '9'; ++s)
+            if (exp10 < 100000000) exp10 = exp10 * 10 + *s - '0';
+        e10 += negexp ? -exp10 : exp10;
+    }
+    if (!nonzero || e10 + digits < -6000) goto done;
+    if (e10 + digits > 6000) goto infinity;
+
+    den = tcc_big_checked(__i2b(_REENT, 1));
+    if (e10 >= 0) {
+        num = tcc_big_checked(__pow5mult(_REENT, num, e10));
+        num = tcc_big_shift(num, e10);
+    } else {
+        den = tcc_big_checked(__pow5mult(_REENT, den, -e10));
+        den = tcc_big_shift(den, -e10);
+    }
+    /* floor(log2(num/den)), then the representable quantum exponent. */
+    exponent = tcc_big_bits(num) - tcc_big_bits(den);
+    if (exponent >= 0) {
+        tmp = tcc_big_shift(tcc_big_copy(den), exponent);
+        cmp = __mcmp(num, tmp);
+    } else {
+        tmp = tcc_big_shift(tcc_big_copy(num), -exponent);
+        cmp = __mcmp(tmp, den);
+    }
+    _Bfree(_REENT, tmp);
+    if (cmp < 0) --exponent;
+    if (exponent > 16383) goto infinity;
+    if (exponent < -16495) goto done;
+    quantum = exponent - 112;
+    if (quantum < -16494) quantum = -16494;
+    if (quantum >= 0) den = tcc_big_shift(den, quantum);
+    else num = tcc_big_shift(num, -quantum);
