+        cmp = __mcmp(num, tmp);
+    } else {
+        tmp = tcc_big_shift(tcc_big_copy(num), -exponent);
+        cmp = __mcmp(tmp, den);
+    }
+    _Bfree(_REENT, tmp);
+    if (cmp < 0) --exponent;
+    if (exponent > bias) goto infinity;
+    if (exponent < min_quantum - 1) goto done;
