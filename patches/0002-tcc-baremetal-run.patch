     ptr = VirtualAlloc(NULL, size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
     if (!ptr)
         return tcc_error_noabort("tccrun: could not allocate memory");
+#elif defined TCC_BAREMETAL
+    /* TCC_BAREMETAL: a static code arena at a fixed address (the linker
+       script's __tccrun_start..__tccrun_end, page aligned, not part of
+       .bss, so nothing zeroes it), readable, writable and executable as
+       all memory is on the bare machine: no mmap, no mprotect. */
+    {
+        extern char __tccrun_start[], __tccrun_end[];
+        if (size > __tccrun_end - __tccrun_start)
+            return tcc_error_noabort("tccrun: program needs %d bytes, the code arena has %d",
+                                     size, (int)(__tccrun_end - __tccrun_start));
+        ptr = __tccrun_start;
+    }
