+#ifdef TCC_BAREMETAL
+/* TCC_BAREMETAL: the same job as the loop below, organised for a slow
+   target. Upstream walks the whole archive index each pass and looks every
+   name up in the symbol table (libc.a's index has ~1080 names, so a pass
+   cost ~1080 hash computations and string compares); this hashes the index
+   once and each pass walks the undefined global symbols instead, looking
+   each up in the index (first entry of a name wins, as upstream). The
+   members loaded are the same set; they may be loaded in another order. */
+static int bm_ar_lookup(const char *const *names, const unsigned *tab,
+                        unsigned mask, const char *name)
+{
+    unsigned h = elf_hash((const unsigned char *)name) & mask;
+    for (; tab[h]; h = (h + 1) & mask)
+        if (0 == strcmp(names[tab[h] - 1], name))
+            return tab[h] - 1;
+    return -1;
+}
+
+static int tcc_load_alacarte(TCCState *s1, int fd, int size, int entrysize)
+{
+    int i, nsyms, sym_index, len, bound, ret = -1;
+    unsigned nb, h, *tab = NULL;
+    unsigned long long off;
+    uint8_t *data;
+    const char *ar_names, *p, **names = NULL;
+    const uint8_t *ar_index;
+    ElfW(Sym) *sym;
+    ArchiveHeader hdr;
+
+    data = tcc_malloc(size);
+    if (full_read(fd, data, size) != size)
+        goto invalid;
+    nsyms = get_be(data, entrysize);
+    ar_index = data + entrysize;
+    ar_names = (char *) ar_index + nsyms * entrysize;
+    names = tcc_malloc(nsyms * sizeof *names + 1);
+    for (nb = 1; nb < 2 * (unsigned)nsyms; nb <<= 1)
+        ;
+    tab = tcc_mallocz(nb * sizeof *tab);
+    for (p = ar_names, i = 0; i < nsyms; i++, p += strlen(p) + 1) {
+        names[i] = p;
+        for (h = elf_hash((const unsigned char *)p) & (nb - 1); tab[h]; h = (h + 1) & (nb - 1))
+            ;
+        tab[h] = i + 1;
+    }
+    do {
+        bound = 0;
+        for (sym_index = 1;
+             sym_index < (int)(symtab_section->data_offset / sizeof (ElfW(Sym)));
+             sym_index++) {
+            sym = &((ElfW(Sym) *)symtab_section->data)[sym_index];
+            if (sym->st_shndx != SHN_UNDEF
+                || ELFW(ST_BIND)(sym->st_info) == STB_LOCAL)
+                continue;
+            i = bm_ar_lookup(names, tab, nb - 1,
+                             (char *)symtab_section->link->data + sym->st_name);
+            if (i < 0)
+                continue;
+            off = get_be(ar_index + i * entrysize, entrysize);
+            len = read_ar_header(fd, off, &hdr);
+            if (len <= 0 || memcmp(hdr.ar_fmag, ARFMAG, 2)) {
+        invalid:
+                tcc_error_noabort("invalid archive");
+                goto the_end;
+            }
+            off += len;
+            if (s1->verbose == 2)
+                printf("   -> %s\n", hdr.ar_name);
+            if (tcc_load_object_file(s1, fd, off) < 0)
+                goto the_end;
+            ++bound;
+        }
+    } while (bound);
+    ret = 0;
+ the_end:
+    tcc_free(tab);
+    tcc_free(names);
+    tcc_free(data);
+    return ret;
+}
+#else
 /* load only the objects which resolve undefined symbols */
 static int tcc_load_alacarte(TCCState *s1, int fd, int size, int entrysize)
 {
