+#ifdef TCC_BAREMETAL
+/* TCC_BAREMETAL: put input sections where GNU ld's default linker script
+   puts them: .text.X into .text, .rodata.X and .srodata.X into .rodata,
+   .data.X and .sdata.X into .data, .bss.X and .sbss.X into .bss, and their
+   .rela sections alike. newlib and libgcc are built with -ffunction-sections
+   -fdata-sections; without this every function became its own section and
+   matching section names (strcmp over all sections, per input section) was
+   the largest cost of linking a program against libc.a on the target. */
+static const char *bm_output_section(const char *name)
+{
+    static const char *const in[] = {
+        ".text", ".rodata", ".srodata", ".data", ".sdata", ".bss", ".sbss" };
+    static const char *const out[] = {
+        ".text", ".rodata", ".rodata", ".data", ".data", ".bss", ".bss" };
+    static const char *const out_rela[] = {
+        ".rela.text", ".rela.rodata", ".rela.rodata", ".rela.data",
+        ".rela.data", ".rela.bss", ".rela.bss" };
+    int rela = 0 == strncmp(name, ".rela.", 6);
+    const char *n = rela ? name + 5 : name;
+    unsigned i, len;
+    for (i = 0; i < sizeof in / sizeof *in; i++) {
+        len = strlen(in[i]);
+        if (0 == strncmp(n, in[i], len) && (n[len] == 0 || n[len] == '.'))
+            return rela ? out_rela[i] : out[i];
+    }
+    return name;
+}
+#endif
