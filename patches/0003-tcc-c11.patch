+/* Phase 6 chooses the common prefix before interpreting each literal's
+   escapes. Keep literal boundaries: "\x12" "3" is not "\x123". */
+static void parse_string_concat(void)
+{
+    TokenString str;
+    const int *q;
+    CValue cv;
+    CString out, spelling;
+    const char *s;
+    int t, prefix = 0, p, flags = parse_flags;
+
+    tok_str_new(&str);
+    parse_flags &= ~PARSE_FLAG_TOK_STR;
+    for (;;) {
+        if (tok != TOK_PPSTR && tok != TOK_STR && tok != TOK_LSTR)
+            break;
+        s = get_tok_str(tok, &tokc);
+        p = *s == 'L' || *s == 'u' || *s == 'U' ? *s : 0;
+        if (p == 'u' && s[1] == '8') p = '8';
+        if (p && prefix && p != prefix)
+            tcc_error("incompatible string literal prefixes");
+        if (p) prefix = p;
+        cv.str.data = (char *)s;
+        cv.str.size = strlen(s) + 1;
+        tok_str_add2(&str, TOK_PPSTR, &cv);
+        next();
+        /* Character constants are not adjacent string literals. */
+        if (tok == TOK_PPSTR) {
+            s = tokc.str.data;
+            while (*s == 'L' || *s == 'u' || *s == 'U' || *s == '8') ++s;
+            if (*s != '"') break;
+        }
+    }
+    unget_tok(0);
+    parse_flags = flags;
+    tok_str_add(&str, 0);
+    cstr_new(&out);
+    cstr_new(&spelling);
+    q = str.str;
+    for (;;) {
+        TOK_GET(&t, &q, &cv);
+        if (!t) break;
+        s = cv.str.data;
+        if (*s == 'L' || *s == 'u' || *s == 'U') {
+            if (*s++ == 'u' && *s == '8') ++s;
+        }
+        cstr_reset(&spelling);
+        if (prefix == '8') cstr_cat(&spelling, "u8", 2);
+        else if (prefix) cstr_ccat(&spelling, prefix);
+        cstr_cat(&spelling, s, -1);
+        parse_string(spelling.data, spelling.size);
+        if (out.size) out.size -= TOK_STR_SIZE(tok);
+        cstr_cat(&out, tokc.str.data, tokc.str.size);
+    }
+    cstr_reset(&tokcstr);
+    cstr_cat(&tokcstr, out.data, out.size);
+    tokc.str.data = tokcstr.data;
+    tokc.str.size = tokcstr.size;
+    cstr_free(&out);
+    cstr_free(&spelling);
+    tok_str_free_str(str.str);
+}
