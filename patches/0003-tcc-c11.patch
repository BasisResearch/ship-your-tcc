+/* C11 Annex D.1: permitted universal character names in identifiers. */
+static int ucn_identifier(unsigned u, int initial)
+{
+    static const unsigned ranges[][2] = {
+        {0xa8,0xa8}, {0xaa,0xaa}, {0xad,0xad}, {0xaf,0xaf},
+        {0xb2,0xb5}, {0xb7,0xba}, {0xbc,0xbe}, {0xc0,0xd6},
+        {0xd8,0xf6}, {0xf8,0x167f}, {0x1681,0x180d},
+        {0x180f,0x1fff}, {0x200b,0x200d}, {0x202a,0x202e},
+        {0x203f,0x2040}, {0x2054,0x2054}, {0x2060,0x206f},
+        {0x2070,0x218f}, {0x2460,0x24ff}, {0x2776,0x2793},
+        {0x2c00,0x2dff}, {0x2e80,0x2fff}, {0x3004,0x3007},
+        {0x3021,0x302f}, {0x3031,0xd7ff}, {0xf900,0xfd3d},
+        {0xfd40,0xfdcf}, {0xfdf0,0xfe44}, {0xfe47,0xfffd}
+    };
+    int i;
+    if (initial && ((u >= 0x300 && u <= 0x36f)
+        || (u >= 0x1dc0 && u <= 0x1dff)
+        || (u >= 0x20d0 && u <= 0x20ff)
+        || (u >= 0xfe20 && u <= 0xfe2f)))
+        return 0;
+    if (u >= 0x10000)
+        return u <= 0xefffd && (u & 0xffff) <= 0xfffd;
+    for (i = 0; i < sizeof ranges / sizeof *ranges; ++i)
+        if (u >= ranges[i][0] && u <= ranges[i][1])
+            return 1;
+    return 0;
+}
