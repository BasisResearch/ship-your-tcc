+    tcc_state->include_stack_ptr = tcc_state->include_stack;
+    tcc_open_bf(tcc_state, file->filename, text.size);
+    memcpy(file->buffer, text.data, text.size);
+    /* once refers to the real file, including after #line. */
+    file->true_filename = tcc_strdup(file->prev->true_filename);
+    file->line_num = file->prev->line_num;
+    parse_flags = PARSE_FLAG_PREPROCESS | PARSE_FLAG_TOK_NUM
+        | PARSE_FLAG_TOK_STR | PARSE_FLAG_LINEFEED;
+    result = tok_str_alloc();
+    pragma_parse(tcc_state);
+    if (tcc_state->output_type == TCC_OUTPUT_PREPROCESS)
+        parse_flags &= ~PARSE_FLAG_PREPROCESS;
+    /* -E re-emits implementation pragmas. Copy them before restoring the
+       caller, so no temporary-buffer or macro-stack pointer escapes. */
+    while (tok != TOK_LINEFEED && tok != TOK_EOF) {
+        if (tcc_state->output_type == TCC_OUTPUT_PREPROCESS)
+            tok_str_add_tok(result);
+        tcc_state->output_type == TCC_OUTPUT_PREPROCESS ? next() : next_nomacro();
