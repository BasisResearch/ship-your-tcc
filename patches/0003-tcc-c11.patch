+            next();
+        }
+    }
+    while (macro_stack) end_macro();
+    tcc_close();
+    tcc_state->include_stack_ptr = saved_includes;
+    tok_str_free_str(tokstr_buf.str);
+    tok_str_free_str(unget_buf.str);
+    tokstr_buf = saved_tokstr;
+    unget_buf = saved_unget;
+    cstr_free(&text);
+    macro_stack = saved_stack;
+    macro_ptr = saved_ptr;
+    tok_flags = saved_tok_flags;
+    tok_line = saved_tok_line;
+    parse_flags = flags;
+    if (result->len) {
+        tok_str_add(result, 0);
+        begin_macro(result, 1);
+    } else
+        tok_str_free(result);
+}
