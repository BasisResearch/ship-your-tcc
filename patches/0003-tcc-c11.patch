+/* C11 phase 1, before splicing and every lexer fast path. This operates
+   only on physical source, never on paste/_Pragma/macro token buffers. */
+ST_FUNC int tcc_trigraphs(unsigned char *buf, int len)
+{
+    int i, n = 0, c;
+    for (i = 0; i < len; ++i) {
+        c = buf[i];
+        if (c == '?' && i + 2 < len && buf[i + 1] == '?') {
+            switch (buf[i + 2]) {
+            case '=': c = '#'; break;
+            case '/': c = '\\'; break;
+            case '\'': c = '^'; break;
+            case '(': c = '['; break;
+            case ')': c = ']'; break;
+            case '!': c = '|'; break;
+            case '<': c = '{'; break;
+            case '>': c = '}'; break;
+            case '-': c = '~'; break;
+            default: buf[n++] = c; continue;
+            }
+            i += 2;
+        }
+        buf[n++] = c;
+    }
+    return n;
+}
