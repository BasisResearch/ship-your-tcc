+   then use exactly the #pragma parser. Isolate its token/file stream. */
+/* A cached macro argument can retain spaces even with SPACES disabled. */
+static void pragma_operand_next(TokenString *events)
+{
+    for (;;) {
+        next();
+        if (tok == TOK_PPSTR && tokc.str.size >= 11 && !tokc.str.data[0])
+            tok_str_add2(events, tok, &tokc);
+        else if (tok != ' ')
