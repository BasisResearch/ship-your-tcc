+/* A union switch invalidates descendants, never its enclosing union,
+   even when both objects start at the same address and have equal size. */
+static int init_union_nested(Sym *outer, Sym *inner)
+{
+    Sym *f;
+    for (f = outer->next; f; f = f->next) {
+        CType *t = &f->type;
+        while (t->t & VT_ARRAY) t = pointed_type(t);
+        if ((t->t & VT_BTYPE) == VT_STRUCT
+            && (t->ref == inner || init_union_nested(t->ref, inner)))
+            return 1;
+    }
+    return 0;
+}
+
+/* Forget active members in a subobject that is being replaced. The
+   containing union's entry is retained when called for its chosen member. */
+static void init_union_forget(init_params *p, unsigned long c, int size,
+                              InitUnion *keep)
+{
+    InitUnion **pp = &p->unions, *u;
+    while ((u = *pp)) {
+        if (u != keep && u->addr - c < (unsigned long)size
+            && init_union_nested(keep->type, u->type)) {
+            *pp = u->next;
+            tcc_free(u);
+        } else
+            pp = &u->next;
+    }
+}
+
+static void init_union_select(init_params *p, CType *type, Sym *member,
+                              unsigned long c, int flags)
+{
+    InitUnion *u;
+    int size = type->ref->c;
+    if (flags & DIF_SIZE_ONLY || type->ref->type.t != VT_UNION)
+        return;
+    for (u = p->unions; u; u = u->next)
+        if (u->type == type->ref && u->addr == c)
+            break;
+    if (!u) {
+        u = tcc_mallocz(sizeof *u);
+        u->type = type->ref;
+        u->addr = c;
+        u->next = p->unions;
+        p->unions = u;
+    } else if (u->member != member) {
+        /* C11 6.7.9p19: changing the active member overrides its entire
+           previous initializer, including bytes and pointer relocations. */
+        init_union_forget(p, c, size, u);
+        decl_design_delrels(p->sec, c, size);
+        if (p->sec) {
+            init_assert(p, c + size);
+            if (!NODATA_WANTED)
+                memset(p->sec->data + c, 0, size);
+        } else
+            init_putz(p, c, size);
+    }
+    u->member = member;
+}
+
+/* Follow an anonymous-field path as well, so every enclosing union sees
+   which direct member is selected. find_field has already validated it. */
+static int init_field_path(init_params *p, CType *type, Sym *field,
+                           unsigned long c, int flags)
+{
+    Sym *s;
+    for (s = type->ref->next; s; s = s->next) {
+        if (s == field || ((s->type.t & VT_BTYPE) == VT_STRUCT
+            && s->v >= (SYM_FIRST_ANOM | SYM_FIELD)
+            && init_field_path(p, &s->type, field, c + s->c,
+                               flags | DIF_SIZE_ONLY))) {
+            init_union_select(p, type, s, c, flags);
+            if (s != field)
+                init_field_path(p, &s->type, field, c + s->c, flags);
+            return 1;
+        }
+    }
+    return 0;
+}
