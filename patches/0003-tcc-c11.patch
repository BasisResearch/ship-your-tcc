+static void pragma_operator(Sym **nested_list)
+{
+    int flags = parse_flags, saved_tok_flags, saved_tok_line = tok_line;
+    const char *s;
+    CString text;
+    TokenString *saved_stack, *result;
+    TokenString *operand_events = tok_str_alloc();
+    TokenString saved_tokstr, saved_unget;
+    BufferedFile **saved_includes;
+    const int *saved_ptr;
+
+    parse_flags &= ~(PARSE_FLAG_TOK_STR | PARSE_FLAG_SPACES | PARSE_FLAG_LINEFEED);
+    pragma_operand_next(operand_events);
+    if (tok != '(') expect("(");
+    pragma_operand_next(operand_events);
+    /* A replacement-list stream is normally already expanded, so next()
+       does not expand its identifiers.  macro_subst invokes us before that
+       rescanning is complete: expand the operand using the same active-macro
+       list, including function-like operands and their argument stream. */
+    if (tok >= TOK_IDENT) {
+        Sym *operand_macro = define_find(tok);
+        if (operand_macro && !sym_find2(*nested_list, canonical_ident(tok))) {
+            TokenString *operand = tok_str_alloc();
+            macro_subst_tok(operand, nested_list, operand_macro);
+            tok_str_add(operand, 0);
+            begin_macro(operand, 1);
+            pragma_operand_next(operand_events);
+        }
+    }
+    if (tok != TOK_PPSTR) expect("string literal in _Pragma");
+    s = tokc.str.data;
+    if (*s == 'L') ++s;
+    if (*s++ != '"') expect("ordinary or wide string literal in _Pragma");
+    cstr_new(&text);
+    while (*s && *s != '"') {
+        if (*s == '\\' && (s[1] == '\\' || s[1] == '"')) ++s;
+        cstr_ccat(&text, *s++);
+    }
+    cstr_ccat(&text, '\n');
+    pragma_operand_next(operand_events);
+    if (tok != ')') expect(")");
+
+    saved_stack = macro_stack;
+    saved_ptr = macro_ptr;
+    saved_tok_flags = tok_flags;
+    macro_stack = NULL;
+    macro_ptr = NULL;
+    saved_tokstr = tokstr_buf;
+    saved_unget = unget_buf;
+    tok_str_new(&tokstr_buf);
+    tok_str_new(&unget_buf);
