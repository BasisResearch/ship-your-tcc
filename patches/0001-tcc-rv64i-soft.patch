+/* Call the libgcc routine NAME on the top NARGS stack values (pushed in
+   argument order), leaving its result (a0, or a0:a1 for long double) on
+   the value stack with type T. */
+static void soft_call(const char *name, int nargs, int t)
+{
+    vpush_helper_func(tok_alloc_const(name));
+    vrott(nargs + 1);
+    gfunc_call(nargs);
+    vpushi(0);
+    vtop->type.t = t;
+    vtop->r = REG_IRET;
+    vtop->r2 = (t & VT_BTYPE) == VT_LDOUBLE ? TREG_R(1) : VT_CONST;
+}
+
+/* RV64I has no M extension: multiply, divide and remainder go to libgcc,
+   as gcc -march=rv64i -mabi=lp64 does it: the DI routines for both
+   widths, unsigned 32-bit operands zero-extended first, and a 32-bit
+   result sign-extended (tcc keeps 32-bit values sign-extended). */
+static int gen_opil_soft(int op, int ll)
+{
+    const char *name;
+    int i, r;
+    switch (op) {
+    case '*': name = "__muldi3"; break;
+    case '/': case TOK_PDIV: name = "__divdi3"; break;
+    case '%': name = "__moddi3"; break;
+    case TOK_UDIV: name = "__udivdi3"; break;
+    case TOK_UMOD: name = "__umoddi3"; break;
+    default: return 0;
+    }
+    gv2(RC_INT, RC_INT);
+    for (i = -1; i <= 0; i++) {
+        if (!ll && (op == TOK_UDIV || op == TOK_UMOD)) {
+            r = ireg(vtop[i].r);
+            EI(0x13, 1, r, r, 32); // slli r, r, 32
+            EI(0x13, 5, r, r, 32); // srli r, r, 32
+        }
+        vtop[i].type.t = VT_LLONG;
+    }
+    soft_call(name, 2, VT_LLONG);
+    if (!ll)
+        EI(0x1b, 0, 10, 10, 0); // addiw a0, a0, 0 == sext.w a0, a0
+    return 1;
+}
+#endif
